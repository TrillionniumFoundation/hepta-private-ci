  "additional_security_findings": [
    {
      "path": "codex-rs/uds/src/lib.rs:326",
      "finding": "Windows ensure_current_user_peer unconditionally returns Unsupported. Correcting the path classification alone does not enable owner-authorized control requests."
    },
    {
      "path": "codex-rs/uds/src/lib.rs:290; codex-rs/hepta-matrixd/src/control.rs:480",
      "finding": "Windows socket directory setup only creates directories; matrix set_owner_only returns Ok without setting access restrictions. It is not equivalent to Unix owner-only permissions."
    },
    {
      "path": "codex-rs/hepta-agentd/src/prompt_runtime.rs:1189,1201,1213",
      "finding": "Non-Unix permission and directory-sync functions return Ok without performing the operation. They are reached after registry open succeeds; a partial registry port must not activate an implicit weaker path."
    },
    {
      "path": "codex-rs/hepta-agentd/src/state_isolation_tests.rs:658",
      "finding": "The unsupported-owner negative control constructs a complete AgentdState first and fails before reaching the authbus ownership denial it intends to test."
    }
  ],
