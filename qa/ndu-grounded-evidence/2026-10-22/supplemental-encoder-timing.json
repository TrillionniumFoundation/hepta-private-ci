    "text": "\"\"\"Bounded, observational, single-resident-worker encoder-only timing probe.\"\"\"\nfrom datetime import datetime, timezone\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport platform\nimport statistics\nimport sys\nimport time\n\nsys.dont_write_bytecode = True\nROOT = Path('/workspace/scratch/79ec3697a4ed/ndu-run')\nCODE = Path('/workspace/scratch/79ec3697a4ed/hepta-ndu/qa/ndu-grounded-generation')\nsys.path.insert(0, str(CODE))\nimport backend as backend_module\nimport numpy\nimport PIL\nimport torch\nimport transformers\n\n\ndef sha(path):\n    with path.open('rb') as stream:\n        return hashlib.file_digest(stream, 'sha256').hexdigest()\n\n\ndef utc():\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef save(value):\n    target = ROOT / 'supplemental-encoder-timing.json'\n    temporary = target.with_suffix('.json.tmp')\n    temporary.write_text(json.dumps(value, indent=2, allow_nan=False) + '\\n')\n    temporary.replace(target)\n\n\nobservations_path = ROOT / 'cohort/test.observations.jsonl'\nobservations = [json.loads(line) for line in observations_path.read_text().splitlines() if line.strip()]\nrequested = ['ggv1_e01f69ec9958977c743198f3', 'ggv1_42dfadfc934ac3d2e1fd030a']\nlookup = {row['task_id']: row for row in observations}\nselected = [lookup[key] for key in requested] + [row for row in observations if row['task_id'] not in requested][:2]\nassert len(selected) == 4 and len({row['task_id'] for row in selected}) == 4\nassert not (ROOT / 'supplemental-encoder-timing.json').exists()\nprimary_paths = ('test.episodes.jsonl', 'test.run.json', 'report.json')\nrecord = {\n    'schema': 'hepta.supplemental-encoder-timing.v1', 'status': 'running', 'started_utc': utc(),\n    'scope': 'Post-primary-test encoder-only repeatability probe; one resident worker and four torch threads.',\n    'limitations': ['Different worker/concurrency conditions from the primary comparison.',\n                    'No host telemetry establishes a specific cause of primary timing outliers.',\n                    'No primary results are replaced, excluded, rescored, or retuned by this probe.'],\n    'protocol': {'rounds': 3, 'task_order': [row['task_id'] for row in selected],\n                 'order_rule': 'Two prespecified timeout task IDs, then first two other test observation rows.',\n                 'warmup_calls': 0, 'discarded_calls': 0, 'retries': 0,\n                 'decoder_calls': 0, 'generation_calls': 0, 'scoring_calls': 0,\n                 'references_loaded': False, 'max_planned_encoder_calls': 12,\n                 'timing_scope': 'Wall and process CPU surround encode(); input hashing for metadata, serialization, and model loading are outside each timed call.'},\n    'primary_sha256_before': {name: sha(ROOT / name) for name in primary_paths},\n    'test_observations_sha256': sha(observations_path),\n    'runtime': {'python': sys.version, 'executable': sys.executable, 'platform': platform.platform(),\n                'torch': torch.__version__, 'transformers': transformers.__version__,\n                'numpy': numpy.__version__, 'pillow': PIL.__version__, 'worker_pid': os.getpid(),\n                'backend_sha256': sha(CODE / 'backend.py'), 'single_resident_worker': True},\n    'probe_source': {'sha256': sha(Path(__file__)), 'text': Path(__file__).read_text()},\n    'measurements': []}\nsave(record)\nload_wall, load_cpu = time.perf_counter(), time.process_time()\nbackend = backend_module.FlorenceBackend(ROOT / 'model', threads=4)\nrecord['runtime'].update(torch_threads=torch.get_num_threads(), torch_interop_threads=torch.get_num_interop_threads(),\n                         resident_load_wall_seconds=time.perf_counter() - load_wall,\n                         resident_load_process_cpu_seconds=time.process_time() - load_cpu,\n                         model_revision=backend_module.MODEL_REVISION,\n                         checkpoint_sha256=backend_module.WEIGHT_SHA256)\nfor round_index in range(3):\n    for order, observation in enumerate(selected):\n        measurement = {'index': len(record['measurements']) + 1, 'round': round_index + 1,\n                       'order_in_round': order + 1, 'task_id': observation['task_id'],\n                       'source_image_sha256': observation['image_sha256'],\n                       'actual_input_image_sha256': sha(Path(observation['image_path'])),\n                       'started_utc': utc()}\n        started_wall, started_cpu = time.perf_counter(), time.process_time()\n        try:\n            encoded = backend.encode(observation)\n            measurement.update(wall_seconds=time.perf_counter() - started_wall,\n                               process_cpu_seconds=time.process_time() - started_cpu, status='ok',\n                               encoder_output_shape=list(encoded.encoder_outputs.last_hidden_state.shape),\n                               encoder_feature_shape=list(encoded.encoder_feature.shape),\n                               attention_mask_shape=list(encoded.attention_mask.shape),\n                               image_size=list(encoded.image_size), backend_costs=encoded.costs)\n            del encoded\n        except Exception as error:\n            measurement.update(wall_seconds=time.perf_counter() - started_wall,\n                               process_cpu_seconds=time.process_time() - started_cpu,\n                               status='error', error_type=type(error).__name__, error=str(error))\n        record['measurements'].append(measurement)\n        save(record)\n        print(json.dumps({key: measurement[key] for key in ('index', 'task_id', 'wall_seconds', 'process_cpu_seconds', 'status')}), flush=True)\nrecord['frozen_model_receipt'] = backend.frozen_receipt()\nrecord['primary_sha256_after'] = {name: sha(ROOT / name) for name in primary_paths}\nrecord['primary_files_unchanged'] = record['primary_sha256_before'] == record['primary_sha256_after']\nrecord['summary_by_task'] = []\nfor observation in selected:\n    rows = [row for row in record['measurements'] if row['task_id'] == observation['task_id']]\n    record['summary_by_task'].append({'task_id': observation['task_id'], 'calls': len(rows),\n        'errors': sum(row['status'] != 'ok' for row in rows),\n        **{field: {'min': min(row[field] for row in rows), 'median': statistics.median(row[field] for row in rows),\n                   'max': max(row[field] for row in rows)} for field in ('wall_seconds', 'process_cpu_seconds')}})\nrecord.update(status='complete', completed_utc=utc(), completed_encoder_calls=len(record['measurements']))\nsave(record)\nprint(json.dumps({'status': record['status'], 'calls': record['completed_encoder_calls'],\n                  'primary_files_unchanged': record['primary_files_unchanged'],\n                  'output_sha256': sha(ROOT / 'supplemental-encoder-timing.json')}), flush=True)\n"
  },
