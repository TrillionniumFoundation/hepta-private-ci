+//! Root-owned learning trust, read separately from deployment and role packets.
+//! This file carries already enrolled public credentials, never signing keys.
+
+use std::io;
+use std::path::Path;
+
+use codex_hepta_learning_ledger::AuthenticatedPrincipalV1;
+use codex_hepta_learning_ledger::LearningEvidenceRoleV1;
+use codex_hepta_learning_ledger::LearningEvidenceTrustV1;
+use codex_hepta_learning_ledger::LearningEvidenceVerifierV1;
+use codex_hepta_learning_ledger::TrustedLearningSignerV1;
+use codex_hepta_types::Digest32;
+use codex_hepta_types::StableId;
+use serde::Deserialize;
+
+use crate::authority_host_config::read_root_json;
+
+const PURPOSE: &str = "hepta.host-resident-learning.trusted-evidence.v3";
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct TrustFile {
+    schema_version: u32,
+    purpose: String,
+    scope_digest: String,
+    objective_digest: String,
+    authority_epoch: u64,
+    signers: Vec<Signer>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Signer {
+    principal: Principal,
+    controller_id: String,
+    verifying_key: [u8; 32],
+    roles: Vec<Role>,
+    revoked_at: Option<u64>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Principal {
+    principal_id: String,
+    credential_chain_digest: String,
+    signing_key_digest: String,
+    scope_digest: String,
+    authority_epoch: u64,
+    authenticated_at: u64,
+    expires_at: u64,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum Role {
+    Generator,
+    Observer,
+    Evaluator,
+    CreditAllocator,
+    UnlearningAuthority,
+    Selector,
+}
+
+impl From<Role> for LearningEvidenceRoleV1 {
