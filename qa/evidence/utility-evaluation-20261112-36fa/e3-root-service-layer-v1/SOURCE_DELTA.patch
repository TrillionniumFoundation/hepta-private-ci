+pub(super) fn digest(value: &str) -> io::Result<Digest32> {
+    let digest = value.parse::<Digest32>().map_err(io::Error::other)?;
+    if digest.to_string() != value {
+        return Err(io::Error::other("noncanonical original digest"));
+    }
