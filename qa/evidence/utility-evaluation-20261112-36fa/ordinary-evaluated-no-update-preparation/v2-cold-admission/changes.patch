+    drop(reader);
+    assert_eq!(f.publication_bytes()?, before);
+    assert_eq!(c.cell.snapshot(&f.source_c.scope)?.revision, 0);
+    drop(host);
+    let reads = peers.finish()?;
+    assert!(reads.iter().all(|count| *count > 0));
+    c.stop().await?;
+    drop(c);
+    f.finish().await
