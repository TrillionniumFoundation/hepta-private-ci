+//! The original evaluated Selector observes a separately held published-task
+//! read capability. Its original journal/key and actual T/B clients are retained.
+
+use super::*;
+use crate::OriginalCircuitEvaluatedLearningReadContextV1;
+
+pub struct OriginalCircuitEvaluatedSelectionRemoteSourcesV1<'a> {
+    pub snapshot: &'a LearningIterationSnapshotV1,
+    pub context: &'a OriginalCircuitEvaluatedRetentionContextV1,
+    pub live: &'a OriginalCircuitLearningReadClientV1,
+    pub trainer: &'a OriginalCellQ24TrainingCommandClientV1,
+    pub evaluator: &'a OriginalCellEvaluationCommandClientV1,
+}
+
+impl SelectionSources for OriginalCircuitEvaluatedSelectionRemoteSourcesV1<'_> {
+    fn snapshot(&self) -> &LearningIterationSnapshotV1 { self.snapshot }
+    fn trainer(&self) -> Option<&LearningIterationEvidenceClientV1> { None }
+    fn evaluated_owners(&self) -> Option<(&OriginalCellQ24TrainingCommandClientV1, &OriginalCellEvaluationCommandClientV1)> {
+        Some((self.trainer, self.evaluator))
+    }
+    fn location(&self) -> ObservationLocation { ObservationLocation::EvaluatedRemoteOwner }
+    async fn observe(&self, config: &OriginalCircuitSelectionReceiptConfigV1) -> Result<LearningIterationObservationV1, Error> {
+        let (scope, verifier, training) = self.context.receipt_configuration();
+        if self.context.snapshot() != &config.decision || scope != config.scope
+            || verifier.trust_digest() != config.verifier.trust_digest()
+            || verifier.scope_digest() != config.verifier.scope_digest()
+            || verifier.objective_digest() != config.verifier.objective_digest()
+            || training != config.training_evidence {
+            return Err(OwnerError::Binding("same original evaluated remote Selection context").into());
+        }
+        self.live.require_original_evaluated_context(
+            &OriginalCircuitEvaluatedLearningReadContextV1::from_original_evaluation(self.context)?)?;
+        Ok(self.live.read_current().await?.observation().clone())
+    }
+}
+
+impl<W: AnchorWitnessStore> OriginalCircuitSelectionReceiptOwnerV1<W> {
+    pub(crate) fn original_evaluated_command_context(&self) -> Option<&OriginalCircuitEvaluatedRetentionContextV1> {
+        match &self.profile {
+            Profile::TrainingNoUpdate => None,
+            Profile::Evaluated(context) => Some(context),
+        }
+    }
+
+    pub async fn attest_original_evaluated_remote_selection(
+        &mut self, source: OriginalCircuitEvaluatedSelectionRemoteSourcesV1<'_>,
+    ) -> Result<OriginalCircuitEvaluatedSelectionReceiptV1, Error> {
+        let completed = match self.command_origin {
+            CommandOrigin::FreshCreate => self.attest_source(source).await?,
+            CommandOrigin::Recovered => self.readback_source(source).await?,
+        };
+        self.completed_evaluated_selection(completed)
+    }
+
+    pub async fn readback_evaluated_remote_selection(
+        &mut self, source: OriginalCircuitEvaluatedSelectionRemoteSourcesV1<'_>,
+    ) -> Result<OriginalCircuitEvaluatedSelectionReceiptV1, Error> {
+        let completed = self.readback_source(source).await?;
+        self.completed_evaluated_selection(completed)
+    }
+
+    pub fn into_evaluated_command_owner(
+        self,
+        live: OriginalCircuitLearningReadClientV1,
+        trainer: OriginalCellQ24TrainingCommandClientV1,
+        evaluator: OriginalCellEvaluationCommandClientV1,
+    ) -> Result<crate::OriginalCircuitSelectionCommandOwnerV1<W>, crate::OriginalCircuitSelectionCommandErrorV1>
+    where W: Send + 'static,
+    {
+        crate::OriginalCircuitSelectionCommandOwnerV1::from_original_evaluated_receipt_owner(
+            self, live, trainer, evaluator)
+    }
+}
+
+impl OriginalCircuitEvaluatedSelectionReceiptV1 {
+    /// Only a verified response from the original Selector command constructs
+    /// this transport continuation. Raw snapshot/signature data are not inputs.
+    pub(crate) fn from_original_command_response(
+        original: &crate::OriginalCircuitSelectionCommandReceiptV1,
+    ) -> Result<Self, Error> {
+        let context = original.evaluated_context()
+            .ok_or(OwnerError::Binding("original evaluated Selector command receipt"))?;
+        let value = Self {
+            context: context.clone_for_original_receipt(), snapshot: original.snapshot().clone(),
+            receipt: original.receipt().clone(), attestation: original.attestation().clone(),
+        };
+        value.original_receipt_predecessors(now()?)?;
+        Ok(value)
+    }
+}
