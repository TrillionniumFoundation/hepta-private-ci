+//! Internal read profiles preserve the legacy wire and require opaque original
+//! evaluated T/B or T/B/S pins for the separate evaluated-retention purpose.
+
+use codex_hepta_learning_artifacts::LearningIterationCoordinatorV1;
+use codex_hepta_learning_artifacts::LearningIterationStageV1;
+use codex_hepta_types::Digest32;
+
+use super::Error;
+use super::OriginalCircuitLearningReadContextV1;
+use super::now;
+use super::wire::Mode;
+use crate::OriginalCircuitEvaluatedRetentionContextV1;
+use crate::OriginalCircuitEvaluatedSelectionReceiptV1;
+
+enum EvaluatedCut {
+    Evaluation(OriginalCircuitEvaluatedRetentionContextV1),
+    Selection(OriginalCircuitEvaluatedSelectionReceiptV1),
+}
+
+/// Read-only pins from actual original command/receipt owners. No public field,
+/// deserializer, signer, owner lookup or callback can manufacture this profile.
+pub struct OriginalCircuitEvaluatedLearningReadContextV1 {
+    metadata: OriginalCircuitLearningReadContextV1,
+    original: EvaluatedCut,
+}
+
+impl Clone for OriginalCircuitEvaluatedLearningReadContextV1 {
+    fn clone(&self) -> Self {
+        Self {
+            metadata: self.metadata.clone(),
+            original: match &self.original {
+                EvaluatedCut::Evaluation(context) => {
+                    EvaluatedCut::Evaluation(context.clone_for_original_receipt())
+                }
+                EvaluatedCut::Selection(selection) => EvaluatedCut::Selection(selection.clone()),
+            },
+        }
+    }
+}
+
+impl OriginalCircuitEvaluatedLearningReadContextV1 {
+    pub fn from_original_evaluation(
+        context: &OriginalCircuitEvaluatedRetentionContextV1,
+    ) -> Result<Self, Error> {
+        let (scope, verifier, training_evidence) = context.receipt_configuration();
+        let value = Self {
+            metadata: OriginalCircuitLearningReadContextV1 {
+                prefix: context.snapshot().clone(),
+                scope,
+                verifier,
+                training_evidence,
+                selection_evidence: None,
+            },
+            original: EvaluatedCut::Evaluation(context.clone_for_original_receipt()),
+        };
+        value.binding(now()?)?;
+        Ok(value)
+    }
+
+    pub fn from_original_selection(
+        selection: &OriginalCircuitEvaluatedSelectionReceiptV1,
+    ) -> Result<Self, Error> {
+        let (scope, verifier, training_evidence) =
+            selection.original_context().receipt_configuration();
+        let value = Self {
+            metadata: OriginalCircuitLearningReadContextV1 {
+                prefix: selection.snapshot().clone(),
+                scope,
+                verifier,
+                training_evidence,
+                selection_evidence: Some(selection.attestation().clone()),
+            },
+            original: EvaluatedCut::Selection(selection.clone()),
+        };
+        value.binding(now()?)?;
+        Ok(value)
+    }
+
+    pub(super) fn mode(&self) -> Result<Mode, Error> {
+        let coordinator =
+            LearningIterationCoordinatorV1::from_snapshot(self.metadata.prefix.clone())?;
+        self.metadata.scope.validate_snapshot(&self.metadata.prefix)?;
+        let (snapshot, length, stage, mode) = match &self.original {
+            EvaluatedCut::Evaluation(context) => {
+                (context.snapshot(), 4, LearningIterationStageV1::Selection, Mode::Selection)
+            }
+            EvaluatedCut::Selection(selection) => {
+                (selection.snapshot(), 5, LearningIterationStageV1::NextUse, Mode::NextUse)
+            }
+        };
+        if snapshot != &self.metadata.prefix
+            || snapshot.receipts.len() != length
+            || snapshot.training_no_update_v2().is_some()
+            || coordinator.next_stage() != Some(stage)
+            || coordinator.next_task_bundle() != Some(&snapshot.request.selected_bundle)
+        {
+            return Err(Error::Binding("exact original evaluated published-read profile"));
+        }
+        Ok(mode)
+    }
+
+    pub(super) fn binding(&self, at: u64) -> Result<Digest32, Error> {
+        self.mode()?;
+        let binding = match &self.original {
+            EvaluatedCut::Evaluation(context) => {
+                context.original_receipt_predecessors(at)
+                    .map_err(|_| Error::Binding("current original evaluated T/B read pins"))?;
+                context.receipt_context_binding()
+            }
+            EvaluatedCut::Selection(selection) => {
+                selection.original_receipt_predecessors(at)
+                    .map_err(|_| Error::Binding("current original evaluated T/B/S read pins"))?;
+                selection.original_receipt_binding()
+            }
+        };
+        Ok(Digest32::of_parts(&[
+            b"hepta.agentd.original-circuit-evaluated-current-read.v1\0",
+            binding.as_array(),
+        ]))
+    }
+}
+
+#[derive(Clone)]
+pub(super) enum ReadContext {
+    Legacy(OriginalCircuitLearningReadContextV1),
+    Evaluated(OriginalCircuitEvaluatedLearningReadContextV1),
+}
+
+impl std::ops::Deref for ReadContext {
+    type Target = OriginalCircuitLearningReadContextV1;
+
+    fn deref(&self) -> &Self::Target {
+        match self {
+            Self::Legacy(context) => context,
+            Self::Evaluated(context) => &context.metadata,
+        }
+    }
+}
+
+/// Sealed module-local view used by the existing wire codec. Only the legacy
+/// public metadata or the opaque evaluated wrapper implement this trait here.
+pub(super) trait ReadProfile {
+    fn metadata(&self) -> &OriginalCircuitLearningReadContextV1;
+    fn evaluated(&self) -> Option<&OriginalCircuitEvaluatedLearningReadContextV1>;
+}
+
+impl ReadProfile for OriginalCircuitLearningReadContextV1 {
+    fn metadata(&self) -> &OriginalCircuitLearningReadContextV1 { self }
+    fn evaluated(&self) -> Option<&OriginalCircuitEvaluatedLearningReadContextV1> { None }
+}
+
+impl ReadProfile for ReadContext {
+    fn metadata(&self) -> &OriginalCircuitLearningReadContextV1 { self }
+    fn evaluated(&self) -> Option<&OriginalCircuitEvaluatedLearningReadContextV1> {
+        match self {
+            Self::Legacy(_) => None,
+            Self::Evaluated(context) => Some(context),
+        }
+    }
+}
