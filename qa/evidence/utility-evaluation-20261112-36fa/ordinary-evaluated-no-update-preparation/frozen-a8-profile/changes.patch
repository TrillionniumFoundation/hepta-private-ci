+impl NextUseSources for OriginalCircuitEvaluatedNextUseRemoteSourcesV1<'_> {
+    fn snapshot(&self) -> &LearningIterationSnapshotV1 { self.snapshot }
+    fn trainer(&self) -> Option<&LearningIterationEvidenceClientV1> { None }
+    fn selector(&self) -> &LearningIterationEvidenceClientV1 { self.selector }
+    fn evaluated_owners(&self) -> Option<(&OriginalCellQ24TrainingCommandClientV1, &OriginalCellEvaluationCommandClientV1)> {
+        Some((self.trainer, self.evaluator))
+    }
+    fn location(&self) -> ObservationLocation { ObservationLocation::EvaluatedRemoteOwner }
+    async fn observe(&self, config: &OriginalCircuitNextUseReceiptConfigV1) -> Result<LearningIterationObservationV1, Error> {
+        let (scope, verifier, training) = self.selection.original_context().receipt_configuration();
+        if self.selection.snapshot() != &config.selection || scope != config.scope
+            || verifier.trust_digest() != config.verifier.trust_digest()
+            || verifier.scope_digest() != config.verifier.scope_digest()
+            || verifier.objective_digest() != config.verifier.objective_digest()
+            || training != config.training_evidence || self.selection.attestation() != &config.selection_evidence {
+            return Err(OwnerError::Binding("same original evaluated remote C context").into());
+        }
+        self.live.require_original_evaluated_context(
+            &OriginalCircuitEvaluatedLearningReadContextV1::from_original_selection(self.selection)?)?;
+        Ok(self.live.read_current().await?.observation().clone())
+    }
+}
