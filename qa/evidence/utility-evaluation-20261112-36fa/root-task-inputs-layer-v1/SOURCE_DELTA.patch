+use crate::AgentdError;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Definition {
+    cell_id: String,
+    bundle_digest: [u8; 32],
+    state_schema_digest: [u8; 32],
+    runtime: Runtime,
+    native: Native,
+    candidates: Vec<Candidate>,
+    max_input_bytes: usize,
+    max_queue_age_micros: u64,
