+def source_object_lookup():
+    """Admit only the previously observed local, read-only alternate closure.
+
+    This is a directory/alternates-file observation, not a donor history or
+    donor worktree inventory. Every requested object body is independently
+    checked by the unchanged full-snapshot, PACK and new-database checks.
+    """
+    expected = {entry["object_directory"]: entry for entry in SOURCE_OBJECT_LOOKUP}
+    primary = str(SOURCE / ".git" / "objects")
+    check(len(expected) == len(SOURCE_OBJECT_LOOKUP) and primary in expected,
+          "exact unique source object directories")
+    rows = []
+    edges = {}
+    for directory in SOURCE_OBJECT_LOOKUP:
+        root = pathlib.Path(directory["object_directory"])
+        check(root.is_absolute() and str(root) == os.path.normpath(str(root)),
+              "canonical absolute object directory")
+        check_real_parents(root)
+        info = root.lstat()
+        observed_directory = {"device":info.st_dev,"inode":info.st_ino,
+                              "mode":stat.S_IMODE(info.st_mode),"uid":info.st_uid}
+        check(observed_directory == directory["directory_identity"],
+              "actual observed object directory identity " + str(root))
+        row = {"object_directory":str(root),"directory_identity":observed_directory}
+        path = root / "info" / "alternates"
+        pinned = directory["alternates"]
+        if pinned["state"] == "absent":
+            if os.path.lexists(path.parent):
+                check_real_parents(path.parent)
+            check(not os.path.lexists(path), "unexpected nested alternates: " + str(path))
+            row["alternates"] = {"path":str(path),"state":"absent"}
+            resolved = []
+        else:
+            check(pinned["state"] == "file", "supported alternates observation")
+            check_real_parents(path.parent)
+            before = path.lstat()
+            raw = regular_read(path,100000)
+            after = path.lstat()
+            pin_bytes(raw,pinned,"actual read-only alternates " + str(path))
+            version = ":".join(str(v) for v in
+                (before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns,before.st_ctime_ns))
+            check(version == pinned["version"] and stat.S_IMODE(before.st_mode) == pinned["mode"]
+                  and before.st_uid == pinned["uid"] and before.st_nlink == pinned["nlink"],
+                  "exact observed alternates file metadata " + str(path))
+            fields = ("st_dev","st_ino","st_size","st_mtime_ns","st_ctime_ns")
+            check(tuple(getattr(before,k) for k in fields) ==
+                  tuple(getattr(after,k) for k in fields), "alternates changed while observing")
+            # The observed closure uses plain, canonical, absolute paths.
+            # Do not silently implement a different quoted/relative grammar.
+            resolved = list(directory["resolved_alternates"])
+            encoded = b"".join((item + "\n").encode("utf-8") for item in resolved)
+            check(raw == encoded, "exact observed absolute alternate lines")
+            row["alternates"] = {"path":str(path),"state":"file",
+                "bytes":len(raw),"sha256":sha256(raw),"git_blob":oid("blob",raw),
+                "raw_base64":base64.b64encode(raw).decode("ascii"),
+                "device":before.st_dev,"inode":before.st_ino,
+                "mode":stat.S_IMODE(before.st_mode),"nlink":before.st_nlink,
+                "mtime_ns":before.st_mtime_ns,"ctime_ns":before.st_ctime_ns}
+        check(resolved == directory["resolved_alternates"], "pinned alternate edges")
+        check(len(set(resolved)) == len(resolved), "duplicate alternate edge")
+        for value in resolved:
+            check(value in expected and pathlib.Path(value).is_absolute() and
+                  value == os.path.normpath(value), "unadmitted source alternate target")
+        row["resolved_alternates"] = resolved
+        rows.append(row)
+        edges[str(root)] = resolved
+    seen = set()
+    def visit(value, active):
+        check(value not in active, "source alternate cycle")
+        if value in seen:
+            return
+        seen.add(value)
+        for child in edges[value]:
+            visit(child, active | {value})
+    visit(primary,set())
+    check(seen == set(expected), "exact complete source alternate closure")
+    return {"format":"hepta-fixed-source-object-lookup-v1","primary":primary,
+            "directories":rows,"directory_count":len(rows),
+            "scope":"Exact local directory identities and alternates bytes only; no donor history/worktree-wide unchanged claim.",
+            "writes_requested":False}
+
