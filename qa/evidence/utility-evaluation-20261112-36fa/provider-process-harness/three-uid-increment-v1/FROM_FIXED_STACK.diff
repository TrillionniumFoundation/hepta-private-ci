+/// One parent fixture creates this immediately before its first child. Every
+/// child in that fixture must borrow this same scope. The deadlines are shared
+/// and never reset per child: startup 5s; normal join 5s; failure cleanup 5s.
+/// These are observation bounds, not protocol deadlines or permission grants.
+pub(super) struct PeerProcessScope {
+    deadlines: Arc<ProcessDeadlines>,
+}
+
+struct ProcessDeadlines {
+    startup_end: Instant,
+    join_end: OnceLock<Instant>,
+    cleanup_end: OnceLock<Instant>,
+}
+
+impl PeerProcessScope {
+    pub(super) fn new() -> Self {
+        Self { deadlines: Arc::new(ProcessDeadlines {
+            startup_end: Instant::now() + IO_WINDOW,
+            join_end: OnceLock::new(),
+            cleanup_end: OnceLock::new(),
+        }) }
+    }
+}
+
+impl ProcessDeadlines {
+    fn before_start(&self) -> anyhow::Result<()> {
+        anyhow::ensure!(self.join_end.get().is_none() && self.cleanup_end.get().is_none(),
+            "no new child after shared fixture cleanup begins");
+        within_window(self.startup_end)
+    }
+
+    fn join_end(&self) -> Instant {
+        *self.join_end.get_or_init(|| Instant::now() + IO_WINDOW)
+    }
+
+    fn cleanup_end(&self) -> Instant {
+        // Early construction failure/Drop also closes startup for the group.
+        let _ = self.join_end();
+        *self.cleanup_end.get_or_init(|| Instant::now() + CLEANUP_WINDOW)
+    }
+}
