+            remaining()
+            digest.update(chunk)
+            blob.update(chunk)
+    check(stat_identity(before) == stat_identity(path.lstat()), 'stable own output retained')
+    artifacts.append({'name': name, 'bytes': before.st_size, 'sha256': digest.hexdigest(), 'git_blob': blob.hexdigest(), 'retained_original': True})
 
