+    assert!(absolute(0, Duration::from_secs(30)).is_err());
+    assert!(absolute(now_ns()?, Duration::from_secs(30)).is_err());
+    assert!(absolute(u64::MAX, Duration::from_secs(300)).is_err());
+    Ok(())
+}
