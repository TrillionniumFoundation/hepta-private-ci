+#[test]
+fn schema_three_consumption_rows_migrate_without_inventing_dispatch() {
+    let directory = tempfile::tempdir().unwrap();
+    std::fs::set_permissions(directory.path(), std::fs::Permissions::from_mode(0o700)).unwrap();
+    let path = directory.path().join("consumption-owner.json");
+    let legacy = serde_json::json!({
+        "schema_version": 3,
+        "revision": 7,
+        "time_frontier_unix_ms": 0,
+        "operations": {},
+        "leases": {},
+        "consumptions": {
+            "operation:legacy-claimed": {
+                "operation_id": "operation:legacy-claimed",
+                "semantic_sha256": vec![21; 32],
+                "effect_sha256": vec![22; 32],
+                "request_sha256": vec![23; 32],
+                "consumer_id": "model-provider",
+                "consumer_configuration_sha256": vec![24; 32],
+                "amount": 1,
+                "reservation_id": null,
+                "state": "dispatch_attempted",
+                "receipt": null
+            },
+            "operation:legacy-success": {
+                "operation_id": "operation:legacy-success",
+                "semantic_sha256": vec![31; 32],
+                "effect_sha256": vec![32; 32],
+                "request_sha256": vec![33; 32],
+                "consumer_id": "model-provider",
+                "consumer_configuration_sha256": vec![34; 32],
+                "amount": 1,
+                "reservation_id": "reservation:legacy-success",
+                "state": "consumer_succeeded",
+                "receipt": {
+                    "request_sha256": vec![33; 32],
+                    "response_sha256": vec![35; 32],
+                    "secret_sha256": vec![36; 32],
+                    "version": 1,
+                    "secret_bytes": 8
+                }
+            }
+        }
+    });
+    std::fs::write(&path, serde_json::to_vec(&legacy).unwrap()).unwrap();
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600)).unwrap();
+
+    let mut owner = DurableLeaseRegistryV1::open(&path).unwrap();
+    assert_eq!(
+        owner
+            .consumption_result("operation:legacy-claimed")
+            .unwrap()
+            .state,
+        BaoConsumptionStateV1::Claimed
+    );
+    owner
+        .settle_consumption("operation:legacy-success")
+        .unwrap();
+    drop(owner);
+
+    let stored: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(&path).unwrap()).unwrap();
+    assert_eq!(stored["schema_version"], 4);
+    let row = &stored["consumptions"]["operation:legacy-success"];
+    assert_eq!(row["terminal_kind"], "success");
+    assert_eq!(row["terminal_observed_cost"], 1);
+}
