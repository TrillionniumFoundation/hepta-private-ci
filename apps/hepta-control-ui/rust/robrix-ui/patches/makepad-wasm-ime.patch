+impl From<ToWasmImeState> for TextInputEvent {
+    fn from(value: ToWasmImeState) -> Self {
+        use crate::event::{CharOffset, FullTextState};
+        // The pinned generic String wire codec confuses UTF-16 with scalars.
+        // Explicit scalar arrays preserve astral characters in both directions.
+        let text: String = value.text.into_iter()
+            .map(|codepoint| char::from_u32(codepoint).unwrap_or(char::REPLACEMENT_CHARACTER))
+            .collect();
+        let offset = |index: u32| {
+            let mut units = 0;
+            let mut count = 0;
+            for character in text.chars() {
+                units += character.len_utf16();
+                if units > index as usize { break; }
+                count += 1;
+            }
+            CharOffset(count)
+        };
+        let first = offset(value.selection_start);
+        let last = offset(value.selection_end);
+        let (start, end) = (first.min(last), first.max(last));
+        let comp_first = offset(value.composition_start);
+        let comp_last = offset(value.composition_end);
+        let composition = (value.has_composition && comp_first != comp_last)
+            .then(|| comp_first.min(comp_last)..comp_first.max(comp_last));
+        let selection = if value.selection_backward { end..start } else { start..end };
+        Self {
+            was_paste: value.was_paste,
+            full_state_sync: Some(FullTextState { text, selection, composition }),
+            ..Default::default()
+        }
+    }
+}
