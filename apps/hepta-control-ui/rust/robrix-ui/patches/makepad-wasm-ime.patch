+// BEGIN MAKEPAD WEB IME BRIDGE
+// DOM is the native editor/IME buffer. Rust TextInput remains the model owner.
+// Offsets on this bridge are UTF-16, matching textarea APIs; Rust converts them.
+export const MAKEPAD_WEB_IME_MAX_UNITS = 1_048_576;
+function makepad_ime_scalar(codepoint) {
+    return Number.isInteger(codepoint) && codepoint >= 0 && codepoint <= 0x10ffff
+        && (codepoint < 0xd800 || codepoint > 0xdfff) ? codepoint : 0xfffd;
+}
+export function makepad_ime_codepoints(text) {
+    if (text.length > MAKEPAD_WEB_IME_MAX_UNITS) throw new RangeError('Web IME text exceeds the native input limit');
+    return Array.from(text, character => makepad_ime_scalar(character.codePointAt(0)));
+}
+export function makepad_ime_string(codepoints) {
+    if (!Array.isArray(codepoints)) throw new TypeError('Invalid Web IME scalar payload');
+    if (codepoints.length > MAKEPAD_WEB_IME_MAX_UNITS) throw new RangeError('Web IME text exceeds the native input limit');
+    const text = codepoints.map(codepoint => String.fromCodePoint(makepad_ime_scalar(codepoint))).join('');
+    if (text.length > MAKEPAD_WEB_IME_MAX_UNITS) throw new RangeError('Web IME text exceeds the native input limit');
+    return text;
+}
+export function makepad_ime_offset(text, offset) {
+    offset = Number.isFinite(offset) ? Math.max(0, Math.min(text.length, Math.floor(offset))) : 0;
+    if (offset > 0 && offset < text.length && text.charCodeAt(offset) >= 0xdc00
+        && text.charCodeAt(offset) <= 0xdfff && text.charCodeAt(offset - 1) >= 0xd800
+        && text.charCodeAt(offset - 1) <= 0xdbff) offset--;
+    return offset;
+}
+
+export class MakepadWebIme {
+    constructor(host, text_area) {
+        this.host = host;
+        this.ta = text_area;
+        this.active = false;
+        this.editable = false;
+        this.ta.readOnly = true;
+        this.applying = false;
+        this.composition = null;
+        this.last_state = null;
+        this.pending_commit = null;
+    }
+
+    show() {
+        this.editable = true;
+        this.ta.readOnly = false;
+    }
+
+    state(text = this.ta.value, start = this.ta.selectionStart,
+        end = this.ta.selectionEnd, composition = null, was_paste = false) {
+        start = makepad_ime_offset(text, start);
+        end = makepad_ime_offset(text, end);
+        const backward = start > end || (start !== end && this.ta.selectionDirection === 'backward');
+        const comp_start = composition ? makepad_ime_offset(text, composition[0]) : 0;
+        const comp_end = composition ? makepad_ime_offset(text, composition[1]) : 0;
+        return {
+            text, selection_start: Math.min(start, end), selection_end: Math.max(start, end),
+            selection_backward: backward,
+            has_composition: comp_start !== comp_end,
+            composition_start: Math.min(comp_start, comp_end),
+            composition_end: Math.max(comp_start, comp_end),
+            was_paste,
+        };
+    }
+
+    write(state) {
+        this.applying = true;
+        try {
+            if (this.ta.value !== state.text) this.ta.value = state.text;
+            const anchor = makepad_ime_offset(state.text, state.selection_start);
+            const cursor = makepad_ime_offset(state.text, state.selection_end);
+            const start = Math.min(anchor, cursor), end = Math.max(anchor, cursor);
+            const backward = start !== end && (state.selection_backward || anchor > cursor);
+            const direction = backward ? 'backward' : 'forward';
