+    end(data) {
+        const composition = this.composition;
+        if (!composition) return;
+        const input = data || '';
+        const end = composition.prefix.length + input.length;
+        const final_state = this.state(composition.prefix + input + composition.suffix, end, end);
+        this.composition = null;
+        this.pending_commit = { data: input, state: final_state };
