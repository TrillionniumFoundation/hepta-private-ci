+        this.host.do_wasm_pump();
+    }
+
+    start() {
+        if (!this.active || !this.editable) return;
+        this.pending_commit = null;
+        const start = this.ta.selectionStart;
+        const end = this.ta.selectionEnd;
+        this.composition = {
+            native_prefix: this.ta.value.slice(0, start),
+            native_suffix: this.ta.value.slice(end),
+            prefix: this.ta.value.slice(0, start),
+            suffix: this.ta.value.slice(end),
+            data: '',
