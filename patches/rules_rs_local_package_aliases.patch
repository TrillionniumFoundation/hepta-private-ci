# What: teach the vendored rules_rs resolver about local package-identity forks.
# Scope: Cargo.lock package-name aliases only; dependency resolution remains Cargo-owned.

diff --git a/rs/private/cargo_workspace_graph.bzl b/rs/private/cargo_workspace_graph.bzl
--- a/rs/private/cargo_workspace_graph.bzl
+++ b/rs/private/cargo_workspace_graph.bzl
@@ -204,6 +204,25 @@ def _dep_package_name(dep):
     return dep.get("package") or dep["name"]
 
+_CODEX_LOCK_PACKAGE_ALIASES = {
+    # The repository gives compatibility/security forks distinct package
+    # identities, while upstream manifests still request these names.
+    "anymap2": "anymap2-compat",
+    "matrix-sdk-crypto": "matrix-sdk-crypto-hepta",
+}
+
+def _lockfile_package_name(dep, resolver_versions_by_name):
+    dep_package = _dep_package_name(dep)
+    if dep_package in resolver_versions_by_name:
+        return dep_package
+
+    alias = _CODEX_LOCK_PACKAGE_ALIASES.get(dep_package)
+    if alias in resolver_versions_by_name:
+        # Keep the dependency label name (dep["name"]) intact, but resolve
+        # features and lockfile versions against the patched package identity.
+        dep["package"] = alias
+        return alias
+    return dep_package
+
 def compute_package_fq_deps(package, versions_by_name, strict = True):
@@ -438,7 +457,7 @@ def _resolve_possible_deps(
         for dep in package["feature_resolutions"].possible_deps:
-            dep_package = _dep_package_name(dep)
+            dep_package = _lockfile_package_name(dep, resolver_versions_by_name)
 
             versions = resolver_versions_by_name.get(dep_package)
             if not versions:
