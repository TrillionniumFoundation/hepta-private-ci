@@ -0,0 +1,55 @@
+use super::*;
+
+#[test]
+fn preserve_final_archives_and_exclude_llvm_temp_files() -> Result<(), Box<dyn std::error::Error>> {
+    let stamp = SystemTime::now().duration_since(UNIX_EPOCH)?.as_nanos();
+    let input = std::env::temp_dir().join(format!(
+        "rules rust archive inputs {} {stamp}",
+        std::process::id()
+    ));
+    fs::create_dir(&input)?;
+    let _input_guard = TemporaryDirectoryGuard::new(Some(input.clone()));
+    let stable = [
+        "exec-server.lib",
+        "libcomponent.rlib",
+        "component.a",
+        "owner-资料.lib",
+        "component.lib.temp-archive-9c734b8.txt",
+        "component.lib.temp-archive-abcdef.a",
+        "component.lib.temp-archive-12345678.a",
+        "component.lib.temp-archive-ghijklm.a",
+        "component.lib.temp-archive-1234abc.a.extra",
+        "custom.temp-archive-9c734b8.a",
+    ];
+    let temporary = [
+        "exec-server.lib.temp-archive-9c734b8.a",
+        "component.a.temp-archive-ABC1234.a",
+        "libcomponent.rlib.temp-archive-123abcd.a",
+        "component.exe.tmp123",
+        "component.rcgu.o",
+    ];
+    for name in stable.iter().chain(temporary.iter()) {
+        fs::write(input.join(name), name.as_bytes())?;
+    }
+
+    let (args, unified) =
+        consolidate_dependency_search_paths(&[format!("-Ldependency={}", input.display())])?;
+    let _unified_guard = TemporaryDirectoryGuard::new(unified.clone());
+    let unified = unified.expect("a nonempty dependency path must produce a directory");
+    assert_eq!(args, vec![format!("-Ldependency={}", unified.display())]);
+    for name in stable {
+        assert_eq!(
+            fs::read(unified.join(name))?,
+            name.as_bytes(),
+            "final or unrelated archive must be preserved: {name}"
+        );
+    }
+    for name in temporary {
+        assert!(
+            !unified.join(name).exists(),
+            "temporary compiler output must not become a dependency: {name}"
+        );
+    }
+    assert_eq!(fs::read_dir(&unified)?.count(), stable.len());
+    Ok(())
+}
