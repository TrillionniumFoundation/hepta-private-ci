+use super::{consolidate_dependency_search_paths, ProcessWrapperError, TemporaryDirectoryGuard};
+use std::collections::{BTreeMap, HashSet};
+use std::fs;
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+// The production consolidator names its output using the process ID and time.
+// Serialize these filesystem tests so even calls in the same millisecond do
+// not share an output directory.
+static CONSOLIDATION_TEST_LOCK: Mutex<()> = Mutex::new(());
+
+#[test]
+fn skips_transient_linker_outputs_and_keeps_stable_dependency_files() {
+    let _lock = CONSOLIDATION_TEST_LOCK.lock().unwrap();
+    let source = test_directory();
+    let source_path = source.path.as_ref().unwrap();
+    let stable = [
+        "libdependency.rlib",
+        "libdependency.rmeta",
+        "dependency.lib",
+        "libdependency.a",
+        "dependency.dll",
+        "dependency.exe",
+        "dependency.pdb",
+        "dependency.obj",
+        "dependency.temp-archive-helper.lib",
+        "dependency.temp-archive-helper.a",
+        "dependency.temp-archive-abc123.a",
+        "dependency.temp-archive-abc12345.a",
+        "dependency.temp-archive-abc123g.a",
+    ];
+    let expected: BTreeMap<_, _> = stable
+        .iter()
+        .map(|name| ((*name).to_owned(), format!("stable {name}").into_bytes()))
+        .collect();
+    for (name, bytes) in &expected {
+        fs::write(source_path.join(name), bytes).unwrap();
+    }
+    for name in [
+        "cli-debug_clear_memories-test.lib.temp-archive-c0b5e9b.a",
+        "OTHER.LIB.TEMP-ARCHIVE-ABC1234.A",
+        "dependency.exe.tmp123",
+        "dependency.123.rcgu.o",
+    ] {
+        fs::write(source_path.join(name), "transient output").unwrap();
+    }
+    fs::create_dir(source_path.join("nested-directory")).unwrap();
+
+    let (args, directory) = consolidate_dependency_search_paths(&[
+        "--crate-type=lib".to_owned(),
+        format!("-Ldependency={}", source_path.display()),
+    ])
+    .unwrap();
+    let output = TemporaryDirectoryGuard::new(directory);
+    let output_path = output.path.as_ref().unwrap();
+    assert_eq!(
+        args,
+        vec![
+            "--crate-type=lib".to_owned(),
+            format!("-Ldependency={}", output_path.display()),
+        ]
+    );
+    let actual: BTreeMap<_, _> = fs::read_dir(output_path)
+        .unwrap()
+        .map(|entry| {
+            let entry = entry.unwrap();
+            (
+                entry.file_name().into_string().unwrap(),
+                fs::read(entry.path()).unwrap(),
+            )
+        })
+        .collect();
+    assert_eq!(actual, expected);
+}
+
+#[test]
+fn case_insensitive_duplicate_keeps_the_first_search_path() {
+    let _lock = CONSOLIDATION_TEST_LOCK.lock().unwrap();
+    let first = test_directory();
+    let second = test_directory();
+    let first_path = first.path.as_ref().unwrap();
+    let second_path = second.path.as_ref().unwrap();
+    fs::write(first_path.join("Shared.lib"), "first").unwrap();
+    fs::write(second_path.join("SHARED.LIB"), "second").unwrap();
+    let (_, directory) = consolidate_dependency_search_paths(&[
+        "-L".to_owned(),
+        format!("dependency={}", first_path.display()),
+        format!("-Ldependency={}", second_path.display()),
+    ])
+    .unwrap();
+    let output = TemporaryDirectoryGuard::new(directory);
+    let entries: Vec<_> = fs::read_dir(output.path.as_ref().unwrap())
+        .unwrap()
+        .map(|entry| {
+            let entry = entry.unwrap();
+            (entry.file_name(), fs::read(entry.path()).unwrap())
+        })
+        .collect();
+    assert_eq!(entries, vec![("Shared.lib".into(), b"first".to_vec())]);
+}
+
+#[test]
+fn missing_dependency_search_path_still_fails() {
+    let _lock = CONSOLIDATION_TEST_LOCK.lock().unwrap();
+    let source = test_directory();
+    let missing = source.path.as_ref().unwrap().join("missing");
+    let existing = dependency_directories();
+    let result =
+        consolidate_dependency_search_paths(&[format!("-Ldependency={}", missing.display())]);
+    // The upstream error path does not return its newly created output for
+    // cleanup. Remove only directories created by this call in this process.
+    for directory in dependency_directories().difference(&existing) {
+        fs::remove_dir_all(directory).unwrap();
+    }
+    let ProcessWrapperError(message) = result.unwrap_err();
+    assert!(message.contains("unable to read dependency search path"));
+    assert!(message.contains(&missing.display().to_string()));
+}
+
+fn test_directory() -> TemporaryDirectoryGuard {
+    let directory = std::env::temp_dir().join(format!(
+        "rules_rust_dependency_test_{}_{}",
+        std::process::id(),
+        SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos()
+    ));
+    fs::create_dir(&directory).unwrap();
+    TemporaryDirectoryGuard::new(Some(directory))
+}
+
+fn dependency_directories() -> HashSet<PathBuf> {
+    let prefix = format!("rules_rust_process_wrapper_deps_{}_", std::process::id());
+    fs::read_dir(std::env::current_dir().unwrap())
+        .unwrap()
+        .map(Result::unwrap)
+        .filter(|entry| entry.file_name().to_string_lossy().starts_with(&prefix))
+        .map(|entry| entry.path())
+        .collect()
+}
