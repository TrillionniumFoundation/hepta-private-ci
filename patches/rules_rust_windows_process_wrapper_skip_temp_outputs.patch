+#[cfg(any(windows, test))]
+fn transient_dependency_output(file_name_lower: &str) -> bool {
+    file_name_lower.contains(".tmp")
+        || file_name_lower.ends_with(".rcgu.o")
+        || file_name_lower
+            .split_once(".lib.temp-archive-")
+            .and_then(|(_, suffix)| suffix.strip_suffix(".a"))
+            .is_some_and(|hash| !hash.is_empty() && hash.bytes().all(|byte| byte.is_ascii_hexdigit()))
 }

