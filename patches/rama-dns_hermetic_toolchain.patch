# Forward Bazel target C toolchain headers into Rama bindgen, derive the
# resolver symbol from those headers, and use the canonical lowercase
# Windows import-library name for Linux cross-linking.
diff --git a/build.rs b/build.rs
--- a/build.rs
+++ b/build.rs
@@ -5,8 +5,23 @@
-
+
 use std::{env, path::PathBuf};
-
+
+#[derive(Debug)]
+struct ResolvCallbacks;
+
+impl bindgen::callbacks::ParseCallbacks for ResolvCallbacks {
+    fn item_name(&self, item: bindgen::callbacks::ItemInfo<'_>) -> Option<String> {
+        // Older glibc headers map this function to its legacy C symbol.
+        // Rename only the Rust item; bindgen retains the original link name.
+        match item.name {
+            "__res_nsearch" => Some("res_nsearch".to_owned()),
+            _ => None,
+        }
+    }
+}
+
 fn main() {
     println!("cargo::rerun-if-changed=build.rs");
+    println!("cargo::rerun-if-env-changed=CFLAGS");
     println!("cargo::rerun-if-changed=src/client/linux/resolv_wrapper.h");
-
+
     let target_os = env::var("CARGO_CFG_TARGET_OS").ok();
@@ -22,9 +37,16 @@
-
+
     let out_path = PathBuf::from(env::var("OUT_DIR").expect("OUT_DIR")).join("resolv_bindings.rs");
-
+
+    // Bazel supplies target sysroots and system headers through its C toolchain.
+    // Parse shell quoting so paths containing spaces remain single arguments.
+    let cflags = env::var("CFLAGS").unwrap_or_default();
+    let clang_args = shlex::split(&cflags).expect("parse target toolchain CFLAGS");
     let bindings = bindgen::Builder::default()
+        .clang_args(clang_args)
         .header("src/client/linux/resolv_wrapper.h")
         .allowlist_type("__res_state")
+        .allowlist_function("(__)?res_nsearch")
+        .parse_callbacks(Box::new(ResolvCallbacks))
         .generate_comments(true)
         .derive_default(true)
         .layout_tests(false)
