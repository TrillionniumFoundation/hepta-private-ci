+/// Expand only Bazel's leading wrapper-flags response file. The child command,
+/// including its own `@params` files, stays under the existing rustc parser.
+fn expand_wrapper_args(
+    mut argv: Vec<String>,
+    read_file: impl FnOnce(&str) -> io::Result<String>,
+) -> Result<Vec<String>, OptionError> {
+    let Some(path) = argv
+        .get(1)
+        .and_then(|arg| arg.strip_prefix("--wrapper-args="))
+    else {
+        return Ok(argv);
+    };
+    let contents = read_file(path).map_err(|err| {
+        OptionError::Generic(format!(
+            "failed to read wrapper arguments from {path:?}: {err}"
+        ))
+    })?;
+    // Bazel's multiline format writes each argument verbatim. In particular,
+    // do not apply shell quoting or the build-script reader's backslash escapes.
+    let wrapper_args: Vec<String> = contents.lines().map(str::to_owned).collect();
+    if wrapper_args.iter().any(|arg| arg == "--") {
+        return Err(OptionError::Generic(
+            "wrapper arguments file must not contain the child-command separator".to_owned(),
+        ));
+    }
+    // One level only: a value beginning with @ or --wrapper-args= is literal.
+    // The normal flag parser still validates all expanded wrapper options.
+    argv.splice(1..2, wrapper_args);
+    Ok(argv)
+}
