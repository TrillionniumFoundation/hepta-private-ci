  "audit_workflow": {
    "content": "name: HCSN boundary audit checks\n\non:\n  pull_request:\n    paths:\n      - qualification/hcsn_boundary_audit/**\n      - qualification/hcsn_budget_baselines/**\n      - .github/workflows/hcsn-boundary-audit.yml\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: hcsn-boundary-audit-${{ github.ref }}\n  cancel-in-progress: false\n\njobs:\n  checks:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    defaults:\n      run:\n        shell: bash\n    env:\n      CUDA_VISIBLE_DEVICES: \"\"\n      OMP_NUM_THREADS: \"1\"\n      OPENBLAS_NUM_THREADS: \"1\"\n      MKL_NUM_THREADS: \"1\"\n      PYTHONDONTWRITEBYTECODE: \"1\"\n    steps:\n      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2\n        with:\n          ref: ${{ github.event.pull_request.head.sha || github.sha }}\n          fetch-depth: 32\n          persist-credentials: false\n      - uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405 # v6.2.0\n        with:\n          python-version: \"3.12.3\"\n      - name: Install pinned CPU dependencies\n        run: |\n          python -m pip install --disable-pip-version-check numpy==2.5.4 mpmath==1.3.0\n          python -m pip install --disable-pip-version-check \"torch==2.8.0+cpu\" --index-url https://download.pytorch.org/whl/cpu\n      - name: Test audit admission and state budget controls\n        run: |\n          python - <<'PY'\n          from pathlib import Path\n          import subprocess\n          import sys\n          roots = (\"qualification/hcsn_boundary_audit\", \"qualification/hcsn_budget_baselines\")\n          modules = sorted(str(p.with_suffix(\"\")).replace(\"/\", \".\")\n                           for root in roots for p in Path(root).glob(\"test_*.py\"))\n          if not modules:\n              raise SystemExit(\"No audit tests were discovered\")\n          subprocess.run([sys.executable, \"-m\", \"unittest\", *modules, \"-v\"], check=True)\n          PY\n      - name: Install formatter entrypoint\n        uses: taiki-e/install-action@44c6d64aa62cd779e873306675c7a58e86d6d532 # v2.62.49\n        with:\n          tool: just@1.51.0\n      - name: Apply repository formatting after tests\n        working-directory: codex-rs\n        run: |\n          just fmt --base a83b2ecda37b0e18b05e7fedcaee0a63037c464f\n          git diff --exit-code\n          git diff --cached --exit-code\n          test -z \"$(git status --porcelain --untracked-files=normal)\"\n",
    "encoding": "utf-8",
