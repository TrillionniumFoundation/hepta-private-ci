age"]}],"tool_choice":"auto","parallel_tool_calls":true,"reasoning":{"effort":"medium"},"store":false,"stream":true,"include":["reasoning.encrypted_content"],"prompt_cache_key":"01a1cb96-a806-73b8-84c8-6ba440e22b5d","text":{"verbosity":"low"},"client_metadata":{"session_id":"01a1cb96-a806-73b8-84c8-6ba440e22b5d","thread_id":"01a1cb96-a806-73b8-84c8-6ba440e22b5d","x-codex-window-id":"01a1cb96-a806-73b8-84c8-6ba440e22b5d:0","turn_id":"01a1cb96-a84d-7749-8c9f-78a812740369","x-codex-installation-id":"3bb75a3f-0f4b-408c-ab40-1b9904e7723a","root_turn_id":"01a1cb96-a84d-7749-8c9f-78a812740369","x-codex-turn-metadata":"{\"installation_id\":\"3bb75a3f-0f4b-408c-ab40-1b9904e7723a\",\"session_id\":\"01a1cb96-a806-73b8-84c8-6ba440e22b5d\",\"thread_id\":\"01a1cb96-a806-73b8-84c8-6ba440e22b5d\",\"agent_name\":\"/root\",\"turn_id\":\"01a1cb96-a84d-7749-8c9f-78a812740369\",\"window_id\":\"01a1cb96-a806-73b8-84c8-6ba440e22b5d:0\",\"context_window_id\":\"01a1cb96-a80c-7268-a5d5-9ca601dfdb48\",\"request_kind\":\"turn\",\"root_turn_id\":\"01a1cb96-a84d-7749-8c9f-78a812740369\",\"sandbox\":\"seatbelt\",\"sandbox_mode\":\"read-only\",\"auto_review_enabled\":true,\"node_repl_auto_review_required\":false,\"node_repl_disabled\":false,\"turn_started_at_unix_ms\":1794417010771}"}}
