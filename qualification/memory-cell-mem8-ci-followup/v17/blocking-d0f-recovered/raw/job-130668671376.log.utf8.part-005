nction","name":"encrypted_output","description":"Return mixed plaintext and encrypted content for integration tests.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl__encrypted_output(args: {}): Promise<CallToolResult>; };\n```","strict":false,"parameters":{"type":"object","properties":{},"additionalProperties":false}},{"type":"function","name":"image","description":"Return a single image content block.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl__image(args: {}): Promise<CallToolResult>; };\n```","strict":false,"parameters":{"type":"object","properties":{},"additionalProperties":false}},{"type":"function","name":"image_scenario","description":"Return content blocks for manual testing of MCP image rendering scenarios.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl__image_scenario(args: {\n  caption?: string;\n  // Optional data URL like data:image/png;base64,AAAA...; if omitted, uses a built-in tiny PNG.\n  data_url?: string;\n  scenario: \"image_only\" | \"image_only_original_detail\" | \"text_then_image\" | \"invalid_base64_then_image\" | \"invalid_image_bytes_then_image\" | \"multiple_valid_images\" | \"image_then_text\" | \"text_only\";\n}): Promise<CallToolResult>; };\n```","strict":false,"parameters":{"type":"object","properties":{"caption":{"type":"string"},"data_url":{"type":"string","description":"Optional data URL like data:image/png;base64,AAAA...; if omitted, uses a built-in tiny PNG."},"scenario":{"type":"string","enum":["image_only","image_only_original_detail","text_then_image","invalid_base64_then_image","invalid_image_bytes_then_image","multiple_valid_images","image_then_text","text_only"]}},"required":["scenario"],"additionalProperties":false}},{"type":"function","name":"js","description":"Run JavaScript in the test Node REPL.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl__js(args: { code: string; }): Promise<CallToolResult>; };\n```","strict":false,"parameters":{"type":"object","properties":{"code":{"type":"string"}},"required":["code"],"additionalProperties":false}},{"type":"function","name":"sandbox_meta","description":"Return the MCP request metadata received by this test server.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl__sandbox_meta(args: {}): Promise<CallToolResult>; };\n```","strict":false,"parameters":{"type":"object","properties":{},"additionalProperties":false}},{"type":"function","name":"sync","description":"Synchronize concurrent test calls and optionally delay before or after the barrier.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl__sync(args: { barrier?: { id: string; participants: number; timeout_ms?: number; }; sleep_after_ms?: number; sleep_before_ms?: number; }): Promise<CallToolResult<{ result: string; }>>; };\n```","strict":false,"parameters":{"type":"object","properties":{"barrier":{"type":"object","properties":{"id":{"type":"string"},"participants":{"type":"number"},"timeout_ms":{"type":"number"}},"required":["id","participants"],"additionalProperties":false},"sleep_after_ms":{"type":"number"},"sleep_before_ms":{"type":"number"}},"additionalProperties":false}},{"type":"function","name":"sync_readonly","description":"Synchronize concurrent test calls and optionally delay before or after the barrier.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl__sync_readonly(args: { barrier?: { id: string; participants: number; timeout_ms?: number; }; sleep_after_ms?: number; sleep_before_ms?: number; }): Promise<CallToolResult<{ result: string; }>>; };\n```","strict":false,"parameters":{"type":"object","properties":{"barrier":{"type":"object","properties":{"id":{"type":"string"},"participants":{"type":"number"},"timeout_ms":{"type":"number"}},"required":["id","participants"],"additionalProperties":false},"sleep_after_ms":{"type":"number"},"sleep_before_ms":{"type":"number"}},"additionalProperties":false}}]},{"type":"namespace","name":"mcp__node_repl_","description":"Use these tools to exercise the rmcp test server.","tools":[{"type":"function","name":"client_capabilities","description":"Return capabilities advertised by the MCP client.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl_client_capabilities(args: {}): Promise<CallToolResult>; };\n```","strict":false,"parameters":{"type":"object","properties":{},"additionalProperties":false}},{"type":"function","name":"cwd","description":"Return the current working directory of this test server process.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl_cwd(args: {}): Promise<CallToolResult<{ cwd: string; }>>; };\n```","strict":false,"parameters":{"type":"object","properties":{},"additionalProperties":false}},{"type":"function","name":"echo","description":"Echo back the provided message and include environment data.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl_echo(args: { env_var?: string; message: string; }): Promise<CallToolResult<{ echo: string; env: string | null; }>>; };\n```","strict":false,"parameters":{"type":"object","properties":{"env_var":{"type":"string"},"message":{"type":"string"}},"required":["message"],"additionalProperties":false}},{"type":"function","name":"echo_tool","description":"Echo back the provided message via a tool name that is not a legal JS identifier.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl_echo_tool(args: { env_var?: string; message: string; }): Promise<CallToolResult<{ echo: string; env: string | null; }>>; };\n```","strict":false,"parameters":{"type":"object","properties":{"env_var":{"type":"string"},"message":{"type":"string"}},"required":["message"],"additionalProperties":false}},{"type":"function","name":"encrypted_output","description":"Return mixed plaintext and encrypted content for integration tests.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl_encrypted_output(args: {}): Promise<CallToolResult>; };\n```","strict":false,"parameters":{"type":"object","properties":{},"additionalProperties":false}},{"type":"function","name":"image","description":"Return a single image content block.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl_image(args: {}): Promise<CallToolResult>; };\n```","strict":false,"parameters":{"type":"object","properties":{},"additionalProperties":false}},{"type":"function","name":"image_scenario","description":"Return content blocks for manual testing of MCP image rendering scenarios.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl_image_scenario(args: {\n  caption?: string;\n  // Optional data URL like data:image/png;base64,AAAA...; if omitted, uses a built-in tiny PNG.\n  data_url?: string;\n  scenario: \"image_only\" | \"image_only_original_detail\" | \"text_then_image\" | \"invalid_base64_then_image\" | \"invalid_image_bytes_then_image\" | \"multiple_valid_images\" | \"image_then_text\" | \"text_only\";\n}): Promise<CallToolResult>; };\n```","strict":false,"parameters":{"type":"object","properties":{"caption":{"type":"string"},"data_url":{"type":"string","description":"Optional data URL like data:image/png;base64,AAAA...; if omitted, uses a built-in tiny PNG."},"scenario":{"type":"string","enum":["image_only","image_only_original_detail","text_then_image","invalid_base64_then_image","invalid_image_bytes_then_image","multiple_valid_images","image_then_text","text_only"]}},"required":["scenario"],"additionalProperties":false}},{"type":"function","name":"js","description":"Run JavaScript in the test Node REPL.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl_js(args: { code: string; }): Promise<CallToolResult>; };\n```","strict":false,"parameters":{"type":"object","properties":{"code":{"type":"string"}},"required":["code"],"additionalProperties":false}},{"type":"function","name":"sandbox_meta","description":"Return the MCP request metadata received by this test server.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl_sandbox_meta(args: {}): Promise<CallToolResult>; };\n```","strict":false,"parameters":{"type":"object","properties":{},"additionalProperties":false}},{"type":"function","name":"sync","description":"Synchronize concurrent test calls and optionally delay before or after the barrier.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl_sync(args: { barrier?: { id: string; participants: number; timeout_ms?: number; }; sleep_after_ms?: number; sleep_before_ms?: number; }): Promise<CallToolResult<{ result: string; }>>; };\n```","strict":false,"parameters":{"type":"object","properties":{"barrier":{"type":"object","properties":{"id":{"type":"string"},"participants":{"type":"number"},"timeout_ms":{"type":"number"}},"required":["id","participants"],"additionalProperties":false},"sleep_after_ms":{"type":"number"},"sleep_before_ms":{"type":"number"}},"additionalProperties":false}},{"type":"function","name":"sync_readonly","description":"Synchronize concurrent test calls and optionally delay before or after the barrier.\n\nexec tool declaration:\n```ts\ndeclare const tools: { mcp__node_repl_sync_readonly(args: { barrier?: { id: string; participants: number; timeout_ms?: number; }; sleep_after_ms?: number; sleep_before_ms?: number; }): Promise<CallToolResult<{ result: string; }>>; };\n```","strict":false,"parameters":{"type":"object","properties":{"barrier":{"type":"object","properties":{"id":{"type":"string"},"participants":{"type":"number"},"timeout_ms":{"type":"number"}},"required":["id","participants"],"additionalProperties":false},"sleep_after_ms":{"type":"number"},"sleep_before_ms":{"type":"number"}},"additionalProperties":false}}]},{"type":"tool_search","execution":"client","description":"# Tool discovery\n\nSearches over deferred tool metadata with BM25 and exposes matching tools for the next model call.\n\nYou have access to tools from the following sources:\n- Multi-agent tools: Spawn and manage sub-agents.\nSome of the tools may not have been provided to you upfront, and you should use this tool (`tool_search`) to search for the required tools. For MCP tool discovery, always use `tool_search` instead of `list_mcp_resources` or `list_mcp_resource_templates`.","parameters":{"type":"object","properties":{"limit":{"type":"number","description":"Maximum number of tools to return. Defaults to 8."},"query":{"type":"string","description":"Search query for deferred tools."}},"required":["query"],"additionalProperties":false}},{"type":"web_search","external_web_access":false,"search_content_types":["text","image"]}],"tool_choice":"auto","parallel_tool_calls":true,"reasoning":{"effort":"medium"},"store":false,"stream":true,"include":["reasoning.encrypted_content"],"prompt_cache_key":"01a1cb9c-02a5-744d-bf30-b8b135c95b19","text":{"verbosity":"low"},"client_metadata":{"x-codex-window-id":"01a1cb9c-02a5-744d-bf30-b8b135c95b19:0","session_id":"01a1cb9c-02a5-744d-bf30-b8b135c95b19","turn_id":"01a1cb9c-0340-7040-a2b8-647a3efdc5b5","x-codex-turn-metadata":"{\"installation_id\":\"7f9519f9-2340-459a-a0c9-e4abad88132c\",\"session_id\":\"01a1cb9c-02a5-744d-bf30-b8b135c95b19\",\"thread_id\":\"01a1cb9c-02a5-744d-bf30-b8b135c95b19\",\"agent_name\":\"/root\",\"turn_id\":\"01a1cb9c-0340-7040-a2b8-647a3efdc5b5\",\"window_id\":\"01a1cb9c-02a5-744d-bf30-b8b135c95b19:0\",\"context_window_id\":\"01a1cb9c-02ab-7192-a944-3339409329b4\",\"request_kind\":\"turn\",\"root_turn_id\":\"01a1cb9c-0340-7040-a2b8-647a3efdc5b5\",\"sandbox\":\"seatbelt\",\"sandbox_mode\":\"read-only\",\"auto_review_enabled\":true,\"node_repl_auto_review_required\":false,\"node_repl_disabled\":false,\"turn_started_at_unix_ms\":1794417361737}","root_turn_id":"01a1cb9c-0340-7040-a2b8-647a3efdc5b5","x-codex-installation-id":"7f9519f9-2340-459a-a0c9-e4abad88132c","thread_id":"01a1cb9c-02a5-744d-bf30-b8b135c95b19"}}
