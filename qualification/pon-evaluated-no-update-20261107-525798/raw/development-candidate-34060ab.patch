@@ -0,0 +1,254 @@
+//! Native learning/Control/CURRENT composition. The trainer and worker are
+//! synthetic. Files, signatures, output ACK, fences and recovery are native.
+
+use std::fs::File;
+use std::io::Write;
+use std::sync::atomic::Ordering;
+
+use codex_hepta_neuron::CellTaskCostV2;
+use codex_hepta_types::AuthorityPosture;
+use codex_hepta_types::Digest32;
+use pretty_assertions::assert_eq;
+
+use super::super::support as host;
+use super::support;
+use crate::AgentdGenerationUpdateRuntimeOptionsV1;
+use crate::neuron_generation_current::test_support::Fixture;
+use crate::plasticity_runtime::lifetime_tests::learning_iteration_tests::no_update as learning;
+use crate::prepare_learning_no_update_same_model_task_v1;
+use crate::recover_learning_no_update_same_model_task_v1;
+
+#[tokio::test]
+async fn no_update_native_next_task_recovers_one_use_and_obeys_current_revocation()
+-> anyhow::Result<()> {
+    let mut host = host::Fixture::new().await;
+    let bundle = learning::bundle();
+    host.config.manifest.bundle_digest = bundle.digest()?.into_array();
+    host.config.initial.manifest_digest = host.config.manifest.digest()?;
+    let mut next = host.config.clone();
+    next.initial.scope.run_id.push_str("-no-update");
+    next.initial.generation += 1;
+    next.initial.writer_epoch += 1;
+    next.task_digest = Digest32::of_bytes(b"new task after native NoUpdate").into_array();
+    let f = Fixture::new_with_target(host.config.clone(), next)?;
+    let old = f.stopped_old()?;
+    let selected = f.selection()?;
+    let request = learning::request(
+        &old.observe_generation()?,
+        selected.observation().payload_digest(),
+        bundle,
+    )?;
+    let mut different_request = request.clone();
+    different_request.operation_id = codex_hepta_types::StableId::new("another-learning-operation")
+        .map_err(anyhow::Error::msg)?;
+    let different_terminal = learning::complete(host.state(), different_request).await?;
+    let terminal = learning::complete(host.state(), request).await?;
+    assert_ne!(
+        terminal.snapshot().head_digest,
+        different_terminal.snapshot().head_digest
+    );
+    let before = terminal.snapshot().clone();
+    let old_bytes = (f.bytes("old-journal")?, f.bytes("old-witness")?);
+    let (prepared, next_task) = prepare_learning_no_update_same_model_task_v1(
+        terminal.clone(),
+        f.reopen_current()?,
+        f.authorities()?,
+        old,
+        selected,
+        f.target_create()?,
+    )?;
+    assert_eq!(
+        prepared.final_use_binding().destination_id,
+        "agentd.cell-generation.next-task-same-model"
+    );
+    let intent = prepared.intent_digest();
+    let grant = f.sign(prepared.final_use_binding())?;
+    let ready = prepared.publish(&grant)?;
+    let control = support::Control::default();
+    let (mut runtime, bound) = next_task.into_runtime(
+        ready,
+        support::next_config(&mut host, /*running_generation*/ 2).await?,
+        control.clone(),
+        host.clock(),
+        AgentdGenerationUpdateRuntimeOptionsV1::default(),
+    )?;
+    let (mut tasks, _lifetime) = support::start(&mut runtime, &host)?;
+    assert!(
+        bound
+            .step(support::request(
+                &f.old_config,
+                f.old_config.initial.clone()
+            ))
+            .await
+            .is_err()
+    );
+    assert_eq!(control.executions.load(Ordering::SeqCst), 0);
+    let mut step_request = support::request(&f.target_config, runtime.handle.snapshot().await?);
+    step_request.input = vec![23, 24, 25];
+    let used = bound.step(step_request.clone()).await?;
+    assert_eq!(used.authority(), AuthorityPosture::DENY_ALL);
+    assert_eq!(used.observation().snapshot().state, step_request.input);
+    assert_eq!(
+        bound.step(step_request.clone()).await?.use_id(),
+        used.use_id()
+    );
+    assert_eq!(control.executions.load(Ordering::SeqCst), 1);
+    assert_eq!(terminal.snapshot(), &before);
+    let chunk = used
+        .observation()
+        .pending_output()
+        .cloned()
+        .ok_or_else(|| anyhow::anyhow!("missing native output"))?;
+    let path = host.directory.path().join("no-update-delivery");
+    let mut delivery = File::create(&path)?;
+    delivery.write_all(&chunk.bytes)?;
+    delivery.sync_all()?;
+    File::open(host.directory.path())?.sync_all()?;
+    runtime
+        .handle
+        .acknowledge(
+            chunk.clone(),
+            Digest32::of_parts(&[b"no-update-delivery", &chunk.bytes]).into_array(),
+            CellTaskCostV2::new(used.observation().cost().identity())?,
+        )
+        .await?;
+    assert!(runtime.handle.drain().await?);
+    let retained = (
+        f.bytes("target-journal")?,
+        f.bytes("target-witness")?,
+        f.bytes("final-use/authority.claims")?,
+    );
+    tasks.shutdown().await;
+    drop(bound);
+    drop(runtime);
+    drop(tasks);
+    // Identical model/source mappings cannot substitute another learning head
+    // into the already signed original next-task operation.
+    assert!(
+        recover_learning_no_update_same_model_task_v1(
+            different_terminal,
+            f.reopen_current()?,
+            f.authorities()?,
+            f.selection()?,
+            f.target_reopen()?,
+            intent,
+        )
+        .is_err()
+    );
+    assert_eq!(
+        (
+            f.bytes("target-journal")?,
+            f.bytes("target-witness")?,
+            f.bytes("final-use/authority.claims")?
+        ),
+        retained
+    );
+    assert_eq!(f.authority.capacity()?.used_nonces, 1);
+    let (ready, next_task) = recover_learning_no_update_same_model_task_v1(
+        terminal,
+        f.reopen_current()?,
+        f.authorities()?,
+        f.selection()?,
+        f.target_reopen()?,
+        intent,
+    )?;
+    let (mut runtime, bound) = next_task.into_runtime(
+        ready,
+        support::next_config(&mut host, /*running_generation*/ 6).await?,
+        control.clone(),
+        host.clock(),
+        AgentdGenerationUpdateRuntimeOptionsV1::default(),
+    )?;
+    let (mut tasks, _lifetime) = support::start(&mut runtime, &host)?;
+    let replay = bound.step(step_request.clone()).await?;
+    assert_eq!(replay.use_id(), used.use_id());
+    assert_eq!(replay.step(), used.step());
+    assert_eq!(control.executions.load(Ordering::SeqCst), 1);
+    assert_eq!(control.reads.load(Ordering::SeqCst), 0);
+    assert_eq!(std::fs::read(path)?, chunk.bytes);
+    assert_eq!(
+        (f.bytes("old-journal")?, f.bytes("old-witness")?),
+        old_bytes
+    );
+    assert_eq!(
+        (
+            f.bytes("target-journal")?,
+            f.bytes("target-witness")?,
+            f.bytes("final-use/authority.claims")?
+        ),
+        retained
+    );
+    assert_eq!(f.authority.capacity()?.used_nonces, 1);
+    f.advance_artifact_current()?;
+    assert!(bound.step(step_request).await.is_err());
+    assert_eq!(control.executions.load(Ordering::SeqCst), 1);
+    tasks.shutdown().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn no_update_rejects_unmapped_bundle_payload_and_source_before_control_mutation()
+-> anyhow::Result<()> {
+    for mismatch in ["bundle", "payload", "source", "run", "cell"] {
+        let mut host = host::Fixture::new().await;
+        let bundle = learning::bundle();
+        host.config.manifest.bundle_digest = bundle.digest()?.into_array();
+        host.config.initial.manifest_digest = host.config.manifest.digest()?;
+        let mut next = host.config.clone();
+        next.initial.scope.run_id.push_str("-negative");
+        next.initial.generation += 1;
+        next.initial.writer_epoch += 1;
+        next.task_digest = [89; 32];
+        let f = Fixture::new_with_target(host.config.clone(), next)?;
+        let old = f.stopped_old()?;
+        let selected = f.selection()?;
+        let mut request = learning::request(
+            &old.observe_generation()?,
+            selected.observation().payload_digest(),
+            bundle,
+        )?;
+        match mismatch {
+            "bundle" => {
+                request.selected_bundle.components.heads = Digest32::of_bytes(b"other heads")
+            }
+            "payload" => request.selected_artifact_digest = Digest32::of_bytes(b"other payload"),
+            "source" => request.completed_task_receipt = Digest32::of_bytes(b"other task receipt"),
+            "run" => {
+                request.source_run_id =
+                    codex_hepta_types::StableId::new("another-run").map_err(anyhow::Error::msg)?
+            }
+            "cell" => {
+                request.cell_id =
+                    codex_hepta_types::StableId::new("another-cell").map_err(anyhow::Error::msg)?
+            }
+            _ => anyhow::bail!("unknown negative fixture"),
+        }
+        let terminal = learning::complete(host.state(), request).await?;
+        let before = (
+            f.bytes("current.json")?,
+            f.bytes("old-journal")?,
+            f.bytes("old-witness")?,
+        );
+        assert!(
+            prepare_learning_no_update_same_model_task_v1(
+                terminal,
+                f.reopen_current()?,
+                f.authorities()?,
+                old,
+                selected,
+                f.target_create()?,
+            )
+            .is_err()
+        );
+        assert_eq!(
+            (
+                f.bytes("current.json")?,
+                f.bytes("old-journal")?,
+                f.bytes("old-witness")?
+            ),
+            before
+        );
+        assert_eq!(f.authority.capacity()?.used_nonces, 0);
+    }
+    Ok(())
+}
