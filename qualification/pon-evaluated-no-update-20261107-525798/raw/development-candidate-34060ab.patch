--- /dev/null
+++ b/codex-rs/hepta-agentd/src/learning_no_update_same_model.rs
@@ -0,0 +1,337 @@
+//! Bind a native NoUpdate result to the existing same-model task owner.
+//! NoUpdate and candidate NextUse keep their original meanings. This profile
+//! requires an exact source observation, complete bundle and CURRENT payload.
+//! It neither fills absent mappings nor grants model adoption or improvement.
+
+use std::sync::Arc;
+
+use codex_hepta_neuron::AnchorWitnessStore;
+use codex_hepta_neuron::CellGenerationControlPortV2;
+use codex_hepta_neuron::CellGenerationDispositionV2;
+use codex_hepta_neuron::CellGenerationErrorV2;
+use codex_hepta_neuron::CellGenerationJournalV2;
+use codex_hepta_neuron::CellGenerationObservationV1;
+use codex_hepta_neuron::CellGenerationOwnerBindingV1;
+use codex_hepta_neuron::CellGenerationReceiptV2;
+use codex_hepta_neuron::CellGenerationRequestV2;
+use codex_hepta_types::AuthorityPosture;
+use codex_hepta_types::Digest32;
+use serde::Serialize;
+
+use crate::AgentdConfig;
+use crate::AgentdError;
+use crate::AgentdGenerationUpdateAuthoritiesV1;
+use crate::AgentdGenerationUpdateRecoveryV1;
+use crate::AgentdGenerationUpdateRequestV1;
+use crate::AgentdGenerationUpdateRuntimeOptionsV1;
+use crate::AgentdGenerationUpdateRuntimeV1;
+use crate::AgentdGenerationUpdateTargetV1;
+use crate::AgentdSelectedGenerationV1;
+use crate::CompletedLearningNoUpdateV1;
+use crate::NeuronGenerationRuntimeHandleV2;
+use crate::PreparedAgentdGenerationUpdateV1;
+use crate::ReadyAgentdGenerationUpdateV1;
+use crate::neuron_generation_current::NeuronGenerationCurrentOwnerV1;
+use crate::neuron_generation_current::NeuronGenerationPredecessorCompletionV1;
+use crate::prepare_agentd_generation_same_model_task_v1;
+use crate::recover_agentd_generation_update_v1;
+
+/// A binding to one original Control operation, with no writer or signer.
+pub struct LearningNoUpdateSameModelTaskV1 {
+    terminal: CompletedLearningNoUpdateV1,
+    operation_id: String,
+    target: CellGenerationOwnerBindingV1,
+    intent: Digest32,
+}
+
+/// Captures the handle from the actual guarded Ready owner before returning
+/// its ordinary host config. Callers cannot substitute another runtime handle.
+pub struct LearningNoUpdateSameModelRuntimeV1 {
+    task: LearningNoUpdateSameModelTaskV1,
+    handle: NeuronGenerationRuntimeHandleV2,
+    signed_grant: Digest32,
+}
+
+/// Observed native use, not delivery, evaluation quality or an improvement.
+/// Private fields and no deserializer exclude caller-assembled success rows.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize)]
+pub struct LearningNoUpdateSameModelUseV1 {
+    use_id: [u8; 32],
+    terminal_head: [u8; 32],
+    selected_bundle: [u8; 32],
+    selected_payload: [u8; 32],
+    target: CellGenerationOwnerBindingV1,
+    intent: [u8; 32],
+    signed_grant: [u8; 32],
+    step: CellGenerationReceiptV2,
+    observation: CellGenerationObservationV1,
+}
+
+impl LearningNoUpdateSameModelUseV1 {
+    /// Stable across ACK, drain and recovery; one use must not be counted again.
+    pub fn use_id(&self) -> Digest32 {
+        Digest32::from_array(self.use_id)
+    }
+
+    /// One task may have several successful steps; aggregate tasks by this
+    /// native binding, not by counting distinct step use IDs.
+    pub fn target(&self) -> &CellGenerationOwnerBindingV1 {
+        &self.target
+    }
+
+    pub fn step(&self) -> &CellGenerationReceiptV2 {
+        &self.step
+    }
+
+    pub fn observation(&self) -> &CellGenerationObservationV1 {
+        &self.observation
+    }
+
+    pub fn authority(&self) -> AuthorityPosture {
+        AuthorityPosture::DENY_ALL
+    }
+}
+
+impl LearningNoUpdateSameModelTaskV1 {
+    fn bind<W: AnchorWitnessStore>(
+        terminal: CompletedLearningNoUpdateV1,
+        selected: &AgentdSelectedGenerationV1,
+        target: &AgentdGenerationUpdateTargetV1<W>,
+    ) -> Result<Self, AgentdError> {
+        let snapshot = terminal.snapshot();
+        let request = &snapshot.request;
+        let bundle = request.selected_bundle.digest().map_err(invalid)?;
+        let scope = &target.config.initial.scope;
+        if bundle.as_array() != &selected.manifest().bundle_digest
+            || request.selected_artifact_digest != selected.observation().payload_digest()
+            || selected.manifest() != &target.config.manifest
+            || request.agent_id.as_str() != scope.agent_id
+            || request.cell_id.as_str() != scope.cell_id
+            || request.source_run_id.as_str() == scope.run_id
+        {
+            return Err(invalid(
+                "NoUpdate has no exact unchanged-model task mapping",
+            ));
+        }
+        let target = CellGenerationOwnerBindingV1::new(&target.config, target.max_records)
+            .map_err(invalid)?;
+        let operation = Digest32::of_parts(&[
+            b"hepta.learning.no-update-same-model-task.v1\0",
+            snapshot.head_digest.as_array(),
+            bundle.as_array(),
+            request.selected_artifact_digest.as_array(),
+            request.completed_task_receipt.as_array(),
+            &target.digest().map_err(invalid)?,
+            selected.observation().digest().as_array(),
+        ]);
+        Ok(Self {
+            terminal,
+            operation_id: format!("learning-no-update:{operation}"),
+            target,
+            intent: Digest32::ZERO,
+        })
+    }
+
+    fn require_predecessor(
+        &self,
+        previous: &CellGenerationOwnerBindingV1,
+        observation: Digest32,
+    ) -> Result<(), AgentdError> {
+        let request = &self.terminal.snapshot().request;
+        if observation != request.completed_task_receipt
+            || previous.scope().agent_id != request.agent_id.as_str()
+            || previous.scope().cell_id != request.cell_id.as_str()
+            || previous.scope().run_id != request.source_run_id.as_str()
+            || previous.scope().principal_digest != self.target.scope().principal_digest
+            || previous.manifest_digest() != self.target.manifest_digest()
+            || previous.task_digest() == self.target.task_digest()
+        {
+            return Err(invalid("NoUpdate source is not this completed native task"));
+        }
+        Ok(())
+    }
+
+    pub fn operation_id(&self) -> &str {
+        &self.operation_id
+    }
+
+    pub fn into_runtime<W, P, C>(
+        self,
+        ready: ReadyAgentdGenerationUpdateV1<W>,
+        config: AgentdConfig,
+        control: P,
+        clock: C,
+        options: AgentdGenerationUpdateRuntimeOptionsV1,
+    ) -> Result<
+        (
+            AgentdGenerationUpdateRuntimeV1,
+            LearningNoUpdateSameModelRuntimeV1,
+        ),
+        AgentdError,
+    >
+    where
+        W: AnchorWitnessStore + Send + 'static,
+        P: CellGenerationControlPortV2 + Send + 'static,
+        C: FnMut() -> u64 + Send + 'static,
+    {
+        let runtime = ready.into_runtime(config, control, clock, options)?;
+        if runtime.publication.intent_digest() != self.intent
+            || runtime.publication.target() != &self.target
+            || runtime.publication.completion()
+                != NeuronGenerationPredecessorCompletionV1::OwnerDrainedSameModel
+        {
+            return Err(invalid(
+                "NoUpdate next use differs from its published owner",
+            ));
+        }
+        let bound = LearningNoUpdateSameModelRuntimeV1 {
+            task: self,
+            handle: runtime.handle.clone(),
+            signed_grant: runtime.publication.signed_grant_digest(),
+        };
+        Ok((runtime, bound))
+    }
+}
+
+impl LearningNoUpdateSameModelRuntimeV1 {
+    /// Delegate one exact task step to the ordinary owner, then read its cut.
+    /// A failed, stale or indeterminate result never becomes a use receipt.
+    pub async fn step(
+        &self,
+        request: CellGenerationRequestV2,
+    ) -> Result<LearningNoUpdateSameModelUseV1, CellGenerationErrorV2> {
+        let task = &self.task;
+        if request.task_digest != task.target.task_digest()
+            || &request.predecessor.scope != task.target.scope()
+            || request.predecessor.generation != task.target.generation()
+            || request.predecessor.writer_epoch != task.target.writer_epoch()
+            || request.predecessor.manifest_digest != task.target.manifest_digest()
+        {
+            return Err(CellGenerationErrorV2::InvalidBinding);
+        }
+        let step = self.handle.step(request).await?;
+        if !matches!(
+            step.disposition,
+            CellGenerationDispositionV2::Advanced | CellGenerationDispositionV2::Stopped
+        ) {
+            return Err(CellGenerationErrorV2::InvalidBinding);
+        }
+        let observation = self.handle.observe_generation().await?;
+        if observation.task_digest() != task.target.task_digest()
+            || observation.snapshot().digest()? != step.checkpoint_after
+            || observation.pending_request_digest().is_some()
+        {
+            return Err(CellGenerationErrorV2::InvalidBinding);
+        }
+        let snapshot = task.terminal.snapshot();
+        let use_id = Digest32::of_parts(&[
+            b"hepta.learning.no-update-same-model-use.v1\0",
+            snapshot.head_digest.as_array(),
+            task.intent.as_array(),
+            &serde_json::to_vec(&step).map_err(|_| CellGenerationErrorV2::InvalidBinding)?,
+        ]);
+        Ok(LearningNoUpdateSameModelUseV1 {
+            use_id: use_id.into_array(),
+            terminal_head: snapshot.head_digest.into_array(),
+            selected_bundle: snapshot
+                .request
+                .selected_bundle
+                .digest()
+                .map_err(|_| CellGenerationErrorV2::InvalidBinding)?
+                .into_array(),
+            selected_payload: snapshot.request.selected_artifact_digest.into_array(),
+            target: task.target.clone(),
+            intent: task.intent.into_array(),
+            signed_grant: self.signed_grant.into_array(),
+            step,
+            observation,
+        })
+    }
+}
+
+/// Existing drain/ACK, CURRENT, complete manifest and fresh FinalUse apply.
+/// The terminal learning head enters the original signed operation identity.
+pub fn prepare_learning_no_update_same_model_task_v1<Old, New>(
+    terminal: CompletedLearningNoUpdateV1,
+    current: Arc<NeuronGenerationCurrentOwnerV1>,
+    authorities: AgentdGenerationUpdateAuthoritiesV1,
+    old: CellGenerationJournalV2<Old>,
+    selected: AgentdSelectedGenerationV1,
+    target: AgentdGenerationUpdateTargetV1<New>,
+) -> Result<
+    (
+        PreparedAgentdGenerationUpdateV1<Old, New>,
+        LearningNoUpdateSameModelTaskV1,
+    ),
+    AgentdError,
+>
+where
+    Old: AnchorWitnessStore,
+    New: AnchorWitnessStore,
+{
+    let mut task = LearningNoUpdateSameModelTaskV1::bind(terminal, &selected, &target)?;
+    task.require_predecessor(
+        old.owner_binding()
+            .ok_or_else(|| invalid("NoUpdate requires a guarded owner"))?,
+        Digest32::from_array(
+            old.observe_generation()
+                .map_err(invalid)?
+                .digest()
+                .map_err(invalid)?,
+        ),
+    )?;
+    let prepared = prepare_agentd_generation_same_model_task_v1(
+        current,
+        authorities,
+        old,
+        selected,
+        target,
+        AgentdGenerationUpdateRequestV1 {
+            operation_id: task.operation_id.clone(),
+        },
+    )?;
+    task.intent = prepared.intent_digest();
+    Ok((prepared, task))
+}
+
+/// Reconcile the same published operation; never mint a new claim after a crash.
+pub fn recover_learning_no_update_same_model_task_v1<W: AnchorWitnessStore>(
+    terminal: CompletedLearningNoUpdateV1,
+    current: Arc<NeuronGenerationCurrentOwnerV1>,
+    authorities: AgentdGenerationUpdateAuthoritiesV1,
+    selected: AgentdSelectedGenerationV1,
+    target: AgentdGenerationUpdateTargetV1<W>,
+    intent: Digest32,
+) -> Result<
+    (
+        ReadyAgentdGenerationUpdateV1<W>,
+        LearningNoUpdateSameModelTaskV1,
+    ),
+    AgentdError,
+> {
+    let mut task = LearningNoUpdateSameModelTaskV1::bind(terminal, &selected, &target)?;
+    let prepared = current.recover_operation(&task.operation_id, intent)?;
+    task.require_predecessor(
+        prepared.predecessor(),
+        prepared.predecessor_observation_digest(),
+    )?;
+    if prepared.completion() != NeuronGenerationPredecessorCompletionV1::OwnerDrainedSameModel {
+        return Err(invalid("NoUpdate recovery is not a same-model operation"));
+    }
+    let ready = recover_agentd_generation_update_v1(
+        current,
+        authorities,
+        selected,
+        target,
+        AgentdGenerationUpdateRecoveryV1 {
+            operation_id: task.operation_id.clone(),
+            intent_digest: intent,
+        },
+    )?;
+    task.intent = intent;
+    Ok((ready, task))
+}
+
+fn invalid(error: impl std::fmt::Display) -> AgentdError {
+    AgentdError::Invalid(error.to_string())
+}
diff --git a/codex-rs/hepta-agentd/src/learning_no_update_same_model_tests.rs b/codex-rs/hepta-agentd/src/learning_no_update_same_model_tests.rs
