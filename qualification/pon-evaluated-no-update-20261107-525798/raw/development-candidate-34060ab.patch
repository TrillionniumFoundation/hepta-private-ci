@@ -0,0 +1,33 @@
+//! A terminal learning result returned by the authenticated learning owner.
+
+use codex_hepta_learning_artifacts::LearningIterationCoordinatorV1;
+use codex_hepta_learning_artifacts::LearningIterationDispositionV1;
+use codex_hepta_learning_artifacts::LearningIterationError;
+use codex_hepta_learning_artifacts::LearningIterationSnapshotV1;
+
+use crate::LearningIterationRuntimeErrorV1;
+
+/// An in-process owner result, not a deserializable assertion or use grant.
+/// The unchanged model still needs current selection and a fresh FinalUse.
+#[derive(Clone, Debug)]
+pub struct CompletedLearningNoUpdateV1 {
+    snapshot: LearningIterationSnapshotV1,
+}
+
+impl CompletedLearningNoUpdateV1 {
+    pub(crate) fn from_owner(
+        snapshot: LearningIterationSnapshotV1,
+    ) -> Result<Self, LearningIterationRuntimeErrorV1> {
+        let restored = LearningIterationCoordinatorV1::from_snapshot(snapshot)?;
+        if restored.disposition() != LearningIterationDispositionV1::NoUpdate {
+            return Err(LearningIterationError::WrongStage.into());
+        }
+        Ok(Self {
+            snapshot: restored.snapshot().clone(),
+        })
+    }
+
+    pub fn snapshot(&self) -> &LearningIterationSnapshotV1 {
+        &self.snapshot
+    }
+}
diff --git a/codex-rs/hepta-agentd/src/learning_no_update_same_model.rs b/codex-rs/hepta-agentd/src/learning_no_update_same_model.rs
