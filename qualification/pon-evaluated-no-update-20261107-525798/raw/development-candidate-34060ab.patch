+//! Existing signed native learning fixtures. Training and the learning
+//! checkpoint port are synthetic; the generation journals remain real files.
+
+use codex_hepta_neuron::CellGenerationObservationV1;
+use pretty_assertions::assert_eq;
+
+use super::*;
+use crate::CompletedLearningNoUpdateV1;
+
+pub(crate) fn bundle() -> CellCompatibilityBundleV1 {
+    iteration_request(&AgentdFixture::new()).selected_bundle
+}
+
+pub(crate) fn request(
+    source: &CellGenerationObservationV1,
+    payload: Digest32,
+    bundle: CellCompatibilityBundleV1,
+) -> anyhow::Result<LearningIterationRequestV1> {
+    let mut request = iteration_request(&AgentdFixture::new());
+    request.agent_id = id(&source.snapshot().scope.agent_id);
+    request.cell_id = id(&source.snapshot().scope.cell_id);
+    request.source_run_id = id(&source.snapshot().scope.run_id);
+    request.completed_task_receipt = Digest32::from_array(source.digest()?);
+    request.selected_artifact_digest = payload;
+    request.selected_bundle = bundle;
+    Ok(request)
+}
+
+pub(crate) async fn complete(
+    state: &Arc<AgentdState>,
+    request: LearningIterationRequestV1,
+) -> anyhow::Result<CompletedLearningNoUpdateV1> {
+    let ports = Arc::new(IterationPorts::new(
+        None,
+        LearningEvaluationDispositionV1::NoUpdate,
+    ));
+    let (handle, owner) = learning_iteration_channel_v1(
+        state.identity().agent_id.clone(),
+        state.identity().spawn_generation,
+        ports.owners(),
+        ports.clone(),
+        ports.verifier.clone(),
+        /*capacity*/ 2,
+    )?;
+    let initial = LearningIterationCoordinatorV1::new(request.clone(), ports.owners())?;
+    assert!(CompletedLearningNoUpdateV1::from_owner(initial.snapshot().clone()).is_err());
+    let terminal = owner.process(state, request.clone(), || Ok(50)).await?;
+    // The public channel must recover an expired terminal operation without
+    // running any stage again. The fixture checkpoint itself remains in memory.
+    let cancellation = CancellationToken::new();
+    let worker = tokio::spawn(owner.run(Arc::clone(state), cancellation.clone()));
+    let recovered = handle.submit_no_update(request).await;
+    cancellation.cancel();
+    worker.await??;
+    let recovered = recovered?;
+    assert_eq!(recovered.snapshot(), &terminal);
+    assert_eq!(ok(ports.executed.lock()).len(), 4);
+    Ok(recovered)
+}
