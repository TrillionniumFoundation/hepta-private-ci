+/// Why one parameter declared learnable by the control-engineering grammar did
+/// not enter the exact signal set consumed by deterministic generation.
+#[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd)]
+pub enum GeneratorCoverageGapReasonV1 {
+    MissingOwnerEvidence,
+    PolicyDisabled,
+    ProtectedSurface,
+    UnsupportedParameter,
+}
+
+impl GeneratorCoverageGapReasonV1 {
+    const fn tag(self) -> u8 {
+        match self {
+            Self::MissingOwnerEvidence => 0,
+            Self::PolicyDisabled => 1,
+            Self::ProtectedSurface => 2,
+            Self::UnsupportedParameter => 3,
+        }
+    }
+}
+
+#[derive(Clone, Debug, Eq, Ord, PartialEq, PartialOrd)]
+pub struct GeneratorCoverageGapV1 {
+    pub parameter_id: StableId,
+    pub reason: GeneratorCoverageGapReasonV1,
+    /// Owner- or policy-produced evidence explaining why this parameter is absent.
+    pub evidence_digest: Digest32,
+}
+
+/// Explicit terminal meaning for a generator-complete no-change result.
+///
+/// Empty signal and empty scale profiles are deliberately distinct from a search
+/// that considered eligible signals and found no admissible trust-region update.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum GeneratorCoverageTerminalV1 {
+    UpdateCandidates,
+    ZeroEligibleSignals,
+    PolicyDisabledUpdates,
+    NoAdmissibleUpdate,
+}
+
+impl GeneratorCoverageTerminalV1 {
+    pub const fn tag(self) -> u8 {
+        match self {
+            Self::UpdateCandidates => 0,
+            Self::ZeroEligibleSignals => 1,
+            Self::PolicyDisabledUpdates => 2,
+            Self::NoAdmissibleUpdate => 3,
+        }
+    }
+}
+
+/// Coverage proof for the exact bounded search profile consumed by V3.
+///
+/// `expected_parameter_set_digest` is reconstructed from the union of the actual
+/// signal identities and the explicitly explained gaps. A caller therefore cannot
+/// manufacture a no-change result by silently omitting a learnable parameter.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct GeneratorCoverageReceiptV1 {
+    pub expected_parameter_set_digest: Digest32,
+    pub actual_signal_set_digest: Digest32,
+    pub gaps: Vec<GeneratorCoverageGapV1>,
+    pub scale_policy_digest: Digest32,
+    pub mutation_grammar_digest: Digest32,
+    pub selected_artifact_digest: Digest32,
+    pub window: ProposalWindowV2,
+    pub owner_frontier_digest: Digest32,
+    pub terminal: GeneratorCoverageTerminalV1,
+    pub coverage_digest: Digest32,
+}
