+#[cfg(test)]
+mod coverage_tests {
+    use super::*;
+    use crate::ParameterMutationRuleV1;
+    use crate::ParameterMutationSurfaceV1;
+    use crate::build_parameter_mutation_policy_v1;
+
+    fn id(value: &str) -> StableId {
+        StableId::new(value).unwrap_or_else(|error| panic!("id {value}: {error}"))
+    }
+    fn digest(value: &[u8]) -> Digest32 {
+        Digest32::of_bytes(value)
+    }
+    fn profile_with(signals: Vec<ParameterPlasticitySignalV3>, scales: Vec<FixedQ32>) -> ParameterGeneratorProfileV3 {
+        let artifact = digest(b"coverage-artifact");
+        let window = ProposalWindowV2 {
+            window_id: id("window:coverage"),
+            window_digest: digest(b"coverage-window"),
+        };
+        let rules = ["parameter:a", "parameter:b"]
+            .into_iter()
+            .map(|parameter| ParameterMutationRuleV1 {
+                parameter_id: id(parameter),
+                layer_id: id("layer:coverage"),
+                surface: ParameterMutationSurfaceV1::LearnableParameter,
+                minimum_delta: FixedQ32::from_raw(-(1_i64 << 24)),
+                maximum_delta: FixedQ32::from_raw(1_i64 << 24),
+            })
+            .collect();
+        ParameterGeneratorProfileV3 {
+            selected_artifact_digest: artifact,
+            window: window.clone(),
+            norm_layers: vec![LayerNormDenominatorV2 {
+                layer_id: id("layer:coverage"),
+                baseline_squared_l2_raw_q64: 1_u128 << 64,
+            }],
+            mutation_policy: build_parameter_mutation_policy_v1(
+                id("policy:coverage"),
+                digest(b"grammar:coverage"),
+                artifact,
+                window,
+                rules,
+            )
+            .expect("policy"),
+            update_scales: scales,
+            signals,
+        }
+    }
+    fn signal(parameter: &str) -> ParameterPlasticitySignalV3 {
+        ParameterPlasticitySignalV3 {
+            layer_id: id("layer:coverage"),
+            parameter_id: id(parameter),
+            eligibility: FixedQ32::ONE,
+            modulator: FixedQ32::ONE,
+            learning_rate: FixedQ32::from_raw(1_i64 << 20),
+            lower_bound: FixedQ32::from_raw(-(1_i64 << 24)),
+            upper_bound: FixedQ32::from_raw(1_i64 << 24),
+            evidence_digest: digest(parameter.as_bytes()),
+        }
+    }
+    fn gap(parameter: &str, reason: GeneratorCoverageGapReasonV1) -> GeneratorCoverageGapV1 {
+        GeneratorCoverageGapV1 {
+            parameter_id: id(parameter),
+            reason,
+            evidence_digest: digest(format!("gap:{parameter}").as_bytes()),
+        }
+    }
+
+    #[test]
+    fn coverage_binds_expected_actual_gap_scale_grammar_and_frontier() {
+        let profile = profile_with(vec![signal("parameter:a")], vec![FixedQ32::ONE]);
+        let generated = generate_parameter_candidates_v3(profile.clone()).expect("generated");
+        let receipt = build_generator_coverage_receipt_v1(
+            &profile,
+            &generated,
+            vec![id("parameter:b"), id("parameter:a")],
+            vec![gap(
+                "parameter:b",
+                GeneratorCoverageGapReasonV1::MissingOwnerEvidence,
+            )],
+            digest(b"owner-frontier"),
+        )
+        .expect("coverage");
+        assert_eq!(receipt.terminal, GeneratorCoverageTerminalV1::UpdateCandidates);
+        verify_generator_coverage_receipt_v1(&profile, &generated, &receipt).expect("verify");
+
+        let mut changed = receipt.clone();
+        changed.owner_frontier_digest = digest(b"other-frontier");
+        assert_eq!(
+            verify_generator_coverage_receipt_v1(&profile, &generated, &changed),
+            Err(ParameterGeneratorErrorV3::CoverageDigestMismatch)
+        );
+    }
+
+    #[test]
