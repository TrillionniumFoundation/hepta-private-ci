+pub fn build_generator_coverage_receipt_v1(
+    profile: &ParameterGeneratorProfileV3,
+    generated: &GeneratedParameterCandidateSetV3,
+    mut expected_parameters: Vec<StableId>,
+    mut gaps: Vec<GeneratorCoverageGapV1>,
+    owner_frontier_digest: Digest32,
+) -> Result<GeneratorCoverageReceiptV1, ParameterGeneratorErrorV3> {
+    verify_generated_parameter_candidates_v3(profile.clone(), generated)?;
+    if expected_parameters.is_empty() {
+        return Err(ParameterGeneratorErrorV3::EmptyExpectedParameterSet);
+    }
+    if owner_frontier_digest.is_zero() {
+        return Err(ParameterGeneratorErrorV3::EmptyOwnerFrontier);
+    }
+    expected_parameters.sort();
+    if let Some(duplicate) = expected_parameters
+        .windows(2)
+        .find(|pair| pair[0] == pair[1])
+        .map(|pair| pair[0].to_string())
+    {
+        return Err(ParameterGeneratorErrorV3::DuplicateExpectedParameter(
+            duplicate,
+        ));
+    }
+
+    let mut actual = profile
+        .signals
+        .iter()
+        .map(|signal| signal.parameter_id.clone())
+        .collect::<Vec<_>>();
+    actual.sort();
+    if let Some(unexpected) = actual
+        .iter()
+        .find(|parameter| expected_parameters.binary_search(parameter).is_err())
+    {
+        return Err(ParameterGeneratorErrorV3::UnexpectedSignal(
+            unexpected.to_string(),
+        ));
+    }
+
+    gaps.sort();
+    for gap in &gaps {
+        if gap.evidence_digest.is_zero() {
+            return Err(ParameterGeneratorErrorV3::CoverageGapEvidenceMissing(
+                gap.parameter_id.to_string(),
+            ));
+        }
+        if actual.binary_search(&gap.parameter_id).is_ok()
+            || expected_parameters.binary_search(&gap.parameter_id).is_err()
+        {
+            return Err(ParameterGeneratorErrorV3::UnexpectedCoverageGap(
+                gap.parameter_id.to_string(),
+            ));
+        }
+    }
+    if let Some(duplicate) = gaps
+        .windows(2)
+        .find(|pair| pair[0].parameter_id == pair[1].parameter_id)
+        .map(|pair| pair[0].parameter_id.to_string())
+    {
+        return Err(ParameterGeneratorErrorV3::DuplicateCoverageGap(
+            duplicate,
+        ));
+    }
+    for expected in &expected_parameters {
+        if actual.binary_search(expected).is_err()
+            && gaps
+                .binary_search_by(|gap| gap.parameter_id.cmp(expected))
+                .is_err()
+        {
+            return Err(ParameterGeneratorErrorV3::MissingCoverageGap(
+                expected.to_string(),
+            ));
+        }
+    }
+
+    let expected_parameter_set_digest = digest_parameter_ids(
+        b"hepta.plasticity.expected-parameter-set.v1\0",
+        &expected_parameters,
+    )?;
+    let actual_signal_set_digest = digest_parameter_ids(
+        b"hepta.plasticity.actual-signal-set.v1\0",
+        &actual,
+    )?;
+    let scale_policy_digest = digest_scale_policy(&profile.update_scales)?;
+    let has_update = generated
+        .candidates
+        .iter()
+        .any(|candidate| candidate.kind == ParameterCandidateKindV2::Update);
+    let terminal = if has_update {
+        GeneratorCoverageTerminalV1::UpdateCandidates
+    } else if profile.signals.is_empty() {
+        GeneratorCoverageTerminalV1::ZeroEligibleSignals
+    } else if profile.update_scales.is_empty() {
+        GeneratorCoverageTerminalV1::PolicyDisabledUpdates
+    } else {
+        GeneratorCoverageTerminalV1::NoAdmissibleUpdate
+    };
+    let mut receipt = GeneratorCoverageReceiptV1 {
+        expected_parameter_set_digest,
+        actual_signal_set_digest,
+        gaps,
+        scale_policy_digest,
+        mutation_grammar_digest: profile.mutation_policy.mutation_grammar_digest,
+        selected_artifact_digest: profile.selected_artifact_digest,
+        window: profile.window.clone(),
+        owner_frontier_digest,
+        terminal,
+        coverage_digest: Digest32::ZERO,
+    };
+    receipt.coverage_digest = digest_generator_coverage_receipt_v1(&receipt)?;
+    Ok(receipt)
+}
+
+pub fn verify_generator_coverage_receipt_v1(
+    profile: &ParameterGeneratorProfileV3,
+    generated: &GeneratedParameterCandidateSetV3,
+    receipt: &GeneratorCoverageReceiptV1,
+) -> Result<(), ParameterGeneratorErrorV3> {
+    let mut expected_parameters = profile
+        .signals
+        .iter()
+        .map(|signal| signal.parameter_id.clone())
+        .collect::<Vec<_>>();
+    expected_parameters.extend(receipt.gaps.iter().map(|gap| gap.parameter_id.clone()));
+    let expected = build_generator_coverage_receipt_v1(
+        profile,
+        generated,
+        expected_parameters,
+        receipt.gaps.clone(),
+        receipt.owner_frontier_digest,
+    )?;
+    if &expected != receipt {
+        return Err(ParameterGeneratorErrorV3::CoverageDigestMismatch);
+    }
+    Ok(())
+}
+
+/// Canonical bytes independently signed by the Observer that resolved the
+/// expected parameter set and owner frontier.
+pub fn generator_coverage_signing_payload_v1(
+    receipt: &GeneratorCoverageReceiptV1,
+) -> Vec<u8> {
+    let mut bytes = b"hepta.plasticity.generator-coverage.v1\0".to_vec();
+    bytes.extend_from_slice(receipt.coverage_digest.as_array());
+    bytes
+}
+
+fn digest_generator_coverage_receipt_v1(
+    receipt: &GeneratorCoverageReceiptV1,
+) -> Result<Digest32, ParameterGeneratorErrorV3> {
+    let mut bytes = b"hepta.plasticity.generator-coverage-receipt.v1\0".to_vec();
+    for digest in [
+        receipt.expected_parameter_set_digest,
+        receipt.actual_signal_set_digest,
+        receipt.scale_policy_digest,
+        receipt.mutation_grammar_digest,
+        receipt.selected_artifact_digest,
+    ] {
+        bytes.extend_from_slice(digest.as_array());
+    }
+    push_id(&mut bytes, &receipt.window.window_id)?;
+    bytes.extend_from_slice(receipt.window.window_digest.as_array());
+    bytes.extend_from_slice(receipt.owner_frontier_digest.as_array());
+    bytes.push(receipt.terminal.tag());
+    push_len(&mut bytes, receipt.gaps.len())?;
+    for gap in &receipt.gaps {
+        push_id(&mut bytes, &gap.parameter_id)?;
+        bytes.push(gap.reason.tag());
+        bytes.extend_from_slice(gap.evidence_digest.as_array());
+    }
+    Ok(Digest32::of_bytes(&bytes))
+}
+
+fn digest_parameter_ids(
+    domain: &[u8],
+    parameters: &[StableId],
+) -> Result<Digest32, ParameterGeneratorErrorV3> {
+    let mut bytes = domain.to_vec();
+    push_len(&mut bytes, parameters.len())?;
+    for parameter in parameters {
+        push_id(&mut bytes, parameter)?;
+    }
+    Ok(Digest32::of_bytes(&bytes))
+}
+
+fn digest_scale_policy(
+    scales: &[FixedQ32],
+) -> Result<Digest32, ParameterGeneratorErrorV3> {
+    let mut canonical = scales.to_vec();
+    canonical.sort();
+    let mut bytes = b"hepta.plasticity.scale-policy.v1\0".to_vec();
+    push_len(&mut bytes, canonical.len())?;
+    for scale in canonical {
+        bytes.extend_from_slice(&scale.raw().to_be_bytes());
+    }
+    Ok(Digest32::of_bytes(&bytes))
+}
