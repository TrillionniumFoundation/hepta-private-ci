name: Kernel evidence closure PR driver

on:
  pull_request:
    branches: [main]

permissions:
  contents: write

concurrency:
  group: kernel-evidence-closure-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  drive:
    if: ${{ github.head_ref == 'fix/kernel-evidence-production-closure' }}
    runs-on: ubuntu-22.04
    timeout-minutes: 125
    steps:
      - name: Check out closure branch
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
        with:
          ref: fix/kernel-evidence-production-closure
          fetch-depth: 0
          persist-credentials: true

      - uses: ./.github/actions/setup-ci

      - uses: dtolnay/rust-toolchain@e081816240890017053eacbb1bdf337761dc5582 # 1.95.0

      - name: Execute audited closure stages
        shell: bash
        run: |
          set -euo pipefail
          if git log -1 --pretty=%B | grep -Fq '[kernel-evidence-closure]'; then
            echo 'Closure commit already present; this synchronized run is a no-op.'
            exit 0
          fi
          python3 - <<'PY'
          from pathlib import Path
          import subprocess

          workflow = Path('.github/workflows/kernel-evidence-closure-bot.yml')
          lines = workflow.read_text(encoding='utf-8').splitlines()
          stages = [
              'Apply correctness and policy closure',
              'Run focused source qualification',
              'Commit source closure',
              'Refresh implementation map and verify repository gates',
              'Remove temporary worker and publish commits',
          ]

          for stage in stages:
              marker = f'- name: {stage}'
              try:
                  start = next(index for index, line in enumerate(lines) if line.strip() == marker)
              except StopIteration as exc:
                  raise SystemExit(f'missing closure stage: {stage}') from exc
              try:
                  run_line = next(
                      index
                      for index in range(start + 1, len(lines))
                      if lines[index].strip() == 'run: |'
                  )
              except StopIteration as exc:
                  raise SystemExit(f'missing run block for closure stage: {stage}') from exc
              run_indent = len(lines[run_line]) - len(lines[run_line].lstrip())
              body = []
              for line in lines[run_line + 1:]:
                  indent = len(line) - len(line.lstrip())
                  if line.strip() and indent <= run_indent:
                      break
                  prefix = min(len(line), run_indent + 2)
                  body.append(line[prefix:])
              script = '\n'.join(body) + '\n'
              if stage == 'Apply correctness and policy closure':
                  old = r'r"fn roles_have_distinct_authenticated_identities\(.*?\n\}\n\nfn read_u64_blob"'
                  new = r'r"fn roles_have_distinct_authenticated_identities\(.*?fn read_u64_blob"'
                  old = old.replace('\\"', '"')
                  new = new.replace('\\"', '"')
                  if old not in script:
                      raise SystemExit('missing matcher regex requiring hardening')
                  script = script.replace(old, new, 1)

                  host_start = 'host = "codex-rs/hepta-agentd/src/evidence_host.rs"'
                  product_start = '\n\nproduct = "codex-rs/hepta-agentd/tests/kernel_evidence_product.rs"'
                  start_index = script.find(host_start)
                  end_index = script.find(product_start, start_index)
                  if start_index < 0 or end_index < 0:
                      raise SystemExit('missing evidence_host patch section')
                  structural_host_patch = r'''host = "codex-rs/hepta-agentd/src/evidence_host.rs"
host_text = read(host)
old_import = "use codex_hepta_evidence::EvidenceIssuerRoleV1;\n"
new_import = (
    "use codex_hepta_evidence::EvidenceIssuerRoleV1;\n"
    "use codex_hepta_evidence::EvidenceVerificationProfileV1;\n"
)
if host_text.count(old_import) != 1:
    raise SystemExit(f"{host}: expected one EvidenceIssuerRoleV1 import")
host_text = host_text.replace(old_import, new_import, 1)
verify_function = host_text.index("pub(crate) async fn verify(")
verify_start = host_text.index("    let claim_class =", verify_function)
trust_start = host_text.index("    let current_trust =", verify_start)
new_verify_prelude = (
    "    if request.verification_profile.is_empty()\n"
    "        || request.verification_profile.len()\n"
    "            > codex_hepta_agent_protocol::MAX_KERNEL_EVIDENCE_PROFILE_BYTES\n"
    "    {\n"
    "        return Err(invalid(\"invalid evidence verification profile length\"));\n"
    "    }\n"
    "    let profile = EvidenceVerificationProfileV1::parse(&request.verification_profile)\n"
    "        .map_err(|error| invalid(&error))?;\n"
)
host_text = host_text[:verify_start] + new_verify_prelude + host_text[trust_start:]
old_fields = (
    "                candidate,\n"
    "                claim_class,\n"
    "                required_roles,\n"
)
new_fields = "                candidate,\n                profile,\n"
if host_text.count(old_fields) != 1:
    raise SystemExit(f"{host}: expected one legacy VerifyChainRequest field block")
host_text = host_text.replace(old_fields, new_fields, 1)
write(host, host_text)'''
                  script = script[:start_index] + structural_host_patch + script[end_index:]
              print(f'::group::{stage}', flush=True)
              subprocess.run(['bash', '-lc', script], check=True)
              print('::endgroup::', flush=True)
          PY

          git rm .github/workflows/kernel-evidence-closure-pr-driver.yml
          git commit -m 'ci: remove kernel.evidence PR driver [kernel-evidence-closure]'
          python3 scripts/hepta-implementation-maps.py verify
          git push origin HEAD:fix/kernel-evidence-production-closure
