+import contextlib, io, json, pathlib, tempfile, unittest
+from unittest.mock import patch
+import test_image_pin as fixture
+import hepta_kaggle
+from kaggle_jobs import KaggleAdapter
+from kaggle_transport import AdapterError, sdk_payload
+
+class OriginalImagePolicyTest(unittest.TestCase):
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.base = pathlib.Path(self.tmp.name)
+        self.source = self.base / 'probe.py'
+        self.source.write_text("print('probe')\n")
+        self.transport = fixture.ImageTransport()
+        self.adapter = KaggleAdapter(self.transport, self.base / 'state')
+
+    def submit(self, policy='original', image=fixture.IMAGE):
+        return self.adapter.submit(request_id='original-image-1', source=self.source, timeout=120, accelerator='NvidiaTeslaT4', docker_image=image, docker_image_pinning_type=policy)
+
+    def test_original_policy_reaches_official_sdk_and_intent(self):
+        result = self.submit()
+        wire = sdk_payload('submit', self.transport.saved)
+        self.assertEqual(result['intent']['docker_image_pinning_type'], 'original')
+        self.assertEqual(wire['dockerImagePinningType'], 'original')
+        self.assertEqual(wire['dockerImage'], fixture.IMAGE)
+        self.assertEqual(wire['machineShape'], 'NvidiaTeslaT4')
+        self.assertEqual(wire['sessionTimeoutSeconds'], 120)
+        self.assertTrue(wire['isPrivate'])
+        self.assertFalse(wire['enableInternet'])
+        self.assertTrue(self.submit()['reused'])
+        self.assertEqual(self.transport.count('submit'), 1)
+
+    def test_policy_change_cannot_reinterpret_existing_image_only_request(self):
+        old = self.submit(None)
+        self.assertNotIn('docker_image_pinning_type', old['intent'])
+        with self.assertRaises(AdapterError) as error:
+            self.submit('original')
+        self.assertEqual(error.exception.code, 'IDEMPOTENCY_CONFLICT')
+        self.assertEqual(self.transport.count('submit'), 1)
+
+    def test_original_requires_fixed_image_and_rejects_other_policies_before_rpc(self):
+        for policy, image in [('original', None), ('latest', fixture.IMAGE), ('Original', fixture.IMAGE)]:
+            with self.subTest(policy=policy, image=image):
+                with self.assertRaises(AdapterError) as error:
+                    self.submit(policy, image)
+                self.assertEqual(error.exception.code, 'INVALID_DOCKER_IMAGE_PINNING')
+        self.assertEqual(self.transport.calls, [])
+
+    def test_provider_image_mismatch_still_fails_with_original_policy(self):
+        self.submit()
+        self.transport.actual_image = 'gcr.io/kaggle-images/python@sha256:' + '0' * 64
+        with self.assertRaises(AdapterError) as error:
+            self.adapter.status('original-image-1')
+        self.assertEqual(error.exception.code, 'DOCKER_IMAGE_MISMATCH')
+
+    def test_cli_forwards_original_without_authentication(self):
+        stream = io.StringIO()
+        with patch.object(hepta_kaggle, 'KaggleTransport', return_value=self.transport):
+            with contextlib.redirect_stdout(stream):
+                code = hepta_kaggle.main(['--state-dir', str(self.base / 'cli-state'), 'submit', '--request-id', 'cli-original-1', '--source', str(self.source), '--timeout', '120', '--accelerator', 'NvidiaTeslaT4', '--docker-image', fixture.IMAGE, '--docker-image-pinning-type', 'original'])
+        self.assertEqual(code, 0)
+        self.assertEqual(json.loads(stream.getvalue())['result']['intent']['docker_image_pinning_type'], 'original')
