+import contextlib, io, json, pathlib, tempfile, unittest
+from unittest.mock import patch
+from test_jobs import FakeTransport
+from kaggle_jobs import KaggleAdapter
+from kaggle_transport import AdapterError, RemoteError, sdk_payload
+import hepta_kaggle
+IMAGE = 'gcr.io/kaggle-gpu-images/python@sha256:de153e6d303881930c51286216393d56f56b26458d0661350305a1e8144eea01'
+OTHER = 'gcr.io/kaggle-gpu-images/python@sha256:' + '0' * 64
+
+class ImageTransport(FakeTransport):
+
+    def __init__(self):
+        super().__init__()
+        self.actual_image = IMAGE
+
+    def call(self, action, values, *, mutation=False):
+        result = super().call(action, values, mutation=mutation)
+        if action == 'get':
+            result['metadata']['dockerImage'] = self.actual_image
+        return result
+
+class ImagePinTest(unittest.TestCase):
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.base = pathlib.Path(self.tmp.name)
+        self.source = self.base / 'probe.py'
+        self.source.write_text("print('device probe')\n")
+        self.transport = ImageTransport()
+        self.adapter = KaggleAdapter(self.transport, self.base / 'state')
+
+    def submit(self, image=IMAGE):
+        return self.adapter.submit(request_id='image-probe-1', source=self.source, timeout=120, accelerator='NvidiaTeslaT4', docker_image=image)
+
+    def test_pinned_image_reaches_official_sdk_wire_and_intent(self):
+        result = self.submit()
+        self.assertEqual(result['intent']['docker_image'], IMAGE)
+        wire = sdk_payload('submit', self.transport.saved)
+        self.assertEqual(wire['dockerImage'], IMAGE)
+        self.assertEqual(wire['machineShape'], 'NvidiaTeslaT4')
+        self.assertEqual(wire['sessionTimeoutSeconds'], 120)
+        self.assertTrue(wire['isPrivate'])
+        self.assertFalse(wire['enableInternet'])
+        self.assertEqual(self.adapter.status('image-probe-1')['remote_state'], 'RUNNING')
+
+    def test_same_image_reconciles_and_changed_image_conflicts(self):
+        self.submit()
+        self.assertTrue(self.submit()['reused'])
+        with self.assertRaises(AdapterError) as error:
+            self.submit(OTHER)
+        self.assertEqual(error.exception.code, 'IDEMPOTENCY_CONFLICT')
+        self.assertEqual(self.transport.count('submit'), 1)
+
+    def test_provider_image_mismatch_denies_identity_acceptance(self):
+        self.submit()
+        self.transport.actual_image = OTHER
+        with self.assertRaises(AdapterError) as error:
+            self.adapter.status('image-probe-1')
+        self.assertEqual(error.exception.code, 'DOCKER_IMAGE_MISMATCH')
+        self.assertEqual(self.transport.count('submit'), 1)
+
+    def test_mutable_foreign_and_malformed_images_rejected_before_rpc(self):
+        for value in ('gcr.io/kaggle-gpu-images/python:latest', 'gcr.io/kaggle-images/python@sha256:' + '0' * 64, IMAGE + '?x=1', {}, 'https://evil/image'):
+            with self.subTest(value=value):
+                with self.assertRaises(AdapterError) as error:
+                    self.submit(value)
+                self.assertEqual(error.exception.code, 'INVALID_DOCKER_IMAGE')
+        self.assertEqual(self.transport.calls, [])
+
+    def test_lost_ack_with_image_never_replays(self):
+        self.transport.lose_ack = True
+        with self.assertRaises(RemoteError):
+            self.submit()
+        self.transport.lose_ack = False
+        self.assertEqual(self.submit()['submission_state'], 'UNKNOWN')
+        self.assertEqual(self.transport.count('submit'), 1)
+
+    def test_legacy_intent_unchanged_when_no_image_provided(self):
+        result = self.submit(None)
+        self.assertNotIn('docker_image', result['intent'])
+        self.assertNotIn('docker_image', self.transport.saved)
+        self.assertTrue(self.submit(None)['reused'])
+        self.assertEqual(self.transport.count('submit'), 1)
+
+    def test_cli_forwards_explicit_pin_without_credentials(self):
+        output = io.StringIO()
+        with patch.object(hepta_kaggle, 'KaggleTransport', return_value=self.transport):
+            with contextlib.redirect_stdout(output):
+                code = hepta_kaggle.main(['--state-dir', str(self.base / 'cli-state'), 'submit', '--request-id', 'cli-image-1', '--source', str(self.source), '--timeout', '120', '--accelerator', 'NvidiaTeslaT4', '--docker-image', IMAGE])
+        self.assertEqual(code, 0)
+        self.assertEqual(json.loads(output.getvalue())['result']['intent']['docker_image'], IMAGE)
