+#[test]
+fn native_growth_v2_activation_rechecks_foreign_epoch_after_transaction_begin() {
+    use rusqlite::hooks::{AuthAction, AuthContext, Authorization, TransactionOperation};
+    use std::sync::Arc;
+
+    for lower_work in [false, true] {
+        let dir = tempfile::tempdir().unwrap();
+        let settings = settings();
+        let mut node =
+            Node::open_with_permanent_account_growth_v2(dir.path(), settings.clone()).unwrap();
+        let packet = make(&node, settings.genesis(), vec![]);
+        let id = admit(&mut node, &packet);
+        let active = node.active().unwrap();
+        let before = rows(&node.db);
+        let version: u64 = node
+            .db
+            .query_row("PRAGMA data_version", [], |r| r.get(0))
+            .unwrap();
+        let own_changes = node.db.total_changes();
+        let path = dir.path().join("native.sqlite");
+        let foreign_commit = Arc::new(AtomicBool::new(false));
+        let observed = foreign_commit.clone();
+        node.db
+            .authorizer(Some(move |context: AuthContext<'_>| {
+                if matches!(
+                    context.action,
+                    AuthAction::Transaction {
+                        operation: TransactionOperation::Begin
+                    }
+                ) && !observed.swap(true, Ordering::Relaxed)
+                {
+                    // The authorizer runs while BEGIN is prepared, before its
+                    // lock is acquired. Two genuine foreign commits restore the
+                    // same final rows but invalidate the original audited epoch.
+                    let foreign = Connection::open(&path).unwrap();
+                    assert_eq!(
+                        foreign
+                            .execute(
+                                "UPDATE active SET generation=generation+1 WHERE singleton=1",
+                                []
+                            )
+                            .unwrap(),
+                        1
+                    );
+                    assert_eq!(
+                        foreign
+                            .execute(
+                                "UPDATE active SET generation=generation-1 WHERE singleton=1",
+                                []
+                            )
+                            .unwrap(),
+                        1
+                    );
+                }
+                Authorization::Allow
+            }))
+            .unwrap();
+        let target = if lower_work { settings.genesis() } else { id };
+        let result = node.growth_activate_with_progress(target, &|_| Ok(()));
+        node.db
+            .authorizer(None::<fn(AuthContext<'_>) -> Authorization>)
+            .unwrap();
+        assert!(foreign_commit.load(Ordering::Relaxed));
+        let after_version: u64 = node
+            .db
+            .query_row("PRAGMA data_version", [], |r| r.get(0))
+            .unwrap();
+        assert_ne!(version, after_version);
+        let error = result.expect_err("activation returned from a changed storage epoch");
+        assert_eq!(error.to_string(), "GROWTH_STORAGE_EPOCH_CHANGED");
+        assert!(error.requires_owner_stop());
+        assert!(node.db.is_autocommit());
+        assert_eq!(node.db.total_changes(), own_changes);
+        assert_eq!(node.active().unwrap(), active);
+        assert_eq!(rows(&node.db), before);
+        drop(node);
+        // The unchanged logical state is valid only after the ordinary cold
+        // audit establishes a fresh owner epoch; the old owner cannot clear it.
+        let node = Node::open_with_permanent_account_growth_v2(dir.path(), settings).unwrap();
+        assert_eq!(node.active().unwrap(), active);
+        assert_eq!(rows(&node.db), before);
+    }
+}
