+#[test]
+fn native_growth_v2_activation_cancellation_precedes_sql_even_for_noop_or_unknown_target() {
+    use rusqlite::hooks::{AuthContext, Authorization};
+    use std::sync::Arc;
+
+    let dir = tempfile::tempdir().unwrap();
+    let settings = settings();
+    let mut node =
+        Node::open_with_permanent_account_growth_v2(dir.path(), settings.clone()).unwrap();
+    let packet = make(
+        &node,
+        settings.genesis(),
+        vec![transfer(&settings, 0, 1, public(83), 1_000)],
+    );
+    let id = admit(&mut node, &packet);
+    let active = node.active().unwrap();
+    let before = rows(&node.db);
+
+    // Both real no-op targets and a missing target must honor an already
+    // cancelled caller. The SQL authorizer observes the real connection;
+    // no mock substitutes for its transaction or retained-state reads.
+    for target in [id, settings.genesis(), [0xff; 32]] {
+        for with_source in [false, true] {
+            let sql_calls = Arc::new(AtomicUsize::new(0));
+            let sql = sql_calls.clone();
+            node.db
+                .authorizer(Some(move |_: AuthContext<'_>| {
+                    sql.fetch_add(1, Ordering::Relaxed);
+                    Authorization::Allow
+                }))
+                .unwrap();
+            let callbacks = AtomicUsize::new(0);
+            let identity = Arc::new(());
+            let result = node.growth_activate_with_progress(target, &|point| {
+                assert_eq!(point, GrowthProgress::BeforeContext);
+                callbacks.fetch_add(1, Ordering::Relaxed);
+                if with_source {
+                    Err(Error::from(std::io::Error::new(
+                        std::io::ErrorKind::Interrupted,
+                        ProofControlSource(identity.clone()),
+                    )))
+                } else {
+                    Err(Error::new(ErrorCode::PublicRequestCancelled))
+                }
+            });
+            node.db
+                .authorizer(None::<fn(AuthContext<'_>) -> Authorization>)
+                .unwrap();
+            let error = result.expect_err("cancelled activation returned success");
+            assert_eq!(callbacks.load(Ordering::Relaxed), 1);
+            assert_eq!(sql_calls.load(Ordering::Relaxed), 0);
+            if with_source {
+                assert_eq!(error.kind(), crate::ErrorKind::Transport);
+                let source = std::error::Error::source(&error)
+                    .unwrap()
+                    .downcast_ref::<std::io::Error>()
+                    .unwrap()
+                    .get_ref()
+                    .unwrap()
+                    .downcast_ref::<ProofControlSource>()
+                    .unwrap();
+                assert!(Arc::ptr_eq(&identity, &source.0));
+            } else {
+                assert!(error.is(ErrorCode::PublicRequestCancelled));
+                assert_eq!(error.kind(), crate::ErrorKind::Cancelled);
+            }
+            assert!(node.db.is_autocommit());
+            assert_eq!(node.active().unwrap(), active);
+            assert_eq!(rows(&node.db), before);
+        }
+    }
+
+    // A later live caller still gets the original no-op behavior and can
+    // advance the actual signed chain; cancellation consumes no native state.
+    assert_eq!(node.growth_activate(id).unwrap(), id);
+    assert_eq!(node.growth_activate(settings.genesis()).unwrap(), id);
+    let next = make(
+        &node,
+        id,
+        vec![transfer(&settings, 0, 2, public(84), 1_000)],
+    );
+    let next_id = admit(&mut node, &next);
+    let after = rows(&node.db);
+    drop(node);
+    let node = Node::open_with_permanent_account_growth_v2(dir.path(), settings).unwrap();
+    assert_eq!(node.active().unwrap().0, next_id);
+    assert_eq!(node.next_nonce(public(0)).unwrap(), 3);
+    assert_eq!(rows(&node.db), after);
+}
