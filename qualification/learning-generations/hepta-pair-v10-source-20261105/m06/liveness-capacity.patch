+#[test]
+fn capacity_ranges_preserve_first_error_and_exact_account_access_order() {
+    let cfg = config(PROFILE, crate::public_evaluation::PROFILE);
+    let base = liabilities();
+    for fail_after in [None, Some(1), Some(2), Some(3), Some(4), Some(5)] {
+        assert_eq!(
+            observed(&base, &cfg, true, fail_after, None),
+            observed(&base, &cfg, false, fail_after, None)
+        );
+    }
+    let mut cases = vec![base.clone()];
+    for key in ["quota:", "release:future", "reward:zero", "task:nested:key"] {
+        for bad in [
+            json!(null),
+            json!({}),
+            json!({"remaining":1,"owner":"BAD"}),
+            json!({"remaining":0}),
+            json!({"remaining":-1}),
+            json!({"remaining":1.0}),
+        ] {
+            let mut state = base.clone();
+            state.insert(key.into(), bad);
+            // A later error cannot hide an earlier malformed liability.
+            state.insert("task:zz-invalid".into(), json!(null));
+            cases.push(state);
+        }
+    }
+    for due in [0, 1, 20, 22, u64::MAX] {
+        let mut state = base.clone();
+        state.get_mut("reward:zero").unwrap()["maturity"] = json!(due);
+        cases.push(state);
+    }
+    let mut duplicate = base.clone();
+    duplicate.insert("reward:duplicate".into(), base["reward:zero"].clone());
+    cases.push(duplicate);
+    let mut missing = base;
+    missing.remove("reward:zero");
+    cases.push(missing);
+    for state in cases {
+        for fail_after in [None, Some(1), Some(3)] {
+            assert_eq!(
+                observed(&state, &cfg, true, fail_after, None),
+                observed(&state, &cfg, false, fail_after, None)
+            );
+            let monetary: State = state
+                .iter()
+                .filter(|(key, _)| crate::pon_executor::is_monetary_obligation(key))
+                .map(|(key, value)| (key.clone(), value.clone()))
+                .collect();
+            assert_eq!(
+                observed(&state, &cfg, true, fail_after, Some(&monetary)),
+                observed(&state, &cfg, false, fail_after, Some(&monetary))
+            );
+        }
+    }
+}
