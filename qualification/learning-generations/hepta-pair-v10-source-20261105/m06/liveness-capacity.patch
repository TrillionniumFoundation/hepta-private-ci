+#[test]
+#[ignore = "paired complete-capacity observation; not original Host or confirmation acceptance"]
+fn capacity_range_full_return_abba_observation() {
+    use std::{hint::black_box, time::Instant};
+    let cfg = config(PROFILE, crate::public_evaluation::PROFILE);
+    const CALLS: usize = 16;
+    // Fixed before execution: four state sizes, twelve ABBA blocks each, all
+    // returns (including destruction) timed. No warmup/sample selection/rerun
+    // or machine-specific timing threshold can confer service acceptance.
+    for count in [0, 64, 1_024, 16_384] {
+        let mut state = unrelated_accounts(count);
+        state.extend(liabilities());
+        let expected = full_capacity(&state, 1, &cfg, None, None).unwrap();
+        let mut samples = Vec::new();
+        for round in 0..12 {
+            for (slot, ranged) in [false, true, true, false].into_iter().enumerate() {
+                let start = Instant::now();
+                let mut complete = true;
+                for _ in 0..CALLS {
+                    let result = if ranged {
+                        capacity(black_box(&state), 1, black_box(&cfg))
+                    } else {
+                        full_capacity(black_box(&state), 1, black_box(&cfg), None, None)
+                    };
+                    complete &= result.as_ref() == Ok(&expected);
+                    drop(black_box(result));
+                }
+                let wall_ns = start.elapsed().as_nanos();
+                assert!(complete);
+                samples.push(json!({"round":round,"slot":slot,"range":ranged,"calls":CALLS,"wall_ns":wall_ns,"all_results_equal":complete}));
+            }
+        }
+        println!(
+            "{}",
+            json!({"schema":"trnm-capacity-range-abba-v1","state_keys":state.len(),"unrelated_accounts":count,"liability_rows":liability_rows(&state).count(),"samples":samples,"scope":"complete in-memory native capacity result including reserve sets and destruction; excludes maintenance material, state clones/roots, SQL, Host checks, W1 and independent confirmation","ordinary_legacy_task_profile_affected":false,"public_service_qualified":false})
+        );
+    }
