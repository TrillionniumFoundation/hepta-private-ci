+#[test]
+fn ordinary_capacity_range_work_does_not_visit_unrelated_state_rows() {
+    for count in [0, 64, 1_024, 16_384, 65_536] {
+        let mut state = unrelated_accounts(count);
+        state.extend(liabilities());
+        let selected: Vec<_> = liability_rows(&state)
+            .map(|(key, _)| key.as_str())
+            .collect();
+        assert_eq!(selected.len(), 9);
+        assert!(selected.iter().all(|key| !key.starts_with("account:")));
+        let cfg = config(PROFILE, crate::public_evaluation::PROFILE);
+        assert_eq!(
+            capacity(&state, 1, &cfg),
+            full_capacity(&state, 1, &cfg, None, None)
+        );
+    }
+}
