+use super::*;
+use std::{convert::Infallible, sync::Mutex};
+
+fn config(task: &str, evaluation: &str) -> Config {
+    Config::installed_with_profiles(evaluation, task).unwrap()
+}
+
+// The original complete-map traversal remains the public observation path.
+// It is a separate selection oracle for the new ordinary native traversal;
+// both must feed the unchanged capacity arithmetic in the same key order.
+fn full_capacity(
+    state: &State,
+    height: u64,
+    cfg: &Config,
+    access: Option<&crate::pon_executor::AccountPointAccess<'_>>,
+    monetary: Option<&State>,
+) -> Result<Capacity> {
+    match scan_capacity_with_sources(state, height, cfg, access, monetary, &mut || {
+        Ok::<(), Infallible>(())
+    }) {
+        Ok(value) => Ok(value),
+        Err(CapacityScanError::State(error)) => Err(error),
+        Err(CapacityScanError::Cancelled(impossible)) => match impossible {},
+    }
+}
+
+fn unrelated_accounts(count: usize) -> State {
+    (0..count)
+        .map(|index| {
+            (
+                format!("account:{index:064x}"),
+                json!({"balance":0,"nonce":index}),
+            )
+        })
+        .collect()
+}
+
+fn liabilities() -> State {
+    let present = hex::encode([1; 32]);
+    let absent = hex::encode([2; 32]);
+    State::from([
+        (
+            format!("account:{present}"),
+            json!({"balance":0,"nonce":71}),
+        ),
+        ("contribution:".into(), json!(null)),
+        ("contribution:unarchived\0λ".into(), json!({})),
+        ("contribution:archived".into(), json!({})),
+        ("evaluation-archive:archived".into(), json!({})),
+        ("quota:".into(), json!({"remaining":1,"owner":present})),
+        ("quota:zero".into(), json!({"remaining":0})),
+        (
+            "release:future".into(),
+            json!({"remaining":2,"owner":absent}),
+        ),
+        (
+            "reward:zero".into(),
+            json!({"maturity":21,"amount":0,"owner":absent}),
+        ),
+        (
+            "task:nested:key".into(),
+            json!({"remaining":3,"owner":absent}),
+        ),
+        ("task:zero".into(), json!({"remaining":0})),
+    ])
+}
+
+#[test]
+fn liability_ranges_keep_original_order_and_every_prefix_boundary() {
+    let mut state = State::new();
+    for stem in ["contribution", "quota", "release", "reward", "task"] {
+        for suffix in [
+            "",
+            "!",
+            ":",
+            ":\0",
+            ":a",
+            ":a:b",
+            ":λ",
+            ":\u{10ffff}",
+            ";",
+            ";x",
+        ] {
+            let key = format!("{stem}{suffix}");
+            state.insert(key.clone(), json!(key));
+        }
+    }
+    for key in [
+        "",
+        "\0",
+        "account:",
+        "account:bad",
+        "evaluation-archive:task:a",
+        "quota",
+        "模",
+        "\u{10ffff}",
+    ] {
+        state.insert(key.into(), json!(null));
+    }
+    let original: Vec<_> = state
+        .iter()
+        .filter(|(key, _)| {
+            key.starts_with("reward:")
+                || key.starts_with("task:")
+                || key.starts_with("quota:")
+                || key.starts_with("release:")
+                || key.starts_with("contribution:")
+        })
+        .collect();
+    let selected: Vec<_> = liability_rows(&state).collect();
+    assert_eq!(selected, original);
+    for (key, value) in selected {
+        let (actual_key, actual_value) = state.get_key_value(key).unwrap();
+        assert!(std::ptr::eq(key, actual_key));
+        assert!(std::ptr::eq(value, actual_value));
+    }
+    assert_eq!(liability_rows(&State::new()).count(), 0);
+}
+
+#[test]
+fn capacity_ranges_match_full_state_and_authenticated_monetary_sources() {
+    let mut state = unrelated_accounts(16_384);
+    state.extend(liabilities());
+    for key in [
+        "contribution;bad",
+        "quota;bad",
+        "release;bad",
+        "reward;bad",
+        "task;bad",
+        "zz:bad",
+    ] {
+        state.insert(key.into(), json!(null));
+    }
+    for task in [PROFILE, crate::growth_profile_v2::PROFILE] {
+        for evaluation in [
+            "legacy-first-two-v3",
+            crate::public_evaluation::PROFILE,
+            crate::public_evaluation::QUORUM_PROFILE,
+        ] {
+            let cfg = config(task, evaluation);
+            let monetary: State = state
+                .iter()
+                .filter(|(key, _)| crate::pon_executor::is_monetary_obligation(key))
+                .map(|(key, value)| (key.clone(), value.clone()))
+                .collect();
+            for source in [None, Some(&monetary)] {
+                let expected = full_capacity(&state, 1, &cfg, None, source).unwrap();
+                let actual = capacity_with_sources(&state, 1, &cfg, None, source).unwrap();
+                assert_eq!(actual, expected);
+                assert_eq!(actual.actual_keys, state.len());
+                assert_eq!(actual.credit_account_reserve, 1);
+                assert_eq!(actual.reward_queue_reserve, 19);
+                assert_eq!(
+                    actual.archive_reserve,
+                    if crate::public_evaluation::enabled(&cfg) {
+                        2
+                    } else {
+                        0
+                    }
+                );
+            }
+        }
+    }
+}
+
+fn observed(
+    state: &State,
+    cfg: &Config,
+    ranged: bool,
+    fail_after: Option<usize>,
+    monetary: Option<&State>,
+) -> (Result<Capacity>, Vec<String>) {
+    let seen = Mutex::new(Vec::new());
+    let access = |owner: &str| {
+        let mut seen = seen.lock().unwrap();
+        seen.push(owner.to_owned());
+        if fail_after == Some(seen.len()) {
+            Err("CAPACITY_TEST_ACCOUNT_ACCESS")
+        } else {
+            Ok(())
+        }
+    };
+    let result = if ranged {
+        capacity_with_sources(state, 1, cfg, Some(&access), monetary)
+    } else {
+        full_capacity(state, 1, cfg, Some(&access), monetary)
+    };
+    (result, seen.into_inner().unwrap())
+}
