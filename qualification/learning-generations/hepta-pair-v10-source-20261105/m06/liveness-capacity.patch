+#[test]
+fn ordinary_capacity_keeps_full_key_limit_and_profile_error_precedence() {
+    let mut cfg = config(PROFILE, crate::public_evaluation::PROFILE);
+    let mut state = bootstrap_state(&cfg).unwrap();
+    for index in 0..MAX_KEYS - 21 {
+        state.insert(format!("unused:{index:05}"), json!(null));
+    }
+    assert_eq!(state.len(), MAX_KEYS - 20);
+    assert_eq!(liability_rows(&state).count(), 0);
+    assert_eq!(capacity(&state, 0, &cfg).unwrap().required_keys, MAX_KEYS);
+    assert_eq!(check_state(&state, 0, &cfg), Ok(()));
+    state.insert("unused:overflow".into(), json!(null));
+    assert_eq!(
+        capacity(&state, 0, &cfg).unwrap().required_keys,
+        MAX_KEYS + 1
+    );
+    assert_eq!(check_state(&state, 0, &cfg), Err("STATE_CAPACITY"));
+    state.insert("quota:".into(), json!(null));
+    assert_eq!(check_state(&state, 0, &cfg), Err("CONTINUITY_STATE"));
+    cfg.params["reward_maturity_blocks"] = json!(null);
+    assert_eq!(capacity(&state, 0, &cfg), Err("CONFIG"));
+    let old = Config::installed().unwrap();
+    assert_eq!(capacity(&state, 0, &old), Err("CONTINUITY_PROFILE"));
+}
