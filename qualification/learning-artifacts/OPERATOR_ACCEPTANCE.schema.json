{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hepta.invalid/schemas/learning-artifacts-operator-acceptance-v1.json",
  "title": "learning.artifacts independent operator acceptance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidateSha",
    "candidateTree",
    "qualificationReceiptDigests",
    "targetHostReceiptDigest",
    "operatorIdentity",
    "observedAt",
    "decision",
    "signatureEnvelope"
  ],
  "properties": {
    "schema": {
      "const": "hepta.learning-artifacts.operator-acceptance.v1"
    },
    "candidateSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidateTree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "qualificationReceiptDigests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "targetHostReceiptDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operatorIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 4096
    },
    "signatureEnvelope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    }
  }
}
