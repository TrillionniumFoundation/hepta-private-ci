      "import importlib.metadata\nimport json\nfrom pathlib import Path\nimport platform\nimport time\nreport = dict(schema='hcsn-kaggle-s81-capability-v2', observed_unix=time.time(),\n    python=platform.python_version(), packages={}, cuda_verified=False, gpu_devices=[],\n    full_physical_energy_joules=None, formal_training_fits=0)\nfor name in ('torch','numpy','scipy','nvidia-ml-py'):\n    try: report['packages'][name]=importlib.metadata.version(name)\n    except importlib.metadata.PackageNotFoundError: report['packages'][name]=None\ntry:\n    import numpy,scipy,torch\n    report.update(torch_version=str(torch.__version__),cuda_version=torch.version.cuda,\n        numpy_version=numpy.__version__,scipy_version=scipy.__version__,\n        cuda_available=torch.cuda.is_available(),gpu_count=torch.cuda.device_count())\n    for index in range(torch.cuda.device_count()):\n        device='cuda:'+str(index);p=torch.cuda.get_device_properties(index)\n        x=torch.arange(4096,dtype=torch.float32,device=device).reshape(64,64)\n        y=x@torch.eye(64,dtype=torch.float32,device=device);torch.cuda.synchronize(index)\n        report['gpu_devices'].append(dict(index=index,name=p.name,memory_bytes=p.total_memory,\n            compute_capability=list(torch.cuda.get_device_capability(index)),matrix_identity_pass=bool(torch.equal(x,y)),\n            probe_peak_allocated_bytes=torch.cuda.max_memory_allocated(index)))\n    report['cuda_verified']=bool(report['gpu_devices']) and all(x['matrix_identity_pass'] and 'T4' in x['name'] for x in report['gpu_devices'])\nexcept Exception as error: report['error']=dict(type=type(error).__name__,message=str(error))\nreport['cpu_energy_counter_files']=[str(p) for p in Path('/sys/class/powercap').glob('*/energy_uj') if p.is_file()]\nPath('evidence/capability.json').write_text(json.dumps(report,indent=2,sort_keys=True,allow_nan=False)+'\\n')\nprint(json.dumps(report,sort_keys=True,allow_nan=False),flush=True)\nassert report['cuda_verified'],'Requested T4 did not prove real CUDA computation'\n"
