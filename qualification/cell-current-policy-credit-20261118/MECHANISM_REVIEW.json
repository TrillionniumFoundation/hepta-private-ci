  "observations": [
    {
      "task": "A-mse",
      "fact": "Parent first patch passes original and rejects wrong-loss/wrong-gradient but not constant-first-mse (2/3 controls). Credit changes arguments to [[1,3]],[[0,2]], predicts loss1/gradient[[1,1]] and rejects all3. F->P becomes P->P, removing one natural recovery opportunity."
    },
    {
      "task": "A-readout-score",
      "fact": "All-observed adds extra JSON trailing text on the second call; credit retains the valid successful assertion."
    },
    {
      "task": "A-clipped-metrics",
      "fact": "All-observed appends a false assertion for [[0]],[[1]], expecting raw_mse0 and correct1; original observation is raw_mse1 and correct0. Credit retains the first valid assertion."
    },
    {
      "task": "A-pair-map",
      "fact": "All-observed appends Python code containing JSON true/null and fails the fixed literal-argument gate. Credit retains the valid original assertion."
    },
    {
      "task": "A-colon-repair",
      "fact": "Credit still emits a subject call without the required index argument, giving original TypeError, then malformed JSON. Rejecting wrong controls does not compensate for failure on the original."
    },
    {
      "task": "B2 escape-leading-slashes",
      "fact": "Parent calls the original function name rather than the permitted subject harness and is rejected; credit calls subject with a correct expected escaped result."
    },
    {
      "task": "B2 to-snake",
      "fact": "Credit's second call appends subject(null), causing the unchanged Python literal gate to reject it."
    },
    {
      "task": "B2 quantify",
      "fact": "The second call appends range and lambda code outside the fixed literal-argument AST contract. The previously successful task regresses."
    },
    {
      "task": "B2 first-true",
      "fact": "Credit predicts a list [1] for subject([1,None,2]), which returns the first truthy element1. This is a real semantic error. Parent's first accepted True==1 assertion remains accepted under the original Python-equality verifier; finite controls are not exhaustive type or full-repository coverage."
    }
  ],
  "interpretation": "The credit treatment is consistent with preserving validated actions and suppressing harmful extra assertions on exposed A. It does not supply a unique B2 final-score gain; new semantic errors and format regressions remain.",
