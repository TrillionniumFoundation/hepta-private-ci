+                    candidate_bundle: version.bundle_digest(),
+                    selection_digest: version.selection_digest(),
+                })
+        {
+            return Err(Error::Binding(
+                "same actual evaluated Version Source and Cell publication",
+            ));
+        }
+        Ok(())
+    }
+}
