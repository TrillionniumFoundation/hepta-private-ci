+pub(crate) fn refuse_evidence_without_pin<W: AnchorWitnessStore + Send + 'static>(
+    owner: &OriginalCircuitEvaluatedNextUseCommandOwnerV1<W>,
+) -> anyhow::Result<()> {
+    let before = owner
