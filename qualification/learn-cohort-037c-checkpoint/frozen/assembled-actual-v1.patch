+    assert!(
+        runtime
+            .state
+            .circuit_task_invocation
+            .set(invocation)
+            .is_ok()
+    );
+    let cancellation = CancellationToken::new();
+    let worker = tokio::spawn(bootstrap.run(Arc::clone(&runtime.state), cancellation.clone()));
+    Ok(Session {
+        runtime,
+        config: Some(config),
+        request,
+        source,
+        cell,
+        retirement,
+        cancellation,
+        worker: Some(worker),
+    })
