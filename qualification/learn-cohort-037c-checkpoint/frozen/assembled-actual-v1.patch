+    assert!(matches!(
+        owner.evidence_response(b"{}", 1),
+        Err(Error::Missing)
+    ));
+    assert_eq!(
+        owner
+            .execution_requested
+            .load(std::sync::atomic::Ordering::Acquire),
+        before
+    );
+    anyhow::ensure!(owner.retained.lock().unwrap().is_none());
+    Ok(())
+}
