+#[derive(Deserialize, Serialize)]
+#[serde(tag = "state", rename_all = "snake_case", deny_unknown_fields)]
+pub(super) enum CommandResult {
+    Completed {
+        snapshot: String,
+        evidence: evidence_wire::Evidence,
+    },
+    Missing,
+    Pending,
+    Busy,
+    Expired,
+    ReadbackRequired,
+    Uncertain,
+    Unavailable,
+}
+
+pub(super) fn encode_completed(
+    context: &Context,
+    original: &OriginalCircuitEvaluatedNextUseReceiptV1,
+    current: u64,
+) -> Result<CommandResult, Error> {
+    let checked = authenticate_completed(
+        context,
+        original.snapshot().clone(),
+        original.attestation().clone(),
+        current,
+    )?;
+    if !same_original(original, &checked) {
+        return Err(Error::Binding("same original evaluated C Observer output"));
+    }
+    Ok(CommandResult::Completed {
+        snapshot: STANDARD_NO_PAD.encode(encode_original_owner_snapshot_v1(original.snapshot())?),
+        evidence: evidence_wire::Evidence::from_original(original.attestation()),
+    })
+}
+
+pub(super) fn decode_completed(
+    context: &Context,
+    snapshot: String,
+    evidence: evidence_wire::Evidence,
+    current: u64,
+) -> Result<OriginalCircuitEvaluatedNextUseReceiptV1, Error> {
+    if snapshot.len() > 10_924 {
+        return Err(Error::Binding("bounded original evaluated NextUse cut"));
+    }
+    let bytes = STANDARD_NO_PAD
+        .decode(&snapshot)
+        .map_err(|_| Error::Binding("original evaluated NextUse cut encoding"))?;
+    if STANDARD_NO_PAD.encode(&bytes) != snapshot {
+        return Err(Error::Binding("canonical original evaluated NextUse cut"));
+    }
+    let completed = decode_original_owner_snapshot_v1(&bytes)?;
+    let signed = evidence
+        .decode()
+        .map_err(|_| Error::Binding("original evaluated C Observer signature encoding"))?;
+    authenticate_completed(context, completed, signed, current)
+}
+
+pub(super) fn authenticate_completed(
+    context: &Context,
+    snapshot: LearningIterationSnapshotV1,
+    signed: SignedLearningEvidenceV1,
+    current: u64,
+) -> Result<OriginalCircuitEvaluatedNextUseReceiptV1, Error> {
+    context.authenticate(current)?;
+    Ok(
+        OriginalCircuitEvaluatedNextUseReceiptV1::authenticate_original_command_response(
+            context.selection.clone(),
+            snapshot,
+            signed,
+            current,
+        )?,
+    )
+}
+
+pub(super) fn same_original(
+    left: &OriginalCircuitEvaluatedNextUseReceiptV1,
+    right: &OriginalCircuitEvaluatedNextUseReceiptV1,
+) -> bool {
+    left.snapshot() == right.snapshot()
+        && left.receipt() == right.receipt()
+        && left.attestation() == right.attestation()
+        && left.original_selection().original_receipt_binding()
+            == right.original_selection().original_receipt_binding()
+}
