+    context: &Context,
+    snapshot: String,
+    evidence: evidence_wire::Evidence,
+    current: u64,
+) -> Result<OriginalCircuitEvaluatedSelectionReceiptV1, Error> {
+    if snapshot.len() > 10_924 {
+        return Err(Error::Binding("bounded original evaluated Selection cut"));
