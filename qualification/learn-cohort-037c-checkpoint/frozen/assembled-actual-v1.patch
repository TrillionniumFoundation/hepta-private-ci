+class EvaluatedCandidateContinuationTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.manifest = tomllib.loads((ROOT / 'CALLERS.toml').read_text())
+        cls.boundaries = {b.identifier: b for b in PROOF._boundary_rows(cls.manifest)}
