+    pub(crate) fn authenticate_original_command_response(
+        selection: OriginalCircuitEvaluatedSelectionReceiptV1,
+        snapshot: LearningIterationSnapshotV1,
+        attestation: SignedLearningEvidenceV1,
+        current: u64,
+    ) -> Result<Self, Error> {
