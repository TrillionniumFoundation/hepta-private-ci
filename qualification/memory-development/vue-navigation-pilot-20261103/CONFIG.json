{
  "version": "sanitized-pilot-evaluator-v1",
  "protocol_version": "sanitized-pilot-protocol-template-v1",
  "bm25": {
    "k1": 1.2,
    "b": 0.75,
    "query_terms": "sorted_unique",
    "tokenizer": "re.findall('[a-z0-9]+', text.lower())",
    "tie": "parent_id_ascending"
  },
  "prf": {
    "seed_count": 2,
    "expansion_count": 4,
    "minimum_term_length": 3,
    "weight": "seed_tf * log(1 + (N + .5)/(collection_df + .5))",
    "tie": "term_ascending"
  },
  "navigation": {
    "seed_count": 2,
    "extra_target_count": 2,
    "link_target_rank": "BM25 over sorted unique visible labels plus target title in linked-target subcollection",
    "fallback": "base_BM25",
    "same_source_only": true,
    "hash_control": "sha256(target_id_utf8), target_id"
  },
  "primary_arms": [
    "bm25",
    "prf",
    "links",
    "hash_links"
  ],
  "diagnostic_arms": [
    "bm25_top8"
  ],
  "primary_parent_cap": 4,
  "diagnostic_parent_cap": 8,
  "utf8_byte_cap": 8192,
  "serialization": "citation + newline + title + newline + exact_text + newline",
  "truncate_parents": false,
  "arm_order_seed": 117,
  "arm_order": [
    "hash_links",
    "links",
    "bm25",
    "bm25_top8",
    "prf"
  ],
  "cold_runs_per_arm": 1,
  "warm_repeats": 3,
  "process_timeout_seconds": 300,
  "address_space_limit_bytes": 1073741824,
  "cpu_threads": 1,
  "experimental_model_calls": 0,
  "network_requests": 0,
  "scoring": "Read scoring.machine from the frozen pilot protocol, including all three controls; no duplicated decision thresholds."
}
