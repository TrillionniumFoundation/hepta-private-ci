
function utf8Bytes(s){return Uint8Array.from(unescape(encodeURIComponent(s)),c=>c.charCodeAt(0));}
function base64Bytes(s){
 if(s.length%4!==0||!/^[A-Za-z0-9+/]*={0,2}$/.test(s))throw Error("invalid base64");
 const pad=s.endsWith("==")?2:s.endsWith("=")?1:0;
 const out=new Uint8Array(s.length/4*3-pad),alpha="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
 let at=0;
 for(let i=0;i<s.length;i+=4){
  const a=alpha.indexOf(s[i]),b=alpha.indexOf(s[i+1]),c=s[i+2]==="="?0:alpha.indexOf(s[i+2]),d=s[i+3]==="="?0:alpha.indexOf(s[i+3]);
  const n=(a<<18)|(b<<12)|(c<<6)|d;
  if(at<out.length)out[at++]=(n>>>16)&255;
  if(at<out.length)out[at++]=(n>>>8)&255;
  if(at<out.length)out[at++]=n&255;
 }
 return out;
}
function padded(data){
 const out=new Uint8Array(Math.ceil((data.length+9)/64)*64);out.set(data);out[data.length]=128;
 const view=new DataView(out.buffer),bits=data.length*8;
 view.setUint32(out.length-8,Math.floor(bits/4294967296),false);view.setUint32(out.length-4,bits>>>0,false);
 return {out,view};
}
function sha256(data){
 const {out,view}=padded(data);
 const k=new Uint32Array([0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2]);
 const h=new Uint32Array([0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19]);
 const ro=(x,n)=>(x>>>n)|(x<<(32-n)),w=new Uint32Array(64);
 for(let off=0;off<out.length;off+=64){
  for(let i=0;i<16;i++)w[i]=view.getUint32(off+4*i,false);
  for(let i=16;i<64;i++){const x=w[i-15],y=w[i-2];w[i]=(w[i-16]+(ro(x,7)^ro(x,18)^(x>>>3))+w[i-7]+(ro(y,17)^ro(y,19)^(y>>>10)))>>>0;}
  let a=h[0],b=h[1],c=h[2],d=h[3],e=h[4],f=h[5],g=h[6],hh=h[7];
  for(let i=0;i<64;i++){
   const t1=(hh+(ro(e,6)^ro(e,11)^ro(e,25))+((e&f)^((~e)&g))+k[i]+w[i])>>>0;
   const t2=((ro(a,2)^ro(a,13)^ro(a,22))+((a&b)^(a&c)^(b&c)))>>>0;
   hh=g;g=f;f=e;e=(d+t1)>>>0;d=c;c=b;b=a;a=(t1+t2)>>>0;
  }
  for(const [i,x] of [a,b,c,d,e,f,g,hh].entries())h[i]=(h[i]+x)>>>0;
 }
 return Array.from(h,x=>x.toString(16).padStart(8,"0")).join("");
}
function sha1(data){
 const {out,view}=padded(data),h=new Uint32Array([0x67452301,0xefcdab89,0x98badcfe,0x10325476,0xc3d2e1f0]),w=new Uint32Array(80);
 const rol=(x,n)=>(x<<n)|(x>>>(32-n));
 for(let off=0;off<out.length;off+=64){
  for(let i=0;i<16;i++)w[i]=view.getUint32(off+4*i,false);
  for(let i=16;i<80;i++)w[i]=rol(w[i-3]^w[i-8]^w[i-14]^w[i-16],1)>>>0;
  let a=h[0],b=h[1],c=h[2],d=h[3],e=h[4];
  for(let i=0;i<80;i++){
   let f,k;if(i<20){f=(b&c)|((~b)&d);k=0x5a827999;}else if(i<40){f=b^c^d;k=0x6ed9eba1;}else if(i<60){f=(b&c)|(b&d)|(c&d);k=0x8f1bbcdc;}else{f=b^c^d;k=0xca62c1d6;}
   const t=(rol(a,5)+f+e+k+w[i])>>>0;e=d;d=c;c=rol(b,30)>>>0;b=a;a=t;
  }
  for(const [i,x] of [a,b,c,d,e].entries())h[i]=(h[i]+x)>>>0;
 }
 return Array.from(h,x=>x.toString(16).padStart(8,"0")).join("");
}
function gitblob(input){
 const data=typeof input==="string"?utf8Bytes(input):input,header=utf8Bytes("blob "+data.length+"\0"),bytes=new Uint8Array(header.length+data.length);
 bytes.set(header);bytes.set(data,header.length);return sha1(bytes);
}
return {utf8Bytes,base64Bytes,sha256,sha1,gitblob};
