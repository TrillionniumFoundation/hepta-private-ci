anged\"));\n        }\n        Ok(())\n    }\n}\n"
        }
      ]
    },
    {
      "key": "learning_data_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_learning_data.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_learning_data.rs",
        "blob": "33dfd853e29f011ab4a9c899fdf7193ea3dfc600",
        "bytes": 11287,
        "sha256": "bd4434c8f7f52e328eed2670bd4c143b75a318a2cb42617497da8998e7b3e751",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Root-approved ordinary Learning trust and signed data conversions.\n//! No attestation, key, role assignment, receipt or timestamp is synthesized.\n\nuse codex_hepta_learning_ledger::ActivatedLearningTrustV1;\nuse codex_hepta_learning_ledger::AuthenticatedPrincipalV1;\nuse codex_hepta_learning_ledger::LearningEvidenceRoleV1;\nuse codex_hepta_learning_ledger::LearningEvidenceTrustV1;\nuse codex_hepta_learning_ledger::LearningTrustDistributionV1;\nuse codex_hepta_learning_ledger::LearningTrustRootV1;\nuse codex_hepta_learning_ledger::SignedLearningEvidenceV1;\nuse codex_hepta_learning_ledger::SignedLearningTrustDistributionV1;\nuse codex_hepta_learning_ledger::TrustedLearningSignerV1;\nuse codex_hepta_learning_ledger::activate_learning_trust;\nuse codex_hepta_types::Digest32;\nuse codex_hepta_types::StableId;\nuse serde::Deserialize;\nuse serde::Serialize;\n\nuse crate::AgentdError;\n\nuse super::deployment_error;\nuse super::deployment_refused;\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct PrincipalData {\n    pub principal_id: String,\n    pub credential_chain_digest: [u8; 32],\n    pub signing_key_digest: [u8; 32],\n    pub scope_digest: [u8; 32],\n    pub authority_epoch: u64,\n    pub authenticated_at: u64,\n    pub expires_at: u64,\n}\n\nimpl PrincipalData {\n    pub(super) fn original(&self) -> Result<AuthenticatedPrincipalV1, AgentdError> {\n        Ok(AuthenticatedPrincipalV1 {\n            principal_id: StableId::new(&self.principal_id).map_err(deployment_error)?,\n            credential_chain_digest: Digest32::from_array(self.credential_chain_digest),\n            signing_key_digest: Digest32::from_array(self.signing_key_digest),\n            scope_digest: Digest32::from_array(self.scope_digest),\n            authority_epoch: self.authority_epoch,\n            authenticated_at: self.authenticated_at,\n            expires_at: self.expires_at,\n        })\n    }\n}\n\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub(super) enum EvidenceRoleData {\n    Generator,\n    Observer,\n    Evaluator,\n    CreditAllocator,\n    UnlearningAuthority,\n    Selector,\n}\n\nimpl EvidenceRoleData {\n    fn original(self) -> LearningEvidenceRoleV1 {\n        match self {\n            Self::Generator => LearningEvidenceRoleV1::Generator,\n            Self::Observer => LearningEvidenceRoleV1::Observer,\n            Self::Evaluator => LearningEvidenceRoleV1::Evaluator,\n            Self::CreditAllocator => LearningEvidenceRoleV1::CreditAllocator,\n            Self::UnlearningAuthority => LearningEvidenceRoleV1::UnlearningAuthority,\n            Self::Selector => LearningEvidenceRoleV1::Selector,\n        }\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct SignerData {\n    pub principal: PrincipalData,\n    pub controller_id: String,\n    pub verifying_key: [u8; 32],\n    pub roles: Vec<EvidenceRoleData>,\n    #[serde(deserialize_with = \"required_option\")]\n    pub revoked_at: Option<u64>,\n}\n\nimpl SignerData {\n    fn original(&self) -> Result<TrustedLearningSignerV1, AgentdError> {\n        Ok(TrustedLearningSignerV1 {\n            principal: self.principal.original()?,\n            controller_id: StableId::new(&self.controller_id).map_err(deployment_error)?,\n            verifying_key: self.verifying_key,\n            roles: self.roles.iter().copied().map(EvidenceRoleData::original).collect(),\n            revoked_at: self.revoked_at,\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct TrustData {\n    pub scope_digest: [u8; 32],\n    pub objective_digest: [u8; 32],\n    pub authority_epoch: u64,\n    pub signers: Vec<SignerData>,\n}\n\nimpl TrustData {\n    fn original(&self) -> Result<LearningEvidenceTrustV1, AgentdError> {\n        Ok(LearningEvidenceTrustV1 {\n            scope_digest: Digest32::from_array(self.scope_digest),\n            objective_digest: Digest32::from_array(self.objective_digest),\n            authority_epoch: self.authority_epoch,\n            signers: self.signers.iter().map(SignerData::original)\n                .collect::<Result<Vec<_>, _>>()?,\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct TrustRootData {\n    pub root_id: String,\n    pub scope_digest: [u8; 32],\n    pub verifying_key: [u8; 32],\n    pub valid_from: u64,\n    pub expires_at: u64,\n    #[serde(deserialize_with = \"required_option\")]\n    pub revoked_at: Option<u64>,\n}\n\nimpl TrustRootData {\n    fn original(&self) -> Result<LearningTrustRootV1, AgentdError> {\n        Ok(LearningTrustRootV1 {\n            root_id: StableId::new(&self.root_id).map_err(deployment_error)?,\n            scope_digest: Digest32::from_array(self.scope_digest),\n            verifying_key: self.verifying_key,\n            valid_from: self.valid_from,\n            expires_at: self.expires_at,\n            revoked_at: self.revoked_at,\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct SignedTrustData {\n    pub distribution_id: String,\n    pub generation: u64,\n    pub effective_at: u64,\n    pub trust: TrustData,\n    pub root_id: String,\n    pub issued_at: u64,\n    pub expires_at: u64,\n    pub signature: Vec<u8>,\n}\n\n/// Root key, exact distribution and its independently approved digest all\n/// come from the immutable Root-owned deployment description.\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct LearningAuthorityData {\n    pub root: TrustRootData,\n    pub signed: SignedTrustData,\n    pub expected_distribution_digest: [u8; 32],\n}\n\npub(super) struct OriginalLearningAuthority {\n    pub(super) activated: ActivatedLearningTrustV1,\n    signers: Vec<TrustedLearningSignerV1>,\n}\n\nimpl LearningAuthorityData {\n    pub(super) fn activate_original(\n        &self,\n        now_unix_seconds: u64,\n    ) -> Result<OriginalLearningAuthority, AgentdError> {\n        let root = self.root.original()?;\n        let trust = self.signed.trust.original()?;\n        let signers = trust.signers.clone();\n        let signed = SignedLearningTrustDistributionV1 {\n            distribution: LearningTrustDistributionV1 {\n                distribution_id: StableId::new(&self.signed.distribution_id)\n                    .map_err(deployment_error)?,\n                generation: self.signed.generation,\n                effective_at: self.signed.effective_at,\n                trust,\n            },\n            root_id: StableId::new(&self.signed.root_id).map_err(deployment_error)?,\n            issued_at: self.signed.issued_at,\n            expires_at: self.signed.expires_at,\n            signature: signature(&self.signed.signature)?,\n        };\n        // This is a fresh explicitly scoped owner, not a trust-rotation or\n        // recovery API. Root itself authenticates the complete distribution.\n        let activated = activate_learning_trust(&root, signed, None, now_unix_seconds)\n            .map_err(deployment_error)?;\n        let expected = Digest32::from_array(self.expected_distribution_digest);\n        if expected.is_zero() || activated.distribution_digest() != expected {\n            return Err(deployment_refused(\"actual Root Learning distribution differs\"));\n        }\n        Ok(OriginalLearningAuthority { activated, signers })\n    }\n}\n\nimpl OriginalLearningAuthority {\n    pub(super) fn into_original_parts(\n        self,\n    ) -> (ActivatedLearningTrustV1, Vec<TrustedLearningSignerV1>) {\n        (self.activated, self.signers)\n    }\n\n    pub(super) fn original_signer(\n        &self,\n        principal_id: &str,\n        required_role: LearningEvidenceRoleV1,\n    ) -> Result<TrustedLearningSignerV1, AgentdError> {\n        let principal = StableId::new(principal_id).map_err(deployment_error)?;\n        self.signers.iter()\n            .find(|signer| signer.principal.principal_id == principal\n                && signer.roles.contains(&required_role))\n            .cloned()\n            .ok_or_else(|| deployment_refused(\"required actual enrolled Learning signer is missing\"))\n    }\n}\n\n/// The external Observer supplies these exact original signed fields. Parsing\n/// them never authenticates an Outcome; the actual producer performs that\n/// admission against its current verifier and committed task publication.\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct SignedEvidenceData {\n    pub evidence_id: String,\n    pub principal_id: String,\n    pub role: EvidenceRoleData,\n    pub trust_digest: [u8; 32],\n    pub scope_digest: [u8; 32],\n    pub objective_digest: [u8; 32],\n    pub authority_epoch: u64,\n    pub issued_at: u64,\n    pub expires_at: u64,\n    pub payload_digest: [u8; 32],\n    pub signature: Vec<u8>,\n}\n\nimpl SignedEvidenceData {\n    pub(super) fn from_original(original: &SignedLearningEvidenceV1) -> Self {\n        Self {\n            evidence_id: original.evidence_id.as_str().to_owned(),\n            principal_id: original.principal_id.as_str().to_owned(),\n            role: match original.role {\n                LearningEvidenceRoleV1::Generator => EvidenceRoleData::Generator,\n                LearningEvidenceRoleV1::Observer => EvidenceRoleData::Observer,\n                LearningEvidenceRoleV1::Evaluator => EvidenceRoleData::Evaluator,\n                LearningEvidenceRoleV1::CreditAllocator => EvidenceRoleData::CreditAllocator,\n                LearningEvidenceRoleV1::UnlearningAuthority => EvidenceRoleData::UnlearningAuthority,\n                LearningEvidenceRoleV1::Selector => EvidenceRoleData::Selector,\n            },\n            trust_digest: original.trust_digest.into_array(),\n            scope_digest: original.scope_digest.into_array(),\n            objective_digest: original.objective_digest.into_array(),\n            authority_epoch: original.authority_epoch,\n            issued_at: original.issued_at, expires_at: original.expires_at,\n            payload_digest: original.payload_digest.into_array(),\n            signature: original.signature.to_vec(),\n        }\n    }\n\n    pub(super) fn original(&self) -> Result<SignedLearningEvidenceV1, AgentdError> {\n        Ok(SignedLearningEvidenceV1 {\n            evidence_id: StableId::new(&self.evidence_id).map_err(deployment_error)?,\n            principal_id: StableId::new(&self.principal_id).map_err(deployment_error)?,\n            role: self.role.original(),\n            trust_digest: Digest32::from_array(self.trust_digest),\n            scope_digest: Digest32::from_array(self.scope_digest),\n            objective_digest: Digest32::from_array(self.objective_digest),\n            authority_epoch: self.authority_epoch,\n            issued_at: self.issued_at,\n            expires_at: self.expires_at,\n            payload_digest: Digest32::from_array(self.payload_digest),\n            signature: signature(&self.signature)?,\n        })\n    }\n}\n\nfn signature(bytes: &[u8]) -> Result<[u8; 64], AgentdError> {\n    bytes.try_into().map_err(|_| deployment_refused(\"original Ed25519 signature must be 64 bytes\"))\n}\n\npub(super) fn required_option<'de, D, T>(deserializer: D) -> Result<Option<T>, D::Error>\nwhere\n    D: serde::Deserializer<'de>,\n    T: Deserialize<'de>,\n{\n    Option::<T>::deserialize(deserializer)\n}\n"
        }
      ]
    },
    {
      "key": "learning_materials_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_learning.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_learning.rs",
        "blob": "24d9b803a93d8b61e183928e797a0622a70e114f",
        "bytes": 10576,
        "sha256": "7b30f7ebf3e5a19f77f9fb6d1b788e9df0b375bc981016a9119886def467dfb9",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Concrete fresh causal-ledger custody for the ordinary phase.\n//! Root-approved signed trust is activated once. No existing history is\n//! reopened under an empty trust predecessor or substituted with a new ledger.\n\nuse std::sync::Arc;\nuse std::sync::Mutex;\n\nuse codex_hepta_learning_ledger::DurableLedger;\nuse codex_hepta_learning_ledger::LearningEvidenceRoleV1;\nuse codex_hepta_learning_ledger::LearningEvidenceVerifierV1;\nuse codex_hepta_learning_ledger::LedgerWitnessStore;\nuse codex_hepta_learning_ledger::LedgerWriter;\nuse codex_hepta_learning_ledger::TrustedLearningSignerV1;\nuse codex_hepta_types::Digest32;\nuse codex_hepta_types::StableId;\nuse serde::Deserialize;\nuse serde::Serialize;\n\nuse crate::AgentdError;\nuse crate::CircuitQ24TaskOpenModeV1;\nuse crate::OriginalCellQ24TaskDatasetFreezeInputsV1;\nuse crate::OriginalCellQ24DatasetFreezeSigningConfigV1;\nuse crate::OriginalCellQ24TaskLedgerConfigV1;\nuse crate::OriginalCellQ24TaskLedgerInputsV1;\n\nuse super::deployment_error;\nuse super::deployment_refused;\nuse super::files::MutableFileData;\nuse super::files::OriginalDeploymentFiles;\nuse super::files::PinnedFileData;\nuse super::learning_data::LearningAuthorityData;\nuse super::witness::OriginalWitnessData;\nuse super::witness::require_fresh_original_file;\n\n#[path = \"same_actor_q24_deployment_learning_owners.rs\"]\nmod owners;\npub(super) use owners::OriginalLearningOwnersData;\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalSignedOwnerFilesData {\n    pub journal: MutableFileData,\n    pub witness: OriginalWitnessData,\n    pub principal: String,\n    pub key: PinnedFileData,\n    pub maximum_signature_lifetime_seconds: u64,\n}\n\nimpl OriginalSignedOwnerFilesData {\n    fn require_fresh(&self) -> Result<(), AgentdError> {\n        require_fresh_original_file(&self.journal)?;\n        require_fresh_original_file(&self.witness.file)?;\n        Ok(())\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalTaskLedgerData {\n    pub signatures: OriginalSignedOwnerFilesData,\n    pub observer: String,\n    pub episode_id: String,\n    pub candidate_set_id: String,\n    pub generator_code_digest: [u8; 32],\n    pub grammar_digest: [u8; 32],\n    pub hard_filter_digest: [u8; 32],\n    pub truncation_digest: [u8; 32],\n    pub outcome_record_id: String,\n    pub outcome_id: String,\n    pub unit_profile_digest: [u8; 32],\n    pub expected_delay_profile_digest: [u8; 32],\n    pub claim_deadline_unix_seconds: u64,\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalLearningMaterialsData {\n    pub authority: LearningAuthorityData,\n    pub ledger: MutableFileData,\n    pub witness: MutableFileData,\n    pub ledger_binding: [u8; 32],\n    pub maximum_records: usize,\n    pub original_a: OriginalTaskLedgerData,\n    pub original_c: OriginalTaskLedgerData,\n    pub freeze: OriginalSignedOwnerFilesData,\n    pub owners: OriginalLearningOwnersData,\n}\n\n/// The verifier and all named principals are taken from the single activated\n/// original distribution that owns this same real LedgerWriter.\npub(super) struct OriginalDeploymentLearning {\n    ledger: Arc<Mutex<LedgerWriter>>,\n    verifier: LearningEvidenceVerifierV1,\n    signers: Vec<TrustedLearningSignerV1>,\n    data: OriginalLearningMaterialsData,\n}\n\nimpl OriginalDeploymentLearning {\n    pub(super) fn open_original(\n        data: OriginalLearningMaterialsData,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<(Self, OriginalCellQ24TaskLedgerInputsV1), AgentdError> {\n        require_fresh_original_file(&data.ledger)?;\n        require_fresh_original_file(&data.witness)?;\n        data.original_a.signatures.require_fresh()?;\n        data.original_c.signatures.require_fresh()?;\n        data.freeze.require_fresh()?;\n        data.owners.require_fresh()?;\n        files.require_original_context()?;\n        let authority = data.authority.activate_original(now)?;\n        // These checks resolve real enrolled principals, not role labels\n        // asserted by a caller. Every later signing owner validates them again.\n        authority.original_signer(\n            &data.original_a.signatures.principal, LearningEvidenceRoleV1::Generator,\n        )?;\n        authority.original_signer(\n            &data.original_a.observer, LearningEvidenceRoleV1::Observer,\n        )?;\n        let (activated, signers) = authority.into_original_parts();\n        let verifier = activated.verifier().clone();\n        let binding = Digest32::from_array(data.ledger_binding);\n        let (ledger_file, ledger_directory) =\n            files.open_original_owner_with_directory(&data.ledger)?;\n        let (witness_file, witness_directory) =\n            files.open_original_owner_with_directory(&data.witness)?;\n        files.require_original_context()?;\n        let ledger = DurableLedger::create(ledger_file, binding, data.maximum_records)\n            .map_err(deployment_error)?;\n        files.require_original_context()?;\n        let witness = LedgerWitnessStore::create(witness_file, binding)\n            .map_err(deployment_error)?;\n        files.require_original_context()?;\n        let ledger = LedgerWriter::from_durable(\n            ledger, witness, activated, &ledger_directory, &witness_directory,\n        )\n        .map_err(deployment_error)?;\n        files.require_original_context()?;\n        let original = Self {\n            ledger: Arc::new(Mutex::new(ledger)), verifier, signers, data,\n        };\n        let inputs = original.open_original_task(&original.data.original_a, files, now)?;\n        Ok((original, inputs))\n    }\n\n    pub(super) fn original_a_claim_deadline(&self) -> u64 {\n        self.data.original_a.claim_deadline_unix_seconds\n    }\n\n    pub(super) fn original_c_claim_deadline(&self) -> u64 {\n        self.data.original_c.claim_deadline_unix_seconds\n    }\n\n    pub(super) fn verifier(&self) -> &LearningEvidenceVerifierV1 {\n        &self.verifier\n    }\n\n    pub(super) fn require_original_signer(\n        &self,\n        principal: &str,\n        role: LearningEvidenceRoleV1,\n        now: u64,\n    ) -> Result<TrustedLearningSignerV1, AgentdError> {\n        let id = StableId::new(principal).map_err(deployment_error)?;\n        let signer = self.signers.iter()\n            .find(|signer| signer.principal.principal_id == id && signer.roles.contains(&role))\n            .cloned()\n            .ok_or_else(|| deployment_refused(\"actual enrolled Learning signer is absent\"))?;\n        self.verifier.require_signer_binding(role, &signer, now)\n            .map_err(deployment_error)?;\n        Ok(signer)\n    }\n\n    pub(super) fn open_original_freeze(\n        &self,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<OriginalCellQ24TaskDatasetFreezeInputsV1, AgentdError> {\n        let data = &self.data.freeze;\n        data.require_fresh()?;\n        let signer = self.require_original_signer(\n            &data.principal, LearningEvidenceRoleV1::Evaluator, now,\n        )?;\n        let key = files.read_original_signing_key(&data.key)?;\n        require_original_key(&signer, &key)?;\n        let journal = files.open_original_owner(&data.journal)?;\n        let witness = data.witness.open_original(files)?;\n        files.require_original_context()?;\n        Ok(OriginalCellQ24TaskDatasetFreezeInputsV1 {\n            journal, witness, open_mode: CircuitQ24TaskOpenModeV1::Create,\n            signing: OriginalCellQ24DatasetFreezeSigningConfigV1 {\n                signer, verifier: self.verifier.clone(),\n                maximum_signature_lifetime_seconds: data.maximum_signature_lifetime_seconds,\n            },\n            evaluator_key: key,\n        })\n    }\n\n    pub(super) fn open_original_c_task(\n        &self,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<OriginalCellQ24TaskLedgerInputsV1, AgentdError> {\n        self.open_original_task(&self.data.original_c, files, now)\n    }\n\n    fn open_original_task(\n        &self,\n        data: &OriginalTaskLedgerData,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<OriginalCellQ24TaskLedgerInputsV1, AgentdError> {\n        data.signatures.require_fresh()?;\n        let generator = self.require_original_signer(\n            &data.signatures.principal, LearningEvidenceRoleV1::Generator, now,\n        )?;\n        let observer = self.require_original_signer(\n            &data.observer, LearningEvidenceRoleV1::Observer, now,\n        )?;\n        let key = files.read_original_signing_key(&data.signatures.key)?;\n        require_original_key(&generator, &key)?;\n        let config = OriginalCellQ24TaskLedgerConfigV1 {\n            episode_id: StableId::new(&data.episode_id).map_err(deployment_error)?,\n            candidate_set_id: StableId::new(&data.candidate_set_id).map_err(deployment_error)?,\n            generator_code_digest: Digest32::from_array(data.generator_code_digest),\n            grammar_digest: Digest32::from_array(data.grammar_digest),\n            hard_filter_digest: Digest32::from_array(data.hard_filter_digest),\n            truncation_digest: Digest32::from_array(data.truncation_digest),\n            generator,\n            observer,\n            outcome_record_id: StableId::new(&data.outcome_record_id).map_err(deployment_error)?,\n            outcome_id: StableId::new(&data.outcome_id).map_err(deployment_error)?,\n            unit_profile_digest: Digest32::from_array(data.unit_profile_digest),\n            expected_delay_profile_digest: Digest32::from_array(data.expected_delay_profile_digest),\n            claim_deadline_unix_seconds: data.claim_deadline_unix_seconds,\n            maximum_signature_lifetime_seconds:\n                data.signatures.maximum_signature_lifetime_seconds,\n        };\n        let signature_journal = files.open_original_owner(&data.signatures.journal)?;\n        let signature_witness = data.signatures.witness.open_original(files)?;\n        files.require_original_context()?;\n        Ok(OriginalCellQ24TaskLedgerInputsV1 {\n            ledger: Arc::clone(&self.ledger), signature_journal, signature_witness,\n            open_mode: CircuitQ24TaskOpenModeV1::Create, config, generator_key: key,\n        })\n    }\n}\n\nfn require_original_key(\n    signer: &TrustedLearningSignerV1,\n    key: &ed25519_dalek::SigningKey,\n) -> Result<(), AgentdError> {\n    if signer.verifying_key != key.verifying_key().to_bytes() {\n        return Err(deployment_refused(\"supplied key differs from the actual enrolled signer\"));\n    }\n    Ok(())\n}\n"
        }
      ]
    },
    {
      "key": "learning_owners_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_learning_owners.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_learning_owners.rs",
        "blob": "05895538b32b08bba514cc2741d0787357588482",
        "bytes": 6832,
        "sha256": "28e36d72c8702ba6951ec627e75960e696801a3ae17595772ec8745061ed5b7d",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Original Observer/Generator/Selector resources opened only after the real\n//! same-session scoped handoff. Prepared is the exact object from A's producer;\n//! its Dataset, targets and Training batch are never deserialized here.\n\nuse std::sync::Arc;\n\nuse codex_hepta_learning_ledger::LearningEvidenceRoleV1;\nuse serde::Deserialize;\nuse serde::Serialize;\n\nuse super::OriginalDeploymentLearning;\nuse super::OriginalSignedOwnerFilesData;\nuse super::require_original_key;\nuse super::super::deployment_error;\nuse super::super::files::MutableFileData;\nuse super::super::files::OriginalDeploymentFiles;\nuse super::super::witness::OriginalWitnessData;\nuse super::super::witness::require_fresh_original_file;\nuse crate::AgentdError;\nuse crate::CellQ24LocalPolicyV1;\nuse crate::CellQ24PreparedLearningV1;\nuse crate::OriginalCellQ24LearningInputsV1;\nuse crate::OriginalCellQ24LearningOpenV1;\nuse crate::OriginalCellQ24LocalDecisionFilesV1;\nuse crate::OriginalCellQ24SourceFilesV1;\nuse crate::OriginalCellQ24SourceInputsV1;\nuse crate::OriginalCellQ24SourceJournalV1;\nuse crate::OriginalCellQ24TrainingFilesV1;\nuse crate::OriginalCellQ24TrainingInputsV1;\nuse crate::same_actor_q24_phase::OriginalSameActorLearningInputsV1;\n\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub(in crate::same_actor_q24_deployment) enum OriginalLocalPolicyData {\n    AdoptQualified,\n    RetainCurrent,\n    DeferQualified,\n}\n\nimpl OriginalLocalPolicyData {\n    fn original(self) -> CellQ24LocalPolicyV1 {\n        match self {\n            Self::AdoptQualified => CellQ24LocalPolicyV1::AdoptQualified,\n            Self::RetainCurrent => CellQ24LocalPolicyV1::RetainCurrent,\n            Self::DeferQualified => CellQ24LocalPolicyV1::DeferQualified,\n        }\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(in crate::same_actor_q24_deployment) struct OriginalLearningOwnersData {\n    pub experience: OriginalSignedOwnerFilesData,\n    pub dataset: OriginalSignedOwnerFilesData,\n    pub training: MutableFileData,\n    pub training_witness: OriginalWitnessData,\n    pub training_receipts: OriginalSignedOwnerFilesData,\n    pub local: OriginalSignedOwnerFilesData,\n    pub local_policy: OriginalLocalPolicyData,\n    pub queue_capacity: usize,\n    pub successor_queue_capacity: usize,\n}\n\nimpl OriginalLearningOwnersData {\n    pub(super) fn require_fresh(&self) -> Result<(), AgentdError> {\n        self.experience.require_fresh()?;\n        self.dataset.require_fresh()?;\n        require_fresh_original_file(&self.training)?;\n        require_fresh_original_file(&self.training_witness.file)?;\n        self.training_receipts.require_fresh()?;\n        self.local.require_fresh()?;\n        Ok(())\n    }\n}\n\nimpl OriginalDeploymentLearning {\n    pub(in crate::same_actor_q24_deployment) fn open_original_scoped_inputs(\n        &self,\n        prepared: Arc<CellQ24PreparedLearningV1>,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<OriginalSameActorLearningInputsV1, AgentdError> {\n        let data = &self.data.owners;\n        data.require_fresh()?;\n        files.require_original_context()?;\n        prepared.revalidate_source().map_err(deployment_error)?;\n        let experience = self.open_original_observer(&data.experience, files, now)?;\n        let dataset = self.open_original_observer(&data.dataset, files, now)?;\n        let training_signer = self.require_original_signer(\n            &data.training_receipts.principal, LearningEvidenceRoleV1::Generator, now,\n        )?;\n        let training_key = files.read_original_signing_key(&data.training_receipts.key)?;\n        require_original_key(&training_signer, &training_key)?;\n        let training = files.open_original_owner(&data.training)?;\n        let training_witness = data.training_witness.open_original(files)?;\n        let receipts = files.open_original_owner(&data.training_receipts.journal)?;\n        let receipt_witness = data.training_receipts.witness.open_original(files)?;\n        let local_signer = self.require_original_signer(\n            &data.local.principal, LearningEvidenceRoleV1::Selector, now,\n        )?;\n        let local_key = files.read_original_signing_key(&data.local.key)?;\n        require_original_key(&local_signer, &local_key)?;\n        let local_journal = files.open_original_owner(&data.local.journal)?;\n        let local_witness = data.local.witness.open_original(files)?;\n        prepared.revalidate_source().map_err(deployment_error)?;\n        files.require_original_context()?;\n        Ok(OriginalSameActorLearningInputsV1 {\n            original: OriginalCellQ24LearningInputsV1 {\n                prepared,\n                sources: OriginalCellQ24SourceInputsV1::Files(OriginalCellQ24SourceFilesV1 {\n                    experience, dataset,\n                }),\n                training: OriginalCellQ24TrainingInputsV1::Files(OriginalCellQ24TrainingFilesV1 {\n                    training, training_witness, receipts, receipt_witness,\n                    signer: training_signer, key: training_key,\n                    verifier: self.verifier.clone(),\n                    maximum_signature_lifetime_seconds:\n                        data.training_receipts.maximum_signature_lifetime_seconds,\n                }),\n                local: OriginalCellQ24LocalDecisionFilesV1 {\n                    journal: local_journal, witness: local_witness,\n                    policy: data.local_policy.original(), signer: local_signer, key: local_key,\n                    maximum_signature_lifetime_seconds:\n                        data.local.maximum_signature_lifetime_seconds,\n                    mode: OriginalCellQ24LearningOpenV1::Create,\n                },\n                verifier: self.verifier.clone(),\n                mode: OriginalCellQ24LearningOpenV1::Create,\n                queue_capacity: data.queue_capacity,\n            },\n            successor_queue_capacity: data.successor_queue_capacity,\n        })\n    }\n\n    fn open_original_observer(\n        &self,\n        data: &OriginalSignedOwnerFilesData,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<OriginalCellQ24SourceJournalV1, AgentdError> {\n        data.require_fresh()?;\n        let signer = self.require_original_signer(\n            &data.principal, LearningEvidenceRoleV1::Observer, now,\n        )?;\n        let key = files.read_original_signing_key(&data.key)?;\n        require_original_key(&signer, &key)?;\n        let journal = files.open_original_owner(&data.journal)?;\n        let witness = data.witness.open_original(files)?;\n        files.require_original_context()?;\n        Ok(OriginalCellQ24SourceJournalV1 {\n            journal, witness, signer, key,\n            maximum_signature_lifetime_seconds: data.maximum_signature_lifetime_seconds,\n        })\n    }\n}\n"
        }
      ]
    },
    {
      "key": "preparation_data_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_preparation.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_preparation.rs",
        "blob": "55a6c955fa9f416a81bf570181fbc3fe11f9876e",
        "bytes": 7354,
        "sha256": "bb9e53e099b1e5e43ef5e51e0e7b9f280f0b82c18a0c8a5cbc21e183e618906e",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Host-frozen preparation data for the actual fresh A source.\n//! The completed-task pin is external observation data checked by the actual\n//! Producer against its live source. It is never taken from a Control ACK.\n\nuse std::sync::Arc;\nuse codex_hepta_learning_artifacts::{CellCompatibilityBundleV1, IterationEnvelopeV1,\n    LearningIterationBudgetV1, LearningIterationOwnersV1, LearningIterationRequestV1};\nuse codex_hepta_types::{Digest32, StableId};\nuse serde::{Deserialize, Serialize};\nuse crate::{AgentdError, CellQ24DatasetProjectionV1, CellQ24LearningPreparationConfigV1,\n    CellQ24PrivateHeadV1, CellQ24SgdRuleV1, LoadedCellQ24ModelV1};\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalEnvelopeData {\n    pub envelope_id: String,\n    pub base_commit: [u8; 32],\n    pub base_tree: [u8; 32],\n    pub objective_digest: [u8; 32],\n    pub grammar_digest: [u8; 32],\n    pub maximum_files: u16,\n    pub maximum_diff_bytes: u64,\n    pub maximum_candidates: u16,\n    pub maximum_parallel_sandboxes: u8,\n    pub expiry_unix_seconds: u64,\n}\nimpl OriginalEnvelopeData {\n    fn original(&self) -> Result<IterationEnvelopeV1, AgentdError> {\n        Ok(IterationEnvelopeV1 {\n            envelope_id: StableId::new(&self.envelope_id).map_err(deployment_error)?,\n            base_commit: Digest32::from_array(self.base_commit),\n            base_tree: Digest32::from_array(self.base_tree),\n            objective_digest: Digest32::from_array(self.objective_digest),\n            grammar_digest: Digest32::from_array(self.grammar_digest),\n            maximum_files: self.maximum_files, maximum_diff_bytes: self.maximum_diff_bytes,\n            maximum_candidates: self.maximum_candidates,\n            maximum_parallel_sandboxes: self.maximum_parallel_sandboxes,\n            expiry_unix_seconds: self.expiry_unix_seconds,\n        })\n    }\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalLearningBudgetData {\n    pub maximum_dataset_rows: u32,\n    pub maximum_dataset_bytes: u64,\n    pub maximum_training_steps: u64,\n    pub maximum_training_milliseconds: u64,\n    pub maximum_artifact_bytes: u64,\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalLearningRequestData {\n    pub operation_id: String,\n    pub principal_id: String,\n    pub agent_id: String,\n    pub cell_id: String,\n    pub source_run_id: String,\n    pub completed_task_receipt: [u8; 32],\n    pub selected_artifact_digest: [u8; 32],\n    pub evaluation_profile: [u8; 32],\n    pub selected_bundle_digest: [u8; 32],\n    pub envelope: OriginalEnvelopeData,\n    pub budget: OriginalLearningBudgetData,\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalIterationOwnersData {\n    pub evidence_trust_digest: [u8; 32],\n    pub experience: String,\n    pub dataset: String,\n    pub trainer: String,\n    pub evaluator: String,\n    pub proposal: String,\n    pub selector: String,\n    pub next_use_observer: String,\n}\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(tag = \"kind\", rename_all = \"snake_case\", deny_unknown_fields)]\npub(super) enum OriginalPrivateHeadData {\n    Drive { index: u16 },\n    Prediction { index: u16 },\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalPreparationData {\n    pub request: OriginalLearningRequestData,\n    pub owners: OriginalIterationOwnersData,\n    pub head: OriginalPrivateHeadData,\n    pub epochs: u16,\n    pub learning_rate_q24: i64,\n    pub inherited_inclusion_policy: [u8; 32],\n    pub unit_profile_digest: [u8; 32],\n    pub input_width: u16,\n    pub snapshot_id: String,\n}\nimpl OriginalPreparationData {\n    pub(super) fn original(\n        &self, baseline: Arc<LoadedCellQ24ModelV1>, bundle: &CellCompatibilityBundleV1,\n    ) -> Result<CellQ24LearningPreparationConfigV1, AgentdError> {\n        let expected = Digest32::from_array(self.request.selected_bundle_digest);\n        if bundle.digest().map_err(deployment_error)? != expected\n            || baseline.components() != &bundle.components\n        {\n            return Err(deployment_refused(\"preparation differs from the actual Initial baseline\"));\n        }\n        let data = &self.request;\n        let budget = &data.budget;\n        let request = LearningIterationRequestV1 {\n            operation_id: StableId::new(&data.operation_id).map_err(deployment_error)?,\n            principal_id: StableId::new(&data.principal_id).map_err(deployment_error)?,\n            agent_id: StableId::new(&data.agent_id).map_err(deployment_error)?,\n            cell_id: StableId::new(&data.cell_id).map_err(deployment_error)?,\n            source_run_id: StableId::new(&data.source_run_id).map_err(deployment_error)?,\n            completed_task_receipt: Digest32::from_array(data.completed_task_receipt),\n            selected_artifact_digest: Digest32::from_array(data.selected_artifact_digest),\n            evaluation_profile: Digest32::from_array(data.evaluation_profile),\n            selected_bundle: bundle.clone(), envelope: data.envelope.original()?,\n            budget: LearningIterationBudgetV1 {\n                maximum_dataset_rows: budget.maximum_dataset_rows,\n                maximum_dataset_bytes: budget.maximum_dataset_bytes,\n                maximum_training_steps: budget.maximum_training_steps,\n                maximum_training_milliseconds: budget.maximum_training_milliseconds,\n                maximum_artifact_bytes: budget.maximum_artifact_bytes,\n            },\n        };\n        let owner = &self.owners;\n        Ok(CellQ24LearningPreparationConfigV1 {\n            request,\n            owners: LearningIterationOwnersV1 {\n                evidence_trust_digest: Digest32::from_array(owner.evidence_trust_digest),\n                experience: StableId::new(&owner.experience).map_err(deployment_error)?,\n                dataset: StableId::new(&owner.dataset).map_err(deployment_error)?,\n                trainer: StableId::new(&owner.trainer).map_err(deployment_error)?,\n                evaluator: StableId::new(&owner.evaluator).map_err(deployment_error)?,\n                proposal: StableId::new(&owner.proposal).map_err(deployment_error)?,\n                selector: StableId::new(&owner.selector).map_err(deployment_error)?,\n                next_use_observer: StableId::new(&owner.next_use_observer).map_err(deployment_error)?,\n            },\n            baseline,\n            head: match self.head {\n                OriginalPrivateHeadData::Drive { index } => CellQ24PrivateHeadV1::Drive { index },\n                OriginalPrivateHeadData::Prediction { index } => CellQ24PrivateHeadV1::Prediction { index },\n            },\n            rule: CellQ24SgdRuleV1 { epochs: self.epochs, learning_rate_q24: self.learning_rate_q24 },\n            projection: CellQ24DatasetProjectionV1 {\n                inherited_inclusion_policy: Digest32::from_array(self.inherited_inclusion_policy),\n                unit_profile_digest: Digest32::from_array(self.unit_profile_digest),\n                baseline_bundle: expected, input_width: self.input_width,\n            },\n            snapshot_id: StableId::new(&self.snapshot_id).map_err(deployment_error)?,\n        })\n    }\n}\n"
        }
      ]
    },
    {
      "key": "cell_data_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_cell_data.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_cell_data.rs",
        "blob": "cc35d786fba07685d911038da4abdbd78399421f",
        "bytes": 9898,
        "sha256": "68d37ff215485832623aead18b1f8e5ead1d7884fbf3684f33c0484a99e4cd13",
