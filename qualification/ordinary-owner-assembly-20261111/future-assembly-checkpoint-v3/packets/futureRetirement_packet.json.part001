      "operations": [
        {
          "op": "add",
          "content": "//! Private custody for retiring only this actual Root serving scope.\n//! Wire data cannot mint this owner, a joined handle, a C result or a lease.\n\nuse super::*;\nuse std::sync::Mutex;\nuse std::sync::MutexGuard;\n\nuse codex_hepta_contracts::HostAuthorityPeerChannel;\nuse crate::same_actor_q24_deployment_protocol::OriginalDeploymentAcknowledgement;\nuse crate::same_actor_q24_deployment_protocol::OriginalDeploymentBinding;\nuse crate::same_actor_q24_deployment_protocol::OriginalDeploymentRequest;\nuse crate::same_actor_q24_deployment_protocol::OriginalDeploymentStage;\nuse crate::same_actor_q24_phase_gate::SameActorPhaseStream;\nuse crate::same_actor_q24_root_retirement_protocol::OriginalRootRetirementAcknowledgement;\nuse crate::same_actor_q24_root_retirement_protocol::OriginalRootRetirementRequest;\nuse crate::same_actor_q24_root_retirement_protocol::OriginalRootRetirementStage;\nuse crate::same_actor_q24_root_retirement_protocol::RETIREMENT_PURPOSE;\n\nconst ALL_PURPOSES: u16 = 0xff;\n\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub(crate) enum OriginalRootRetirementPurpose {\n    Observation,\n    Issuer,\n    Checkpoint,\n    DeviceFrontier,\n    NotesFrontier,\n    Learning,\n    Model,\n    Publication,\n}\n\nimpl OriginalRootRetirementPurpose {\n    fn bit(self) -> u16 {\n        match self {\n            Self::Observation => 1,\n            Self::Issuer => 2,\n            Self::Checkpoint => 4,\n            Self::DeviceFrontier => 8,\n            Self::NotesFrontier => 16,\n            Self::Learning => 32,\n            Self::Model => 64,\n            Self::Publication => 128,\n        }\n    }\n\n    pub(crate) fn from_original_lane(lane: HostAuthorityLane) -> Self {\n        match lane {\n            HostAuthorityLane::Observation => Self::Observation,\n            HostAuthorityLane::Issuer => Self::Issuer,\n            HostAuthorityLane::Checkpoint => Self::Checkpoint,\n            HostAuthorityLane::DeviceConsumerFrontier => Self::DeviceFrontier,\n            HostAuthorityLane::NotesConsumerFrontier => Self::NotesFrontier,\n        }\n    }\n}\n\nstruct RetirementState {\n    registered: u16,\n    active_requests: usize,\n    original_current: Option<(String, String)>,\n    intent: Option<String>,\n    intent_acknowledged: bool,\n    clean_eof: u16,\n    stop_watcher: bool,\n    acknowledged: bool,\n}\n\npub(crate) struct OriginalRootRetirementScope {\n    gate: Arc<SameActorPhaseGate>,\n    binding: OriginalDeploymentBinding,\n    registration: HostAuthorityRegistration,\n    uid: u32,\n    gid: u32,\n    owner: OwnedFd,\n    state: Mutex<RetirementState>,\n}\n\npub(crate) struct OriginalRootRetirementLane {\n    scope: Arc<OriginalRootRetirementScope>,\n    purpose: OriginalRootRetirementPurpose,\n    closing: CloseSameActorPhaseOnDrop,\n}\n\npub(crate) struct OriginalRootRequestAdmission {\n    scope: Arc<OriginalRootRetirementScope>,\n}\n\n/// Retains the actual channel/pidfd and shutdown alias after its exact clean\n/// EOF. This is not a join witness: the owner scope must still join its thread.\npub(crate) struct OriginalRootRetiredChannel {\n    scope: Arc<OriginalRootRetirementScope>,\n    purpose: OriginalRootRetirementPurpose,\n    channel: HostAuthorityPeerChannel,\n    _stream: SameActorPhaseStream,\n    _closing: CloseSameActorPhaseOnDrop,\n}\n\nimpl OriginalRootRetirementScope {\n    pub(super) fn from_original_phase(\n        phase: &PreparedRootSameActorQ24PhaseV1,\n    ) -> io::Result<Arc<Self>> {\n        crate::authority_host_service::generation_initial::original_root()?;\n        phase.gate.require_open()?;\n        let binding = OriginalDeploymentBinding::from_original_phase(&phase.descriptor)?;\n        let scope = Arc::new(Self {\n            gate: Arc::clone(&phase.gate),\n            binding,\n            registration: phase.original.registration.clone(),\n            uid: phase.original.config.peer_uid,\n            gid: phase.original.config.peer_gid,\n            owner: phase.original.owner_pidfd.try_clone()?,\n            state: Mutex::new(RetirementState {\n                registered: 0,\n                active_requests: 0,\n                original_current: None,\n                intent: None,\n                intent_acknowledged: false,\n                clean_eof: 0,\n                stop_watcher: false,\n                acknowledged: false,\n            }),\n        });\n        scope.require_original(&phase.gate)?;\n        Ok(scope)\n    }\n\n    pub(crate) fn gate(&self) -> &Arc<SameActorPhaseGate> {\n        &self.gate\n    }\n\n    fn state(&self) -> io::Result<MutexGuard<'_, RetirementState>> {\n        self.state.lock().map_err(|_| {\n            self.gate.close();\n            io::Error::other(\"original Root retirement state poisoned\")\n        })\n    }\n\n    pub(crate) fn require_original(&self, gate: &Arc<SameActorPhaseGate>) -> io::Result<()> {\n        if !Arc::ptr_eq(&self.gate, gate) {\n            self.gate.close();\n            return Err(io::Error::other(\"Root retirement replaced its original phase gate\"));\n        }\n        let checked = (|| {\n            self.gate.require_open()?;\n            verify_pinned_process(\n                &self.registration,\n                self.uid,\n                self.gid,\n                &self.owner,\n                self.gate.deadline().instant(),\n            )?;\n            self.gate.require_open()?;\n            Ok(())\n        })();\n        if checked.is_err() {\n            self.gate.close();\n        }\n        checked\n    }\n\n    pub(crate) fn register_original_lane(\n        self: &Arc<Self>,\n        purpose: OriginalRootRetirementPurpose,\n        gate: &Arc<SameActorPhaseGate>,\n    ) -> io::Result<OriginalRootRetirementLane> {\n        let mut closing = CloseSameActorPhaseOnDrop::new(&self.gate);\n        self.require_original(gate)?;\n        let mut state = self.state()?;\n        let bit = purpose.bit();\n        if state.intent.is_some() || state.registered & bit != 0 {\n            return Err(io::Error::other(\"original Root retirement lane reused or too late\"));\n        }\n        state.registered |= bit;\n        drop(state);\n        self.require_original(gate)?;\n        closing.disarm();\n        Ok(OriginalRootRetirementLane {\n            scope: Arc::clone(self),\n            purpose,\n            closing: CloseSameActorPhaseOnDrop::new(gate),\n        })\n    }\n\n    pub(super) fn retain_original_current(\n        &self,\n        request: &OriginalDeploymentRequest,\n        acknowledgement: &OriginalDeploymentAcknowledgement,\n    ) -> io::Result<()> {\n        let mut closing = CloseSameActorPhaseOnDrop::new(&self.gate);\n        self.require_original(&self.gate)?;\n        request.require_original_stage(&self.binding, OriginalDeploymentStage::Current)?;\n        acknowledgement.require_original_request(request)?;\n        let binding = acknowledgement.registration_binding.clone()\n            .ok_or_else(|| io::Error::other(\"actual Root CURRENT registration missing\"))?;\n        let mut state = self.state()?;\n        if state.original_current.is_some() || state.intent.is_some() {\n            return Err(io::Error::other(\"Root retirement CURRENT registration reused\"));\n        }\n        state.original_current = Some((binding, acknowledgement.original_request.clone()));\n        drop(state);\n        self.require_original(&self.gate)?;\n        closing.disarm();\n        Ok(())\n    }\n\n    pub(super) fn authorize_original_retirement(\n        &self,\n        request: &OriginalRootRetirementRequest,\n    ) -> io::Result<Vec<u8>> {\n        let mut closing = CloseSameActorPhaseOnDrop::new(&self.gate);\n        self.require_original(&self.gate)?;\n        let mut state = self.state()?;\n        let (registration, current_request) = state.original_current.as_ref()\n            .ok_or_else(|| io::Error::other(\"Root retirement requires its actual CURRENT registration\"))?;\n        request.require_original(\n            &self.binding,\n            registration,\n            current_request,\n            OriginalRootRetirementStage::AuthorizeRootRetirement,\n            None,\n        )?;\n        if state.intent.is_some()\n            || state.registered != ALL_PURPOSES\n            || state.clean_eof != 0\n            || state.active_requests != 0\n        {\n            return Err(io::Error::other(\"original Root retirement is busy, incomplete, or consumed\"));\n        }\n        // This mutex is also the request-admission cut. No later original\n        // effect or response exchange can enter after this one-shot intent.\n        let intent = request.digest()?;\n        state.intent = Some(intent.clone());\n        drop(state);\n        self.require_original(&self.gate)?;\n        let response = retirement_response(request, &intent)?;\n        closing.disarm();\n        Ok(response)\n    }\n\n    pub(super) fn acknowledge_original_intent(&self) -> io::Result<()> {\n        let mut closing = CloseSameActorPhaseOnDrop::new(&self.gate);\n        self.require_original(&self.gate)?;\n        let mut state = self.state()?;\n        if state.intent.is_none() || state.intent_acknowledged {\n            return Err(io::Error::other(\"original Root retirement intent ACK reused\"));\n        }\n        state.intent_acknowledged = true;\n        drop(state);\n        self.require_original(&self.gate)?;\n        self.gate.notify_original_waiters();\n        closing.disarm();\n        Ok(())\n    }\n\n    pub(super) fn require_original_intent(\n        &self,\n        request: &OriginalRootRetirementRequest,\n    ) -> io::Result<String> {\n        self.require_original(&self.gate)?;\n        let state = self.state()?;\n        let intent = state.intent.as_ref()\n            .ok_or_else(|| io::Error::other(\"original Root retirement intent missing\"))?;\n        let (registration, current_request) = state.original_current.as_ref()\n            .ok_or_else(|| io::Error::other(\"actual original CURRENT registration missing\"))?;\n        request.require_original(\n            &self.binding,\n            registration,\n            current_request,\n            OriginalRootRetirementStage::ObserveRootWorkersJoined,\n            Some(intent),\n        )?;\n        if !state.intent_acknowledged || state.acknowledged {\n            return Err(io::Error::other(\"original Root retirement ACK state differs\"));\n        }\n        Ok(intent.clone())\n    }\n\n    pub(super) fn stop_original_deadline_worker(\n        &self,\n        joined: &super::deployment::OriginalRootDeploymentJoined,\n    ) -> io::Result<()> {\n        joined.require_original(self)?;\n        loop {\n            let epoch = self.gate.original_wait_epoch()?;\n            self.require_original(&self.gate)?;\n            let mut state = self.state()?;\n            if state.active_requests != 0 || state.clean_eof != ALL_PURPOSES {\n                return Err(io::Error::other(\"original Root business lanes have not retired\"));\n            }\n            if state.intent_acknowledged {\n                if state.stop_watcher {\n                    return Err(io::Error::other(\"original Root deadline worker already released\"));\n                }\n                state.stop_watcher = true;\n                drop(state);\n                self.gate.notify_original_waiters();\n                return self.require_original(&self.gate);\n            }\n            drop(state);\n            self.gate.wait_original_change(epoch)?;\n        }\n    }\n\n    pub(super) fn watch_original_deadline(&self) -> io::Result<()> {\n        let mut closing = CloseSameActorPhaseOnDrop::new(&self.gate);\n        loop {\n            let epoch = self.gate.original_wait_epoch()?;\n            self.require_original(&self.gate)?;\n            if self.state()?.stop_watcher {\n                self.require_original(&self.gate)?;\n                closing.disarm();\n                return Ok(());\n            }\n            self.gate.wait_original_change(epoch)?;\n        }\n    }\n\n    pub(super) fn acknowledge_original_workers(\n        &self,\n        request: &OriginalRootRetirementRequest,\n        joined: &super::deployment::OriginalRootAllWorkersJoined,\n    ) -> io::Result<Vec<u8>> {\n        joined.require_original(self)?;\n        let intent = self.require_original_intent(request)?;\n        let state = self.state()?;\n        if !state.stop_watcher || state.clean_eof != ALL_PURPOSES || state.active_requests != 0 {\n            return Err(io::Error::other(\"original Root worker scope is not joined\"));\n        }\n        drop(state);\n        retirement_response(request, &intent)\n    }\n\n    pub(super) fn mark_original_workers_acknowledged(\n        &self,\n        joined: &super::deployment::OriginalRootAllWorkersJoined,\n    ) -> io::Result<()> {\n        joined.require_original(self)?;\n        self.require_original(&self.gate)?;\n        let mut state = self.state()?;\n        if !state.stop_watcher || !state.intent_acknowledged || state.acknowledged {\n            return Err(io::Error::other(\"original Root workers ACK reused or incomplete\"));\n        }\n        state.acknowledged = true;\n        drop(state);\n        self.require_original(&self.gate)\n    }\n}\n\nimpl OriginalRootRetirementLane {\n    /// Kept by the actual channel owner until the original framed ACK finishes.\n    /// Root retirement never waits for this count inside its 500 ms request.\n    pub(crate) fn enter_original_request(&self) -> io::Result<OriginalRootRequestAdmission> {\n        self.scope.require_original(&self.scope.gate)?;\n        let mut state = self.scope.state()?;\n        if state.intent.is_some() || state.clean_eof & self.purpose.bit() != 0 {\n            return Err(io::Error::other(\"original Root lane is retiring\"));\n        }\n        state.active_requests = state.active_requests.checked_add(1)\n            .ok_or_else(|| io::Error::other(\"original Root request count overflow\"))?;\n        Ok(OriginalRootRequestAdmission { scope: Arc::clone(&self.scope) })\n    }\n\n    /// Called only after the original peer channel returned Ok(false). Every\n    /// framing/handler/ACK error remains an error in that actual caller.\n    pub(crate) fn accept_original_clean_eof(\n        mut self,\n        channel: HostAuthorityPeerChannel,\n        stream: SameActorPhaseStream,\n    ) -> io::Result<OriginalRootRetiredChannel> {\n        self.scope.require_original(&self.scope.gate)?;\n        HostAuthorityPeerChannel::check_peer_lifetime(&channel).map_err(io::Error::other)?;\n        let mut state = self.scope.state()?;\n        let bit = self.purpose.bit();\n        if state.intent.is_none() || state.clean_eof & bit != 0 {\n            return Err(io::Error::other(\"required original Root lane ended without its retirement\"));\n        }\n        state.clean_eof |= bit;\n        drop(state);\n        self.scope.require_original(&self.scope.gate)?;\n        self.closing.disarm();\n        Ok(OriginalRootRetiredChannel {\n            scope: Arc::clone(&self.scope),\n            purpose: self.purpose,\n            channel,\n            _stream: stream,\n            _closing: CloseSameActorPhaseOnDrop::new(&self.scope.gate),\n        })\n    }\n}\n\nimpl OriginalRootRetiredChannel {\n    pub(crate) fn require_original(\n        &self,\n        scope: &OriginalRootRetirementScope,\n        purpose: OriginalRootRetirementPurpose,\n    ) -> io::Result<()> {\n        if !std::ptr::eq(self.scope.as_ref(), scope) || self.purpose != purpose {\n            self.scope.gate.close();\n            return Err(io::Error::other(\"original Root retired channel origin differs\"));\n        }\n        self.scope.require_original(&self.scope.gate)?;\n        HostAuthorityPeerChannel::check_peer_lifetime(&self.channel).map_err(io::Error::other)?;\n        let state = self.scope.state()?;\n        if state.intent.is_none() || state.clean_eof & purpose.bit() == 0 {\n            return Err(io::Error::other(\"actual original Root clean EOF is missing\"));\n        }\n        Ok(())\n    }\n}\n\nimpl Drop for OriginalRootRequestAdmission {\n    fn drop(&mut self) {\n        let outcome = self.scope.state().and_then(|mut state| {\n            state.active_requests = state.active_requests.checked_sub(1)\n                .ok_or_else(|| io::Error::other(\"original Root request custody underflow\"))?;\n            Ok(())\n        });\n        if outcome.is_err() {\n            self.scope.gate.close();\n        }\n        self.scope.gate.notify_original_waiters();\n    }\n}\n\nimpl Drop for OriginalRootRetirementScope {\n    fn drop(&mut self) {\n        self.gate.close();\n    }\n}\n\nfn retirement_response(\n    request: &OriginalRootRetirementRequest,\n    intent: &str,\n) -> io::Result<Vec<u8>> {\n    OriginalRootRetirementAcknowledgement {\n        schema_version: 1,\n        purpose: RETIREMENT_PURPOSE.into(),\n        binding: request.binding.clone(),\n        sequence: request.sequence,\n        stage: request.stage,\n        original_request: request.digest()?,\n        original_intent: intent.into(),\n    }\n    .encode_original(request, intent)\n}\n"
        }
      ]
    },
    {
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_root_retirement_protocol.rs",
      "preimage": null,
      "preimage_bytes": null,
      "preimage_sha256": null,
      "postimage": "77cba7adc7a61b0177306a56ad608229e9d56d65",
      "postimage_bytes": 6234,
      "postimage_sha256": "b2da5390e1ba337554890bc29dd081a41cd2cf5799ef6e303f4aeb8d7b0d44b4",
      "operations": [
        {
          "op": "add",
          "content": "//! Data-only correlation for the bounded retirement of this Root's workers.\n//! Neither request nor acknowledgement proves C execution, daemon completion,\n//! authority consumption, or operating-system process exit.\n\nuse std::io;\n\nuse codex_hepta_types::Digest32;\nuse serde::Deserialize;\nuse serde::Serialize;\n\nuse crate::same_actor_q24_deployment_protocol::FRAME_BOUND;\nuse crate::same_actor_q24_deployment_protocol::OriginalDeploymentBinding;\n\npub(crate) const RETIREMENT_PURPOSE: &str =\n    \"hepta.same-actor-q24-deployment.root-retirement.v1\";\n\n#[derive(Clone, Copy, Debug, Eq, PartialEq, Deserialize, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub(crate) enum OriginalRootRetirementStage {\n    AuthorizeRootRetirement,\n    ObserveRootWorkersJoined,\n}\n\n#[derive(Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(crate) struct OriginalRootRetirementRequest {\n    pub(crate) schema_version: u8,\n    pub(crate) purpose: String,\n    pub(crate) binding: OriginalDeploymentBinding,\n    pub(crate) sequence: u8,\n    pub(crate) stage: OriginalRootRetirementStage,\n    pub(crate) current_registration: String,\n    pub(crate) current_request: String,\n    pub(crate) original_intent: Option<String>,\n}\n\nimpl OriginalRootRetirementRequest {\n    pub(crate) fn encode_original(&self) -> io::Result<Vec<u8>> {\n        self.binding.require_data()?;\n        require_digest(&self.current_registration)?;\n        require_digest(&self.current_request)?;\n        if self.schema_version != 1 || self.purpose != RETIREMENT_PURPOSE {\n            return Err(io::Error::other(\"original Root retirement purpose differs\"));\n        }\n        match (self.sequence, self.stage, self.original_intent.as_deref()) {\n            (1, OriginalRootRetirementStage::AuthorizeRootRetirement, None) => {}\n            (2, OriginalRootRetirementStage::ObserveRootWorkersJoined, Some(intent)) => {\n                require_digest(intent)?;\n            }\n            _ => return Err(io::Error::other(\"original Root retirement sequence differs\")),\n        }\n        encode_bounded(self)\n    }\n\n    pub(crate) fn decode_original(bytes: &[u8]) -> io::Result<Self> {\n        if bytes.is_empty() || bytes.len() > FRAME_BOUND {\n            return Err(io::Error::other(\"bounded Root retirement request required\"));\n        }\n        let request: Self = serde_json::from_slice(bytes).map_err(io::Error::other)?;\n        if request.encode_original()? != bytes {\n            return Err(io::Error::other(\"canonical Root retirement request required\"));\n        }\n        Ok(request)\n    }\n\n    pub(crate) fn digest(&self) -> io::Result<String> {\n        Ok(Digest32::of_parts(&[\n            b\"hepta.same-actor-q24-deployment.root-retirement-request.v1\\0\",\n            &self.encode_original()?,\n        ])\n        .to_string())\n    }\n\n    pub(crate) fn require_original(\n        &self,\n        binding: &OriginalDeploymentBinding,\n        current_registration: &str,\n        current_request: &str,\n        stage: OriginalRootRetirementStage,\n        original_intent: Option<&str>,\n    ) -> io::Result<()> {\n        self.encode_original()?;\n        if self.binding != *binding\n            || self.current_registration != current_registration\n            || self.current_request != current_request\n            || self.stage != stage\n            || self.original_intent.as_deref() != original_intent\n        {\n            return Err(io::Error::other(\"original Root retirement correlation changed\"));\n        }\n        Ok(())\n    }\n}\n\n/// A Root response is a bounded observation of its own resource scope. The\n/// second stage is encoded only by the actual Root finalizer after real joins.\n#[derive(Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(crate) struct OriginalRootRetirementAcknowledgement {\n    pub(crate) schema_version: u8,\n    pub(crate) purpose: String,\n    pub(crate) binding: OriginalDeploymentBinding,\n    pub(crate) sequence: u8,\n    pub(crate) stage: OriginalRootRetirementStage,\n    pub(crate) original_request: String,\n    pub(crate) original_intent: String,\n}\n\nimpl OriginalRootRetirementAcknowledgement {\n    pub(crate) fn require_original_request(\n        &self,\n        request: &OriginalRootRetirementRequest,\n        intent: &str,\n    ) -> io::Result<()> {\n        request.encode_original()?;\n        require_digest(intent)?;\n        if self.schema_version != 1\n            || self.purpose != RETIREMENT_PURPOSE\n            || self.binding != request.binding\n            || self.sequence != request.sequence\n            || self.stage != request.stage\n            || self.original_request != request.digest()?\n            || self.original_intent != intent\n        {\n            return Err(io::Error::other(\"original Root retirement acknowledgement differs\"));\n        }\n        Ok(())\n    }\n\n    pub(crate) fn encode_original(\n        &self,\n        request: &OriginalRootRetirementRequest,\n        intent: &str,\n    ) -> io::Result<Vec<u8>> {\n        self.require_original_request(request, intent)?;\n        encode_bounded(self)\n    }\n\n    pub(crate) fn decode_original(\n        bytes: &[u8],\n        request: &OriginalRootRetirementRequest,\n        intent: &str,\n    ) -> io::Result<Self> {\n        if bytes.is_empty() || bytes.len() > FRAME_BOUND {\n            return Err(io::Error::other(\"bounded Root retirement acknowledgement required\"));\n        }\n        let response: Self = serde_json::from_slice(bytes).map_err(io::Error::other)?;\n        if response.encode_original(request, intent)? != bytes {\n            return Err(io::Error::other(\"canonical Root retirement acknowledgement required\"));\n        }\n        Ok(response)\n    }\n}\n\nfn require_digest(value: &str) -> io::Result<()> {\n    let digest = value.parse::<Digest32>().map_err(io::Error::other)?;\n    if digest.is_zero() || digest.to_string() != value {\n        return Err(io::Error::other(\"canonical original Root retirement digest required\"));\n    }\n    Ok(())\n}\n\nfn encode_bounded(value: &impl Serialize) -> io::Result<Vec<u8>> {\n    let bytes = serde_json::to_vec(value).map_err(io::Error::other)?;\n    if bytes.is_empty() || bytes.len() > FRAME_BOUND {\n        return Err(io::Error::other(\"Root retirement frame exceeds its original bound\"));\n    }\n    Ok(bytes)\n}\n"
        }
      ]
    },
    {
      "path": "codex-rs/hepta-agentd/src/authority_host_same_actor_q24_retirement_worker.rs",
      "preimage": null,
      "preimage_bytes": null,
      "preimage_sha256": null,
      "postimage": "aa1b04235d21b9c0843d4ce0e9e4e125fad5df9e",
      "postimage_bytes": 14884,
      "postimage_sha256": "ea5bc70ea86980709de26091b2c467d7896ebded70a8d707e6d264604b29275b",
      "operations": [
        {
          "op": "add",
          "content": "//! The Root-only retirement serving scope. It retains actual returned owners;\n//! a peer request or a zero count can never construct a joined scope.\n\nuse super::*;\n\npub(in super::super) struct OriginalRootScopedJoined {\n    channels: learning::OriginalRootScopedChannelsJoined,\n    _lane: learning::BoundLearning,\n    _record: OriginalPhaseRecord,\n    _scope: scope_cap::ScopeRuntime,\n    _origin: crate::authority_host_service::generation_initial::OriginalSameActorPhaseA,\n}\n\nstruct OriginalRootBusinessJoined {\n    retirement: Arc<crate::OriginalRootRetirementScope>,\n    lanes: listeners::OriginalRootAuthorityLanesJoined,\n    scoped: OriginalRootScopedJoined,\n    _initial: generation_initial::BoundInitial,\n    _control: BoundPhaseControl,\n    _initial_retirement: OriginalInitialRetirement,\n}\n\n/// Only constructed after joining the actual Initial, scoped and all nested\n/// lane workers. The outer deployment still joins its registration, material\n/// bridge and deadline worker before it may acknowledge RootWorkersJoined.\npub(in super::super) struct OriginalRootPhaseWorkersJoined {\n    business: OriginalRootBusinessJoined,\n    // Keep this actual issuer, clock, checkpoints and registered observers\n    // until after the final Root ACK. The writer-lock File was already moved\n    // to the daemon by the original three-right handoff; it is not here.\n    _original: PreparedHostAuthoritySession,\n}\n\nimpl OriginalRootPhaseWorkersJoined {\n    pub(in super::super) fn require_original(\n        &self,\n        retirement: &crate::OriginalRootRetirementScope,\n    ) -> io::Result<()> {\n        if !std::ptr::eq(self.business.retirement.as_ref(), retirement) {\n            return Err(io::Error::other(\"Root joined scope replaced its original retirement owner\"));\n        }\n        self.business.lanes.require_original(retirement)?;\n        self.business.scoped.channels.require_original(retirement)\n    }\n}\n\npub(in super::super) fn serve_original_phase_for_retirement(\n    phase: PreparedRootSameActorQ24PhaseV1,\n    root_retirement: &Arc<crate::OriginalRootRetirementScope>,\n    ready: impl FnOnce() -> io::Result<()>,\n) -> io::Result<OriginalRootPhaseWorkersJoined> {\n    let PreparedRootSameActorQ24PhaseV1 {\n        mut original,\n        gate,\n        record,\n        descriptor,\n        model,\n        scope: scope_runtime,\n        start,\n        mut closing,\n    } = phase;\n    if start.is_some() {\n        return Err(io::Error::other(\n            \"original phase start capabilities must be taken before serving\",\n        ));\n    }\n    root_retirement.require_original(&gate)?;\n    let initial = generation_initial::BoundInitial::bind(\n        original\n            .initial_publication\n            .take()\n            .ok_or_else(|| io::Error::other(\"original phase Initial route missing\"))?,\n        &original.config,\n    )?;\n    let control =\n        BoundPhaseControl::bind(&original.config, &descriptor.control_socket, initial.path())?;\n    initial.activate_same_actor_phase()?;\n    scope_runtime.activate()?;\n    let five = listeners::bind_runtime_lanes(&original.config, || Ok(()))?;\n    let retirement = OriginalInitialRetirement::new(&gate, &descriptor.phase);\n    let (lanes, scoped) = std::thread::scope(|threads| {\n        let mut scope_close = CloseSameActorPhaseOnDrop::new(&gate);\n        let (initial_sender, initial_receiver) = mpsc::sync_channel(1);\n        let initial_ref = &initial;\n        let original_ref = &original;\n        let gate_ref = &gate;\n        let retirement_ref = &retirement;\n        let first = threads.spawn(move || {\n            let mut phase_close = CloseSameActorPhaseOnDrop::new(gate_ref);\n            let result = initial_ref.serve_same_actor_phase_initial(\n                &original_ref.service,\n                &original_ref.config,\n                &original_ref.registration,\n                &original_ref.owner_pidfd,\n                gate_ref,\n                retirement_ref,\n            );\n            let transferred = match result {\n                Ok(slot) => initial_sender\n                    .try_send(slot)\n                    .map_err(|_| io::Error::other(\"original Initial owner handoff was lost\")),\n                Err(error) => Err(error),\n            };\n            gate_ref.notify_original_waiters();\n            if transferred.is_ok() {\n                phase_close.disarm();\n            }\n            transferred\n        });\n        let scoped = threads.spawn(|| {\n            run_original_scoped_phase_for_retirement(\n                &original,\n                &gate,\n                record,\n                &descriptor,\n                &model,\n                scope_runtime,\n                &control,\n                &retirement,\n                initial_receiver,\n                root_retirement,\n            )\n        });\n        let announced = (|| {\n            gate.require_open()?;\n            ready()?;\n            gate.require_open()?;\n            Ok(())\n        })();\n        let served = match announced {\n            Ok(()) => listeners::serve_bound_phase_lanes_for_root_retirement(\n                &original.service,\n                &original.config,\n                &original.registration,\n                &original.owner_pidfd,\n                five,\n                root_retirement,\n            ),\n            Err(error) => Err(error),\n        };\n        if served.is_err() {\n            gate.close();\n        }\n        let first = first\n            .join()\n            .map_err(|_| io::Error::other(\"original Initial phase worker panicked\"))\n            .and_then(|result| result);\n        if first.is_err() {\n            gate.close();\n        }\n        let scoped = scoped\n            .join()\n            .map_err(|_| io::Error::other(\"original scoped phase worker panicked\"))\n            .and_then(|result| result);\n        if scoped.is_err() {\n            gate.close();\n        }\n        let served = served?;\n        first?;\n        let scoped = scoped?;\n        root_retirement.require_original(&gate)?;\n        scope_close.disarm();\n        Ok::<_, io::Error>((served, scoped))\n    })?;\n    let joined = OriginalRootPhaseWorkersJoined {\n        business: OriginalRootBusinessJoined {\n            retirement: Arc::clone(root_retirement),\n            lanes,\n            scoped,\n            _initial: initial,\n            _control: control,\n            _initial_retirement: retirement,\n        },\n        _original: original,\n    };\n    joined.require_original(root_retirement)?;\n    closing.disarm();\n    Ok(joined)\n}\n\nfn run_original_scoped_phase_for_retirement(\n    original: &PreparedHostAuthoritySession,\n    gate: &Arc<SameActorPhaseGate>,\n    mut record: OriginalPhaseRecord,\n    descriptor: &OriginalPhaseBootstrap,\n    model: &crate::HostAuthorityQ24ModelFactoryReservationV1,\n    scope: scope_cap::ScopeRuntime,\n    control: &BoundPhaseControl,\n    retirement: &OriginalInitialRetirement,\n    initial_receiver: mpsc::Receiver<\n        crate::authority_host_service::generation_initial::RegisteredGenerationInitial,\n    >,\n    root_retirement: &Arc<crate::OriginalRootRetirementScope>,\n) -> io::Result<OriginalRootScopedJoined> {\n    let mut closing = CloseSameActorPhaseOnDrop::new(gate);\n    root_retirement.require_original(gate)?;\n    let submission = loop {\n        let epoch = gate.original_wait_epoch()?;\n        owner_alive(&original.owner_pidfd, gate.deadline().instant())?;\n        match scope.receiver.try_recv() {\n            Ok(value) => break value,\n            Err(mpsc::TryRecvError::Empty) => gate.wait_original_change(epoch)?,\n            Err(mpsc::TryRecvError::Disconnected) => {\n                return Err(io::Error::other(\n                    \"original Root scope capability was dropped\",\n                ));\n            }\n        }\n    };\n    let stream = control.accept_original(\n        &original.config,\n        &original.registration,\n        &original.owner_pidfd,\n        gate,\n    )?;\n    let joined = accept_original_phase_join(\n        &original.service,\n        &original.config,\n        &original.registration,\n        &original.owner_pidfd,\n        stream,\n        HostAuthorityPeerPolicy {\n            peer: HostIssuerPeer {\n                uid: original.config.peer_uid,\n                pid: original.registration.peer_pid,\n            },\n            timeout: std::time::Duration::from_millis(original.config.timeout_ms),\n            lifetime: std::time::Duration::from_millis(original.config.lifetime_ms),\n            request_bound: 16 * 1024,\n            response_bound: 16 * 1024,\n        },\n        &descriptor.phase,\n        &submission.profile,\n        retirement,\n        gate,\n    )?;\n    // A transport EOF can only transfer this actual held owner. It cannot\n    // replace the independently completed original join above.\n    let initial = loop {\n        let epoch = gate.original_wait_epoch()?;\n        match initial_receiver.try_recv() {\n            Ok(slot) => break slot,\n            Err(mpsc::TryRecvError::Empty) => gate.wait_original_change(epoch)?,\n            Err(mpsc::TryRecvError::Disconnected) => {\n                return Err(io::Error::other(\n                    \"original Initial owner was not transferred\",\n                ));\n            }\n        }\n    };\n    joined.require_original_profile(&descriptor.phase, &submission.profile, retirement, gate)?;\n    let claim = original.service.claim_same_actor_phase_after_original_a(\n        &original.config,\n        &original.registration,\n        &original.owner_pidfd,\n        &initial,\n        &submission.profile,\n        &mut record,\n        gate,\n    )?;\n    // Any failure above leaves a claimed/partial record closed. No fallthrough\n    // can open a Learning/Model namespace or convert this attempt into recovery.\n    joined.require_original_profile(&descriptor.phase, &submission.profile, retirement, gate)?;\n    let origin = initial.retire_original_phase_slot(claim)?;\n    gate.require_open()?;\n    origin.require_retained_predecessor()?;\n    record.require_claimed()?;\n    let namespace =\n        crate::authority_host_same_actor_q24_phase_namespace::OriginalPhaseNamespaceContext {\n            gate,\n            record: &record,\n        };\n    original\n        .service\n        .reserve_original_learning_profile_in_phase(\n            &original.config,\n            &original.registration,\n            &original.owner_pidfd,\n            &submission.profile,\n            Some(&namespace),\n        )?;\n    gate.require_open()?;\n    record.require_claimed()?;\n    let mut learning = original.service.open_original_learning_profile_in_phase(\n        &original.config,\n        &original.registration,\n        &original.owner_pidfd,\n        submission.profile.clone(),\n        Some(&namespace),\n    )?;\n    gate.require_open()?;\n    record.require_claimed()?;\n    let factory_profile = HostAuthorityService::reserve_original_phase_q24_model_factory(\n        &original.service,\n        &original.config,\n        &original.registration,\n        &original.owner_pidfd,\n        &learning.profile,\n        model,\n        Some(&namespace),\n    )?;\n    gate.require_open()?;\n    record.require_claimed()?;\n    let factory = original.service.open_original_phase_q24_model_reservation(\n        &original.config,\n        &original.registration,\n        &original.owner_pidfd,\n        &learning.profile,\n        model.clone(),\n        Some(&namespace),\n    )?;\n    if factory.profile != factory_profile {\n        return Err(io::Error::other(\n            \"original reserved Model factory changed on open\",\n        ));\n    }\n    learning.q24_model = Some(factory);\n    let learning_bootstrap = original.service.seal_learning_checkpoint(\n        &original.config,\n        &original.registration,\n        &original.owner_pidfd,\n        &learning,\n    )?;\n    gate.require_open()?;\n    let (publication, capability, publication_offer) =\n        generation_publication::original_publication_route(\n            &original.service,\n            &original.config,\n            &original.registration,\n            &original.owner_pidfd,\n            &learning,\n        )?;\n    gate.require_open()?;\n    record.require_claimed()?;\n    gate.require_open()?;\n    record.mark_scoped_before_rights(factory_profile.binding().to_string())?;\n    gate.require_open()?;\n    let factory_offer = original.service.seal_q24_model_factory_offer(\n        &original.config,\n        &original.registration,\n        &original.owner_pidfd,\n        learning\n            .q24_model\n            .as_mut()\n            .ok_or_else(|| io::Error::other(\"original scoped Model owner missing\"))?,\n    )?;\n    let scoped_descriptor = crate::same_actor_q24_phase_protocol::OriginalScopedPhaseBootstrap {\n        purpose: crate::same_actor_q24_phase_protocol::SCOPED_PURPOSE.into(),\n        phase: descriptor.phase.clone(),\n        original: descriptor.clone(),\n        learning: submission.profile,\n        claim: record.claimed()?.clone(),\n        factory: factory_profile.binding().to_string(),\n    };\n    let scoped_seal = crate::authority_host_bootstrap_seal::seal_bytes(\n        &serde_json::to_vec(&scoped_descriptor).map_err(io::Error::other)?,\n    )?;\n    let lane = learning::BoundLearning::bind(learning, &original.config, Some(publication))?;\n    record.require_scoped()?;\n    gate.require_open()?;\n    let enrolled = RootSameActorScopedEnrollmentV1 {\n        offer: crate::root_production_handoff::same_actor_phase::RootSameActorScopedOfferV1 {\n            bootstrap: scoped_seal, learning: learning_bootstrap,\n            model: factory_offer, publication: publication_offer,\n        },\n        publication: generation_publication::RootGenerationPublicationEnrollmentCapabilityV1::into_same_actor_phase(\n            capability, gate,\n        ),\n        gate: Arc::clone(gate),\n        closing: CloseSameActorPhaseOnDrop::new(gate),\n    };\n    let context = OriginalPhasePublicationContext {\n        gate,\n        record: &record,\n        original: &origin,\n    };\n    let channels = lane.serve_same_actor_phase_learning_for_retirement(\n        &original.service,\n        &original.config,\n        &original.registration,\n        &original.owner_pidfd,\n        (&context, root_retirement),\n        || {\n            record.require_scoped()?;\n            gate.require_open()?;\n            submission\n                .acknowledgement\n                .try_send(Ok(enrolled))\n                .map_err(|_| {\n                    io::Error::other(\"original scoped owner offer acknowledgement lost\")\n                })?;\n            gate.notify_original_waiters();\n            gate.require_open()?;\n            Ok(())\n        },\n    )?;\n    channels.require_original(root_retirement)?;\n    record.require_scoped()?;\n    gate.require_open()?;\n    closing.disarm();\n    Ok(OriginalRootScopedJoined {\n        channels,\n        _lane: lane,\n        _record: record,\n        _scope: scope,\n        _origin: origin,\n    })\n}\n"
        }
      ]
    },
