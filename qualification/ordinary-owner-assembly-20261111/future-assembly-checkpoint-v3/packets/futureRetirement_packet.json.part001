          "after": "        Err(HostIssuerTransportError::Closed)\n    }\n}\n\nimpl HostAuthorityService {\n    pub(crate) fn serve_learning_checkpoint_for_root_retirement(\n        &self,\n        backend: &LearningIterationCheckpointOwnerV1,\n        stream: UnixStream,\n        mut policy: HostAuthorityPeerPolicy,\n        owner_pidfd: OwnedFd,\n        retirement: &std::sync::Arc<crate::OriginalRootRetirementScope>,\n    ) -> Result<crate::OriginalRootRetiredChannel, HostIssuerTransportError> {\n        let phase = retirement.gate();\n        let mut closing = crate::same_actor_q24_phase_gate::CloseSameActorPhaseOnDrop::new(phase);\n        phase.require_open().map_err(unavailable)?;\n        let stream_stop = phase.retain_original_stream(&stream).map_err(unavailable)?;\n        let writer: &RegisteredWriter = self\n            .writer\n            .as_ref()\n            .ok_or(HostIssuerTransportError::Unavailable)?;\n        if backend.registered_agent_id() != self.identity.agent_id.to_string() {\n            return Err(HostIssuerTransportError::PeerDenied);\n        }\n        policy.request_bound = 16 * 1024;\n        policy.response_bound = 16 * 1024;\n        let mut channel = HostAuthorityPeerChannel::from_stream_until(\n            stream,\n            policy,\n            owner_pidfd,\n            phase.deadline().instant(),\n        )?;\n        let retirement_lane = retirement\n            .register_original_lane(crate::OriginalRootRetirementPurpose::Learning, phase)\n            .map_err(unavailable)?;\n        let mut next_request_id = 1;\n        let mut retirement_admission = None;\n        while channel.exchange(|bytes| {\n            retirement_admission = Some(\n                retirement_lane.enter_original_request().map_err(unavailable)?,\n            );\n            let _admission = phase.enter_original_lane().map_err(unavailable)?;\n            self.check_logind_lifetime().map_err(unavailable)?;\n            let response = writer.exchange_same_actor_learning_checkpoint(\n                &self.issuer,\n                &self.clock,\n                backend,\n                bytes,\n                &mut next_request_id,\n                phase,\n            )?;\n            self.check_logind_lifetime().map_err(unavailable)?;\n            phase.require_open().map_err(unavailable)?;\n            Ok(response)\n        })? {\n            phase.require_open().map_err(unavailable)?;\n            drop(retirement_admission.take());\n        }\n        let retired = retirement_lane\n            .accept_original_clean_eof(channel, stream_stop)\n            .map_err(unavailable)?;\n        closing.disarm();\n        Ok(retired)\n    }\n}\n"
        }
