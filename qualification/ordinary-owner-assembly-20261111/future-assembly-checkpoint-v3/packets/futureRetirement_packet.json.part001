  "files": [
    {
      "path": "codex-rs/hepta-agentd/src/authority_host_same_actor_q24_retirement.rs",
      "preimage": null,
      "preimage_bytes": null,
      "preimage_sha256": null,
      "postimage": "c4174a13da61e0dc138648c0bee198e4538a967f",
