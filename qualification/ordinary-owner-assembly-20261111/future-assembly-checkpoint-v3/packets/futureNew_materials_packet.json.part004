nown_fields)]\npub(super) struct OriginalDeploymentData {\n    pub schema_version: u32,\n    pub binding: OriginalDeploymentBinding,\n    pub initial: OriginalInitialData,\n    pub task: OriginalCircuitData,\n    pub learning: OriginalLearningMaterialsData,\n    pub artifacts: OriginalArtifactOwnerData,\n    pub authbus_trust: PinnedFileData,\n    pub authbus_checkpoint: MutableFileData,\n    pub objective_profile: PinnedFileData,\n    pub plasticity: PinnedFileData,\n    pub objective_a: PinnedFileData,\n    pub completion_a: PathBuf,\n    pub scoped_material_ready: OriginalActorExchangeData,\n    pub independent_training: OriginalActorExchangeData,\n    pub artifact_decision: OriginalActorExchangeData,\n    pub independent_selection: OriginalActorExchangeData,\n    pub current_material_ready: OriginalActorExchangeData,\n    pub original_c: OriginalCData,\n    pub objective_c: PinnedFileData,\n    pub outcome_c: PathBuf,\n    pub host_capacity: usize,\n}\n\n#[derive(Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalACompletionData {\n    pub schema_version: u32,\n    pub phase: String,\n    pub outcome: OriginalSignedOutcomeData,\n    pub preparation: OriginalPreparationData,\n}\n#[derive(Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalCOutcomeData {\n    pub schema_version: u32,\n    pub phase: String,\n    pub outcome: OriginalSignedOutcomeData,\n}\n\n#[derive(Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalEvaluationResponse {\n    pub schema_version: u32,\n    pub request_digest: [u8; 32],\n    pub original: OriginalEvaluationData,\n}\n#[derive(Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalArtifactResponse {\n    pub schema_version: u32,\n    pub request_digest: [u8; 32],\n    pub original: OriginalArtifactDecisionData,\n}\n#[derive(Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalSelectionResponse {\n    pub schema_version: u32,\n    pub request_digest: [u8; 32],\n    pub original: OriginalSelectionData,\n}\n#[derive(Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalMaterialReady {\n    pub schema_version: u32,\n    pub request_digest: [u8; 32],\n    pub material_digest: [u8; 32],\n}\n"
        }
      ]
    },
    {
      "key": "witness_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_witness.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_witness.rs",
        "blob": "3a89520c8c07521eb3370a291732dc8ac282c89e",
        "bytes": 1971,
        "sha256": "45c73f1b7e73ddd73693e74556fae1fc2d68e71ca0fb3253064e7978c09eed2e",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Actual independently placed witness files for deployment owners.\n//! Descriptor fields only select the original scope and generation; this\n//! constructor retains the real file and runs the original witness validation.\n\nuse codex_hepta_neuron::FileAnchorWitnessStore;\nuse codex_hepta_neuron::JournalScope;\nuse codex_hepta_types::Digest32;\nuse codex_hepta_types::Generation;\nuse serde::Deserialize;\nuse serde::Serialize;\n\nuse crate::AgentdError;\n\nuse super::deployment_error;\nuse super::deployment_refused;\nuse super::files::MutableFileData;\nuse super::files::OriginalDeploymentFiles;\nuse super::files::OriginalFileMode;\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalWitnessData {\n    pub file: MutableFileData,\n    pub scope: [u8; 32],\n    pub objective: [u8; 32],\n    pub generation: u64,\n    pub maximum_records: usize,\n}\n\nimpl OriginalWitnessData {\n    pub(super) fn open_original(\n        &self,\n        files: &mut OriginalDeploymentFiles,\n    ) -> Result<FileAnchorWitnessStore, AgentdError> {\n        let scope = JournalScope {\n            scope_digest: Digest32::from_array(self.scope),\n            objective_digest: Digest32::from_array(self.objective),\n        };\n        let generation = Generation::new(self.generation).map_err(deployment_error)?;\n        let file = files.open_original_owner(&self.file)?;\n        files.require_original_context()?;\n        let witness = FileAnchorWitnessStore::open(\n            file, scope, generation, self.maximum_records,\n        )\n        .map_err(deployment_error)?;\n        files.require_original_context()?;\n        Ok(witness)\n    }\n}\n\npub(super) fn require_fresh_original_file(input: &MutableFileData) -> Result<(), AgentdError> {\n    if matches!(input.mode, OriginalFileMode::Recover) {\n        return Err(deployment_refused(\n            \"this fresh Learning owner cannot use recovery data or reset its trust history\",\n        ));\n    }\n    Ok(())\n}\n"
        }
      ]
    },
    {
      "key": "deployment_parent_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment.rs",
        "blob": "f4f535f7d7bb53489a6cf0e2466eeff380327c4d",
        "bytes": 3593,
        "sha256": "7fcfc53c9790b0aed6ab021d9acc5b09df208fe782539af83185abd302ff9741",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Concrete ordinary deployment material owners and event coordinator.\n//! Data from files never substitutes for the original signed ingress,\n//! Prepared, B execution, Root approval or opaque owner capabilities.\n\nuse std::path::PathBuf;\nuse std::sync::Arc;\nuse codex_hepta_types::Digest32;\nuse crate::AgentdError;\nuse crate::root_production_inputs::same_actor_phase::OriginalSameActorRootContext;\nuse crate::same_actor_q24_phase::OriginalSameActorBusinessInputsV1;\n\n#[path = \"same_actor_q24_deployment_client.rs\"]\nmod client;\n#[path = \"same_actor_q24_deployment_ingress.rs\"]\nmod ingress;\n#[path = \"same_actor_q24_deployment_owner.rs\"]\nmod owner;\n#[path = \"same_actor_q24_deployment_factory.rs\"]\nmod factory;\n#[path = \"same_actor_q24_deployment_coordinator.rs\"]\nmod coordinator;\n#[path = \"same_actor_q24_deployment_files.rs\"]\nmod files;\n#[path = \"same_actor_q24_deployment_learning_data.rs\"]\nmod learning_data;\n#[path = \"same_actor_q24_deployment_learning.rs\"]\nmod learning;\n#[path = \"same_actor_q24_deployment_preparation.rs\"]\nmod preparation;\n#[path = \"same_actor_q24_deployment_cell_data.rs\"]\nmod cell_data;\n#[path = \"same_actor_q24_deployment_bundle_data.rs\"]\nmod bundle_data;\n#[path = \"same_actor_q24_deployment_model.rs\"]\nmod model;\n#[path = \"same_actor_q24_deployment_task.rs\"]\nmod task;\n#[path = \"same_actor_q24_deployment_c.rs\"]\nmod c;\n#[path = \"same_actor_q24_deployment_artifact_data.rs\"]\nmod artifact_data;\n#[path = \"same_actor_q24_deployment_artifacts.rs\"]\nmod artifacts;\n#[path = \"same_actor_q24_deployment_exchange.rs\"]\nmod exchange;\n#[path = \"same_actor_q24_deployment_temporal_data.rs\"]\nmod temporal_data;\n#[path = \"same_actor_q24_deployment_comparison_data.rs\"]\nmod comparison_data;\n#[path = \"same_actor_q24_deployment_evaluation_data.rs\"]\nmod evaluation_data;\n#[path = \"same_actor_q24_deployment_evaluation_signing.rs\"]\nmod evaluation_signing;\n#[path = \"same_actor_q24_deployment_evaluation_storage.rs\"]\nmod evaluation_storage;\n#[path = \"same_actor_q24_deployment_evaluation.rs\"]\nmod evaluation;\n#[path = \"same_actor_q24_deployment_observation_data.rs\"]\nmod observation_data;\n#[path = \"same_actor_q24_deployment_data.rs\"]\nmod data;\n#[path = \"same_actor_q24_deployment_witness.rs\"]\nmod witness;\n\npub(crate) use owner::OriginalDeploymentCoordinatorOwner;\n\n/// Only a selected pathname and exact immutable digest, not authority.\npub(crate) struct OriginalDeploymentDescriptor(files::PinnedFileData);\n\nimpl OriginalDeploymentDescriptor {\n    pub(crate) fn from_original_arguments(path: PathBuf, digest: Digest32) -> Result<Self, AgentdError> {\n        if !path.is_absolute() {\n            return Err(deployment_refused(\"original deployment descriptor must be absolute\"));\n        }\n        Ok(Self(files::PinnedFileData { path, sha256: digest.into_array() }))\n    }\n}\n\npub(crate) async fn open_original_deployment(\n    context: Arc<OriginalSameActorRootContext>,\n    descriptor: OriginalDeploymentDescriptor,\n) -> Result<(OriginalSameActorBusinessInputsV1, OriginalDeploymentCoordinatorOwner), AgentdError> {\n    let factory::OriginalLoadedDeployment { business, coordinator } =\n        factory::load_original_deployment(Arc::clone(&context), descriptor.0).await?;\n    let owner = OriginalDeploymentCoordinatorOwner::start_original(context, coordinator)?;\n    Ok((business, owner))\n}\n\nfn deployment_refused(message: &str) -> AgentdError {\n    AgentdError::GenerationFenced(format!(\"original same-actor deployment: {message}\"))\n}\n\nfn deployment_error(error: impl std::fmt::Display) -> AgentdError {\n    AgentdError::Invalid(format!(\"original same-actor deployment: {error}\"))\n}\n"
        }
      ]
    },
    {
      "key": "main_overlay",
