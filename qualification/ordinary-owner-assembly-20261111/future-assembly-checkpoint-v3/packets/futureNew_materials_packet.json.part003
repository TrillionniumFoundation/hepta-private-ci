      "operations": [
        {
          "op": "add_file",
          "content": "//! Actual Artifact owner, existing CURRENT floor and independent selection.\n//! The descriptor supplies original signed material. None of these loaders\n//! signs a head or treats an untrusted local snapshot as an independent floor.\n\nuse std::path::PathBuf;\nuse std::sync::{Arc, Mutex};\nuse codex_hepta_learning_artifacts::{\n    ArtifactSelectionVerifierV1, DatasetWithdrawalSnapshotReceiptV1,\n    LearningArtifactOwnerService, LearningArtifactOwnerServiceConfigV1,\n    LearningArtifactPublishRequestV1, SignedArtifactSelectionV1,\n    admit_manifest_at_withdrawal_head_v3, read_dataset_withdrawal_snapshot,\n};\nuse codex_hepta_types::{Digest32, StableId};\nuse serde::{Deserialize, Serialize};\nuse crate::{AgentdError, AgentdGenerationSelectionFilesV1, AgentdSelectedGenerationV1,\n    OriginalCellQ24SelectionInputsV1};\nuse crate::authority_host_runtime::{\n    OriginalDeploymentCurrentData, OriginalDeploymentOwnerTrustData,\n    OriginalDeploymentSelectionData, OriginalDeploymentSelectorTrustData,\n    OriginalDeploymentWithdrawalData,\n};\nuse crate::same_actor_q24_phase::OriginalSameActorArtifactInputsV1;\nuse super::artifact_data::{OriginalArtifactManifestData, OriginalArtifactWriterData};\nuse super::files::{OriginalDeploymentFiles, OriginalDirectoryPin, OriginalPinnedRead, PinnedFileData};\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalSelectionData {\n    pub signed: OriginalDeploymentSelectionData,\n    pub registry_snapshot: PinnedFileData,\n    pub payload: PinnedFileData,\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalArtifactOwnerData {\n    pub root: PathBuf,\n    pub trust: OriginalDeploymentOwnerTrustData,\n    pub writer_lease: OriginalArtifactWriterData,\n    // This is mandatory original Root-approved history. It is never inferred\n    // from the files which are being opened and cannot silently become None.\n    pub required_current_head: OriginalDeploymentCurrentData,\n    pub withdrawal_file: PinnedFileData,\n    pub withdrawal: OriginalDeploymentWithdrawalData,\n    pub storage_binding: [u8; 32],\n    pub selector: OriginalDeploymentSelectorTrustData,\n    pub initial_selection: OriginalSelectionData,\n}\n\n/// The exact path/inode pins are retained for as long as this concrete\n/// coordinator can operate its original path-based Artifact owner.\npub(super) struct OriginalDeploymentArtifacts {\n    owner: Arc<Mutex<LearningArtifactOwnerService>>,\n    verifier: ArtifactSelectionVerifierV1,\n    directories: Vec<OriginalDirectoryPin>,\n    lock: OriginalPinnedRead,\n}\n\nimpl OriginalDeploymentArtifacts {\n    pub(super) fn open_original(\n        data: &OriginalArtifactOwnerData,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<(Self, AgentdSelectedGenerationV1), AgentdError> {\n        // All named directories and the actual writer lock must already\n        // exist. The original owner's creation fallback is not enrollment.\n        let mut directories = vec![files.pin_original_owner_directory(&data.root)?];\n        for name in [\"writer\", \"transactions\", \"payloads\", \"registries\", \"witnesses\", \"heads\"] {\n            directories.push(files.pin_original_owner_directory(&data.root.join(name))?);\n        }\n        let lock = files.pin_original_artifact_lock(&data.root.join(\"writer/owner.lock\"))?;\n        let withdrawal_file = files.read_original(&data.withdrawal_file, 16 * 1024 * 1024)?;\n        let withdrawal_registry = read_dataset_withdrawal_snapshot(\n            withdrawal_file.clone_original_file()?,\n            DatasetWithdrawalSnapshotReceiptV1 {\n                binding: Digest32::from_array(data.withdrawal.binding),\n                scope_digest: Digest32::from_array(data.withdrawal.scope),\n                head_digest: Digest32::from_array(data.withdrawal.head),\n                file_digest: Digest32::from_array(data.withdrawal.file_digest),\n                records: data.withdrawal.records, encoded_bytes: data.withdrawal.encoded_bytes,\n            },\n        ).map_err(deployment_error)?;\n        withdrawal_file.require_original_pin()?;\n        let trust = data.trust.original_owner_trust().map_err(deployment_error)?;\n        let verifier = data.selector.original_selector(&trust).map_err(deployment_error)?;\n        let writer_lease = data.writer_lease.original()?;\n        let current = data.required_current_head.original_current().map_err(deployment_error)?;\n        files.require_original_context()?;\n        let owner = LearningArtifactOwnerService::open(LearningArtifactOwnerServiceConfigV1 {\n            root: data.root.clone(), trust, writer_lease,\n            required_current_head: Some(current), withdrawal_registry,\n            storage_binding: Digest32::from_array(data.storage_binding), now,\n        }).map_err(deployment_error)?;\n        if owner.recovery_required().is_some() {\n            return Err(deployment_refused(\"original Artifact operation is not terminal\"));\n        }\n        for directory in &directories { directory.require_original_pin()?; }\n        lock.require_original_pin()?;\n        files.require_original_context()?;\n        let material = data.initial_selection.open_original(files, &verifier)?;\n        let selected = AgentdSelectedGenerationV1::load(\n            &owner, material.verifier, material.signed, material.files, now,\n        )?;\n        files.require_original_context()?;\n        Ok((Self { owner: Arc::new(Mutex::new(owner)), verifier, directories, lock }, selected))\n    }\n\n    pub(super) fn owner(&self) -> &Arc<Mutex<LearningArtifactOwnerService>> { &self.owner }\n\n    pub(super) fn require_original_paths(&self) -> Result<(), AgentdError> {\n        for directory in &self.directories { directory.require_original_pin()?; }\n        self.lock.require_original_pin()\n    }\n\n    pub(super) fn open_original_selection(\n        &self,\n        data: &OriginalSelectionData,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<(OriginalCellQ24SelectionInputsV1, Digest32), AgentdError> {\n        self.require_original_paths()?;\n        let validation = data.open_original(files, &self.verifier)?;\n        let owner = self.owner.lock()\n            .map_err(|_| deployment_refused(\"original Artifact owner mutex is poisoned\"))?;\n        files.require_original_context()?;\n        let selected = AgentdSelectedGenerationV1::load(\n            &owner, validation.verifier, validation.signed, validation.files, now,\n        )?;\n        let expected = selected.observation().digest();\n        drop(owner);\n        // These immutable reads reuse only an unchanged actual inode/hash.\n        // The controller consumes its own opened files and authenticates again.\n        let selection = data.open_original(files, &self.verifier)?;\n        self.require_original_paths()?;\n        files.require_original_context()?;\n        Ok((selection, expected))\n    }\n\n    pub(super) fn original_artifact_command(\n        &self,\n        data: &OriginalArtifactDecisionData,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<OriginalSameActorArtifactInputsV1, AgentdError> {\n        self.require_original_paths()?;\n        files.require_original_context()?;\n        match data {\n            OriginalArtifactDecisionData::RetainOriginal => {\n                // The actual owner must still authenticate its exact\n                // NoUpdate/Retain/Defer decision. This data cannot select one.\n                Ok(OriginalSameActorArtifactInputsV1::RetainOriginal)\n            }\n            OriginalArtifactDecisionData::PublishQualified(data) => {\n                let payload = files.read_original(&data.payload, 16 * 1024 * 1024)?;\n                let manifest = data.manifest.original()?;\n                let owner = self.owner.lock().map_err(|_| deployment_refused(\"original Artifact owner mutex is poisoned\"))?;\n                files.require_original_context()?;\n                self.require_original_paths()?;\n                let admission = admit_manifest_at_withdrawal_head_v3(\n                    owner.withdrawal_registry(),\n                    Digest32::from_array(data.expected_withdrawal_head),\n                    manifest, now,\n                ).map_err(deployment_error)?;\n                let request = LearningArtifactPublishRequestV1 {\n                    operation_id: StableId::new(&data.operation_id).map_err(deployment_error)?,\n                    admission, payload: payload.bytes().to_vec(),\n                    signed_current_head: data.signed_current_head.original_current()\n                        .map_err(deployment_error)?,\n                    expected_registry_predecessor_head: Digest32::from_array(data.expected_registry_predecessor_head),\n                    now,\n                };\n                payload.require_original_pin()?;\n                files.require_original_context()?;\n                drop(owner);\n                // Actual publication subsequently reacquires its original\n                // writer and checks this exact withdrawal/current frontier.\n                Ok(OriginalSameActorArtifactInputsV1::PublishQualified(Box::new(request)))\n            }\n        }\n    }\n}\n\nimpl OriginalSelectionData {\n    pub(super) fn original_signed(&self) -> Result<SignedArtifactSelectionV1, AgentdError> {\n        self.signed.original_selection().map_err(deployment_error)\n    }\n\n    fn open_original(\n        &self,\n        files: &mut OriginalDeploymentFiles,\n        verifier: &ArtifactSelectionVerifierV1,\n    ) -> Result<OriginalCellQ24SelectionInputsV1, AgentdError> {\n        let registry = files.read_original(&self.registry_snapshot, 16 * 1024 * 1024)?;\n        let payload = files.read_original(&self.payload, 16 * 1024 * 1024)?;\n        let result = OriginalCellQ24SelectionInputsV1 {\n            verifier: verifier.clone(), signed: self.original_signed()?,\n            files: AgentdGenerationSelectionFilesV1 {\n                registry_snapshot: registry.clone_original_file()?,\n                payload: payload.clone_original_file()?,\n            },\n        };\n        registry.require_original_pin()?;\n        payload.require_original_pin()?;\n        files.require_original_context()?;\n        Ok(result)\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(tag = \"kind\", rename_all = \"snake_case\", deny_unknown_fields)]\npub(super) enum OriginalArtifactDecisionData {\n    RetainOriginal,\n    PublishQualified(Box<OriginalArtifactPublicationData>),\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalArtifactPublicationData {\n    pub operation_id: String,\n    pub manifest: OriginalArtifactManifestData,\n    pub payload: PinnedFileData,\n    pub signed_current_head: OriginalDeploymentCurrentData,\n    pub expected_withdrawal_head: [u8; 32],\n    pub expected_registry_predecessor_head: [u8; 32],\n}\n"
        }
      ]
    },
    {
      "key": "exchange_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_exchange.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_exchange.rs",
        "blob": "801620ea5ba7fee5ca88bff214acfce10296a393",
        "bytes": 6852,
        "sha256": "b2acd367a31c02ae09e4b418af0c5100301de42ac170050055b165b235bb39d5",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! One-shot data exchange with an independently operated original actor.\n//! A missing response may wait inside the SAME operation. No authority call,\n//! nonce, signing request or failed result is resubmitted by this adapter.\n\nuse std::io::Write;\nuse std::path::PathBuf;\nuse std::sync::Arc;\nuse std::time::Duration;\n\nuse codex_hepta_types::Digest32;\nuse serde::{Deserialize, Serialize};\n\nuse crate::{AgentdError, CellQ24PreparedLearningV1};\nuse crate::root_production_inputs::same_actor_phase::OriginalSameActorRootContext;\n\nuse super::files::{MutableFileData, OriginalDeploymentFiles, OriginalFileMode, OriginalPinnedRead};\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalActorExchangeData {\n    pub request: MutableFileData,\n    pub response: PathBuf,\n}\n\n/// Captures the actual request's ORIGINAL absolute business expiry. This is\n/// independent of the two original phase bounds; no Duration starts a new end.\npub(super) struct OriginalActorWait {\n    context: Arc<OriginalSameActorRootContext>,\n    business_expiry_unix_seconds: u64,\n    last_unix_seconds: u64,\n}\n\nimpl OriginalActorWait {\n    pub(super) fn for_original_prepared(\n        context: Arc<OriginalSameActorRootContext>,\n        prepared: &CellQ24PreparedLearningV1,\n    ) -> Result<Self, AgentdError> {\n        OriginalSameActorRootContext::require_current(&context)?;\n        prepared.revalidate_source().map_err(deployment_error)?;\n        let business_expiry_unix_seconds =\n            prepared.initial().request.envelope.expiry_unix_seconds;\n        let last_unix_seconds = context.clock().now_unix_ms()\n            .map_err(deployment_error)? / 1_000;\n        if business_expiry_unix_seconds <= last_unix_seconds {\n            return Err(deployment_refused(\"original signing business deadline has elapsed\"));\n        }\n        let mut wait = Self { context, business_expiry_unix_seconds, last_unix_seconds };\n        wait.require_original_live()?;\n        Ok(wait)\n    }\n\n    /// Ordinary Outcome/Selection handoff also uses the already approved\n    /// absolute task expiry, never a deadline based on this later wait.\n    pub(super) fn for_original_task(\n        context: Arc<OriginalSameActorRootContext>,\n        original_expiry_unix_seconds: u64,\n    ) -> Result<Self, AgentdError> {\n        OriginalSameActorRootContext::require_current(&context)?;\n        let last_unix_seconds = context.clock().now_unix_ms()\n            .map_err(deployment_error)? / 1_000;\n        let mut wait = Self {\n            context, business_expiry_unix_seconds: original_expiry_unix_seconds,\n            last_unix_seconds,\n        };\n        wait.require_original_live()?;\n        Ok(wait)\n    }\n\n    pub(super) fn require_original_live(&mut self) -> Result<u64, AgentdError> {\n        OriginalSameActorRootContext::require_current(&self.context)?;\n        let now = self.context.clock().now_unix_ms().map_err(deployment_error)? / 1_000;\n        if now < self.last_unix_seconds || now >= self.business_expiry_unix_seconds {\n            return Err(deployment_refused(\"original actor deadline expired or clock regressed\"));\n        }\n        self.last_unix_seconds = now;\n        OriginalSameActorRootContext::require_current(&self.context)?;\n        Ok(now)\n    }\n\n    pub(super) fn wait_original_file(\n        &mut self,\n        files: &mut OriginalDeploymentFiles,\n        path: &std::path::Path,\n        maximum: usize,\n    ) -> Result<OriginalPinnedRead, AgentdError> {\n        loop {\n            self.require_original_live()?;\n            match std::fs::symlink_metadata(path) {\n                Ok(_) => {\n                    // The first visible response is read exactly once. An\n                    // empty, partial, changed, unauthorized or invalid file is\n                    // an error, never a reason to wait for a replacement.\n                    let read = files.read_original_stage(path, maximum)?;\n                    self.require_original_live()?;\n                    return Ok(read);\n                }\n                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}\n                Err(error) => return Err(error.into()),\n            }\n            // This concrete coordinator has a retained std::thread owner.\n            // Waiting does not hold a Root request, owner mutex or Tokio worker.\n            // A late wake still checks the same absolute bounds before reading.\n            std::thread::park_timeout(Duration::from_millis(5));\n        }\n    }\n}\n\n/// Deliberately not Clone. Taking this object consumes its one request path\n/// even if write, sync, waiting or parsing fails. The durable owner which made\n/// the original request retains Pending/uncertain state on that failure.\npub(super) struct OriginalActorExchange {\n    data: OriginalActorExchangeData,\n}\n\nimpl OriginalActorExchange {\n    pub(super) fn new(data: OriginalActorExchangeData) -> Result<Self, AgentdError> {\n        if !matches!(data.request.mode, OriginalFileMode::CreateNew)\n            || data.request.path == data.response\n        {\n            return Err(deployment_refused(\"original actor exchange requires a fresh request path\"));\n        }\n        Ok(Self { data })\n    }\n\n    pub(super) fn exchange_original<T: Serialize>(\n        self,\n        request: &T,\n        files: &mut OriginalDeploymentFiles,\n        wait: &mut OriginalActorWait,\n    ) -> Result<(Digest32, OriginalPinnedRead), AgentdError> {\n        wait.require_original_live()?;\n        let bytes = serde_json::to_vec(request).map_err(deployment_error)?;\n        if bytes.is_empty() || bytes.len() > 1024 * 1024 {\n            return Err(deployment_refused(\"original signing request exceeds its data bound\"));\n        }\n        // A response already at this unique original path is not a reply to\n        // the request we have yet to publish. Never adopt a precomputed reply.\n        match std::fs::symlink_metadata(&self.data.response) {\n            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}\n            Ok(_) => return Err(deployment_refused(\"original response path already exists\")),\n            Err(error) => return Err(error.into()),\n        }\n        let (mut file, directory) =\n            files.open_original_owner_with_directory(&self.data.request)?;\n        wait.require_original_live()?;\n        file.write_all(&bytes)?;\n        file.sync_all()?;\n        directory.sync_all()?;\n        wait.require_original_live()?;\n        // The external original actor must publish a complete response once,\n        // e.g. by an atomic rename after syncing its own private temporary file.\n        let response = wait.wait_original_file(files, &self.data.response, 1024 * 1024)?;\n        wait.require_original_live()?;\n        Ok((Digest32::of_bytes(&bytes), response))\n    }\n}\n"
        }
      ]
    },
    {
      "key": "temporal_data_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_temporal_data.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_temporal_data.rs",
        "blob": "1a5f75d2e392b0c5f16a7f52adb16388430c8b16",
        "bytes": 3321,
        "sha256": "4e8b1834245f4c9c009eba1d6b8bfd7491f6fb22eba60da32f3773191a155c5b",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Raw temporal declarations from the immutable evaluation deployment.\n//! Original canonical-digest, support and evidence validation remains in the\n//! original runner; none of these data structures is a sealed evaluation.\n\nuse codex_hepta_intelligence_eval::{ClusterConfidencePlan, OpePlan, TemporalEvaluationPlan,\n    TemporalFoldPlan};\nuse codex_hepta_types::{Digest32, FixedQ32, StableId};\nuse serde::{Deserialize, Serialize};\nuse crate::AgentdError;\nuse super::deployment_error;\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalTemporalFoldData {\n    pub plan_digest: [u8; 32],\n    pub fold_id: String,\n    pub training_watermark: u64,\n    pub evaluation_start: u64,\n    pub minimum_per_action: usize,\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalOpeData {\n    pub plan_digest: [u8; 32],\n    pub outcome_watermark: u64,\n    pub minimum_rows: usize,\n    pub minimum_ess_q32: i64,\n    pub maximum_weight_q32: i64,\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalConfidenceData {\n    pub plan_digest: [u8; 32],\n    pub assumptions_digest: [u8; 32],\n    pub family_alpha_ppm: u32,\n    pub simultaneous_comparisons: u32,\n    pub minimum_clusters: usize,\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalTemporalPlanData {\n    pub plan_digest: [u8; 32],\n    pub evaluation_id: String,\n    pub objective_digest: [u8; 32],\n    pub fold: OriginalTemporalFoldData,\n    pub ope: OriginalOpeData,\n    pub confidence: OriginalConfidenceData,\n}\nimpl OriginalTemporalPlanData {\n    pub(super) fn original(&self) -> Result<TemporalEvaluationPlan, AgentdError> {\n        Ok(TemporalEvaluationPlan {\n            plan_digest: Digest32::from_array(self.plan_digest),\n            evaluation_id: StableId::new(&self.evaluation_id).map_err(deployment_error)?,\n            objective_digest: Digest32::from_array(self.objective_digest),\n            fold: TemporalFoldPlan {\n                plan_digest: Digest32::from_array(self.fold.plan_digest),\n                fold_id: StableId::new(&self.fold.fold_id).map_err(deployment_error)?,\n                training_watermark: self.fold.training_watermark,\n                evaluation_start: self.fold.evaluation_start,\n                minimum_per_action: self.fold.minimum_per_action,\n            },\n            ope: OpePlan {\n                plan_digest: Digest32::from_array(self.ope.plan_digest),\n                outcome_watermark: self.ope.outcome_watermark,\n                minimum_rows: self.ope.minimum_rows,\n                minimum_ess: FixedQ32::from_raw(self.ope.minimum_ess_q32),\n                maximum_weight: FixedQ32::from_raw(self.ope.maximum_weight_q32),\n            },\n            confidence: ClusterConfidencePlan {\n                plan_digest: Digest32::from_array(self.confidence.plan_digest),\n                assumptions_digest: Digest32::from_array(self.confidence.assumptions_digest),\n                family_alpha_ppm: self.confidence.family_alpha_ppm,\n                simultaneous_comparisons: self.confidence.simultaneous_comparisons,\n                minimum_clusters: self.confidence.minimum_clusters,\n            },\n        })\n    }\n}\n"
        }
      ]
    },
    {
      "key": "comparison_data_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_comparison_data.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_comparison_data.rs",
        "blob": "5d18debf33eb8c1d54a03f0bc27814cb9c13b01b",
        "bytes": 4868,
        "sha256": "8e75909b489dbcf5508b18bc752b8bdeb28aa53b5cee03e638356f4231794ac4",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Supplied comparison declarations and actual cost-coverage requirements.\n//! No count, matched budget, role or measured cost is filled in by this loader.\n\nuse codex_hepta_types::StableId;\nuse serde::{Deserialize, Serialize};\nuse crate::{AgentdError, CellComparisonContractV1, CellCostCoverageV1,\n    CellParameterCapacityV1, CellRequiredCostMetricV1, CellSelectiveUpdateV1,\n    CellTrainingBudgetV1, CellTrainingObservationV1};\nuse super::deployment_error;\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalCapacityData {\n    pub total_parameters: u64,\n    pub trainable_parameters: u64,\n    pub maximum_active_parameters: u64,\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalTrainingBudgetData {\n    pub examples_seen: u64,\n    pub optimizer_steps: u64,\n    pub parameter_updates: u64,\n    pub compute_units: u64,\n    pub compute_unit_contract: [u8; 32],\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalSelectiveUpdateData {\n    pub policy_digest: [u8; 32],\n    pub eligibility_digest: [u8; 32],\n    pub schedule_digest: [u8; 32],\n    pub maximum_parameters_per_step: u64,\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalTrainingObservationData {\n    pub participant_id: String,\n    pub capacity: OriginalCapacityData,\n    pub cumulative: OriginalTrainingBudgetData,\n    pub selective_update: OriginalSelectiveUpdateData,\n    pub structure_before: [u8; 32],\n    pub structure_after: [u8; 32],\n    pub training_receipt_digest: [u8; 32],\n}\nimpl OriginalTrainingObservationData {\n    fn original(&self) -> Result<CellTrainingObservationV1, AgentdError> {\n        Ok(CellTrainingObservationV1 {\n            participant_id: StableId::new(&self.participant_id).map_err(deployment_error)?,\n            capacity: CellParameterCapacityV1 {\n                total_parameters: self.capacity.total_parameters,\n                trainable_parameters: self.capacity.trainable_parameters,\n                maximum_active_parameters: self.capacity.maximum_active_parameters,\n            },\n            cumulative: CellTrainingBudgetV1 {\n                examples_seen: self.cumulative.examples_seen,\n                optimizer_steps: self.cumulative.optimizer_steps,\n                parameter_updates: self.cumulative.parameter_updates,\n                compute_units: self.cumulative.compute_units,\n                compute_unit_contract: self.cumulative.compute_unit_contract,\n            },\n            selective_update: CellSelectiveUpdateV1 {\n                policy_digest: self.selective_update.policy_digest,\n                eligibility_digest: self.selective_update.eligibility_digest,\n                schedule_digest: self.selective_update.schedule_digest,\n                maximum_parameters_per_step: self.selective_update.maximum_parameters_per_step,\n            },\n            structure_before: self.structure_before, structure_after: self.structure_after,\n            training_receipt_digest: self.training_receipt_digest,\n        })\n    }\n}\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub(super) enum OriginalCostMetricData {\n    Wall, Cpu, Energy, StorageRead, StorageWrite, StorageRetention, Communication,\n}\nimpl OriginalCostMetricData {\n    fn original(self) -> CellRequiredCostMetricV1 {\n        match self {\n            Self::Wall => CellRequiredCostMetricV1::Wall,\n            Self::Cpu => CellRequiredCostMetricV1::Cpu,\n            Self::Energy => CellRequiredCostMetricV1::Energy,\n            Self::StorageRead => CellRequiredCostMetricV1::StorageRead,\n            Self::StorageWrite => CellRequiredCostMetricV1::StorageWrite,\n            Self::StorageRetention => CellRequiredCostMetricV1::StorageRetention,\n            Self::Communication => CellRequiredCostMetricV1::Communication,\n        }\n    }\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalComparisonData {\n    pub candidate: OriginalTrainingObservationData,\n    pub fixed_expert: OriginalTrainingObservationData,\n    pub metering_contract_digest: [u8; 32],\n    pub required_metrics: Vec<OriginalCostMetricData>,\n}\nimpl OriginalComparisonData {\n    pub(super) fn original(&self) -> Result<CellComparisonContractV1, AgentdError> {\n        Ok(CellComparisonContractV1 {\n            candidate: self.candidate.original()?,\n            fixed_expert: self.fixed_expert.original()?,\n            cost_coverage: CellCostCoverageV1 {\n                metering_contract_digest: self.metering_contract_digest,\n                required_metrics: self.required_metrics.iter().copied()\n                    .map(OriginalCostMetricData::original).collect(),\n            },\n        })\n    }\n}\n"
        }
      ]
    },
    {
      "key": "eval_data_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation_data.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation_data.rs",
        "blob": "17c5193608486a738bffd3100f3b3747060bc48a",
        "bytes": 8453,
        "sha256": "adce08ae88ee0406de23a7f1910300c30f29e6197bfbcdb6607caf7bd5b5706a",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Original preregistration declarations. Freezing remains an original Cell\n//! and Product operation over actual drained journals and supplied temporal\n//! inputs. No private plan or qualification receipt is deserialized here.\n\nuse codex_hepta_intelligence_eval::{\n    CrossFoldPartitionV1, CrossFoldPlanV1, EvaluationClaimScopeV1, EvaluationDirectionV1,\n    MetricContractV1, MetricRoleContractV2, MetricRoleV2, ProductMetricSourceContractV1,\n    ProductMetricSourceV1, ProductQualificationContextV1,\n};\nuse codex_hepta_types::{Digest32, FixedQ32, StableId};\nuse serde::{Deserialize, Serialize};\nuse crate::{AgentdError, CellEvaluationRegistrationV1};\nuse super::{deployment_error, deployment_refused};\nuse super::comparison_data::OriginalComparisonData;\nuse super::learning_data::{PrincipalData, required_option};\n\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub(super) enum OriginalClaimScopeData { Qualification, SystemLongitudinal }\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub(super) enum OriginalDirectionData { Maximize, Minimize }\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(tag = \"kind\", rename_all = \"snake_case\", deny_unknown_fields)]\npub(super) enum OriginalMetricRoleData {\n    PrimarySuperiority { minimum_improvement_q32: i64 },\n    NonInferiority { maximum_regression_q32: i64 },\n    AbsoluteConstraint,\n}\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub(super) enum OriginalMetricSourceData { Ips, Snips, DoublyRobust }\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalMetricData {\n    pub metric_id: String,\n    pub direction: OriginalDirectionData,\n    #[serde(deserialize_with = \"required_option\")]\n    pub safety_floor_q32: Option<i64>,\n    pub role: OriginalMetricRoleData,\n    pub source: OriginalMetricSourceData,\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalFoldData {\n    pub fold_id: String,\n    pub training_principals: Vec<String>,\n    pub training_episodes: Vec<String>,\n    pub training_windows: Vec<String>,\n    pub holdout_principals: Vec<String>,\n    pub holdout_episodes: Vec<String>,\n    pub holdout_windows: Vec<String>,\n    pub model_digest: [u8; 32],\n    pub predictions_digest: [u8; 32],\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalEvaluationRegistrationData {\n    pub plan_id: String,\n    pub claim_scope: OriginalClaimScopeData,\n    pub candidate_id: String,\n    pub baseline_id: String,\n    pub objective_digest: [u8; 32],\n    pub dataset_digest: [u8; 32],\n    pub estimand_digest: [u8; 32],\n    pub metrics: Vec<OriginalMetricData>,\n    pub family_alpha_ppm: u32,\n    pub simultaneous_comparisons: u32,\n    pub folds: Vec<OriginalFoldData>,\n    pub final_holdout_window_id: String,\n    pub final_holdout_digest: [u8; 32],\n    pub comparison: OriginalComparisonData,\n}\nimpl OriginalEvaluationRegistrationData {\n    pub(super) fn original(&self) -> Result<CellEvaluationRegistrationV1, AgentdError> {\n        // This loader has no original longitudinal timing owner. Refuse that\n        // mode explicitly instead of manufacturing elapsed-window evidence.\n        if !matches!(self.claim_scope, OriginalClaimScopeData::Qualification) {\n            return Err(deployment_refused(\"original longitudinal timing owner is not supplied\"));\n        }\n        let mut contracts = Vec::with_capacity(self.metrics.len());\n        let mut roles = Vec::with_capacity(self.metrics.len());\n        let mut sources = Vec::with_capacity(self.metrics.len());\n        for metric in &self.metrics {\n            let id = StableId::new(&metric.metric_id).map_err(deployment_error)?;\n            contracts.push(MetricContractV1 {\n                metric_id: id.clone(),\n                direction: match metric.direction {\n                    OriginalDirectionData::Maximize => EvaluationDirectionV1::Maximize,\n                    OriginalDirectionData::Minimize => EvaluationDirectionV1::Minimize,\n                },\n                safety_floor: metric.safety_floor_q32.map(FixedQ32::from_raw),\n            });\n            roles.push(MetricRoleContractV2 {\n                metric_id: id.clone(),\n                role: match metric.role {\n                    OriginalMetricRoleData::PrimarySuperiority { minimum_improvement_q32 } =>\n                        MetricRoleV2::PrimarySuperiority {\n                            minimum_improvement: FixedQ32::from_raw(minimum_improvement_q32),\n                        },\n                    OriginalMetricRoleData::NonInferiority { maximum_regression_q32 } =>\n                        MetricRoleV2::NonInferiority {\n                            maximum_regression: FixedQ32::from_raw(maximum_regression_q32),\n                        },\n                    OriginalMetricRoleData::AbsoluteConstraint => MetricRoleV2::AbsoluteConstraint,\n                },\n            });\n            sources.push(ProductMetricSourceContractV1 {\n                metric_id: id,\n                source: match metric.source {\n                    OriginalMetricSourceData::Ips => ProductMetricSourceV1::Ips,\n                    OriginalMetricSourceData::Snips => ProductMetricSourceV1::Snips,\n                    OriginalMetricSourceData::DoublyRobust => ProductMetricSourceV1::DoublyRobust,\n                },\n            });\n        }\n        let folds = self.folds.iter().map(|fold| Ok(CrossFoldPartitionV1 {\n            fold_id: StableId::new(&fold.fold_id).map_err(deployment_error)?,\n            training_principals: original_ids(&fold.training_principals)?,\n            training_episodes: original_ids(&fold.training_episodes)?,\n            training_windows: original_ids(&fold.training_windows)?,\n            holdout_principals: original_ids(&fold.holdout_principals)?,\n            holdout_episodes: original_ids(&fold.holdout_episodes)?,\n            holdout_windows: original_ids(&fold.holdout_windows)?,\n            model_digest: Digest32::from_array(fold.model_digest),\n            predictions_digest: Digest32::from_array(fold.predictions_digest),\n        })).collect::<Result<Vec<_>, AgentdError>>()?;\n        Ok(CellEvaluationRegistrationV1 {\n            product: CrossFoldPlanV1 {\n                plan_id: StableId::new(&self.plan_id).map_err(deployment_error)?,\n                claim_scope: EvaluationClaimScopeV1::Qualification,\n                candidate_id: StableId::new(&self.candidate_id).map_err(deployment_error)?,\n                baseline_id: StableId::new(&self.baseline_id).map_err(deployment_error)?,\n                objective_digest: Digest32::from_array(self.objective_digest),\n                dataset_digest: Digest32::from_array(self.dataset_digest),\n                estimand_digest: Digest32::from_array(self.estimand_digest),\n                metric_contracts: contracts, family_alpha_ppm: self.family_alpha_ppm,\n                simultaneous_comparisons: self.simultaneous_comparisons, folds,\n                final_holdout_window_id: StableId::new(&self.final_holdout_window_id)\n                    .map_err(deployment_error)?,\n                final_holdout_digest: Digest32::from_array(self.final_holdout_digest),\n            },\n            metric_roles: roles, metric_sources: sources,\n            comparison: self.comparison.original()?,\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalQualificationContextData {\n    pub generator: PrincipalData,\n    pub evaluator: PrincipalData,\n    pub retention_receipt_digests: Vec<[u8; 32]>,\n    pub unlearning_receipt_digest: [u8; 32],\n}\nimpl OriginalQualificationContextData {\n    pub(super) fn original(&self) -> Result<ProductQualificationContextV1, AgentdError> {\n        Ok(ProductQualificationContextV1 {\n            generator: self.generator.original()?,\n            evaluator: self.evaluator.original()?,\n            retention_receipt_digests: self.retention_receipt_digests.iter()\n                .copied().map(Digest32::from_array).collect(),\n            unlearning_receipt_digest: Digest32::from_array(self.unlearning_receipt_digest),\n        })\n    }\n}\nfn original_ids(data: &[String]) -> Result<Vec<StableId>, AgentdError> {\n    data.iter().map(|value| StableId::new(value).map_err(deployment_error)).collect()\n}\n"
        }
      ]
    },
    {
      "key": "eval_signing_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation_signing.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation_signing.rs",
        "blob": "595ac3b2a66468e222794e7f539873bbb88a6462",
        "bytes": 8102,
        "sha256": "74e80f2223b5708f9290f35ead95393978c0e1d82c796238d0370fd971be0608",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Concrete transport for the original evaluator's one signing operation.\n//! The independent actor receives only the exact original request data. The\n//! original Product runner authenticates its response before completing its\n//! already durable execution claim; this adapter never signs an execution.\n\nuse std::sync::Arc;\n\nuse codex_hepta_intelligence_eval::{\n    ProductEvaluationExecutionAttestationRequestV1, ProductEvaluationExecutionAttestorV1,\n    ProductEvaluationExecutionKeyV1, ProductProviderErrorV1, SignedEvaluationEvidenceV1,\n};\nuse codex_hepta_learning_ledger::SignedLearningEvidenceV1;\nuse codex_hepta_types::Digest32;\nuse serde::{Deserialize, Serialize};\n\nuse crate::{AgentdError, CellEvaluationPlanV1, CellQ24PreparedLearningV1};\nuse crate::root_production_inputs::same_actor_phase::OriginalSameActorRootContext;\n\nuse super::exchange::{OriginalActorExchange, OriginalActorExchangeData, OriginalActorWait};\nuse super::files::OriginalDeploymentFiles;\nuse super::learning_data::SignedEvidenceData;\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Serialize)]\n#[serde(deny_unknown_fields)]\nstruct OriginalExecutionSigningData<'a> {\n    schema_version: u32,\n    purpose: &'static str,\n    phase: &'a str,\n    learning_operation: &'a str,\n    plan_id: &'a str,\n    execution_binding: [u8; 32],\n    execution_digest: [u8; 32],\n    payload: &'a [u8],\n}\n#[derive(Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\nstruct OriginalExecutionResponseData {\n    schema_version: u32,\n    request_digest: [u8; 32],\n    execution_digest: [u8; 32],\n    signed: SignedEvidenceData,\n}\n\npub(super) struct OriginalExecutionAttestor<'a> {\n    context: Arc<OriginalSameActorRootContext>,\n    prepared: &'a CellQ24PreparedLearningV1,\n    expected: ProductEvaluationExecutionKeyV1,\n    exchange: Option<OriginalActorExchange>,\n    files: &'a mut OriginalDeploymentFiles,\n    wait: &'a mut OriginalActorWait,\n    failure: Option<AgentdError>,\n}\n\nimpl<'a> OriginalExecutionAttestor<'a> {\n    pub(super) fn new(\n        context: Arc<OriginalSameActorRootContext>,\n        prepared: &'a CellQ24PreparedLearningV1,\n        expected: ProductEvaluationExecutionKeyV1,\n        exchange: OriginalActorExchangeData,\n        files: &'a mut OriginalDeploymentFiles,\n        wait: &'a mut OriginalActorWait,\n    ) -> Result<Self, AgentdError> {\n        OriginalSameActorRootContext::require_current(&context)?;\n        prepared.revalidate_source().map_err(deployment_error)?;\n        Ok(Self {\n            context, prepared, expected,\n            exchange: Some(OriginalActorExchange::new(exchange)?),\n            files, wait, failure: None,\n        })\n    }\n\n    pub(super) fn take_original_failure(&mut self) -> Option<AgentdError> {\n        self.failure.take()\n    }\n\n    fn exchange_original_request(\n        &mut self,\n        request: &ProductEvaluationExecutionAttestationRequestV1<'_>,\n    ) -> Result<SignedLearningEvidenceV1, AgentdError> {\n        self.wait.require_original_live()?;\n        if request.key() != &self.expected {\n            return Err(deployment_refused(\"actual evaluator request differs from its original key\"));\n        }\n        let exchange = self.exchange.take()\n            .ok_or_else(|| deployment_refused(\"original evaluator operation already consumed\"))?;\n        let raw = OriginalExecutionSigningData {\n            schema_version: 1,\n            purpose: \"hepta.same-actor-q24-deployment.execution-signing.v1\",\n            phase: &self.context.descriptor().phase,\n            learning_operation: self.prepared.initial().request.operation_id.as_str(),\n            plan_id: request.key().plan_id.as_str(),\n            execution_binding: request.key().binding_digest.into_array(),\n            execution_digest: request.execution().execution_digest.into_array(),\n            payload: request.signing_payload(),\n        };\n        let (digest, response) = exchange.exchange_original(&raw, self.files, self.wait)?;\n        let signed: OriginalExecutionResponseData = response.parse_original()?;\n        if signed.schema_version != 1\n            || signed.request_digest != digest.into_array()\n            || signed.execution_digest != raw.execution_digest\n        {\n            return Err(deployment_refused(\"original evaluator response binding differs\"));\n        }\n        let evidence = signed.signed.original()?;\n        response.require_original_pin()?;\n        self.wait.require_original_live()?;\n        // Signature, role, full principal and objective authentication remains\n        // in Product::authenticate immediately after this exact trait return.\n        Ok(evidence)\n    }\n}\n\nimpl ProductEvaluationExecutionAttestorV1 for OriginalExecutionAttestor<'_> {\n    fn attest_execution(\n        &mut self,\n        request: &ProductEvaluationExecutionAttestationRequestV1<'_>,\n    ) -> Result<SignedLearningEvidenceV1, ProductProviderErrorV1> {\n        match self.exchange_original_request(request) {\n            Ok(signed) => Ok(signed),\n            Err(error) => {\n                self.failure = Some(error);\n                // Actual execution was already claimed and performed. A\n                // missing/failed external reply is never \"not executed\".\n                Err(ProductProviderErrorV1::Indeterminate)\n            }\n        }\n    }\n}\n\n#[derive(Serialize)]\n#[serde(deny_unknown_fields)]\nstruct OriginalQualificationSigningData<'a> {\n    schema_version: u32,\n    purpose: &'static str,\n    phase: &'a str,\n    learning_operation: &'a str,\n    execution_digest: [u8; 32],\n    frozen_plan_digest: [u8; 32],\n    generator_payload: &'a [u8],\n    evaluator_payload: &'a [u8],\n    actual_cell_record: serde_json::Value,\n}\n#[derive(Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\nstruct OriginalQualificationResponseData {\n    schema_version: u32,\n    request_digest: [u8; 32],\n    execution_digest: [u8; 32],\n    generator_plan: SignedEvidenceData,\n    evaluator_bundle: SignedEvidenceData,\n}\n\n/// Called only after actual Cell evaluation returns a sealed receipt and the\n/// SAME runner builds its qualification bundle and canonical signing payload.\npub(super) struct OriginalQualificationSigningRequest<'a> {\n    pub context: &'a OriginalSameActorRootContext,\n    pub prepared: &'a CellQ24PreparedLearningV1,\n    pub plan: &'a CellEvaluationPlanV1,\n    pub execution_digest: Digest32,\n    pub evaluator_payload: &'a [u8],\n}\n\npub(super) fn request_original_qualification(\n    original: OriginalQualificationSigningRequest<'_>,\n    exchange: OriginalActorExchangeData,\n    files: &mut OriginalDeploymentFiles,\n    wait: &mut OriginalActorWait,\n) -> Result<SignedEvaluationEvidenceV1, AgentdError> {\n    wait.require_original_live()?;\n    let generator = original.plan.product_plan().frozen_plan.plan_digest;\n    let request = OriginalQualificationSigningData {\n        schema_version: 1,\n        purpose: \"hepta.same-actor-q24-deployment.qualification-signing.v1\",\n        phase: &original.context.descriptor().phase,\n        learning_operation: original.prepared.initial().request.operation_id.as_str(),\n        execution_digest: original.execution_digest.into_array(),\n        frozen_plan_digest: generator.into_array(),\n        generator_payload: generator.as_array(),\n        evaluator_payload: original.evaluator_payload,\n        actual_cell_record: serde_json::to_value(original.plan.record()).map_err(deployment_error)?,\n    };\n    let (digest, response) = OriginalActorExchange::new(exchange)?\n        .exchange_original(&request, files, wait)?;\n    let signed: OriginalQualificationResponseData = response.parse_original()?;\n    if signed.schema_version != 1 || signed.request_digest != digest.into_array()\n        || signed.execution_digest != request.execution_digest\n    {\n        return Err(deployment_refused(\"actual qualification response binding differs\"));\n    }\n    let evidence = SignedEvaluationEvidenceV1 {\n        generator_plan: signed.generator_plan.original()?,\n        evaluator_bundle: signed.evaluator_bundle.original()?,\n    };\n    response.require_original_pin()?;\n    wait.require_original_live()?;\n    Ok(evidence)\n}\n"
        }
      ]
    },
    {
      "key": "eval_storage_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation_storage.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation_storage.rs",
        "blob": "5ddacddb99924751d37ef72fc244150bccac3dc5",
        "bytes": 8157,
        "sha256": "ba344bdf7f66e02435542faeea3fa4a55f6aa29bb3f07ded03b2351e2c144ac9",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Concrete independent B storage. Existing owner journals never fall back to\n//! genesis, and every recovered durable store requires its external minimum.\n//! File identities remain distinct across source, witness, execution and sink.\n\nuse codex_hepta_intelligence_eval::{\n    FinalHoldoutCasAnchorV1, FencedFinalHoldoutOwnerV1, HoldoutWriterFenceV1,\n    LockedFileFinalHoldoutCasStoreV1, LockedFileProductEvaluationExecutionStoreV1,\n    LockedFileProductQualificationEvidenceSinkV1, ProductEvaluationExecutionAnchorV1,\n};\nuse codex_hepta_neuron::{CellGenerationJournalV2, FileAnchorWitnessStore};\nuse codex_hepta_types::{Digest32, StableId};\nuse serde::{Deserialize, Serialize};\nuse crate::AgentdError;\nuse crate::authority_host_runtime::OriginalDeploymentObserverData;\nuse super::files::{MutableFileData, OriginalDeploymentFiles, OriginalFileMode};\nuse super::learning_data::required_option;\nuse super::witness::OriginalWitnessData;\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalEvaluationJournalData {\n    pub journal: MutableFileData,\n    pub witness: OriginalWitnessData,\n    pub observer: OriginalDeploymentObserverData,\n}\nimpl OriginalEvaluationJournalData {\n    pub(super) fn open_original(\n        &self, files: &mut OriginalDeploymentFiles,\n    ) -> Result<CellGenerationJournalV2<FileAnchorWitnessStore>, AgentdError> {\n        if !matches!(self.journal.mode, OriginalFileMode::Recover)\n            || !matches!(self.witness.file.mode, OriginalFileMode::Recover)\n        {\n            return Err(deployment_refused(\"B requires actual existing experiment journals\"));\n        }\n        let observer = self.observer.original_observer_config().map_err(deployment_error)?;\n        if observer.witness_scope.scope_digest.into_array() != self.witness.scope\n            || observer.witness_scope.objective_digest.into_array() != self.witness.objective\n            || observer.witness_generation.get() != self.witness.generation\n            || observer.witness_records != self.witness.maximum_records\n        {\n            return Err(deployment_refused(\"B witness differs from its actual observer configuration\"));\n        }\n        let journal = files.open_original_owner(&self.journal)?;\n        let witness = self.witness.open_original(files)?;\n        files.require_original_context()?;\n        // Ordinary open rejects guarded CURRENT journals. No replacement\n        // current callback or precomputed proof is installed by this loader.\n        let original = CellGenerationJournalV2::open(\n            journal, witness, observer.generation, observer.journal_records,\n        ).map_err(deployment_error)?;\n        files.require_original_context()?;\n        Ok(original)\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalHoldoutMinimumData {\n    pub fence_generation: u64,\n    pub record_count: u64,\n    pub state_digest: [u8; 32],\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalHoldoutData {\n    pub file: MutableFileData,\n    pub binding: [u8; 32],\n    pub owner_id: String,\n    pub generation: u64,\n    pub lease_digest: [u8; 32],\n    #[serde(deserialize_with = \"required_option\")]\n    pub minimum: Option<OriginalHoldoutMinimumData>,\n}\nimpl OriginalHoldoutData {\n    pub(super) fn open_original(\n        &self, files: &mut OriginalDeploymentFiles,\n    ) -> Result<FencedFinalHoldoutOwnerV1<LockedFileFinalHoldoutCasStoreV1>, AgentdError> {\n        let binding = Digest32::from_array(self.binding);\n        // These are the real host-provided fence fields. No fence issuer,\n        // authority digest, lease, generation or minimum is synthesized here.\n        let fence = HoldoutWriterFenceV1 {\n            owner_id: StableId::new(&self.owner_id).map_err(deployment_error)?,\n            generation: self.generation,\n            lease_digest: Digest32::from_array(self.lease_digest),\n        };\n        let file = files.open_original_owner(&self.file)?;\n        files.require_original_context()?;\n        let original = match self.file.mode {\n            OriginalFileMode::Recover => {\n                let minimum = self.minimum.as_ref()\n                    .ok_or_else(|| deployment_refused(\"recovered holdout has no independent minimum\"))?;\n                let minimum = FinalHoldoutCasAnchorV1 {\n                    fence_generation: minimum.fence_generation,\n                    record_count: minimum.record_count,\n                    state_digest: Digest32::from_array(minimum.state_digest),\n                };\n                let store = LockedFileFinalHoldoutCasStoreV1::recover(file, binding, Some(minimum))\n                    .map_err(deployment_error)?;\n                files.require_original_context()?;\n                FencedFinalHoldoutOwnerV1::recover(store, binding, fence)\n            }\n            OriginalFileMode::CreateNew | OriginalFileMode::ExistingEmpty => {\n                if self.minimum.is_some() {\n                    return Err(deployment_refused(\"fresh holdout cannot discard an existing minimum\"));\n                }\n                let store = LockedFileFinalHoldoutCasStoreV1::create(file, binding)\n                    .map_err(deployment_error)?;\n                files.require_original_context()?;\n                FencedFinalHoldoutOwnerV1::initialize(store, binding, fence)\n            }\n        }.map_err(deployment_error)?;\n        files.require_original_context()?;\n        Ok(original)\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalExecutionMinimumData {\n    pub sequence: u64,\n    pub history_digest: [u8; 32],\n}\nimpl OriginalExecutionMinimumData {\n    fn original(&self) -> ProductEvaluationExecutionAnchorV1 {\n        ProductEvaluationExecutionAnchorV1 {\n            sequence: self.sequence,\n            history_digest: Digest32::from_array(self.history_digest),\n        }\n    }\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalEvaluationStoreData {\n    pub file: MutableFileData,\n    pub binding: [u8; 32],\n    #[serde(deserialize_with = \"required_option\")]\n    pub minimum: Option<OriginalExecutionMinimumData>,\n}\nimpl OriginalEvaluationStoreData {\n    fn require_original_mode(&self) -> Result<(), AgentdError> {\n        if matches!(self.file.mode, OriginalFileMode::Recover) != self.minimum.is_some() {\n            return Err(deployment_refused(\"original evaluation store lifecycle/minimum differs\"));\n        }\n        Ok(())\n    }\n\n    pub(super) fn open_original_execution(\n        &self, files: &mut OriginalDeploymentFiles,\n    ) -> Result<LockedFileProductEvaluationExecutionStoreV1, AgentdError> {\n        self.require_original_mode()?;\n        let file = files.open_original_owner(&self.file)?;\n        let binding = Digest32::from_array(self.binding);\n        files.require_original_context()?;\n        let store = match &self.minimum {\n            Some(minimum) => LockedFileProductEvaluationExecutionStoreV1::recover(\n                file, binding, minimum.original(),\n            ),\n            None => LockedFileProductEvaluationExecutionStoreV1::create(file, binding),\n        }.map_err(deployment_error)?;\n        files.require_original_context()?;\n        Ok(store)\n    }\n\n    pub(super) fn open_original_sink(\n        &self, files: &mut OriginalDeploymentFiles,\n    ) -> Result<LockedFileProductQualificationEvidenceSinkV1, AgentdError> {\n        self.require_original_mode()?;\n        let file = files.open_original_owner(&self.file)?;\n        let binding = Digest32::from_array(self.binding);\n        files.require_original_context()?;\n        let sink = match &self.minimum {\n            Some(minimum) => LockedFileProductQualificationEvidenceSinkV1::recover(\n                file, binding, minimum.original(),\n            ),\n            None => LockedFileProductQualificationEvidenceSinkV1::create(file, binding),\n        }.map_err(deployment_error)?;\n        files.require_original_context()?;\n        Ok(sink)\n    }\n}\n"
        }
      ]
    },
    {
      "key": "evaluation_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation.rs",
        "blob": "821360eb2d4c0537e816ea4e2428a3d719a4c3d8",
        "bytes": 11392,
        "sha256": "ec16644c2ae391a25742e117efe2d8def4c12c53bbd915df086f28be2f3b8f06",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Actual independent B execution for the ordinary deployment.\n//! This runs the original Cell/Product estimator and qualification owners.\n//! Supplied files are inputs and signatures; no result receipt is decoded\n//! from host JSON or substituted for the actual runner's return value.\n\nuse std::sync::Arc;\n\nuse codex_hepta_intelligence_eval::{\n    LockedFileFinalHoldoutProviderV1, LockedFileProductQualificationEvidenceSinkV1,\n    ProductEvaluationExecutionRequestV1,\n    ProductEvaluationRunnerV1, ProductProviderErrorV1, ProductTimingEvidenceV1,\n    evaluation_signing_payload_v2, product_evaluation_execution_key_v1,\n};\nuse codex_hepta_learning_ledger::LearningEvidenceRoleV1;\nuse codex_hepta_types::Digest32;\nuse serde::{Deserialize, Serialize};\n\nuse crate::{\n    AgentdError, CellEvaluationJournalsV1, CellEvaluationQualificationRequestV1,\n    CellEvaluationRunnerV1, CellQ24PreparedLearningV1,\n    OriginalCellEvaluationSigningConfigV1, OriginalCellEvaluationTrainerV1,\n    OriginalCellQ24EvaluationInputsV1, OriginalCellQ24EvaluationTimingV1,\n    OriginalCellQ24LearningOpenV1, OriginalCellQ24TrainingReadbackV1,\n    freeze_cell_learning_evaluation_plan_v1,\n};\nuse crate::root_production_inputs::same_actor_phase::OriginalSameActorRootContext;\n\nuse super::evaluation_data::{OriginalEvaluationRegistrationData, OriginalQualificationContextData};\nuse super::evaluation_signing::{\n    OriginalExecutionAttestor, OriginalQualificationSigningRequest,\n    request_original_qualification,\n};\nuse super::evaluation_storage::{\n    OriginalEvaluationJournalData, OriginalEvaluationStoreData, OriginalHoldoutData,\n};\nuse super::exchange::{OriginalActorExchangeData, OriginalActorWait};\nuse super::files::{OriginalDeploymentFiles, PinnedFileData};\nuse super::learning::{OriginalDeploymentLearning, OriginalSignedOwnerFilesData};\nuse super::temporal_data::OriginalTemporalPlanData;\nuse super::witness::require_fresh_original_file;\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalEvaluationData {\n    pub registration: OriginalEvaluationRegistrationData,\n    pub candidate_journal: OriginalEvaluationJournalData,\n    pub fixed_expert_journal: OriginalEvaluationJournalData,\n    pub candidate_plan: OriginalTemporalPlanData,\n    pub baseline_plan: OriginalTemporalPlanData,\n    pub holdout_material: PinnedFileData,\n    pub holdout: OriginalHoldoutData,\n    pub executions: OriginalEvaluationStoreData,\n    pub evidence_store: OriginalEvaluationStoreData,\n    pub qualification_context: OriginalQualificationContextData,\n    pub execution_signing: OriginalActorExchangeData,\n    pub qualification_signing: OriginalActorExchangeData,\n    pub receipt: OriginalSignedOwnerFilesData,\n}\n\npub(super) struct OriginalExecutedEvaluation {\n    pub inputs: OriginalCellQ24EvaluationInputsV1,\n    /// Retained by the actual coordinator through its original phase cleanup.\n    /// A digest or qualification object is not a substitute for this owner.\n    pub evidence_owner: LockedFileProductQualificationEvidenceSinkV1,\n}\n\nimpl OriginalEvaluationData {\n    pub(super) fn execute_original(\n        &self,\n        context: &Arc<OriginalSameActorRootContext>,\n        prepared: &Arc<CellQ24PreparedLearningV1>,\n        trainer: OriginalCellQ24TrainingReadbackV1,\n        learning: &OriginalDeploymentLearning,\n        files: &mut OriginalDeploymentFiles,\n    ) -> Result<OriginalExecutedEvaluation, AgentdError> {\n        let mut wait = OriginalActorWait::for_original_prepared(\n            Arc::clone(context), prepared,\n        )?;\n        let qualification_context = self.qualification_context.original()?;\n        let now = wait.require_original_live()?;\n        let generator = learning.require_original_signer(\n            qualification_context.generator.principal_id.as_str(),\n            LearningEvidenceRoleV1::Generator, now,\n        )?;\n        let evaluator = learning.require_original_signer(\n            qualification_context.evaluator.principal_id.as_str(),\n            LearningEvidenceRoleV1::Evaluator, now,\n        )?;\n        if generator.principal != qualification_context.generator\n            || evaluator.principal != qualification_context.evaluator\n            || evaluator.principal.principal_id.as_str() != self.receipt.principal\n        {\n            return Err(deployment_refused(\"B principals differ from actual enrolled owners\"));\n        }\n        let candidate = self.candidate_journal.open_original(files)?;\n        let fixed_expert = self.fixed_expert_journal.open_original(files)?;\n        let candidate_plan = self.candidate_plan.original()?;\n        let baseline_plan = self.baseline_plan.original()?;\n        wait.require_original_live()?;\n        // The same actual Prepared request supplies this pre-training pin;\n        // a later B data file cannot replace its original evaluation protocol.\n        let plan = freeze_cell_learning_evaluation_plan_v1(\n            self.registration.original()?,\n            CellEvaluationJournalsV1 { candidate: &candidate, fixed_expert: &fixed_expert },\n            &candidate_plan, &baseline_plan, prepared.initial().request.evaluation_profile,\n        ).map_err(deployment_error)?;\n        let material = files.read_original(&self.holdout_material, 16 * 1024 * 1024)?;\n        wait.require_original_live()?;\n        let mut provider = LockedFileFinalHoldoutProviderV1::open(\n            material.clone_original_file()?, plan.product_plan(),\n        ).map_err(deployment_error)?;\n        material.require_original_pin()?;\n        let holdout = self.holdout.open_original(files)?;\n        let mut executions = self.executions.open_original_execution(files)?;\n        // Its separate original namespace and distinct actual File are\n        // checked by the sink itself and the loader's inode custody.\n        let mut sink = self.evidence_store.open_original_sink(files)?;\n        let mut runner = CellEvaluationRunnerV1::new(ProductEvaluationRunnerV1::new(holdout));\n        let key = product_evaluation_execution_key_v1(\n            plan.product_plan(), Digest32::from_array(self.holdout.binding),\n            &qualification_context.evaluator,\n        ).map_err(deployment_error)?;\n        let business_expiry = prepared.initial().request.envelope.expiry_unix_seconds;\n        let actual_clock = context.clock();\n        let clock_context = Arc::clone(context);\n        let clock = move || {\n            OriginalSameActorRootContext::require_current(&clock_context)\n                .map_err(|_| ProductProviderErrorV1::Unavailable)?;\n            let now = actual_clock.now_unix_ms()\n                .map_err(|_| ProductProviderErrorV1::Unavailable)? / 1_000;\n            if now >= business_expiry {\n                return Err(ProductProviderErrorV1::Unavailable);\n            }\n            OriginalSameActorRootContext::require_current(&clock_context)\n                .map_err(|_| ProductProviderErrorV1::Unavailable)?;\n            Ok(now)\n        };\n        let request = ProductEvaluationExecutionRequestV1 {\n            plan: plan.product_plan(), candidate_plan: &candidate_plan,\n            baseline_plan: &baseline_plan, evaluator: &qualification_context.evaluator,\n            verifier: learning.verifier(), clock: &clock,\n        };\n        let receipt = {\n            let mut attestor = OriginalExecutionAttestor::new(\n                Arc::clone(context), prepared, key, self.execution_signing.clone(),\n                files, &mut wait,\n            )?;\n            let result = runner.evaluate_or_readback(\n                &plan, CellEvaluationJournalsV1 {\n                    candidate: &candidate, fixed_expert: &fixed_expert,\n                }, &request, &mut provider, &mut executions, &mut attestor,\n            );\n            // Preserve the actual external actor error as well as the\n            // original runner's Pending semantics; never dispatch again.\n            if let Some(error) = attestor.take_original_failure() {\n                return Err(error);\n            }\n            result.map_err(deployment_error)?\n        };\n        material.require_original_pin()?;\n        wait.require_original_live()?;\n        let bundle = runner.qualification_bundle(&receipt, &qualification_context)\n            .map_err(deployment_error)?;\n        let evaluator_payload = evaluation_signing_payload_v2(\n            &bundle, &plan.product_plan().metric_roles,\n        ).map_err(deployment_error)?;\n        let evidence = request_original_qualification(\n            OriginalQualificationSigningRequest {\n                context, prepared, plan: &plan,\n                execution_digest: receipt.temporal().execution_digest,\n                evaluator_payload: &evaluator_payload,\n            },\n            self.qualification_signing.clone(), files, &mut wait,\n        )?;\n        let now = wait.require_original_live()?;\n        let qualification = runner.qualify_and_persist(\n            &receipt,\n            CellEvaluationQualificationRequestV1 {\n                context: &qualification_context, evidence: &evidence,\n                timing: ProductTimingEvidenceV1::Qualification,\n                verifier: learning.verifier(), now,\n            },\n            &mut sink,\n        ).map_err(deployment_error)?;\n        let persisted = sink.readback(\n            receipt.temporal().execution_digest, &qualification.product().decision,\n        ).map_err(deployment_error)?;\n        if persisted != qualification.product().publication_digest {\n            return Err(deployment_refused(\"actual B evidence sink readback differs\"));\n        }\n        // Only the actual runner return can enter this concrete handoff.\n        // The original Stage re-reads signed execution and authenticates the\n        // same Trainer/Training cut before minting its own Evaluation receipt.\n        wait.require_original_live()?;\n        require_fresh_original_file(&self.receipt.journal)?;\n        require_fresh_original_file(&self.receipt.witness.file)?;\n        let key = files.read_original_signing_key(&self.receipt.key)?;\n        if key.verifying_key().to_bytes() != evaluator.verifying_key {\n            return Err(deployment_refused(\"B receipt key differs from its actual enrolled Evaluator\"));\n        }\n        let receipt_file = files.open_original_owner(&self.receipt.journal)?;\n        let receipt_witness = self.receipt.witness.open_original(files)?;\n        let signing = OriginalCellEvaluationSigningConfigV1 {\n            plan: plan.product_plan().clone(),\n            execution_namespace: Digest32::from_array(self.holdout.binding),\n            signer: evaluator, verifier: learning.verifier().clone(),\n            maximum_signature_lifetime_seconds: self.receipt.maximum_signature_lifetime_seconds,\n        };\n        wait.require_original_live()?;\n        let inputs = OriginalCellQ24EvaluationInputsV1 {\n            plan, runner, candidate, fixed_expert, candidate_plan, baseline_plan,\n            executions, qualification, context: qualification_context, evidence,\n            timing: OriginalCellQ24EvaluationTimingV1::Qualification,\n            trainer: OriginalCellEvaluationTrainerV1::OriginalQ24(trainer),\n            receipt_file, receipt_witness, signing, key,\n            mode: OriginalCellQ24LearningOpenV1::Create,\n        };\n        Ok(OriginalExecutedEvaluation { inputs, evidence_owner: sink })\n    }\n}\n"
        }
      ]
    },
    {
      "key": "observation_data_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_observation_data.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_observation_data.rs",
        "blob": "a895514e7f23a9ab66a265478bea2122eebfa7d7",
        "bytes": 4533,
        "sha256": "b00a4a945e0758290198c32bc3c7510c0a5455453ed3335fe7ec1e668da67404",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Exact data exported from the actual Training/decision observations.\n//! These descriptions carry no receipt constructor, task admission or Root\n//! authority. Independent actors must reconcile them with their real sources.\n\nuse std::sync::Arc;\nuse codex_hepta_learning_artifacts::{\n    LearningIterationSnapshotV1, learning_iteration_receipt_signing_bytes_v1,\n};\nuse serde::Serialize;\nuse crate::{AgentdError, CellQ24TrainingOutcomeV1, LoadedCellQ24ModelV1,\n    OriginalCellQ24TrainingMaterialV1};\nuse super::bundle_data::OriginalBundleData;\nuse super::learning_data::SignedEvidenceData;\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalTrainingNotice {\n    pub schema_version: u32,\n    pub purpose: &'static str,\n    pub phase: String,\n    pub learning_operation: String,\n    pub dataset_head: [u8; 32],\n    pub training_head: [u8; 32],\n    pub receipt_signing_bytes: Vec<u8>,\n    pub attestation: SignedEvidenceData,\n    pub candidate_bundle: OriginalBundleData,\n    pub heads: Vec<u8>,\n    pub batch_digest: [u8; 32],\n    pub optimizer_rule: [u8; 32],\n    pub update_rule: [u8; 32],\n    pub optimizer_steps: u64,\n    pub squared_error_before_q48: String,\n    pub squared_error_after_q48: String,\n    pub elapsed_microseconds: u64,\n}\nimpl OriginalTrainingNotice {\n    pub(super) fn from_original(\n        phase: &str,\n        snapshot: &LearningIterationSnapshotV1,\n        material: OriginalCellQ24TrainingMaterialV1,\n    ) -> Result<(Self, Arc<LoadedCellQ24ModelV1>), AgentdError> {\n        if material.training() != snapshot {\n            return Err(deployment_refused(\"Training notice differs from its actual readback\"));\n        }\n        let dataset_head = material.dataset().head_digest.into_array();\n        let completion = material.into_completion();\n        let CellQ24TrainingOutcomeV1::Candidate(candidate) = completion.outcome else {\n            // An authenticated NoUpdate follows the existing Decision branch;\n            // it is not reclassified as a candidate for an independent B run.\n            return Err(deployment_refused(\"actual NoUpdate has no independent-B candidate\"));\n        };\n        let candidate = *candidate;\n        let notice = Self {\n            schema_version: 1,\n            purpose: \"hepta.same-actor-q24-deployment.original-training.v1\",\n            phase: phase.to_owned(),\n            learning_operation: snapshot.request.operation_id.as_str().to_owned(),\n            dataset_head, training_head: snapshot.head_digest.into_array(),\n            receipt_signing_bytes: learning_iteration_receipt_signing_bytes_v1(\n                &completion.receipt,\n            ).map_err(deployment_error)?,\n            attestation: SignedEvidenceData::from_original(&completion.attestation),\n            candidate_bundle: OriginalBundleData::from_original(&candidate.bundle),\n            heads: candidate.heads,\n            batch_digest: candidate.metrics.batch_digest.into_array(),\n            optimizer_rule: candidate.metrics.optimizer_rule.into_array(),\n            update_rule: candidate.metrics.update_rule.into_array(),\n            optimizer_steps: candidate.metrics.optimizer_steps,\n            squared_error_before_q48: candidate.metrics.squared_error_before_q48.to_string(),\n            squared_error_after_q48: candidate.metrics.squared_error_after_q48.to_string(),\n            elapsed_microseconds: candidate.metrics.elapsed_microseconds,\n        };\n        Ok((notice, Arc::new(candidate.model)))\n    }\n}\n\n#[derive(Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalDecisionNotice {\n    pub schema_version: u32,\n    pub purpose: &'static str,\n    pub phase: String,\n    pub learning_operation: String,\n    pub actual_head: [u8; 32],\n    pub original_receipt_signing_bytes: Vec<Vec<u8>>,\n}\nimpl OriginalDecisionNotice {\n    pub(super) fn from_original(\n        phase: &str, snapshot: &LearningIterationSnapshotV1,\n    ) -> Result<Self, AgentdError> {\n        Ok(Self {\n            schema_version: 1,\n            purpose: \"hepta.same-actor-q24-deployment.original-decision.v1\",\n            phase: phase.to_owned(),\n            learning_operation: snapshot.request.operation_id.as_str().to_owned(),\n            actual_head: snapshot.head_digest.into_array(),\n            original_receipt_signing_bytes: snapshot.receipts.iter()\n                .map(learning_iteration_receipt_signing_bytes_v1)\n                .collect::<Result<Vec<_>, _>>().map_err(deployment_error)?,\n        })\n    }\n}\n"
        }
      ]
    },
    {
      "key": "deployment_data_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_data.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_data.rs",
        "blob": "be4ca92a49cc1cbdf15cb368751ddcb7f09c3cc0",
        "bytes": 3194,
        "sha256": "d6e66f794704df6c6c045765825de8a5ab7c583b717140c4d6fdea7ee88ffb23",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Immutable Root-approved deployment configuration and late actor data.\n//! All signatures, Outcomes, plans, journals and approved materials are real\n//! deployment inputs. Missing material has no synthetic or permissive default.\n\nuse std::path::PathBuf;\nuse serde::{Deserialize, Serialize};\nuse crate::same_actor_q24_deployment_protocol::OriginalDeploymentBinding;\nuse super::artifacts::{OriginalArtifactDecisionData, OriginalArtifactOwnerData, OriginalSelectionData};\nuse super::c::OriginalCData;\nuse super::evaluation::OriginalEvaluationData;\nuse super::exchange::OriginalActorExchangeData;\nuse super::files::{MutableFileData, PinnedFileData};\nuse super::learning::OriginalLearningMaterialsData;\nuse super::outcome_data::OriginalSignedOutcomeData;\nuse super::preparation::OriginalPreparationData;\nuse super::task::{OriginalCircuitData, OriginalInitialData};\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unk