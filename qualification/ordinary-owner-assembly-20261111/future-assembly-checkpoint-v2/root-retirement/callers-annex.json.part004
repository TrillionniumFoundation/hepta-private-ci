              "*dispatched = true",
              "gate.notify_original_waiters()",
              "gate.require_open()"
            ]
          },
          {
            "function": "fn receive_original_acknowledgement(",
            "sequence": [
              "CloseSameActorPhaseOnDrop::new(gate)",
              "gate.original_wait_epoch()?",
              "receiver.try_recv()",
              "gate.require_open()?",
              "closing.disarm()",
              "return Ok(value)",
              "gate.wait_original_change(epoch)?",
              "Err(mpsc::TryRecvError::Disconnected)",
              "return Err("
            ]
          },
