            "sequence": [
              "match (stage, acknowledgement)",
              "RootSameActorHostAcknowledgementV1::InitialRegistered",
              "RootSameActorHostAcknowledgementV1::CurrentRegistered",
              "binding.parse::<Digest32>()",
              "digest.is_zero()",
              "return Err(",
              "Ok(Some(binding))",
              "RootSameActorHostAcknowledgementV1::ScopedRightsSent",
              "Ok(None)",
              "_ => Err("
            ]
          }
        ]
