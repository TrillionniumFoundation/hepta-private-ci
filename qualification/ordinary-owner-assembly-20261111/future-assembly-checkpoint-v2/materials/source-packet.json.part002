1::Evaluator, now,\n        )?;\n        let key = files.read_original_signing_key(&data.key)?;\n        require_original_key(&signer, &key)?;\n        let journal = files.open_original_owner(&data.journal)?;\n        let witness = data.witness.open_original(files)?;\n        files.require_original_context()?;\n        Ok(OriginalCellQ24TaskDatasetFreezeInputsV1 {\n            journal, witness, open_mode: CircuitQ24TaskOpenModeV1::Create,\n            signing: OriginalCellQ24DatasetFreezeSigningConfigV1 {\n                signer, verifier: self.verifier.clone(),\n                maximum_signature_lifetime_seconds: data.maximum_signature_lifetime_seconds,\n            },\n            evaluator_key: key,\n        })\n    }\n\n    pub(super) fn open_original_c_task(\n        &self,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<OriginalCellQ24TaskLedgerInputsV1, AgentdError> {\n        self.open_original_task(&self.data.original_c, files, now)\n    }\n\n    fn open_original_task(\n        &self,\n        data: &OriginalTaskLedgerData,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<OriginalCellQ24TaskLedgerInputsV1, AgentdError> {\n        data.signatures.require_fresh()?;\n        let generator = self.require_original_signer(\n            &data.signatures.principal, LearningEvidenceRoleV1::Generator, now,\n        )?;\n        let observer = self.require_original_signer(\n            &data.observer, LearningEvidenceRoleV1::Observer, now,\n        )?;\n        let key = files.read_original_signing_key(&data.signatures.key)?;\n        require_original_key(&generator, &key)?;\n        let config = OriginalCellQ24TaskLedgerConfigV1 {\n            episode_id: StableId::new(&data.episode_id).map_err(deployment_error)?,\n            candidate_set_id: StableId::new(&data.candidate_set_id).map_err(deployment_error)?,\n            generator_code_digest: Digest32::from_array(data.generator_code_digest),\n            grammar_digest: Digest32::from_array(data.grammar_digest),\n            hard_filter_digest: Digest32::from_array(data.hard_filter_digest),\n            truncation_digest: Digest32::from_array(data.truncation_digest),\n            generator,\n            observer,\n            outcome_record_id: StableId::new(&data.outcome_record_id).map_err(deployment_error)?,\n            outcome_id: StableId::new(&data.outcome_id).map_err(deployment_error)?,\n            unit_profile_digest: Digest32::from_array(data.unit_profile_digest),\n            expected_delay_profile_digest: Digest32::from_array(data.expected_delay_profile_digest),\n            claim_deadline_unix_seconds: data.claim_deadline_unix_seconds,\n            maximum_signature_lifetime_seconds:\n                data.signatures.maximum_signature_lifetime_seconds,\n        };\n        let signature_journal = files.open_original_owner(&data.signatures.journal)?;\n        let signature_witness = data.signatures.witness.open_original(files)?;\n        files.require_original_context()?;\n        Ok(OriginalCellQ24TaskLedgerInputsV1 {\n            ledger: Arc::clone(&self.ledger), signature_journal, signature_witness,\n            open_mode: CircuitQ24TaskOpenModeV1::Create, config, generator_key: key,\n        })\n    }\n}\n\nfn require_original_key(\n    signer: &TrustedLearningSignerV1,\n    key: &ed25519_dalek::SigningKey,\n) -> Result<(), AgentdError> {\n    if signer.verifying_key != key.verifying_key().to_bytes() {\n        return Err(deployment_refused(\"supplied key differs from the actual enrolled signer\"));\n    }\n    Ok(())\n}\n"
        }
      ]
    },
    {
      "key": "learning_owners_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_learning_owners.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_learning_owners.rs",
        "blob": "05895538b32b08bba514cc2741d0787357588482",
        "bytes": 6832,
        "sha256": "28e36d72c8702ba6951ec627e75960e696801a3ae17595772ec8745061ed5b7d",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Original Observer/Generator/Selector resources opened only after the real\n//! same-session scoped handoff. Prepared is the exact object from A's producer;\n//! its Dataset, targets and Training batch are never deserialized here.\n\nuse std::sync::Arc;\n\nuse codex_hepta_learning_ledger::LearningEvidenceRoleV1;\nuse serde::Deserialize;\nuse serde::Serialize;\n\nuse super::OriginalDeploymentLearning;\nuse super::OriginalSignedOwnerFilesData;\nuse super::require_original_key;\nuse super::super::deployment_error;\nuse super::super::files::MutableFileData;\nuse super::super::files::OriginalDeploymentFiles;\nuse super::super::witness::OriginalWitnessData;\nuse super::super::witness::require_fresh_original_file;\nuse crate::AgentdError;\nuse crate::CellQ24LocalPolicyV1;\nuse crate::CellQ24PreparedLearningV1;\nuse crate::OriginalCellQ24LearningInputsV1;\nuse crate::OriginalCellQ24LearningOpenV1;\nuse crate::OriginalCellQ24LocalDecisionFilesV1;\nuse crate::OriginalCellQ24SourceFilesV1;\nuse crate::OriginalCellQ24SourceInputsV1;\nuse crate::OriginalCellQ24SourceJournalV1;\nuse crate::OriginalCellQ24TrainingFilesV1;\nuse crate::OriginalCellQ24TrainingInputsV1;\nuse crate::same_actor_q24_phase::OriginalSameActorLearningInputsV1;\n\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub(in crate::same_actor_q24_deployment) enum OriginalLocalPolicyData {\n    AdoptQualified,\n    RetainCurrent,\n    DeferQualified,\n}\n\nimpl OriginalLocalPolicyData {\n    fn original(self) -> CellQ24LocalPolicyV1 {\n        match self {\n            Self::AdoptQualified => CellQ24LocalPolicyV1::AdoptQualified,\n            Self::RetainCurrent => CellQ24LocalPolicyV1::RetainCurrent,\n            Self::DeferQualified => CellQ24LocalPolicyV1::DeferQualified,\n        }\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(in crate::same_actor_q24_deployment) struct OriginalLearningOwnersData {\n    pub experience: OriginalSignedOwnerFilesData,\n    pub dataset: OriginalSignedOwnerFilesData,\n    pub training: MutableFileData,\n    pub training_witness: OriginalWitnessData,\n    pub training_receipts: OriginalSignedOwnerFilesData,\n    pub local: OriginalSignedOwnerFilesData,\n    pub local_policy: OriginalLocalPolicyData,\n    pub queue_capacity: usize,\n    pub successor_queue_capacity: usize,\n}\n\nimpl OriginalLearningOwnersData {\n    pub(super) fn require_fresh(&self) -> Result<(), AgentdError> {\n        self.experience.require_fresh()?;\n        self.dataset.require_fresh()?;\n        require_fresh_original_file(&self.training)?;\n        require_fresh_original_file(&self.training_witness.file)?;\n        self.training_receipts.require_fresh()?;\n        self.local.require_fresh()?;\n        Ok(())\n    }\n}\n\nimpl OriginalDeploymentLearning {\n    pub(in crate::same_actor_q24_deployment) fn open_original_scoped_inputs(\n        &self,\n        prepared: Arc<CellQ24PreparedLearningV1>,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<OriginalSameActorLearningInputsV1, AgentdError> {\n        let data = &self.data.owners;\n        data.require_fresh()?;\n        files.require_original_context()?;\n        prepared.revalidate_source().map_err(deployment_error)?;\n        let experience = self.open_original_observer(&data.experience, files, now)?;\n        let dataset = self.open_original_observer(&data.dataset, files, now)?;\n        let training_signer = self.require_original_signer(\n            &data.training_receipts.principal, LearningEvidenceRoleV1::Generator, now,\n        )?;\n        let training_key = files.read_original_signing_key(&data.training_receipts.key)?;\n        require_original_key(&training_signer, &training_key)?;\n        let training = files.open_original_owner(&data.training)?;\n        let training_witness = data.training_witness.open_original(files)?;\n        let receipts = files.open_original_owner(&data.training_receipts.journal)?;\n        let receipt_witness = data.training_receipts.witness.open_original(files)?;\n        let local_signer = self.require_original_signer(\n            &data.local.principal, LearningEvidenceRoleV1::Selector, now,\n        )?;\n        let local_key = files.read_original_signing_key(&data.local.key)?;\n        require_original_key(&local_signer, &local_key)?;\n        let local_journal = files.open_original_owner(&data.local.journal)?;\n        let local_witness = data.local.witness.open_original(files)?;\n        prepared.revalidate_source().map_err(deployment_error)?;\n        files.require_original_context()?;\n        Ok(OriginalSameActorLearningInputsV1 {\n            original: OriginalCellQ24LearningInputsV1 {\n                prepared,\n                sources: OriginalCellQ24SourceInputsV1::Files(OriginalCellQ24SourceFilesV1 {\n                    experience, dataset,\n                }),\n                training: OriginalCellQ24TrainingInputsV1::Files(OriginalCellQ24TrainingFilesV1 {\n                    training, training_witness, receipts, receipt_witness,\n                    signer: training_signer, key: training_key,\n                    verifier: self.verifier.clone(),\n                    maximum_signature_lifetime_seconds:\n                        data.training_receipts.maximum_signature_lifetime_seconds,\n                }),\n                local: OriginalCellQ24LocalDecisionFilesV1 {\n                    journal: local_journal, witness: local_witness,\n                    policy: data.local_policy.original(), signer: local_signer, key: local_key,\n                    maximum_signature_lifetime_seconds:\n                        data.local.maximum_signature_lifetime_seconds,\n                    mode: OriginalCellQ24LearningOpenV1::Create,\n                },\n                verifier: self.verifier.clone(),\n                mode: OriginalCellQ24LearningOpenV1::Create,\n                queue_capacity: data.queue_capacity,\n            },\n            successor_queue_capacity: data.successor_queue_capacity,\n        })\n    }\n\n    fn open_original_observer(\n        &self,\n        data: &OriginalSignedOwnerFilesData,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<OriginalCellQ24SourceJournalV1, AgentdError> {\n        data.require_fresh()?;\n        let signer = self.require_original_signer(\n            &data.principal, LearningEvidenceRoleV1::Observer, now,\n        )?;\n        let key = files.read_original_signing_key(&data.key)?;\n        require_original_key(&signer, &key)?;\n        let journal = files.open_original_owner(&data.journal)?;\n        let witness = data.witness.open_original(files)?;\n        files.require_original_context()?;\n        Ok(OriginalCellQ24SourceJournalV1 {\n            journal, witness, signer, key,\n            maximum_signature_lifetime_seconds: data.maximum_signature_lifetime_seconds,\n        })\n    }\n}\n"
        }
      ]
    },
    {
      "key": "preparation_data_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_preparation.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_preparation.rs",
        "blob": "55a6c955fa9f416a81bf570181fbc3fe11f9876e",
        "bytes": 7354,
        "sha256": "bb9e53e099b1e5e43ef5e51e0e7b9f280f0b82c18a0c8a5cbc21e183e618906e",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Host-frozen preparation data for the actual fresh A source.\n//! The completed-task pin is external observation data checked by the actual\n//! Producer against its live source. It is never taken from a Control ACK.\n\nuse std::sync::Arc;\nuse codex_hepta_learning_artifacts::{CellCompatibilityBundleV1, IterationEnvelopeV1,\n    LearningIterationBudgetV1, LearningIterationOwnersV1, LearningIterationRequestV1};\nuse codex_hepta_types::{Digest32, StableId};\nuse serde::{Deserialize, Serialize};\nuse crate::{AgentdError, CellQ24DatasetProjectionV1, CellQ24LearningPreparationConfigV1,\n    CellQ24PrivateHeadV1, CellQ24SgdRuleV1, LoadedCellQ24ModelV1};\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalEnvelopeData {\n    pub envelope_id: String,\n    pub base_commit: [u8; 32],\n    pub base_tree: [u8; 32],\n    pub objective_digest: [u8; 32],\n    pub grammar_digest: [u8; 32],\n    pub maximum_files: u16,\n    pub maximum_diff_bytes: u64,\n    pub maximum_candidates: u16,\n    pub maximum_parallel_sandboxes: u8,\n    pub expiry_unix_seconds: u64,\n}\nimpl OriginalEnvelopeData {\n    fn original(&self) -> Result<IterationEnvelopeV1, AgentdError> {\n        Ok(IterationEnvelopeV1 {\n            envelope_id: StableId::new(&self.envelope_id).map_err(deployment_error)?,\n            base_commit: Digest32::from_array(self.base_commit),\n            base_tree: Digest32::from_array(self.base_tree),\n            objective_digest: Digest32::from_array(self.objective_digest),\n            grammar_digest: Digest32::from_array(self.grammar_digest),\n            maximum_files: self.maximum_files, maximum_diff_bytes: self.maximum_diff_bytes,\n            maximum_candidates: self.maximum_candidates,\n            maximum_parallel_sandboxes: self.maximum_parallel_sandboxes,\n            expiry_unix_seconds: self.expiry_unix_seconds,\n        })\n    }\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalLearningBudgetData {\n    pub maximum_dataset_rows: u32,\n    pub maximum_dataset_bytes: u64,\n    pub maximum_training_steps: u64,\n    pub maximum_training_milliseconds: u64,\n    pub maximum_artifact_bytes: u64,\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalLearningRequestData {\n    pub operation_id: String,\n    pub principal_id: String,\n    pub agent_id: String,\n    pub cell_id: String,\n    pub source_run_id: String,\n    pub completed_task_receipt: [u8; 32],\n    pub selected_artifact_digest: [u8; 32],\n    pub evaluation_profile: [u8; 32],\n    pub selected_bundle_digest: [u8; 32],\n    pub envelope: OriginalEnvelopeData,\n    pub budget: OriginalLearningBudgetData,\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalIterationOwnersData {\n    pub evidence_trust_digest: [u8; 32],\n    pub experience: String,\n    pub dataset: String,\n    pub trainer: String,\n    pub evaluator: String,\n    pub proposal: String,\n    pub selector: String,\n    pub next_use_observer: String,\n}\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(tag = \"kind\", rename_all = \"snake_case\", deny_unknown_fields)]\npub(super) enum OriginalPrivateHeadData {\n    Drive { index: u16 },\n    Prediction { index: u16 },\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalPreparationData {\n    pub request: OriginalLearningRequestData,\n    pub owners: OriginalIterationOwnersData,\n    pub head: OriginalPrivateHeadData,\n    pub epochs: u16,\n    pub learning_rate_q24: i64,\n    pub inherited_inclusion_policy: [u8; 32],\n    pub unit_profile_digest: [u8; 32],\n    pub input_width: u16,\n    pub snapshot_id: String,\n}\nimpl OriginalPreparationData {\n    pub(super) fn original(\n        &self, baseline: Arc<LoadedCellQ24ModelV1>, bundle: &CellCompatibilityBundleV1,\n    ) -> Result<CellQ24LearningPreparationConfigV1, AgentdError> {\n        let expected = Digest32::from_array(self.request.selected_bundle_digest);\n        if bundle.digest().map_err(deployment_error)? != expected\n            || baseline.components() != &bundle.components\n        {\n            return Err(deployment_refused(\"preparation differs from the actual Initial baseline\"));\n        }\n        let data = &self.request;\n        let budget = &data.budget;\n        let request = LearningIterationRequestV1 {\n            operation_id: StableId::new(&data.operation_id).map_err(deployment_error)?,\n            principal_id: StableId::new(&data.principal_id).map_err(deployment_error)?,\n            agent_id: StableId::new(&data.agent_id).map_err(deployment_error)?,\n            cell_id: StableId::new(&data.cell_id).map_err(deployment_error)?,\n            source_run_id: StableId::new(&data.source_run_id).map_err(deployment_error)?,\n            completed_task_receipt: Digest32::from_array(data.completed_task_receipt),\n            selected_artifact_digest: Digest32::from_array(data.selected_artifact_digest),\n            evaluation_profile: Digest32::from_array(data.evaluation_profile),\n            selected_bundle: bundle.clone(), envelope: data.envelope.original()?,\n            budget: LearningIterationBudgetV1 {\n                maximum_dataset_rows: budget.maximum_dataset_rows,\n                maximum_dataset_bytes: budget.maximum_dataset_bytes,\n                maximum_training_steps: budget.maximum_training_steps,\n                maximum_training_milliseconds: budget.maximum_training_milliseconds,\n                maximum_artifact_bytes: budget.maximum_artifact_bytes,\n            },\n        };\n        let owner = &self.owners;\n        Ok(CellQ24LearningPreparationConfigV1 {\n            request,\n            owners: LearningIterationOwnersV1 {\n                evidence_trust_digest: Digest32::from_array(owner.evidence_trust_digest),\n                experience: StableId::new(&owner.experience).map_err(deployment_error)?,\n                dataset: StableId::new(&owner.dataset).map_err(deployment_error)?,\n                trainer: StableId::new(&owner.trainer).map_err(deployment_error)?,\n                evaluator: StableId::new(&owner.evaluator).map_err(deployment_error)?,\n                proposal: StableId::new(&owner.proposal).map_err(deployment_error)?,\n                selector: StableId::new(&owner.selector).map_err(deployment_error)?,\n                next_use_observer: StableId::new(&owner.next_use_observer).map_err(deployment_error)?,\n            },\n            baseline,\n            head: match self.head {\n                OriginalPrivateHeadData::Drive { index } => CellQ24PrivateHeadV1::Drive { index },\n                OriginalPrivateHeadData::Prediction { index } => CellQ24PrivateHeadV1::Prediction { index },\n            },\n            rule: CellQ24SgdRuleV1 { epochs: self.epochs, learning_rate_q24: self.learning_rate_q24 },\n            projection: CellQ24DatasetProjectionV1 {\n                inherited_inclusion_policy: Digest32::from_array(self.inherited_inclusion_policy),\n                unit_profile_digest: Digest32::from_array(self.unit_profile_digest),\n                baseline_bundle: expected, input_width: self.input_width,\n            },\n            snapshot_id: StableId::new(&self.snapshot_id).map_err(deployment_error)?,\n        })\n    }\n}\n"
        }
      ]
    },
    {
      "key": "cell_data_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_cell_data.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_cell_data.rs",
        "blob": "cc35d786fba07685d911038da4abdbd78399421f",
        "bytes": 9898,
        "sha256": "68d37ff215485832623aead18b1f8e5ead1d7884fbf3684f33c0484a99e4cd13",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Original Cell definition data from the Root-approved ordinary descriptor.\n//! These conversions copy values; the original model, Cell and CURRENT owners\n//! validate the complete definition and all executable/resource bindings.\n\nuse codex_hepta_neuron::{NeuronCalibrationProfileV1, NeuronResourceEnvelopeV1, NeuronRuntimeConfigV1, SparseConfig, InhibitoryEdge, CellCandidateV1, CellDefinitionV1, CellCandidateKindV1};\nuse codex_hepta_types::{Digest32, Generation, StableId};\nuse serde::{Deserialize, Serialize};\nuse crate::AgentdError;\nuse super::deployment_error;\n\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub(super) enum OriginalCandidateKindData { Action, Abstain, SlowPath }\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalCalibrationData {\n    pub calibration_artifact_digest: [u8; 32],\n    pub ood_artifact_digest: [u8; 32],\n    pub generation: u64,\n    pub valid_from_sequence: u64,\n    pub expires_after_sequence: u64,\n    pub zero_confidence_error_q24: i64,\n    pub maximum_in_domain_error_q24: i64,\n    pub minimum_confidence_ppm: u32,\n    pub maximum_ood_ppm: u32,\n    pub minimum_active_ppm: u32,\n    pub maximum_active_ppm: u32,\n    pub maximum_projection_count: u32,\n    pub measured_ece_ppm: u32,\n    pub maximum_ece_ppm: u32,\n    pub measured_false_acceptance_ppm: u32,\n    pub maximum_false_acceptance_ppm: u32,\n}\n\nimpl OriginalCalibrationData {\n    pub(super) fn original(&self) -> Result<NeuronCalibrationProfileV1, AgentdError> {\n        Ok(NeuronCalibrationProfileV1 {\n            calibration_artifact_digest: Digest32::from_array(self.calibration_artifact_digest),\n            ood_artifact_digest: Digest32::from_array(self.ood_artifact_digest),\n            generation: Generation::new(self.generation).map_err(deployment_error)?,\n            valid_from_sequence: self.valid_from_sequence,\n            expires_after_sequence: self.expires_after_sequence,\n            zero_confidence_error_q24: self.zero_confidence_error_q24,\n            maximum_in_domain_error_q24: self.maximum_in_domain_error_q24,\n            minimum_confidence_ppm: self.minimum_confidence_ppm,\n            maximum_ood_ppm: self.maximum_ood_ppm,\n            minimum_active_ppm: self.minimum_active_ppm,\n            maximum_active_ppm: self.maximum_active_ppm,\n            maximum_projection_count: self.maximum_projection_count,\n            measured_ece_ppm: self.measured_ece_ppm,\n            maximum_ece_ppm: self.maximum_ece_ppm,\n            measured_false_acceptance_ppm: self.measured_false_acceptance_ppm,\n            maximum_false_acceptance_ppm: self.maximum_false_acceptance_ppm,\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalResourceEnvelopeData {\n    pub p95_latency_micros: u64,\n    pub p99_latency_micros: u64,\n    pub transient_allocation_bytes: u64,\n    pub checkpoint_bytes: u64,\n    pub write_amplification_ppm: u32,\n}\n\nimpl OriginalResourceEnvelopeData {\n    pub(super) fn original(&self) -> Result<NeuronResourceEnvelopeV1, AgentdError> {\n        Ok(NeuronResourceEnvelopeV1 {\n            p95_latency_micros: self.p95_latency_micros,\n            p99_latency_micros: self.p99_latency_micros,\n            transient_allocation_bytes: self.transient_allocation_bytes,\n            checkpoint_bytes: self.checkpoint_bytes,\n            write_amplification_ppm: self.write_amplification_ppm,\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalCellRuntimeData {\n    pub config_id: String,\n    pub generation: u64,\n    pub model_id: String,\n    pub model_manifest_digest: [u8; 32],\n    pub encoder_digest: [u8; 32],\n    pub head_digest: [u8; 32],\n    pub weights_digest: [u8; 32],\n    pub tokenizer_digest: [u8; 32],\n    pub preprocessor_digest: [u8; 32],\n    pub quantization_digest: [u8; 32],\n    pub runtime_digest: [u8; 32],\n    pub device_digest: [u8; 32],\n    pub normalization_digest: [u8; 32],\n    pub native_config_digest: [u8; 32],\n    pub input_feature_dimension: usize,\n    pub state_width: usize,\n    pub modulator_dimension: usize,\n    pub calibration: OriginalCalibrationData,\n    pub resource_envelope: OriginalResourceEnvelopeData,\n}\n\nimpl OriginalCellRuntimeData {\n    pub(super) fn original(&self) -> Result<NeuronRuntimeConfigV1, AgentdError> {\n        Ok(NeuronRuntimeConfigV1 {\n            config_id: StableId::new(&self.config_id).map_err(deployment_error)?,\n            generation: Generation::new(self.generation).map_err(deployment_error)?,\n            model_id: StableId::new(&self.model_id).map_err(deployment_error)?,\n            model_manifest_digest: Digest32::from_array(self.model_manifest_digest),\n            encoder_digest: Digest32::from_array(self.encoder_digest),\n            head_digest: Digest32::from_array(self.head_digest),\n            weights_digest: Digest32::from_array(self.weights_digest),\n            tokenizer_digest: Digest32::from_array(self.tokenizer_digest),\n            preprocessor_digest: Digest32::from_array(self.preprocessor_digest),\n            quantization_digest: Digest32::from_array(self.quantization_digest),\n            runtime_digest: Digest32::from_array(self.runtime_digest),\n            device_digest: Digest32::from_array(self.device_digest),\n            normalization_digest: Digest32::from_array(self.normalization_digest),\n            native_config_digest: Digest32::from_array(self.native_config_digest),\n            input_feature_dimension: self.input_feature_dimension,\n            state_width: self.state_width,\n            modulator_dimension: self.modulator_dimension,\n            calibration: self.calibration.original()?,\n            resource_envelope: self.resource_envelope.original()?,\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalSparseData {\n    pub model_digest: [u8; 32],\n    pub normalization_digest: [u8; 32],\n    pub generation: u64,\n    pub width: usize,\n    pub top_k: usize,\n    pub temporal_decay_q24: i64,\n    pub inhibition_gain_q24: i64,\n    pub inhibition: Vec<OriginalInhibitoryEdgeData>,\n    pub activity_decay_q24: i64,\n    pub target_activity_q24: i64,\n    pub threshold_rate_q24: i64,\n    pub threshold_min_q24: i64,\n    pub threshold_max_q24: i64,\n    pub eligibility_decay_q24: i64,\n}\n\nimpl OriginalSparseData {\n    pub(super) fn original(&self) -> Result<SparseConfig, AgentdError> {\n        Ok(SparseConfig {\n            model_digest: Digest32::from_array(self.model_digest),\n            normalization_digest: Digest32::from_array(self.normalization_digest),\n            generation: Generation::new(self.generation).map_err(deployment_error)?,\n            width: self.width,\n            top_k: self.top_k,\n            temporal_decay_q24: self.temporal_decay_q24,\n            inhibition_gain_q24: self.inhibition_gain_q24,\n            inhibition: self.inhibition.iter().map(OriginalInhibitoryEdgeData::original).collect::<Result<_, _>>()?,\n            activity_decay_q24: self.activity_decay_q24,\n            target_activity_q24: self.target_activity_q24,\n            threshold_rate_q24: self.threshold_rate_q24,\n            threshold_min_q24: self.threshold_min_q24,\n            threshold_max_q24: self.threshold_max_q24,\n            eligibility_decay_q24: self.eligibility_decay_q24,\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalInhibitoryEdgeData {\n    pub source: usize,\n    pub target: usize,\n    pub weight_q24: i64,\n}\n\nimpl OriginalInhibitoryEdgeData {\n    pub(super) fn original(&self) -> Result<InhibitoryEdge, AgentdError> {\n        Ok(InhibitoryEdge {\n            source: self.source,\n            target: self.target,\n            weight_q24: self.weight_q24,\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalCandidateData {\n    pub candidate_id: String,\n    pub activation_index: usize,\n    pub kind: OriginalCandidateKindData,\n}\n\nimpl OriginalCandidateData {\n    pub(super) fn original(&self) -> Result<CellCandidateV1, AgentdError> {\n        Ok(CellCandidateV1 {\n            candidate_id: StableId::new(&self.candidate_id).map_err(deployment_error)?,\n            activation_index: self.activation_index,\n            kind: match self.kind { OriginalCandidateKindData::Action => CellCandidateKindV1::Action, OriginalCandidateKindData::Abstain => CellCandidateKindV1::Abstain, OriginalCandidateKindData::SlowPath => CellCandidateKindV1::SlowPath },\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalCellDefinitionData {\n    pub cell_id: String,\n    pub bundle_digest: [u8; 32],\n    pub state_schema_digest: [u8; 32],\n    pub runtime: OriginalCellRuntimeData,\n    pub native: OriginalSparseData,\n    pub candidates: Vec<OriginalCandidateData>,\n    pub max_input_bytes: usize,\n    pub max_queue_age_micros: u64,\n    pub max_resident_bytes: u64,\n}\n\nimpl OriginalCellDefinitionData {\n    pub(super) fn original(&self) -> Result<CellDefinitionV1, AgentdError> {\n        Ok(CellDefinitionV1 {\n            cell_id: StableId::new(&self.cell_id).map_err(deployment_error)?,\n            bundle_digest: Digest32::from_array(self.bundle_digest),\n            state_schema_digest: Digest32::from_array(self.state_schema_digest),\n            runtime: self.runtime.original()?,\n            native: self.native.original()?,\n            candidates: self.candidates.iter().map(OriginalCandidateData::original).collect::<Result<_, _>>()?,\n            max_input_bytes: self.max_input_bytes,\n            max_queue_age_micros: self.max_queue_age_micros,\n            max_resident_bytes: self.max_resident_bytes,\n        })\n    }\n}\n\n"
        }
      ]
    },
    {
      "key": "bundle_data_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_bundle_data.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_bundle_data.rs",
        "blob": "c1ddb59ea63b6dc135b2570220a2df693d8527af",
        "bytes": 5397,
        "sha256": "1fc15bc23d748ee6848e16113956c17deb27da6c7fbdc6273925a8a99afce389",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Lossless raw compatibility-bundle data; only original owner validation can\n//! bind it to an actual selected model, Training lineage or CURRENT.\nuse codex_hepta_learning_artifacts::{CellBundleComponentsV1, CellTrainingLineageV1, CellCompatibilityBundleV1};\nuse codex_hepta_types::{Digest32, Generation, StableId};\nuse serde::{Deserialize, Serialize};\nuse crate::AgentdError;\nuse super::deployment_error;\nuse super::learning_data::required_option;\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalBundleComponentsData {\n    pub base: [u8; 32],\n    #[serde(deserialize_with = \"required_option\")]\n    pub organ_adapter: Option<[u8; 32]>,\n    #[serde(deserialize_with = \"required_option\")]\n    pub cell_adapter: Option<[u8; 32]>,\n    pub heads: [u8; 32],\n    pub composition: [u8; 32],\n    pub encoder: [u8; 32],\n    pub tokenizer: [u8; 32],\n    pub normalizer: [u8; 32],\n    pub calibration: [u8; 32],\n    pub numeric_profile: [u8; 32],\n    pub output_schema: [u8; 32],\n    pub state_schema: [u8; 32],\n    pub state_semantics: [u8; 32],\n}\n\nimpl OriginalBundleComponentsData {\n    pub(super) fn original(&self) -> Result<CellBundleComponentsV1, AgentdError> {\n        Ok(CellBundleComponentsV1 {\n            base: Digest32::from_array(self.base),\n            organ_adapter: self.organ_adapter.map(Digest32::from_array),\n            cell_adapter: self.cell_adapter.map(Digest32::from_array),\n            heads: Digest32::from_array(self.heads),\n            composition: Digest32::from_array(self.composition),\n            encoder: Digest32::from_array(self.encoder),\n            tokenizer: Digest32::from_array(self.tokenizer),\n            normalizer: Digest32::from_array(self.normalizer),\n            calibration: Digest32::from_array(self.calibration),\n            numeric_profile: Digest32::from_array(self.numeric_profile),\n            output_schema: Digest32::from_array(self.output_schema),\n            state_schema: Digest32::from_array(self.state_schema),\n            state_semantics: Digest32::from_array(self.state_semantics),\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalTrainingLineageData {\n    pub source_bundle: [u8; 32],\n    pub dataset: [u8; 32],\n    pub update_rule: [u8; 32],\n    pub evaluation_profile: [u8; 32],\n}\n\nimpl OriginalTrainingLineageData {\n    pub(super) fn original(&self) -> Result<CellTrainingLineageV1, AgentdError> {\n        Ok(CellTrainingLineageV1 {\n            source_bundle: Digest32::from_array(self.source_bundle),\n            dataset: Digest32::from_array(self.dataset),\n            update_rule: Digest32::from_array(self.update_rule),\n            evaluation_profile: Digest32::from_array(self.evaluation_profile),\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalBundleData {\n    pub artifact_id: String,\n    pub generation: u64,\n    pub components: OriginalBundleComponentsData,\n    #[serde(deserialize_with = \"required_option\")]\n    pub training_lineage: Option<OriginalTrainingLineageData>,\n    #[serde(deserialize_with = \"required_option\")]\n    pub rollback_predecessor: Option<[u8; 32]>,\n}\n\nimpl OriginalBundleData {\n    pub(super) fn from_original(original: &CellCompatibilityBundleV1) -> Self {\n        let parts = &original.components;\n        Self {\n            artifact_id: original.artifact_id.as_str().to_owned(),\n            generation: original.generation.get(),\n            components: OriginalBundleComponentsData {\n                base: parts.base.into_array(),\n                organ_adapter: parts.organ_adapter.map(Digest32::into_array),\n                cell_adapter: parts.cell_adapter.map(Digest32::into_array),\n                heads: parts.heads.into_array(), composition: parts.composition.into_array(),\n                encoder: parts.encoder.into_array(), tokenizer: parts.tokenizer.into_array(),\n                normalizer: parts.normalizer.into_array(), calibration: parts.calibration.into_array(),\n                numeric_profile: parts.numeric_profile.into_array(),\n                output_schema: parts.output_schema.into_array(), state_schema: parts.state_schema.into_array(),\n                state_semantics: parts.state_semantics.into_array(),\n            },\n            training_lineage: original.training_lineage.as_ref().map(|lineage| OriginalTrainingLineageData {\n                source_bundle: lineage.source_bundle.into_array(), dataset: lineage.dataset.into_array(),\n                update_rule: lineage.update_rule.into_array(),\n                evaluation_profile: lineage.evaluation_profile.into_array(),\n            }),\n            rollback_predecessor: original.rollback_predecessor.map(Digest32::into_array),\n        }\n    }\n\n    pub(super) fn original(&self) -> Result<CellCompatibilityBundleV1, AgentdError> {\n        Ok(CellCompatibilityBundleV1 {\n            artifact_id: StableId::new(&self.artifact_id).map_err(deployment_error)?,\n            generation: Generation::new(self.generation).map_err(deployment_error)?,\n            components: self.components.original()?,\n            training_lineage: self.training_lineage.as_ref().map(OriginalTrainingLineageData::original).transpose()?,\n            rollback_predecessor: self.rollback_predecessor.map(Digest32::from_array),\n        })\n    }\n}\n\n"
        }
      ]
    },
    {
      "key": "model_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_model.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_model.rs",
        "blob": "7ba5e3e61787dee0064059a46870a1467e62c6f3",
        "bytes": 2673,
        "sha256": "a73d7690f8746c5978fbeff88d07191e58f86b1c677d75207e71b417bb4c025b",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Open actual immutable Q24 files from the approved deployment and retain\n//! their inode/hash pins across the original bounded model decoder.\n\nuse std::sync::Arc;\nuse codex_hepta_learning_artifacts::CellCompatibilityBundleV1;\nuse serde::{Deserialize, Serialize};\nuse crate::{AgentdError, CellQ24ModelFilesV1, LoadedCellQ24ModelV1};\nuse super::bundle_data::OriginalBundleData;\nuse super::files::{OriginalDeploymentFiles, PinnedFileData};\nuse super::learning_data::required_option;\nuse super::deployment_error;\nuse super::deployment_refused;\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalModelData {\n    pub base: PinnedFileData,\n    pub encoder: PinnedFileData,\n    pub heads: PinnedFileData,\n    #[serde(deserialize_with = \"required_option\")]\n    pub organ_adapter: Option<PinnedFileData>,\n    #[serde(deserialize_with = \"required_option\")]\n    pub cell_adapter: Option<PinnedFileData>,\n    pub bundle: OriginalBundleData,\n}\n\nimpl OriginalModelData {\n    pub(super) fn open_original(\n        &self,\n        files: &mut OriginalDeploymentFiles,\n    ) -> Result<(Arc<LoadedCellQ24ModelV1>, CellCompatibilityBundleV1), AgentdError> {\n        files.require_original_context()?;\n        let base = files.read_original(&self.base, 16 * 1024 * 1024)?;\n        let encoder = files.read_original(&self.encoder, 16 * 1024 * 1024)?;\n        let heads = files.read_original(&self.heads, 16 * 1024 * 1024)?;\n        let organ = self.organ_adapter.as_ref()\n            .map(|file| files.read_original(file, 16 * 1024 * 1024)).transpose()?;\n        let cell = self.cell_adapter.as_ref()\n            .map(|file| files.read_original(file, 16 * 1024 * 1024)).transpose()?;\n        let model = LoadedCellQ24ModelV1::open_files(CellQ24ModelFilesV1 {\n            base: base.clone_original_file()?,\n            encoder: encoder.clone_original_file()?,\n            heads: heads.clone_original_file()?,\n            organ_adapter: organ.as_ref().map(|read| read.clone_original_file()).transpose()?,\n            cell_adapter: cell.as_ref().map(|read| read.clone_original_file()).transpose()?,\n        }).map_err(deployment_error)?;\n        for read in [&base, &encoder, &heads].into_iter().chain(organ.iter()).chain(cell.iter()) {\n            read.require_original_pin()?;\n        }\n        let bundle = self.bundle.original()?;\n        bundle.digest().map_err(deployment_error)?;\n        if model.components() != &bundle.components {\n            return Err(deployment_refused(\"actual model components differ from the approved bundle\"));\n        }\n        files.require_original_context()?;\n        Ok((Arc::new(model), bundle))\n    }\n}\n"
        }
      ]
    },
    {
      "key": "task_materials_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_task.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_task.rs",
        "blob": "1594718f4a9ecc4c904cef50c86565662b5ccc54",
        "bytes": 12573,
        "sha256": "fcc7b637f6221df5932a0e3fb05b1a919cd3894acfedbb47739a0e5f0f558ea8",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Concrete ordinary task and original Initial target files.\n//! No RunStart/receipt is manufactured here: the signed Control ingress and\n//! original Root/Cell owners admit and validate every supplied input.\n\nuse std::os::fd::AsRawFd;\nuse std::sync::Arc;\nuse codex_hepta_automation::{BoundedCircuitDefinitionV2, CircuitExitV2, TaskFlowFence};\nuse codex_hepta_contracts::AgentId;\nuse codex_hepta_neuron::{CellCandidateMaskV1, CellScopeV1, DurableInferenceControl};\nuse codex_hepta_types::{Digest32, StableId};\nuse serde::{Deserialize, Serialize};\nuse crate::{AgentdError, CircuitCellRouteV1, CircuitCellTimeV1, CircuitQ24TaskFilesV1,\n    CircuitTaskSourceInputV1, OriginalRootInitialFeatureTargetV1, RootGenerationJournalInputsV1};\nuse crate::authority_host_runtime::OriginalDeploymentObserverData;\nuse crate::root_production_inputs::same_actor_phase::OriginalSameActorRootContext;\nuse crate::same_actor_q24_phase::OriginalSameActorATaskInputsV1;\nuse super::cell_data::OriginalCellDefinitionData;\nuse super::files::{MutableFileData, OriginalDeploymentFiles, OriginalFileMode, OriginalOwnerFileOrigin};\nuse super::model::OriginalModelData;\nuse super::witness::{OriginalWitnessData, require_fresh_original_file};\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalCandidateMaskData { pub candidate_id: String, pub allowed: bool }\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalTaskSourceData {\n    pub agent_id: String,\n    pub cell_id: String,\n    pub run_id: String,\n    pub principal_digest: [u8; 32],\n    pub source_frontier: [u8; 32],\n    pub objective_digest: [u8; 32],\n    pub ndu_snapshot_digest: [u8; 32],\n    pub monotonic_micros: u64,\n    pub deadline_micros: u64,\n    pub observation: Vec<u8>,\n    pub candidates: Vec<OriginalCandidateMaskData>,\n    pub lease_duration_ms: u64,\n}\n\nimpl OriginalTaskSourceData {\n    pub(super) fn original(&self) -> Result<CircuitTaskSourceInputV1, AgentdError> {\n        Ok(CircuitTaskSourceInputV1 {\n            scope: CellScopeV1 {\n                agent_id: StableId::new(&self.agent_id).map_err(deployment_error)?,\n                cell_id: StableId::new(&self.cell_id).map_err(deployment_error)?,\n                run_id: StableId::new(&self.run_id).map_err(deployment_error)?,\n                principal_digest: Digest32::from_array(self.principal_digest),\n            },\n            source_frontier: Digest32::from_array(self.source_frontier),\n            objective_digest: Digest32::from_array(self.objective_digest),\n            ndu_snapshot_digest: Digest32::from_array(self.ndu_snapshot_digest),\n            monotonic_micros: self.monotonic_micros,\n            deadline_micros: self.deadline_micros,\n            observation: self.observation.clone(),\n            candidates: self.candidates.iter().map(|candidate| {\n                Ok(CellCandidateMaskV1 {\n                    candidate_id: StableId::new(&candidate.candidate_id).map_err(deployment_error)?,\n                    allowed: candidate.allowed,\n                })\n            }).collect::<Result<_, AgentdError>>()?,\n            lease_duration_ms: self.lease_duration_ms,\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalInitialData {\n    pub journal: MutableFileData,\n    pub witness: MutableFileData,\n    pub observer: OriginalDeploymentObserverData,\n    pub model: OriginalModelData,\n    pub definition: OriginalCellDefinitionData,\n    pub source: OriginalTaskSourceData,\n}\n\nimpl OriginalInitialData {\n    pub(super) fn open_original(\n        &self,\n        files: &mut OriginalDeploymentFiles,\n    ) -> Result<(OriginalRootInitialFeatureTargetV1, OriginalInitialPredecessorFiles), AgentdError> {\n        // Root's actual Initial observer requires an unwritten target journal\n        // and an independently initialized witness. No missing-witness fallback.\n        require_fresh_original_file(&self.journal)?;\n        if !matches!(self.witness.mode, OriginalFileMode::Recover) {\n            return Err(deployment_refused(\"Initial requires its existing original witness\"));\n        }\n        let (model, bundle) = self.model.open_original(files)?;\n        let definition = self.definition.original()?;\n        let source = self.source.original()?;\n        let config = self.observer.original_observer_config().map_err(deployment_error)?;\n        crate::circuit_feature_initial_root::require_feature(\n            &config.generation, &bundle, &model, &definition, &source,\n        )?;\n        let journal = files.open_original_owner(&self.journal)?;\n        let witness = files.open_original_owner(&self.witness)?;\n        let origin = OriginalInitialPredecessorFiles {\n            journal: files.retain_original_initial_file_origin(&journal, &self.journal.path)?,\n            witness: files.retain_original_initial_file_origin(&witness, &self.witness.path)?,\n            config: config.clone(),\n        };\n        files.require_original_context()?;\n        Ok((OriginalRootInitialFeatureTargetV1 {\n            files: RootGenerationJournalInputsV1 { journal, witness, config },\n            model, bundle, definition, source,\n        }, origin))\n    }\n}\n\n/// Retained metadata and parent custody from the original Initial open. It\n/// contains no writer-file alias, active task capability or completion token.\npub(super) struct OriginalInitialPredecessorFiles {\n    journal: OriginalOwnerFileOrigin,\n    witness: OriginalOwnerFileOrigin,\n    config: codex_hepta_neuron::CellGenerationObserverConfigV1,\n}\nimpl OriginalInitialPredecessorFiles {\n    pub(super) fn reopen_original(\n        self, files: &mut OriginalDeploymentFiles,\n    ) -> Result<crate::AgentdGenerationUpdatePredecessorFilesV1<codex_hepta_neuron::FileAnchorWitnessStore>, AgentdError> {\n        let journal = self.journal.reopen_original(files)?;\n        let witness_file = self.witness.reopen_original(files)?;\n        files.require_original_context()?;\n        let witness = codex_hepta_neuron::FileAnchorWitnessStore::open(\n            witness_file, self.config.witness_scope, self.config.witness_generation, self.config.witness_records,\n        ).map_err(deployment_error)?;\n        files.require_original_context()?;\n        Ok(crate::AgentdGenerationUpdatePredecessorFilesV1 {\n            file: journal, witness, config: self.config.generation, max_records: self.config.journal_records,\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalCircuitRouteData {\n    pub candidate_id: String,\n    pub outcome: CircuitExitV2,\n    pub selected_edges: Vec<String>,\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalTaskFilesData {\n    pub source_journal: MutableFileData,\n    pub source_witness: OriginalWitnessData,\n    pub cell_journal: MutableFileData,\n    pub cell_witness: OriginalWitnessData,\n    pub inference_control: MutableFileData,\n    pub inference_capacity: usize,\n}\n\nimpl OriginalTaskFilesData {\n    pub(super) fn open_original(\n        &self,\n        files: &mut OriginalDeploymentFiles,\n    ) -> Result<CircuitQ24TaskFilesV1<codex_hepta_neuron::FileAnchorWitnessStore,\n        codex_hepta_neuron::FileAnchorWitnessStore>, AgentdError> {\n        for file in [&self.source_journal, &self.source_witness.file, &self.cell_journal,\n            &self.cell_witness.file, &self.inference_control] {\n            require_fresh_original_file(file)?;\n        }\n        let source_journal = files.open_original_owner(&self.source_journal)?;\n        let source_witness = self.source_witness.open_original(files)?;\n        let cell_journal = files.open_original_owner(&self.cell_journal)?;\n        let cell_witness = self.cell_witness.open_original(files)?;\n        let control = files.open_original_owner(&self.inference_control)?;\n        files.require_original_context()?;\n        // The original inference owner requires O_APPEND. This is the one\n        // privately owned descriptor; no alias or writer is retained afterward.\n        // SAFETY: the live owned File supplies a valid borrowed descriptor;\n        // F_GETFL reads its status without taking ownership.\n        let flags = unsafe { libc::fcntl(control.as_raw_fd(), libc::F_GETFL) };\n        if flags < 0 {\n            return Err(AgentdError::Io(std::io::Error::last_os_error()));\n        }\n        // SAFETY: the same live private descriptor is borrowed; the existing\n        // status flags are preserved while enabling the required append mode.\n        if unsafe { libc::fcntl(control.as_raw_fd(), libc::F_SETFL, flags | libc::O_APPEND) } < 0 {\n            return Err(AgentdError::Io(std::io::Error::last_os_error()));\n        }\n        let inference_control = DurableInferenceControl::open_file(\n            control, &self.inference_control.path, self.inference_capacity,\n        ).map_err(deployment_error)?;\n        files.require_original_context()?;\n        Ok(CircuitQ24TaskFilesV1 { source_journal, source_witness, cell_journal,\n            cell_witness, inference_control })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalCircuitData {\n    pub files: OriginalTaskFilesData,\n    pub owner_agent_id: String,\n    pub owner_id: String,\n    pub owner_epoch: u64,\n    pub generation: u64,\n    pub fencing_token: String,\n    pub circuit: BoundedCircuitDefinitionV2,\n    pub routes: Vec<OriginalCircuitRouteData>,\n    pub worker_generation: u64,\n    pub maximum_cell_records: usize,\n    pub queue_capacity: usize,\n}\n\nimpl OriginalCircuitData {\n    pub(super) fn open_original(\n        &self,\n        context: &Arc<OriginalSameActorRootContext>,\n        files: &mut OriginalDeploymentFiles,\n    ) -> Result<OriginalSameActorATaskInputsV1, AgentdError> {\n        let agent = AgentId::new(&self.owner_agent_id).map_err(deployment_error)?;\n        if agent != context.identity().agent_id\n            || context.identity().spawn_generation.checked_add(1) != Some(self.generation)\n        {\n            return Err(deployment_refused(\"Circuit fence differs from the actual registered actor\"));\n        }\n        let fence = TaskFlowFence::new(agent, &self.owner_id, self.owner_epoch,\n            self.generation, &self.fencing_token).map_err(deployment_error)?;\n        self.circuit.validate().map_err(deployment_error)?;\n        let routes = self.routes.iter().map(|route| Ok(CircuitCellRouteV1 {\n            candidate_id: StableId::new(&route.candidate_id).map_err(deployment_error)?,\n            outcome: route.outcome, selected_edges: route.selected_edges.clone(),\n        })).collect::<Result<_, AgentdError>>()?;\n        let task_files = self.files.open_original(files)?;\n        let clock = original_task_clock(context)?;\n        files.require_original_context()?;\n        Ok(OriginalSameActorATaskInputsV1 {\n            files: task_files, fence, circuit: self.circuit.clone(), routes,\n            worker_generation: self.worker_generation,\n            maximum_cell_records: self.maximum_cell_records,\n            queue_capacity: self.queue_capacity, clock,\n        })\n    }\n}\n\npub(super) fn original_task_clock(\n    context: &Arc<OriginalSameActorRootContext>,\n) -> Result<Arc<dyn Fn() -> CircuitCellTimeV1 + Send + Sync>, AgentdError> {\n    OriginalSameActorRootContext::require_current(context)?;\n    let clock = context.clock();\n    let gate = Arc::clone(context.gate());\n    clock.now_unix_ms().map_err(deployment_error)?;\n    crate::root_observation_cache::boottime_ns().map_err(deployment_error)?;\n    Ok(Arc::new(move || {\n        let sampled = (|| {\n            gate.require_open()?;\n            let circuit_millis = clock.now_unix_ms().map_err(deployment_error)?;\n            let cell_micros = crate::root_observation_cache::boottime_ns()\n                .map_err(deployment_error)? / 1_000;\n            gate.require_open()?;\n            Ok::<_, AgentdError>(CircuitCellTimeV1 { circuit_millis, cell_micros })\n        })();\n        match sampled {\n            Ok(time) => time,\n            Err(_) => {\n                gate.close();\n                // This original callback cannot return an error. MAX denies\n                // every bounded dispatch deadline; it is never a clock value\n                // on which this now-closed phase can authorize publication.\n                CircuitCellTimeV1 { circuit_millis: u64::MAX, cell_micros: u64::MAX }\n            }\n        }\n    }))\n}\n"
        }
      ]
    },
    {
      "key": "c_materials_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_c.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_c.rs",
        "blob": "c84cc17c5792c7f10a11c62d4de3836ee5addbc3",
        "bytes": 5701,
        "sha256": "461c1ee34b25de45cc7bfd5cbc42b47c3810e2cf71a1964b16afebfb93203d8b",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Concrete same-actor C files, still admitted by the original Root CURRENT,\n//! selected bundle and FinalUse owners. This is not an independent-C contract.\n\nuse std::sync::Arc;\nuse codex_hepta_learning_artifacts::SignedArtifactSelectionV1;\nuse codex_hepta_neuron::FileAnchorWitnessStore;\nuse serde::{Deserialize, Serialize};\nuse crate::{AgentdError, AgentdGenerationUpdateTargetV1, CircuitQ24TaskOpenModeV1,\n    LoadedCellQ24ModelV1, OriginalQ24SuccessorExecutionInputsV1, OriginalQ24SuccessorFeedbackV1};\nuse crate::authority_host_runtime::{OriginalDeploymentObserverData, RootGenerationPublicationDeploymentV1};\nuse crate::root_production_inputs::same_actor_phase::OriginalSameActorRootContext;\nuse crate::same_actor_q24_phase::OriginalSameActorCInputsV1;\nuse super::cell_data::OriginalCellDefinitionData;\nuse super::files::{MutableFileData, OriginalDeploymentFiles};\nuse super::learning::OriginalDeploymentLearning;\nuse super::task::{OriginalCircuitData, OriginalInitialPredecessorFiles, OriginalTaskSourceData};\nuse super::witness::{OriginalWitnessData, require_fresh_original_file};\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub(super) enum OriginalCModelData { RetainedInitial, ActualTrainingCandidate }\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalCData {\n    pub journal: MutableFileData,\n    pub witness: OriginalWitnessData,\n    pub target: OriginalDeploymentObserverData,\n    pub definition: OriginalCellDefinitionData,\n    pub source: OriginalTaskSourceData,\n    pub model: OriginalCModelData,\n    pub execution: OriginalCircuitData,\n}\n\npub(super) struct OpenedOriginalC {\n    pub inputs: OriginalSameActorCInputsV1,\n    pub canonical_material: String,\n}\n\nimpl OriginalCData {\n    pub(super) fn open_original(\n        &self,\n        context: &Arc<OriginalSameActorRootContext>,\n        files: &mut OriginalDeploymentFiles,\n        resources: OriginalCResources<'_>,\n    ) -> Result<OpenedOriginalC, AgentdError> {\n        let OriginalCResources {\n            initial_model, trained_model, predecessor, learning, selection, capacity, now,\n        } = resources;\n        OriginalSameActorRootContext::require_current(context)?;\n        require_fresh_original_file(&self.journal)?;\n        require_fresh_original_file(&self.witness.file)?;\n        if self.execution.queue_capacity != capacity {\n            return Err(deployment_refused(\"actual C capacity differs from its original pending slot\"));\n        }\n        let model = match self.model {\n            OriginalCModelData::RetainedInitial => Arc::clone(initial_model),\n            OriginalCModelData::ActualTrainingCandidate => trained_model.cloned()\n                .ok_or_else(|| deployment_refused(\"there is no actual Training candidate model\"))?,\n        };\n        let observer = self.target.original_observer_config().map_err(deployment_error)?;\n        if observer.witness_scope.scope_digest.into_array() != self.witness.scope\n            || observer.witness_scope.objective_digest.into_array() != self.witness.objective\n            || observer.witness_generation.get() != self.witness.generation\n            || observer.witness_records != self.witness.maximum_records\n        {\n            return Err(deployment_refused(\"C observer and actual witness configuration differ\"));\n        }\n        // Encode only the actual input data. Root checks its separately\n        // approved material, actual files, signature and source independently.\n        let material = RootGenerationPublicationDeploymentV1::encode_original_material(\n            &observer, selection,\n        ).map_err(deployment_error)?;\n        let canonical_material = String::from_utf8(material).map_err(deployment_error)?;\n        let file = files.open_original_owner(&self.journal)?;\n        let witness: FileAnchorWitnessStore = self.witness.open_original(files)?;\n        let target = AgentdGenerationUpdateTargetV1 {\n            file, witness, config: observer.generation, max_records: observer.journal_records,\n        };\n        let actual = self.execution.open_original(context, files)?;\n        let ledger = learning.open_original_c_task(files, now)?;\n        let predecessor = predecessor.reopen_original(files)?;\n        let inputs = OriginalSameActorCInputsV1 {\n            predecessor, target, definition: self.definition.original()?,\n            source: self.source.original()?, model,\n            execution: OriginalQ24SuccessorExecutionInputsV1 {\n                files: actual.files, source_mode: CircuitQ24TaskOpenModeV1::Create,\n                feedback: OriginalQ24SuccessorFeedbackV1::OriginalLedger(ledger),\n                fence: actual.fence, circuit: actual.circuit, routes: actual.routes,\n                worker_generation: actual.worker_generation,\n                maximum_cell_records: actual.maximum_cell_records, clock: actual.clock,\n            },\n        };\n        OriginalSameActorRootContext::require_current(context)?;\n        Ok(OpenedOriginalC { inputs, canonical_material })\n    }\n}\n\n/// Only the concrete coordinator supplies these actual owned inputs after\n/// the controller has observed the independent Selection. Nothing here is a\n/// normal-retirement capability or permission to restart the old A.\npub(super) struct OriginalCResources<'a> {\n    pub initial_model: &'a Arc<LoadedCellQ24ModelV1>,\n    pub trained_model: Option<&'a Arc<LoadedCellQ24ModelV1>>,\n    pub predecessor: OriginalInitialPredecessorFiles,\n    pub learning: &'a OriginalDeploymentLearning,\n    pub selection: &'a SignedArtifactSelectionV1,\n    pub capacity: usize,\n    pub now: u64,\n}\n"
        }
      ]
    },
    {
      "key": "artifact_data_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_artifact_data.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_artifact_data.rs",
        "blob": "7c6909e197b4410a6dc55bead2c206a8d1ce28a1",
        "bytes": 5412,
        "sha256": "2cf926f01cacc7a7369a25e8552df2d398e7e8c22fe3c03646e614b4d398907d",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Supplied Artifact writer leases and manifests are data, not admission.\n//! The existing signature verifier and withdrawal-bound admission consume the\n//! exact original values; no key, lease, generation or predecessor is invented.\n\nuse codex_hepta_learning_artifacts::{\n    ArtifactKind, LearningArtifactManifestV2, ProvenanceModeV1, SignedArtifactWriterLeaseV1,\n};\nuse codex_hepta_types::{Digest32, Generation, StableId};\nuse serde::{Deserialize, Serialize};\nuse crate::AgentdError;\nuse super::learning_data::required_option;\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalArtifactWriterData {\n    pub lease_id: String,\n    pub producer_id: String,\n    pub registry_id: String,\n    pub withdrawal_scope_digest: [u8; 32],\n    pub signer_id: String,\n    pub signing_key_digest: [u8; 32],\n    pub authority_epoch: u64,\n    pub lease_generation: u64,\n    pub issued_at: u64,\n    pub expires_at: u64,\n    pub signature: Vec<u8>,\n}\n\nimpl OriginalArtifactWriterData {\n    pub(super) fn original(&self) -> Result<SignedArtifactWriterLeaseV1, AgentdError> {\n        Ok(SignedArtifactWriterLeaseV1 {\n            lease_id: StableId::new(&self.lease_id).map_err(deployment_error)?,\n            producer_id: StableId::new(&self.producer_id).map_err(deployment_error)?,\n            registry_id: StableId::new(&self.registry_id).map_err(deployment_error)?,\n            withdrawal_scope_digest: Digest32::from_array(self.withdrawal_scope_digest),\n            signer_id: StableId::new(&self.signer_id).map_err(deployment_error)?,\n            signing_key_digest: Digest32::from_array(self.signing_key_digest),\n            authority_epoch: self.authority_epoch, lease_generation: self.lease_generation,\n            issued_at: self.issued_at, expires_at: self.expires_at,\n            signature: self.signature.as_slice().try_into()\n                .map_err(|_| deployment_refused(\"original Artifact lease signature must have 64 bytes\"))?,\n        })\n    }\n}\n\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub(super) enum OriginalArtifactKindData { Model }\n\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub(super) enum OriginalArtifactProvenanceData { DatasetDerived, DatasetIndependent }\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalArtifactManifestData {\n    pub artifact_id: String,\n    pub kind: OriginalArtifactKindData,\n    pub generation: u64,\n    pub provenance_mode: OriginalArtifactProvenanceData,\n    pub source_dataset_digests: Vec<[u8; 32]>,\n    pub lineage_digests: Vec<[u8; 32]>,\n    pub predecessor_ids: Vec<String>,\n    #[serde(deserialize_with = \"required_option\")]\n    pub rollback_predecessor: Option<String>,\n    pub bytes_digest: [u8; 32],\n    pub encoded_size_bytes: u64,\n    pub training_code_digest: [u8; 32],\n    pub runtime_tuple_digest: [u8; 32],\n    pub device_profile_digest: [u8; 32],\n    pub objective_class_digest: [u8; 32],\n    pub compatibility_digest: [u8; 32],\n    pub schema_profile_digest: [u8; 32],\n    pub normalization_digest: [u8; 32],\n    pub producer_id: String,\n    pub created_at: u64,\n    pub expires_at: u64,\n}\n\nimpl OriginalArtifactManifestData {\n    pub(super) fn original(&self) -> Result<LearningArtifactManifestV2, AgentdError> {\n        Ok(LearningArtifactManifestV2 {\n            artifact_id: StableId::new(&self.artifact_id).map_err(deployment_error)?,\n            kind: match self.kind { OriginalArtifactKindData::Model => ArtifactKind::Model },\n            generation: Generation::new(self.generation).map_err(deployment_error)?,\n            provenance_mode: match self.provenance_mode {\n                OriginalArtifactProvenanceData::DatasetDerived => ProvenanceModeV1::DatasetDerived,\n                OriginalArtifactProvenanceData::DatasetIndependent => ProvenanceModeV1::DatasetIndependent,\n            },\n            source_dataset_digests: self.source_dataset_digests.iter().copied().map(Digest32::from_array).collect(),\n            lineage_digests: self.lineage_digests.iter().copied().map(Digest32::from_array).collect(),\n            predecessor_ids: self.predecessor_ids.iter().map(StableId::new)\n                .collect::<Result<_, _>>().map_err(deployment_error)?,\n            rollback_predecessor: self.rollback_predecessor.as_ref().map(StableId::new)\n                .transpose().map_err(deployment_error)?,\n            bytes_digest: Digest32::from_array(self.bytes_digest),\n            encoded_size_bytes: self.encoded_size_bytes,\n            training_code_digest: Digest32::from_array(self.training_code_digest),\n            runtime_tuple_digest: Digest32::from_array(self.runtime_tuple_digest),\n            device_profile_digest: Digest32::from_array(self.device_profile_digest),\n            objective_class_digest: Digest32::from_array(self.objective_class_digest),\n            compatibility_digest: Digest32::from_array(self.compatibility_digest),\n            schema_profile_digest: Digest32::from_array(self.schema_profile_digest),\n            normalization_digest: Digest32::from_array(self.normalization_digest),\n            producer_id: StableId::new(&self.producer_id).map_err(deployment_error)?,\n            created_at: self.created_at, expires_at: self.expires_at,\n        })\n    }\n}\n"
        }
      ]
    },
    {
      "key": "artifacts_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_artifacts.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_artifacts.rs",
        "blob": "1f295958468344bfc99e71b3830a37dff0a3d5c4",
        "bytes": 10940,
        "sha256": "187a478cd60ca4a70eff05e7a543811dcdc29a299c6295983139f52f44545287",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Actual Artifact owner, existing CURRENT floor and independent selection.\n//! The descriptor supplies original signed material. None of these loaders\n//! signs a head or treats an untrusted local snapshot as an independent floor.\n\nuse std::path::PathBuf;\nuse std::sync::{Arc, Mutex};\nuse codex_hepta_learning_artifacts::{\n    ArtifactSelectionVerifierV1, DatasetWithdrawalSnapshotReceiptV1,\n    LearningArtifactOwnerService, LearningArtifactOwnerServiceConfigV1,\n    LearningArtifactPublishRequestV1, SignedArtifactSelectionV1,\n    admit_manifest_at_withdrawal_head_v3, read_dataset_withdrawal_snapshot,\n};\nuse codex_hepta_types::{Digest32, StableId};\nuse serde::{Deserialize, Serialize};\nuse crate::{AgentdError, AgentdGenerationSelectionFilesV1, AgentdSelectedGenerationV1,\n    OriginalCellQ24SelectionInputsV1};\nuse crate::authority_host_runtime::{\n    OriginalDeploymentCurrentData, OriginalDeploymentOwnerTrustData,\n    OriginalDeploymentSelectionData, OriginalDeploymentSelectorTrustData,\n    OriginalDeploymentWithdrawalData,\n};\nuse crate::same_actor_q24_phase::OriginalSameActorArtifactInputsV1;\nuse super::artifact_data::{OriginalArtifactManifestData, OriginalArtifactWriterData};\nuse super::files::{OriginalDeploymentFiles, OriginalDirectoryPin, OriginalPinnedRead, PinnedFileData};\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalSelectionData {\n    pub signed: OriginalDeploymentSelectionData,\n    pub registry_snapshot: PinnedFileData,\n    pub payload: PinnedFileData,\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalArtifactOwnerData {\n    pub root: PathBuf,\n    pub trust: OriginalDeploymentOwnerTrustData,\n    pub writer_lease: OriginalArtifactWriterData,\n    // This is mandatory original Root-approved history. It is never inferred\n    // from the files which are being opened and cannot silently become None.\n    pub required_current_head: OriginalDeploymentCurrentData,\n    pub withdrawal_file: PinnedFileData,\n    pub withdrawal: OriginalDeploymentWithdrawalData,\n    pub storage_binding: [u8; 32],\n    pub selector: OriginalDeploymentSelectorTrustData,\n    pub initial_selection: OriginalSelectionData,\n}\n\n/// The exact path/inode pins are retained for as long as this concrete\n/// coordinator can operate its original path-based Artifact owner.\npub(super) struct OriginalDeploymentArtifacts {\n    owner: Arc<Mutex<LearningArtifactOwnerService>>,\n    verifier: ArtifactSelectionVerifierV1,\n    directories: Vec<OriginalDirectoryPin>,\n    lock: OriginalPinnedRead,\n}\n\nimpl OriginalDeploymentArtifacts {\n    pub(super) fn open_original(\n        data: &OriginalArtifactOwnerData,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<(Self, AgentdSelectedGenerationV1), AgentdError> {\n        // All named directories and the actual writer lock must already\n        // exist. The original owner's creation fallback is not enrollment.\n        let mut directories = vec![files.pin_original_owner_directory(&data.root)?];\n        for name in [\"writer\", \"transactions\", \"payloads\", \"registries\", \"witnesses\", \"heads\"] {\n            directories.push(files.pin_original_owner_directory(&data.root.join(name))?);\n        }\n        let lock = files.pin_original_artifact_lock(&data.root.join(\"writer/owner.lock\"))?;\n        let withdrawal_file = files.read_original(&data.withdrawal_file, 16 * 1024 * 1024)?;\n        let withdrawal_registry = read_dataset_withdrawal_snapshot(\n            withdrawal_file.clone_original_file()?,\n            DatasetWithdrawalSnapshotReceiptV1 {\n                binding: Digest32::from_array(data.withdrawal.binding),\n                scope_digest: Digest32::from_array(data.withdrawal.scope),\n                head_digest: Digest32::from_array(data.withdrawal.head),\n                file_digest: Digest32::from_array(data.withdrawal.file_digest),\n                records: data.withdrawal.records, encoded_bytes: data.withdrawal.encoded_bytes,\n            },\n        ).map_err(deployment_error)?;\n        withdrawal_file.require_original_pin()?;\n        let trust = data.trust.original_owner_trust().map_err(deployment_error)?;\n        let verifier = data.selector.original_selector(&trust).map_err(deployment_error)?;\n        let writer_lease = data.writer_lease.original()?;\n        let current = data.required_current_head.original_current().map_err(deployment_error)?;\n        files.require_original_context()?;\n        let owner = LearningArtifactOwnerService::open(LearningArtifactOwnerServiceConfigV1 {\n            root: data.root.clone(), trust, writer_lease,\n            required_current_head: Some(current), withdrawal_registry,\n            storage_binding: Digest32::from_array(data.storage_binding), now,\n        }).map_err(deployment_error)?;\n        if owner.recovery_required().is_some() {\n            return Err(deployment_refused(\"original Artifact operation is not terminal\"));\n        }\n        for directory in &directories { directory.require_original_pin()?; }\n        lock.require_original_pin()?;\n        files.require_original_context()?;\n        let material = data.initial_selection.open_original(files, &verifier)?;\n        let selected = AgentdSelectedGenerationV1::load(\n            &owner, material.verifier, material.signed, material.files, now,\n        )?;\n        files.require_original_context()?;\n        Ok((Self { owner: Arc::new(Mutex::new(owner)), verifier, directories, lock }, selected))\n    }\n\n    pub(super) fn owner(&self) -> &Arc<Mutex<LearningArtifactOwnerService>> { &self.owner }\n\n    pub(super) fn require_original_paths(&self) -> Result<(), AgentdError> {\n        for directory in &self.directories { directory.require_original_pin()?; }\n        self.lock.require_original_pin()\n    }\n\n    pub(super) fn open_original_selection(\n        &self,\n        data: &OriginalSelectionData,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<(OriginalCellQ24SelectionInputsV1, Digest32), AgentdError> {\n        self.require_original_paths()?;\n        let validation = data.open_original(files, &self.verifier)?;\n        let owner = self.owner.lock()\n            .map_err(|_| deployment_refused(\"original Artifact owner mutex is poisoned\"))?;\n        files.require_original_context()?;\n        let selected = AgentdSelectedGenerationV1::load(\n            &owner, validation.verifier, validation.signed, validation.files, now,\n        )?;\n        let expected = selected.observation().digest();\n        drop(owner);\n        // These immutable reads reuse only an unchanged actual inode/hash.\n        // The controller consumes its own opened files and authenticates again.\n        let selection = data.open_original(files, &self.verifier)?;\n        self.require_original_paths()?;\n        files.require_original_context()?;\n        Ok((selection, expected))\n    }\n\n    pub(super) fn original_artifact_command(\n        &self,\n        data: &OriginalArtifactDecisionData,\n        files: &mut OriginalDeploymentFiles,\n        now: u64,\n    ) -> Result<OriginalSameActorArtifactInputsV1, AgentdError> {\n        self.require_original_paths()?;\n        files.require_original_context()?;\n        match data {\n            OriginalArtifactDecisionData::RetainOriginal => {\n                // The actual owner must still authenticate its exact\n                // NoUpdate/Retain/Defer decision. This data cannot select one.\n                Ok(OriginalSameActorArtifactInputsV1::RetainOriginal)\n            }\n            OriginalArtifactDecisionData::PublishQualified(data) => {\n                let payload = files.read_original(&data.payload, 16 * 1024 * 1024)?;\n                let manifest = data.manifest.original()?;\n                let owner = self.owner.lock().map_err(|_| deployment_refused(\"original Artifact owner mutex is poisoned\"))?;\n                files.require_original_context()?;\n                self.require_original_paths()?;\n                let admission = admit_manifest_at_withdrawal_head_v3(\n                    owner.withdrawal_registry(),\n                    Digest32::from_array(data.expected_withdrawal_head),\n                    manifest, now,\n                ).map_err(deployment_error)?;\n                let request = LearningArtifactPublishRequestV1 {\n                    operation_id: StableId::new(&data.operation_id).map_err(deployment_error)?,\n                    admission, payload: payload.bytes().to_vec(),\n                    signed_current_head: data.signed_current_head.original_current()\n                        .map_err(deployment_error)?,\n                    expected_registry_predecessor_head: Digest32::from_array(data.expected_registry_predecessor_head),\n                    now,\n                };\n                payload.require_original_pin()?;\n                files.require_original_context()?;\n                drop(owner);\n                // Actual publication subsequently reacquires its original\n                // writer and checks this exact withdrawal/current frontier.\n                Ok(OriginalSameActorArtifactInputsV1::PublishQualified(Box::new(request)))\n            }\n        }\n    }\n}\n\nimpl OriginalSelectionData {\n    pub(super) fn original_signed(&self) -> Result<SignedArtifactSelectionV1, AgentdError> {\n        self.signed.original_selection().map_err(deployment_error)\n    }\n\n    fn open_original(\n        &self,\n        files: &mut OriginalDeploymentFiles,\n        verifier: &ArtifactSelectionVerifierV1,\n    ) -> Result<OriginalCellQ24SelectionInputsV1, AgentdError> {\n        let registry = files.read_original(&self.registry_snapshot, 16 * 1024 * 1024)?;\n        let payload = files.read_original(&self.payload, 16 * 1024 * 1024)?;\n        let result = OriginalCellQ24SelectionInputsV1 {\n            verifier: verifier.clone(), signed: self.original_signed()?,\n            files: AgentdGenerationSelectionFilesV1 {\n                registry_snapshot: registry.clone_original_file()?,\n                payload: payload.clone_original_file()?,\n            },\n        };\n        registry.require_original_pin()?;\n        payload.require_original_pin()?;\n        files.require_original_context()?;\n        Ok(result)\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(tag = \"kind\", rename_all = \"snake_case\", deny_unknown_fields)]\npub(super) enum OriginalArtifactDecisionData {\n    RetainOriginal,\n    PublishQualified(Box<OriginalArtifactPublicationData>),\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalArtifactPublicationData {\n    pub operation_id: String,\n    pub manifest: OriginalArtifactManifestData,\n    pub payload: PinnedFileData,\n    pub signed_current_head: OriginalDeploymentCurrentData,\n    pub expected_withdrawal_head: [u8; 32],\n    pub expected_registry_predecessor_head: [u8; 32],\n}\n"
        }
      ]
    },
    {
      "key": "exchange_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_exchange.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_exchange.rs",
        "blob": "801620ea5ba7fee5ca88bff214acfce10296a393",
        "bytes": 6852,
        "sha256": "b2acd367a31c02ae09e4b418af0c5100301de42ac170050055b165b235bb39d5",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! One-shot data exchange with an independently operated original actor.\n//! A missing response may wait inside the SAME operation. No authority call,\n//! nonce, signing request or failed result is resubmitted by this adapter.\n\nuse std::io::Write;\nuse std::path::PathBuf;\nuse std::sync::Arc;\nuse std::time::Duration;\n\nuse codex_hepta_types::Digest32;\nuse serde::{Deserialize, Serialize};\n\nuse crate::{AgentdError, CellQ24PreparedLearningV1};\nuse crate::root_production_inputs::same_actor_phase::OriginalSameActorRootContext;\n\nuse super::files::{MutableFileData, OriginalDeploymentFiles, OriginalFileMode, OriginalPinnedRead};\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalActorExchangeData {\n    pub request: MutableFileData,\n    pub response: PathBuf,\n}\n\n/// Captures the actual request's ORIGINAL absolute business expiry. This is\n/// independent of the two original phase bounds; no Duration starts a new end.\npub(super) struct OriginalActorWait {\n    context: Arc<OriginalSameActorRootContext>,\n    business_expiry_unix_seconds: u64,\n    last_unix_seconds: u64,\n}\n\nimpl OriginalActorWait {\n    pub(super) fn for_original_prepared(\n        context: Arc<OriginalSameActorRootContext>,\n        prepared: &CellQ24PreparedLearningV1,\n    ) -> Result<Self, AgentdError> {\n        OriginalSameActorRootContext::require_current(&context)?;\n        prepared.revalidate_source().map_err(deployment_error)?;\n        let business_expiry_unix_seconds =\n            prepared.initial().request.envelope.expiry_unix_seconds;\n        let last_unix_seconds = context.clock().now_unix_ms()\n            .map_err(deployment_error)? / 1_000;\n        if business_expiry_unix_seconds <= last_unix_seconds {\n            return Err(deployment_refused(\"original signing business deadline has elapsed\"));\n        }\n        let mut wait = Self { context, business_expiry_unix_seconds, last_unix_seconds };\n        wait.require_original_live()?;\n        Ok(wait)\n    }\n\n    /// Ordinary Outcome/Selection handoff also uses the already approved\n    /// absolute task expiry, never a deadline based on this later wait.\n    pub(super) fn for_original_task(\n        context: Arc<OriginalSameActorRootContext>,\n        original_expiry_unix_seconds: u64,\n    ) -> Result<Self, AgentdError> {\n        OriginalSameActorRootContext::require_current(&context)?;\n        let last_unix_seconds = context.clock().now_unix_ms()\n            .map_err(deployment_error)? / 1_000;\n        let mut wait = Self {\n            context, business_expiry_unix_seconds: original_expiry_unix_seconds,\n            last_unix_seconds,\n        };\n        wait.require_original_live()?;\n        Ok(wait)\n    }\n\n    pub(super) fn require_original_live(&mut self) -> Result<u64, AgentdError> {\n        OriginalSameActorRootContext::require_current(&self.context)?;\n        let now = self.context.clock().now_unix_ms().map_err(deployment_error)? / 1_000;\n        if now < self.last_unix_seconds || now >= self.business_expiry_unix_seconds {\n            return Err(deployment_refused(\"original actor deadline expired or clock regressed\"));\n        }\n        self.last_unix_seconds = now;\n        OriginalSameActorRootContext::require_current(&self.context)?;\n        Ok(now)\n    }\n\n    pub(super) fn wait_original_file(\n        &mut self,\n        files: &mut OriginalDeploymentFiles,\n        path: &std::path::Path,\n        maximum: usize,\n    ) -> Result<OriginalPinnedRead, AgentdError> {\n        loop {\n            self.require_original_live()?;\n            match std::fs::symlink_metadata(path) {\n                Ok(_) => {\n                    // The first visible response is read exactly once. An\n                    // empty, partial, changed, unauthorized or invalid file is\n                    // an error, never a reason to wait for a replacement.\n                    let read = files.read_original_stage(path, maximum)?;\n                    self.require_original_live()?;\n                    return Ok(read);\n                }\n                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}\n                Err(error) => return Err(error.into()),\n            }\n            // This concrete coordinator has a retained std::thread owner.\n            // Waiting does not hold a Root request, owner mutex or Tokio worker.\n            // A late wake still checks the same absolute bounds before reading.\n            std::thread::park_timeout(Duration::from_millis(5));\n        }\n    }\n}\n\n/// Deliberately not Clone. Taking this object consumes its one request path\n/// even if write, sync, waiting or parsing fails. The durable owner which made\n/// the original request retains Pending/uncertain state on that failure.\npub(super) struct OriginalActorExchange {\n    data: OriginalActorExchangeData,\n}\n\nimpl OriginalActorExchange {\n    pub(super) fn new(data: OriginalActorExchangeData) -> Result<Self, AgentdError> {\n        if !matches!(data.request.mode, OriginalFileMode::CreateNew)\n            || data.request.path == data.response\n        {\n            return Err(deployment_refused(\"original actor exchange requires a fresh request path\"));\n        }\n        Ok(Self { data })\n    }\n\n    pub(super) fn exchange_original<T: Serialize>(\n        self,\n        request: &T,\n        files: &mut OriginalDeploymentFiles,\n        wait: &mut OriginalActorWait,\n    ) -> Result<(Digest32, OriginalPinnedRead), AgentdError> {\n        wait.require_original_live()?;\n        let bytes = serde_json::to_vec(request).map_err(deployment_error)?;\n        if bytes.is_empty() || bytes.len() > 1024 * 1024 {\n            return Err(deployment_refused(\"original signing request exceeds its data bound\"));\n        }\n        // A response already at this unique original path is not a reply to\n        // the request we have yet to publish. Never adopt a precomputed reply.\n        match std::fs::symlink_metadata(&self.data.response) {\n            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}\n            Ok(_) => return Err(deployment_refused(\"original response path already exists\")),\n            Err(error) => return Err(error.into()),\n        }\n        let (mut file, directory) =\n            files.open_original_owner_with_directory(&self.data.request)?;\n        wait.require_original_live()?;\n        file.write_all(&bytes)?;\n        file.sync_all()?;\n        directory.sync_all()?;\n        wait.require_original_live()?;\n        // The external original actor must publish a complete response once,\n        // e.g. by an atomic rename after syncing its own private temporary file.\n        let response = wait.wait_original_file(files, &self.data.response, 1024 * 1024)?;\n        wait.require_original_live()?;\n        Ok((Digest32::of_bytes(&bytes), response))\n    }\n}\n"
        }
      ]
    },
