a::Ips => ProductMetricSourceV1::Ips,\n                    OriginalMetricSourceData::Snips => ProductMetricSourceV1::Snips,\n                    OriginalMetricSourceData::DoublyRobust => ProductMetricSourceV1::DoublyRobust,\n                },\n            });\n        }\n        let folds = self.folds.iter().map(|fold| Ok(CrossFoldPartitionV1 {\n            fold_id: StableId::new(&fold.fold_id).map_err(deployment_error)?,\n            training_principals: original_ids(&fold.training_principals)?,\n            training_episodes: original_ids(&fold.training_episodes)?,\n            training_windows: original_ids(&fold.training_windows)?,\n            holdout_principals: original_ids(&fold.holdout_principals)?,\n            holdout_episodes: original_ids(&fold.holdout_episodes)?,\n            holdout_windows: original_ids(&fold.holdout_windows)?,\n            model_digest: Digest32::from_array(fold.model_digest),\n            predictions_digest: Digest32::from_array(fold.predictions_digest),\n        })).collect::<Result<Vec<_>, AgentdError>>()?;\n        Ok(CellEvaluationRegistrationV1 {\n            product: CrossFoldPlanV1 {\n                plan_id: StableId::new(&self.plan_id).map_err(deployment_error)?,\n                claim_scope: EvaluationClaimScopeV1::Qualification,\n                candidate_id: StableId::new(&self.candidate_id).map_err(deployment_error)?,\n                baseline_id: StableId::new(&self.baseline_id).map_err(deployment_error)?,\n                objective_digest: Digest32::from_array(self.objective_digest),\n                dataset_digest: Digest32::from_array(self.dataset_digest),\n                estimand_digest: Digest32::from_array(self.estimand_digest),\n                metric_contracts: contracts, family_alpha_ppm: self.family_alpha_ppm,\n                simultaneous_comparisons: self.simultaneous_comparisons, folds,\n                final_holdout_window_id: StableId::new(&self.final_holdout_window_id)\n                    .map_err(deployment_error)?,\n                final_holdout_digest: Digest32::from_array(self.final_holdout_digest),\n            },\n            metric_roles: roles, metric_sources: sources,\n            comparison: self.comparison.original()?,\n        })\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalQualificationContextData {\n    pub generator: PrincipalData,\n    pub evaluator: PrincipalData,\n    pub retention_receipt_digests: Vec<[u8; 32]>,\n    pub unlearning_receipt_digest: [u8; 32],\n}\nimpl OriginalQualificationContextData {\n    pub(super) fn original(&self) -> Result<ProductQualificationContextV1, AgentdError> {\n        Ok(ProductQualificationContextV1 {\n            generator: self.generator.original()?,\n            evaluator: self.evaluator.original()?,\n            retention_receipt_digests: self.retention_receipt_digests.iter()\n                .copied().map(Digest32::from_array).collect(),\n            unlearning_receipt_digest: Digest32::from_array(self.unlearning_receipt_digest),\n        })\n    }\n}\nfn original_ids(data: &[String]) -> Result<Vec<StableId>, AgentdError> {\n    data.iter().map(|value| StableId::new(value).map_err(deployment_error)).collect()\n}\n"
        }
      ]
    },
    {
      "key": "eval_signing_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation_signing.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation_signing.rs",
        "blob": "595ac3b2a66468e222794e7f539873bbb88a6462",
        "bytes": 8102,
        "sha256": "74e80f2223b5708f9290f35ead95393978c0e1d82c796238d0370fd971be0608",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Concrete transport for the original evaluator's one signing operation.\n//! The independent actor receives only the exact original request data. The\n//! original Product runner authenticates its response before completing its\n//! already durable execution claim; this adapter never signs an execution.\n\nuse std::sync::Arc;\n\nuse codex_hepta_intelligence_eval::{\n    ProductEvaluationExecutionAttestationRequestV1, ProductEvaluationExecutionAttestorV1,\n    ProductEvaluationExecutionKeyV1, ProductProviderErrorV1, SignedEvaluationEvidenceV1,\n};\nuse codex_hepta_learning_ledger::SignedLearningEvidenceV1;\nuse codex_hepta_types::Digest32;\nuse serde::{Deserialize, Serialize};\n\nuse crate::{AgentdError, CellEvaluationPlanV1, CellQ24PreparedLearningV1};\nuse crate::root_production_inputs::same_actor_phase::OriginalSameActorRootContext;\n\nuse super::exchange::{OriginalActorExchange, OriginalActorExchangeData, OriginalActorWait};\nuse super::files::OriginalDeploymentFiles;\nuse super::learning_data::SignedEvidenceData;\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Serialize)]\n#[serde(deny_unknown_fields)]\nstruct OriginalExecutionSigningData<'a> {\n    schema_version: u32,\n    purpose: &'static str,\n    phase: &'a str,\n    learning_operation: &'a str,\n    plan_id: &'a str,\n    execution_binding: [u8; 32],\n    execution_digest: [u8; 32],\n    payload: &'a [u8],\n}\n#[derive(Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\nstruct OriginalExecutionResponseData {\n    schema_version: u32,\n    request_digest: [u8; 32],\n    execution_digest: [u8; 32],\n    signed: SignedEvidenceData,\n}\n\npub(super) struct OriginalExecutionAttestor<'a> {\n    context: Arc<OriginalSameActorRootContext>,\n    prepared: &'a CellQ24PreparedLearningV1,\n    expected: ProductEvaluationExecutionKeyV1,\n    exchange: Option<OriginalActorExchange>,\n    files: &'a mut OriginalDeploymentFiles,\n    wait: &'a mut OriginalActorWait,\n    failure: Option<AgentdError>,\n}\n\nimpl<'a> OriginalExecutionAttestor<'a> {\n    pub(super) fn new(\n        context: Arc<OriginalSameActorRootContext>,\n        prepared: &'a CellQ24PreparedLearningV1,\n        expected: ProductEvaluationExecutionKeyV1,\n        exchange: OriginalActorExchangeData,\n        files: &'a mut OriginalDeploymentFiles,\n        wait: &'a mut OriginalActorWait,\n    ) -> Result<Self, AgentdError> {\n        OriginalSameActorRootContext::require_current(&context)?;\n        prepared.revalidate_source().map_err(deployment_error)?;\n        Ok(Self {\n            context, prepared, expected,\n            exchange: Some(OriginalActorExchange::new(exchange)?),\n            files, wait, failure: None,\n        })\n    }\n\n    pub(super) fn take_original_failure(&mut self) -> Option<AgentdError> {\n        self.failure.take()\n    }\n\n    fn exchange_original_request(\n        &mut self,\n        request: &ProductEvaluationExecutionAttestationRequestV1<'_>,\n    ) -> Result<SignedLearningEvidenceV1, AgentdError> {\n        self.wait.require_original_live()?;\n        if request.key() != &self.expected {\n            return Err(deployment_refused(\"actual evaluator request differs from its original key\"));\n        }\n        let exchange = self.exchange.take()\n            .ok_or_else(|| deployment_refused(\"original evaluator operation already consumed\"))?;\n        let raw = OriginalExecutionSigningData {\n            schema_version: 1,\n            purpose: \"hepta.same-actor-q24-deployment.execution-signing.v1\",\n            phase: &self.context.descriptor().phase,\n            learning_operation: self.prepared.initial().request.operation_id.as_str(),\n            plan_id: request.key().plan_id.as_str(),\n            execution_binding: request.key().binding_digest.into_array(),\n            execution_digest: request.execution().execution_digest.into_array(),\n            payload: request.signing_payload(),\n        };\n        let (digest, response) = exchange.exchange_original(&raw, self.files, self.wait)?;\n        let signed: OriginalExecutionResponseData = response.parse_original()?;\n        if signed.schema_version != 1\n            || signed.request_digest != digest.into_array()\n            || signed.execution_digest != raw.execution_digest\n        {\n            return Err(deployment_refused(\"original evaluator response binding differs\"));\n        }\n        let evidence = signed.signed.original()?;\n        response.require_original_pin()?;\n        self.wait.require_original_live()?;\n        // Signature, role, full principal and objective authentication remains\n        // in Product::authenticate immediately after this exact trait return.\n        Ok(evidence)\n    }\n}\n\nimpl ProductEvaluationExecutionAttestorV1 for OriginalExecutionAttestor<'_> {\n    fn attest_execution(\n        &mut self,\n        request: &ProductEvaluationExecutionAttestationRequestV1<'_>,\n    ) -> Result<SignedLearningEvidenceV1, ProductProviderErrorV1> {\n        match self.exchange_original_request(request) {\n            Ok(signed) => Ok(signed),\n            Err(error) => {\n                self.failure = Some(error);\n                // Actual execution was already claimed and performed. A\n                // missing/failed external reply is never \"not executed\".\n                Err(ProductProviderErrorV1::Indeterminate)\n            }\n        }\n    }\n}\n\n#[derive(Serialize)]\n#[serde(deny_unknown_fields)]\nstruct OriginalQualificationSigningData<'a> {\n    schema_version: u32,\n    purpose: &'static str,\n    phase: &'a str,\n    learning_operation: &'a str,\n    execution_digest: [u8; 32],\n    frozen_plan_digest: [u8; 32],\n    generator_payload: &'a [u8],\n    evaluator_payload: &'a [u8],\n    actual_cell_record: serde_json::Value,\n}\n#[derive(Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\nstruct OriginalQualificationResponseData {\n    schema_version: u32,\n    request_digest: [u8; 32],\n    execution_digest: [u8; 32],\n    generator_plan: SignedEvidenceData,\n    evaluator_bundle: SignedEvidenceData,\n}\n\n/// Called only after actual Cell evaluation returns a sealed receipt and the\n/// SAME runner builds its qualification bundle and canonical signing payload.\npub(super) struct OriginalQualificationSigningRequest<'a> {\n    pub context: &'a OriginalSameActorRootContext,\n    pub prepared: &'a CellQ24PreparedLearningV1,\n    pub plan: &'a CellEvaluationPlanV1,\n    pub execution_digest: Digest32,\n    pub evaluator_payload: &'a [u8],\n}\n\npub(super) fn request_original_qualification(\n    original: OriginalQualificationSigningRequest<'_>,\n    exchange: OriginalActorExchangeData,\n    files: &mut OriginalDeploymentFiles,\n    wait: &mut OriginalActorWait,\n) -> Result<SignedEvaluationEvidenceV1, AgentdError> {\n    wait.require_original_live()?;\n    let generator = original.plan.product_plan().frozen_plan.plan_digest;\n    let request = OriginalQualificationSigningData {\n        schema_version: 1,\n        purpose: \"hepta.same-actor-q24-deployment.qualification-signing.v1\",\n        phase: &original.context.descriptor().phase,\n        learning_operation: original.prepared.initial().request.operation_id.as_str(),\n        execution_digest: original.execution_digest.into_array(),\n        frozen_plan_digest: generator.into_array(),\n        generator_payload: generator.as_array(),\n        evaluator_payload: original.evaluator_payload,\n        actual_cell_record: serde_json::to_value(original.plan.record()).map_err(deployment_error)?,\n    };\n    let (digest, response) = OriginalActorExchange::new(exchange)?\n        .exchange_original(&request, files, wait)?;\n    let signed: OriginalQualificationResponseData = response.parse_original()?;\n    if signed.schema_version != 1 || signed.request_digest != digest.into_array()\n        || signed.execution_digest != request.execution_digest\n    {\n        return Err(deployment_refused(\"actual qualification response binding differs\"));\n    }\n    let evidence = SignedEvaluationEvidenceV1 {\n        generator_plan: signed.generator_plan.original()?,\n        evaluator_bundle: signed.evaluator_bundle.original()?,\n    };\n    response.require_original_pin()?;\n    wait.require_original_live()?;\n    Ok(evidence)\n}\n"
        }
      ]
    },
    {
      "key": "eval_storage_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation_storage.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation_storage.rs",
        "blob": "5ddacddb99924751d37ef72fc244150bccac3dc5",
        "bytes": 8157,
        "sha256": "ba344bdf7f66e02435542faeea3fa4a55f6aa29bb3f07ded03b2351e2c144ac9",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Concrete independent B storage. Existing owner journals never fall back to\n//! genesis, and every recovered durable store requires its external minimum.\n//! File identities remain distinct across source, witness, execution and sink.\n\nuse codex_hepta_intelligence_eval::{\n    FinalHoldoutCasAnchorV1, FencedFinalHoldoutOwnerV1, HoldoutWriterFenceV1,\n    LockedFileFinalHoldoutCasStoreV1, LockedFileProductEvaluationExecutionStoreV1,\n    LockedFileProductQualificationEvidenceSinkV1, ProductEvaluationExecutionAnchorV1,\n};\nuse codex_hepta_neuron::{CellGenerationJournalV2, FileAnchorWitnessStore};\nuse codex_hepta_types::{Digest32, StableId};\nuse serde::{Deserialize, Serialize};\nuse crate::AgentdError;\nuse crate::authority_host_runtime::OriginalDeploymentObserverData;\nuse super::files::{MutableFileData, OriginalDeploymentFiles, OriginalFileMode};\nuse super::learning_data::required_option;\nuse super::witness::OriginalWitnessData;\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalEvaluationJournalData {\n    pub journal: MutableFileData,\n    pub witness: OriginalWitnessData,\n    pub observer: OriginalDeploymentObserverData,\n}\nimpl OriginalEvaluationJournalData {\n    pub(super) fn open_original(\n        &self, files: &mut OriginalDeploymentFiles,\n    ) -> Result<CellGenerationJournalV2<FileAnchorWitnessStore>, AgentdError> {\n        if !matches!(self.journal.mode, OriginalFileMode::Recover)\n            || !matches!(self.witness.file.mode, OriginalFileMode::Recover)\n        {\n            return Err(deployment_refused(\"B requires actual existing experiment journals\"));\n        }\n        let observer = self.observer.original_observer_config().map_err(deployment_error)?;\n        if observer.witness_scope.scope_digest.into_array() != self.witness.scope\n            || observer.witness_scope.objective_digest.into_array() != self.witness.objective\n            || observer.witness_generation.get() != self.witness.generation\n            || observer.witness_records != self.witness.maximum_records\n        {\n            return Err(deployment_refused(\"B witness differs from its actual observer configuration\"));\n        }\n        let journal = files.open_original_owner(&self.journal)?;\n        let witness = self.witness.open_original(files)?;\n        files.require_original_context()?;\n        // Ordinary open rejects guarded CURRENT journals. No replacement\n        // current callback or precomputed proof is installed by this loader.\n        let original = CellGenerationJournalV2::open(\n            journal, witness, observer.generation, observer.journal_records,\n        ).map_err(deployment_error)?;\n        files.require_original_context()?;\n        Ok(original)\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalHoldoutMinimumData {\n    pub fence_generation: u64,\n    pub record_count: u64,\n    pub state_digest: [u8; 32],\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalHoldoutData {\n    pub file: MutableFileData,\n    pub binding: [u8; 32],\n    pub owner_id: String,\n    pub generation: u64,\n    pub lease_digest: [u8; 32],\n    #[serde(deserialize_with = \"required_option\")]\n    pub minimum: Option<OriginalHoldoutMinimumData>,\n}\nimpl OriginalHoldoutData {\n    pub(super) fn open_original(\n        &self, files: &mut OriginalDeploymentFiles,\n    ) -> Result<FencedFinalHoldoutOwnerV1<LockedFileFinalHoldoutCasStoreV1>, AgentdError> {\n        let binding = Digest32::from_array(self.binding);\n        // These are the real host-provided fence fields. No fence issuer,\n        // authority digest, lease, generation or minimum is synthesized here.\n        let fence = HoldoutWriterFenceV1 {\n            owner_id: StableId::new(&self.owner_id).map_err(deployment_error)?,\n            generation: self.generation,\n            lease_digest: Digest32::from_array(self.lease_digest),\n        };\n        let file = files.open_original_owner(&self.file)?;\n        files.require_original_context()?;\n        let original = match self.file.mode {\n            OriginalFileMode::Recover => {\n                let minimum = self.minimum.as_ref()\n                    .ok_or_else(|| deployment_refused(\"recovered holdout has no independent minimum\"))?;\n                let minimum = FinalHoldoutCasAnchorV1 {\n                    fence_generation: minimum.fence_generation,\n                    record_count: minimum.record_count,\n                    state_digest: Digest32::from_array(minimum.state_digest),\n                };\n                let store = LockedFileFinalHoldoutCasStoreV1::recover(file, binding, Some(minimum))\n                    .map_err(deployment_error)?;\n                files.require_original_context()?;\n                FencedFinalHoldoutOwnerV1::recover(store, binding, fence)\n            }\n            OriginalFileMode::CreateNew | OriginalFileMode::ExistingEmpty => {\n                if self.minimum.is_some() {\n                    return Err(deployment_refused(\"fresh holdout cannot discard an existing minimum\"));\n                }\n                let store = LockedFileFinalHoldoutCasStoreV1::create(file, binding)\n                    .map_err(deployment_error)?;\n                files.require_original_context()?;\n                FencedFinalHoldoutOwnerV1::initialize(store, binding, fence)\n            }\n        }.map_err(deployment_error)?;\n        files.require_original_context()?;\n        Ok(original)\n    }\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalExecutionMinimumData {\n    pub sequence: u64,\n    pub history_digest: [u8; 32],\n}\nimpl OriginalExecutionMinimumData {\n    fn original(&self) -> ProductEvaluationExecutionAnchorV1 {\n        ProductEvaluationExecutionAnchorV1 {\n            sequence: self.sequence,\n            history_digest: Digest32::from_array(self.history_digest),\n        }\n    }\n}\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalEvaluationStoreData {\n    pub file: MutableFileData,\n    pub binding: [u8; 32],\n    #[serde(deserialize_with = \"required_option\")]\n    pub minimum: Option<OriginalExecutionMinimumData>,\n}\nimpl OriginalEvaluationStoreData {\n    fn require_original_mode(&self) -> Result<(), AgentdError> {\n        if matches!(self.file.mode, OriginalFileMode::Recover) != self.minimum.is_some() {\n            return Err(deployment_refused(\"original evaluation store lifecycle/minimum differs\"));\n        }\n        Ok(())\n    }\n\n    pub(super) fn open_original_execution(\n        &self, files: &mut OriginalDeploymentFiles,\n    ) -> Result<LockedFileProductEvaluationExecutionStoreV1, AgentdError> {\n        self.require_original_mode()?;\n        let file = files.open_original_owner(&self.file)?;\n        let binding = Digest32::from_array(self.binding);\n        files.require_original_context()?;\n        let store = match &self.minimum {\n            Some(minimum) => LockedFileProductEvaluationExecutionStoreV1::recover(\n                file, binding, minimum.original(),\n            ),\n            None => LockedFileProductEvaluationExecutionStoreV1::create(file, binding),\n        }.map_err(deployment_error)?;\n        files.require_original_context()?;\n        Ok(store)\n    }\n\n    pub(super) fn open_original_sink(\n        &self, files: &mut OriginalDeploymentFiles,\n    ) -> Result<LockedFileProductQualificationEvidenceSinkV1, AgentdError> {\n        self.require_original_mode()?;\n        let file = files.open_original_owner(&self.file)?;\n        let binding = Digest32::from_array(self.binding);\n        files.require_original_context()?;\n        let sink = match &self.minimum {\n            Some(minimum) => LockedFileProductQualificationEvidenceSinkV1::recover(\n                file, binding, minimum.original(),\n            ),\n            None => LockedFileProductQualificationEvidenceSinkV1::create(file, binding),\n        }.map_err(deployment_error)?;\n        files.require_original_context()?;\n        Ok(sink)\n    }\n}\n"
        }
      ]
    },
    {
      "key": "evaluation_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_evaluation.rs",
        "blob": "821360eb2d4c0537e816ea4e2428a3d719a4c3d8",
        "bytes": 11392,
        "sha256": "ec16644c2ae391a25742e117efe2d8def4c12c53bbd915df086f28be2f3b8f06",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Actual independent B execution for the ordinary deployment.\n//! This runs the original Cell/Product estimator and qualification owners.\n//! Supplied files are inputs and signatures; no result receipt is decoded\n//! from host JSON or substituted for the actual runner's return value.\n\nuse std::sync::Arc;\n\nuse codex_hepta_intelligence_eval::{\n    LockedFileFinalHoldoutProviderV1, LockedFileProductQualificationEvidenceSinkV1,\n    ProductEvaluationExecutionRequestV1,\n    ProductEvaluationRunnerV1, ProductProviderErrorV1, ProductTimingEvidenceV1,\n    evaluation_signing_payload_v2, product_evaluation_execution_key_v1,\n};\nuse codex_hepta_learning_ledger::LearningEvidenceRoleV1;\nuse codex_hepta_types::Digest32;\nuse serde::{Deserialize, Serialize};\n\nuse crate::{\n    AgentdError, CellEvaluationJournalsV1, CellEvaluationQualificationRequestV1,\n    CellEvaluationRunnerV1, CellQ24PreparedLearningV1,\n    OriginalCellEvaluationSigningConfigV1, OriginalCellEvaluationTrainerV1,\n    OriginalCellQ24EvaluationInputsV1, OriginalCellQ24EvaluationTimingV1,\n    OriginalCellQ24LearningOpenV1, OriginalCellQ24TrainingReadbackV1,\n    freeze_cell_learning_evaluation_plan_v1,\n};\nuse crate::root_production_inputs::same_actor_phase::OriginalSameActorRootContext;\n\nuse super::evaluation_data::{OriginalEvaluationRegistrationData, OriginalQualificationContextData};\nuse super::evaluation_signing::{\n    OriginalExecutionAttestor, OriginalQualificationSigningRequest,\n    request_original_qualification,\n};\nuse super::evaluation_storage::{\n    OriginalEvaluationJournalData, OriginalEvaluationStoreData, OriginalHoldoutData,\n};\nuse super::exchange::{OriginalActorExchangeData, OriginalActorWait};\nuse super::files::{OriginalDeploymentFiles, PinnedFileData};\nuse super::learning::{OriginalDeploymentLearning, OriginalSignedOwnerFilesData};\nuse super::temporal_data::OriginalTemporalPlanData;\nuse super::witness::require_fresh_original_file;\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalEvaluationData {\n    pub registration: OriginalEvaluationRegistrationData,\n    pub candidate_journal: OriginalEvaluationJournalData,\n    pub fixed_expert_journal: OriginalEvaluationJournalData,\n    pub candidate_plan: OriginalTemporalPlanData,\n    pub baseline_plan: OriginalTemporalPlanData,\n    pub holdout_material: PinnedFileData,\n    pub holdout: OriginalHoldoutData,\n    pub executions: OriginalEvaluationStoreData,\n    pub evidence_store: OriginalEvaluationStoreData,\n    pub qualification_context: OriginalQualificationContextData,\n    pub execution_signing: OriginalActorExchangeData,\n    pub qualification_signing: OriginalActorExchangeData,\n    pub receipt: OriginalSignedOwnerFilesData,\n}\n\npub(super) struct OriginalExecutedEvaluation {\n    pub inputs: OriginalCellQ24EvaluationInputsV1,\n    /// Retained by the actual coordinator through its original phase cleanup.\n    /// A digest or qualification object is not a substitute for this owner.\n    pub evidence_owner: LockedFileProductQualificationEvidenceSinkV1,\n}\n\nimpl OriginalEvaluationData {\n    pub(super) fn execute_original(\n        &self,\n        context: &Arc<OriginalSameActorRootContext>,\n        prepared: &Arc<CellQ24PreparedLearningV1>,\n        trainer: OriginalCellQ24TrainingReadbackV1,\n        learning: &OriginalDeploymentLearning,\n        files: &mut OriginalDeploymentFiles,\n    ) -> Result<OriginalExecutedEvaluation, AgentdError> {\n        let mut wait = OriginalActorWait::for_original_prepared(\n            Arc::clone(context), prepared,\n        )?;\n        let qualification_context = self.qualification_context.original()?;\n        let now = wait.require_original_live()?;\n        let generator = learning.require_original_signer(\n            qualification_context.generator.principal_id.as_str(),\n            LearningEvidenceRoleV1::Generator, now,\n        )?;\n        let evaluator = learning.require_original_signer(\n            qualification_context.evaluator.principal_id.as_str(),\n            LearningEvidenceRoleV1::Evaluator, now,\n        )?;\n        if generator.principal != qualification_context.generator\n            || evaluator.principal != qualification_context.evaluator\n            || evaluator.principal.principal_id.as_str() != self.receipt.principal\n        {\n            return Err(deployment_refused(\"B principals differ from actual enrolled owners\"));\n        }\n        let candidate = self.candidate_journal.open_original(files)?;\n        let fixed_expert = self.fixed_expert_journal.open_original(files)?;\n        let candidate_plan = self.candidate_plan.original()?;\n        let baseline_plan = self.baseline_plan.original()?;\n        wait.require_original_live()?;\n        // The same actual Prepared request supplies this pre-training pin;\n        // a later B data file cannot replace its original evaluation protocol.\n        let plan = freeze_cell_learning_evaluation_plan_v1(\n            self.registration.original()?,\n            CellEvaluationJournalsV1 { candidate: &candidate, fixed_expert: &fixed_expert },\n            &candidate_plan, &baseline_plan, prepared.initial().request.evaluation_profile,\n        ).map_err(deployment_error)?;\n        let material = files.read_original(&self.holdout_material, 16 * 1024 * 1024)?;\n        wait.require_original_live()?;\n        let mut provider = LockedFileFinalHoldoutProviderV1::open(\n            material.clone_original_file()?, plan.product_plan(),\n        ).map_err(deployment_error)?;\n        material.require_original_pin()?;\n        let holdout = self.holdout.open_original(files)?;\n        let mut executions = self.executions.open_original_execution(files)?;\n        // Its separate original namespace and distinct actual File are\n        // checked by the sink itself and the loader's inode custody.\n        let mut sink = self.evidence_store.open_original_sink(files)?;\n        let mut runner = CellEvaluationRunnerV1::new(ProductEvaluationRunnerV1::new(holdout));\n        let key = product_evaluation_execution_key_v1(\n            plan.product_plan(), Digest32::from_array(self.holdout.binding),\n            &qualification_context.evaluator,\n        ).map_err(deployment_error)?;\n        let business_expiry = prepared.initial().request.envelope.expiry_unix_seconds;\n        let actual_clock = context.clock();\n        let clock_context = Arc::clone(context);\n        let clock = move || {\n            OriginalSameActorRootContext::require_current(&clock_context)\n                .map_err(|_| ProductProviderErrorV1::Unavailable)?;\n            let now = actual_clock.now_unix_ms()\n                .map_err(|_| ProductProviderErrorV1::Unavailable)? / 1_000;\n            if now >= business_expiry {\n                return Err(ProductProviderErrorV1::Unavailable);\n            }\n            OriginalSameActorRootContext::require_current(&clock_context)\n                .map_err(|_| ProductProviderErrorV1::Unavailable)?;\n            Ok(now)\n        };\n        let request = ProductEvaluationExecutionRequestV1 {\n            plan: plan.product_plan(), candidate_plan: &candidate_plan,\n            baseline_plan: &baseline_plan, evaluator: &qualification_context.evaluator,\n            verifier: learning.verifier(), clock: &clock,\n        };\n        let receipt = {\n            let mut attestor = OriginalExecutionAttestor::new(\n                Arc::clone(context), prepared, key, self.execution_signing.clone(),\n                files, &mut wait,\n            )?;\n            let result = runner.evaluate_or_readback(\n                &plan, CellEvaluationJournalsV1 {\n                    candidate: &candidate, fixed_expert: &fixed_expert,\n                }, &request, &mut provider, &mut executions, &mut attestor,\n            );\n            // Preserve the actual external actor error as well as the\n            // original runner's Pending semantics; never dispatch again.\n            if let Some(error) = attestor.take_original_failure() {\n                return Err(error);\n            }\n            result.map_err(deployment_error)?\n        };\n        material.require_original_pin()?;\n        wait.require_original_live()?;\n        let bundle = runner.qualification_bundle(&receipt, &qualification_context)\n            .map_err(deployment_error)?;\n        let evaluator_payload = evaluation_signing_payload_v2(\n            &bundle, &plan.product_plan().metric_roles,\n        ).map_err(deployment_error)?;\n        let evidence = request_original_qualification(\n            OriginalQualificationSigningRequest {\n                context, prepared, plan: &plan,\n                execution_digest: receipt.temporal().execution_digest,\n                evaluator_payload: &evaluator_payload,\n            },\n            self.qualification_signing.clone(), files, &mut wait,\n        )?;\n        let now = wait.require_original_live()?;\n        let qualification = runner.qualify_and_persist(\n            &receipt,\n            CellEvaluationQualificationRequestV1 {\n                context: &qualification_context, evidence: &evidence,\n                timing: ProductTimingEvidenceV1::Qualification,\n                verifier: learning.verifier(), now,\n            },\n            &mut sink,\n        ).map_err(deployment_error)?;\n        let persisted = sink.readback(\n            receipt.temporal().execution_digest, &qualification.product().decision,\n        ).map_err(deployment_error)?;\n        if persisted != qualification.product().publication_digest {\n            return Err(deployment_refused(\"actual B evidence sink readback differs\"));\n        }\n        // Only the actual runner return can enter this concrete handoff.\n        // The original Stage re-reads signed execution and authenticates the\n        // same Trainer/Training cut before minting its own Evaluation receipt.\n        wait.require_original_live()?;\n        require_fresh_original_file(&self.receipt.journal)?;\n        require_fresh_original_file(&self.receipt.witness.file)?;\n        let key = files.read_original_signing_key(&self.receipt.key)?;\n        if key.verifying_key().to_bytes() != evaluator.verifying_key {\n            return Err(deployment_refused(\"B receipt key differs from its actual enrolled Evaluator\"));\n        }\n        let receipt_file = files.open_original_owner(&self.receipt.journal)?;\n        let receipt_witness = self.receipt.witness.open_original(files)?;\n        let signing = OriginalCellEvaluationSigningConfigV1 {\n            plan: plan.product_plan().clone(),\n            execution_namespace: Digest32::from_array(self.holdout.binding),\n            signer: evaluator, verifier: learning.verifier().clone(),\n            maximum_signature_lifetime_seconds: self.receipt.maximum_signature_lifetime_seconds,\n        };\n        wait.require_original_live()?;\n        let inputs = OriginalCellQ24EvaluationInputsV1 {\n            plan, runner, candidate, fixed_expert, candidate_plan, baseline_plan,\n            executions, qualification, context: qualification_context, evidence,\n            timing: OriginalCellQ24EvaluationTimingV1::Qualification,\n            trainer: OriginalCellEvaluationTrainerV1::OriginalQ24(trainer),\n            receipt_file, receipt_witness, signing, key,\n            mode: OriginalCellQ24LearningOpenV1::Create,\n        };\n        Ok(OriginalExecutedEvaluation { inputs, evidence_owner: sink })\n    }\n}\n"
        }
      ]
    },
    {
      "key": "observation_data_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_observation_data.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_observation_data.rs",
        "blob": "a895514e7f23a9ab66a265478bea2122eebfa7d7",
        "bytes": 4533,
        "sha256": "b00a4a945e0758290198c32bc3c7510c0a5455453ed3335fe7ec1e668da67404",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Exact data exported from the actual Training/decision observations.\n//! These descriptions carry no receipt constructor, task admission or Root\n//! authority. Independent actors must reconcile them with their real sources.\n\nuse std::sync::Arc;\nuse codex_hepta_learning_artifacts::{\n    LearningIterationSnapshotV1, learning_iteration_receipt_signing_bytes_v1,\n};\nuse serde::Serialize;\nuse crate::{AgentdError, CellQ24TrainingOutcomeV1, LoadedCellQ24ModelV1,\n    OriginalCellQ24TrainingMaterialV1};\nuse super::bundle_data::OriginalBundleData;\nuse super::learning_data::SignedEvidenceData;\nuse super::{deployment_error, deployment_refused};\n\n#[derive(Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalTrainingNotice {\n    pub schema_version: u32,\n    pub purpose: &'static str,\n    pub phase: String,\n    pub learning_operation: String,\n    pub dataset_head: [u8; 32],\n    pub training_head: [u8; 32],\n    pub receipt_signing_bytes: Vec<u8>,\n    pub attestation: SignedEvidenceData,\n    pub candidate_bundle: OriginalBundleData,\n    pub heads: Vec<u8>,\n    pub batch_digest: [u8; 32],\n    pub optimizer_rule: [u8; 32],\n    pub update_rule: [u8; 32],\n    pub optimizer_steps: u64,\n    pub squared_error_before_q48: String,\n    pub squared_error_after_q48: String,\n    pub elapsed_microseconds: u64,\n}\nimpl OriginalTrainingNotice {\n    pub(super) fn from_original(\n        phase: &str,\n        snapshot: &LearningIterationSnapshotV1,\n        material: OriginalCellQ24TrainingMaterialV1,\n    ) -> Result<(Self, Arc<LoadedCellQ24ModelV1>), AgentdError> {\n        if material.training() != snapshot {\n            return Err(deployment_refused(\"Training notice differs from its actual readback\"));\n        }\n        let dataset_head = material.dataset().head_digest.into_array();\n        let completion = material.into_completion();\n        let CellQ24TrainingOutcomeV1::Candidate(candidate) = completion.outcome else {\n            // An authenticated NoUpdate follows the existing Decision branch;\n            // it is not reclassified as a candidate for an independent B run.\n            return Err(deployment_refused(\"actual NoUpdate has no independent-B candidate\"));\n        };\n        let candidate = *candidate;\n        let notice = Self {\n            schema_version: 1,\n            purpose: \"hepta.same-actor-q24-deployment.original-training.v1\",\n            phase: phase.to_owned(),\n            learning_operation: snapshot.request.operation_id.as_str().to_owned(),\n            dataset_head, training_head: snapshot.head_digest.into_array(),\n            receipt_signing_bytes: learning_iteration_receipt_signing_bytes_v1(\n                &completion.receipt,\n            ).map_err(deployment_error)?,\n            attestation: SignedEvidenceData::from_original(&completion.attestation),\n            candidate_bundle: OriginalBundleData::from_original(&candidate.bundle),\n            heads: candidate.heads,\n            batch_digest: candidate.metrics.batch_digest.into_array(),\n            optimizer_rule: candidate.metrics.optimizer_rule.into_array(),\n            update_rule: candidate.metrics.update_rule.into_array(),\n            optimizer_steps: candidate.metrics.optimizer_steps,\n            squared_error_before_q48: candidate.metrics.squared_error_before_q48.to_string(),\n            squared_error_after_q48: candidate.metrics.squared_error_after_q48.to_string(),\n            elapsed_microseconds: candidate.metrics.elapsed_microseconds,\n        };\n        Ok((notice, Arc::new(candidate.model)))\n    }\n}\n\n#[derive(Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct OriginalDecisionNotice {\n    pub schema_version: u32,\n    pub purpose: &'static str,\n    pub phase: String,\n    pub learning_operation: String,\n    pub actual_head: [u8; 32],\n    pub original_receipt_signing_bytes: Vec<Vec<u8>>,\n}\nimpl OriginalDecisionNotice {\n    pub(super) fn from_original(\n        phase: &str, snapshot: &LearningIterationSnapshotV1,\n    ) -> Result<Self, AgentdError> {\n        Ok(Self {\n            schema_version: 1,\n            purpose: \"hepta.same-actor-q24-deployment.original-decision.v1\",\n            phase: phase.to_owned(),\n            learning_operation: snapshot.request.operation_id.as_str().to_owned(),\n            actual_head: snapshot.head_digest.into_array(),\n            original_receipt_signing_bytes: snapshot.receipts.iter()\n                .map(learning_iteration_receipt_signing_bytes_v1)\n                .collect::<Result<Vec<_>, _>>().map_err(deployment_error)?,\n        })\n    }\n}\n"
        }
      ]
    },
