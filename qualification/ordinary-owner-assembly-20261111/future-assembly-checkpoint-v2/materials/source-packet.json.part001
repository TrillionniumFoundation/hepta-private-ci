      "operations": [
        {
          "op": "add_file",
          "content": "//! File custody for the explicit ordinary same-actor deployment.\n//! The Root-owned descriptor chooses paths and pins. File parsing creates data;\n//! the original owner constructors still authenticate every authority and cut.\n\nuse std::collections::BTreeMap;\nuse std::collections::BTreeSet;\nuse std::fs::File;\nuse std::fs::Metadata;\nuse std::fs::OpenOptions;\nuse std::io::Read;\nuse std::os::unix::fs::MetadataExt;\nuse std::os::unix::fs::OpenOptionsExt;\nuse std::path::Path;\nuse std::path::PathBuf;\nuse std::sync::Arc;\n\nuse codex_hepta_types::Digest32;\nuse serde::Deserialize;\nuse serde::Serialize;\n\nuse crate::AgentdError;\nuse crate::root_production_inputs::same_actor_phase::OriginalSameActorRootContext;\n\nuse super::deployment_error;\nuse super::deployment_refused;\n\n#[path = \"same_actor_q24_deployment_file_origin.rs\"]\nmod origin;\npub(super) use origin::OriginalOwnerFileOrigin;\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct PinnedFileData {\n    pub path: PathBuf,\n    pub sha256: [u8; 32],\n}\n\n#[derive(Clone, Copy, Debug, Deserialize, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub(super) enum OriginalFileMode {\n    CreateNew,\n    ExistingEmpty,\n    Recover,\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\npub(super) struct MutableFileData {\n    pub path: PathBuf,\n    pub mode: OriginalFileMode,\n}\n\n#[derive(Clone, Debug, Eq, PartialEq)]\nstruct PhysicalPin {\n    device: u64,\n    inode: u64,\n    owner: u32,\n    group: u32,\n    mode: u32,\n    links: u64,\n    length: u64,\n    modified_seconds: i64,\n    modified_nanos: i64,\n    changed_seconds: i64,\n    changed_nanos: i64,\n}\n\nimpl PhysicalPin {\n    fn of(metadata: &Metadata) -> Self {\n        Self {\n            device: metadata.dev(),\n            inode: metadata.ino(),\n            owner: metadata.uid(),\n            group: metadata.gid(),\n            mode: metadata.mode(),\n            links: metadata.nlink(),\n            length: metadata.len(),\n            modified_seconds: metadata.mtime(),\n            modified_nanos: metadata.mtime_nsec(),\n            changed_seconds: metadata.ctime(),\n            changed_nanos: metadata.ctime_nsec(),\n        }\n    }\n}\n\n/// One actual immutable read. It retains the opened file until its consumer\n/// has constructed the original owner, and checks the same file and path again.\npub(super) struct OriginalPinnedRead {\n    file: File,\n    path: PathBuf,\n    parent: File,\n    parent_path: PathBuf,\n    parent_identity: (u64, u64, u32, u32, u32),\n    pin: PhysicalPin,\n    bytes: Vec<u8>,\n}\n\nimpl OriginalPinnedRead {\n    pub(super) fn bytes(&self) -> &[u8] {\n        &self.bytes\n    }\n\n    /// Keep the original read/pin alive while its immutable decoder consumes\n    /// this same open-file description; the caller verifies the pin again.\n    pub(super) fn clone_original_file(&self) -> Result<File, AgentdError> {\n        self.require_original_pin()?;\n        let mut cloned = self.file.try_clone()?;\n        std::io::Seek::rewind(&mut cloned)?;\n        Ok(cloned)\n    }\n\n    pub(super) fn parse_original<T: serde::de::DeserializeOwned + Serialize>(\n        &self,\n    ) -> Result<T, AgentdError> {\n        self.require_original_pin()?;\n        let data: T = serde_json::from_slice(&self.bytes).map_err(deployment_error)?;\n        if serde_json::to_vec(&data).map_err(deployment_error)? != self.bytes {\n            return Err(deployment_refused(\"deployment data is not canonical JSON\"));\n        }\n        self.require_original_pin()?;\n        Ok(data)\n    }\n\n    pub(super) fn require_original_pin(&self) -> Result<(), AgentdError> {\n        if PhysicalPin::of(&self.file.metadata()?) != self.pin\n            || PhysicalPin::of(&std::fs::symlink_metadata(&self.path)?) != self.pin\n        {\n            return Err(deployment_refused(\"original deployment file changed\"));\n        }\n        let retained = self.parent.metadata()?;\n        let path = std::fs::symlink_metadata(&self.parent_path)?;\n        if !retained.is_dir()\n            || !path.is_dir()\n            || directory_identity(&retained) != self.parent_identity\n            || directory_identity(&path) != self.parent_identity\n            || self.parent_path.canonicalize()? != self.parent_path\n        {\n            return Err(deployment_refused(\"original deployment parent changed\"));\n        }\n        Ok(())\n    }\n}\n\n/// A retained actual directory used by an original path-based owner. It does\n/// not replace that owner's file fence, trusted minimum or signature checks.\npub(super) struct OriginalDirectoryPin {\n    file: File,\n    path: PathBuf,\n    identity: (u64, u64, u32, u32, u32),\n}\n\nimpl OriginalDirectoryPin {\n    pub(super) fn require_original_pin(&self) -> Result<(), AgentdError> {\n        if directory_identity(&self.file.metadata()?) != self.identity\n            || directory_identity(&std::fs::symlink_metadata(&self.path)?) != self.identity\n            || self.path.canonicalize()? != self.path\n        {\n            return Err(deployment_refused(\"original owner directory changed\"));\n        }\n        Ok(())\n    }\n}\n\n/// Actual inode custody prevents mutable owner roles from aliasing each\n/// other or any immutable input. Repeated immutable reads are allowed only\n/// with the exact same retained physical pin and content digest, so a real\n/// enrolled signer or retained artifact does not need a duplicate file.\npub(super) struct OriginalDeploymentFiles {\n    uid: u32,\n    gid: u32,\n    claimed: BTreeSet<(u64, u64)>,\n    immutable: BTreeMap<(u64, u64), (PhysicalPin, Digest32)>,\n    origins: BTreeSet<(u64, u64)>,\n    context: Arc<OriginalSameActorRootContext>,\n}\n\nimpl OriginalDeploymentFiles {\n    pub(super) fn for_original_context(\n        context: Arc<OriginalSameActorRootContext>,\n    ) -> Result<Self, AgentdError> {\n        OriginalSameActorRootContext::require_current(&context)?;\n        let uid = unsafe { libc::geteuid() };\n        let gid = unsafe { libc::getegid() };\n        if uid == 0 || gid == 0 {\n            return Err(deployment_refused(\n                \"ordinary deployment requires the actual dedicated non-Root owner\",\n            ));\n        }\n        Ok(Self { uid, gid, claimed: BTreeSet::new(), immutable: BTreeMap::new(), origins: BTreeSet::new(), context })\n    }\n\n    pub(super) fn read_root_descriptor(\n        &mut self,\n        input: &PinnedFileData,\n        maximum: usize,\n    ) -> Result<OriginalPinnedRead, AgentdError> {\n        let read = self.read_original(input, maximum)?;\n        // The ordinary process can read this data, but cannot replace the\n        // Root-approved deployment or select its own trust/credential set.\n        if read.pin.owner != 0\n            || read.pin.group != self.gid\n            || read.pin.mode & 0o7777 != 0o640\n        {\n            return Err(deployment_refused(\n                \"deployment descriptor requires Root ownership and exact 0640 mode\",\n            ));\n        }\n        let parent = read.parent.metadata()?;\n        if parent.uid() != 0\n            || parent.gid() != self.gid\n            || !matches!(parent.mode() & 0o7777, 0o750 | 0o2750)\n        {\n            return Err(deployment_refused(\n                \"deployment descriptor requires its original Root-owned read-only parent\",\n            ));\n        }\n        read.require_original_pin()?;\n        Ok(read)\n    }\n\n    pub(super) fn read_original(\n        &mut self,\n        input: &PinnedFileData,\n        maximum: usize,\n    ) -> Result<OriginalPinnedRead, AgentdError> {\n        let expected = Digest32::from_array(input.sha256);\n        if expected.is_zero() {\n            return Err(deployment_refused(\"deployment file digest is missing\"));\n        }\n        let read = self.read_original_path(&input.path, maximum)?;\n        if Digest32::of_bytes(read.bytes()) != expected {\n            return Err(deployment_refused(\"deployment file digest differs\"));\n        }\n        read.require_original_pin()?;\n        Ok(read)\n    }\n\n    /// Used only after the concrete coordinator receives the matching actual\n    /// stage event. A late signed attestation is data; its original verifier,\n    /// actual task and same phase must all be checked before any effect.\n    pub(super) fn read_original_stage(\n        &mut self,\n        path: &Path,\n        maximum: usize,\n    ) -> Result<OriginalPinnedRead, AgentdError> {\n        self.read_original_path(path, maximum)\n    }\n\n    fn read_original_path(\n        &mut self,\n        path: &Path,\n        maximum: usize,\n    ) -> Result<OriginalPinnedRead, AgentdError> {\n        OriginalSameActorRootContext::require_current(&self.context)?;\n        if maximum == 0 || maximum > 16 * 1024 * 1024 {\n            return Err(deployment_refused(\"deployment read bound is invalid\"));\n        }\n        let (parent_path, parent) = open_original_parent(path)?;\n        let mut file = OpenOptions::new()\n            .read(true)\n            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK | libc::O_CLOEXEC)\n            .open(path)?;\n        let metadata = file.metadata()?;\n        if !metadata.is_file()\n            || metadata.nlink() != 1\n            || (metadata.uid() != 0 && metadata.uid() != self.uid)\n            || metadata.mode() & 0o022 != 0\n            || metadata.len() == 0\n            || metadata.len() > maximum as u64\n        {\n            return Err(deployment_refused(\"deployment input is not a bounded protected file\"));\n        }\n        let pin = PhysicalPin::of(&metadata);\n        let parent_metadata = parent.metadata()?;\n        let mut bytes = Vec::new();\n        (&mut file).take(maximum as u64 + 1).read_to_end(&mut bytes)?;\n        if bytes.len() as u64 != metadata.len() || bytes.len() > maximum {\n            return Err(deployment_refused(\"deployment input changed during bounded read\"));\n        }\n        let read = OriginalPinnedRead {\n            file, path: path.to_owned(), parent, parent_path,\n            parent_identity: directory_identity(&parent_metadata),\n            pin, bytes,\n        };\n        read.require_original_pin()?;\n        self.claim_original_immutable(&read)?;\n        OriginalSameActorRootContext::require_current(&self.context)?;\n        Ok(read)\n    }\n\n    pub(super) fn open_original_owner(\n        &mut self,\n        input: &MutableFileData,\n    ) -> Result<File, AgentdError> {\n        self.open_original_owner_with_directory(input)\n            .map(|(file, _directory)| file)\n    }\n\n    pub(super) fn open_original_owner_with_directory(\n        &mut self,\n        input: &MutableFileData,\n    ) -> Result<(File, File), AgentdError> {\n        OriginalSameActorRootContext::require_current(&self.context)?;\n        let (parent_path, parent) = open_original_parent(&input.path)?;\n        let directory = parent.metadata()?;\n        if directory.uid() != self.uid || directory.mode() & 0o077 != 0 {\n            return Err(deployment_refused(\"mutable owner requires its actual private directory\"));\n        }\n        let mut options = OpenOptions::new();\n        options.read(true).write(true)\n            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK | libc::O_CLOEXEC);\n        if matches!(input.mode, OriginalFileMode::CreateNew) {\n            options.create_new(true).mode(0o600);\n        }\n        OriginalSameActorRootContext::require_current(&self.context)?;\n        let file = options.open(&input.path)?;\n        let metadata = file.metadata()?;\n        if !metadata.is_file()\n            || metadata.uid() != self.uid\n            || metadata.nlink() != 1\n            || metadata.mode() & 0o7777 != 0o600\n        {\n            return Err(deployment_refused(\"mutable owner file must be original private 0600 data\"));\n        }\n        let empty = metadata.len() == 0;\n        if match input.mode {\n            OriginalFileMode::CreateNew | OriginalFileMode::ExistingEmpty => !empty,\n            OriginalFileMode::Recover => empty,\n        } {\n            return Err(deployment_refused(\"explicit owner lifecycle differs from actual file\"));\n        }\n        self.claim_original_inode(&metadata)?;\n        let current_parent = std::fs::symlink_metadata(&parent_path)?;\n        let current = std::fs::symlink_metadata(&input.path)?;\n        if directory_identity(&current_parent) != directory_identity(&directory)\n            || parent_path.canonicalize()? != parent_path\n            || PhysicalPin::of(&current) != PhysicalPin::of(&metadata)\n        {\n            return Err(deployment_refused(\"mutable owner path changed before transfer\"));\n        }\n        // Existing owner constructors synchronize their own commits. This\n        // host also makes an explicitly created directory entry durable.\n        if matches!(input.mode, OriginalFileMode::CreateNew) {\n            parent.sync_all()?;\n        }\n        OriginalSameActorRootContext::require_current(&self.context)?;\n        Ok((file, parent))\n    }\n\n    pub(super) fn pin_original_owner_directory(\n        &mut self,\n        path: &Path,\n    ) -> Result<OriginalDirectoryPin, AgentdError> {\n        self.require_original_context()?;\n        if !path.is_absolute() || path.canonicalize()? != path {\n            return Err(deployment_refused(\"original owner directory must exist without symlinks\"));\n        }\n        let file = OpenOptions::new().read(true)\n            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)\n            .open(path)?;\n        let metadata = file.metadata()?;\n        if !metadata.is_dir() || metadata.uid() != self.uid\n            || metadata.mode() & 0o7777 != 0o700\n        {\n            return Err(deployment_refused(\"original owner directory must be private 0700\"));\n        }\n        self.claim_original_inode(&metadata)?;\n        let pin = OriginalDirectoryPin { file, path: path.to_owned(),\n            identity: directory_identity(&metadata) };\n        pin.require_original_pin()?;\n        self.require_original_context()?;\n        Ok(pin)\n    }\n\n    /// The Artifact owner uses its original path-based lock. Keep the exact\n    /// existing private inode pinned while that owner opens and locks it;\n    /// absence does not permit the original create(true) fallback.\n    pub(super) fn pin_original_artifact_lock(\n        &mut self,\n        path: &Path,\n    ) -> Result<OriginalPinnedRead, AgentdError> {\n        self.require_original_context()?;\n        let (parent_path, parent) = open_original_parent(path)?;\n        let file = OpenOptions::new().read(true)\n            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK | libc::O_CLOEXEC)\n            .open(path)?;\n        let metadata = file.metadata()?;\n        if !metadata.is_file() || metadata.uid() != self.uid || metadata.nlink() != 1\n            || metadata.mode() & 0o7777 != 0o600 || metadata.len() != 0\n        {\n            return Err(deployment_refused(\"existing original Artifact lock must be private and empty\"));\n        }\n        self.claim_original_inode(&metadata)?;\n        let parent_identity = directory_identity(&parent.metadata()?);\n        let pinned = OriginalPinnedRead {\n            file, path: path.to_owned(), parent, parent_path, parent_identity,\n            pin: PhysicalPin::of(&metadata), bytes: Vec::new(),\n        };\n        pinned.require_original_pin()?;\n        self.require_original_context()?;\n        Ok(pinned)\n    }\n\n    pub(super) fn retain_original_initial_file_origin(\n        &mut self, file: &File, path: &Path,\n    ) -> Result<OriginalOwnerFileOrigin, AgentdError> {\n        OriginalOwnerFileOrigin::capture_original(file, path, self)\n    }\n\n    pub(super) fn require_original_context(&self) -> Result<(), AgentdError> {\n        OriginalSameActorRootContext::require_current(self.context.as_ref())\n    }\n\n    pub(super) fn read_original_signing_key(\n        &mut self,\n        input: &PinnedFileData,\n    ) -> Result<ed25519_dalek::SigningKey, AgentdError> {\n        let read = self.read_original(input, 32)?;\n        if read.pin.owner != self.uid || read.pin.mode & 0o7777 != 0o600 {\n            return Err(deployment_refused(\"signing key must belong to the actual private owner\"));\n        }\n        let key: [u8; 32] = read.bytes().try_into()\n            .map_err(|_| deployment_refused(\"signing key must contain exactly 32 supplied bytes\"))?;\n        read.require_original_pin()?;\n        Ok(ed25519_dalek::SigningKey::from_bytes(&key))\n    }\n\n    fn claim_original_immutable(&mut self, read: &OriginalPinnedRead) -> Result<(), AgentdError> {\n        let inode = (read.pin.device, read.pin.inode);\n        let digest = Digest32::of_bytes(read.bytes());\n        if let Some((pin, original)) = self.immutable.get(&inode) {\n            if pin != &read.pin || *original != digest {\n                return Err(deployment_refused(\"retained immutable deployment input changed\"));\n            }\n            return Ok(());\n        }\n        if !self.claimed.insert(inode) {\n            return Err(deployment_refused(\"immutable input aliases an actual mutable owner\"));\n        }\n        self.immutable.insert(inode, (read.pin.clone(), digest));\n        Ok(())\n    }\n\n    fn claim_original_inode(&mut self, metadata: &Metadata) -> Result<(), AgentdError> {\n        if !self.claimed.insert((metadata.dev(), metadata.ino())) {\n            return Err(deployment_refused(\"deployment roles alias the same actual file\"));\n        }\n        Ok(())\n    }\n}\n\nfn open_original_parent(path: &Path) -> Result<(PathBuf, File), AgentdError> {\n    let parent = path.parent()\n        .filter(|parent| path.is_absolute() && path.file_name().is_some() && parent.is_absolute())\n        .ok_or_else(|| deployment_refused(\"deployment file requires an absolute canonical parent\"))?;\n    if parent.canonicalize()? != parent {\n        return Err(deployment_refused(\"deployment parent contains a symlink or traversal\"));\n    }\n    let directory = OpenOptions::new().read(true)\n        .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)\n        .open(parent)?;\n    if !directory.metadata()?.is_dir() {\n        return Err(deployment_refused(\"deployment parent is not an actual directory\"));\n    }\n    Ok((parent.to_owned(), directory))\n}\n\nfn directory_identity(metadata: &Metadata) -> (u64, u64, u32, u32, u32) {\n    (metadata.dev(), metadata.ino(), metadata.uid(), metadata.gid(), metadata.mode())\n}\n"
        }
      ]
    },
    {
      "key": "file_origin_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_file_origin.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_file_origin.rs",
        "blob": "4c5ee7d25ea6e86bb6a17a856fe194198edb9c2c",
        "bytes": 3810,
        "sha256": "3cd82ad3c4c817634886a515c326485b9d176f8ba7eeb10e2e708c25e8e53d37",
