      "key": "factory_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_factory.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_factory.rs",
        "blob": "62bfd57b3059fdc8f1d68fb3a02d08334ea84649",
        "bytes": 6149,
        "sha256": "bc711a99ef6c41a4cd7e7ecceffaba94dfd80cad094e1f337a3490e3949822f4",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Open real ordinary owners after the sealed Root context is received.\n//! This factory returns actual business inputs AND their concrete coordinator;\n//! it cannot return an unconsumed placeholder channel as a configured phase.\n\nuse std::sync::Arc;\nuse codex_hepta_learning_artifacts::CellCompatibilityBundleV1;\nuse codex_hepta_types::Digest32;\nuse crate::{AgentdError, AuthBusObjectiveIngress, LoadedCellQ24ModelV1,\n    load_plasticity_process_bootstrap_v1};\nuse crate::root_production_inputs::same_actor_phase::OriginalSameActorRootContext;\nuse crate::same_actor_q24_deployment_protocol::OriginalDeploymentBinding;\nuse crate::same_actor_q24_phase::{\n    OriginalSameActorBusinessInputsV1, original_same_actor_deployment_host_channel,\n};\nuse crate::same_actor_q24_phase_gate::CloseSameActorPhaseOnDrop;\n\nuse super::artifacts::OriginalDeploymentArtifacts;\nuse super::client::OriginalDeploymentClient;\nuse super::coordinator::OriginalDeploymentCoordinator;\nuse super::data::OriginalDeploymentData;\nuse super::files::{OriginalDeploymentFiles, OriginalPinnedRead, PinnedFileData};\nuse super::ingress::OriginalOrdinaryTaskIngress;\nuse super::learning::OriginalDeploymentLearning;\nuse super::task::OriginalInitialPredecessorFiles;\nuse super::{deployment_error, deployment_refused};\n\npub(super) struct OriginalLoadedDeployment {\n    pub business: OriginalSameActorBusinessInputsV1,\n    pub coordinator: OriginalDeploymentCoordinator,\n}\n\npub(super) struct OriginalCoordinatorMaterials {\n    pub data: OriginalDeploymentData,\n    pub files: OriginalDeploymentFiles,\n    pub artifacts: OriginalDeploymentArtifacts,\n    pub learning: OriginalDeploymentLearning,\n    pub initial_model: Arc<LoadedCellQ24ModelV1>,\n    pub initial_bundle: CellCompatibilityBundleV1,\n    pub predecessor: OriginalInitialPredecessorFiles,\n    pub objective_a: AuthBusObjectiveIngress,\n    pub objective_c: AuthBusObjectiveIngress,\n    /// Retained Root configuration pins are data custody, never writer caps.\n    pub pins: Vec<OriginalPinnedRead>,\n}\n\npub(super) async fn load_original_deployment(\n    context: Arc<OriginalSameActorRootContext>,\n    descriptor: PinnedFileData,\n) -> Result<OriginalLoadedDeployment, AgentdError> {\n    let mut closing = CloseSameActorPhaseOnDrop::new(context.gate());\n    OriginalSameActorRootContext::require_current(&context)?;\n    let mut files = OriginalDeploymentFiles::for_original_context(Arc::clone(&context))?;\n    let pinned = files.read_root_descriptor(&descriptor, 8 * 1024 * 1024)?;\n    let data: OriginalDeploymentData = pinned.parse_original()?;\n    if data.schema_version != 1\n        || data.binding != OriginalDeploymentBinding::from_original_phase(context.descriptor())?\n    {\n        return Err(deployment_refused(\"deployment does not bind this actual original Root phase\"));\n    }\n    let now = context.clock().now_unix_ms().map_err(deployment_error)? / 1_000;\n    let authbus = files.read_root_descriptor(&data.authbus_trust, 1024 * 1024)?;\n    let objective_profile = files.read_root_descriptor(&data.objective_profile, 1024 * 1024)?;\n    let plasticity_data = files.read_root_descriptor(&data.plasticity, 8 * 1024 * 1024)?;\n    // This actual original loader owns its full existing artifacts, ledger,\n    // policy, neuron, NDU and parameter/topology resources. No stand-in\n    // Plasticity bootstrap is supplied for the phase's readiness check.\n    files.require_original_context()?;\n    let plasticity = load_plasticity_process_bootstrap_v1(\n        &data.plasticity.path, Digest32::from_array(data.plasticity.sha256), context.identity(),\n    )?;\n    plasticity_data.require_original_pin()?;\n    let checkpoint = files.open_original_owner(&data.authbus_checkpoint)?;\n    // ReplayCheckpointFile later opens this SAME explicitly selected file.\n    // This loader does not keep a second writable alias past that handoff.\n    drop(checkpoint);\n    let objective_a_file = files.read_original(&data.objective_a, 1024 * 1024)?;\n    let objective_c_file = files.read_original(&data.objective_c, 1024 * 1024)?;\n    let objective_a: AuthBusObjectiveIngress = objective_a_file.parse_original()?;\n    let objective_c: AuthBusObjectiveIngress = objective_c_file.parse_original()?;\n    if objective_a.body.run_id == objective_c.body.run_id {\n        return Err(deployment_refused(\"original A and C require distinct actual signed runs\"));\n    }\n    let (artifacts, selected) = OriginalDeploymentArtifacts::open_original(\n        &data.artifacts, &mut files, now,\n    )?;\n    let (initial, predecessor) = data.initial.open_original(&mut files)?;\n    let initial_model = Arc::clone(&initial.model);\n    let initial_bundle = initial.bundle.clone();\n    let task = data.task.open_original(&context, &mut files)?;\n    let (learning, ledger) = OriginalDeploymentLearning::open_original(\n        data.learning.clone(), &mut files, now,\n    )?;\n    let (commands, events, host) = original_same_actor_deployment_host_channel(data.host_capacity)?;\n    let ingress = OriginalOrdinaryTaskIngress::for_original_context(Arc::clone(&context))?;\n    let client = OriginalDeploymentClient::connect_original(Arc::clone(&context)).await?;\n    let business = OriginalSameActorBusinessInputsV1 {\n        artifacts: Arc::clone(artifacts.owner()), selected, initial, task, ledger,\n        authbus_trust_file: data.authbus_trust.path.clone(),\n        authbus_checkpoint_file: data.authbus_checkpoint.path.clone(),\n        objective_profile_file: data.objective_profile.path.clone(),\n        plasticity, host,\n    };\n    let pins = vec![pinned, authbus, objective_profile, plasticity_data,\n        objective_a_file, objective_c_file];\n    for pin in &pins { pin.require_original_pin()?; }\n    OriginalSameActorRootContext::require_current(&context)?;\n    let coordinator = OriginalDeploymentCoordinator::new_original(\n        Arc::clone(&context), client, ingress, commands, events,\n        OriginalCoordinatorMaterials {\n            data, files, artifacts, learning, initial_model, initial_bundle,\n            predecessor, objective_a, objective_c, pins,\n        },\n    )?;\n    closing.disarm();\n    Ok(OriginalLoadedDeployment { business, coordinator })\n}\n"
        }
      ]
    },
    {
      "key": "coordinator_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_coordinator.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_coordinator.rs",
        "blob": "cb1f0b161ea9ff579781df4a6c8287d804f63780",
        "bytes": 13547,
        "sha256": "439e69e5280af125653db569c7ada85ea658d252a612349e86af28b800338c1f",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! The concrete ordinary coordinator consumes every real phase event and\n//! supplies authenticated, deployment-owned material through the original\n//! typed commands. It never submits directly to a task queue or makes Ready.\n\nuse std::sync::Arc;\n\nuse codex_hepta_intelligence_eval::LockedFileProductQualificationEvidenceSinkV1;\nuse codex_hepta_learning_artifacts::CellCompatibilityBundleV1;\nuse codex_hepta_types::Digest32;\nuse tokio::sync::mpsc;\n\nuse crate::{AgentdError, AuthBusObjectiveIngress, CellQ24PreparedLearningV1, LoadedCellQ24ModelV1};\nuse crate::root_production_inputs::same_actor_phase::OriginalSameActorRootContext;\nuse crate::same_actor_q24_deployment_protocol::OriginalDeploymentProgress;\nuse crate::same_actor_q24_phase::{\n    OriginalSameActorCOutcomeInputsV1, OriginalSameActorCompletedAInputsV1,\n    OriginalSameActorPhaseCommandV1 as Command, OriginalSameActorPhaseEventV1 as Event,\n};\nuse crate::same_actor_q24_phase_gate::CloseSameActorPhaseOnDrop;\n\nuse super::artifacts::{OriginalDeploymentArtifacts, OriginalSelectionData};\nuse super::c::OriginalCResources;\nuse super::client::OriginalDeploymentClient;\nuse super::data::{OriginalACompletionData, OriginalCOutcomeData, OriginalDeploymentData};\nuse super::exchange::OriginalActorWait;\nuse super::factory::OriginalCoordinatorMaterials;\nuse super::files::{OriginalDeploymentFiles, OriginalPinnedRead};\nuse super::ingress::{OriginalOrdinaryTaskIngress, OriginalOrdinaryTaskStage};\nuse super::learning::OriginalDeploymentLearning;\nuse super::task::OriginalInitialPredecessorFiles;\nuse super::deployment_refused;\n\n#[path = \"same_actor_q24_deployment_coordinator_materials.rs\"]\nmod materials;\n\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\nenum Expected {\n    Inputs, AInstalled, APrepared, TrainingOrDecision, Decision,\n    Artifact, Selection, CInstalled, COutcome,\n}\n\npub(super) struct OriginalDeploymentCoordinator {\n    context: Arc<OriginalSameActorRootContext>,\n    client: OriginalDeploymentClient,\n    ingress: OriginalOrdinaryTaskIngress,\n    commands: mpsc::Sender<Command>,\n    events: mpsc::Receiver<Event>,\n    data: OriginalDeploymentData,\n    files: OriginalDeploymentFiles,\n    artifacts: OriginalDeploymentArtifacts,\n    learning: OriginalDeploymentLearning,\n    initial_model: Arc<LoadedCellQ24ModelV1>,\n    initial_bundle: CellCompatibilityBundleV1,\n    predecessor: Option<OriginalInitialPredecessorFiles>,\n    objective_a: Option<AuthBusObjectiveIngress>,\n    objective_c: Option<AuthBusObjectiveIngress>,\n    prepared: Option<Arc<CellQ24PreparedLearningV1>>,\n    trained_model: Option<Arc<LoadedCellQ24ModelV1>>,\n    original_selection: Option<(OriginalSelectionData, Digest32)>,\n    evidence_owner: Option<LockedFileProductQualificationEvidenceSinkV1>,\n    decision_head: Option<Digest32>,\n    pins: Vec<OriginalPinnedRead>,\n    expected: Expected,\n}\n\nimpl OriginalDeploymentCoordinator {\n    pub(super) fn new_original(\n        context: Arc<OriginalSameActorRootContext>,\n        client: OriginalDeploymentClient,\n        ingress: OriginalOrdinaryTaskIngress,\n        commands: mpsc::Sender<Command>,\n        events: mpsc::Receiver<Event>,\n        actual: OriginalCoordinatorMaterials,\n    ) -> Result<Self, AgentdError> {\n        OriginalSameActorRootContext::require_current(&context)?;\n        let OriginalCoordinatorMaterials {\n            data, files, artifacts, learning, initial_model, initial_bundle,\n            predecessor, objective_a, objective_c, pins,\n        } = actual;\n        Ok(Self {\n            context, client, ingress, commands, events, data, files, artifacts, learning,\n            initial_model, initial_bundle, predecessor: Some(predecessor),\n            objective_a: Some(objective_a), objective_c: Some(objective_c), prepared: None,\n            trained_model: None, original_selection: None, evidence_owner: None,\n            decision_head: None, pins, expected: Expected::Inputs,\n        })\n    }\n\n    pub(super) fn require_original_context(\n        &self, context: &Arc<OriginalSameActorRootContext>,\n    ) -> Result<(), AgentdError> {\n        if !Arc::ptr_eq(context, &self.context) {\n            return Err(deployment_refused(\"coordinator belongs to another actual Root context\"));\n        }\n        self.require_original_inputs()\n    }\n\n    fn require_original_inputs(&self) -> Result<(), AgentdError> {\n        OriginalSameActorRootContext::require_current(&self.context)?;\n        for pin in &self.pins { pin.require_original_pin()?; }\n        self.artifacts.require_original_paths()?;\n        self.files.require_original_context()\n    }\n\n    fn send_original(&self, command: Command) -> Result<(), AgentdError> {\n        self.require_original_inputs()?;\n        self.commands.try_send(command)\n            .map_err(|_| deployment_refused(\"actual coordinator command was not delivered\"))?;\n        self.require_original_inputs()\n    }\n\n    fn prepared(&self) -> Result<Arc<CellQ24PreparedLearningV1>, AgentdError> {\n        self.prepared.as_ref().cloned()\n            .ok_or_else(|| deployment_refused(\"actual Prepared has not been received\"))\n    }\n\n    pub(super) async fn run_original(mut self) -> Result<(), AgentdError> {\n        let _closing = CloseSameActorPhaseOnDrop::new(self.context.gate());\n        loop {\n            self.require_original_inputs()?;\n            let event = tokio::select! {\n                _ = self.context.gate().cancelled() =>\n                    return Err(deployment_refused(\"original deployment phase closed\")),\n                event = self.events.recv() => event,\n            }.ok_or_else(|| deployment_refused(\"original phase event owner stopped\"))?;\n            self.require_original_inputs()?;\n            match (self.expected, event) {\n                (Expected::Inputs, Event::InputsOpened { identity, phase }) => {\n                    if identity.as_ref() != self.context.identity()\n                        || phase != self.context.descriptor().phase\n                    {\n                        return Err(deployment_refused(\"InputsOpened differs from sealed actual context\"));\n                    }\n                    // This is the actual context-pinned peer. Public event\n                    // fields were only compared; they created no capability.\n                    self.client.exchange_original(OriginalDeploymentProgress::InputsOpened)?;\n                    self.send_original(Command::InitialRootEnrolled)?;\n                    self.expected = Expected::AInstalled;\n                }\n                (Expected::AInstalled, Event::OriginalAOwnersInstalled) => {\n                    let objective = self.objective_a.take()\n                        .ok_or_else(|| deployment_refused(\"original A was already submitted\"))?;\n                    self.ingress.submit_original_once(OriginalOrdinaryTaskStage::A, objective).await?;\n                    let mut wait = OriginalActorWait::for_original_task(\n                        Arc::clone(&self.context), self.learning.original_a_claim_deadline(),\n                    )?;\n                    let completion = wait.wait_original_file(\n                        &mut self.files, &self.data.completion_a, 1024 * 1024,\n                    )?;\n                    let completed: OriginalACompletionData = completion.parse_original()?;\n                    if completed.schema_version != 1\n                        || completed.phase != self.context.descriptor().phase\n                    {\n                        return Err(deployment_refused(\"actual A completion file belongs to another phase\"));\n                    }\n                    let (outcome, signed) = completed.outcome.into_original()?;\n                    let preparation = completed.preparation.original(\n                        Arc::clone(&self.initial_model), &self.initial_bundle,\n                    )?;\n                    let now = wait.require_original_live()?;\n                    let freeze = self.learning.open_original_freeze(&mut self.files, now)?;\n                    completion.require_original_pin()?;\n                    self.send_original(Command::CompleteOriginalA(Box::new(\n                        OriginalSameActorCompletedAInputsV1 {\n                            outcome, signed, preparation,\n                            // This actual ledger was created fresh for A.\n                            // The producer adds and authenticates A's own task.\n                            history: Vec::new(), freeze,\n                        },\n                    )))?;\n                    self.expected = Expected::APrepared;\n                }\n                (Expected::APrepared, Event::OriginalAPrepared { prepared, profile }) => {\n                    self.receive_prepared_original(prepared, *profile)?;\n                    self.expected = Expected::TrainingOrDecision;\n                }\n                (Expected::TrainingOrDecision, Event::OriginalTraining {\n                    snapshot, material, readback,\n                }) => {\n                    self.execute_original_b(*snapshot, *material, *readback)?;\n                    self.expected = Expected::Decision;\n                }\n                (Expected::TrainingOrDecision | Expected::Decision, Event::OriginalDecision(snapshot)) => {\n                    self.receive_original_decision(*snapshot)?;\n                    self.expected = Expected::Artifact;\n                }\n                (Expected::Artifact, Event::OriginalArtifactAvailable) => {\n                    self.receive_original_artifact()?;\n                    self.expected = Expected::Selection;\n                }\n                (Expected::Selection, Event::OriginalSelectionObserved { selection }) => {\n                    let (data, expected) = self.original_selection.take()\n                        .ok_or_else(|| deployment_refused(\"actual Selection was not supplied\"))?;\n                    if selection != expected {\n                        return Err(deployment_refused(\"actual Selection observation differs\"));\n                    }\n                    let prepared = self.prepared()?;\n                    let mut wait = OriginalActorWait::for_original_prepared(\n                        Arc::clone(&self.context), &prepared,\n                    )?;\n                    let signed = data.original_signed()?;\n                    let predecessor = self.predecessor.take()\n                        .ok_or_else(|| deployment_refused(\"actual A predecessor already transferred\"))?;\n                    let now = wait.require_original_live()?;\n                    let actual = self.data.original_c.open_original(\n                        &self.context, &mut self.files,\n                        OriginalCResources {\n                            initial_model: &self.initial_model, trained_model: self.trained_model.as_ref(),\n                            predecessor, learning: &self.learning, selection: &signed,\n                            capacity: self.data.learning.owners.successor_queue_capacity, now,\n                        },\n                    )?;\n                    self.await_original_current_material(&actual.canonical_material, &mut wait)?;\n                    self.client.exchange_original(OriginalDeploymentProgress::OriginalSelectionReady {\n                        canonical_material: actual.canonical_material,\n                    })?;\n                    wait.require_original_live()?;\n                    self.send_original(Command::PublishOriginalC(Box::new(actual.inputs)))?;\n                    self.expected = Expected::CInstalled;\n                }\n                (Expected::CInstalled, Event::OriginalCOwnersInstalled) => {\n                    let objective = self.objective_c.take()\n                        .ok_or_else(|| deployment_refused(\"original C was already submitted\"))?;\n                    self.ingress.submit_original_once(OriginalOrdinaryTaskStage::C, objective).await?;\n                    let mut wait = OriginalActorWait::for_original_task(\n                        Arc::clone(&self.context), self.learning.original_c_claim_deadline(),\n                    )?;\n                    let response = wait.wait_original_file(\n                        &mut self.files, &self.data.outcome_c, 1024 * 1024,\n                    )?;\n                    let data: OriginalCOutcomeData = response.parse_original()?;\n                    if data.schema_version != 1 || data.phase != self.context.descriptor().phase {\n                        return Err(deployment_refused(\"actual C Outcome belongs to another phase\"));\n                    }\n                    let (outcome, signed) = data.outcome.into_original()?;\n                    response.require_original_pin()?;\n                    wait.require_original_live()?;\n                    self.send_original(Command::ObserveOriginalC(Box::new(\n                        OriginalSameActorCOutcomeInputsV1 { outcome, signed },\n                    )))?;\n                    self.expected = Expected::COutcome;\n                }\n                (Expected::COutcome, Event::OriginalCOutcomeAccepted(_actual_status)) => {\n                    // The actual receipt was accepted, but this version has\n                    // no private normal-retirement/physical-join completion\n                    // contract. Keep the original peer and every owner alive.\n                    // Fault closure remains an error, never a success ACK.\n                    return self.client.retain_until_original_close().await;\n                }\n                _ => return Err(deployment_refused(\"original deployment event arrived out of order\")),\n            }\n        }\n    }\n}\n"
        }
      ]
    },
    {
      "key": "coordinator_materials_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_coordinator_materials.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_coordinator_materials.rs",
        "blob": "e6a038c03bb6f77898c01a21d5183c2ca25564c5",
        "bytes": 10966,
        "sha256": "e42d0fbc101cf3e18d1169472d37d9da3b1ea6cda97782ac0589c803dd8fc870",
        "create_get_equal": true
      },
      "operations": [
        {
          "op": "add_file",
          "content": "//! Actual external material handoffs at the original Prepared, Training,\n//! decision and selected-C boundaries. A ready response is only data; Root,\n//! original Artifact, Selector and Evaluation owners still authenticate it.\n\nuse std::sync::Arc;\nuse codex_hepta_learning_artifacts::LearningIterationSnapshotV1;\nuse codex_hepta_types::Digest32;\nuse serde::Serialize;\n\nuse super::OriginalDeploymentCoordinator;\nuse crate::{\n    AgentdError, CellQ24PreparedLearningV1, HostAuthorityLearningProfileV1,\n    OriginalCellQ24TrainingMaterialV1, OriginalCellQ24TrainingReadbackV1,\n};\nuse crate::root_production_inputs::same_actor_phase::OriginalSameActorRootContext;\nuse crate::same_actor_q24_deployment_protocol::OriginalDeploymentProgress;\nuse crate::same_actor_q24_phase::OriginalSameActorPhaseCommandV1 as Command;\n\nuse super::super::data::{\n    OriginalArtifactResponse, OriginalEvaluationResponse, OriginalMaterialReady,\n    OriginalSelectionResponse,\n};\nuse super::super::evaluation::OriginalExecutedEvaluation;\nuse super::super::exchange::{OriginalActorExchange, OriginalActorWait};\nuse super::super::observation_data::{OriginalDecisionNotice, OriginalTrainingNotice};\nuse super::super::{deployment_error, deployment_refused};\n\n#[derive(Serialize)]\n#[serde(deny_unknown_fields)]\nstruct OriginalPreparedMaterialNotice<'a> {\n    schema_version: u32,\n    purpose: &'static str,\n    phase: &'a str,\n    material_digest: [u8; 32],\n    actual_profile: &'a HostAuthorityLearningProfileV1,\n}\n#[derive(Serialize)]\n#[serde(deny_unknown_fields)]\nstruct OriginalSelectionMaterialNotice<'a> {\n    schema_version: u32,\n    purpose: &'static str,\n    phase: &'a str,\n    material_digest: [u8; 32],\n    canonical_material: &'a str,\n}\n#[derive(Serialize)]\n#[serde(deny_unknown_fields)]\nstruct OriginalArtifactNotice<'a> {\n    schema_version: u32,\n    purpose: &'static str,\n    phase: &'a str,\n    original_decision_head: [u8; 32],\n}\n\nimpl OriginalDeploymentCoordinator {\n    pub(super) fn receive_prepared_original(\n        &mut self,\n        prepared: Arc<CellQ24PreparedLearningV1>,\n        profile: HostAuthorityLearningProfileV1,\n    ) -> Result<(), AgentdError> {\n        if self.prepared.is_some() {\n            return Err(deployment_refused(\"actual Prepared was already consumed\"));\n        }\n        let proof = self.context.bootstrap().writer_proof.sha256()?\n            .as_str().parse::<Digest32>().map_err(deployment_error)?.into_array();\n        let expected = CellQ24PreparedLearningV1::root_profile(\n            &prepared, self.context.identity(), proof,\n        ).map_err(deployment_error)?;\n        if expected != profile {\n            return Err(deployment_refused(\"APrepared profile differs from the original producer\"));\n        }\n        let mut wait = OriginalActorWait::for_original_prepared(\n            Arc::clone(&self.context), &prepared,\n        )?;\n        let encoded = serde_json::to_vec(&profile).map_err(deployment_error)?;\n        let material_digest = Digest32::of_bytes(&encoded);\n        let notice = OriginalPreparedMaterialNotice {\n            schema_version: 1,\n            purpose: \"hepta.same-actor-q24-deployment.prepared-material.v1\",\n            phase: &self.context.descriptor().phase,\n            material_digest: material_digest.into_array(), actual_profile: &profile,\n        };\n        let (request, response) = OriginalActorExchange::new(\n            self.data.scoped_material_ready.clone(),\n        )?.exchange_original(&notice, &mut self.files, &mut wait)?;\n        require_original_material_ready(&response, request, material_digest)?;\n        wait.require_original_live()?;\n        // This data-only signal is BEFORE A captures its original first\n        // request_started. It grants no Root permission and proves no ACK.\n        self.send_original(Command::OriginalPreparedMaterialsReady)?;\n        // The actual A controller concurrently performs its two original\n        // ACKs, drops A's original owners and receives the scoped rights.\n        // This synchronous frame has its OWN unchanged original 500 ms end.\n        self.client.exchange_original(OriginalDeploymentProgress::OriginalAPrepared { profile })?;\n        wait.require_original_live()?;\n        let inputs = self.learning.open_original_scoped_inputs(\n            Arc::clone(&prepared), &mut self.files, wait.require_original_live()?,\n        )?;\n        self.prepared = Some(prepared);\n        self.send_original(Command::Learning(Box::new(inputs)))\n    }\n\n    pub(super) fn execute_original_b(\n        &mut self,\n        snapshot: LearningIterationSnapshotV1,\n        material: OriginalCellQ24TrainingMaterialV1,\n        readback: OriginalCellQ24TrainingReadbackV1,\n    ) -> Result<(), AgentdError> {\n        let prepared = self.prepared()?;\n        prepared.scope().validate_snapshot(&snapshot).map_err(deployment_error)?;\n        if snapshot.request != prepared.initial().request\n            || material.scope() != prepared.scope() || material.training() != &snapshot\n            || self.trained_model.is_some() || self.evidence_owner.is_some()\n        {\n            return Err(deployment_refused(\"independent B differs from the actual single Training cut\"));\n        }\n        let mut wait = OriginalActorWait::for_original_prepared(\n            Arc::clone(&self.context), &prepared,\n        )?;\n        let (notice, model) = OriginalTrainingNotice::from_original(\n            &self.context.descriptor().phase, &snapshot, material,\n        )?;\n        let (digest, response) = OriginalActorExchange::new(\n            self.data.independent_training.clone(),\n        )?.exchange_original(&notice, &mut self.files, &mut wait)?;\n        let data: OriginalEvaluationResponse = response.parse_original()?;\n        if data.schema_version != 1 || data.request_digest != digest.into_array() {\n            return Err(deployment_refused(\"independent B input does not bind this actual Training\"));\n        }\n        response.require_original_pin()?;\n        wait.require_original_live()?;\n        let OriginalExecutedEvaluation { inputs, evidence_owner } =\n            data.original.execute_original(\n                &self.context, &prepared, readback, &self.learning, &mut self.files,\n            )?;\n        // These are the actual retained model and sink, not reconstructed\n        // capabilities from the external notification or private receipt bytes.\n        self.trained_model = Some(model);\n        self.evidence_owner = Some(evidence_owner);\n        self.send_original(Command::Evaluation(Box::new(inputs)))\n    }\n\n    pub(super) fn receive_original_decision(\n        &mut self, snapshot: LearningIterationSnapshotV1,\n    ) -> Result<(), AgentdError> {\n        let prepared = self.prepared()?;\n        prepared.scope().validate_snapshot(&snapshot).map_err(deployment_error)?;\n        if snapshot.request != prepared.initial().request || self.decision_head.is_some() {\n            return Err(deployment_refused(\"actual decision belongs to another original request\"));\n        }\n        let mut wait = OriginalActorWait::for_original_prepared(\n            Arc::clone(&self.context), &prepared,\n        )?;\n        let notice = OriginalDecisionNotice::from_original(\n            &self.context.descriptor().phase, &snapshot,\n        )?;\n        let (digest, response) = OriginalActorExchange::new(self.data.artifact_decision.clone())?\n            .exchange_original(&notice, &mut self.files, &mut wait)?;\n        let data: OriginalArtifactResponse = response.parse_original()?;\n        if data.schema_version != 1 || data.request_digest != digest.into_array() {\n            return Err(deployment_refused(\"Artifact input differs from the actual decision\"));\n        }\n        let command = self.artifacts.original_artifact_command(\n            &data.original, &mut self.files, wait.require_original_live()?,\n        )?;\n        response.require_original_pin()?;\n        self.decision_head = Some(snapshot.head_digest);\n        self.send_original(Command::Artifact(command))\n    }\n\n    pub(super) fn receive_original_artifact(&mut self) -> Result<(), AgentdError> {\n        let prepared = self.prepared()?;\n        let head = self.decision_head\n            .ok_or_else(|| deployment_refused(\"original Artifact has no observed decision\"))?;\n        let mut wait = OriginalActorWait::for_original_prepared(\n            Arc::clone(&self.context), &prepared,\n        )?;\n        let notice = OriginalArtifactNotice {\n            schema_version: 1,\n            purpose: \"hepta.same-actor-q24-deployment.artifact-available.v1\",\n            phase: &self.context.descriptor().phase, original_decision_head: head.into_array(),\n        };\n        let (digest, response) = OriginalActorExchange::new(self.data.independent_selection.clone())?\n            .exchange_original(&notice, &mut self.files, &mut wait)?;\n        let data: OriginalSelectionResponse = response.parse_original()?;\n        if data.schema_version != 1 || data.request_digest != digest.into_array() {\n            return Err(deployment_refused(\"independent Selection response differs\"));\n        }\n        let (selection, digest) = self.artifacts.open_original_selection(\n            &data.original, &mut self.files, wait.require_original_live()?,\n        )?;\n        response.require_original_pin()?;\n        self.original_selection = Some((data.original, digest));\n        self.send_original(Command::Selection(Box::new(selection)))\n    }\n\n    pub(super) fn await_original_current_material(\n        &mut self, canonical: &str, wait: &mut OriginalActorWait,\n    ) -> Result<(), AgentdError> {\n        let material = Digest32::of_bytes(canonical.as_bytes());\n        let notice = OriginalSelectionMaterialNotice {\n            schema_version: 1,\n            purpose: \"hepta.same-actor-q24-deployment.selected-current-material.v1\",\n            phase: &self.context.descriptor().phase, material_digest: material.into_array(),\n            canonical_material: canonical,\n        };\n        let (request, response) = OriginalActorExchange::new(\n            self.data.current_material_ready.clone(),\n        )?.exchange_original(&notice, &mut self.files, wait)?;\n        require_original_material_ready(&response, request, material)?;\n        wait.require_original_live()?;\n        OriginalSameActorRootContext::require_current(&self.context)\n    }\n}\n\nfn require_original_material_ready(\n    response: &super::super::files::OriginalPinnedRead,\n    request: Digest32, material: Digest32,\n) -> Result<(), AgentdError> {\n    let ready: OriginalMaterialReady = response.parse_original()?;\n    if ready.schema_version != 1 || ready.request_digest != request.into_array()\n        || ready.material_digest != material.into_array()\n    {\n        return Err(deployment_refused(\"external material-ready data differs\"));\n    }\n    // This authenticates no approval. Root's actual finite-purpose handler\n    // separately opens and authenticates its original 0600 approval material.\n    response.require_original_pin()\n}\n"
        }
      ]
    },
    {
      "key": "files_draft",
      "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_files.rs",
      "pre": null,
      "post": {
        "path": "codex-rs/hepta-agentd/src/same_actor_q24_deployment_files.rs",
        "blob": "962147b26db8d7ef6488811cedb8940d9fe396ab",
        "bytes": 18244,
        "sha256": "337760f583b9ccd64ff52a817158e02e788bafaaed91e068e7a50997a991f6db",
        "create_get_equal": true
