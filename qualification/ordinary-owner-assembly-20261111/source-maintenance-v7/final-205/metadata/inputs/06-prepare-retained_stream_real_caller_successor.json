  "semantic_apply_js": "return function applyRetainCallerDelta(rows, expected, updated) {\n  const ix = rows.map((row, i) => row.id === expected.id ? i : -1).filter(i => i >= 0);\n  if (ix.length !== 1) throw new Error(\"expected one complete boundary row\");\n  const index = ix[0], current = rows[index];\n  const equal = (a,b) => JSON.stringify(a) === JSON.stringify(b);\n  const keys = new Set([...Object.keys(expected), ...Object.keys(current)]);\n  for (const key of keys) {\n    if (key !== \"product_callers\" && !equal(current[key], expected[key]))\n      throw new Error(\"unowned boundary field changed: \" + key);\n  }\n  if (!expected.product_callers.every(p => current.product_callers.includes(p)))\n    throw new Error(\"original declared caller disappeared\");\n  const result = rows.slice();\n  result[index] = { ...current, product_callers: [...new Set([...current.product_callers, ...updated.product_callers])].sort() };\n  return result;\n};",
