+def sequence(repo, records, source):
+    directory = records / 'list-admission'
+    directory.mkdir(mode=0o700, exist_ok=False)
+    start = time.monotonic()
+    deadline = start + 7200
+    save_json(directory, 'sequence-intent.json', {
+        'source': source, 'started_at': now(), 'started_monotonic': start,
+        'absolute_end_monotonic': deadline, 'original_total_budget_seconds': 7200,
+        'original_test_command': ORIGINAL_TEST_COMMAND, 'parent_signal_or_kill': False,
+        'acceptance_rule': 'every phase starts and completes strictly before the same fixed end',
+        'cleanup_rule': 'wait for the unchanged original controller natural timeout cleanup'})
+    result = {'kind': 'actual-list-and-original-test-fixed-budget', 'source': source,
+              'started_at': now(), 'status': 'listing-not-started',
+              'budget_seconds': 7200, 'absolute_end_monotonic': deadline,
+              'budget_expired': False, 'native_test_child_started': False,
+              'listing_is_test_pass': False, 'ordinary_qualification': False,
+              'additional_timeout_or_retry': False, 'parent_signal_or_kill': False}
+    before = None
+    returncode = 1
+    try:
+        before = source_identity(repo)
+        if before['source'] != source or before['status']:
+            raise RuntimeError('sequence requires the exact clean source')
+        save_json(directory, 'source-before.json', before)
+        list_command = ['python3', str(Path(__file__).resolve()), '--list-only',
+                        '--repo', str(repo), '--records', str(records), '--source', source]
+        run_ci_phase(repo, directory, source, deadline, 'list', records / 'list-execution.json',
+                     list_command, 0, result)
+        listed = json.loads((directory / 'list-only-result.json').read_text(), object_pairs_hook=unique_object)
+        if (listed['status'] != 'actual-list-exact' or listed['exit_code'] != 0
+                or listed['source_before'] != before or listed['source_after'] != before):
+            raise RuntimeError('list-only child did not finish exact and unchanged')
+        inputs = json.loads((directory / 'listed-binary-inputs.json').read_text(), object_pairs_hook=unique_object)
+        if inputs['source'] != source or source_identity(repo) != before:
+            raise RuntimeError('source changed between actual listing and original test')
+        for expected in inputs['binaries']:
+            if file_meta(Path(expected['path'])) != {k: expected[k] for k in ('bytes', 'sha256')}:
+                raise RuntimeError('listed binary changed before the original test')
+        result.update(status='original-test-starting', listing_exact_selected_names=True)
+        run_ci_phase(repo, directory, source, deadline, 'test', records / 'diagnostic-eleven.json',
+                     ORIGINAL_TEST_COMMAND, 1, result)
+        for expected in inputs['binaries']:
+            if file_meta(Path(expected['path'])) != {k: expected[k] for k in ('bytes', 'sha256')}:
+                raise RuntimeError('binary changed between listing and original test completion')
+        result['status'] = 'original-test-returned-zero'
+        returncode = 0
+    except BaseException as error:
+        result['error'] = type(error).__name__ + ': ' + str(error)
+        if isinstance(error, OriginalBudgetExpired):
+            result['status'] = 'original-budget-expired'
+        else:
+            result['status'] = 'list-or-test-failed'
+        print('native list/run admission failed: ' + result['error'], flush=True)
+    finally:
+        try:
+            after = source_identity(repo)
