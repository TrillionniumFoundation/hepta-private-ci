+def run_ci_phase(repo, directory, source, deadline, label, execution_path,
+                 command, minimum_tests, result):
+    # The relative timeout is only the unspent part of the original fixed end.
+    # The unchanged controller starts its own command group and performs its
+    # original cleanup. No parent signal or additional process kill is used.
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        result['budget_expired'] = True
+        save_json(directory, label + '-not-started.json', {
+            'reason': 'original-budget-expired', 'absolute_end': deadline,
+            'remaining_seconds': remaining, 'command_started': False})
+        raise OriginalBudgetExpired('original 7200s end reached before ' + label)
+    controller = ['python3', str(repo / 'scripts/hepta_ci_exec.py'),
+                  '--timeout-seconds', format(remaining, '.17g'),
+                  '--minimum-tests', str(minimum_tests), '--output', str(execution_path),
+                  '--', *command]
+    launch = {'command': controller, 'actual_child_command': command,
+              'cwd': str(repo), 'started_at': now(),
+              'absolute_end_monotonic': deadline, 'remaining_seconds_passed': remaining,
+              'parent_signal_or_kill': False}
+    process = subprocess.Popen(controller, cwd=repo, env=os.environ.copy())
+    launch['pid'] = process.pid
+    save_json(directory, label + '-controller-launch.json', launch)
+    print(json.dumps({'phase': label + '-original-ci-controller', 'pid': process.pid,
+                      'remaining_seconds': remaining, 'absolute_end_monotonic': deadline}), flush=True)
+    controller_code = process.wait()
+    completed = time.monotonic()
+    terminal = {**launch, 'finished_at': now(), 'finished_monotonic': completed,
+                'returncode': controller_code, 'actual_process_exit_observed': True,
+                'execution_file_observed': execution_path.is_file()}
+    record = None
+    if execution_path.is_file():
+        terminal['original_execution'] = {'path': str(execution_path), **file_meta(execution_path)}
+        record = json.loads(execution_path.read_text(), object_pairs_hook=unique_object)
+        result[label + '_execution'] = record
+        if label == 'test':
+            result['native_test_child_started'] = type(record.get('command_exit_code')) is int
+    result[label + '_controller'] = terminal
+    save_json(directory, label + '-controller-terminal.json', terminal)
+    # Controller setup/identity I/O is not allowed to extend an acceptable run.
+    # If it used time outside the passed relative command timeout, retain its
+    # natural real record but fail this complete sequence at the fixed end.
+    if completed >= deadline:
+        result['budget_expired'] = True
+        raise OriginalBudgetExpired('original 7200s end reached during ' + label)
+    if controller_code != 0 or record is None:
+        raise RuntimeError(label + ' original CI controller failed or has no terminal record')
+    if (record.get('command') != command or record.get('status') != 'passed'
+            or record.get('exit_code') != 0 or record.get('command_exit_code') != 0
+            or record.get('returncode') != 0 or record.get('timed_out') is not False
+            or record.get('output_limit_exceeded') is not False
+            or record.get('source_sha') != source or record.get('tested_sha') != source
+            or record.get('lane') != 'source-head'
+            or record.get('before') != record.get('after')
+            or record.get('before', {}).get('commit') != source
+            or record.get('before', {}).get('dirty') is not False
+            or record.get('minimum_tests') != minimum_tests):
+        raise RuntimeError(label + ' original CI record did not satisfy its actual command/source gate')
+    return record
