diff --git a/codex-rs/hepta-automation/src/action_skill.rs b/codex-rs/hepta-automation/src/action_skill.rs
new file mode 100644
index 00000000..1698245a
--- /dev/null
+++ b/codex-rs/hepta-automation/src/action_skill.rs
@@ -0,0 +1,221 @@
+//! Goal-checked skills on the existing authorized TaskFlow effect boundary.
+//!
+//! This module declares a policy identity, not a policy interpreter or another
+//! executor. Final-use authorization, durable attempts, writer fencing and
+//! recovery admission remain owned by `AutomationStore`.
+
+use std::future::Future;
+
+use codex_hepta_contracts::ProviderEffectIntent;
+use codex_hepta_contracts::Sha256Digest;
+use serde::Deserialize;
+use serde::Serialize;
+use thiserror::Error;
+
+pub const ACTION_SKILL_SCHEMA_VERSION: u32 = 1;
+
+#[derive(Clone, Copy, Debug, Error, Eq, PartialEq)]
+pub enum ActionSkillError {
+    #[error("invalid action skill contract")]
+    Contract,
+    #[error("invalid or mismatched action skill invocation")]
+    Invocation,
+    #[error("action skill observation unavailable or mismatched")]
+    Observation,
+    #[error("action skill encoding failed")]
+    Encoding,
+}
+
+/// Per-call limits only. The durable TaskFlow owner must enforce cumulative
+/// work, attempt and recovery budgets; recreating a driver grants none of them.
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct ActionSkillBudgetV1 {
+    pub max_wire_bytes: u32,
+    pub provider_timeout_ms: u64,
+    pub observer_timeout_ms: u64,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ActionSkillRecoveryV1 {
+    /// Query the original identity. This driver never retries or compensates.
+    ReconcileOriginalIdentity,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct ActionSkillContractV1 {
+    pub schema_version: u32,
+    pub skill_id: String,
+    pub version: u32,
+    pub destination_id: String,
+    pub observer_id: String,
+    pub initiation_digest: Sha256Digest,
+    pub policy_digest: Sha256Digest,
+    pub termination_digest: Sha256Digest,
+    pub goal_digest: Sha256Digest,
+    pub budget: ActionSkillBudgetV1,
+    pub recovery: ActionSkillRecoveryV1,
+}
+
+impl ActionSkillContractV1 {
+    pub fn digest(&self) -> Result<Sha256Digest, ActionSkillError> {
+        if self.schema_version != ACTION_SKILL_SCHEMA_VERSION
+            || self.version == 0
+            || [&self.skill_id, &self.destination_id, &self.observer_id]
+                .into_iter()
+                .any(|id| id.is_empty() || id.len() > 128 || id.chars().any(char::is_whitespace))
+            || !(1..=1_048_576).contains(&self.budget.max_wire_bytes)
+            || !(1..=300_000).contains(&self.budget.provider_timeout_ms)
+            || !(1..=300_000).contains(&self.budget.observer_timeout_ms)
+            || [
+                &self.initiation_digest,
+                &self.policy_digest,
+                &self.termination_digest,
+                &self.goal_digest,
+            ]
+            .into_iter()
+            .any(|digest| Sha256Digest::parse(digest.as_str()).is_err())
+        {
+            return Err(ActionSkillError::Contract);
+        }
+        evidence_digest(b"hepta.action-skill.contract.v1\0", self)
+    }
+
+    /// Freeze these exact bytes into the existing TaskFlow payload/final-use
+    /// binding. The provider receives the whole envelope unchanged.
+    pub fn encode_invocation(&self, body: Vec<u8>) -> Result<Vec<u8>, ActionSkillError> {
+        let contract_digest = self.digest()?;
+        if body.len() > self.budget.max_wire_bytes as usize {
+            return Err(ActionSkillError::Invocation);
+        }
+        let invocation = ActionSkillInvocationV1 {
+            schema_version: ACTION_SKILL_SCHEMA_VERSION,
+            contract_digest,
+            destination_id: self.destination_id.clone(),
+            body,
+        };
+        let bytes = serde_json::to_vec(&invocation).map_err(|_| ActionSkillError::Encoding)?;
+        if bytes.len() > self.budget.max_wire_bytes as usize {
+            return Err(ActionSkillError::Invocation);
+        }
+        Ok(bytes)
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct ActionSkillInvocationV1 {
+    pub schema_version: u32,
+    pub contract_digest: Sha256Digest,
+    pub destination_id: String,
+    pub body: Vec<u8>,
+}
+
+/// The durable effect intent digest includes the attempt, policy generation,
+/// operation, subject and scope. It does not confer current writer authority.
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct ActionSkillBindingV1 {
+    pub provider_intent: ProviderEffectIntent,
+    pub effect_intent_digest: Sha256Digest,
+    pub contract_digest: Sha256Digest,
+    pub destination_id: String,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ActionConditionV1 {
+    Met,
+    Unmet,
+    Unknown,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(tag = "state", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ActionExecutionStateV1 {
+    NotStarted,
+    Running,
+    WaitingForInput,
+    Returned { exit_code: Option<i32> },
+    Interrupted,
+    Unknown,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ActionGoalStateV1 {
+    Satisfied,
+    Unsatisfied,
+    Partial,
+    Unknown,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ActionCancellationStateV1 {
+    NotRequested,
+    Requested,
+    Confirmed,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct ActionInitiationObservationV1 {
+    pub binding: ActionSkillBindingV1,
+    pub observer_id: String,
+    pub evidence_digest: Sha256Digest,
+    pub condition: ActionConditionV1,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct ActionSkillObservationV1 {
+    pub binding: ActionSkillBindingV1,
+    pub provider_receipt_digest: Sha256Digest,
+    pub observer_id: String,
+    pub evidence_digest: Sha256Digest,
+    /// Independent proof of no effect and no possible late commit for this
+    /// identity. A missing row, process exit or cancellation ACK is not proof.
+    pub absence_proof_digest: Option<Sha256Digest>,
+    pub execution: ActionExecutionStateV1,
+    pub cancellation: ActionCancellationStateV1,
+    pub termination: ActionConditionV1,
+    pub goal: ActionGoalStateV1,
+}
+
+/// Trusted, independently provisioned, read-only destination observer. The
+/// host pins this implementation and its identity; matching a string is not
+/// authentication. Implementations evaluate the contract's predicates against
+/// authoritative state, never infer them from a tool return or echo a request.
+///
+/// Before returning, retain the evidence addressed by `evidence_digest`,
+/// including partial subeffects, input-reader identity/epoch and cancellation
+/// facts, in the destination observation owner. TaskFlow persists a digest, not
+/// these details. Lookup must be able to observe them after either owner restarts.
+/// Index initiation and subsequent evidence by the entire binding for recovery.
+pub trait ActionSkillObserver: Send + Sync {
+    fn observer_id(&self) -> &str;
+
+    fn check_initiation(
+        &self,
+        binding: &ActionSkillBindingV1,
+        body: &[u8],
+    ) -> impl Future<Output = Result<ActionInitiationObservationV1, ActionSkillError>> + Send;
+
+    fn observe(
+        &self,
+        binding: &ActionSkillBindingV1,
+        provider_receipt_digest: &Sha256Digest,
+    ) -> impl Future<Output = Result<ActionSkillObservationV1, ActionSkillError>> + Send;
+}
+
+pub(crate) fn evidence_digest<T: Serialize>(
+    domain: &[u8],
+    value: &T,
+) -> Result<Sha256Digest, ActionSkillError> {
+    let mut bytes = domain.to_vec();
+    bytes.extend(serde_json::to_vec(value).map_err(|_| ActionSkillError::Encoding)?);
+    Ok(Sha256Digest::for_bytes(&bytes))
+}
diff --git a/codex-rs/hepta-automation/src/action_skill_driver.rs b/codex-rs/hepta-automation/src/action_skill_driver.rs
new file mode 100644
index 00000000..50cd4ff7
--- /dev/null
+++ b/codex-rs/hepta-automation/src/action_skill_driver.rs
@@ -0,0 +1,294 @@
+//! An authorized driver decorator, not an authority or a durable executor.
+
+use std::time::Duration;
+
+use codex_hepta_contracts::ProviderEffectAdapter;
+use codex_hepta_contracts::ProviderEffectIdempotencyCapability;
+use codex_hepta_contracts::ProviderEffectIntent;
+use codex_hepta_contracts::ProviderEffectKey;
+use codex_hepta_contracts::Sha256Digest;
+
+use crate::AsyncAuthorizedEffectDriver;
+use crate::AuthorizedEffectDriverError;
+use crate::AuthorizedEffectFuture;
+use crate::AuthorizedEffectOutcome;
+use crate::AuthorizedEffectPending;
+use crate::AuthorizedEffectProviderReceipt;
+use crate::AuthorizedProviderEffectLookup;
+use crate::AuthorizedProviderEffectRequest;
+use crate::ProviderEffectTaskFlowDriver;
+use crate::action_skill::ACTION_SKILL_SCHEMA_VERSION;
+use crate::action_skill::ActionConditionV1;
+use crate::action_skill::ActionExecutionStateV1;
+use crate::action_skill::ActionGoalStateV1;
+use crate::action_skill::ActionSkillBindingV1;
+use crate::action_skill::ActionSkillContractV1;
+use crate::action_skill::ActionSkillError;
+use crate::action_skill::ActionSkillInvocationV1;
+use crate::action_skill::ActionSkillObservationV1;
+use crate::action_skill::ActionSkillObserver;
+use crate::action_skill::evidence_digest;
+
+/// Use through `AutomationStore::execute_authorized_taskflow_effect_async`.
+/// The existing owner persists the intent, verifies final use and fences the
+/// result. This decorator neither authorizes dispatch nor retries it.
+pub struct GoalCheckedActionSkillDriver<A, O> {
+    contract: ActionSkillContractV1,
+    contract_digest: Sha256Digest,
+    provider: ProviderEffectTaskFlowDriver<A>,
+    observer: O,
+}
+
+impl<A: ProviderEffectAdapter, O: ActionSkillObserver> GoalCheckedActionSkillDriver<A, O> {
+    pub fn new(
+        contract: ActionSkillContractV1,
+        adapter: A,
+        observer: O,
+    ) -> Result<Self, ActionSkillError> {
+        let contract_digest = contract.digest()?;
+        if observer.observer_id() != contract.observer_id {
+            return Err(ActionSkillError::Contract);
+        }
+        let provider = ProviderEffectTaskFlowDriver::new(contract.destination_id.clone(), adapter)
+            .map_err(|_| ActionSkillError::Contract)?;
+        Ok(Self {
+            contract,
+            contract_digest,
+            provider,
+            observer,
+        })
+    }
+
+    fn bind_invocation(
+        &self,
+        effect_intent_digest: &Sha256Digest,
+        provider_intent: &ProviderEffectIntent,
+        wire_payload: &[u8],
+    ) -> Result<(ActionSkillBindingV1, ActionSkillInvocationV1), ActionSkillError> {
+        if wire_payload.len() > self.contract.budget.max_wire_bytes as usize
+            || provider_intent.validate().is_err()
+            || Sha256Digest::parse(effect_intent_digest.as_str()).is_err()
+            || Sha256Digest::for_bytes(wire_payload) != provider_intent.payload_sha256
+        {
+            return Err(ActionSkillError::Invocation);
+        }
+        let invocation: ActionSkillInvocationV1 =
+            serde_json::from_slice(wire_payload).map_err(|_| ActionSkillError::Invocation)?;
+        if invocation.schema_version != ACTION_SKILL_SCHEMA_VERSION
+            || invocation.contract_digest != self.contract_digest
+            || invocation.destination_id != self.contract.destination_id
+        {
+            return Err(ActionSkillError::Invocation);
+        }
+        Ok((
+            ActionSkillBindingV1 {
+                provider_intent: provider_intent.clone(),
+                effect_intent_digest: effect_intent_digest.clone(),
+                contract_digest: self.contract_digest.clone(),
+                destination_id: self.contract.destination_id.clone(),
+            },
+            invocation,
+        ))
+    }
+
+    /// Reuse the frozen original bytes, including after restart. This prevents
+    /// a new contract from reinterpreting the same durable pending payload.
+    /// Ordinary NotFound is unresolved: key/status capability alone cannot
+    /// prove that no in-flight dispatch can commit later.
+    pub async fn lookup(
+        &self,
+        pending: &AuthorizedEffectPending,
+        original_wire_payload: &[u8],
+    ) -> AuthorizedProviderEffectLookup {
+        let Ok(binding) = self.bind_pending(pending, original_wire_payload) else {
+            return AuthorizedProviderEffectLookup::Unresolved;
+        };
+        let Ok(AuthorizedProviderEffectLookup::Observed(provider)) = tokio::time::timeout(
+            Duration::from_millis(self.contract.budget.provider_timeout_ms),
+            self.provider.lookup(pending),
+        )
+        .await
+        else {
+            return AuthorizedProviderEffectLookup::Unresolved;
+        };
+        let receipt = self.check_goal(&binding, provider).await;
+        match receipt.outcome {
+            AuthorizedEffectOutcome::Succeeded | AuthorizedEffectOutcome::Failed => {
+                AuthorizedProviderEffectLookup::Observed(receipt)
+            }
+            AuthorizedEffectOutcome::Indeterminate => AuthorizedProviderEffectLookup::Unresolved,
+        }
+    }
+
+    /// Read current waiting, partial-effect and cancellation facts without
+    /// settling the durable attempt or granting another dispatch. When provider
+    /// status is unavailable, the provider digest records that unresolved query.
+    pub async fn observe_pending(
+        &self,
+        pending: &AuthorizedEffectPending,
+        original_wire_payload: &[u8],
+    ) -> Result<ActionSkillObservationV1, ActionSkillError> {
+        let binding = self.bind_pending(pending, original_wire_payload)?;
+        let provider = match tokio::time::timeout(
+            Duration::from_millis(self.contract.budget.provider_timeout_ms),
+            self.provider.lookup(pending),
+        )
+        .await
+        {
+            Ok(AuthorizedProviderEffectLookup::Observed(receipt)) => receipt,
+            _ => unresolved(&binding, &Sha256Digest::for_bytes(b"status_unresolved")),
+        };
+        self.read_observation(&binding, &provider.receipt_digest)
+            .await
+    }
+
+    fn bind_pending(
+        &self,
+        pending: &AuthorizedEffectPending,
+        wire_payload: &[u8],
+    ) -> Result<ActionSkillBindingV1, ActionSkillError> {
+        if pending.destination_id != self.contract.destination_id {
+            return Err(ActionSkillError::Invocation);
+        }
+        let logical_id = format!("taskflow:{}:{}", pending.run_id, pending.step_id);
+        let key = ProviderEffectKey::for_logical_effect(&pending.destination_id, &logical_id)
+            .map_err(|_| ActionSkillError::Invocation)?;
+        let intent = ProviderEffectIntent::new(key, pending.payload_digest.clone());
+        self.bind_invocation(&pending.intent_digest, &intent, wire_payload)
+            .map(|(binding, _)| binding)
+    }
+
+    async fn read_observation(
+        &self,
+        binding: &ActionSkillBindingV1,
+        provider_digest: &Sha256Digest,
+    ) -> Result<ActionSkillObservationV1, ActionSkillError> {
+        let observation = tokio::time::timeout(
+            Duration::from_millis(self.contract.budget.observer_timeout_ms),
+            self.observer.observe(binding, provider_digest),
+        )
+        .await
+        .map_err(|_| ActionSkillError::Observation)??;
+        if observation.binding != *binding
+            || observation.provider_receipt_digest != *provider_digest
+            || observation.observer_id != self.contract.observer_id
+            || Sha256Digest::parse(observation.evidence_digest.as_str()).is_err()
+            || observation
+                .absence_proof_digest
+                .as_ref()
+                .is_some_and(|digest| Sha256Digest::parse(digest.as_str()).is_err())
+        {
+            return Err(ActionSkillError::Observation);
+        }
+        Ok(observation)
+    }
+
+    async fn check_goal(
+        &self,
+        binding: &ActionSkillBindingV1,
+        provider: AuthorizedEffectProviderReceipt,
+    ) -> AuthorizedEffectProviderReceipt {
+        let Ok(observation) = self
+            .read_observation(binding, &provider.receipt_digest)
+            .await
+        else {
+            return unresolved(binding, &provider.receipt_digest);
+        };
+        let Ok(receipt_digest) =
+            evidence_digest(b"hepta.action-skill.observation.v1\0", &observation)
+        else {
+            return unresolved(binding, &provider.receipt_digest);
+        };
+        let terminal = matches!(
+            observation.execution,
+            ActionExecutionStateV1::Returned { .. } | ActionExecutionStateV1::Interrupted
+        );
+        // Exit code and cancellation requests do not determine business effect.
+        let outcome = if provider.outcome == AuthorizedEffectOutcome::Succeeded
+            && terminal
+            && observation.termination == ActionConditionV1::Met
+            && observation.goal == ActionGoalStateV1::Satisfied
+        {
+            AuthorizedEffectOutcome::Succeeded
+        } else if provider.outcome == AuthorizedEffectOutcome::Failed
+            && observation.absence_proof_digest.is_some()
+            && observation.goal == ActionGoalStateV1::Unsatisfied
+            && observation.termination == ActionConditionV1::Met
+            && (terminal || observation.execution == ActionExecutionStateV1::NotStarted)
+        {
+            AuthorizedEffectOutcome::Failed
+        } else {
+            AuthorizedEffectOutcome::Indeterminate
+        };
+        AuthorizedEffectProviderReceipt {
+            outcome,
+            receipt_digest,
+        }
+    }
+}
+
+impl<A: ProviderEffectAdapter, O: ActionSkillObserver> AsyncAuthorizedEffectDriver
+    for GoalCheckedActionSkillDriver<A, O>
+{
+    fn dispatch<'a>(
+        &'a mut self,
+        request: AuthorizedProviderEffectRequest<'a>,
+    ) -> AuthorizedEffectFuture<'a> {
+        Box::pin(async move {
+            if request.intent.destination_id != self.contract.destination_id
+                || self.provider.adapter().capability()
+                    != ProviderEffectIdempotencyCapability::KeyAndStatusLookup
+            {
+                return Err(AuthorizedEffectDriverError::BeforeProviderContact);
+            }
+            let (binding, invocation) = self
+                .bind_invocation(
+                    request.intent_digest,
+                    &request.provider_intent,
+                    request.wire_payload,
+                )
+                .map_err(|_| AuthorizedEffectDriverError::BeforeProviderContact)?;
+            let initiation = tokio::time::timeout(
+                Duration::from_millis(self.contract.budget.observer_timeout_ms),
+                self.observer.check_initiation(&binding, &invocation.body),
+            )
+            .await;
+            let Ok(Ok(initiation)) = initiation else {
+                return Err(AuthorizedEffectDriverError::BeforeProviderContact);
+            };
+            if initiation.binding != binding
+                || initiation.observer_id != self.contract.observer_id
+                || initiation.condition != ActionConditionV1::Met
+                || Sha256Digest::parse(initiation.evidence_digest.as_str()).is_err()
+            {
+                return Err(AuthorizedEffectDriverError::BeforeProviderContact);
+            }
+            // No error after invoking the downstream driver can become local
+            // absence proof, including its own error or a dropped I/O future.
+            let provider = match tokio::time::timeout(
+                Duration::from_millis(self.contract.budget.provider_timeout_ms),
+                self.provider.dispatch(request),
+            )
+            .await
+            {
+                Ok(Ok(receipt)) => receipt,
+                _ => unresolved(&binding, &Sha256Digest::for_bytes(b"provider_unresolved")),
+            };
+            Ok(self.check_goal(&binding, provider).await)
+        })
+    }
+}
+
+fn unresolved(
+    binding: &ActionSkillBindingV1,
+    provider_digest: &Sha256Digest,
+) -> AuthorizedEffectProviderReceipt {
+    AuthorizedEffectProviderReceipt {
+        outcome: AuthorizedEffectOutcome::Indeterminate,
+        receipt_digest: evidence_digest(
+            b"hepta.action-skill.unresolved.v1\0",
+            &(binding, provider_digest),
+        )
+        .unwrap_or_else(|_| binding.effect_intent_digest.clone()),
+    }
+}
diff --git a/codex-rs/hepta-automation/src/action_skill_tests.rs b/codex-rs/hepta-automation/src/action_skill_tests.rs
new file mode 100644
index 00000000..ebcb27b1
--- /dev/null
+++ b/codex-rs/hepta-automation/src/action_skill_tests.rs
@@ -0,0 +1,301 @@
+use std::sync::Arc;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+use codex_hepta_contracts::ProviderEffectAck;
+use codex_hepta_contracts::ProviderEffectAckStatus;
+use codex_hepta_contracts::ProviderEffectAdapter;
+use codex_hepta_contracts::ProviderEffectDispatch;
+use codex_hepta_contracts::ProviderEffectFuture;
+use codex_hepta_contracts::ProviderEffectIdempotencyCapability;
+use codex_hepta_contracts::ProviderEffectIntent;
+use codex_hepta_contracts::ProviderEffectKey;
+use codex_hepta_contracts::ProviderEffectLookup;
+use codex_hepta_contracts::Sha256Digest;
+use pretty_assertions::assert_eq;
+
+use crate::*;
+
+struct ProbeProvider {
+    calls: Arc<AtomicUsize>,
+    status: ProviderEffectAckStatus,
+}
+
+impl ProviderEffectAdapter for ProbeProvider {
+    fn capability(&self) -> ProviderEffectIdempotencyCapability {
+        ProviderEffectIdempotencyCapability::KeyAndStatusLookup
+    }
+
+    fn dispatch<'a>(
+        &'a self,
+        intent: &'a ProviderEffectIntent,
+    ) -> ProviderEffectFuture<'a, ProviderEffectDispatch> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        Box::pin(async move {
+            ProviderEffectDispatch::Ack(ProviderEffectAck::new(
+                intent.key.clone(),
+                intent.payload_sha256.clone(),
+                Sha256Digest::for_bytes(b"provider-operation"),
+                self.status,
+            ))
+        })
+    }
+
+    fn lookup<'a>(
+        &'a self,
+        _key: &'a ProviderEffectKey,
+    ) -> ProviderEffectFuture<'a, ProviderEffectLookup> {
+        Box::pin(async { ProviderEffectLookup::NotFound })
+    }
+}
+
+#[derive(Clone, Copy)]
+enum ObservationCase {
+    Satisfied,
+    Error,
+    OldAttempt,
+    WrongContract,
+    WrongPayload,
+    Partial,
+    Waiting,
+}
+
+struct ProbeObserver(ObservationCase);
+
+impl ActionSkillObserver for ProbeObserver {
+    fn observer_id(&self) -> &str {
+        "independent-observer"
+    }
+
+    async fn check_initiation(
+        &self,
+        binding: &ActionSkillBindingV1,
+        _body: &[u8],
+    ) -> Result<ActionInitiationObservationV1, ActionSkillError> {
+        Ok(ActionInitiationObservationV1 {
+            binding: binding.clone(),
+            observer_id: self.observer_id().to_string(),
+            evidence_digest: Sha256Digest::for_bytes(b"initiation"),
+            condition: ActionConditionV1::Met,
+        })
+    }
+
+    async fn observe(
+        &self,
+        binding: &ActionSkillBindingV1,
+        provider_receipt_digest: &Sha256Digest,
+    ) -> Result<ActionSkillObservationV1, ActionSkillError> {
+        let mut observed = ActionSkillObservationV1 {
+            binding: binding.clone(),
+            provider_receipt_digest: provider_receipt_digest.clone(),
+            observer_id: self.observer_id().to_string(),
+            evidence_digest: Sha256Digest::for_bytes(b"goal"),
+            absence_proof_digest: None,
+            execution: ActionExecutionStateV1::Returned { exit_code: Some(0) },
+            cancellation: ActionCancellationStateV1::Requested,
+            termination: ActionConditionV1::Met,
+            goal: ActionGoalStateV1::Satisfied,
+        };
+        match self.0 {
+            ObservationCase::Satisfied => {}
+            ObservationCase::Error => return Err(ActionSkillError::Observation),
+            ObservationCase::OldAttempt => {
+                observed.binding.effect_intent_digest = Sha256Digest::for_bytes(b"old-attempt")
+            }
+            ObservationCase::WrongContract => {
+                observed.binding.contract_digest = Sha256Digest::for_bytes(b"other-skill")
+            }
+            ObservationCase::WrongPayload => {
+                observed.binding.provider_intent.payload_sha256 =
+                    Sha256Digest::for_bytes(b"other-payload")
+            }
+            ObservationCase::Partial => observed.goal = ActionGoalStateV1::Partial,
+            ObservationCase::Waiting => {
+                observed.execution = ActionExecutionStateV1::WaitingForInput
+            }
+        }
+        Ok(observed)
+    }
+}
+
+fn contract() -> ActionSkillContractV1 {
+    ActionSkillContractV1 {
+        schema_version: ACTION_SKILL_SCHEMA_VERSION,
+        skill_id: "create-task".to_string(),
+        version: 1,
+        destination_id: "automation-test".to_string(),
+        observer_id: "independent-observer".to_string(),
+        initiation_digest: Sha256Digest::for_bytes(b"initiate"),
+        policy_digest: Sha256Digest::for_bytes(b"policy"),
+        termination_digest: Sha256Digest::for_bytes(b"terminal"),
+        goal_digest: Sha256Digest::for_bytes(b"goal"),
+        budget: ActionSkillBudgetV1 {
+            max_wire_bytes: 4096,
+            provider_timeout_ms: 1000,
+            observer_timeout_ms: 1000,
+        },
+        recovery: ActionSkillRecoveryV1::ReconcileOriginalIdentity,
+    }
+}
+
+fn effect(wire: &[u8]) -> AuthorizedEffectIntent {
+    AuthorizedEffectIntent {
+        run_id: "run".to_string(),
+        step_id: "step".to_string(),
+        attempt: 1,
+        operation_id: "operation".to_string(),
+        subject_id: "agent".to_string(),
+        destination_id: "automation-test".to_string(),
+        payload_digest: Sha256Digest::for_bytes(wire),
+        final_use_scope_digest: Sha256Digest::for_bytes(b"scope"),
+        policy_generation: 1,
+        expected_predecessor_digest: None,
+        dependencies: Vec::new(),
+        compensation_for: None,
+    }
+}
+
+// Decorator-level probes only; the ACT-1 integration suite uses the durable
+// AutomationStore owner and independent final-use authority.
+async fn invoke(
+    driver: &mut GoalCheckedActionSkillDriver<ProbeProvider, ProbeObserver>,
+    intent: &AuthorizedEffectIntent,
+    wire: &[u8],
+) -> Result<AuthorizedEffectProviderReceipt, AuthorizedEffectDriverError> {
+    let digest = intent.digest().expect("intent");
+    let operation = intent.operation_intent_v1().expect("operation");
+    let binding = intent.final_use_binding().expect("binding");
+    let key = ProviderEffectKey::for_logical_effect(&intent.destination_id, "taskflow:run:step")
+        .expect("key");
+    driver
+        .dispatch(AuthorizedProviderEffectRequest {
+            operation_intent: &operation,
+            intent,
+            intent_digest: &digest,
+            binding: &binding,
+            provider_intent: ProviderEffectIntent::new(key, intent.payload_digest.clone()),
+            wire_payload: wire,
+        })
+        .await
+}
