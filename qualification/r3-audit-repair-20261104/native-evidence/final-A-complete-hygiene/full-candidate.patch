+        assert_eq!(error.kind(), std::io::ErrorKind::NotConnected);
+        assert_eq!(error.raw_os_error(), Some(libc::ENOTCONN));
+        let observed = interpret_agent_drain_response(&identity, 18, Err(error));
+        eprintln!(
