      "case": "sqlite::native_custody_tests::guarded_pool_retains_custody_when_native_open_is_cancelled",
      "description": "Real sqlite3_auto_extension native-open callback is held while the actual guarded pool future is polled then cancelled; parent physical File lock must remain blocked at gate_status=0, then release after child native cleanup."
    },
    {
      "case": "sqlite::native_custody_tests::coordinated_pool_retains_custody_when_initial_pragma_is_cancelled",
      "description": "Real progress callback during initial PRAGMA is held while coordinated pool opening is polled then cancelled; checkout callback must not run; the same physical held→released lock protocol applies."
    },
    {
      "case": "production_writer::objective_sender::connection_custody_tests::native_custody_survives_removal_of_both_registered_anchors",
      "description": "Detach live Memory connection, close store/pool, verify SELECT and exclusive lock denial, remove actual commit hook and reserved collation, verify SELECT and exclusive lock denial again, then actual close permits exclusive locking."
    }
