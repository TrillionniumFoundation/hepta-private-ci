ins_key(\"--admission-bits\")\n                    || args.contains_key(\"--admission-ttl-ms\"))\n            {\n                return Err(\"ADMISSION_PROFILE_REQUIRED\".into());\n            }\n            let admission = if protected {\n                Some(ingress::AdmissionPolicy::new(\n                    u8::try_from(number(&args, \"--admission-bits\", 16)?)\n                        .map_err(|_| Error::from(\"ADMISSION_POLICY\"))?,\n                    Duration::from_millis(number(&args, \"--admission-ttl-ms\", 2000)?),\n                )?)\n            } else {\n                None\n            };\n            let address = args\n                .get(\"--listen\")\n                .map(String::as_str)\n                .unwrap_or(\"127.0.0.1:0\");\n            let address: std::net::SocketAddr =\n                address.parse().map_err(|_| Error::from(\"LISTEN_ADDRESS\"))?;\n            let authentication = authenticated_server(&args)?;\n            if authentication.is_none() && !address.ip().is_loopback() {\n                return Err(\"DEVELOPMENT_LOOPBACK_ONLY\".into());\n            }\n            let listener = std::net::TcpListener::bind(address)?;\n            let server_public = authentication\n                .as_ref()\n                .map(|value| value.public_key().to_owned());\n            println!(\n                \"{}\",\n                json!({\n                    \"event\":\"listening\",\n                    \"address\":listener.local_addr()?.to_string(),\n                    \"state\":node.stats()?,\n                    \"scope\":if authentication.is_some(){\"authenticated-development-private\"}else{\"native-development-loopback\"},\n                    \"server_public\":server_public,\n                    \"admission_profile\":if protected {\"connection-work-v1\"} else {\"legacy-development\"},\n                    \"confidentiality\":false,\n                    \"production_activation\":false\n                })\n            );\n            std::io::stdout().flush()?;\n            let lifetime = Duration::from_secs(number(&args, \"--seconds\", 30)?);\n            let stop = Arc::new(AtomicBool::new(false));\n            let metrics = match (authentication, admission) {\n                (Some(authentication), Some(policy)) => ingress::serve_authenticated_protected(\n                    listener,\n                    node,\n                    lifetime,\n                    stop,\n                    authentication,\n                    policy,\n                )?,\n                (None, Some(policy)) => {\n                    ingress::serve_protected(listener, node, lifetime, stop, policy)?\n                }\n                (Some(authentication), None) => {\n                    ingress::serve_authenticated(listener, node, lifetime, stop, authentication)?\n                }\n                (None, None) => ingress::serve(listener, node, lifetime, stop)?,\n            };\n            serde_json::to_value(metrics)?\n        }\n        _ => return Err(\"UNKNOWN_COMMAND\".into()),\n    };\n    Ok(\n        json!({\"result\":value,\"clock_scope\":if args.contains_key(\"--logical-now\"){\"logical-test\"}else{\"local-wall\"},\"production_activation\":false}),\n    )\n}\n/// Render untrusted diagnostics as one terminal line without changing the\n/// underlying error, its typed identity, or any authenticated protocol bytes.\nfn cli_error_line(error: &impl std::fmt::Display) -> String {\n    let mut line = String::new();\n    for character in error.to_string().chars() {\n        if character.is_control() {\n            line.extend(character.escape_default());\n        } else {\n            line.push(character);\n        }\n    }\n    line\n}\n\nfn main() {\n    match run() {\n        Ok(value) => {\n            let refused = value.get(\"ok\") == Some(&Value::Bool(false));\n            println!(\"{value}\");\n            // Preserve the authenticated denial as structured stdout while making\n            // the command unsuccessful for shell callers and campaign supervisors.\n            if refused {\n                std::process::exit(2);\n            }\n        }\n        Err(error) => {\n            eprintln!(\"{}\", cli_error_line(&error));\n            std::process::exit(2);\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use std::os::unix::fs::{symlink, PermissionsExt};\n\n    #[test]\n    fn cli_error_line_escapes_remote_log_and_terminal_controls() {\n        let message =\n            \"REMOTE_TERMINAL:denied\\nforged entry\\r\\t\\u{1b}[2J\\u{7f}\\u{85}\\u{9b}31m\\u{9d}title\";\n        let error = Error::from(message);\n        let original_kind = error.kind();\n        let original_code = error.code();\n        assert_eq!(\n            cli_error_line(&error),\n            r\"REMOTE_TERMINAL:denied\\nforged entry\\r\\t\\u{1b}[2J\\u{7f}\\u{85}\\u{9b}31m\\u{9d}title\"\n        );\n        assert_eq!(error.to_string(), message);\n        assert_eq!(error.kind(), original_kind);\n        assert_eq!(error.code(), original_code);\n    }\n\n    #[test]\n    fn cli_error_line_removes_every_c0_del_and_c1_control() {\n        let controls = (0..=0x1f).chain(0x7f..=0x9f);\n        for codepoint in controls {\n            let character = char::from_u32(codepoint).unwrap();\n            let message = format!(\"before{character}after\");\n            let rendered = cli_error_line(&message);\n            assert!(!rendered.chars().any(char::is_control));\n            assert!(rendered.starts_with(\"before\\\\\"));\n            assert!(rendered.ends_with(\"after\"));\n            assert_ne!(rendered, message);\n        }\n    }\n\n    #[test]\n    fn cli_error_line_preserves_ordinary_unicode_quotes_and_backslashes() {\n        let message = r#\"拒绝: café é 🦀 'quoted' \"double\" C:\\keys\\node.key literal\\n\"#;\n        assert_eq!(cli_error_line(&message), message);\n        let error = Error::new(trnm_pon_node::ErrorCode::PublicMutationCpuBudget);\n        assert_eq!(cli_error_line(&error), \"PUBLIC_MUTATION_CPU_BUDGET\");\n        assert_eq!(error.to_string(), \"PUBLIC_MUTATION_CPU_BUDGET\");\n        assert!(error.is(trnm_pon_node::ErrorCode::PublicMutationCpuBudget));\n    }\n\n    #[test]\n    fn public_sync_cannot_use_loopback_proxy_to_avoid_fixed_host_cpu_owner() {\n        use trnm_pon_node::host_kernel_parent::{\n            require_host_kernel_budget, FIXED_PUBLIC_KERNEL_PARENT,\n        };\n        let loopback: std::net::SocketAddr = \"127.0.0.1:11223\".parse().unwrap();\n        // This preserved plain-developer profile never claims a public\n        // network resource budget or public-network readiness.\n        assert!(matches!(sync_host_kernel_owner(loopback, false), Ok(None)));\n        let original = require_host_kernel_budget(loopback, Some(FIXED_PUBLIC_KERNEL_PARENT));\n        let protected = sync_host_kernel_owner(loopback, true);\n        match (protected, original) {\n            (Ok(Some(a)), Ok(Some(b))) => {\n                a.verify().unwrap();\n                b.verify().unwrap();\n            }\n            (Err(left), Err(right)) => {\n                assert_eq!(left.to_string(), right.to_string());\n            }\n            _ => panic!(\"public History cannot bypass fixed Host resource owner\"),\n        }\n        // Signed authenticated and public V2/V3 transports are untrusted\n        // sources regardless of their loopback destination or caller identity.\n        let mut args = BTreeMap::new();\n        assert!(!priced_sync_context(&args));\n        for profile in [\n            ingress::public_v2::PROFILE,\n            ingress::public_v3::PROFILE,\n            ingress::public_v3::GROWTH_PROFILE,\n        ] {\n            args.insert(\"--admission-profile\".into(), profile.into());\n            assert!(priced_sync_context(&args));\n        }\n        args.clear();\n        for option in [\"--auth-secret\", \"--server-public\", \"--session-generation\"] {\n            args.insert(option.into(), \"test-selection\".into());\n            assert!(priced_sync_context(&args));\n            args.clear();\n        }\n    }\n\n    #[test]\n    fn pinned_peer_remote_history_must_share_fixed_host_even_with_loopback_listener() {\n        let listen: std::net::SocketAddr = \"127.0.0.1:44222\".parse().unwrap();\n        // A genuinely local V3 development listener without a poller keeps\n        // the existing original exemption (not a public WAN qualification).\n        assert!(matches!(\n            pinned_peer_service_host_kernel(listen, None, false),\n            Ok(None)\n        ));\n        let strict = pinned_peer_service_host_kernel(listen, None, true);\n        let original = host_public_guard::require_host_kernel_budget(\n            listen,\n            Some(trnm_pon_node::host_kernel_parent::FIXED_PUBLIC_KERNEL_PARENT),\n        );\n        match (strict, original) {\n            (Ok(Some(a)), Ok(Some(b))) => {\n                a.verify().unwrap();\n                b.verify().unwrap();\n            }\n            (Err(a), Err(b)) => assert_eq!(a.to_string(), b.to_string()),\n            _ => panic!(\"pinned peer cannot evade fixed host by local listener\"),\n        }\n        // A configured foreign parent cannot create an alternative allowance;\n        // the original fixed-parent validation remains authoritative.\n        assert!(pinned_peer_service_host_kernel(\n            listen,\n            Some(\"/sys/fs/cgroup/not-the-approved-parent.slice\"),\n            true\n        )\n        .is_err());\n    }\n\n    #[test]\n    fn host_kernel_parent_is_not_silently_accepted_for_other_profiles() {\n        let mut opts = BTreeMap::new();\n        opts.insert(\n            \"--host-kernel-parent\".into(),\n            \"/sys/fs/cgroup/system.slice/trnmpondev.slice\".into(),\n        );\n        assert_eq!(\n            validate_host_kernel_profile(\"serve\", &opts)\n                .unwrap_err()\n                .to_string(),\n            \"PUBLIC_HOST_KERNEL_PROFILE\"\n        );\n        opts.insert(\"--public-development-network\".into(), \"true\".into());\n        opts.insert(\n            \"--admission-profile\".into(),\n            ingress::public_v2::PROFILE.into(),\n        );\n        assert_eq!(\n            validate_host_kernel_profile(\"serve\", &opts)\n                .unwrap_err()\n                .to_string(),\n            \"PUBLIC_HOST_KERNEL_PROFILE\"\n        );\n        opts.insert(\n            \"--admission-profile\".into(),\n            ingress::public_v3::PROFILE.into(),\n        );\n        assert!(validate_host_kernel_profile(\"serve\", &opts).is_ok());\n        assert_eq!(\n            validate_host_kernel_profile(\"head\", &opts)\n                .unwrap_err()\n                .to_string(),\n            \"PUBLIC_HOST_KERNEL_PROFILE\"\n        );\n    }\n\n    #[test]\n    fn request_observation_output_has_a_closed_byte_limit() {\n        let mut bytes = BoundedObservationBuffer(Vec::new());\n        bytes\n            .write_all(&vec![b'x'; MAX_REQUEST_OBSERVATION_OUTPUT_BYTES])\n            .unwrap();\n        assert_eq!(bytes.0.len(), MAX_REQUEST_OBSERVATION_OUTPUT_BYTES);\n        assert!(bytes.write_all(b\"\\n\").is_err());\n        assert_eq!(bytes.0.len(), MAX_REQUEST_OBSERVATION_OUTPUT_BYTES);\n    }\n\n    #[test]\n    fn request_observation_descriptor_refuses_special_permission_bits() {\n        let temp = tempfile::tempdir().unwrap();\n        let file = File::create(temp.path().join(\"new-output\")).unwrap();\n        file.set_permissions(std::fs::Permissions::from_mode(0o600))\n            .unwrap();\n        assert!(check_request_observation_descriptor(&file).is_ok());\n        file.set_permissions(std::fs::Permissions::from_mode(0o4600))\n            .unwrap();\n        assert!(check_request_observation_descriptor(&file).is_err());\n    }\n\n    #[test]\n    fn test_authentication_configuration_uses_the_opened_file_identity() {\n        let temp = tempfile::tempdir().unwrap();\n        let key = temp.path().join(\"peer.key\");\n        let seed = \"11\".repeat(32);\n        std::fs::write(&key, format!(\"{seed}\\n\")).unwrap();\n        std::fs::set_permissions(&key, std::fs::Permissions::from_mode(0o600)).unwrap();\n        assert!(secret_identity(key.to_str().unwrap()).is_ok());\n\n        let link = temp.path().join(\"peer-link.key\");\n        symlink(&key, &link).unwrap();\n        assert_eq!(\n            secret_identity(link.to_str().unwrap())\n                .err()\n                .unwrap()\n                .to_string(),\n            \"AUTH_SECRET_FILE\"\n        );\n\n        let public = temp.path().join(\"public.key\");\n        std::fs::write(&public, format!(\"{seed}\\n\")).unwrap();\n        std::fs::set_permissions(&public, std::fs::Permissions::from_mode(0o644)).unwrap();\n        assert_eq!(\n            secret_identity(public.to_str().unwrap())\n                .err()\n                .unwrap()\n                .to_string(),\n            \"AUTH_SECRET_FILE\"\n        );\n\n        let hard = temp.path().join(\"hard.key\");\n        std::fs::hard_link(&key, &hard).unwrap();\n        assert_eq!(\n            secret_identity(hard.to_str().unwrap())\n                .err()\n                .unwrap()\n                .to_string(),\n            \"AUTH_SECRET_FILE\"\n        );\n\n        let roster = temp.path().join(\"peers.json\");\n        let peer = ingress::DevelopmentIdentity::from_secret_hex(&\"22\".repeat(32)).unwrap();\n        std::fs::write(\n            &roster,\n            serde_json::to_vec(&vec![peer.public_key().to_owned()]).unwrap(),\n        )\n        .unwrap();\n        std::fs::set_permissions(&roster, std::fs::Permissions::from_mode(0o644)).unwrap();\n        assert_eq!(peer_roster(roster.to_str().unwrap()).unwrap().len(), 1);\n        let writable_roster = temp.path().join(\"writable-peers.json\");\n        std::fs::write(\n            &writable_roster,\n            serde_json::to_vec(&vec![peer.public_key().to_owned()]).unwrap(),\n        )\n        .unwrap();\n        std::fs::set_permissions(&writable_roster, std::fs::Permissions::from_mode(0o666)).unwrap();\n        assert_eq!(\n            peer_roster(writable_roster.to_str().unwrap())\n                .unwrap_err()\n                .to_string(),\n            \"AUTH_ROSTER_FILE\"\n        );\n        let roster_link = temp.path().join(\"peers-link.json\");\n        symlink(&roster, &roster_link).unwrap();\n        assert_eq!(\n            peer_roster(roster_link.to_str().unwrap())\n                .unwrap_err()\n                .to_string(),\n            \"AUTH_ROSTER_FILE\"\n        );\n    }\n}\n\n#[cfg(test)]\n#[path = \"operator_task_cli_tests.rs\"]\nmod operator_task_cli_tests;\n"},"isError":false}},{"key":"source:TrillionniumFoundation/Trillionnium-Chain:trillionnium/crates/trnm-protocol/src/pon_wire.rs","request":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/git/blobs/9333ce92c6ba130dd182538bfd8f69ec289acc83","response":{"content":[{"type":"text","text":"Action completed."}],"structuredContent":{"content":"//! Exact development wire contract. Decoded values are NOT signature-verified authority.\nuse sha2::{Digest, Sha256};\nuse std::collections::BTreeMap;\nmod state_root_arithmetic;\npub use state_root_arithmetic::{\n    StateRootArithmetic, StateRootArithmeticObservation, StateRootInputBuilder,\n};\npub type Hash = [u8; 32];\npub const HEADER_BYTES: usize = 318;\npub const MAX_TX_BYTES: usize = 2048;\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum WireError {\n    Length,\n    Version,\n    Noncanonical,\n    Limit,\n    KeyCollision,\n}\npub fn hash(tag: &[u8], parts: &[&[u8]]) -> Hash {\n    let mut h = Sha256::new();\n    h.update(b\"TRNM-PON1\\0\");\n    h.update((tag.len() as u16).to_le_bytes());\n    h.update(tag);\n    for p in parts {\n        h.update((p.len() as u32).to_le_bytes());\n        h.update(p);\n    }\n    h.finalize().into()\n}\n/// Exact account-archive branch grammar shared by the native storage and full\n/// reference root builders. This is a hash primitive, never a verified account,\n/// stored-node verdict or authority cache. Keep crypto code generation with the\n/// existing protocol owner rather than instantiating it in each storage caller.\npub fn account_archive_branch_hash(left: Hash, right: Hash) -> Hash {\n    let mut encoded = [0u8; 109];\n    encoded[..41].copy_from_slice(b\"TRNM-PON1\\0\\x19\\0account-archive-branch-v1\\x20\\0\\0\\0\");\n    encoded[41..73].copy_from_slice(&left);\n    encoded[73..77].copy_from_slice(&32u32.to_le_bytes());\n    encoded[77..].copy_from_slice(&right);\n    Sha256::digest(encoded).into()\n}\n\n/// Complete reference rebuild of the existing account-archive sparse relation.\n/// No source, storage, execution or admission authority is implied. Profile\n/// owners enforce their own finite account count and monetary limits.\npub fn account_archive_root_from_accounts(\n    accounts: impl IntoIterator<Item = (Hash, u64, u64)>,\n) -> Result<Hash, WireError> {\n    static EMPTY: std::sync::OnceLock<[Hash; 257]> = std::sync::OnceLock::new();\n    let empty = EMPTY.get_or_init(|| {\n        let mut values = [[0; 32]; 257];\n        values[256] = hash(b\"account-archive-empty-v1\", &[]);\n        for depth in (0..256).rev() {\n            values[depth] = account_archive_branch_hash(values[depth + 1], values[depth + 1]);\n        }\n        values\n    });\n    let mut rows: Vec<_> = accounts\n        .into_iter()\n        .map(|(owner, balance, nonce)| {\n            (\n                hash(b\"account-archive-key-v1\", &[&owner]),\n                hash(\n                    b\"account-archive-leaf-v1\",\n                    &[&owner, &balance.to_le_bytes(), &nonce.to_le_bytes()],\n                ),\n            )\n        })\n        .collect();\n    rows.sort_unstable_by_key(|row| row.0);\n    if rows.windows(2).any(|pair| pair[0].0 == pair[1].0) {\n        return Err(WireError::KeyCollision);\n    }\n    fn subtree(rows: &[(Hash, Hash)], depth: usize, empty: &[Hash; 257]) -> Hash {\n        if rows.is_empty() {\n            return empty[depth];\n        }\n        if depth == 256 {\n            return rows[0].1;\n        }\n        let split = rows.partition_point(|row| row.0[depth / 8] & (128 >> (depth % 8)) == 0);\n        account_archive_branch_hash(\n            subtree(&rows[..split], depth + 1, empty),\n            subtree(&rows[split..], depth + 1, empty),\n        )\n    }\n    Ok(subtree(&rows, 0, empty))\n}\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct Header {\n    pub network: Hash,\n    pub parameters: Hash,\n    pub parent: Hash,\n    pub height: u64,\n    pub timestamp: u64,\n    pub target: Hash,\n    pub miner: Hash,\n    pub transactions: Hash,\n    pub state: Hash,\n    pub receipts: Hash,\n    pub work_task: Hash,\n    pub nonce: u64,\n}\nstruct Reader<'a> {\n    bytes: &'a [u8],\n    pos: usize,\n}\nimpl<'a> Reader<'a> {\n    fn take<const N: usize>(&mut self) -> Result<[u8; N], WireError> {\n        let end = self.pos.checked_add(N).ok_or(WireError::Length)?;\n        let result = self\n            .bytes\n            .get(self.pos..end)\n            .ok_or(WireError::Length)?\n            .try_into()\n            .map_err(|_| WireError::Length)?;\n        self.pos = end;\n        Ok(result)\n    }\n    fn number(&mut self) -> Result<u64, WireError> {\n        Ok(u64::from_le_bytes(self.take()?))\n    }\n}\nimpl Header {\n    pub fn encode(&self) -> Vec<u8> {\n        let mut o = Vec::with_capacity(HEADER_BYTES);\n        o.extend(b\"PNH1\");\n        o.extend(1_u16.to_le_bytes());\n        for h in [self.network, self.parameters, self.parent] {\n            o.extend(h)\n        }\n        o.extend(self.height.to_le_bytes());\n        o.extend(self.timestamp.to_le_bytes());\n        for h in [\n            self.target,\n            self.miner,\n            self.transactions,\n            self.state,\n            self.receipts,\n            self.work_task,\n        ] {\n            o.extend(h)\n        }\n        o.extend(self.nonce.to_le_bytes());\n        o\n    }\n    pub fn decode(bytes: &[u8]) -> Result<Self, WireError> {\n        if bytes.len() != HEADER_BYTES {\n            return Err(WireError::Length);\n        }\n        let mut r = Reader { bytes, pos: 0 };\n        if r.take::<4>()? != *b\"PNH1\" || r.take::<2>()? != 1_u16.to_le_bytes() {\n            return Err(WireError::Version);\n        }\n        Ok(Self {\n            network: r.take()?,\n            parameters: r.take()?,\n            parent: r.take()?,\n            height: r.number()?,\n            timestamp: r.number()?,\n            target: r.take()?,\n            miner: r.take()?,\n            transactions: r.take()?,\n            state: r.take()?,\n            receipts: r.take()?,\n            work_task: r.take()?,\n            nonce: r.number()?,\n        })\n    }\n    pub fn challenge(&self) -> Hash {\n        hash(b\"challenge\", &[&self.encode()])\n    }\n    pub fn block_id(&self, trace: Hash) -> Hash {\n        hash(b\"block\", &[&self.encode(), &trace])\n    }\n}\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct Envelope {\n    pub network: Hash,\n    pub sender: Hash,\n    pub nonce: u64,\n    pub expiry: u64,\n    pub fee_limit: u64,\n    pub tag: u8,\n    pub payload: Vec<u8>,\n    pub signature: [u8; 64],\n}\n/// Canonical application payload grammar shared by explicitly selected signature\n/// profiles. This parses bytes only and never constructs an authenticated envelope.\npub(crate) fn payload_len(tag: u8, p: &[u8]) -> Result<(), WireError> {\n    let size = match tag {\n        1 => 40,\n        2 => 80,\n        3 => 32,\n        4 | 5 => 64,\n        6 => 176,\n        7 => 104,\n        8 => {\n            if p.len() < 145 {\n                return Err(WireError::Length);\n            }\n            let count = p[144] as usize;\n            if !(1..=16).contains(&count) {\n                return Err(WireError::Limit);\n            }\n            if p.len() != 145 + count * 40 {\n                return Err(WireError::Length);\n            }\n            for i in 1..count {\n                if p[145 + (i - 1) * 40..177 + (i - 1) * 40] >= p[145 + i * 40..177 + i * 40] {\n                    return Err(WireError::Noncanonical);\n                }\n            }\n            145 + count * 40\n        }\n        10 => 112,\n        11 => 136,\n        12 => 32,\n        // Decoding this candidate payload does not activate it in historical contexts.\n        13 => crate::qualified_work_task::SIGNED_TASK_BYTES,\n        14 => 96,\n        15 => 168,\n        16 => {\n            if p.len() < 36 {\n                return Err(WireError::Length);\n            }\n            let first = u16::from_le_bytes([p[32], p[33]]) as usize;\n            if !(159..=512).contains(&first) || p.len() < 36 + first {\n                return Err(WireError::Length);\n            }\n            let offset = 34 + first;\n            let second = u16::from_le_bytes([p[offset], p[offset + 1]]) as usize;\n            if !(159..=512).contains(&second) {\n                return Err(WireError::Length);\n            }\n            36 + first + second\n        }\n        17 => 128,\n        18 | 19 => crate::qualified_work_task::lifecycle_v2::DEMAND_LEASE_BYTES,\n        20 => crate::qualified_work_task::lifecycle_v2::DEMAND_REVOCATION_BYTES,\n        21 => crate::qualified_work_task::lifecycle_v2::LIFECYCLE_TASK_BYTES,\n        22 => crate::qualified_work_task::lifecycle_v3::ATOMIC_RENEW_BYTES,\n        23 => {\n            crate::integer_factor_v2::FactorWitnessV2::decode(p)?;\n            p.len()\n        }\n        24 => {\n            crate::integer_evolution_v3::EvolutionWitnessV3::decode(p)?;\n            p.len()\n        }\n        9 => {\n            if p.len() < 73 {\n                return Err(WireError::Length);\n            }\n            let n = p[72] as usize;\n            if n > 8 {\n                return Err(WireError::Limit);\n            }\n            73 + n * 32\n        }\n        _ => return Err(WireError::Version),\n    };\n    if p.len() != size {\n        return Err(WireError::Length);\n    }\n    Ok(())\n}\nimpl Envelope {\n    pub fn unsigned(&self) -> Result<Vec<u8>, WireError> {\n        payload_len(self.tag, &self.payload)?;\n        if self.nonce == 0 || self.fee_limit > 10_000_000 {\n            return Err(WireError::Noncanonical);\n        }\n        let mut o = Vec::with_capacity(159 + self.payload.len());\n        o.extend(b\"PNX1\");\n        o.extend(self.network);\n        o.extend(self.sender);\n        o.extend(self.nonce.to_le_bytes());\n        o.extend(self.expiry.to_le_bytes());\n        o.extend(self.fee_limit.to_le_bytes());\n        o.push(self.tag);\n        o.extend((self.payload.len() as u16).to_le_bytes());\n        o.extend(&self.payload);\n        Ok(o)\n    }\n    pub fn encode(&self) -> Result<Vec<u8>, WireError> {\n        let mut o = self.unsigned()?;\n        o.extend(self.signature);\n        Ok(o)\n    }\n    pub fn signing_digest(&self) -> Result<Hash, WireError> {\n        Ok(hash(b\"tx-sign\", &[&self.unsigned()?]))\n    }\n    pub fn id(&self) -> Result<Hash, WireError> {\n        Ok(hash(b\"tx-id\", &[&self.encode()?]))\n    }\n    pub fn decode(bytes: &[u8]) -> Result<Self, WireError> {\n        if bytes.len() > MAX_TX_BYTES {\n            return Err(WireError::Limit);\n        }\n        if bytes.len() < 159 {\n            return Err(WireError::Length);\n        }\n        let mut r = Reader { bytes, pos: 0 };\n        if r.take::<4>()? != *b\"PNX1\" {\n            return Err(WireError::Version);\n        }\n        let (network, sender, nonce, expiry, fee_limit) =\n            (r.take()?, r.take()?, r.number()?, r.number()?, r.number()?);\n        let tag = r.take::<1>()?[0];\n        let len = u16::from_le_bytes(r.take()?) as usize;\n        if bytes.len() != 159 + len {\n            return Err(WireError::Length);\n        }\n        let payload = bytes[r.pos..r.pos + len].to_vec();\n        r.pos += len;\n        let signature = r.take()?;\n        let out = Self {\n            network,\n            sender,\n            nonce,\n            expiry,\n            fee_limit,\n            tag,\n            payload,\n            signature,\n        };\n        out.unsigned()?;\n        Ok(out)\n    }\n}\n/// Canonical sparse Merkle root. Values are byte strings; callers enforce value schemas.\n/// Missing leaves are distinct from present empty values. Hash-key collisions reject.\npub fn state_root(values: &BTreeMap<Vec<u8>, Vec<u8>>) -> Result<Hash, WireError> {\n    if values.len() > 65_536 {\n        return Err(WireError::Limit);\n    }\n    match state_root_from_entries(values.iter().map(Ok::<_, std::convert::Infallible>)) {\n        Ok(root) => Ok(root),\n        Err(StateRootInputError::Wire(error)) => Err(error),\n        Err(StateRootInputError::Input(impossible)) => match impossible {},\n    }\n}\n\n/// Input failures remain distinct from the fixed wire bounds. No partial root\n/// escapes a failed iterator, and a supplied root is never an admission token.\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum StateRootInputError<E> {\n    Input(E),\n    Wire(WireError),\n}\n\n/// Consume each borrowed key/owned-or-borrowed encoding once. Retain only the\n/// fixed-size path and leaf hashes needed for hash-path sorting, not a second\n/// ordered map of all key/value bytes. This remains O(N) hash storage and full\n/// sparse-tree work; it neither removes the state cap nor skips any leaf.\n///\n/// Callers requiring canonical-value errors to precede wire limits must validate\n/// their complete value grammar before entering this wire-level operation.\npub fn state_root_from_entries<K, V, E>(\n    entries: impl IntoIterator<Item = Result<(K, V), E>>,\n) -> Result<Hash, StateRootInputError<E>>\nwhere\n    K: AsRef<[u8]>,\n    V: AsRef<[u8]>,\n{\n    let mut leaves = Vec::new();\n    for row in entries {\n        let (key, value) = row.map_err(StateRootInputError::Input)?;\n        let (key, value) = (key.as_ref(), value.as_ref());\n        if leaves.len() == 65_536 || key.len() > 160 || value.len() > 4096 {\n            return Err(StateRootInputError::Wire(WireError::Limit));\n        }\n        leaves.push((\n            hash(b\"state-key\", &[key]),\n            hash(b\"state-leaf\", &[key, value]),\n        ));\n    }\n    state_root_from_hashes(leaves).map_err(StateRootInputError::Wire)\n}\n\n// Exact H(\"state-node\", left, right) grammar in one 94-byte buffer. The\n// generic domain hash remains the reference for all other protocol objects.\n// No stored state, root verdict, clock, profile or permission enters this cache.\nfn state_node_hash(left: &Hash, right: &Hash) -> Hash {\n    let mut encoded = [0; 94];\n    encoded[..26].copy_from_slice(b\"TRNM-PON1\\0\\x0a\\0state-node\\x20\\0\\0\\0\");\n    encoded[26..58].copy_from_slice(left);\n    encoded[58..62].copy_from_slice(&32u32.to_le_bytes());\n    encoded[62..].copy_from_slice(right);\n    Sha256::digest(encoded).into()\n}\n\n// One immutable 8,224-byte value table per process (plus OnceLock metadata).\n// Borrow it: rebuilding or copying 257 constants on every complete root is not\n// input validation. Every actual key/value and duplicate/limit check stays live.\nfn state_empty_hashes() -> &'static [Hash; 257] {\n    static EMPTY: std::sync::OnceLock<[Hash; 257]> = std::sync::OnceLock::new();\n    EMPTY.get_or_init(|| {\n        let mut empty = [[0; 32]; 257];\n        empty[256] = hash(b\"state-empty\", &[]);\n        for depth in (0..256).rev() {\n            empty[depth] = state_node_hash(&empty[depth + 1], &empty[depth + 1]);\n        }\n        empty\n    })\n}\n\nfn state_root_from_hashes(mut leaves: Vec<(Hash, Hash)>) -> Result<Hash, WireError> {\n    leaves.sort_unstable_by_key(|x| x.0);\n    if leaves.windows(2).any(|p| p[0].0 == p[1].0) {\n        return Err(WireError::KeyCollision);\n    }\n    let empty = state_empty_hashes();\n    fn root(xs: &[(Hash, Hash)], depth: usize, empty: &[Hash; 257]) -> Hash {\n        if xs.is_empty() {\n            return empty[depth];\n        }\n        if depth == 256 {\n            return xs[0].1;\n        }\n        let split = xs.partition_point(|x| (x.0[depth / 8] & (128 >> (depth % 8))) == 0);\n        state_node_hash(\n            &root(&xs[..split], depth + 1, empty),\n            &root(&xs[split..], depth + 1, empty),\n        )\n    }\n    Ok(root(&leaves, 0, empty))\n}\n#[cfg(test)]\nmod tests {\n    use super::*;\n    #[test]\n    fn account_archive_reference_root_matches_independent_vectors() {\n        assert_eq!(\n            hex::encode(account_archive_root_from_accounts([]).unwrap()),\n            \"c19429dfa77d3aaedb639dd367f7ac1cab288d30dd60f06c4786d8c66c3345ac\"\n        );\n        assert_eq!(\n            hex::encode(account_archive_root_from_accounts([([9; 32], 7, 3)]).unwrap()),\n            \"0f54f056e419772853d3168d1c21e0c2ca9e47e374c3bb95769238d952a9ac78\"\n        );\n        assert_eq!(\n            account_archive_root_from_accounts([([9; 32], 7, 3), ([9; 32], 7, 3)]),\n            Err(WireError::KeyCollision)\n        );\n    }\n\n    #[test]\n    fn header_exact_and_context_bound() {\n        let mut h = Header {\n            network: [1; 32],\n            parameters: [2; 32],\n            parent: [3; 32],\n            height: 1,\n            timestamp: 1800000010,\n            target: [15; 32],\n            miner: [4; 32],\n            transactions: [5; 32],\n            state: [6; 32],\n            receipts: [7; 32],\n            work_task: [8; 32],\n            nonce: 0,\n        };\n        assert_eq!(h.encode().len(), HEADER_BYTES);\n        assert_eq!(Header::decode(&h.encode()).unwrap(), h);\n        let before = h.challenge();\n        h.nonce += 1;\n        assert_ne!(before, h.challenge());\n        let mut b = h.encode();\n        b.push(0);\n        assert_eq!(Header::decode(&b).unwrap_err(), WireError::Length);\n    }\n\n    #[test]\n    fn every_header_field_binds_its_wire_bytes_challenge_and_block_identity() {\n        let original = Header {\n            network: [1; 32],\n            parameters: [2; 32],\n            parent: [3; 32],\n            height: 1,\n            timestamp: 1_800_000_010,\n            target: [15; 32],\n            miner: [4; 32],\n            transactions: [5; 32],\n            state: [6; 32],\n            receipts: [7; 32],\n            work_task: [8; 32],\n            nonce: 9,\n        };\n        let wire = original.encode();\n        let trace = [41; 32];\n        let challenge = original.challenge();\n        let block = original.block_id(trace);\n        assert_eq!(wire.len(), 318);\n        assert_eq!(&wire[..6], b\"PNH1\\x01\\x00\");\n        assert_ne!(challenge, block);\n\n        // Independent PNH1 wire offsets: touch the LAST byte of every hash\n        // and the high byte of every little-endian number. This detects a\n        // missing/truncated field, a reordered field or a changed byte order.\n        type Mutation = (&'static str, usize, fn(&mut Header));\n        let mutations: [Mutation; 12] = [\n            (\"network\", 37, |h| h.network[31] ^= 0x80),\n            (\"parameters\", 69, |h| h.parameters[31] ^= 0x80),\n            (\"parent\", 101, |h| h.parent[31] ^= 0x80),\n            (\"height\", 109, |h| h.height ^= 1_u64 << 63),\n            (\"timestamp\", 117, |h| h.timestamp ^= 1_u64 << 63),\n            (\"target\", 149, |h| h.target[31] ^= 0x80),\n            (\"miner\", 181, |h| h.miner[31] ^= 0x80),\n            (\"transactions\", 213, |h| h.transactions[31] ^= 0x80),\n            (\"state\", 245, |h| h.state[31] ^= 0x80),\n            (\"receipts\", 277, |h| h.receipts[31] ^= 0x80),\n            (\"work_task\", 309, |h| h.work_task[31] ^= 0x80),\n            (\"nonce\", 317, |h| h.nonce ^= 1_u64 << 63),\n        ];\n        let mut challenges = std::collections::BTreeSet::from([challenge]);\n        let mut blocks = std::collections::BTreeSet::from([block]);\n        for (name, offset, mutate) in mutations {\n            let mut changed = original.clone();\n            mutate(&mut changed);\n            let mut expected = wire.clone();\n            expected[offset] ^= 0x80;\n            let encoded = changed.encode();\n            assert_eq!(encoded, expected, \"wire field: {name}\");\n            assert_eq!(&encoded[..6], b\"PNH1\\x01\\x00\", \"domain: {name}\");\n            assert_eq!(Header::decode(&encoded).unwrap(), changed, \"{name}\");\n            assert!(challenges.insert(changed.challenge()), \"challenge: {name}\");\n            assert!(blocks.insert(changed.block_id(trace)), \"block: {name}\");\n        }\n\n        // These are encoding/hash-binding cases, not branch-validity claims\n        // for the mutated heights, timestamps or targets. A changed wire\n        // namespace must be rejected rather than interpreted under PNH1 v1.\n        for offset in 0..6 {\n            let mut changed_domain = wire.clone();\n            changed_domain[offset] ^= 0x80;\n            assert_eq!(Header::decode(&changed_domain), Err(WireError::Version));\n        }\n        let mut changed_trace = trace;\n        changed_trace[31] ^= 0x80;\n        assert_ne!(original.block_id(changed_trace), block);\n    }\n    #[test]\n    fn every_tx_tag_has_an_exact_payload() {\n        for (tag, n) in [\n            (1, 40),\n            (2, 80),\n            (3, 32),\n            (4, 64),\n            (5, 64),\n            (6, 176),\n            (7, 104),\n            (9, 73),\n            (10, 112),\n            (11, 136),\n            (12, 32),\n        ] {\n            let e = Envelope {\n                network: [1; 32],\n                sender: [2; 32],\n                nonce: 1,\n                expiry: 10,\n                fee_limit: 10000,\n                tag,\n                payload: vec![0; n],\n                signature: [3; 64],\n            };\n            let b = e.encode().unwrap();\n            assert_eq!(Envelope::decode(&b).unwrap(), e);\n            for end in 0..b.len() {\n                assert!(Envelope::decode(&b[..end]).is_err());\n            }\n            let mut b = b;\n            b.push(0);\n            assert!(Envelope::decode(&b).is_err());\n        }\n    }\n    #[test]\n    fn contribution_without_signed_round_is_not_revision3_wire() {\n        assert_eq!(payload_len(6, &[0; 168]), Err(WireError::Length));\n        assert!(payload_len(6, &[0; 176]).is_ok());\n        assert_eq!(payload_len(6, &[0; 177]), Err(WireError::Length));\n    }\n\n    #[test]\n    fn release_payload_is_bounded_and_sorted() {\n        let mut p = vec![0; 185];\n        p[144] = 1;\n        assert!(payload_len(8, &p).is_ok());\n        p[144] = 0;\n        assert_eq!(payload_len(8, &p), Err(WireError::Limit));\n        p = vec![0; 225];\n        p[144] = 2;\n        assert_eq!(payload_len(8, &p), Err(WireError::Noncanonical));\n        p[185] = 1;\n        assert!(payload_len(8, &p).is_ok());\n    }\n    #[test]\n    fn sparse_root_is_order_independent_and_value_sensitive() {\n        let mut a = BTreeMap::new();\n        a.insert(b\"a\".to_vec(), b\"1\".to_vec());\n        a.insert(b\"b\".to_vec(), b\"2\".to_vec());\n        let r = state_root(&a).unwrap();\n        a.insert(b\"b\".to_vec(), b\"3\".to_vec());\n        assert_ne!(r, state_root(&a).unwrap());\n        assert_ne!(r, state_root(&BTreeMap::new()).unwrap());\n    }\n}\n\n#[cfg(test)]\nmod streamed_state_root_tests {\n    use super::*;\n    use std::cell::Cell;\n    use std::rc::Rc;\n\n    // Exact pre-refactor complete-map algorithm, including its independent\n    // sparse recursion. It does not call the streamed hash-root implementation.\n    fn original_state_root(values: &BTreeMap<Vec<u8>, Vec<u8>>) -> Result<Hash, WireError> {\n        if values.len() > 65_536 {\n            return Err(WireError::Limit);\n        }\n        let mut leaves = Vec::with_capacity(values.len());\n        for (k, v) in values {\n            if k.len() > 160 || v.len() > 4096 {\n                return Err(WireError::Limit);\n            }\n            leaves.push((hash(b\"state-key\", &[k]), hash(b\"state-leaf\", &[k, v])));\n        }\n        leaves.sort_unstable_by_key(|x| x.0);\n        if leaves.windows(2).any(|p| p[0].0 == p[1].0) {\n            return Err(WireError::KeyCollision);\n        }\n        let mut empty = [[0; 32]; 257];\n        empty[256] = hash(b\"state-empty\", &[]);\n        for d in (0..256).rev() {\n            empty[d] = hash(b\"state-node\", &[&empty[d + 1], &empty[d + 1]])\n        }\n        fn root(xs: &[(Hash, Hash)], depth: usize, empty: &[Hash; 257]) -> Hash {\n            if xs.is_empty() {\n                return empty[depth];\n            }\n            if depth == 256 {\n                return xs[0].1;\n            }\n            let split = xs.partition_point(|x| (x.0[depth / 8] & (128 >> (depth % 8))) == 0);\n            hash(\n                b\"state-node\",\n                &[\n                    &root(&xs[..split], depth + 1, empty),\n                    &root(&xs[split..], depth + 1, empty),\n                ],\n            )\n        }\n        Ok(root(&leaves, 0, &empty))\n    }\n\n    fn fixture(count: usize) -> BTreeMap<Vec<u8>, Vec<u8>> {\n        (0..count)\n            .map(|i| {\n                (\n                    format!(\"key-{i:05}\").into_bytes(),\n                    (i as u64).to_le_bytes().to_vec(),\n                )\n            })\n            .collect()\n    }\n\n    #[test]\n    fn streamed_state_root_preserves_original_sparse_tree_for_all_input_orders() {\n        for count in [0, 1, 2, 3, 7, 16, 31, 32, 33, 128, 257, 1025] {\n            let values = fixture(count);\n            let expected = original_state_root(&values).unwrap();\n            assert_eq!(state_root(&values).unwrap(), expected);\n            for reverse in [false, true] {\n                let mut rows: Vec<_> = values.iter().collect();\n                if reverse {\n                    rows.reverse();\n                }\n                assert_eq!(\n                    state_root_from_entries(rows.into_iter().map(Ok::<_, ()>)).unwrap(),\n                    expected\n                );\n            }\n        }\n        let absent = BTreeMap::new();\n        let empty = BTreeMap::from([(Vec::new(), Vec::new())]);\n        assert_ne!(state_root(&absent).unwrap(), state_root(&empty).unwrap());\n        assert_eq!(\n            state_root(&empty).unwrap(),\n            original_state_root(&empty).unwrap()\n        );\n    }\n\n    #[test]\n    fn streamed_state_root_refuses_duplicate_limit_and_truncated_producer_errors() {\n        let duplicate = [(b\"key\", b\"one\"), (b\"key\", b\"two\")];\n        assert_eq!(\n            state_root_from_entries(duplicate.into_iter().map(Ok::<_, ()>)),\n            Err(StateRootInputError::Wire(WireError::KeyCollision))\n        );\n        for (key, value) in [(vec![0; 161], vec![0]), (vec![0], vec![0; 4097])] {\n            assert_eq!(\n                state_root_from_entries([Ok::<_, ()>((key, value))]),\n                Err(StateRootInputError::Wire(WireError::Limit))\n            );\n        }\n        let over = (0..65_537u64).map(|i| Ok::<_, ()>((i.to_le_bytes(), [0u8])));\n        assert_eq!(\n            state_root_from_entries(over),\n            Err(StateRootInputError::Wire(WireError::Limit))\n        );\n        for cut in [0, 1, 255, 256, 257] {\n            let rows = (0..258u64).map(|i| {\n                if i == cut {\n                    Err(\"source-cancelled\")\n                } else {\n                    Ok((i.to_le_bytes(), [0u8]))\n                }\n            });\n            assert_eq!(\n                state_root_from_entries(rows),\n                Err(StateRootInputError::Input(\"source-cancelled\"))\n            );\n        }\n        let boundary = BTreeMap::from([(vec![255; 160], vec![255; 4096])]);\n        assert_eq!(state_root(&boundary), original_state_root(&boundary));\n    }\n\n    #[test]\n    fn streamed_state_root_drops_each_owned_encoding_before_requesting_the_next() {\n        struct Encoded {\n            bytes: Vec<u8>,\n            live: Rc<Cell<usize>>,\n        }\n        impl AsRef<[u8]> for Encoded {\n            fn as_ref(&self) -> &[u8] {\n                &self.bytes\n            }\n        }\n        impl Drop for Encoded {\n            fn drop(&mut self) {\n                self.live.set(self.live.get() - 1);\n            }\n        }\n        let live = Rc::new(Cell::new(0));\n        let values = fixture(257);\n        let rows = values.iter().map(|(key, bytes)| {\n            assert_eq!(\n                live.get(),\n                0,\n                \"the previous encoded payload must be released\"\n            );\n            live.set(1);\n            Ok::<_, ()>((\n                key,\n                Encoded {\n                    bytes: bytes.clone(),\n                    live: live.clone(),\n                },\n            ))\n        });\n        assert_eq!(\n            state_root_from_entries(rows).unwrap(),\n            original_state_root(&values).unwrap()\n        );\n        assert_eq!(live.get(), 0);\n    }\n\n    #[test]\n    fn state_node_single_buffer_matches_original_wire() {\n        for bit in 0..512 {\n            let mut left = [0; 32];\n            let mut right = [0; 32];\n            if bit < 256 {\n                left[bit / 8] = 1 << (bit % 8);\n            } else {\n                right[(bit - 256) / 8] = 1 << (bit % 8);\n            }\n            assert_eq!(\n                state_node_hash(&left, &right),\n                hash(b\"state-node\", &[&left, &right])\n            );\n            assert_eq!(\n                state_node_hash(&right, &left),\n                hash(b\"state-node\", &[&right, &left])\n            );\n        }\n        for seed in 0..1024u64 {\n            let left = hash(b\"state-node-test-left\", &[&seed.to_le_bytes()]);\n            let right = hash(b\"state-node-test-right\", &[&seed.to_le_bytes()]);\n            assert_eq!(\n                state_node_hash(&left, &right),\n                hash(b\"state-node\", &[&left, &right])\n            );\n        }\n        for left in [[0; 32], [255; 32], [85; 32], [170; 32]] {\n            for right in [[0; 32], [255; 32], [85; 32], [170; 32]] {\n                assert_eq!(\n                    state_node_hash(&left, &right),\n                    hash(b\"state-node\", &[&left, &right])\n                );\n            }\n        }\n    }\n\n    #[test]\n    fn state_empty_constants_match_all_depths_and_parallel_callers() {\n        let mut expected = [[0; 32]; 257];\n        expected[256] = hash(b\"state-empty\", &[]);\n        for depth in (0..256).rev() {\n            expected[depth] = hash(b\"state-node\", &[&expected[depth + 1], &expected[depth + 1]]);\n        }\n        assert_eq!(state_empty_hashes(), &expected);\n        std::thread::scope(|scope| {\n            for _ in 0..8 {\n                scope.spawn(|| {\n                    for _ in 0..16 {\n                        assert_eq!(state_empty_hashes(), &expected);\n                    }\n                });\n            }\n        });\n        assert_eq!(state_root(&BTreeMap::new()).unwrap(), expected[0]);\n    }\n\n    #[test]\n    fn state_root_constants_do_not_cache_values_or_failures() {\n        let mut values = fixture(3);\n        let initial = state_root(&values).unwrap();\n        let key = b\"key-00000\".to_vec();\n        let original = values.get(&key).unwrap().clone();\n        values.insert(key.clone(), Vec::new());\n        let present_empty = state_root(&values).unwrap();\n        assert_ne!(present_empty, initial);\n        assert_eq!(present_empty, original_state_root(&values).unwrap());\n        values.remove(&key);\n        assert_ne!(state_root(&values).unwrap(), present_empty);\n        values.insert(key.clone(), vec![0; 4097]);\n        assert_eq!(state_root(&values), Err(WireError::Limit));\n        values.insert(key, original);\n        assert_eq!(state_root(&values).unwrap(), initial);\n        let rows = [Ok((b\"k\".as_slice(), b\"v\".as_slice())), Err(\"cancelled\")];\n        assert_eq!(\n            state_root_from_entries(rows),\n            Err(StateRootInputError::Input(\"cancelled\"))\n        );\n        let rows = [Ok::<_, ()>((b\"k\", b\"v\")), Ok((b\"k\", b\"w\"))];\n        assert_eq!(\n            state_root_from_entries(rows),\n            Err(StateRootInputError::Wire(WireError::KeyCollision))\n        );\n        assert_eq!(state_root(&values).unwrap(), initial);\n    }\n\n    #[test]\n    #[ignore = \"explicit complete-root paired observation; not Node or WAN throughput\"]\n    fn state_node_and_complete_root_paired_cost_observation() {\n        use std::hint::black_box;\n        use std::time::Instant;\n\n        if cfg!(debug_assertions) {\n            panic!(\"run this observation in release mode\");\n        }\n        let values = fixture(33);\n        let expected = original_state_root(&values).unwrap();\n        assert_eq!(state_root(&values).unwrap(), expected);\n        for pair in 0..8 {\n            let order = if pair % 2 == 0 {\n                [false, true]\n            } else {\n                [true, false]\n            };\n            for optimized in order {\n                let started = Instant::now();\n                let mut observed = [0; 32];\n                for _ in 0..16 {\n                    observed = if optimized {\n                        state_root(black_box(&values)).unwrap()\n                    } else {\n                        original_state_root(black_box(&values)).unwrap()\n                    };\n                    black_box(observed);\n                }\n                let elapsed_ns = started.elapsed().as_nanos();\n                assert_eq!(observed, expected);\n                let arm = if optimized {\n                    \"single-buffer-constants\"\n                } else {\n                    \"original\"\n                };\n                println!(\n                    \"pon_complete_state_root_cost_v1 {{\\\"pair\\\":{pair},\\\"arm\\\":\\\"{arm}\\\",\\\"roots\\\":16,\\\"keys\\\":33,\\\"elapsed_ns\\\":{elapsed_ns},\\\"root\\\":{observed:?},\\\"warm_constants\\\":true,\\\"whole_node_performance_qualified\\\":false}}\"\n                );\n            }\n        }\n    }\n}\n"},"isError":false}},{"key":"source:TrillionniumFoundation/Trillionnium-Chain:trillionnium/crates/trnm-protocol/src/pq_frame.rs","request":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/git/blobs/07537462b6a2a57f8b29b2bb59c16862b770aa91","response":{"content":[{"type":"text","text":"Action completed."}],"structuredContent":{"content":"//! Strict native TPQ1 research wire preflight; **not** a signature verifier.\n//!\n//! No value returned by this module is an authenticated identity, a verified\n//! transaction, VerifiedWork, authorization, final-use or release capability.\n//! A separately reviewed ML-DSA-65 verifier and state/nonce owner MUST follow.\n//! This module deliberately does not alter the installed legacy PoN wire.\nuse sha2::{Digest, Sha256, Sha384};\n\npub const TPQ1_UNSIGNED_BYTES: usize = 176;\npub const ML_DSA_65_SIGNATURE_BYTES: usize = 3_309;\npub const ML_DSA_65_PUBLIC_KEY_BYTES: usize = 1_952;\npub const ML_DSA_65_SPKI_BYTES: usize = 1_974;\n// Strict DER SPKI: SEQUENCE(1970), SEQUENCE(id-ml-dsa-65 OID), BIT STRING(1953).\n// This checks framing/algorithm identity only; it is NOT ML-DSA public-key validation.\npub(crate) const ML_DSA_65_SPKI_PREFIX: [u8; 22] = [\n    0x30, 0x82, 0x07, 0xb2, 0x30, 0x0b, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x03,\n    0x12, 0x03, 0x82, 0x07, 0xa1, 0x00,\n];\npub(crate) const PUBLIC_KEY_ID_DOMAIN: &[u8] = b\"TRNM/PoN/PQKey/v1\\0\";\npub const TPQ1_SIGNED_BYTES: usize = TPQ1_UNSIGNED_BYTES + 2 + ML_DSA_65_SIGNATURE_BYTES;\npub const TPQ1_MAX_PAYLOAD_BYTES: usize = 64 * 1024 * 1024;\npub(crate) const DOMAIN: &[u8] = b\"TRNM/PoN/PQAuth/ML-DSA-65/v1\\0\";\npub(crate) const PAYLOAD_TAG: &[u8] = b\"payload\\0\";\npub(crate) const TPQ1_MAGIC: &[u8; 4] = b\"TPQ1\";\npub(crate) const TPQ1_VERSION: u8 = 1;\npub(crate) const TPQ1_ALGORITHM: u8 = 0x65;\npub(crate) const FIRST_PURPOSE: u8 = 1;\npub(crate) const LAST_PURPOSE: u8 = 6;\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum PqFrameError {\n    FrameLength,\n    HeaderVersionAlgorithm,\n    PurposeOrReserved,\n    ContextOrIdentity,\n    LifetimeOrSequence,\n    Expired,\n    PayloadSize,\n    PayloadDigest,\n    SignatureLength,\n    PublicKeyDer,\n}\n\n/// Independently pinned caller expectations. In particular, the key ID does\n/// not come from the untrusted frame; the future crypto owner must derive it\n/// from a strict ML-DSA-65 SPKI public key before using this preflight.\n#[derive(Debug, Clone)]\npub struct PqFrameExpectation<'a> {\n    pub purpose: u8,\n    pub network: [u8; 32],\n    pub owner_context: [u8; 32],\n    pub signer_key_id: [u8; 32],\n    pub owner_generation: u64,\n    pub operation_sequence: u64,\n    pub expires_at: u64,\n    pub now: u64,\n    pub payload: &'a [u8],\n}\n\n/// These are UNVERIFIED bytes; never use this as a boolean proof of signature,\n/// chain authority, user permission, model quality or state transition.\n#[derive(Debug)]\npub struct UnverifiedPqFrame<'a> {\n    statement: &'a [u8],\n    signature: &'a [u8],\n}\n\nimpl<'a> UnverifiedPqFrame<'a> {\n    pub fn unsigned_statement(&self) -> &'a [u8] {\n        self.statement\n    }\n\n    pub fn unverified_signature(&self) -> &'a [u8] {\n        self.signature\n    }\n}\n\nfn u64_at(input: &[u8], start: usize) -> u64 {\n    let mut bytes = [0u8; 8];\n    bytes.copy_from_slice(&input[start..start + 8]);\n    u64::from_be_bytes(bytes)\n}\n\n/// The exact v1 Python research payload commitment:\n/// SHA384(DOMAIN || \"payload\\0\" || BE64(len) || payload).\npub fn payload_commitment(payload: &[u8]) -> Result<[u8; 48], PqFrameError> {\n    if payload.len() > TPQ1_MAX_PAYLOAD_BYTES {\n        return Err(PqFrameError::PayloadSize);\n    }\n    let mut h = Sha384::new();\n    h.update(DOMAIN);\n    h.update(PAYLOAD_TAG);\n    h.update((payload.len() as u64).to_be_bytes());\n    h.update(payload);\n    Ok(h.finalize().into())\n}\n\n/// Derive the reference identity from one exact ML-DSA-65 DER SPKI.\n///\n/// Restrict both the ASN.1 structure and OID before hashing: this rejects\n/// alternative algorithms, optional parameters, non-minimal length encodings,\n/// padding changes, truncation and appended bytes. The 1,952 key bytes are\n/// NOT checked for cryptographic validity here; a real ML-DSA-65 verifier\n/// remains mandatory before any trust or authorization can be established.\npub fn ml_dsa_65_key_id_from_spki(spki: &[u8]) -> Result<[u8; 32], PqFrameError> {\n    if spki.len() != ML_DSA_65_SPKI_BYTES || !spki.starts_with(&ML_DSA_65_SPKI_PREFIX) {\n        return Err(PqFrameError::PublicKeyDer);\n    }\n    let mut digest = Sha256::new();\n    digest.update(PUBLIC_KEY_ID_DOMAIN);\n    digest.update(spki);\n    Ok(digest.finalize().into())\n}\n\n/// Reject malformed/unbound TPQ1 before invoking an independently implemented\n/// ML-DSA-65 verifier. Success is NEVER signature verification. Keeping this\n/// result unverified avoids a forged Boolean being converted to an authority.\npub fn preflight_unverified<'a>(\n    bytes: &'a [u8],\n    expected: &PqFrameExpectation<'_>,\n) -> Result<UnverifiedPqFrame<'a>, PqFrameError> {\n    if bytes.len() != TPQ1_SIGNED_BYTES {\n        return Err(PqFrameError::FrameLength);\n    }\n    if &bytes[..4] != TPQ1_MAGIC || bytes[4] != TPQ1_VERSION || bytes[5] != TPQ1_ALGORITHM {\n        return Err(PqFrameError::HeaderVersionAlgorithm);\n    }\n    if !(FIRST_PURPOSE..=LAST_PURPOSE).contains(&bytes[6])\n        || bytes[6] != expected.purpose\n        || bytes[7] != 0\n    {\n        return Err(PqFrameError::PurposeOrReserved);\n    }\n    if &bytes[8..40] != expected.network.as_slice()\n        || &bytes[40..72] != expected.owner_context.as_slice()\n        || &bytes[72..104] != expected.signer_key_id.as_slice()\n    {\n        return Err(PqFrameError::ContextOrIdentity);\n    }\n    let generation = u64_at(bytes, 104);\n    let sequence = u64_at(bytes, 112);\n    let expiry = u64_at(bytes, 120);\n    if generation == 0\n        || sequence == 0\n        || expiry == 0\n        || generation != expected.owner_generation\n        || sequence != expected.operation_sequence\n        || expiry != expected.expires_at\n    {\n        return Err(PqFrameError::LifetimeOrSequence);\n    }\n    if expected.now > expiry {\n        return Err(PqFrameError::Expired);\n    }\n    if &bytes[128..176] != payload_commitment(expected.payload)?.as_slice() {\n        return Err(PqFrameError::PayloadDigest);\n    }\n    let len = u16::from_be_bytes([bytes[176], bytes[177]]) as usize;\n    if len != ML_DSA_65_SIGNATURE_BYTES {\n        return Err(PqFrameError::SignatureLength);\n    }\n    Ok(UnverifiedPqFrame {\n        statement: &bytes[..TPQ1_UNSIGNED_BYTES],\n        signature: &bytes[TPQ1_UNSIGNED_BYTES + 2..],\n    })\n}\n\n/// Preflight a TPQ1 frame against a caller-pinned actual DER SPKI,\n/// rather than trusting a key ID copied from an untrusted frame.\n///\n/// The caller must independently authenticate expected (including the key ID)\n/// and supply the nominated public key out-of-band. Neither this check nor the\n/// simpler preflight_unverified verifies a signature, signer possession,\n/// nonce consumption, or any Chain/Hepta authority.\npub fn preflight_unverified_with_spki<'a>(\n    bytes: &'a [u8],\n    expected: &PqFrameExpectation<'_>,\n    pinned_spki: &[u8],\n) -> Result<UnverifiedPqFrame<'a>, PqFrameError> {\n    let actual_key_id = ml_dsa_65_key_id_from_spki(pinned_spki)?;\n    if actual_key_id != expected.signer_key_id {\n        return Err(PqFrameError::ContextOrIdentity);\n    }\n    preflight_unverified(bytes, expected)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn case<'a>(payload: &'a [u8]) -> (Vec<u8>, PqFrameExpectation<'a>) {\n        let e = PqFrameExpectation {\n            purpose: 4,\n            network: [1; 32],\n            owner_context: [2; 32],\n            signer_key_id: [3; 32],\n            owner_generation: 7,\n            operation_sequence: 19,\n            expires_at: 4000,\n            now: 3999,\n            payload,\n        };\n        let mut v = vec![0xab; TPQ1_SIGNED_BYTES];\n        v[..4].copy_from_slice(b\"TPQ1\");\n        v[4] = 1;\n        v[5] = 0x65;\n        v[6] = e.purpose;\n        v[7] = 0;\n        v[8..40].copy_from_slice(&e.network);\n        v[40..72].copy_from_slice(&e.owner_context);\n        v[72..104].copy_from_slice(&e.signer_key_id);\n        v[104..112].copy_from_slice(&e.owner_generation.to_be_bytes());\n        v[112..120].copy_from_slice(&e.operation_sequence.to_be_bytes());\n        v[120..128].copy_from_slice(&e.expires_at.to_be_bytes());\n        v[128..176].copy_from_slice(&payload_commitment(payload).unwrap());\n        v[176..178].copy_from_slice(&(ML_DSA_65_SIGNATURE_BYTES as u16).to_be_bytes());\n        (v, e)\n    }\n\n    #[test]\n    fn entire_statement_has_one_exact_canonical_preflight_binding() {\n        let (v, e) = case(b\"public Cell release manifest hash and consent\");\n        let checked = preflight_unverified(&v, &e).unwrap();\n        assert_eq!(checked.unsigned_statement().len(), 176);\n        assert_eq!(checked.unverified_signature().len(), 3309);\n        for idx in 0..TPQ1_UNSIGNED_BYTES {\n            let mut mutated = v.clone();\n            mutated[idx] ^= 1;\n            assert!(\n                preflight_unverified(&mutated, &e).is_err(),\n                \"field byte {idx}\"\n            );\n        }\n    }\n\n    #[test]\n    fn zero_lifetimes_bad_length_and_classical_downgrade_reject() {\n        let (v, e) = case(b\"test\");\n        for end in [0, 175, 3486, 3488] {\n            let mut bad = v.clone();\n            bad.resize(end, 0);\n            assert_eq!(\n                preflight_unverified(&bad, &e).unwrap_err(),\n                PqFrameError::FrameLength\n            );\n        }\n        let mut bad = v.clone();\n        bad[5] = 0x19; // Ed25519 is not a PQ signature algorithm.\n        assert_eq!(\n            preflight_unverified(&bad, &e).unwrap_err(),\n            PqFrameError::HeaderVersionAlgorithm\n        );\n        for range in [104..112, 112..120, 120..128] {\n            let mut bad = v.clone();\n            bad[range].fill(0);\n            assert_eq!(\n                preflight_unverified(&bad, &e).unwrap_err(),\n                PqFrameError::LifetimeOrSequence\n            );\n        }\n    }\n\n    #[test]\n    fn stale_payload_and_signature_size_refuse() {\n        let (v, mut e) = case(b\"test\");\n        e.now = 4001;\n        assert_eq!(\n            preflight_unverified(&v, &e).unwrap_err(),\n            PqFrameError::Expired\n        );\n        e.now = 3999;\n        e.payload = b\"other\";\n        assert_eq!(\n            preflight_unverified(&v, &e).unwrap_err(),\n            PqFrameError::PayloadDigest\n        );\n        e.payload = b\"test\";\n        let mut bad = v.clone();\n        bad[176] = 0;\n        assert_eq!(\n            preflight_unverified(&bad, &e).unwrap_err(),\n            PqFrameError::SignatureLength\n        );\n    }\n\n    #[test]\n    fn unverified_signature_change_never_grants_authority() {\n        let (v, e) = case(b\"test\");\n        let mut fake = v.clone();\n        fake[178] ^= 1;\n        let a = preflight_unverified(&v, &e).unwrap();\n        let b = preflight_unverified(&fake, &e).unwrap();\n        assert_ne!(a.unverified_signature(), b.unverified_signature());\n        // Both are merely unverified frames: no cryptographic success is offered.\n    }\n\n    #[test]\n    fn sha384_payload_commitment_matches_independent_python_oracle() {\n        let payload = b\"public Cell release manifest hash and consent\";\n        let digest = payload_commitment(payload).unwrap();\n        assert_eq!(\n            hex::encode(digest),\n            \"2ceb9c0f29a40392386f5644c998adedaf5ae91f46b2faff977a66ad8153cbfe2bc62af16fd4125e7f516fc09a1382e4\"\n        );\n    }\n\n    fn spki_with_payload_byte(value: u8) -> Vec<u8> {\n        let mut result = ML_DSA_65_SPKI_PREFIX.to_vec();\n        result.extend_from_slice(&vec![value; ML_DSA_65_PUBLIC_KEY_BYTES]);\n        result\n    }\n\n    #[test]\n    fn pinned_mldsa_spki_identity_matches_independent_sha256_vector() {\n        let spki = spki_with_payload_byte(0x42);\n        assert_eq!(spki.len(), ML_DSA_65_SPKI_BYTES);\n        let id = ml_dsa_65_key_id_from_spki(&spki).unwrap();\n        assert_eq!(\n            hex::encode(id),\n            \"afc295d8a2307875be792894d57b195f2f9513ede37ac98162232d2a09ca0989\"\n        );\n        let (mut frame, mut expected) = case(b\"pinned model\");\n        expected.signer_key_id = id;\n        frame[72..104].copy_from_slice(&id);\n        let unverified = preflight_unverified_with_spki(&frame, &expected, &spki).unwrap();\n        assert_eq!(unverified.unsigned_statement().len(), TPQ1_UNSIGNED_BYTES);\n        assert_eq!(\n            unverified.unverified_signature().len(),\n            ML_DSA_65_SIGNATURE_BYTES\n        );\n\n        // A second structurally well-formed key cannot substitute for the pinned key.\n        let alternative = spki_with_payload_byte(0);\n        assert_eq!(\n            preflight_unverified_with_spki(&frame, &expected, &alternative).unwrap_err(),\n            PqFrameError::ContextOrIdentity\n        );\n        frame[178..].fill(0);\n        // Even an all-zero alleged signature pa