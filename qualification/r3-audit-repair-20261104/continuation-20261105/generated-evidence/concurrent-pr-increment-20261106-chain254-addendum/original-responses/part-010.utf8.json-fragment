!({\n            \"snapshot_digest\": \"a\".repeat(64),\n            \"read_digest\": \"b\".repeat(64),\n            \"omitted_records\": 0,\n            \"items\": [{\n                \"memory_id\": \"memory:v2:test\",\n                \"revision\": 1,\n                \"content\": \"verified memory\",\n                \"content_sha256\": \"c\".repeat(64)\n            }],\n            \"plan\": null\n        });\n        let snapshot: CognitiveContextSnapshot =\n            serde_json::from_value(legacy).expect(\"legacy cognitive context shape\");\n        let serialized = serde_json::to_value(&snapshot).expect(\"serialize cognitive context\");\n        assert!(serialized.get(\"cut_digest\").is_none());\n\n        let request = AgentdRequest {\n            schema_version: AGENTD_CONTROL_SCHEMA_VERSION,\n            request_id: 13,\n            spawn_generation: 3,\n            method: AgentdMethod::CognitiveContextRevalidate {\n                snapshot_digest: snapshot.snapshot_digest.clone(),\n                read_digest: snapshot.read_digest.clone(),\n                omitted_records: snapshot.omitted_records,\n                items: snapshot.items.clone(),\n                plan: snapshot.plan,\n            },\n        };\n        let bytes = serde_json::to_vec(&request).expect(\"serialize revalidation request\");\n        assert!(bytes.len() as u64 <= MAX_CONTROL_FRAME_BYTES);\n        assert_eq!(\n            serde_json::from_slice::<AgentdRequest>(&bytes).expect(\"parse revalidation request\"),\n            request\n        );\n    }\n\n    #[test]\n    fn health_wire_round_trip_is_strict_and_bounded() {\n        let request = AgentdRequest::health(7, 11);\n        let request_bytes = serde_json::to_vec(&request).expect(\"serialize request\");\n        assert!(request_bytes.len() as u64 <= MAX_CONTROL_FRAME_BYTES);\n        assert_eq!(\n            serde_json::from_slice::<AgentdRequest>(&request_bytes).expect(\"parse request\"),\n            request\n        );\n\n        let response = AgentdResponse {\n            schema_version: AGENTD_CONTROL_SCHEMA_VERSION,\n            request_id: 7,\n            agent_id: AgentId::parse(\"018f4f72-5f8f-7cc1-8f55-df9fb3aa2c12\").expect(\"agent id\"),\n            spawn_generation: 11,\n            current_generation: 11,\n            payload: AgentdPayload::Health(HealthSnapshot {\n                promotion_ready: true,\n                ready: true,\n                fenced: false,\n                lifecycle: AgentLifecycle::Running,\n                process_id: 17,\n                workspace: PathBuf::from(\"/tmp/workspace\"),\n                home_root: PathBuf::from(\"/tmp/home\"),\n                run_root: PathBuf::from(\"/tmp/run\"),\n            }),\n        };\n        let response_bytes = serde_json::to_vec(&response).expect(\"serialize response\");\n        assert!(response_bytes.len() as u64 <= MAX_CONTROL_FRAME_BYTES);\n        assert_eq!(\n            serde_json::from_slice::<AgentdResponse>(&response_bytes).expect(\"parse response\"),\n            response\n        );\n    }\n\n    #[test]\n    fn automation_wire_round_trip_is_strict_and_bounded() {\n        let mut draft = AutomationTaskDraft::new(\n            \"019153a4-3088-7e03-a56a-9b1964f75ddd\",\n            \"x\".repeat(32 * 1024),\n            codex_hepta_automation::AutomationSchedule::Once,\n            123,\n            100,\n        );\n        draft.task_id =\n            AutomationTaskId::parse(\"019153a4-3088-7000-a56a-9b1964f75001\").expect(\"task id\");\n        let request = AgentdRequest::automation_create(9, 3, draft);\n        let bytes = serde_json::to_vec(&request).expect(\"serialize request\");\n        assert!(bytes.len() as u64 <= MAX_CONTROL_FRAME_BYTES);\n        assert_eq!(\n            serde_json::from_slice::<AgentdRequest>(&bytes).expect(\"parse request\"),\n            request\n        );\n\n        let schedule = codex_hepta_automation::AutomationCalendarScheduleV2 {\n            timezone_id: \"Etc/UTC\".to_string(),\n            tzdb_digest: Sha256Digest::for_bytes(b\"tzdb-test\"),\n            start_at_utc_ms: 123,\n            end_at_utc_ms: Some(86_400_123),\n            every_days: 1,\n            local_time_ms: 123,\n            dst_gap_policy: codex_hepta_automation::AutomationDstGapPolicy::Skip,\n            dst_overlap_policy: codex_hepta_automation::AutomationDstOverlapPolicy::First,\n            clock_profile: codex_hepta_automation::AutomationTimeZoneProfileV1 {\n                timezone_id: \"Etc/UTC\".to_string(),\n                tzdb_digest: Sha256Digest::for_bytes(b\"tzdb-test\"),\n                valid_from_utc_ms: 0,\n                valid_until_utc_ms: 172_800_000,\n                initial_offset_seconds: 0,\n                transitions: Vec::new(),\n            },\n        };\n        let calendar = AgentdRequest::automation_create_calendar_v2(\n            10,\n            3,\n            AutomationTaskDraft::new(\n                \"019153a4-3088-7e03-a56a-9b1964f75ddd\",\n                \"calendar task\",\n                codex_hepta_automation::AutomationSchedule::Once,\n                123,\n                100,\n            ),\n            schedule,\n            codex_hepta_automation::AutomationMissedRunPolicy::Coalesce,\n            codex_hepta_automation::AutomationOverlapPolicy::Forbid,\n        );\n        let calendar_bytes = serde_json::to_vec(&calendar).expect(\"serialize calendar request\");\n        assert!(calendar_bytes.len() as u64 <= MAX_CONTROL_FRAME_BYTES);\n        assert_eq!(\n            serde_json::from_slice::<AgentdRequest>(&calendar_bytes)\n                .expect(\"parse calendar request\"),\n            calendar\n        );\n    }\n\n    #[test]\n    fn automation_effect_wire_round_trip_is_strict_and_bounded() {\n        let payload = b\"{\\\"effect\\\":\\\"test\\\"}\";\n        let payload_digest = Sha256Digest::for_bytes(payload);\n        let intent = AuthorizedEffectIntent {\n            run_id: \"run-effect\".to_string(),\n            step_id: \"effect\".to_string(),\n            attempt: 1,\n            operation_id: \"provider.deliver\".to_string(),\n            subject_id: \"019153a4-3088-7e03-a56a-9b1964f75ddd\".to_string(),\n            destination_id: \"provider:fixture\".to_string(),\n            payload_digest,\n            final_use_scope_digest: Sha256Digest::for_bytes(b\"scope\"),\n            policy_generation: 1,\n            expected_predecessor_digest: None,\n            dependencies: Vec::new(),\n            compensation_for: None,\n        };\n        let binding = intent.final_use_binding().expect(\"binding\");\n        let signed_grant = SignedFinalUseGrant {\n            grant: codex_hepta_contracts::FinalUseGrant {\n                schema_version: 1,\n                signer_id: \"security-owner\".to_string(),\n                authority_epoch: 1,\n                grant_id: \"effect-grant\".to_string(),\n                nonce: [7_u8; 32],\n                binding,\n                not_before_unix_ms: 1,\n                expires_at_unix_ms: 1_001,\n            },\n            signature: vec![9_u8; 64],\n        };\n        let wire_payload_hex = payload\n            .iter()\n            .flat_map(|byte| format!(\"{byte:02x}\").chars().collect::<Vec<_>>())\n            .collect::<String>();\n        let expected_wire = serde_json::json!({\n            \"schema_version\": AGENTD_CONTROL_SCHEMA_VERSION,\n            \"request_id\": 11,\n            \"spawn_generation\": 3,\n            \"method\": {\n                \"type\": \"automation_execute_effect\",\n                \"intent\": &intent,\n                \"wire_payload_hex\": &wire_payload_hex,\n                \"signed_grant\": &signed_grant,\n                \"command_id\": \"effect-command\",\n            },\n        });\n        let request = AgentdRequest::automation_execute_effect(\n            11,\n            3,\n            intent,\n            wire_payload_hex,\n            signed_grant,\n            \"effect-command\".to_string(),\n        );\n        let bytes = serde_json::to_vec(&request).expect(\"serialize effect request\");\n        assert_eq!(\n            serde_json::from_slice::<serde_json::Value>(&bytes).expect(\"read effect wire shape\"),\n            expected_wire\n        );\n        assert!(bytes.len() as u64 <= MAX_CONTROL_FRAME_BYTES);\n        assert_eq!(\n            serde_json::from_slice::<AgentdRequest>(&bytes).expect(\"parse effect request\"),\n            request\n        );\n\n        let response =\n            AgentdPayload::AutomationEffectReconcile(AutomationEffectReconcileSnapshot {\n                state: AutomationEffectReconcileState::Indeterminate,\n                effect: None,\n                chain: None,\n            });\n        let response_bytes = serde_json::to_vec(&response).expect(\"serialize effect response\");\n        assert_eq!(\n            serde_json::from_slice::<AgentdPayload>(&response_bytes)\n                .expect(\"parse effect response\"),\n            response\n        );\n    }\n\n    #[test]\n    fn memory_federation_control_is_typed_strict_and_bounded() {\n        let consumer = AgentId::parse(\"019153a4-3088-7e03-a56a-9b1964f75dd3\").expect(\"consumer id\");\n        let grant = AgentdRequest::memory_federation_grant(\n            10,\n            3,\n            consumer,\n            MemoryFederationScopeKind::WorkspacePrivate,\n            3_600,\n        );\n        let grant_bytes = serde_json::to_vec(&grant).expect(\"serialize grant\");\n        assert!(grant_bytes.len() as u64 <= MAX_CONTROL_FRAME_BYTES);\n        assert_eq!(\n            serde_json::from_slice::<AgentdRequest>(&grant_bytes).expect(\"parse grant\"),\n            grant\n        );\n\n        let capability_id =\n            MemoryFederationCapabilityId::parse(format!(\"federation:v1:{}\", \"a\".repeat(64)))\n                .expect(\"capability id\");\n        let revoke = AgentdRequest::memory_federation_revoke(11, 3, capability_id);\n        let revoke_bytes = serde_json::to_vec(&revoke).expect(\"serialize revoke\");\n        assert!(revoke_bytes.len() as u64 <= MAX_CONTROL_FRAME_BYTES);\n        assert_eq!(\n            serde_json::from_slice::<AgentdRequest>(&revoke_bytes).expect(\"parse revoke\"),\n            revoke\n        );\n\n        let malformed = String::from_utf8(revoke_bytes)\n            .expect(\"utf8\")\n            .replace(&\"a\".repeat(64), \"not-a-digest\");\n        assert!(serde_json::from_str::<AgentdRequest>(&malformed).is_err());\n    }\n\n    #[test]\n    fn run_lifecycle_wire_round_trip_is_strict_and_bounded() {\n        let snapshot = AgentRunSnapshot {\n            run_id: \"run.1\".to_string(),\n            request_digest: \"1\".repeat(64),\n            objective_digest: \"2\".repeat(64),\n            body_digest: \"3\".repeat(64),\n            artifact_set_digest: \"4\".repeat(64),\n            authority_epoch: 7,\n            generation: 4,\n            fence_digest: \"7\".repeat(64),\n            deadline_ms: 9_999,\n        };\n        let start = AgentdRequest::run_start(12, 3, snapshot.clone());\n        let start_bytes = serde_json::to_vec(&start).expect(\"serialize run start\");\n        assert!(start_bytes.len() as u64 <= MAX_CONTROL_FRAME_BYTES);\n        assert_eq!(\n            serde_json::from_slice::<AgentdRequest>(&start_bytes).expect(\"parse run start\"),\n            start\n        );\n\n        let attachment = AgentContextAttachment {\n            run_id: snapshot.run_id.clone(),\n            request_digest: snapshot.request_digest.clone(),\n            objective_digest: snapshot.objective_digest.clone(),\n            body_digest: snapshot.body_digest.clone(),\n            artifact_set_digest: snapshot.artifact_set_digest.clone(),\n            authority_epoch: snapshot.authority_epoch,\n            generation: snapshot.generation,\n            fence_digest: snapshot.fence_digest.clone(),\n            deadline_ms: snapshot.deadline_ms,\n            context_digest: \"5\".repeat(64),\n            compilation_receipt_digest: \"6\".repeat(64),\n        };\n        let attach = AgentdRequest::run_attach_context(13, 3, 1, attachment);\n        let attach_bytes = serde_json::to_vec(&attach).expect(\"serialize attachment\");\n        assert!(attach_bytes.len() as u64 <= MAX_CONTROL_FRAME_BYTES);\n        assert_eq!(\n            serde_json::from_slice::<AgentdRequest>(&attach_bytes).expect(\"parse attachment\"),\n            attach\n        );\n\n        let cancel =\n            AgentdRequest::run_cancel(14, 3, snapshot.run_id, 2, \"operator_request\".to_string());\n        let cancel_bytes = serde_json::to_vec(&cancel).expect(\"serialize cancellation\");\n        assert!(cancel_bytes.len() as u64 <= MAX_CONTROL_FRAME_BYTES);\n        assert_eq!(\n            serde_json::from_slice::<AgentdRequest>(&cancel_bytes).expect(\"parse cancellation\"),\n            cancel\n        );\n\n        let release = AgentdRequest::run_release_closed(16, 4, \"run.1\".to_string(), 10);\n        let release_bytes = serde_json::to_vec(&release).expect(\"serialize release\");\n        assert!(release_bytes.len() as u64 <= MAX_CONTROL_FRAME_BYTES);\n        assert_eq!(\n            serde_json::from_slice::<AgentdRequest>(&release_bytes).expect(\"parse release\"),\n            release\n        );\n    }\n\n    #[test]\n    fn host_turn_authority_binding_is_strict_and_fail_closed() {\n        let owner = AgentId::parse(\"019153a4-3088-7e03-a56a-9b1964f75dde\").expect(\"owner id\");\n        let binding = HostTurnAuthorityBinding::new(\n            owner,\n            \"lease:transport-witness\",\n            7,\n            11,\n            3,\n            \"fence:transport-witness\",\n            1_900_000_000,\n            Sha256Digest::for_bytes(b\"transport-head\"),\n        )\n        .expect(\"valid host authority binding\");\n        let bytes = serde_json::to_vec(&binding).expect(\"serialize host binding\");\n        assert!(bytes.len() as u64 <= MAX_CONTROL_FRAME_BYTES);\n        assert_eq!(\n            serde_json::from_slice::<HostTurnAuthorityBinding>(&bytes).expect(\"parse host binding\"),\n            binding\n        );\n\n        let mut zero_epoch = serde_json::to_string(&binding).expect(\"json\");\n        zero_epoch = zero_epoch.replace(\"\\\"authority_epoch\\\":7\", \"\\\"authority_epoch\\\":0\");\n        assert!(serde_json::from_str::<HostTurnAuthorityBinding>(&zero_epoch).is_err());\n\n        let unknown = serde_json::to_string(&binding)\n            .expect(\"json\")\n            .replace('}', \",\\\"unexpected\\\":true}\");\n        assert!(serde_json::from_str::<HostTurnAuthorityBinding>(&unknown).is_err());\n\n        assert!(\n            HostTurnAuthorityBinding::new(\n                binding.owner_agent_id,\n                binding.lease_id.clone(),\n                binding.authority_epoch,\n                binding.owner_epoch,\n                binding.generation,\n                \"\\0\",\n                binding.lease_expires_at_unix_seconds,\n                binding.lease_head_sha256,\n            )\n            .is_err()\n        );\n    }\n}\n\n#[cfg(test)]\n#[path = \"objective_tests.rs\"]\nmod objective_tests;\n\n#[cfg(test)]\n#[path = \"automation_effect_packet_tests.rs\"]\nmod automation_effect_packet_tests;\n"},"isError":false}},{"key":"source:TrillionniumFoundation/hepta-private-ci:codex-rs/hepta-agentd/ORDINARY_PQ_EFFECT_PACKET_V1.md","request":"https://api.github.com/repos/TrillionniumFoundation/hepta-private-ci/git/blobs/59c618036359b6aac1b9471e8872cc8b58b3dc3d","response":{"content":[{"type":"text","text":"Action completed."}],"structuredContent":{"content":"# Ordinary PQ PoN effect packet transport v1\n\n## Purpose and compatibility\n\nThe original ordinary effect API carries a hexadecimal payload in one newline-delimited JSON frame. Its 24 KiB decoded-payload limit and 64 KiB JSON-frame limit cannot carry the fixed Chain qualification packet, which is 49,508 bytes before hexadecimal expansion. An empty transaction list does not remove the packet's proof bytes.\n\nThe new `AutomationExecuteEffectPacketV1` request is a separately advertised transport. It carries the existing authorized intent, signed FinalUse grant, command ID and `wire_len` in the bounded JSON header, followed by the complete raw packet and a write-side EOF. It preserves the ordinary AutomationStore, FinalUse nonce owner, taskflow fence, operation identity, provider outbox and receipt readback. It does not split a packet, strip proof bytes, substitute a synthetic provider, retry a failed transport or fall back to the old API.\n\nThe old `AutomationExecuteEffect` request and all of its size limits remain unchanged. Historical failure evidence for that API remains valid. Qualification of v1 must not be recorded as success of the old inline protocol.\n\n## Admission contract\n\n| Input or resource | Rule |\n| --- | --- |\n| Capability | `automation.external_effect_packet`, major version 1; advertised only for an ordinary PoN adapter backed by ML-DSA-65 FinalUse authority |\n| Header | One complete newline-delimited JSON request within the existing 65,536-byte control-frame bound |\n| Body | Nonempty, at most 65,536 bytes; this matches the existing durable effect ledger ceiling |\n| Framing | Exactly `wire_len` bytes, followed by EOF; truncation and any trailing byte are rejected |\n| Integrity | SHA-256 of all raw packet bytes must equal the authorized intent's payload digest |\n| Authorization | Existing subject, destination, scope, taskflow fence, PQ issuer/revocation/frontier and FinalUse checks remain authoritative |\n| Bulk retention | Two per-server permits; a permit follows a packet into a blocking provider worker and is released only after the last owner drops it |\n| Time | Existing control request deadline is carried through packet reception, effect dispatch and native provider admission; the provider uses the earlier of that deadline and its own configured timeout |\n| Unknown outcome | A transport error does not authorize replay; reconcile the original effect identity |\n\nThe 64 KiB body limit is checked before allocating the body or claiming the FinalUse nonce. The initial qualification candidate used a 1 MiB transport bound; independent review found that the existing ledger rejects bodies above 64 KiB after the FinalUse claim. The final transport is narrowed to the ledger's existing ceiling. The ledger limit itself is not increased.\n\n## Cancellation and native entry\n\nThe execution token is checked before admission and again after body verification, before and after blocking queue handoff, after preparation of the pinned provider binary, and immediately before native process creation. The subprocess runner observes cancellation after entry and performs bounded direct-child cleanup. Any cancellation, timeout or incomplete output after process entry remains an unknown dispatch outcome; it is never reclassified as a proof of non-dispatch.\n\nThese checks do not make cancellation atomic with OS process creation. The cleanup grace is not an extension of the success deadline. The transport's two permits bound this new packet path, not all daemon memory, all provider children, existing inline requests or historical reconciliation work.\n\n## Required qualification\n\nQualification must bind the tested Hepta commit and tree, unchanged Cargo lockfile and nextest configuration, native toolchain, test executable hashes, and the exact Chain source/build/binary identity. Retain every failed and successful attempt separately.\n\nThe required checks are:\n\n1. Protocol serialization and client behavior, including capability refusal, bounded headers, full raw bytes, identity-checked responses, timeout and no fallback.\n2. Server framing under coalesced and fragmented input; zero, oversized, truncated and trailing bodies; digest mismatch; permit exhaustion and lifetime; cancellation and deadline handling.\n3. Ordinary PQ host rejection before authority consumption for invalid bindings, a classical or non-PoN owner, cancellation, and a 65,537-byte body. Nonce and durable-attempt state must remain unchanged on pre-admission refusal.\n4. Native direct-child tests for pre-entry refusal, exact 49,508-byte stdin/stdout, and post-entry cancellation yielding an unknown result with cleanup.\n5. The fixed full Chain packet on the original `legacy-v2` and `authenticated-v1` state backends, through both the ordinary PQ host and the real control socket/public client.\n6. Exact historical receipt readback after closing and reopening the real stores and owner, with trust services and the provider namespace subsequently unavailable, without another nonce claim or provider-store recreation.\n7. Cold rollback of the complete local Automation/FinalUse directory and Chain namespace after nonce consumption and after signed revocation, on both backends. Close the SQLx pool and every authority owner before copying or restoring files; retain the external frontier's future history; replay the original signed bytes. The ordinary loader must reject twice with `AntiRollbackViolation`, and the retained frontier and restored authority/provider files must remain unchanged. Record the original Chain pair and the final integrated Chain pair separately.\n\nThe socket qualification fixture explicitly establishes daemon readiness for this component test. It does not start the production AppServer or execute the daemon's Evidence startup gate. Its result is not a full production startup, deployment, or end-to-end PQ task/evaluator qualification.\n\nThe cold rollback test restores local owner state while its fixture clock and CAS frontier remain outside the restored directories. This is a component test of the external-frontier contract. It does not establish independently deployed custody or resistance to simultaneously rolling back every holder of the future history.\n\n## Claims retained outside this transport\n\nPassing these checks establishes bounded transport of a full packet through the ordinary PQ FinalUse owner. It does not independently establish production trust custody, complete software/configuration release roots, PQ requester/source/evaluator authority, persistent cross-owner rollback resistance, confidentiality of every listener, arbitrary-fork continuous recovery, or quantum PoN work-cost and fork-choice security. Those gates need their own fixed-source evidence and owners.\n"},"isError":false}},{"key":"source:TrillionniumFoundation/hepta-private-ci:codex-rs/hepta-agentd/src/automation_effect_host_packet.rs","request":"https://api.github.com/repos/TrillionniumFoundation/hepta-private-ci/git/blobs/f2d87f2f0184e08eae195dd5ab711252362c095e","response":{"content":[{"type":"text","text":"Action completed."}],"structuredContent":{"content":"//! Versioned full-packet transport into the existing authorized effect owner.\n//! The legacy inline route retains its original size and authentication checks.\n\nuse super::*;\nuse codex_hepta_contracts::FinalUseAuthenticationProfile;\n\npub(super) enum EffectWire<'a> {\n    Inline(&'a [u8]),\n    Packet(&'a crate::control_packet::AdmittedEffectPacketV1),\n}\n\nimpl AgentdAutomationEffectHost {\n    pub(crate) fn supports_packet_v1(&self) -> bool {\n        matches!(&self.adapter, AgentdProviderEffectAdapter::Pon(_))\n            && self.pq.is_some()\n            && self.authority.authentication_profile() == FinalUseAuthenticationProfile::MlDsa65V2\n    }\n\n    pub(crate) async fn execute_packet_v1(\n        &self,\n        store: &AutomationStore,\n        intent: &AuthorizedEffectIntent,\n        packet: &crate::control_packet::AdmittedEffectPacketV1,\n        signed_grant: &SignedFinalUseGrant,\n        command_id: &str,\n        now_ms: u64,\n    ) -> Result<TaskFlowStepReceipt, AgentdError> {\n        self.execute_wire(\n            store,\n            intent,\n           