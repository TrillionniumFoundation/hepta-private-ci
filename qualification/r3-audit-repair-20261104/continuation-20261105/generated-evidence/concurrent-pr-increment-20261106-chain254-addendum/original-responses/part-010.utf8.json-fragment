ionEffectObservation::Succeeded\n        );\n        let durable = fixture\n            .store\n            .authorized_taskflow_effect_attempt(&intent.run_id, &intent.step_id, intent.attempt)\n            .await?\n            .context(\"durable packet attempt\")?;\n        assert_eq!(durable.owner_agent_id, fixture.identity.agent_id);\n        assert_eq!(durable.intent_digest, intent.digest()?);\n        assert_eq!(durable.payload_digest, intent.payload_digest);\n        assert_eq!(durable.provider_effect_key.as_ref(), Some(&key));\n        assert_eq!(durable.wire_payload.as_deref(), Some(wire.as_slice()));\n        let original = fixture\n            .store\n            .read_authorized_taskflow_effect_receipt(&intent, command)\n            .await?\n            .context(\"original terminal receipt\")?;\n        assert_eq!(receipt.run_id, original.run_id);\n        assert_eq!(receipt.step_id, original.step_id);\n        assert_eq!(receipt.attempt, original.attempt);\n        assert_eq!(receipt.event_seq, original.event_seq);\n        assert_eq!(receipt.receipt_digest, original.receipt_digest);\n        let included = host\n            .adapter\n            .current_chain_observation(&provider_intent, Some(&wire))\n            .await\n            .context(\"native post-dispatch observation\")?;\n        assert!(included.stored_exact && included.active_chain_member);\n        assert_eq!(included.block_id, before.block_id);\n        assert_eq!(included.active_depth, Some(0));\n        assert_eq!(included.provider_effect_key.as_deref(), Some(key.as_str()));\n        assert_eq!(\n            included.payload_sha256.as_deref(),\n            Some(intent.payload_digest.as_str())\n        );\n        assert!(!included.confirmation_policy_satisfied);\n        assert!(!included.finality_authority && !included.execution_authority);\n        let mut block_binding = b\"trillionnium.pon.block.v1\\0\".to_vec();\n        block_binding.extend_from_slice(before.block_id.as_bytes());\n        let expected = AuthorizedEffectProviderReceipt::from_provider_ack(\n            ProviderEffectAck::new(\n                key,\n                intent.payload_digest.clone(),\n                Sha256Digest::for_bytes(&block_binding),\n                ProviderEffectAckStatus::Completed,\n            ),\n            ProviderEffectAckSource::DispatchResponse,\n        );\n        assert_eq!(\n            receipt.receipt_digest.as_ref(),\n            Some(&expected.receipt_digest)\n        );\n        let consumed = host.authority.frontier()?;\n        assert_eq!(host.authority.capacity()?.used_nonces, 1);\n        assert_eq!(\n            serde_json::from_slice::<FinalUseFrontier>(&fs::read(\n                setup.root.path().join(\"frontier.json\")\n            )?,)?,\n            consumed\n        );\n        control.stop().await?;\n        // Response delivery does not prove a detached connection released its\n        // owner. Require that release before reopening the original storage.\n        tokio::time::timeout(Duration::from_secs(2), async {\n            while Arc::strong_count(&host) != 1 {\n                tokio::task::yield_now().await;\n            }\n        })\n        .await?;\n        fixture.store.close().await;\n        drop(host);\n        let store = AutomationStore::open(&fixture.identity.layout).await?;\n        let reopened = Arc::new(AgentdAutomationEffectHost::open(\n            &fixture.identity,\n            &setup.config_path,\n        )?);\n        assert_eq!(reopened.authority.frontier()?, consumed);\n        let control = ControlFixture::start(&fixture, store.clone(), Arc::clone(&reopened)).await?;\n        // Move only this test's disposable provider namespace after ordinary\n        // loader validation. Stop trust services; retain the original binary.\n        fs::rename(&namespace, root.join(\"retained-receiver\"))?;\n        setup.now.store(now + 90_000, Ordering::SeqCst);\n        drop(setup);\n        let replay = control.packet(&intent, &wire, &grant, command).await?;\n        assert_eq!(replay, receipt);\n        assert_eq!(\n            store\n                .read_authorized_taskflow_effect_receipt(&intent, command,)\n                .await?,\n            Some(original)\n        );\n        assert_eq!(reopened.authority.capacity()?.used_nonces, 1);\n        assert!(\n            !namespace.exists(),\n            \"offline readback must not recreate the provider store\"\n        );\n        assert!(\n            control\n                .packet(&intent, &wire, &grant, \"changed-command\")\n                .await\n                .is_err()\n        );\n        control.stop().await?;\n        store.close().await;\n        println!(\n            \"{}\",\n            serde_json::json!({\n                \"case\":\"pq-packet-v1-control-socket-real-chain\", \"backend\":backend,\n                \"chain_source\":source, \"chain_binary_sha256\":digest.as_str(), \"wire_bytes\":wire.len(),\n                \"inline_limit_unchanged\":true, \"server_io_timeout_configuration_ms\":2000,\n                \"provider_timeout_configuration_ms\":30000, \"provider_elapsed_time_measured\":false,\n                \"receipt\":receipt, \"used_nonces\":1, \"restart_offline_exact_receipt\":true,\n                \"readiness_fixture_only\":true, \"app_server_launched\":false, \"evidence_startup_executed\":false,\n                \"chain_task_profile_is_pq\":false, \"independent_trust_deployment_qualified\":false,\n                \"process_start_count_measured\":false, \"energy_measured\":false, \"production_activation\":false,\n            })\n        );\n    }\n    Ok(())\n}\n\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]\nasync fn ordinary_pq_http_does_not_advertise_or_accept_packet_v1() -> anyhow::Result<()> {\n    let fixture = Fixture::new().await?;\n    let scope = Sha256Digest::for_bytes(b\"pq-http-no-packet-v1\");\n    let setup = PqFixture::http(\"http://127.0.0.1:9\", &scope)?;\n    let host = Arc::new(AgentdAutomationEffectHost::open(\n        &fixture.identity,\n        &setup.config_path,\n    )?);\n    let control = ControlFixture::start(&fixture, fixture.store.clone(), Arc::clone(&host)).await?;\n    let capabilities = control.client.capabilities().await?;\n    assert!(\n        capabilities\n            .capabilities\n            .iter()\n            .any(|capability| capability.id == crate::AGENTD_CAPABILITY_AUTOMATION_EXTERNAL_EFFECT)\n    );\n    assert!(\n        !capabilities\n            .capabilities\n            .iter()\n            .any(|capability| capability.id\n                == crate::AGENTD_CAPABILITY_AUTOMATION_EXTERNAL_EFFECT_PACKET_V1)\n    );\n    let intent = effect_intent(&scope);\n    let grant = setup.grant(&intent, NOW + 30_000)?;\n    let error = control\n        .packet(&intent, WIRE, &grant, \"http-cannot-gain-packet\")\n        .await\n        .unwrap_err();\n    assert!(error.to_string().contains(\"does not advertise\"), \"{error}\");\n    assert_eq!(host.authority.capacity()?.used_nonces, 0);\n    assert!(\n        fixture\n            .store\n            .pending_authorized_taskflow_effects(8)\n            .await?\n            .is_empty()\n    );\n    control.stop().await?;\n    fixture.store.close().await;\n    Ok(())\n}\n"},"isError":false}},{"key":"source:TrillionniumFoundation/hepta-private-ci:codex-rs/hepta-agentd/src/control_packet.rs","request":"https://api.github.com/repos/TrillionniumFoundation/hepta-private-ci/git/blobs/43df162273088fed1cc8905b4d50e21c8bfde06d","response":{"content":[{"type":"text","text":"Action completed."}],"structuredContent":{"content":"//! Bounded raw-packet transport for the versioned PoN effect method.\n//!\n//! Admission proves complete framing and payload identity, not authorization.\n//! The ordinary effect owner still verifies the PQ grant and owns dispatch.\n\nuse std::sync::Arc;\n\nuse codex_hepta_contracts::Sha256Digest;\nuse tokio::io::AsyncRead;\nuse tokio::io::AsyncReadExt;\nuse tokio::sync::OwnedSemaphorePermit;\nuse tokio::sync::Semaphore;\n\nuse crate::AGENTD_OVERLOAD_RETRY_AFTER_MS;\nuse crate::AgentdError;\nuse crate::MAX_AUTOMATION_EFFECT_PACKET_V1_BYTES;\nuse crate::NeuralCognitiveExecutionV1;\n\npub(crate) const PACKET_CONNECTION_CAPACITY: usize = 2;\n\n/// Complete immutable packet bytes with a reservation retained through provider\n/// execution, including an execution thread that outlives its control future.\npub(crate) struct AdmittedEffectPacketV1 {\n    wire_payload: Vec<u8>,\n    retention: Arc<OwnedSemaphorePermit>,\n    execution: NeuralCognitiveExecutionV1,\n}\n\nimpl AdmittedEffectPacketV1 {\n    /// Read one exact packet and the client's write-side EOF. The caller owns\n    /// the absolute deadline; progress never extends that deadline here.\n    pub(crate) async fn read(\n        reader: &mut (impl AsyncRead + Unpin),\n        wire_len: u32,\n        expected_digest: &Sha256Digest,\n        permits: Arc<Semaphore>,\n        execution: &NeuralCognitiveExecutionV1,\n    ) -> Result<Self, AgentdError> {\n        execution.check().map_err(AgentdError::Protocol)?;\n        let wire_len = usize::try_from(wire_len)\n            .ok()\n            .filter(|length| *length > 0 && *length <= MAX_AUTOMATION_EFFECT_PACKET_V1_BYTES)\n            .ok_or_else(|| {\n                AgentdError::Invalid(\"automation effect packet length is invalid\".to_string())\n            })?;\n        let retention =\n            Arc::new(\n                permits\n                    .try_acquire_owned()\n                    .map_err(|_| AgentdError::Overloaded {\n                        retry_after_ms: AGENTD_OVERLOAD_RETRY_AFTER_MS,\n                    })?,\n            );\n        let mut wire_payload = vec![0_u8; wire_len];\n        reader.read_exact(&mut wire_payload).await?;\n        let mut trailing = [0_u8; 1];\n        if reader.read(&mut trailing).await? != 0 {\n            return Err(AgentdError::Protocol(\n                \"automation effect packet has trailing bytes\".to_string(),\n            ));\n        }\n        if Sha256Digest::for_bytes(&wire_payload) != *expected_digest {\n            return Err(AgentdError::Invalid(\n                \"automation effect packet digest mismatch\".to_string(),\n            ));\n        }\n        execution.check().map_err(AgentdError::Protocol)?;\n        Ok(Self {\n            wire_payload,\n            retention,\n            execution: execution.clone(),\n        })\n    }\n\n    pub(crate) fn wire_payload(&self) -> &[u8] {\n        &self.wire_payload\n    }\n\n    pub(crate) fn retention(&self) -> Arc<OwnedSemaphorePermit> {\n        Arc::clone(&self.retention)\n    }\n\n    pub(crate) fn execution(&self) -> &NeuralCognitiveExecutionV1 {\n        &self.execution\n    }\n}\n\n#[cfg(test)]\n#[path = \"control_packet_tests.rs\"]\nmod tests;\n"},"isError":false}},{"key":"source:TrillionniumFoundation/hepta-private-ci:codex-rs/hepta-agentd/src/client_effect_packet.rs","request":"https://api.github.com/repos/TrillionniumFoundation/hepta-private-ci/git/blobs/e8330fe8a2fd8032fd2db5931fbc75f0d0b6e2ed","response":{"content":[{"type":"text","text":"Action completed."}],"structuredContent":{"content":"//! Explicit raw packet transport for the ordinary automation effect owner.\n\nuse codex_hepta_automation::AuthorizedEffectIntent;\nuse codex_hepta_contracts::Sha256Digest;\nuse codex_hepta_contracts::SignedFinalUseGrant;\nuse codex_uds::UnixStream;\nuse tokio::io::AsyncBufReadExt;\nuse tokio::io::AsyncReadExt;\nuse tokio::io::AsyncWriteExt;\nuse tokio::io::BufReader;\nuse tokio::time::Instant;\nuse tokio::time::timeout_at;\n\nuse crate::AGENTD_CAPABILITY_AUTOMATION_EXTERNAL_EFFECT_PACKET_V1;\nuse crate::AgentdError;\nuse crate::AgentdPayload;\nuse crate::AgentdRequest;\nuse crate::AutomationEffectSnapshot;\nuse crate::MAX_AUTOMATION_EFFECT_PACKET_V1_BYTES;\nuse crate::MAX_CONTROL_FRAME_BYTES;\n\nuse super::AgentdClient;\nuse super::unexpected;\n\nimpl AgentdClient {\n    /// Send one complete digest-bound packet under a separately advertised\n    /// capability. A transport error never triggers fallback or redispatch;\n    /// reconcile the original operation when its outcome is unknown.\n    pub async fn automation_execute_effect_packet_v1(\n        &self,\n        intent: AuthorizedEffectIntent,\n        wire_payload: &[u8],\n        signed_grant: SignedFinalUseGrant,\n        command_id: String,\n    ) -> Result<AutomationEffectSnapshot, AgentdError> {\n        let deadline = Instant::now() + self.timeout;\n        if wire_payload.is_empty() || wire_payload.len() > MAX_AUTOMATION_EFFECT_PACKET_V1_BYTES {\n            return Err(AgentdError::Invalid(\n                \"automation packet payload is empty or too large\".to_string(),\n            ));\n        }\n        if Sha256Digest::for_bytes(wire_payload) != intent.payload_digest {\n            return Err(AgentdError::Invalid(\n                \"automation packet does not match its authorized payload digest\".to_string(),\n            ));\n        }\n        let wire_len = u32::try_from(wire_payload.len()).map_err(|_| {\n            AgentdError::Invalid(\"automation packet length cannot be represented\".to_string())\n        })?;\n        let request = AgentdRequest::automation_execute_effect_packet_v1(\n            self.request_id(),\n            self.spawn_generation,\n            intent,\n            wire_len,\n            signed_grant,\n            command_id,\n        );\n        let mut header = serde_json::to_vec(&request)?;\n        header.push(b'\\n');\n        if header.len() as u64 > MAX_CONTROL_FRAME_BYTES {\n            return Err(AgentdError::Protocol(\n                \"agentd packet header exceeded frame bound\".to_string(),\n            ));\n        }\n        // Capability discovery and both connections share this one absolute\n        // deadline, including the full body, EOF and bounded response.\n        timeout_at(\n            deadline,\n            codex_uds::guard_future_before_deadline(deadline.into_std(), async {\n                let capabilities = self.capabilities().await?;\n                if !capabilities.capabilities.iter().any(|capability| {\n                    capability.id == AGENTD_CAPABILITY_AUTOMATION_EXTERNAL_EFFECT_PACKET_V1\n                        && capability.major == 1\n                }) {\n                    return Err(AgentdError::Protocol(\n                        \"agentd does not advertise automation packet v1 control\".to_string(),\n                    ));\n                }\n                let stream = UnixStream::connect(&self.socket_path).await?;\n                let (reader, mut writer) = tokio::io::split(stream);\n                writer.write_all(&header).await?;\n                writer.write_all(wire_payload).await?;\n                writer.shutdown().await?;\n                let mut reader = BufReader::new(reader).take(MAX_CONTROL_FRAME_BYTES + 1);\n                let mut response_bytes = Vec::new();\n                reader.read_until(b'\\n', &mut response_bytes).await?;\n                match self\n                    .decode_response(request.request_id, &response_bytes)?\n                    .payload\n                {\n                    AgentdPayload::AutomationEffect(receipt) => Ok(receipt),\n                    payload => unexpected(payload),\n                }\n            }),\n        )\n        .await\n        .ok()\n        .flatten()\n        .unwrap_or_else(|| {\n            Err(AgentdError::Protocol(\n                \"agentd packet request timed out; reconcile the original effect before retrying\"\n                    .to_string(),\n            ))\n        })\n    }\n}\n\n#[cfg(test)]\n#[path = \"client_effect_packet_tests.rs\"]\nmod tests;\n"},"isError":false}},{"key":"source:TrillionniumFoundation/hepta-private-ci:codex-rs/hepta-agentd/src/control.rs","request":"https://api.github.com/repos/TrillionniumFoundation/hepta-private-ci/git/blobs/8026824f5fe86ea828bbc04196f00f3b98695d11","response":{"content":[{"type":"text","text":"Action completed."}],"structuredContent":{"content":"use std::io::ErrorKind;\nuse std::path::Path;\nuse std::path::PathBuf;\nuse std::sync::Arc;\nuse std::time::Duration;\n\nuse codex_uds::UnixListener;\nuse codex_uds::UnixStream;\nuse tokio::io::AsyncBufRead;\nuse tokio::io::AsyncBufReadExt;\nuse tokio::io::AsyncReadExt;\nuse tokio::io::AsyncWriteExt;\nuse tokio::io::BufReader;\nuse tokio::sync::Semaphore;\nuse tokio::time::timeout_at;\nuse tokio_util::sync::CancellationToken;\n\nuse crate::AGENTD_CONTROL_OVERLOAD_FRAME;\nuse crate::AGENTD_CONTROL_SCHEMA_VERSION;\nuse crate::AgentdError;\nuse crate::AgentdMethod;\nuse crate::AgentdPayload;\nuse crate::AgentdRequest;\nuse crate::AgentdResponse;\nuse crate::AgentdState;\nuse crate::MAX_CONTROL_FRAME_BYTES;\nuse crate::control_packet::AdmittedEffectPacketV1;\nuse crate::control_packet::PACKET_CONNECTION_CAPACITY;\nuse crate::error::io_context;\n\nconst CONNECTION_CAPACITY: usize = 32;\nconst IO_TIMEOUT: Duration = Duration::from_secs(2);\nconst OVERLOAD_WRITE_TIMEOUT: Duration = Duration::from_millis(50);\n\npub(crate) struct AgentdControlServer {\n    listener: UnixListener,\n    socket_path: PathBuf,\n    state: Arc<AgentdState>,\n    cancellation: CancellationToken,\n    connections: Arc<Semaphore>,\n    effect_packets: Arc<Semaphore>,\n}\n\nimpl AgentdControlServer {\n    pub(crate) async fn bind(\n        socket_path: PathBuf,\n        state: Arc<AgentdState>,\n        cancellation: CancellationToken,\n    ) -> Result<Self, AgentdError> {\n        prepare_socket(&socket_path).await?;\n        let listener = UnixListener::bind(&socket_path)\n            .await\n            .map_err(|error| io_context(\"bind agentd control socket\", &socket_path, error))?;\n        set_owner_only(&socket_path).await?;\n        Ok(Self {\n            listener,\n            socket_path,\n            state,\n            cancellation,\n            connections: Arc::new(Semaphore::new(CONNECTION_CAPACITY)),\n            effect_packets: Arc::new(Semaphore::new(PACKET_CONNECTION_CAPACITY)),\n        })\n    }\n\n    pub(crate) async fn run(mut self) -> Result<(), AgentdError> {\n        loop {\n            let stream = tokio::select! {\n                _ = self.cancellation.cancelled() => return Ok(()),\n                accepted = self.listener.accept() => accepted?,\n            };\n            let deadline = std::time::Instant::now() + IO_TIMEOUT;\n            if stream.ensure_current_user_peer().is_err() || std::time::Instant::now() >= deadline {\n                continue;\n            }\n            let Ok(permit) = Arc::clone(&self.connections).try_acquire_owned() else {\n                let mut stream = stream;\n                let overload_deadline =\n                    deadline.min(std::time::Instant::now() + OVERLOAD_WRITE_TIMEOUT);\n                let _ = timeout_at(\n                    tokio::time::Instant::from_std(overload_deadline),\n                    codex_uds::guard_future_before_deadline(overload_deadline, async {\n                        stream.write_all(AGENTD_CONTROL_OVERLOAD_FRAME).await?;\n                        stream.shutdown().await\n                    }),\n                )\n                .await;\n                continue;\n            };\n            let state = Arc::clone(&self.state);\n            let effect_packets = Arc::clone(&self.effect_packets);\n            let cancellation = self.cancellation.child_token();\n            let execution =\n                crate::NeuralCognitiveExecutionV1::with_deadline(deadline, cancellation.clone());\n            tokio::spawn(async move {\n                let _permit = permit;\n                let _cancel_on_exit = cancellation.drop_guard();\n                if execution.check().is_err() {\n                    return;\n                }\n                let _ = tokio::time::timeout_at(\n                    tokio::time::Instant::from_std(execution.deadline()),\n                    codex_uds::guard_future_before_deadline(\n                        execution.deadline(),\n                        serve_connection(stream, state, effect_packets, &execution),\n                    ),\n                )\n                .await;\n            });\n        }\n    }\n}\n\nimpl Drop for AgentdControlServer {\n    fn drop(&mut self) {\n        if let Err(error) = std::fs::remove_file(&self.socket_path)\n            && error.kind() != ErrorKind::NotFound\n        {\n            eprintln!(\n                \"failed to remove agentd control socket {}: {error}\",\n                self.socket_path.display()\n            );\n        }\n    }\n}\n\nasync fn serve_connection(\n    stream: UnixStream,\n    state: Arc<AgentdState>,\n    effect_packets: Arc<Semaphore>,\n    execution: &crate::NeuralCognitiveExecutionV1,\n) -> Result<(), AgentdError> {\n    let (reader, mut writer) = tokio::io::split(stream);\n    // Keep the same buffer for the header and raw body: a single client write\n    // may already have placed packet bytes in BufReader's unread buffer.\n    let mut reader = BufReader::new(reader);\n    let frame = read_request_frame(&mut reader).await?;\n    let request: AgentdRequest = serde_json::from_slice(&frame)?;\n    let response = if request.schema_version != AGENTD_CONTROL_SCHEMA_VERSION {\n        error_response(\n            &state,\n            request.request_id,\n            request.spawn_generation,\n            \"unsupported_schema\",\n            \"unsupported agentd control schema\",\n        )\n    } else {\n        let result = match &request.method {\n            AgentdMethod::AutomationExecuteEffectPacketV1 {\n                intent, wire_len, ..\n            } => {\n                match AdmittedEffectPacketV1::read(\n                    &mut reader,\n                    *wire_len,\n                    &intent.payload_digest,\n                    effect_packets,\n                    execution,\n                )\n                .await\n                {\n                    Ok(packet) => {\n                        if execution.check().is_err() {\n                            Err(AgentdError::Protocol(\n                                \"agentd packet request expired or was cancelled before execution\"\n                                    .to_string(),\n                            ))\n                        } else {\n                            state\n                                .response_with_packet(\n                                    request.request_id,\n                                    request.spawn_generation,\n                                    request.method,\n                                    Some(&packet),\n                                    execution,\n                                )\n                                .await\n                        }\n                    }\n                    Err(AgentdError::Overloaded { .. }) => {\n                        writer.write_all(AGENTD_CONTROL_OVERLOAD_FRAME).await?;\n                        writer.shutdown().await?;\n                        return Ok(());\n                    }\n                    Err(error) => Err(error),\n                }\n            }\n            _ => {\n                state\n                    .response_with_execution(\n                        request.request_id,\n                        request.spawn_generation,\n                        request.method,\n                        execution,\n                    )\n                    .await\n            }\n        };\n        match result {\n            Ok(response) => response,\n            Err(error) => error_response(\n                &state,\n                request.request_id,\n                request.spawn_generation,\n                \"request_rejected\",\n                &error.to_string(),\n            ),\n        }\n    };\n    let mut bytes = serde_json::to_vec(&response)?;\n    bytes.push(b'\\n');\n    if bytes.len() as u64 > MAX_CONTROL_FRAME_BYTES {\n        return Err(AgentdError::Protocol(\n            \"agentd control response exceeded frame bound\".to_string(),\n        ));\n    }\n    writer.write_all(&bytes).await?;\n    writer.shutdown().await?;\n    Ok(())\n}\n\npub(crate) async fn read_request_frame(\n    reader: &mut (impl AsyncBufRead + Unpin),\n) -> Result<Vec<u8>, AgentdError> {\n    let mut reader = reader.take(MAX_CONTROL_FRAME_BYTES + 1);\n    let mut frame = Vec::new();\n    let count = reader.read_until(b'\\n', &mut frame).await?;\n    if count == 0 || count as u64 > MAX_CONTROL_FRAME_BYTES || !frame.ends_with(b\"\\n\") {\n        return Err(AgentdError::Protocol(\n            \"agentd control request must be one bounded newline JSON frame\".to_string(),\n        ));\n    }\n    Ok(frame)\n}\n\nfn error_response(\n    state: &AgentdState,\n    request_id: u64,\n    spawn_generation: u64,\n    code: &str,\n    message: &str,\n) -> AgentdResponse {\n    AgentdResponse {\n        schema_version: AGENTD_CONTROL_SCHEMA_VERSION,\n        request_id,\n        agent_id: state.identity().agent_id.clone(),\n        spawn_generation: state.identity().spawn_generation,\n        current_generation: spawn_generation,\n        payload: AgentdPayload::Error {\n            code: code.to_string(),\n            message: bounded_message(message),\n        },\n    }\n}\n\nfn bounded_message(message: &str) -> String {\n    message.chars().take(512).collect()\n}\n\nasync fn prepare_socket(socket_path: &Path) -> Result<(), AgentdError> {\n    let parent = socket_path.parent().ok_or_else(|| {\n        AgentdError::Invalid(\"agentd control socket has no parent directory\".to_string())\n    })?;\n    codex_uds::prepare_private_socket_directory(parent)\n        .await\n        .map_err(|error| io_context(\"prepare agentd control socket directory\", parent, error))?;\n    match UnixStream::connect(socket_path).await {\n        Ok(_) => {\n            return Err(AgentdError::Io(std::io::Error::new(\n                ErrorKind::AddrInUse,\n                format!(\n                    \"agentd control socket is already live at {}\",\n                    socket_path.display()\n                ),\n            )));\n        }\n        Err(error) if error.kind() == ErrorKind::NotFound => return Ok(()),\n        Err(error) if error.kind() == ErrorKind::ConnectionRefused => {}\n        Err(_error) if !socket_path.exists() => return Ok(()),\n        Err(error) => {\n            return Err(io_context(\n                /* operation */ \"probe existing agentd control socket\",\n                /* path */ socket_path,\n                /* source */ error,\n            ));\n        }\n    }\n    if codex_uds::is_stale_socket_path(socket_path)\n        .await\n        .map_err(|error| io_context(\"inspect stale agentd control socket\", socket_path, error))?\n    {\n        tokio::fs::remove_file(socket_path).await.map_err(|error| {\n            io_context(\"remove stale agentd control socket\", socket_path, error)\n        })?;\n        Ok(())\n    } else {\n        Err(AgentdError::Io(std::io::Error::new(\n            ErrorKind::AlreadyExists,\n            format!(\n                \"agentd control socket path is not a stale socket: {}\",\n                socket_path.display()\n            ),\n        )))\n    }\n}\n\n#[cfg(unix)]\nasync fn set_owner_only(path: &Path) -> Result<(), AgentdError> {\n    use std::os::unix::fs::PermissionsExt;\n\n    tokio::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600))\n        .await\n        .map_err(|error| {\n            io_context(\n                \"set owner-only agentd control socket permissions\",\n                path,\n                error,\n            )\n        })?;\n    Ok(())\n}\n\n#[cfg(not(unix))]\nasync fn set_owner_only(_path: &Path) -> Result<(), AgentdError> {\n    Ok(())\n}\n"},"isError":false}},{"key":"source:TrillionniumFoundation/hepta-private-ci:codex-rs/hepta-agentd/src/client.rs","request":"https://api.github.com/repos/TrillionniumFoundation/hepta-private-ci/git/blobs/779b2f94f611b80f374e68d8de391ea018217b8f","response":{"content":[{"type":"text","text":"Action completed."}],"structuredContent":{"content":"use std::path::PathBuf;\nuse std::sync::atomic::AtomicU64;\nuse std::sync::atomic::Ordering;\nuse std::time::Duration;\n\nuse codex_hepta_agent_protocol::DrainSnapshot;\nuse codex_hepta_automation::AuthorizedEffectIntent;\nuse codex_hepta_automation::AutomationCalendarScheduleV2;\nuse codex_hepta_automation::AutomationMissedRunPolicy;\nuse codex_hepta_automation::AutomationOverlapPolicy;\nuse codex_hepta_automation::AutomationTask;\nuse codex_hepta_automation::AutomationTaskDraft;\nuse codex_hepta_automation::AutomationTaskId;\nuse codex_hepta_contracts::AgentId;\nuse codex_hepta_contracts::SignedFinalUseGrant;\nuse codex_uds::UnixStream;\nuse tokio::io::AsyncBufReadExt;\nuse tokio::io::AsyncReadExt;\nuse tokio::io::AsyncWriteExt;\nuse tokio::io::BufReader;\nuse tokio::time::timeout;\n\nuse crate::AGENTD_CONTROL_OVERLOAD_FRAME;\nuse crate::AGENTD_CONTROL_SCHEMA_VERSION;\nuse crate::AGENTD_OVERLOAD_RETRY_AFTER_MS;\nuse crate::AgentContextAttachment;\nuse crate::AgentRunCancellation;\nuse crate::AgentRunPhase;\nuse crate::AgentRunReceipt;\nuse crate::AgentRunSnapshot;\nuse crate::AgentdCapabilitySet;\nuse crate::AgentdError;\nuse crate::AgentdPayload;\nuse crate::AgentdRequest;\nuse crate::AgentdResponse;\nuse crate::AuthBusObjectiveIngress;\nuse crate::AutomationEffectReconcileSnapshot;\nuse crate::AutomationEffectSnapshot;\nuse crate::EventBatch;\nuse crate::HealthSnapshot;\nuse crate::LifecycleSnapshot;\nuse crate::MAX_CONTROL_FRAME_BYTES;\nuse crate::MemoryFederationCapabilityId;\nuse crate::MemoryFederationCapabilitySnapshot;\nuse crate::MemoryFederationScopeKind;\nuse crate::ObjectiveStartOutcome;\nuse crate::SessionIngress;\n\n#[path = \"client_effect_packet.rs\"]\nmod effect_packet;\n\npub struct AgentdClient {\n    socket_path: PathBuf,\n    expected_agent_id: AgentId,\n    spawn_generation: u64,\n    next_request_id: AtomicU64,\n    timeout: Duration,\n}\n\nimpl AgentdClient {\n    pub fn new(\n        socket_path: PathBuf,\n        expected_agent_id: AgentId,\n        spawn_generation: u64,\n    ) -> Result<Self, AgentdError> {\n        if !socket_path.is_absolute() || spawn_generation == 0 {\n            return Err(AgentdError::Invalid(\n                \"agentd client requires an absolute socket and non-zero spawn generation\"\n                    .to_string(),\n            ));\n        }\n        Ok(Self {\n            socket_path,\n            expected_agent_id,\n            spawn_generation,\n            next_request_id: AtomicU64::new(1),\n            timeout: Duration::from_secs(2),\n        })\n    }\n\n    pub async fn capabilities(&self) -> Result<AgentdCapabilitySet, AgentdError> {\n        match self\n            .send(AgentdRequest::capabilities(\n                self.request_id(),\n                self.spawn_generation,\n            ))\n            .await?\n            .payload\n        {\n            AgentdPayload::Capabilities(capabilities) => {\n                capabilities.validate().map_err(AgentdError::Protocol)?;\n                Ok(capabilities)\n            }\n            payload => unexpected(payload),\n        }\n    }\n\n    pub async fn health(&self) -> Result<HealthSnapshot, AgentdError> {\n        match self\n            .send(AgentdRequest::health(\n                self.request_id(),\n                self.spawn_generation,\n            ))\n            .await?\n            .payload\n        {\n            AgentdPayload::Health(snapshot) => Ok(snapshot),\n            payload => unexpected(payload),\n        }\n    }\n\n    pub async fn lifecycle(&self) -> Result<LifecycleSnapshot, AgentdError> {\n        match self\n            .send(AgentdRequest::lifecycle(\n                self.request_id(),\n                self.spawn_generation,\n            ))\n            .await?\n            .payload\n        {\n            AgentdPayload::Lifecycle(snapshot) => Ok(snapshot),\n            payload => unexpected(payload),\n        }\n    }\n\n    /// Request the existing owner drain after Supervisor enters Draining.\n    /// A drained response reports quiescence, not process exit or task joining.\n    pub async fn drain(&self) -> Result<DrainSnapshot, AgentdError> {\n        match self\n            .send(AgentdRequest::drain(\n                self.request_id(),\n                self.spawn_generation,\n            ))\n            .await?\n            .payload\n        {\n            AgentdPayload::Drain(snapshot) => Ok(snapshot),\n            payload => unexpected(payload),\n        }\n    }\n\n    pub async fn session_ingress(&self) -> Result<SessionIngress, AgentdError> {\n        match self\n            .send(AgentdRequest::session_ingress(\n                self.request_id(),\n                self.spawn_generation,\n            ))\n            .await?\n            .payload\n        {\n            AgentdPayload::SessionIngress(ingress) => Ok(ingress),\n            payload => unexpected(payload),\n        }\n    }\n\n    pub async fn objective_start(\n        &self,\n        request: AuthBusObjectiveIngress,\n    ) -> Result<ObjectiveStartOutcome, AgentdError> {\n        match self\n            .send(AgentdRequest::objective_start(\n                self.request_id(),\n                self.spawn_generation,\n                request,\n            ))\n            .await?\n            .payload\n        {\n            AgentdPayload::ObjectiveRun(receipt) => Ok(ObjectiveStartOutcome::Admitted { receipt }),\n            AgentdPayload::ObjectiveConflict {\n                run_id,\n                conflict_digest,\n            } => Ok(ObjectiveStartOutcome::Conflict {\n                run_id,\n                conflict_digest,\n            }),\n            payload => unexpected(payload),\n        }\n    }\n\n    /// Read verified context through this exact generation's canonical owner.\n    pub async fn cognitive_context(\n        &self,\n        query: String,\n        limit: u16,\n    ) -> Result<crate::CognitiveContextSnapshot, AgentdError> {\n        match self\n            .send(AgentdRequest {\n                schema_version: AGENTD_CONTROL_SCHEMA_VERSION,\n                request_id: self.request_id(),\n                spawn_generation: self.spawn_generation,\n                method: crate::AgentdMethod::CognitiveContext { query, limit },\n            })\n            .await?\n            .payload\n        {\n            AgentdPayload::CognitiveContext(snapshot) => Ok(snapshot),\n            payload => unexpected(payload),\n        }\n    }\n\n    /// Read the unchanged owner snapshot and its original settled neural work\n    /// in the separately negotiated, bounded execution envelope.\n    pub async fn cognitive_context_with_execution_v1(\n        &self,\n        query: String,\n        limit: u16,\n    ) -> Result<crate::CognitiveContextExecutionV1, AgentdError> {\n        match self\n            .send(AgentdRequest {\n                schema_version: AGENTD_CONTROL_SCHEMA_VERSION,\n                request_id: self.request_id(),\n                spawn_generation: self.spawn_generation,\n                method: crate::AgentdMethod::CognitiveContextWithExecutionV1 { query, limit },\n            })\n            .await?\n            .payload\n        {\n            AgentdPayload::CognitiveContextWithExecutionV1(context) => {\n                crate::cognitive_execution::validate_context_execution_v1(&context)\n                    .map_err(AgentdError::Protocol)?;\n                if context.neural.as_ref().is_some_and(|neural| {\n                    neural.owner_id != self.expected_agent_id\n                        || neural.body_generation != self.spawn_generation\n                }) {\n                    return Err(AgentdError::Protocol(\n                        \"cognitive execution