+#[test]
+fn state_parse_error_releases_lock_and_lock_path_stays_bound() -> Result<()> {
+    let temp = tempfile::tempdir()?;
+    let state_path = temp.path().join(DENY_READ_ACL_STATE_FILE);
+    fs::write(&state_path, b"{")?;
+    let result = (|| {
+        let _guard = acquire_state_lock(&state_path)?;
+        load_state(&state_path)
+    })();
+    let error = match result {
+        Ok(_) => anyhow::bail!("malformed state must remain an error"),
+        Err(error) => error,
+    };
+    assert!(format!("{error:#}").contains("parse deny-read ACL state"));
+    assert_eq!(fs::read(&state_path)?, b"{");
+    let lock_path = state_path.with_extension("lock");
+    let probe = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .share_mode(FILE_SHARE_READ | FILE_SHARE_WRITE)
+        .open(&lock_path)?;
+    probe.try_lock().context("parse error must release the lock")?;
+    assert!(fs::remove_file(&lock_path).is_err());
+    let moved = temp.path().join("moved-lock");
+    assert!(fs::rename(&lock_path, &moved).is_err());
+    drop(probe);
+    fs::rename(&lock_path, &moved)?;
+    fs::create_dir(&lock_path)?;
+    assert!(acquire_state_lock(&state_path).is_err());
+    assert_eq!(fs::read(&state_path)?, b"{");
+    Ok(())
+}
