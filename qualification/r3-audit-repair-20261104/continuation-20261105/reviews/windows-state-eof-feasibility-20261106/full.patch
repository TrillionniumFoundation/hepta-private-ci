+use super::DENY_READ_ACL_STATE_FILE;
+use super::PersistentDenyReadAclState;
+use super::acquire_state_lock;
+use super::load_state;
+use super::store_state;
+use anyhow::Context;
+use anyhow::Result;
+use pretty_assertions::assert_eq;
+use std::collections::BTreeMap;
+use std::fs;
+use std::fs::OpenOptions;
+use std::fs::TryLockError;
+use std::os::windows::fs::OpenOptionsExt;
+use std::path::PathBuf;
+use std::process::Child;
+use std::process::Command;
+use std::process::ExitStatus;
+use std::process::Stdio;
+use std::time::Duration;
+use std::time::Instant;
+use windows_sys::Win32::Storage::FileSystem::FILE_SHARE_READ;
+use windows_sys::Win32::Storage::FileSystem::FILE_SHARE_WRITE;
+
+const CHILD_DIRECTORY_ENV: &str = "CODEX_DENY_READ_STATE_LOCK_TEST_DIRECTORY";
+const CHILD_CASE: &str = "deny_read_state::tests::state_lock_child_process";
+const WAIT_LIMIT: Duration = Duration::from_secs(/*secs*/ 10);
+const WAIT_STEP: Duration = Duration::from_millis(/*millis*/ 10);
+
+struct OwnedChild(Child);
+
+impl OwnedChild {
+    fn wait(&mut self) -> Result<ExitStatus> {
+        let deadline = Instant::now() + WAIT_LIMIT;
+        loop {
+            if let Some(status) = self.0.try_wait()? {
+                return Ok(status);
+            }
+            anyhow::ensure!(Instant::now() < deadline, "state lock child did not finish");
+            std::thread::sleep(WAIT_STEP);
+        }
+    }
+}
+
+impl Drop for OwnedChild {
+    fn drop(&mut self) {
+        // This guard owns this exact child; never signal a guessed PID.
+        if !matches!(self.0.try_wait(), Ok(Some(_))) {
+            let _ = self.0.kill();
+            let _ = self.0.wait();
+        }
+    }
+}
+
+#[test]
+fn state_lock_serializes_cross_process_state_updates() -> Result<()> {
+    let temp = tempfile::tempdir()?;
+    let state_path = temp.path().join(DENY_READ_ACL_STATE_FILE);
+    let parent = PersistentDenyReadAclState {
+        principals: BTreeMap::from([(
+            "parent-principal".to_string(),
+            vec![PathBuf::from("parent-path")],
+        )]),
+    };
+    let guard = acquire_state_lock(&state_path)?;
+    store_state(&state_path, &parent)?;
+    // Deterministically hold the original truncate-before-write window open.
+    fs::write(&state_path, b"")?;
+    assert!(load_state(&state_path).is_err(), "empty JSON must still fail");
+    let log_path = temp.path().join("child.log");
+    let log = OpenOptions::new().write(true).create_new(true).open(&log_path)?;
+    let mut child = OwnedChild(
+        Command::new(std::env::current_exe()?)
+            .arg("--exact")
+            .arg(CHILD_CASE)
+            .arg("--ignored")
+            .arg("--nocapture")
+            .env(CHILD_DIRECTORY_ENV, temp.path())
+            .stdin(Stdio::null())
+            .stdout(Stdio::from(log.try_clone()?))
+            .stderr(Stdio::from(log))
+            .spawn()?,
+    );
+    let blocked = temp.path().join("blocked");
+    let deadline = Instant::now() + WAIT_LIMIT;
+    while !blocked.exists() {
+        if let Some(status) = child.0.try_wait()? {
+            anyhow::bail!(
+                "state lock child exited before the lock probe: {status}\n{}",
+                fs::read_to_string(&log_path)?
+            );
+        }
+        anyhow::ensure!(Instant::now() < deadline, "state lock child did not probe");
+        std::thread::sleep(WAIT_STEP);
+    }
+    // The child wrote this only after its native try_lock returned WouldBlock.
+    assert_eq!(fs::read(&blocked)?, b"lock blocked");
+    assert!(!temp.path().join("acquired").exists());
+    assert_eq!(fs::read(&state_path)?, b"");
+    store_state(&state_path, &parent)?;
+    drop(guard);
+    let status = child.wait()?;
+    anyhow::ensure!(
+        status.success(),
+        "state lock child failed: {status}\n{}",
+        fs::read_to_string(&log_path)?
+    );
+    assert_eq!(fs::read(temp.path().join("acquired"))?, b"loaded complete state");
+    let final_state = load_state(&state_path)?;
+    assert_eq!(
+        final_state.principals,
+        BTreeMap::from([
+            ("parent-principal".to_string(), vec![PathBuf::from("parent-path")]),
+            ("child-principal".to_string(), vec![PathBuf::from("child-path")]),
+        ])
+    );
+    Ok(())
+}
+
+#[test]
+#[ignore = "owned child helper for state_lock_serializes_cross_process_state_updates"]
+fn state_lock_child_process() -> Result<()> {
+    let directory = PathBuf::from(
+        std::env::var_os(CHILD_DIRECTORY_ENV).context("state lock child directory is missing")?,
+    );
+    let state_path = directory.join(DENY_READ_ACL_STATE_FILE);
+    let probe = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .share_mode(FILE_SHARE_READ | FILE_SHARE_WRITE)
+        .open(state_path.with_extension("lock"))?;
+    anyhow::ensure!(
+        matches!(probe.try_lock(), Err(TryLockError::WouldBlock)),
+        "parent must hold the native lock while state is empty"
+    );
+    drop(probe);
+    fs::write(directory.join("blocked"), b"lock blocked")?;
+    let _guard = acquire_state_lock(&state_path)?;
+    let mut state = load_state(&state_path)?;
+    assert_eq!(
+        state.principals,
+        BTreeMap::from([(
+            "parent-principal".to_string(),
+            vec![PathBuf::from("parent-path")],
+        )])
+    );
+    fs::write(directory.join("acquired"), b"loaded complete state")?;
+    state.principals.insert(
+        "child-principal".to_string(),
+        vec![PathBuf::from("child-path")],
+    );
+    store_state(&state_path, &state)?;
+    Ok(())
+}
