+fn acquire_state_lock(state_path: &Path) -> Result<File> {
+    let lock_path = state_path.with_extension("lock");
+    let lock = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        // Keep one file identity while any participant holds an open handle.
+        // Do not delete this persistent lock file when releasing the lock.
+        .share_mode(FILE_SHARE_READ | FILE_SHARE_WRITE)
+        .custom_flags(FILE_FLAG_OPEN_REPARSE_POINT)
+        .open(&lock_path)
+        .with_context(|| format!("open deny-read ACL state lock {}", lock_path.display()))?;
+    let metadata = lock
+        .metadata()
+        .with_context(|| format!("inspect deny-read ACL state lock {}", lock_path.display()))?;
+    if !metadata.is_file() || metadata.file_attributes() & FILE_ATTRIBUTE_REPARSE_POINT != 0 {
+        anyhow::bail!(
+            "deny-read ACL state lock is not a regular file: {}",
+            lock_path.display()
+        );
+    }
+    lock.lock()
+        .with_context(|| format!("lock deny-read ACL state {}", state_path.display()))?;
+    Ok(lock)
+}
