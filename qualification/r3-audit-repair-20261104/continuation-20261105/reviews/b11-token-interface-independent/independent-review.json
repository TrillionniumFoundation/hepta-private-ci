  "findings": [
    {
      "id": "F1",
      "kind": "source+physical",
      "finding": "The current base-token/capability-SID factory has no owned root handles, readable set, integrity-label contract, or per-operation filesystem mediator. The production bytes match the original failing token after removing only a cfg(test) module suffix."
    },
    {
      "id": "F2",
      "kind": "physical+AccessCheck-distinction",
      "finding": "Original production-token tests physically remove outside objects; the full-restricting variant is only an AccessCheck control and rejects outside read there. It was never impersonated for physical I/O."
    },
    {
      "id": "F3",
      "kind": "documented-API+inference",
      "finding": "Restricting-SID attributes do not supply a read-only access mask. Adding a SID with broad allow ACEs cannot be assumed to restore read while withholding write/delete; deny-only removes all allow matches for that SID."
    },
    {
      "id": "F4",
      "kind": "scope-limited-inference",
      "finding": "The documented target DELETE or parent DELETE_CHILD rule coheres with the actual AccessCheck and physical results. No private-kernel syscall route or universal Windows-build behavior is claimed."
    },
    {
      "id": "F5",
      "kind": "source+inference",
      "finding": "A default DACL update changes the token default for new objects, not the retained existing outside-parent DACL. A launch-only AccessCheck or blanket Err cannot implement the original successful-operation contract."
    },
    {
      "id": "F6",
      "kind": "missing-inputs-not-OS-impossibility",
      "finding": "MIC is a distinct possible layer but requires actual token/object label observations, selected-root custody, positive-root write feasibility, outside low-integrity handling and lifecycle/restoration semantics. Those inputs are not supplied to the current constructor."
    },
    {
      "id": "F7",
      "kind": "official-rights-precision",
      "finding": "LABEL_SECURITY_INFORMATION query requires READ_CONTROL; set requires WRITE_OWNER. Do not conflate a label-only operation with whole-SACL ACCESS_SYSTEM_SECURITY or assert all label observation requires administrator authority."
    }
  ],
  "next_implementation_requirements": [
    {
      "option": "explicit-read-roots-full-restriction",
      "new_inputs": [
        "trusted read-root and write-root objects",
        "independent read capability and exact access masks",
        "actual ACL installation completion and object identity",
        "real caller mode plus cleanup/concurrency/loader/IPC coverage"
      ],
      "permissions": [
        "READ_CONTROL to query DACL",
        "WRITE_DAC to change DACL"
      ],
      "contract_limit": "Cannot silently narrow ambient-read semantics or modify original strict assertions. A new mode is not the old raw-token factory closure."
    },
    {
      "option": "mandatory-integrity-layer",
      "new_inputs": [
        "actual TokenIntegrityLevel and TokenMandatoryPolicy",
        "same-object mandatory labels",
        "selected writable-root custody",
        "outside lower-integrity counterexample coverage",
        "label inheritance and restoration ownership"
      ],
      "permissions": [
        "READ_CONTROL for LABEL_SECURITY_INFORMATION query",
        "WRITE_OWNER for LABEL_SECURITY_INFORMATION set; effective OS constraints still must be observed"
      ],
      "contract_limit": "No assumed root labels, rights or universal outside-medium environment. No unconditional relabel of all capability-granted roots."
    },
    {
      "option": "preserve-ambient-read-with-independent-file-operation-enforcement",
      "new_inputs": [
        "real unbypassable per-operation enforcement component",
        "authoritative root/object policy and handle lifecycle"
      ],
      "contract_limit": "No proven reusable component was found in the inspected call chain. This is not a whole-repository or whole-OS absence theorem."
    }
  ],
