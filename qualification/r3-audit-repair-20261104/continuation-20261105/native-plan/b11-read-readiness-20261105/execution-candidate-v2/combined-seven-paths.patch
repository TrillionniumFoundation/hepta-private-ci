+            "complete_compiled_roster_covered": True, "ignored": 0, "outer_xml_cases": len(outer)}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--evidence", type=Path, required=True)
+    args = parser.parse_args()
+    if os.name != "nt":
+        raise RuntimeError("this original setup-bin gate requires native Windows")
+    root = Path(__file__).resolve().parents[2]
+    control = load_control(root)
+    original = args.evidence.resolve(strict=True)
+    control.require(original.is_relative_to(Path(os.environ["RUNNER_TEMP"]).resolve(strict=True)), "evidence is outside runner temp")
+    evidence = original / "read-acl-readiness"
+    evidence.mkdir(exist_ok=False)
+    report = {"status": "NOT_STARTED", "command_launch_attempted": False, "command_completed": False,
+              "helper_case_execution_verified": False, "helper_qualified": False,
+              "product_B11": "OPEN", "original_library_result_unchanged": True,
+              "full_read_grants_loader_or_descendants_qualified": False}
+    entry = None
+    exit_code = None
+    error = None
+    final_error = None
+    head = control.git(root, "rev-parse", "HEAD").decode().strip()
+    try:
+        previous = original / "acl-identity-counterfactual"
+        prior = json.loads((previous / "counterfactual-terminal.json").read_text(encoding="utf-8"))
+        control.require(prior.get("status") == "VALID_NEGATIVE_AND_EXACT_RESTORE"
+                        and prior.get("physical_counterfactual_qualified") is True
+                        and prior.get("restored_exact_original_bytes") is True
+                        and prior.get("error") is None and prior.get("restore_error") is None,
+                        "the preceding counterfactual did not qualify and restore exactly")
+        restored = json.loads((previous / "source-restored.json").read_text(encoding="utf-8"))
+        prior_entry = json.loads((previous / "source-entry.json").read_text(encoding="utf-8"))
+        entry = guard(control, root, head)
+        control.require(entry["source"] == prior_entry == restored, "fresh source/index/locks differ from the original exact restore")
+        control.save(evidence, "source-before.json", entry)
+        archive = evidence / "bazel-execution-logs"
+        archive.mkdir()
+        env = os.environ.copy()
+        env["CODEX_BAZEL_EXECUTION_LOG_COMPACT_DIR"] = str(archive)
+        argv = ["bash", "./.github/scripts/run-bazel-ci.sh", "--print-failed-action-summary",
+                "--print-failed-test-logs", "--windows-msvc-host-platform", "--remote-download-toplevel", "--", "test",
+                "--platforms=//:windows_x86_64_msvc", "--skip_incompatible_explicit_targets",
+                "--test_tag_filters=-argument-comment-lint", "--test_verbose_timeout_warnings", "--test_output=all",
+                f"--build_metadata=COMMIT_SHA={os.environ['GITHUB_SHA']}", "--build_metadata=TAG_b11_observation_only=true",
+                "--build_metadata=TAG_b11_read_acl_readiness=true", "--nocache_test_results", "--flaky_test_attempts=1", "--", TARGET]
+        control.save(evidence, "command.json", {"argv": argv, "cwd": str(root), "source": entry,
+                     "event_github_sha": os.environ["GITHUB_SHA"], "scope": "Original unfiltered setup-bin target; no test_arg, test_filter, retry or timeout increase."})
+        started = time.monotonic()
+        with (evidence / "console.log").open("wb") as output:
+            report["command_launch_attempted"] = True
+            result = subprocess.run(argv, cwd=root, env=env, stdout=output, stderr=subprocess.STDOUT, check=False)
+        exit_code = result.returncode
+        report["command_completed"] = True
+        control.save(evidence, "command-terminal.json", {"exit_code": exit_code, "elapsed_seconds": time.monotonic() - started,
+                     "console": control.digest((evidence / "console.log").read_bytes())})
+        after = guard(control, root, head)
+        control.save(evidence, "source-after.json", after)
+        control.require(after == entry, "helper execution changed source/index/locks")
+        control.require(exit_code == 0, "original setup-bin target did not pass")
+        console = control.ANSI.sub("", (evidence / "console.log").read_text(encoding="utf-8")).replace("\r", "")
+        terminals = [line.strip() for line in console.splitlines() if line.startswith(TARGET + " ")]
+        control.require(len(terminals) == 1 and re.fullmatch(re.escape(TARGET) + r"\s+PASSED in [0-9.]+s", terminals[0]) is not None,
+                        "helper target was missing, cached, flaky, skipped or ambiguous")
+        selected, retained = helper_artifacts(control, archive, entry["source"])
+        results = helper_results(control, selected[".log"], selected[".xml"])
+        report.update(status="HELPER_TARGET_PASSED", helper_case_execution_verified=True, helper_qualified=True, target_terminal=terminals[0],
+                      artifacts=retained, results=results)
+    except Exception as exc:
+        error = repr(exc)
+    finally:
+        if entry is not None:
+            try:
+                final = guard(control, root, head)
+                control.save(evidence, "source-final.json", final)
+                control.require(final == entry, "final source/index/locks differ from the helper entry")
+            except Exception as exc:
+                final_error = repr(exc)
+        if error is not None or final_error is not None:
+            report.update(status="FAILED_OR_INCOMPLETE", helper_qualified=False)
+        report.update(command_exit_code=exit_code, error=error, final_guard_error=final_error,
+                      hard_cancellation_has_no_terminal_qualification=True)
+        control.save(evidence, "terminal.json", report)
+    print(json.dumps(report, indent=2))
+    return exit_code if exit_code not in (None, 0) else (0 if report["helper_qualified"] else 1)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
