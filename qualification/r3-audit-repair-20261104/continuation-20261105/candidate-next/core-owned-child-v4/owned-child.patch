+            // first register these spans without this test's scoped subscriber.
+            // Keep the original case in the parallel roster, but run its body
+            // in an owned process with the same test binary and exact selector.
+            struct OwnedChild(Option<std::process::Child>);
+
+            impl Drop for OwnedChild {
+                fn drop(&mut self) {
+                    if let Some(mut child) = self.0.take() {
+                        let _ = child.kill();
+                        let _ = child.wait();
+                    }
+                }
