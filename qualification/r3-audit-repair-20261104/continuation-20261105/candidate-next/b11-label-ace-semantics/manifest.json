  "primary_interpretation": [
    {
      "source_blob": "f06e267f0a3f4ef401a097b9763c3523970d8768",
      "finding": "SDDL separates sacl_flags from each parenthesized ACE; the SACL uses the same P/AR/AI control-token scheme as the DACL. Thus the observed S:AI prefix is not an ACE flags or policy-mask change."
    },
    {
      "source_blob": "c161d8f0883f4476275dda10a40f0fcbd2071078",
      "finding": "Mandatory label ACE consists of Header, Mask and the variable-length SID beginning at SidStart. Header includes type, size and inheritance flags; policy mask and mandatory authority/RID are retained exactly."
    },
    {
      "source_blob": "1be1075e1877be8755cedf2ab9c2c71c0118adda",
      "finding": "Only successful present SACL with non-NULL ACL pointer is accepted; absent and NULL differ and both fail this fixture."
    },
    {
      "source_blob": "cbc0ddcae5738811a90c54a2e92e9ce322a04325",
      "finding": "GetAce index zero returns the first ACE pointer; candidate additionally validates the returned extent within ACL bounds before dereferencing label/SID fields."
    },
    {
      "source_blob": "05ad6495db83be5e439ca3ef1df05e4ff7929b78",
      "finding": "IsValidAcl checks revision and that ACE count fits AclSize. Candidate separately validates label type, payload extent, authority and SID validity."
    },
    {
      "source_blob": "f31ccbe9d866950670513600dec7162d29af9369",
      "finding": "GetSecurityDescriptorControl supplies control and revision; both are compared on restoration, including bits not serialized by SDDL."
    }
  ],
