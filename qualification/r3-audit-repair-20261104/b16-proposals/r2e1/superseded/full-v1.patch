+async fn install_commit_guard<F>(
+    connection: &mut sqlx::SqliteConnection,
+    commit_allowed: Arc<F>,
+) -> Result<(), Error>
+where
+    F: Fn() -> bool + Send + Sync + 'static,
+{
+    connection
+        .lock_handle()
+        .await?
+        .set_commit_hook(move || commit_allowed());
+    Ok(())
+}
