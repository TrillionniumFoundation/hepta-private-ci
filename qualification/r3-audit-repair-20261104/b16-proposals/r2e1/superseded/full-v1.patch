+#[tokio::test]
+async fn recovered_pool_vetoes_commits_and_retains_its_exclusive_open_guard() {
+    let temp = tempfile::TempDir::new().unwrap();
+    let owner = crate::cognitive_test_support::agent_id(OWNER);
+    let layout = crate::cognitive_test_support::layout(&temp, &owner);
+    let initial = crate::CognitiveStore::open(&layout).await.unwrap();
+    let cut = initial.recovery_anchor().await.unwrap();
+    initial.close().await;
+    let verifier = Arc::new(TestVerifier::new());
+    let store = crate::CognitiveStore::open_with_recovery(
+        &layout,
+        crate::CognitiveRecoveryRequirement::ExactCurrentCut(&cut),
+        &authority(&owner, 87),
+        verifier.as_ref(),
+    )
+    .await
+    .unwrap();
+    let writer = ProductionDurableWriter::open_with_live_verifier(
+        store.clone(),
+        authority(&owner, 87),
+        verifier.clone(),
+        LEASE,
+        1,
+    )
+    .await
+    .unwrap();
+    let checkpoint = TestCheckpoint::new(verifier);
+    let before = store.recovery_anchor().await.unwrap();
+    *checkpoint.mode.lock().unwrap() = CheckpointMode::Refuse;
+    assert!(matches!(
+        writer
+            .checkpoint_current(&checkpoint, Duration::from_secs(2))
+            .await,
+        Err(ObjectiveSenderError::AcknowledgementUnknown)
+    ));
+    require_commit_veto(
+        sqlx::query("CREATE TABLE checkpoint_recovered_probe (value INTEGER)")
+            .execute(&store.pool)
+            .await,
+    );
+    assert_eq!(store.recovery_anchor().await.unwrap(), before);
+    assert!(crate::CognitiveStore::open(&layout).await.is_err());
+    assert!(
+        crate::CognitiveStore::open_with_recovery(
+            &layout,
+            crate::CognitiveRecoveryRequirement::ExactCurrentCut(&before),
+            &authority(&owner, 87),
+            &TestVerifier::new(),
+        )
+        .await
+        .is_err()
+    );
