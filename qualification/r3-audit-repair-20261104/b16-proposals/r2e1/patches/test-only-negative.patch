+#[tokio::test]
+async fn cancelled_checkpoint_vetoes_a_preexisting_connection_waiting_for_sqlite() {
+    let fixture = Fixture::new().await;
+    let before = fixture.store.recovery_anchor().await.unwrap();
+    let mut connection = fixture.store.pool.acquire().await.unwrap();
+    *fixture.checkpoint.mode.lock().unwrap() = CheckpointMode::Hold;
+    let mut checkpoint = Box::pin(
+        fixture
+            .writer
+            .checkpoint_current(fixture.checkpoint.as_ref(), Duration::from_secs(2)),
+    );
+    tokio::time::timeout(Duration::from_secs(2), async {
+        tokio::select! {
+            result = &mut checkpoint => panic!("checkpoint completed before hold: {result:?}"),
+            () = fixture.checkpoint.entered.notified() => {}
+        }
+    })
+    .await
+    .unwrap();
+
+    // This physical connection predates the checkpoint. Its BEGIN is actually
+    // polled while the original checkpoint holds SQLite's writer lock.
+    let mut waiting = Box::pin(sqlx::query("BEGIN IMMEDIATE").execute(&mut *connection));
+    assert!(
+        tokio::time::timeout(Duration::from_millis(20), &mut waiting)
+            .await
+            .is_err()
+    );
+    drop(checkpoint);
+    tokio::time::timeout(Duration::from_secs(2), waiting)
+        .await
+        .unwrap()
+        .unwrap();
+    sqlx::query("CREATE TABLE checkpoint_interlock_probe (value INTEGER)")
+        .execute(&mut *connection)
+        .await
+        .unwrap();
+    require_commit_veto(sqlx::query("COMMIT").execute(&mut *connection).await);
+    let tables: i64 = sqlx::query_scalar(
+        "SELECT count(*) FROM sqlite_schema WHERE name = 'checkpoint_interlock_probe'",
+    )
+    .fetch_one(&mut *connection)
+    .await
+    .unwrap();
+    assert_eq!(tables, 0);
+    drop(connection);
+    assert_eq!(fixture.store.recovery_anchor().await.unwrap(), before);
+    assert!(
+        fixture
+            .writer
+            .admit("interlock-after-cancellation", "test", "{}")
+            .await
+            .is_err()
+    );
+    assert_eq!(fixture.store.recovery_anchor().await.unwrap(), before);
+}
