+#[tokio::test]
+async fn refused_checkpoint_vetoes_growth_replacement_and_writes_after_read_ack() {
+    let fixture = Fixture::new().await;
+    let before = fixture.store.recovery_anchor().await.unwrap();
+    *fixture.checkpoint.mode.lock().unwrap() = CheckpointMode::Refuse;
+    assert!(matches!(
+        fixture
+            .writer
+            .checkpoint_current(fixture.checkpoint.as_ref(), Duration::from_secs(2))
+            .await,
+        Err(ObjectiveSenderError::AcknowledgementUnknown)
+    ));
+
+    let mut connections = Vec::new();
+    for _ in 0..5 {
+        connections.push(fixture.store.pool.acquire().await.unwrap());
+    }
+    for mut connection in connections {
+        require_commit_veto(
+            sqlx::query("CREATE TABLE checkpoint_growth_probe (value INTEGER)")
+                .execute(&mut *connection)
+                .await,
+        );
+        connection.close().await.unwrap();
+    }
+    let clone = fixture.store.clone();
+    require_commit_veto(
+        sqlx::query("CREATE TABLE checkpoint_replacement_probe (value INTEGER)")
+            .execute(&clone.pool)
+            .await,
+    );
+    assert_eq!(clone.recovery_anchor().await.unwrap(), before);
+
+    // A successful independent read ACK remains available but cannot reopen
+    // this pool's monotonic interlock.
+    *fixture.checkpoint.mode.lock().unwrap() = CheckpointMode::Accept;
+    assert_eq!(
+        fixture
+            .writer
+            .checkpoint_current(fixture.checkpoint.as_ref(), Duration::from_secs(2))
+            .await
+            .unwrap(),
+        before
+    );
+    require_commit_veto(
+        sqlx::query("CREATE TABLE checkpoint_after_read_ack_probe (value INTEGER)")
+            .execute(&clone.pool)
+            .await,
+    );
+    assert_eq!(clone.recovery_anchor().await.unwrap(), before);
+}
