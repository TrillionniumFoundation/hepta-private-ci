+use super::test_support::*;
+use super::*;
+use pretty_assertions::assert_eq;
+
+fn require_commit_veto(result: Result<sqlx::sqlite::SqliteQueryResult, sqlx::Error>) {
+    let code = result
+        .as_ref()
+        .err()
+        .and_then(|error| error.as_database_error())
+        .and_then(|error| error.code())
+        .map(|code| code.into_owned());
+    eprintln!(
+        "commit_interlock: commit_succeeded={} sqlite_code={code:?}",
+        result.is_ok()
+    );
+    assert_eq!(code.as_deref(), Some("531"));
+}
+
+#[tokio::test]
+async fn cancelled_checkpoint_vetoes_a_preexisting_read_transaction() {
+    let fixture = Fixture::new().await;
+    let before = fixture.store.recovery_anchor().await.unwrap();
+    let mut connection = fixture.store.pool.acquire().await.unwrap();
+    sqlx::query("BEGIN")
+        .execute(&mut *connection)
+        .await
+        .unwrap();
+    let metadata_rows: i64 = sqlx::query_scalar("SELECT count(*) FROM cognitive_meta")
+        .fetch_one(&mut *connection)
+        .await
+        .unwrap();
+    assert_eq!(metadata_rows, 1);
+    *fixture.checkpoint.mode.lock().unwrap() = CheckpointMode::Hold;
+    let mut checkpoint = Box::pin(
+        fixture
+            .writer
+            .checkpoint_current(fixture.checkpoint.as_ref(), Duration::from_secs(2)),
+    );
+    tokio::time::timeout(Duration::from_secs(2), async {
+        tokio::select! {
+            result = &mut checkpoint => panic!("checkpoint completed before hold: {result:?}"),
+            () = fixture.checkpoint.entered.notified() => {}
+        }
+    })
+    .await
+    .unwrap();
+    drop(checkpoint);
+    // Await a real writer-lock handoff; dropping the future only queues SQLx's
+    // rollback. This transaction writes nothing and cannot change the snapshot.
+    let released = fixture
+        .store
+        .pool
+        .begin_with("BEGIN IMMEDIATE")
+        .await
+        .unwrap();
+    released.rollback().await.unwrap();
+
+    // This real read transaction predates the checkpoint. SQLite permits only
+    // one writer, so it upgrades after the cancelled owner releases its lock.
+    sqlx::query("CREATE TABLE checkpoint_held_transaction_probe (value INTEGER)")
+        .execute(&mut *connection)
+        .await
+        .unwrap();
+    require_commit_veto(sqlx::query("COMMIT").execute(&mut *connection).await);
+    drop(connection);
+    assert_eq!(fixture.store.recovery_anchor().await.unwrap(), before);
+}
