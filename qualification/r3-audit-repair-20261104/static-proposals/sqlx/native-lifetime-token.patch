+use futures_util::task::noop_waker;
+use libsqlite3_sys::{
+    sqlite3, sqlite3_api_routines, sqlite3_auto_extension, sqlite3_cancel_auto_extension, sqlite3_close,
+    sqlite3_finalize, sqlite3_prepare_v2, sqlite3_progress_handler, sqlite3_step,
+    SQLITE_BUSY, SQLITE_OK, SQLITE_ROW,
+};
+use sqlx_core::connection::{ConnectOptions, Connection};
+use sqlx_core::executor::Executor;
