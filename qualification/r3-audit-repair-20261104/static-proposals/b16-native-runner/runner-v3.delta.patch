+class JunitTerminalTests(unittest.TestCase):
+    def test_actual_timeout_and_leak_types_cannot_satisfy_assertion_failure(self):
+        actual = ET.parse(HERE / "observed-nextest-timeout-testcase.xml").getroot()
+        self.assertFalse(any("TIMEOUT" in (child.text or "") for child in actual))
+        observed = junit_terminal(actual)
+        self.assertEqual(observed["result"], "FAIL")
+        self.assertEqual(observed["terminal_elements"][0]["attributes"], {"type": "test timeout"})
+        self.assertFalse(observed["terminal_status_accepted"])
+        for terminal_type in (None, "test failure with exit code 101 (leaked handles)",
+                              "test timeout", "test failure with exit code 1", "unknown failure type"):
+            case = ET.fromstring('<testcase><failure/><system-err>physical markers and panic may be present</system-err></testcase>')
+            if terminal_type is not None:
+                case.find("failure").set("type", terminal_type)
+            with self.subTest(terminal_type=terminal_type):
+                self.assertFalse(junit_terminal(case)["terminal_status_accepted"])
+        ordinary = ET.fromstring('<testcase><failure type="test failure with exit code 101" message="assertion failed"/></testcase>')
+        self.assertIsNone(ordinary.find("failure").text)
+        self.assertTrue(junit_terminal(ordinary)["terminal_status_accepted"])
+        self.assertEqual(junit_terminal(ordinary)["terminal_elements"][0]["attributes"]["message"], "assertion failed")
+        del ordinary.find("failure").attrib["message"]
+        self.assertTrue(junit_terminal(ordinary)["terminal_status_accepted"])
+        ET.SubElement(ordinary, "error", {"type": "test passed but leaked handles"})
+        self.assertFalse(junit_terminal(ordinary)["terminal_status_accepted"])
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=2)
