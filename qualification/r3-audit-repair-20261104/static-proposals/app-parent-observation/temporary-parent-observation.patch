+// Temporary observation of this invocation's own process; removed after diagnosis.
+fn record_parent_lifecycle_probe(phase: &str) {
+    let mut parent_death_signal: libc::c_int = 0;
+    // SAFETY: the output pointer addresses a live c_int; this operation only reads state.
+    let result = unsafe {
+        libc::prctl(libc::PR_GET_PDEATHSIG, &mut parent_death_signal as *mut libc::c_int, 0, 0, 0)
+    };
+    let error = (result < 0).then(std::io::Error::last_os_error);
+    // SAFETY: these calls only read the current process's own identifiers.
+    let (pid, ppid, pgid, sid) = unsafe {
+        (libc::getpid(), libc::getppid(), libc::getpgrp(), libc::getsid(0))
+    };
+    eprintln!(
+        "hepta_owned_lifecycle_probe phase={phase} pid={pid} ppid={ppid} pgid={pgid} sid={sid} pdeath_rc={result} pdeath_signal={parent_death_signal} error={error:?}"
+    );
+}
