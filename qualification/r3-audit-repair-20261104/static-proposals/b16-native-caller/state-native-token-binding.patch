@@ -0,0 +1,308 @@
+use super::SqliteConfig;
+use pretty_assertions::assert_eq;
+use crate::runtime::test_support::create_private_test_directory;
+use codex_utils_absolute_path::test_support::PathExt;
+use std::ffi::{c_char, c_int, c_void};
+use std::fs::{self, File, OpenOptions, TryLockError};
+use std::io::{BufRead, BufReader, Write};
+use std::path::{Path, PathBuf};
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::atomic::{AtomicBool, AtomicI32, AtomicUsize, Ordering};
+use std::sync::{mpsc, Arc, Mutex, OnceLock};
+use std::thread::{self, JoinHandle};
+use std::time::{Duration, Instant};
+use libsqlite3_sys::{
+    sqlite3, sqlite3_api_routines, sqlite3_auto_extension, sqlite3_cancel_auto_extension,
+    sqlite3_progress_handler, SQLITE_OK,
+};
+
+const BOUND: Duration = Duration::from_secs(5);
+const CHILD: &str = "sqlite::native_custody_tests::owned_state_scenario";
+static SERIAL: AtomicUsize = AtomicUsize::new(0);
+
+#[derive(Debug)]
+enum LockState {
+    Held,
+    Released,
+}
+
+enum GateState { Blocked, Released }
+
+struct OwnedScenario {
+    child: Child,
+    input: Option<ChildStdin>,
+    lines: Option<mpsc::Receiver<String>>,
+    reader: Option<JoinHandle<()>>,
+    directory: PathBuf,
+    reaped: bool,
+}
+
+impl OwnedScenario {
+    fn start(scenario: &str) -> Self {
+        let directory = std::env::temp_dir().join(format!(
+            "codex-state-native-custody-{}-{}",
+            std::process::id(),
+            SERIAL.fetch_add(1, Ordering::Relaxed)
+        ));
+        create_private_test_directory(&directory).unwrap();
+        let mut child = Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", CHILD, "--ignored", "--nocapture", "--test-threads=1"])
+            .env("CODEX_STATE_NATIVE_CUSTODY_SCENARIO", scenario)
+            .env("CODEX_STATE_NATIVE_CUSTODY_DIRECTORY", &directory)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .unwrap();
+        let input = child.stdin.take();
+        let output = child.stdout.take().unwrap();
+        let (sender, lines) = mpsc::sync_channel(64);
+        let mut owned = Self {
+            child, input, lines: Some(lines), reader: None, directory, reaped: false,
+        };
+        owned.reader = Some(thread::spawn(move || {
+            for line in BufReader::new(output).lines() {
+                match line {
+                    Ok(line) => { if sender.send(line).is_err() { break; } }
+                    Err(_) => break,
+                }
+            }
+        }));
+        owned
+    }
+
+    fn marker(&self) -> String {
+        let deadline = Instant::now() + BOUND;
+        loop {
+            let line = self.lines.as_ref().unwrap()
+                .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+                .expect("owned scenario did not reach its physical checkpoint");
+            if let Some(stage) = line.strip_prefix("LIFETIME: ") {
+                eprintln!("owned lifetime checkpoint={stage}");
+                return stage.to_owned();
+            }
+        }
+    }
+
+    fn send(&mut self, command: &[u8]) {
+        self.input.as_mut().unwrap().write_all(command).unwrap();
+        self.input.as_mut().unwrap().flush().unwrap();
+    }
+
+    fn checkpoint(&mut self, expected: &str, lock: LockState, gate: GateState) {
+        assert_eq!(self.marker(), expected);
+        let actual = self.probe_lock();
+        eprintln!("physical custody expected={lock:?} result={actual:?}");
+        self.send(b"inspect\n");
+        let expected_gate = match gate {
+            GateState::Blocked => "gate_status=0",
+            GateState::Released => "gate_status=1",
+        };
+        // Check after the physical probe so a timed-out callback cannot count
+        // as the intended early-release counterfactual.
+        assert_eq!(self.marker(), expected_gate, "native gate is not in the required state");
+        match (lock, actual) {
+            (LockState::Held, Err(TryLockError::WouldBlock))
+            | (LockState::Released, Ok(())) => {}
+            (_, actual) => panic!("unexpected physical lock result: {actual:?}"),
+        }
+        self.send(b"go\n");
+    }
+
+    fn probe_lock(&self) -> Result<(), TryLockError> {
+        let contender = OpenOptions::new().read(true).write(true)
+            .open(self.directory.join("custody.lock")).unwrap();
+        contender.try_lock()
+    }
+
+    fn finish(&mut self) {
+        let deadline = Instant::now() + BOUND;
+        loop {
+            if let Some(status) = self.child.try_wait().unwrap() {
+                self.reaped = true;
+                assert!(status.success(), "owned scenario failed: {status}");
+                assert!(self.probe_lock().is_ok(), "custody survived owned process exit");
+                return;
+            }
+            assert!(Instant::now() < deadline, "owned scenario did not exit");
+            thread::sleep(Duration::from_millis(10));
+        }
+    }
+}
+
+impl Drop for OwnedScenario {
+    fn drop(&mut self) {
+        drop(self.input.take());
+        drop(self.lines.take());
+        if !self.reaped {
+            let _ = self.child.kill();
+            let _ = self.child.wait();
+        }
+        if let Some(reader) = self.reader.take() {
+            let _ = reader.join();
+        }
+        let _ = fs::remove_dir_all(&self.directory);
+    }
+}
+
+#[test]
+fn guarded_pool_retains_custody_when_native_open_is_cancelled() {
+    let mut child = OwnedScenario::start("guarded-open");
+    child.checkpoint("cancelled_guarded_native_open", LockState::Held, GateState::Blocked);
+    child.checkpoint("native_closed", LockState::Released, GateState::Released);
+    child.finish();
+}
+
+#[test]
+fn coordinated_pool_retains_custody_when_initial_pragma_is_cancelled() {
+    let mut child = OwnedScenario::start("coordinated-pragma");
+    child.checkpoint("cancelled_coordinated_initial_pragma", LockState::Held, GateState::Blocked);
+    child.checkpoint("native_closed", LockState::Released, GateState::Released);
+    child.finish();
+}
+
+// Only the two parents explicitly invoke this ordinary libtest child.
+#[test]
+#[ignore]
+fn owned_state_scenario() {
+    let scenario = std::env::var("CODEX_STATE_NATIVE_CUSTODY_SCENARIO").unwrap();
+    let directory = PathBuf::from(std::env::var_os("CODEX_STATE_NATIVE_CUSTODY_DIRECTORY").unwrap());
+    cancelled_state_open(&directory, &scenario);
+}
+
+struct ResourceOwner {
+    file: Option<File>,
+    released: mpsc::Sender<()>,
+    allowed: AtomicBool,
+}
+
+impl Drop for ResourceOwner {
+    fn drop(&mut self) {
+        drop(self.file.take());
+        let _ = self.released.send(());
+    }
+}
+
+fn commit_guard(directory: &Path) -> (impl Fn() -> bool + Send + Sync + 'static, mpsc::Receiver<()>) {
+    let file = OpenOptions::new().read(true).write(true).create_new(true)
+        .open(directory.join("custody.lock")).unwrap();
+    file.lock().unwrap();
+    let (released, receiver) = mpsc::channel();
+    let owner = Arc::new(ResourceOwner {
+        file: Some(file), released, allowed: AtomicBool::new(false),
+    });
+    (move || owner.allowed.load(Ordering::SeqCst), receiver)
+}
+
+fn checkpoint(stage: &str) {
+    println!("\nLIFETIME: {stage}");
+    std::io::stdout().flush().unwrap();
+    let mut line = String::new();
+    std::io::stdin().read_line(&mut line).unwrap();
+    assert_eq!(line, "inspect\n");
+    let status = NATIVE_GATE.get().map(|gate| gate.outcome.load(Ordering::Acquire)).unwrap_or(-1);
+    println!("LIFETIME: gate_status={status}");
+    std::io::stdout().flush().unwrap();
+    line.clear();
+    std::io::stdin().read_line(&mut line).unwrap();
+    assert_eq!(line, "go\n");
+}
+
+enum GatePoint {
+    Open,
+    Pragma,
+}
+
+struct NativeGate {
+    point: GatePoint,
+    entered: tokio::sync::mpsc::Sender<()>,
+    release: Mutex<mpsc::Receiver<()>>,
+    first_progress: AtomicBool,
+    outcome: AtomicI32,
+}
+
+static NATIVE_GATE: OnceLock<NativeGate> = OnceLock::new();
+
+fn wait_at_native_gate() -> c_int {
+    let Some(gate) = NATIVE_GATE.get() else { return 1 };
+    if gate.entered.try_send(()).is_err() { return 1; }
+    let released = match gate.release.lock() {
+        Ok(receiver) => receiver.recv_timeout(BOUND).is_ok(),
+        Err(_) => false,
+    };
+    gate.outcome.store(if released { 1 } else { 2 }, Ordering::Release);
+    if released { 0 } else { 1 }
+}
+
+unsafe extern "C" fn progress(_: *mut c_void) -> c_int {
+    let Some(gate) = NATIVE_GATE.get() else { return 1 };
+    if gate.first_progress.swap(false, Ordering::AcqRel) {
+        wait_at_native_gate()
+    } else {
+        0
+    }
+}
+
+unsafe extern "C" fn opened(
+    database: *mut sqlite3,
+    _: *mut *mut c_char,
+    _: *const sqlite3_api_routines,
+) -> c_int {
+    match NATIVE_GATE.get().map(|gate| &gate.point) {
+        Some(GatePoint::Open) => wait_at_native_gate(),
+        Some(GatePoint::Pragma) => {
+            unsafe { sqlite3_progress_handler(database, 1, Some(progress), std::ptr::null_mut()); }
+            SQLITE_OK
+        }
+        None => 1,
+    }
+}
+
+fn cancelled_state_open(directory: &Path, scenario: &str) {
+    let (entered, mut receiver) = tokio::sync::mpsc::channel(1);
+    let (release, release_receiver) = mpsc::channel();
+    let point = match scenario {
+        "guarded-open" => GatePoint::Open,
+        "coordinated-pragma" => GatePoint::Pragma,
+        _ => panic!("unknown owned state scenario"),
+    };
+    assert!(NATIVE_GATE.set(NativeGate {
+        point, entered, release: Mutex::new(release_receiver),
+        first_progress: AtomicBool::new(true), outcome: AtomicI32::new(0),
+    }).is_ok());
+    assert_eq!(unsafe { sqlite3_auto_extension(Some(opened)) }, SQLITE_OK);
+    let sqlite = SqliteConfig::new_for_testing(directory.abs());
+    let path = directory.join("evidence.sqlite");
+    let (commit_allowed, closed) = commit_guard(directory);
+    let mut opening = Box::pin(async move {
+        match scenario {
+            "guarded-open" => sqlite
+                .open_commit_guarded_durable_evidence_pool(&path, commit_allowed)
+                .await,
+            "coordinated-pragma" => sqlite
+                .open_coordinated_durable_evidence_pool(&path, commit_allowed, || async {
+                    panic!("checkout cannot run before a cancelled initial PRAGMA completes");
+                })
+                .await,
+            _ => unreachable!("scenario was checked before opening"),
+        }
+    });
+    tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap().block_on(async {
+        tokio::time::timeout(BOUND, async {
+            tokio::select! {
+                result = opening.as_mut() => panic!("state open completed before native gate: {result:?}"),
+                entered = receiver.recv() => assert_eq!(entered, Some(()), "native gate disconnected"),
+            }
+        }).await.expect("real SQLite callback did not enter");
+    });
+    drop(opening);
+    checkpoint(if scenario == "guarded-open" {
+        "cancelled_guarded_native_open"
+    } else {
+        "cancelled_coordinated_initial_pragma"
+    });
+    release.send(()).unwrap();
+    closed.recv_timeout(BOUND).expect("actual resource owner did not release after native close");
+    assert_eq!(unsafe { sqlite3_cancel_auto_extension(Some(opened)) }, 1);
+    checkpoint("native_closed");
+}
