diff --git a/codex-rs/state/src/sqlite.rs b/codex-rs/state/src/sqlite.rs
--- a/codex-rs/state/src/sqlite.rs
+++ b/codex-rs/state/src/sqlite.rs
@@ -441,8 +441,17 @@
     /// The owner must hold its recovery fence and pass a newly materialized copy,
     /// never the suspect source. A single connection permits the journal-mode
     /// switch that a pool's other live handles would otherwise block.
-    pub async fn checkpoint_private_recovery_database(&self, path: &Path) -> Result<(), Error> {
-        let options = SqliteConnectOptions::new()
+    ///
+    /// `connection_custody` must own that actual recovery fence, including any
+    /// retained filesystem handles. Native SQLite work can outlive cancellation
+    /// of this future; a path or a separately created token is not custody.
+    pub async fn checkpoint_private_recovery_database(
+        &self,
+        path: &Path,
+        connection_custody: Arc<dyn Send + Sync + 'static>,
+    ) -> Result<(), Error> {
+        let options = SqliteConnectOptions::new()
+            .connection_lifetime_token(connection_custody)
             .filename(path)
             .create_if_missing(false)
             .synchronous(SqliteSynchronous::Full)
diff --git a/codex-rs/hepta-memory/src/cognitive_store_recovery.rs b/codex-rs/hepta-memory/src/cognitive_store_recovery.rs
--- a/codex-rs/hepta-memory/src/cognitive_store_recovery.rs
+++ b/codex-rs/hepta-memory/src/cognitive_store_recovery.rs
@@ -216,7 +216,10 @@
             pool.close().await;
 
             config
-                .checkpoint_private_recovery_database(&candidate)
+                .checkpoint_private_recovery_database(
+                    &candidate,
+                    exclusive_guard.custody.clone(),
+                )
                 .await
                 .map_err(|error| CognitiveRecoveryError::Unavailable(error.to_string()))?;
 
