{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hepta.ui-control.independent-security-review-receipt.v1",
  "title": "ui.control independent security and penetration-review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidateCommit",
    "candidateTree",
    "backendDeploymentDigest",
    "executedAt",
    "reviewer",
    "controls",
    "findings",
    "rawEvidenceDigest"
  ],
  "properties": {
    "schema": { "const": "hepta.ui-control.independent-security-review-receipt.v1" },
    "status": { "enum": ["passed", "failed"] },
    "candidateCommit": { "$ref": "#/$defs/sha1" },
    "candidateTree": { "$ref": "#/$defs/sha1" },
    "backendDeploymentDigest": { "$ref": "#/$defs/sha256" },
    "executedAt": { "type": "string", "format": "date-time" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "organization", "independentOfImplementationAuthor"],
      "properties": {
        "identity": { "type": "string", "minLength": 1, "maxLength": 256 },
        "organization": { "type": "string", "minLength": 1, "maxLength": 256 },
        "independentOfImplementationAuthor": { "const": true }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/control" }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openCritical", "openHigh", "openMedium", "openLow"],
      "properties": {
        "openCritical": { "type": "integer", "minimum": 0 },
        "openHigh": { "type": "integer", "minimum": 0 },
        "openMedium": { "type": "integer", "minimum": 0 },
        "openLow": { "type": "integer", "minimum": 0 }
      }
    },
    "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "rawEvidenceDigest"],
      "properties": {
        "id": {
          "enum": [
            "tls",
            "csp",
            "csrf",
            "cors",
            "cookie",
            "production-identity-provider",
            "session",
            "operation-ledger",
            "browser-token-non-persistence",
            "logging-redaction",
            "penetration-test"
          ]
        },
        "status": { "enum": ["passed", "failed"] },
        "notes": { "type": "string", "maxLength": 4096 },
        "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
