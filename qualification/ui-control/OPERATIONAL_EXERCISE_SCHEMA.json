{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hepta.ui-control.operational-exercise-receipt.v1",
  "title": "ui.control rollback, disaster-recovery, monitoring, redaction, and rotation exercise",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidateCommit",
    "candidateTree",
    "backendDeploymentDigest",
    "executedAt",
    "cases",
    "rawEvidenceDigest"
  ],
  "properties": {
    "schema": { "const": "hepta.ui-control.operational-exercise-receipt.v1" },
    "status": { "enum": ["passed", "failed"] },
    "candidateCommit": { "$ref": "#/$defs/sha1" },
    "candidateTree": { "$ref": "#/$defs/sha1" },
    "backendDeploymentDigest": { "$ref": "#/$defs/sha256" },
    "executedAt": { "type": "string", "format": "date-time" },
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "rawEvidenceDigest"],
        "properties": {
          "id": {
            "enum": [
              "rollback",
              "disaster-recovery",
              "alert-routing",
              "log-redaction",
              "credential-rotation"
            ]
          },
          "status": { "enum": ["passed", "failed"] },
          "notes": { "type": "string", "maxLength": 4096 },
          "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
