{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hepta.ui-control.operational-exercise-receipt.v1",
  "title": "ui.control semantic rollback, recovery, monitoring, redaction, rotation, and mixed-version exercise",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidateCommit",
    "candidateTree",
    "backendDeploymentDigest",
    "executedAt",
    "cases",
    "rawEvidenceDigest"
  ],
  "properties": {
    "schema": { "const": "hepta.ui-control.operational-exercise-receipt.v1" },
    "status": { "enum": ["passed", "failed"] },
    "candidateCommit": { "$ref": "#/$defs/sha1" },
    "candidateTree": { "$ref": "#/$defs/sha1" },
    "backendDeploymentDigest": { "$ref": "#/$defs/sha256" },
    "executedAt": { "type": "string", "format": "date-time" },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/rollback" },
          { "$ref": "#/$defs/disasterRecovery" },
          { "$ref": "#/$defs/alertRouting" },
          { "$ref": "#/$defs/logRedaction" },
          { "$ref": "#/$defs/credentialRotation" },
          { "$ref": "#/$defs/mixedVersionFence" }
        ]
      }
    },
    "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "notes": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "boundedSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
    "positiveBoundedSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "rollbackBuildManifestSha256",
        "restoredBrowserBuildManifestSha256",
        "mutationFenceObserved",
        "operationLedgerContinuity",
        "unresolvedOperations",
        "duplicateSideEffects",
        "rawEvidenceDigest"
      ],
      "properties": {
        "id": { "const": "rollback" },
        "status": { "enum": ["passed", "failed"] },
        "rollbackBuildManifestSha256": { "$ref": "#/$defs/sha256" },
        "restoredBrowserBuildManifestSha256": { "$ref": "#/$defs/sha256" },
        "mutationFenceObserved": { "type": "boolean" },
        "operationLedgerContinuity": { "type": "boolean" },
        "unresolvedOperations": { "type": "integer", "minimum": 0 },
        "duplicateSideEffects": { "type": "integer", "minimum": 0 },
        "notes": { "$ref": "#/$defs/notes" },
        "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "disasterRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "objectiveRpoSeconds",
        "observedRpoSeconds",
        "objectiveRtoSeconds",
        "observedRtoSeconds",
        "operationLedgerRestored",
        "auditLinkageRestored",
        "terminalLookupContinuity",
        "unresolvedOperations",
        "duplicateSideEffects",
        "rawEvidenceDigest"
      ],
      "properties": {
        "id": { "const": "disaster-recovery" },
        "status": { "enum": ["passed", "failed"] },
        "objectiveRpoSeconds": { "$ref": "#/$defs/positiveBoundedSeconds" },
        "observedRpoSeconds": { "$ref": "#/$defs/boundedSeconds" },
        "objectiveRtoSeconds": { "$ref": "#/$defs/positiveBoundedSeconds" },
        "observedRtoSeconds": { "$ref": "#/$defs/boundedSeconds" },
        "operationLedgerRestored": { "type": "boolean" },
        "auditLinkageRestored": { "type": "boolean" },
        "terminalLookupContinuity": { "type": "boolean" },
        "unresolvedOperations": { "type": "integer", "minimum": 0 },
        "duplicateSideEffects": { "type": "integer", "minimum": 0 },
        "notes": { "$ref": "#/$defs/notes" },
        "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "alertRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "alertRuleSha256",
        "routeConfigurationSha256",
        "objectiveAcknowledgementSeconds",
        "observedAcknowledgementSeconds",
        "alertTriggered",
        "routeMatched",
        "acknowledged",
        "escalationPolicyVerified",
        "rawEvidenceDigest"
      ],
      "properties": {
        "id": { "const": "alert-routing" },
        "status": { "enum": ["passed", "failed"] },
        "alertRuleSha256": { "$ref": "#/$defs/sha256" },
        "routeConfigurationSha256": { "$ref": "#/$defs/sha256" },
        "objectiveAcknowledgementSeconds": { "$ref": "#/$defs/positiveBoundedSeconds" },
        "observedAcknowledgementSeconds": { "$ref": "#/$defs/boundedSeconds" },
        "alertTriggered": { "type": "boolean" },
        "routeMatched": { "type": "boolean" },
        "acknowledged": { "type": "boolean" },
        "escalationPolicyVerified": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/notes" },
        "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "logRedaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "logCorpusSha256",
        "secretCanaryCount",
        "secretCanaryMatches",
        "correlationCanaryCount",
        "fullIdentifierMatches",
        "redactedCorrelationMatches",
        "credentialMatches",
        "rawEvidenceDigest"
      ],
      "properties": {
        "id": { "const": "log-redaction" },
        "status": { "enum": ["passed", "failed"] },
        "logCorpusSha256": { "$ref": "#/$defs/sha256" },
        "secretCanaryCount": { "type": "integer", "minimum": 1 },
        "secretCanaryMatches": { "type": "integer", "minimum": 0 },
        "correlationCanaryCount": { "type": "integer", "minimum": 1 },
        "fullIdentifierMatches": { "type": "integer", "minimum": 0 },
        "redactedCorrelationMatches": { "type": "integer", "minimum": 0 },
        "credentialMatches": { "type": "integer", "minimum": 0 },
        "notes": { "$ref": "#/$defs/notes" },
        "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "credentialRotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "oldCredentialFingerprintSha256",
        "newCredentialFingerprintSha256",
        "activeOldCredentials",
        "oldCredentialRejectedStatus",
        "oldCredentialOperationCreated",
        "newCredentialAuthenticated",
        "permissionRevisionAdvanced",
        "postRotationLookupSucceeded",
        "rawEvidenceDigest"
      ],
      "properties": {
        "id": { "const": "credential-rotation" },
        "status": { "enum": ["passed", "failed"] },
        "oldCredentialFingerprintSha256": { "$ref": "#/$defs/sha256" },
        "newCredentialFingerprintSha256": { "$ref": "#/$defs/sha256" },
        "activeOldCredentials": { "type": "integer", "minimum": 0 },
        "oldCredentialRejectedStatus": { "enum": [401, 403] },
        "oldCredentialOperationCreated": { "type": "boolean" },
        "newCredentialAuthenticated": { "type": "boolean" },
        "permissionRevisionAdvanced": { "type": "boolean" },
        "postRotationLookupSucceeded": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/notes" },
        "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "mixedVersionFence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "oldMutationSessionsRevoked",
        "cachedHtmlInvalidated",
        "activeLegacyMutationSessions",
        "staleClientMutationStatus",
        "staleClientOperationCreated",
        "freshClientBuildManifestSha256",
        "rawEvidenceDigest"
      ],
      "properties": {
        "id": { "const": "mixed-version-mutation-fence" },
        "status": { "enum": ["passed", "failed"] },
        "oldMutationSessionsRevoked": { "type": "boolean" },
        "cachedHtmlInvalidated": { "type": "boolean" },
        "activeLegacyMutationSessions": { "type": "integer", "minimum": 0 },
        "staleClientMutationStatus": { "enum": [401, 403] },
        "staleClientOperationCreated": { "type": "boolean" },
        "freshClientBuildManifestSha256": { "$ref": "#/$defs/sha256" },
        "notes": { "$ref": "#/$defs/notes" },
        "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
