{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hepta.ui-control.production-approval-receipt.v1",
  "title": "ui.control production deployment and release approval",
  "description": "Each authority records its own approval time after reviewing the exact prerequisite evidence set. The top-level approvedAt is the latest individual authority approval time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidateCommit",
    "candidateTree",
    "backendDeploymentDigest",
    "approvedAt",
    "expiresAt",
    "approvals",
    "evidenceDigests",
    "signature",
    "rawEvidenceDigest"
  ],
  "properties": {
    "schema": { "const": "hepta.ui-control.production-approval-receipt.v1" },
    "status": { "const": "approved" },
    "candidateCommit": { "$ref": "#/$defs/sha1" },
    "candidateTree": { "$ref": "#/$defs/sha1" },
    "backendDeploymentDigest": { "$ref": "#/$defs/sha256" },
    "approvedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the latest individual authority approval."
    },
    "expiresAt": { "type": "string", "format": "date-time" },
    "approvals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "identity", "approvedAt"],
        "properties": {
          "role": { "enum": ["deployment-authority", "release-authority", "security-authority"] },
          "identity": { "type": "string", "minLength": 1, "maxLength": 256 },
          "approvedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Time this authority approved the exact bound evidence set."
          }
        }
      }
    },
    "evidenceDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceHead",
        "mergeTree",
        "deploymentSecurity",
        "realBackend",
        "independentAcceptance",
        "independentSecurity",
        "operationalExercise"
      ],
      "properties": {
        "sourceHead": { "$ref": "#/$defs/sha256" },
        "mergeTree": { "$ref": "#/$defs/sha256" },
        "deploymentSecurity": { "$ref": "#/$defs/sha256" },
        "realBackend": { "$ref": "#/$defs/sha256" },
        "independentAcceptance": { "$ref": "#/$defs/sha256" },
        "independentSecurity": { "$ref": "#/$defs/sha256" },
        "operationalExercise": { "$ref": "#/$defs/sha256" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": { "const": "sigstore-bundle" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
