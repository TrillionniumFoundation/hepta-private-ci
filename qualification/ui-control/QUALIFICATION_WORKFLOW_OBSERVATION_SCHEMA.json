{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hepta.ui-control.qualification-workflow-observation.v1",
  "title": "ui.control exact-head qualification workflow observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "observedAt",
    "observer",
    "sourceRun",
    "jobInventory",
    "jobInventoryComplete",
    "artifactInventory",
    "artifactInventoryComplete",
    "expectedArtifacts",
    "evidenceAvailability",
    "observedOutcome",
    "acceptedEvidence",
    "failure",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "hepta.ui-control.qualification-workflow-observation.v1"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowSha",
        "runId",
        "runAttempt",
        "repository"
      ],
      "properties": {
        "workflowSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "runId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "runAttempt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "sourceRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "attempt",
        "workflowId",
        "workflowName",
        "headSha",
        "headBranch",
        "event",
        "status",
        "conclusion",
        "displayTitle",
        "htmlUrl"
      ],
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "attempt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "workflowId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "workflowName": {
          "const": "ui.control exact-head qualification"
        },
        "headSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "headBranch": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "event": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "conclusion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "displayTitle": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "htmlUrl": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      }
    },
    "jobInventory": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "conclusion",
          "startedAt",
          "completedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "conclusion": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          }
        }
      }
    },
    "jobInventoryComplete": {
      "type": "boolean"
    },
    "artifactInventory": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "sizeInBytes",
          "digest",
          "expired"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sizeInBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          },
          "digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "expired": {
            "type": "boolean"
          }
        }
      }
    },
    "artifactInventoryComplete": {
      "type": "boolean"
    },
    "expectedArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactHeadName",
        "syntheticMergeRequired"
      ],
      "properties": {
        "exactHeadName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "syntheticMergeRequired": {
          "type": "boolean"
        }
      }
    },
    "evidenceAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactHeadObservation",
        "syntheticMergeObservation"
      ],
      "properties": {
        "exactHeadObservation": {
          "type": "boolean"
        },
        "syntheticMergeObservation": {
          "type": "boolean"
        }
      }
    },
    "observedOutcome": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "acceptedEvidence": {
      "const": false
    },
    "failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage",
            "code",
            "message",
            "checks"
          ],
          "properties": {
            "stage": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "checks": {
              "type": "object",
              "maxProperties": 32
            }
          }
        }
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositorySourceQualified",
        "deterministicMergeQualified",
        "deployedSecurityObserved",
        "realBackendSemanticsQualified",
        "durableCrashRestartQualified",
        "independentAccessibilityAndOperatorAcceptanceSigned",
        "independentSecurityReviewPassed",
        "rollbackDisasterRecoveryMonitoringAndRedactionExercised",
        "productionDeploymentApproved",
        "releaseAuthorized"
      ],
      "properties": {
        "repositorySourceQualified": {
          "const": false
        },
        "deterministicMergeQualified": {
          "const": false
        },
        "deployedSecurityObserved": {
          "const": false
        },
        "realBackendSemanticsQualified": {
          "const": false
        },
        "durableCrashRestartQualified": {
          "const": false
        },
        "independentAccessibilityAndOperatorAcceptanceSigned": {
          "const": false
        },
        "independentSecurityReviewPassed": {
          "const": false
        },
        "rollbackDisasterRecoveryMonitoringAndRedactionExercised": {
          "const": false
        },
        "productionDeploymentApproved": {
          "const": false
        },
        "releaseAuthorized": {
          "const": false
        }
      }
    }
  }
}
