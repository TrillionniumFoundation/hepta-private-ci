{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hepta.ui-control.independent-acceptance-receipt.v1",
  "title": "ui.control independent acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidateCommit",
    "candidateTree",
    "assetManifestSha256",
    "backendDeploymentDigest",
    "browser",
    "os",
    "verifier",
    "executedAt",
    "cases",
    "rawEvidenceDigest"
  ],
  "properties": {
    "schema": {
      "const": "hepta.ui-control.independent-acceptance-receipt.v1"
    },
    "candidateCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidateTree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "assetManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "backendDeploymentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "enum": [
            "Chrome",
            "Firefox",
            "Safari"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "os": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "assistiveTechnology": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "organization",
        "independentOfImplementationAuthor"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "independentOfImplementationAuthor": {
          "const": true
        }
      }
    },
    "executedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "result": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "rawEvidenceDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
