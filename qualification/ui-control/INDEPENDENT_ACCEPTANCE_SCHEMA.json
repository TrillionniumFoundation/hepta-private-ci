{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hepta.ui-control.independent-acceptance-receipt.v2",
  "title": "ui.control independent browser, keyboard, and assistive-technology acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidateCommit",
    "candidateTree",
    "backendDeploymentDigest",
    "executedAt",
    "verifier",
    "observations",
    "rawEvidenceDigest"
  ],
  "properties": {
    "schema": { "const": "hepta.ui-control.independent-acceptance-receipt.v2" },
    "status": { "enum": ["passed", "failed"] },
    "candidateCommit": { "$ref": "#/$defs/sha1" },
    "candidateTree": { "$ref": "#/$defs/sha1" },
    "backendDeploymentDigest": { "$ref": "#/$defs/sha256" },
    "executedAt": { "type": "string", "format": "date-time" },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "organization", "independentOfImplementationAuthor"],
      "properties": {
        "identity": { "type": "string", "minLength": 1, "maxLength": 256 },
        "organization": { "type": "string", "minLength": 1, "maxLength": 256 },
        "independentOfImplementationAuthor": { "const": true }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/observation" }
    },
    "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "modality", "browser", "os", "result", "rawEvidenceDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "modality": { "enum": ["browser-operator", "keyboard-only", "screen-reader"] },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "enum": ["Chrome", "Firefox", "Safari"] },
            "version": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "os": { "type": "string", "minLength": 1, "maxLength": 128 },
        "assistiveTechnology": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "result": { "enum": ["pass", "fail"] },
        "notes": { "type": "string", "maxLength": 4096 },
        "rawEvidenceDigest": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "modality": { "const": "screen-reader" } } },
          "then": { "required": ["assistiveTechnology"] }
        }
      ]
    }
  }
}
