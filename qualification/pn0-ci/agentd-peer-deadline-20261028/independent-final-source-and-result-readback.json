  "semantic_review": [
    {
      "area": "Accepted existing stream peer gate",
      "result": "Existing ensure_current_user_peer runs immediately after accept, before any semaphore permit, overload write, task spawn or frame read. Err or already-expiredcontinue drops original stream naturally. Supported Unix uses original OS UID producer; Windows remains Unsupported and refuses, no PID/SID/boolean trust substitute."
    },
    {
      "area": "Single original accepted deadline",
      "result": "One std Instant deadline is captured after accept before peer check, exactly original2seconds. It feeds the existing execution context and both cleanup/admission wrappers; no fresh window after peer latency, queuing or task spawn.32capacity and frame constants unchanged."
    },
    {
      "area": "Both actual production callers",
      "result": "Overload computes min(original accepteddeadline,stdnow+original50ms) and wraps its write_all/shutdown future with per-poll guard and original outertimeout_at using that same deadline. Normal spawned branch retains execution.check before future construction and wraps original serve_connection future with per-poll guard and original outertimer. No timeout result issues authority."
    },
    {
      "area": "Every poll fence",
      "result": "Private async helper pins original F and awaits poll_fn. Each poll_fn callback first invokes clock, rejects clock>=same deadline as Ready(None) without polling F, otherwise polls F once and wraps original ready output in Some. A Tokio Timeout value-first poll after deadline therefore reaches the guard, not the expired inner F."
    },
    {
      "area": "Timer wakeup retained",
      "result": "Guard intentionally has no own timer. Both production consumers retain original timeout_at so a pending future with no I/O wakeup is still woken/cancelled at the existing deadline. External drop/timeout drops F and releases original permit/cancellation guard through original task scope."
    },
    {
      "area": "No clock or trust authority",
      "result": "Public helper always delegates to private clock helper with std Instant::now. Private injected clock is unit-test-only interface, not exported, serde or AuthorityClock provider. Existing peer/authorization/state/clock/CAS/provider paths are unchanged."
    }
  ],
  "meaningful_test_source_review": [
    {
      "name": "expired_ready_future_is_dropped_without_being_polled",
      "purpose": "Reject even an immediately-ready expired F before any innerpoll; assert0poll1drop."
    },
    {
      "name": "pending_future_is_not_polled_again_after_deadline_and_is_dropped",
      "purpose": "First allowed pending poll then deterministic clock reachesdeadline; no second innerpoll and drop1."
    },
    {
      "name": "early_completion_preserves_the_original_result",
