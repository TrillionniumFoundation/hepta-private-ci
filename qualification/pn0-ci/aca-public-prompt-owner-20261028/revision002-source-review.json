    {
      "id": "R02",
      "priority": "P1",
      "blocking": false,
      "kind": "STATIC_PUBLIC_CALLER_INTEGRATION_DEFECT",
      "title": "Canonical Windows Agentd roots are rejected before native owner capture",
      "candidate_source": {
        "path": "codex-rs/hepta-agentd/src/prompt_runtime_windows.rs",
        "lines": "34-45",
        "sha256": "03e0e5ad53ff45cc61ab799d754362431bf21f369b7888e692d68473824a93e3"
      },
      "actual_ACA_chain": [
        {
          "path": "codex-rs/hepta-agentd/src/test_support.rs",
          "lines": "83-85;108-109",
          "meaning": "start canonicalizes root, then obtains home/run from registered layout"
        },
        {
          "path": "codex-rs/hepta-agentd/src/config.rs",
          "lines": "159-161;595-616",
          "meaning": "ordinary config requires canonical exact home/run inputs"
        },
        {
          "path": "codex-rs/hepta-agentd/src/state.rs",
          "lines": "110-120",
          "meaning": "public ordinary factory receives those home/run child paths"
        },
        {
          "path": "codex-rs/utils/windows-private-state/src/parent_anchor.rs",
          "lines": "125-150",
          "sha256": "f5d9e518cd97d1847ed282abfe1863917a803126ead3651a5811c8047b9369f2",
          "meaning": "only Prefix::Disk admitted; Prefix::VerbatimDisk returns UnsafeObject before owner capture"
        }
      ],
      "impact": "Normal std::fs::canonicalize Windows disk roots use VerbatimDisk spelling, so new public pipeline still returns RegistryOpen/Unavailable before protected creation or marker recovery. This is static source reasoning, not an observed compiler/native failure.",
      "required_change": "Accept the equivalent local VerbatimDisk spelling at the existing ParentAnchor producer while preserving all root GUID/NTFS, bounded literal ancestor, no-reparse, no-delete-share, exact owner/ACL/principal and sticky refusal checks; retain canonical callers/tests. Add a real native alias regression source without altering old test bodies.",
      "status": "SOURCE_REPAIRED_AND_INDEPENDENTLY_REVIEWED_NOT_EXECUTED",
      "resolution": {
        "path": "codex-rs/utils/windows-private-state/src/parent_anchor.rs",
        "sha256": "790b4ac7105d585fa07793b584426cd919ac50a1f2e07170236aef91e49e0bf2",
        "change": "Only two documentation lines and Disk|VerbatimDisk prefix match added; all remaining producer bytes exactly preserved. Existing mechanism local_nt_path performs equivalent Disk skip0/VerbatimDisk skip4 conversion before actual native root capture. UNC/devices remain rejected.",
        "native_regression_source": "codex-rs/utils/windows-private-state/src/parent_anchor_tests.rs:180-213; NOT_RUN",
        "scope": "Resolves first static caller spelling mismatch; does not prove namespace or principal admission for any actual host or original failing tests."
      }
    },
    {
      "id": "C01",
      "priority": "P2",
      "blocking": false,
      "kind": "PUBLIC_API_AND_STRICT_LINT_COMPATIBILITY",
      "title": "Shared revalidation receiver changes a public signature and leaves an old fixture mut unused",
