+#[test]
+fn matrix_orphan_fault_uses_lease_release_budget_before_writing()
+-> Result<(), SupervisorError> {
+    let (fleet, control, mut supervisor, mut now) =
+        ready_paired_supervisor("matrix-lease-release")?;
+    control.set_matrix_exit(&fleet.first);
+    assert_eq!(supervisor.tick(now), TickReport::default());
+    now += Duration::from_secs(2);
+    assert_eq!(supervisor.tick(now), TickReport::default());
+    control.set_matrix_healthy(&fleet.first);
+    assert_eq!(supervisor.tick(now), TickReport::default());
+
+    let record = fleet.registry.load()?.agent(&fleet.first).cloned().expect("agent");
+    let journal = read_restart_journal(record.layout.run_root())?.expect("Matrix budget");
+    assert_eq!(journal.matrix.attempts, 1);
+    let claim = crate::restart_budget::claim_restart(
+        record.layout.run_root(),
+        config().restart_max_attempts,
+        config().restart_window,
+        config().restart_backoff_base,
+    )
+    .map_err(|error| SupervisorError::Invalid(error.to_string()))?;
+    let main_before = read_main_restart_budget(record.layout.run_root())?;
+    assert!(main_before.as_ref().expect("main budget").pending);
+
+    // Model a crash after exact target-process admission but before the
+    // registry's release revision. The live lease identifies the actual
+    // release; restoring against the stale registry value would erase its
+    // existing Matrix fault window.
+    let stale_release = ReleaseId::parse("matrix-stale-registry-release")?;
+    let source = fleet.write_release_source()?;
+    fleet.registry.install_release_bundle(
+        stale_release.clone(),
+        &source,
+        Vec::new(),
+        Some(&source),
+        Vec::new(),
+    )?;
+    fleet.registry.allow_release(&fleet.first, &stale_release)?;
+    fleet.registry.compare_and_set_release_state(
+        &fleet.first,
+        record.release_state.generation,
+        Some(stale_release),
+        record.release_state.previous.clone(),
+    )?;
+
+    // Leave the dead Matrix lease unobserved so recovery itself adds a fault.
+    control.set_matrix_exit(&fleet.first);
+    drop(supervisor);
+    let (recovered, report) =
+        Supervisor::recover(fleet.registry.clone(), control.driver(), config(), now)?;
+    assert_eq!(report, TickReport::default());
+    let snapshot = recovered.snapshot(&fleet.first).expect("recovered snapshot");
+    assert_eq!(snapshot.active_release.as_deref(), Some(journal.release_id.as_str()));
+    assert_eq!(snapshot.matrix.restart_attempt, 2);
+    assert_eq!(snapshot.restart_attempt, claim.attempt);
+    assert!(!snapshot.restart_pending, "the exact Agent was already adopted");
+    assert_eq!(read_main_restart_budget(record.layout.run_root())?, main_before);
+    assert_eq!(
+        read_restart_journal(record.layout.run_root())?,
+        Some(RestartBudgetJournal::new(
+            journal.agent_id,
+            journal.release_id,
+            DurableRestartWindow::empty(),
+            DurableRestartWindow {
+                attempts: 2,
+                window_started_unix_millis: journal.matrix.window_started_unix_millis,
+            },
+        )?)
+    );
+    assert_eq!(control.spawn_count(&fleet.first), 1);
+    assert_eq!(control.matrix_spawn_count(&fleet.first), 2);
+    Ok(())
+}
