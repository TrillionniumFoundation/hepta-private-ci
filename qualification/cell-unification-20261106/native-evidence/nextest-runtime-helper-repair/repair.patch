+        "--lib", "--bins", "--tests", "--examples", "--benches",
+        "--all-targets", "--no-fail-fast", "--fail-fast", "--no-run",
+        "--no-capture", "--nocapture", "--hide-progress-bar",
+        "--override-version-check", "--ignore-default-filter", "--verbose",
+        "-v", "--quiet", "-q",
+    }
