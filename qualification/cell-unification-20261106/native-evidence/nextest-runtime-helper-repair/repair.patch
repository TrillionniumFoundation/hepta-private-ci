+    expected = {}
+    for owner, name in sorted(required):
+        declared = [p for p in packages.values() if p["name"] == owner]
+        if len(declared) != 1:
+            raise RuntimeHelperError(f"runtime helper owner missing or ambiguous: {owner}")
+        package = declared[0]
