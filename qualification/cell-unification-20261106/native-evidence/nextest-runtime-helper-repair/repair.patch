+def helper_env_keys(name):
+    names = [name] if "-" not in name else [name, name.replace("-", "_")]
+    return [f"{prefix}_{variant}" for prefix in ("CARGO_BIN_EXE", "NEXTEST_BIN_EXE")
+            for variant in names]
