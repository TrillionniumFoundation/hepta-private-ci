    {
      "name": "host_blocked_requires_allowlist_match",
      "settings": "network_settings(&[\"example.com\"], &[])",
      "purpose": "Exact allowlist matching; initial example.com is allowed and public 8.8.8.8 is not in that allowlist. The separate enabled/broker/default-local loop stays unchanged.",
      "expected_r26_status": "PASS",
      "changed_setup": "Only the first state in this function. Its independent default-config loop still tests broker defaults and loopback denial.",
      "original_execution": {
        "status": "PASS",
        "seconds": 0.116,
        "line": "        PASS [   0.116s] codex-network-proxy runtime::tests::host_blocked_requires_allowlist_match"
      },
      "all_original_assertions_preserved": true,
      "original_function": "    async fn host_blocked_requires_allowlist_match() {\n        let state = network_proxy_state_for_policy(network_settings(&[\"example.com\"], &[]));\n\n        assert_eq!(\n            state\n                .host_blocked(\"example.com\", /*port*/ 80)\n                .await\n                .unwrap(),\n            HostBlockDecision::Allowed\n        );\n        assert_eq!(\n            // Use a public IP literal to avoid relying on ambient DNS behavior (some networks\n            // resolve unknown hostnames to private IPs, which would trigger `not_allowed_local`).\n            state.host_blocked(\"8.8.8.8\", /*port*/ 80).await.unwrap(),\n            HostBlockDecision::Blocked(HostBlockReason::NotAllowed)\n        );\n        for enabled in [false, true] {\n            let mut config = NetworkProxyConfig {\n                enabled,\n                ..NetworkProxyConfig::default()\n            };\n            config.set_credential_broker_enabled(/*enabled*/ true);\n            let config_state = build_config_state(config, NetworkProxyConstraints::default())\n                .expect(\"valid credential-broker configuration\");\n            assert_eq!(config_state.brokerage_created_default_allowlist, !enabled);\n            let state = NetworkProxyState::with_reloader(config_state, Arc::new(NoopReloader));\n\n            assert_eq!(\n                state.host_blocked(\"8.8.8.8\", /*port*/ 80).await.unwrap(),\n                if enabled {\n                    HostBlockDecision::Blocked(HostBlockReason::NotAllowed)\n                } else {\n                    HostBlockDecision::Allowed\n                }\n            );\n            assert_eq!(\n                state.host_blocked(\"127.0.0.1\", /*port*/ 80).await.unwrap(),\n                HostBlockDecision::Blocked(HostBlockReason::NotAllowedLocal)\n            );\n        }\n    }\n",
      "original_function_pin": {
        "bytes": 1813,
        "sha256": "caa9f85f9939699ef31a09a605d36384f2bd7ab42c71ffd0dfd340d20a344d2f",
        "git_blob": "64c67c830dadfb1d5303df00750d4ae06d294c8e"
      },
      "candidate_function_pin": {
        "bytes": 1997,
        "sha256": "1fefc47708d1081341916b6ffe780e352e9849bf9fce25efcf04060d37587637",
        "git_blob": "4459743de2ccdc6683729e019a91cb86b6133542"
      },
      "source_path": "codex-rs/network-proxy/src/runtime.rs",
      "original_first_line": 1221,
      "lookup_path_before": "network_settings -> default allow_local_binding=false -> test-local network_proxy_state_for_policy -> host_blocked -> explicit deny first -> DNS/local-address guard for nonliteral hosts -> allowlist",
      "candidate_boundary": "Only this fixture's first config sets the existing allow_local_binding=true. No new network request, resolver override, production setting or default is introduced."
    },
