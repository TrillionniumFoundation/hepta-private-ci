  "function": "OriginalCellQ24TrainingCommandOwnerV1::serve_original_training_readback",
  "function_source": "    pub async fn serve_original_training_readback(\n        self: Arc<Self>,\n        stream: UnixStream,\n        consumer: AgentdRootAuthorityPeer,\n        consumer_uid: u32,\n        original_consumer_pidfd: OwnedFd,\n        timeout: Duration,\n        lifetime: Duration,\n    ) -> Result<u64, Error> {\n        let permit = Arc::clone(&self.connections)\n            .try_acquire_owned()\n            .map_err(|_| Error::Busy)?;\n        let mut channel = original_owner_command_channel_v1(\n            stream,\n            consumer,\n            consumer_uid,\n            original_consumer_pidfd,\n            timeout,\n            lifetime,\n        )?;\n        tokio::task::spawn_blocking(move || {\n            let _permit = permit;\n            self.serve_original_training_readback_channel(&mut channel)\n        })\n        .await\n        .map_err(|_| Error::CommitUncertain)?\n    }\n\n",
  "actual_call": "original_owner_command_channel_v1(",
