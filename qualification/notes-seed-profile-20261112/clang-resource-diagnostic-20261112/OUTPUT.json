 in ALLOWED_HEADERS {"}, {"line": 122, "text": "        emit_warning(format!(\"Allowed header: {header}\").as_str());"}, {"line": 123, "text": "        builder = builder.allowlist_file(format!(\"{}{}\", r\".*(/|\\\\)openssl(/|\\\\)\", header));"}, {"line": 124, "text": "    }"}, {"line": 136, "text": "    }"}, {"line": 137, "text": "    builder"}, {"line": 138, "text": "}"}, {"line": 139, "text": ""}, {"line": 140, "text": "fn prepare_bindings_builder(manifest_dir: &Path, options: &BindingOptions) -> bindgen::Builder {"}, {"line": 141, "text": "    let clang_args = crate::prepare_clang_args(manifest_dir, options);"}, {"line": 142, "text": ""}, {"line": 143, "text": "    let mut builder = bindgen::Builder::default()"}, {"line": 144, "text": "        .derive_copy(true)"}, {"line": 145, "text": "        .derive_debug(true)"}, {"line": 146, "text": "        .derive_default(true)"}, {"line": 147, "text": "        .derive_eq(true)"}, {"line": 148, "text": "        .allowlist_file(r\".*(/|\\\\)rust_wrapper\\.h\")"}, {"line": 149, "text": "        .rustified_enum(r\"point_conversion_form_t\")"}, {"line": 150, "text": "        .rust_target(bindgen::RustTarget::stable(70, 0).unwrap())"}, {"line": 151, "text": "        .default_macro_constant_type(bindgen::MacroTypeVariation::Signed)"}, {"line": 154, "text": "        .size_t_is_usize(true)"}, {"line": 155, "text": "        .layout_tests(true)"}, {"line": 156, "text": "        .prepend_enum_name(true)"}, {"line": 157, "text": "        .formatter(bindgen::Formatter::Rustfmt)"}, {"line": 158, "text": "        .clang_args(clang_args)"}, {"line": 159, "text": "        .raw_line(COPYRIGHT)"}, {"line": 160, "text": "        .header("}, {"line": 161, "text": "            get_rust_include_path(manifest_dir)"}, {"line": 162, "text": "                .join(\"rust_wrapper.h\")"}, {"line": 163, "text": "                .display()"}, {"line": 164, "text": "                .to_string(),"}, {"line": 165, "text": "        );"}, {"line": 166, "text": ""}, {"line": 180, "text": ""}, {"line": 181, "text": "    builder"}, {"line": 182, "text": "}"}, {"line": 183, "text": ""}, {"line": 184, "text": "pub(crate) fn generate_bindings("}, {"line": 185, "text": "    manifest_dir: &Path,"}, {"line": 186, "text": "    options: &BindingOptions,"}, {"line": 187, "text": ") -> bindgen::Bindings {"}, {"line": 188, "text": "    let _guard_target = EnvGuard::new(\"TARGET\", effective_target());"}, {"line": 189, "text": "    prepare_bindings_builder(manifest_dir, options)"}, {"line": 190, "text": "        .generate()"}, {"line": 191, "text": "        .expect(\"Unable to generate bindings.\")"}, {"line": 192, "text": "}"}, {"line": 193, "text": ""}, {"line": 194, "text": "#[cfg(test)]"}, {"line": 195, "text": "mod tests {"}, {"line": 196, "text": "    use super::*;"}, {"line": 197, "text": "    use crate::strip_binding_link_prefixes;"}, {"line": 198, "text": ""}, {"line": 242, "text": "        let header = HEADER.replace("}, {"line": 243, "text": "            \"PREFIX_\","}, {"line": 244, "text": "            &prefix.map_or_else(String::new, |p| format!(\"{p}_\")),"}, {"line": 245, "text": "        );"}, {"line": 246, "text": "        let mut builder = bindgen::Builder::default()"}, {"line": 247, "text": "            .header_contents(\"test/openssl/mem.h\", &header)"}, {"line": 248, "text": "            .clang_arg(format!(\"--target={target}\"))"}, {"line": 249, "text": "            .clang_arg(\"-nostdinc\")"}, {"line": 250, "text": "            .detect_include_paths(false)"}, {"line": 251, "text": "            .layout_tests(false)"}, {"line": 252, "text": "            .formatter(bindgen::Formatter::None);"}, {"line": 253, "text": "        if let Some(prefix) = prefix {"}, {"line": 254, "text": "            builder = builder.parse_callbacks(Box::new(StripPrefixCallback::new(prefix)));"}, {"line": 255, "text": "        }"}, {"line": 256, "text": "        configure_binding_scope(builder, all_bindings)"}, {"line": 257, "text": "            .generate()"}, {"line": 258, "text": "            .expect(\"generate fixture bindings\")"}, {"line": 259, "text": "            .to_string()"}, {"line": 260, "text": "    }"}, {"line": 261, "text": ""}, {"line": 262, "text": "    // Whole-identifier match on declarations only, so `FILE` does not match"}, {"line": 263, "text": "    // `_IO_FILE` and `tm` does not match a `*mut tm` parameter."}, {"line": 264, "text": "    fn declares_item(bindings: &str, name: &str) -> bool {"}, {"line": 265, "text": "        const KEYWORDS: [&str; 5] = [\"fn\", \"type\", \"struct\", \"const\", \"static mut\"];"}], "selected_lines_truncated": false, "sha256": "6ddd6df8f90b53bd8f2ece6b636550301d4dcdc19946e455bb9e6cf25e926d31", "size": 11341, "symlink": false, "version": "66306:65407649:11341:1153704088000000000:1793863964685553210"}, {"exists": true, "matching_lines_total": 119, "path": "/home/qq/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/bindgen-0.73.2/lib.rs", "realpath": "/home/qq/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/bindgen-0.73.2/lib.rs", "regular_file": true, "selected_lines": [{"line": 248, "text": "///"}, {"line": 249, "text": "/// Extra arguments can be passed to with clang:"}, {"line": 250, "text": "/// 1. [`clang_arg()`](#method.clang_arg): takes a single argument"}, {"line": 251, "text": "/// 2. [`clang_args()`](#method.clang_args): takes an iterator of arguments"}, {"line": 252, "text": "/// 3. `BINDGEN_EXTRA_CLANG_ARGS` environment variable: whitespace separate"}, {"line": 253, "text": "///    environment variable of arguments"}, {"line": 254, "text": "///"}, {"line": 255, "text": "/// Clang arguments specific to your crate should be added via the"}, {"line": 256, "text": "/// `clang_arg()`/`clang_args()` methods."}, {"line": 257, "text": "///"}, {"line": 258, "text": "/// End-users of the crate may need to set the `BINDGEN_EXTRA_CLANG_ARGS` environment variable to"}, {"line": 259, "text": "/// add additional arguments. For example, to build against a different sysroot a user could set"}, {"line": 260, "text": "/// `BINDGEN_EXTRA_CLANG_ARGS` to `--sysroot=/path/to/sysroot`."}, {"line": 261, "text": "///"}, {"line": 262, "text": "/// # Regular expression arguments"}, {"line": 263, "text": "///"}, {"line": 264, "text": "/// Some [`Builder`] methods, such as `allowlist_*` and `blocklist_*`, allow regular"}, {"line": 265, "text": "/// expressions as arguments. These regular expressions will be enclosed in parentheses and"}, {"line": 266, "text": "/// anchored with `^` and `$`. So, if the argument passed is `<regex>`, the regular expression to be"}, {"line": 267, "text": "/// stored will be `^(<regex>)$`."}, {"line": 268, "text": "///"}, {"line": 291, "text": "pub fn builder() -> Builder {"}, {"line": 292, "text": "    Default::default()"}, {"line": 293, "text": "}"}, {"line": 294, "text": ""}, {"line": 295, "text": "fn get_extra_clang_args("}, {"line": 296, "text": "    parse_callbacks: &[Rc<dyn callbacks::ParseCallbacks>],"}, {"line": 297, "text": ") -> Vec<String> {"}, {"line": 298, "text": "    // Add any extra arguments from the environment to the clang command line."}, {"line": 299, "text": "    let Some(extra_clang_args) = get_target_dependent_env_var("}, {"line": 300, "text": "        parse_callbacks,"}, {"line": 301, "text": "        \"BINDGEN_EXTRA_CLANG_ARGS\","}, {"line": 302, "text": "    ) else {"}, {"line": 303, "text": "        return vec![];"}, {"line": 304, "text": "    };"}, {"line": 305, "text": ""}, {"line": 306, "text": "    // Try to parse it with shell quoting. If we fail, make it one single big argument."}, {"line": 307, "text": "    if let Some(strings) = shlex::split(&extra_clang_args) {"}, {"line": 308, "text": "        return strings;"}, {"line": 309, "text": "    }"}, {"line": 338, "text": "        };"}, {"line": 339, "text": ""}, {"line": 340, "text": "        // Add any extra arguments from the environment to the clang command line."}, {"line": 341, "text": "        self.options.clang_args.extend("}, {"line": 342, "text": "            get_extra_clang_args(&self.options.parse_callbacks)"}, {"line": 343, "text": "                .into_iter()"}, {"line": 344, "text": "                .map(String::into_boxed_str),"}, {"line": 345, "text": "        );"}, {"line": 346, "text": ""}, {"line": 347, "text": "        for header in &self.options.input_headers {"}, {"line": 348, "text": "            self.options"}, {"line": 349, "text": "                .for_each_callback(|cb| cb.header_file(header.as_ref()));"}, {"line": 350, "text": "        }"}, {"line": 386, "text": "    /// issues. The resulting file will be named something like `__bindgen.i` or"}, {"line": 387, "text": "    /// `__bindgen.ii`"}, {"line": 388, "text": "    pub fn dump_preprocessed_input(&self) -> io::Result<()> {"}, {"line": 389, "text": "        let clang ="}, {"line": 390, "text": "            clang_sys::support::Clang::find(None, &[]).ok_or_else(|| {"}, {"line": 391, "text": "                io::Error::new("}, {"line": 392, "text": "                    io::ErrorKind::Other,"}, {"line": 393, "text": "                    \"Cannot find clang executable\","}, {"line": 394, "text": "                )"}, {"line": 395, "text": "            })?;"}, {"line": 396, "text": ""}, {"line": 397, "text": "        // The contents of a wrapper file that includes all the input header"}, {"line": 398, "text": "        // files."}, {"line": 443, "text": "        for a in &self.options.clang_args {"}, {"line": 444, "text": "            cmd.arg(a.as_ref());"}, {"line": 445, "text": "        }"}, {"line": 446, "text": ""}, {"line": 447, "text": "        for a in get_extra_clang_args(&self.options.parse_callbacks) {"}, {"line": 448, "text": "            cmd.arg(a);"}, {"line": 449, "text": "        }"}, {"line": 450, "text": ""}, {"line": 451, "text": "        let mut child = cmd.spawn()?;"}, {"line": 452, "text": ""}, {"line": 453, "text": "        let mut preprocessed = child.stdout.take().unwrap();"}, {"line": 454, "text": "        let mut file = File::create(if is_cpp {"}, {"line": 455, "text": "            \"__bindgen.ii\""}, {"line": 804, "text": "            options.clang_args.insert(0, target_arg.clone());"}, {"line": 805, "text": "            options.fallback_clang_args.insert(0, target_arg);"}, {"line": 806, "text": "        }"}, {"line": 807, "text": ""}, {"line": 808, "text": "        fn detect_include_paths(options: &mut BindgenOptions) {"}, {"line": 809, "text": "            if !options.detect_include_paths {"}, {"line": 810, "text": "                return;"}, {"line": 811, "text": "            }"}, {"line": 812, "text": ""}, {"line": 813, "text": "            // Filter out include paths and similar stuff, so we don't incorrectly"}, {"line": 814, "text": "            // promote them to `-isystem`."}, {"line": 815, "text": "            let clang_args_for_clang_sys = {"}, {"line": 816, "text": "                let mut last_was_include_prefix = false;"}, {"line": 817, "text": "                options"}, {"line": 847, "text": "            debug!("}, {"line": 848, "text": "                \"Trying to find clang with flags: {clang_args_for_clang_sys:?}\""}, {"line": 849, "text": "            );"}, {"line": 850, "text": ""}, {"line": 851, "text": "            let Some(clang) = clang_sys::support::Clang::find("}, {"line": 852, "text": "                None,"}, {"line": 853, "text": "                &clang_args_for_clang_sys,"}], "selected_lines_truncated": true, "sha256": "bd1715d40656416337d54a14e1d26c687484858e1578607d6d5ee6ea84cc78ef", "size": 46016, "symlink": false, "version": "66306:65293968:46016:1153704088000000000:1793863961139173955"}, {"exists": true, "matching_lines_total": 60, "path": "/home/qq/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/clang-sys-1.9.1/src/support.rs", "realpath": "/home/qq/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/clang-sys-1.9.1/src/support.rs", "regular_file": true, "selected_lines": [{"line": 27, "text": "    /// they could be parsed."}, {"line": 28, "text": "    pub c_search_paths: Option<Vec<PathBuf>>,"}, {"line": 29, "text": "    /// The directories searched by this `clang` executable for C++ headers if"}, {"line": 30, "text": "    /// they could be parsed."}, {"line": 31, "text": "    pub cpp_search_paths: Option<Vec<PathBuf>>,"}, {"line": 32, "text": "}"}, {"line": 33, "text": ""}, {"line": 34, "text": "impl Clang {"}, {"line": 35, "text": "    fn new(path: impl AsRef<Path>, args: &[String]) -> Self {"}, {"line": 36, "text": "        Self {"}, {"line": 37, "text": "            path: path.as_ref().into(),"}, {"line": 38, "text": "            version: parse_version(path.as_ref()),"}, {"line": 39, "text": "            c_search_paths: parse_search_paths(path.as_ref(), \"c\", args),"}, {"line": 40, "text": "            cpp_search_paths: parse_search_paths(path.as_ref(), \"c++\", args),"}, {"line": 41, "text": "        }"}, {"line": 42, "text": "    }"}, {"line": 43, "text": ""}, {"line": 44, "text": "    /// Returns a `clang` executable if one can be found."}, {"line": 45, "text": "    ///"}, {"line": 46, "text": "    /// If the `CLANG_PATH` environment variable is set, that is the instance of"}, {"line": 47, "text": "    /// `clang` used. Otherwise, a series of directories are searched. First, if"}, {"line": 48, "text": "    /// a path is supplied, that is the first directory searched. Then, the"}, {"line": 49, "text": "    /// directory returned by `llvm-config --bindir` is searched. On macOS"}, {"line": 50, "text": "    /// systems, `xcodebuild -find clang` will next be queried. Last, the"}, {"line": 51, "text": "    /// directories in the system's `PATH` are searched."}, {"line": 52, "text": "    ///"}, {"line": 53, "text": "    /// ## Cross-compilation"}, {"line": 54, "text": "    ///"}, {"line": 55, "text": "    /// If target arguments are provided (e.g., `--target` followed by a target"}, {"line": 56, "text": "    /// like `x86_64-unknown-linux-gnu`) then this method will prefer a"}, {"line": 57, "text": "    /// target-prefixed instance of `clang` (e.g.,"}, {"line": 58, "text": "    /// `x86_64-unknown-linux-gnu-clang` for the above example)."}, {"line": 59, "text": "    pub fn find(path: Option<&Path>, args: &[String]) -> Option<Clang> {"}, {"line": 60, "text": "        if let Ok(path) = env::var(\"CLANG_PATH\") {"}, {"line": 61, "text": "            let p = Path::new(&path);"}, {"line": 62, "text": "            if p.is_file() && is_executable(p).unwrap_or(false) {"}, {"line": 63, "text": "                return Some(Clang::new(p, args));"}, {"line": 64, "text": "            } else {"}, {"line": 65, "text": "                eprintln!(\"`CLANG_PATH` env var set but is not a full path to an executable\");"}, {"line": 66, "text": "            }"}, {"line": 67, "text": "        }"}, {"line": 68, "text": ""}, {"line": 69, "text": "        // Determine the cross-compilation target, if any."}, {"line": 70, "text": ""}, {"line": 71, "text": "        let mut target = None;"}, {"line": 72, "text": "        for i in 0..args.len() {"}, {"line": 73, "text": "            if (args[i] == \"-target\" || args[i] == \"--target\") && i + 1 < args.len() {"}, {"line": 220, "text": "    })"}, {"line": 221, "text": "}"}, {"line": 222, "text": ""}, {"line": 223, "text": "/// Parses the search paths from the output of a `clang` executable if possible."}, {"line": 224, "text": "fn parse_search_paths(path: &Path, language: &str, args: &[String]) -> Option<Vec<PathBuf>> {"}, {"line": 225, "text": "    let mut clang_args = vec![\"-E\", \"-x\", language, \"-\", \"-v\"];"}, {"line": 226, "text": "    clang_args.extend(args.iter().map(|s| &**s));"}, {"line": 227, "text": "    let output = run_clang(path, &clang_args).1;"}, {"line": 228, "text": "    let start = output.find(\"#include <...> search starts here:\")? + 34;"}, {"line": 229, "text": "    let end = output.find(\"End of search list.\")?;"}, {"line": 230, "text": "    let paths = output[start..end].replace(\"(framework directory)\", \"\");"}, {"line": 231, "text": "    Some("}, {"line": 232, "text": "        paths"}], "selected_lines_truncated": false, "sha256": "944a20ba026ae545e77e215a705f64de1e57dfb0fb7758ed5865bc16ff7b0dc8", "size": 8345, "symlink": false, "version": "66306:65290002:8345:1153704088000000000:1793863959546981768"}, {"exists": true, "matching_lines_total": 97, "path": "/home/qq/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/clang-sys-1.9.1/build/dynamic.rs", "realpath": "/home/qq/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/clang-sys-1.9.1/build/dynamic.rs", "regular_file": true, "selected_lines": [{"line": 116, "text": "}"}, {"line": 117, "text": ""}, {"line": 118, "text": "/// Finds `libclang` shared libraries and returns the paths to, filenames of,"}, {"line": 119, "text": "/// and versions of those shared libraries."}, {"line": 120, "text": "fn search_libclang_directories(runtime: bool) -> Result<Vec<(PathBuf, String, Vec<u32>)>, String> {"}, {"line": 121, "text": "    let mut files = vec![format!("}, {"line": 122, "text": "        \"{}clang{}\","}, {"line": 123, "text": "        env::consts::DLL_PREFIX,"}, {"line": 124, "text": "        env::consts::DLL_SUFFIX"}, {"line": 125, "text": "    )];"}, {"line": 126, "text": ""}, {"line": 127, "text": "    if target_os!(\"linux\") {"}, {"line": 128, "text": "        // Some Linux distributions don't create a `libclang.so` symlink, so we"}, {"line": 159, "text": ""}, {"line": 160, "text": "    // Find and validate `libclang` shared libraries and collect the versions."}, {"line": 161, "text": "    let mut valid = vec![];"}, {"line": 162, "text": "    let mut invalid = vec![];"}, {"line": 163, "text": "    for (directory, filename) in common::search_libclang_directories(&files, \"LIBCLANG_PATH\") {"}, {"line": 164, "text": "        let path = directory.join(&filename);"}, {"line": 165, "text": "        match validate_library(&path) {"}, {"line": 166, "text": "            Ok(()) => {"}, {"line": 167, "text": "                let version = parse_version(&filename);"}, {"line": 168, "text": "                valid.push((directory, filename, version))"}, {"line": 169, "text": "            }"}, {"line": 170, "text": "            Err(message) => invalid.push(format!(\"({}: {})\", path.display(), message)),"}, {"line": 171, "text": "        }"}, {"line": 176, "text": "    }"}, {"line": 177, "text": ""}, {"line": 178, "text": "    let message = format!("}, {"line": 179, "text": "        \"couldn't find any valid shared libraries matching: [{}], set the \\"}, {"line": 180, "text": "         `LIBCLANG_PATH` environment variable to a path where one of these files \\"}, {"line": 181, "text": "         can be found (invalid: [{}])\","}, {"line": 182, "text": "        files"}, {"line": 183, "text": "            .iter()"}, {"line": 184, "text": "            .map(|f| format!(\"'{}'\", f))"}, {"line": 185, "text": "            .collect::<Vec<_>>()"}, {"line": 186, "text": "            .join(\", \"),"}, {"line": 187, "text": "        invalid.join(\", \"),"}, {"line": 188, "text": "    );"}, {"line": 191, "text": "}"}, {"line": 192, "text": ""}, {"line": 193, "text": "/// Finds the \"best\" `libclang` shared library and returns the directory and"}, {"line": 194, "text": "/// filename of that library."}, {"line": 195, "text": "pub fn find(runtime: bool) -> Result<(PathBuf, String), String> {"}, {"line": 196, "text": "    search_libclang_directories(runtime)?"}, {"line": 197, "text": "        .iter()"}, {"line": 198, "text": "        // We want to find the `libclang` shared library with the highest"}, {"line": 199, "text": "        // version number, hence `max_by_key` below."}, {"line": 200, "text": "        //"}, {"line": 201, "text": "        // However, in the case where there are multiple such `libclang` shared"}, {"line": 202, "text": "        // libraries, we want to use the order in which they appeared in the"}, {"line": 203, "text": "        // list returned by `search_libclang_directories` as a tiebreaker since"}, {"line": 204, "text": "        // that function returns `libclang` shared libraries in descending order"}, {"line": 205, "text": "        // of preference by how they were found."}, {"line": 206, "text": "        //"}, {"line": 207, "text": "        // `max_by_key`, perhaps surprisingly, returns the *last* item with the"}, {"line": 208, "text": "        // maximum key rather than the first which results in the opposite of"}, {"line": 209, "text": "        // the tiebreaking behavior we want. This is easily fixed by reversing"}, {"line": 210, "text": "        // the list first."}, {"line": 211, "text": "        .rev()"}, {"line": 212, "text": "        .max_by_key(|f| &f.2)"}, {"line": 213, "text": "        .cloned()"}, {"line": 214, "text": "        .map(|(path, filename, _)| (path, filename))"}, {"line": 215, "text": "        .ok_or_else(|| \"unreachable\".into())"}, {"line": 216, "text": "}"}, {"line": 217, "text": ""}, {"line": 218, "text": "//================================================"}, {"line": 219, "text": "// Linking"}, {"line": 220, "text": "//================================================"}, {"line": 225, "text": "    let cep = common::CommandErrorPrinter::default();"}, {"line": 226, "text": ""}, {"line": 227, "text": "    use std::fs;"}, {"line": 228, "text": ""}, {"line": 229, "text": "    let (directory, filename) = find(false).unwrap();"}, {"line": 230, "text": "    println!(\"cargo:rustc-link-search={}\", directory.display());"}, {"line": 231, "text": ""}, {"line": 232, "text": "    if cfg!(all(target_os = \"windows\", target_env = \"msvc\")) {"}, {"line": 233, "text": "        // Find the `libclang` stub static library required for the MSVC"}, {"line": 234, "text": "        // toolchain."}, {"line": 235, "text": "        let lib = if !directory.ends_with(\"bin\") {"}, {"line": 236, "text": "            directory"}, {"line": 237, "text": "        } else {"}, {"line": 268, "text": ""}, {"line": 269, "text": "        // Strip extensions and trailing version numbers (e.g., the `.so.7.0` in"}, {"line": 270, "text": "        // `libclang.so.7.0`) and also `.dll` for MinGW / MSYS."}, {"line": 271, "text": "        let name = match name"}, {"line": 272, "text": "            .find(\".dylib\")"}, {"line": 273, "text": "            .or_else(|| name.find(\".so\"))"}, {"line": 274, "text": "            .or_else(|| name.find(\".dll\"))"}, {"line": 275, "text": "        {"}, {"line": 276, "text": "            Some(index) => &name[0..index],"}, {"line": 277, "text": "            None => name,"}, {"line": 278, "text": "        };"}, {"line": 279, "text": ""}, {"line": 280, "text": "        println!(\"cargo:rustc-link-lib=dylib={}\", name);"}, {"line": 281, "text": "    }"}, {"line": 282, "text": ""}], "selected_lines_truncated": false, "sha256": "d1c96b612a3123971702a64460ef6f5f5e9e3660c774a985168e3f0d955897d0", "size": 9912, "symlink": false, "version": "66306:65289994:9912:1153704088000000000:1793863959546238534"}], "overrides": {"LIBCLANG_PATH": "/usr/lib/x86_64-linux-gnu", "PATH": "/home/qq/.rustup/toolchains/1.96.0-x86_64-unknown-linux-gnu/bin:/home/qq/hepta-smollm2-weight-research-20261103/ci-env/bin:/home/qq/neuro-owner-tools-862531d11598/v1/bin:/home/qq/neuro-owner-tools-862531d11598/protoc-33.5-v2/bin:/home/qq/neuro-owner-tools-862531d11598/dotslash-0.5.9-v1/bin:/home/qq/.cargo/bin:/usr/local/bin:/usr/bin:/bin"}, "package_status": {"argv": ["dpkg-query", "-W", "-f=${binary:Package} ${Version} ${db:Status-Status}\n", "libclang1-21", "libclang-common-21-dev", "clang-21", "libc6-dev", "gcc-15"], "returncode": 1, "stderr": {"bytes": 110, "sha256": "8907dd662f0ae703e5ddacc38a4249b82a452349afb0dfa9c4b8b4bd5a3782e5", "text": "dpkg-query: no packages found matching libclang-common-21-dev\ndpkg-query: no packages found matching clang-21\n", "truncated": false}, "stdout": {"bytes": 117, "sha256": "930e04b67cea4bae8d068358d3464bd802cff8cf694c4