+def standalone_all(rows, *, parent_p='0',parent_m='0',parent_m_clock=None):
+    """One fresh full evidence/DAG check for one all-cell boundary.
+
+    No cross-call cache or unverified public path. The verified deep copy stays
+    local; a new stage/append/wait requires a new invocation. All original
+    per-cell Decimal formulas and ceilings are reused. An optional live clock
+    keeps post-stage accounting work inside M, including a final all-cell gate.
+    """
+    if parent_m_clock is not None and not callable(parent_m_clock):
+        raise TypeError('parent M clock must be callable')
+    checked=inventory(rows)
+    accounts={}
+    for cell in CELLS:
+        current=parent_m if parent_m_clock is None else parent_m_clock()
+        accounts[cell_id(cell)]=_standalone_verified(checked,cell,parent_p=parent_p,parent_m=current)
+    if parent_m_clock is not None:
+        # Shared M is checked for every cell at the end of the batch too. Do not
+        # erase the verification CPU with one early timestamp or clock reset.
+        final_m=parent_m_clock()
+        accounts={cell_id(cell):_standalone_verified(checked,cell,parent_p=parent_p,parent_m=final_m)
+                  for cell in CELLS}
+    return accounts
+
