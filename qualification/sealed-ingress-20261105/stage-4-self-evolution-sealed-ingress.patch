+#[test]
+fn sealed_longitudinal_qualification_reaches_public_preparation_and_independent_selector() {
+    let fixture = Fixture::new(digest("publication"));
+    let prepared = fixture.prepare().unwrap();
+    assert_eq!(prepared.receipt().qualification_evidence_digest, fixture.qualification.evidence_digest);
+    assert_eq!(prepared.receipt().qualification_publication_digest, fixture.qualification.publication_digest);
+    let selector = fixture.signers.sign(/*signer*/ 3, LearningEvidenceRoleV1::Selector, /*issued_at*/ 70,
+        &selection_signing_payload_v2(prepared.receipt()).unwrap());
+    let selected = admit_self_evolution_selection_v1(prepared, &selector, &fixture.signers.verifier, /*now*/ 70).unwrap();
+    assert_eq!(selected.receipt().qualification_evidence_digest, fixture.qualification.evidence_digest);
+    let regression = digest("observed-regression");
+    let rollback = fixture.signers.sign(/*signer*/ 1, LearningEvidenceRoleV1::Evaluator, /*issued_at*/ 70,
+        &rollback_signing_payload_v1(&selected, regression).unwrap());
+    let rollback = admit_self_evolution_rollback_v1(&selected, regression, &rollback,
+        &fixture.signers.verifier, /*now*/ 70).unwrap();
+    assert_eq!(rollback.rollback_generation(), Generation::new(9).unwrap());
+}
