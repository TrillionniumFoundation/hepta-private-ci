+#[path = "self_evolution_qualification_test_support.rs"]
+mod qualification_support;
+
+fn id(value: &str) -> StableId { StableId::new(value).unwrap() }
+fn digest(value: &str) -> Digest32 { Digest32::of_bytes(value.as_bytes()) }
+
+struct Signers {
+    keys: [SigningKey; 4],
+    principals: Vec<AuthenticatedPrincipalV1>,
+    verifier: LearningEvidenceVerifierV1,
+}
+
+impl Signers {
+    fn new() -> Self {
+        let keys = [11, 22, 33, 44].map(|byte| SigningKey::from_bytes(&[byte; 32]));
+        let principals = keys.iter().enumerate().map(|(index, key)| AuthenticatedPrincipalV1 {
+            principal_id: id(&format!("longitudinal-signer-{index}")),
+            credential_chain_digest: digest(&format!("credential-{index}")),
+            signing_key_digest: Digest32::of_bytes(&key.verifying_key().to_bytes()),
+            scope_digest: digest("longitudinal-scope"),
+            authority_epoch: 7,
+            authenticated_at: 1,
+            expires_at: 100,
+        }).collect::<Vec<_>>();
+        let roles = [LearningEvidenceRoleV1::Generator, LearningEvidenceRoleV1::Evaluator,
+            LearningEvidenceRoleV1::Observer, LearningEvidenceRoleV1::Selector];
+        let verifier = LearningEvidenceVerifierV1::new(LearningEvidenceTrustV1 {
+            scope_digest: digest("longitudinal-scope"),
+            objective_digest: digest("objective"),
+            authority_epoch: 7,
+            signers: principals.iter().zip(&keys).zip(roles).map(|((principal, key), role)| {
+                TrustedLearningSignerV1 {
+                    principal: principal.clone(),
+                    controller_id: principal.principal_id.clone(),
+                    verifying_key: key.verifying_key().to_bytes(),
+                    roles: vec![role],
+                    revoked_at: None,
+                }
+            }).collect(),
+        }).unwrap();
+        Self { keys, principals, verifier }
+    }
+
+    fn sign(&self, signer: usize, role: LearningEvidenceRoleV1, issued_at: u64, payload: &[u8])
+        -> SignedLearningEvidenceV1 {
+        let mut evidence = SignedLearningEvidenceV1 {
+            evidence_id: id(&format!("longitudinal-attestation-{signer}")),
+            principal_id: self.principals[signer].principal_id.clone(),
+            role,
+            trust_digest: self.verifier.trust_digest(),
+            scope_digest: digest("longitudinal-scope"),
+            objective_digest: digest("objective"),
+            authority_epoch: 7,
+            issued_at,
+            expires_at: 99,
+            payload_digest: Digest32::of_bytes(payload),
+            signature: [0; 64],
+        };
+        evidence.signature = self.keys[signer].sign(&evidence.signing_bytes()).to_bytes();
+        evidence
+    }
+}
+
+struct Fixture {
