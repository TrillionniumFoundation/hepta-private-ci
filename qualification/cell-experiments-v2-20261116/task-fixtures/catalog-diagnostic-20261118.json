      "subject_source": "def normalize_machine(machine: str) -> str:\n    machine = machine.lower()\n    if machine in (\"amd64\", \"x86_64\"):\n        return \"x86_64\"\n    if machine in (\"aarch64\", \"arm64\"):\n        return \"aarch64\"\n    return machine\n"
