    "gate_definitions": {
      "full": "Original next/full_kernel compiled FullHX risk and Call; finance parameters fixed",
      "sigmoid": "sigmoid(2z) risk, retaining exactly the same compiled FullHX Call; this differs deliberately from the old v4 sigmoid control",
      "c1": "q=.5+.5*z*abs(z)/(1+z*z), a=relu(-z)^2/(1+relu(-z)^2); stable extreme branches, no financial table",
