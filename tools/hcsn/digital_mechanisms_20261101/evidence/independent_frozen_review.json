  "four_experiment_review": [
    {
      "experiment": "Structured terminal values and policy-state supervision",
      "finding": "Five inherited families receive shared constrained terminal structure; three continuation outputs plus belief remain learned. Chosen states are supervised at recorded latent indices. Autonomous short-horizon witness includes action probability in joint path mass. No teacher posterior enters learned policy features."
    },
    {
      "experiment": "Evidence memory versus sustained drive",
      "finding": "Causal pre-interval driver and exactly one successful completion impulse are separate. Accumulator sees only completed observations and public time. Model families share content access/charges. Current stored history and retained public last observation prevent interpreting this as elimination of all evidence memory."
    },
    {
      "experiment": "Reset-aware prediction and continuous event semantics",
      "finding": "Standalone CTMC uses one generator for forecasts and event/renewal sampling. Pending jump time, destination, RNG and recovery state persist in native checkpoint. Its semantics are explicitly distinct from the inherited finite interval efficacy model and may not inherit that model's quality outcome."
    },
    {
      "experiment": "Fresh freeze and quality/full cost confirmation",
      "finding": "New namespace, fit list, full model publication prerequisite, source/protocol/data/model/receipt checks precede cohort generation. Analysis uses independent fit means, all eight prespecified adjusted intervals, raw-world pairing and external process cost. Failure/drop/budget mismatches are rejected."
    }
  ],
  "inference_limits": [
    "Structural active counts explicitly do not establish equal rank, effective capacity or parameter identifiability.",
    "On-policy collection is one halfway snapshot and is not a current-policy occupancy gradient or a proof of final support coverage.",
