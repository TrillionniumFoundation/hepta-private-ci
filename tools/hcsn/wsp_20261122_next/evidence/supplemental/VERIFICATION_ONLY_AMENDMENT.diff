+    canonical_models = {}
+    def model_identity(entry):
+        path = resolve(entry['model_pin'])
+        identity = entry['model_pin']['sha256']
+        if identity not in canonical_models:
+            canonical_models[identity] = digest(canonical(read(path, entry['model_pin'])).encode())
+        check(canonical_models[identity] == entry['canonical_model_sha256'],
+              'actual canonical model identity')
+        return canonical_models[identity]
+
+    def same_models(actual, frozen, fit):
+        check(set(actual) == set(frozen), 'sealed model name set')
+        original = protocol['fits'][fit]['model']
+        for name in frozen:
+            a, b = actual[name], frozen[name]
+            check({k: v for k, v in a.items() if k != 'model_pin'} ==
+                  {k: v for k, v in b.items() if k != 'model_pin'}, 'sealed model metadata: ' + name)
+            check(model_identity(a) == model_identity(b), 'sealed actual model: ' + name)
+            if any(a['model_pin'][k] != b['model_pin'][k] for k in ('bytes', 'sha256')):
+                # Frozen runner remaps canonically identical KEEP aliases to the
+                # authenticated original file; gzip serialization bytes may differ.
+                check(a['canonical_model_sha256'] == frozen['KEEP']['canonical_model_sha256'] and
+                      all(a['model_pin'][k] == original[k] for k in ('bytes', 'sha256')),
+                      'only source-specified original KEEP alias remapping is allowed')
