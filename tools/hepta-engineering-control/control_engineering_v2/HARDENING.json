{
  "schema": "hepta.control.engineering.hardening.v1",
  "moduleId": "control.engineering",
  "implementationPackage": "control_engineering_v2",
  "publicBoundary": "control_engineering_v2.__init__",
  "controls": [
    {
      "id": "G-HARD-001",
      "claim": "Engineering errors retain a stable machine-readable code and malformed evidence fails closed.",
      "source": "hardening.py",
      "symbols": ["_engineering_error_init", "install_hardening"],
      "tests": ["test_engineering_error_has_stable_code"]
    },
    {
      "id": "G-HARD-002",
      "claim": "Every owner mutation starts with BEGIN IMMEDIATE and assignment generations bind an immutable envelope plus active-lease frontier.",
      "source": "hardening.py",
      "symbols": ["_run_immediate", "_hardened_schedule", "assignment_frontier"],
      "tests": ["test_generation_is_bound_to_envelope_and_lease_frontier"]
    },
    {
      "id": "G-HARD-003",
      "claim": "Candidate qualification requires at least one check, an exact clean base, a disconnected local clone, bounded text-only changes, and source Git-frontier invariance.",
      "source": "hardening.py",
      "symbols": ["hardened_sandbox_candidate", "hardened_execute_candidate_sandbox"],
      "tests": [
        "test_zero_checks_are_rejected",
        "test_dirty_source_is_rejected_before_candidate_execution",
        "test_candidate_git_mutation_stays_inside_disconnected_clone",
        "test_check_cannot_rewrite_candidate_after_mutation"
      ]
    },
    {
      "id": "G-HARD-004",
      "claim": "Exact source and synthetic-merge evidence cannot cross an authority boundary until a separately signed receipt binds it to the exact candidate and sandbox receipt.",
      "source": "hardening.py",
      "symbols": [
        "CandidateEvidenceBindingReceipt",
        "BoundEvidenceDecision",
        "bind_candidate_evidence",
        "hardened_request_independent_review",
        "hardened_record_integration_decision"
      ],
      "tests": [
        "test_eligible_decision_requires_candidate_binding",
        "test_unbound_evidence_cannot_request_review",
        "test_signed_binding_allows_review_request_but_no_acceptance",
        "test_binding_cannot_be_replayed_for_another_candidate"
      ]
    },
    {
      "id": "G-HARD-005",
      "claim": "A dormant assimilation proposal requires authenticated external-owner consent and authenticated independent sandbox parity bound to the exact manifest and operations.",
      "source": "hardening.py",
      "symbols": [
        "OwnerConsentAttestation",
        "SandboxParityAttestation",
        "AttestedSandboxParity",
        "hardened_prepare_assimilation_candidate"
      ],
      "tests": [
        "test_authenticated_pipeline_still_stops_at_dormant_candidate",
        "test_unsigned_or_unattested_parity_is_rejected"
      ]
    },
    {
      "id": "G-HARD-006",
      "claim": "Qualification executes exact source-head and synthetic-merge identities and includes documentation plus repository-integrity gates.",
      "source": ".github/workflows/hepta-lane-g-engineering.yml",
      "symbols": ["source-head", "synthetic-merge"],
      "tests": ["lane_g_hardening_validate.py", "hepta-repository-integrity.py"]
    }
  ],
  "authorityNotGranted": [
    "independent_acceptance",
    "merge",
    "activation",
    "promotion",
    "release",
    "deployment",
    "peer_enrollment",
    "credential_propagation",
    "runtime_authority"
  ]
}
