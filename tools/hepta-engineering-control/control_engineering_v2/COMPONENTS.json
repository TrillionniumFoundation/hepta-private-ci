      "failureModel": ["dependency_cycle", "unknown_predecessor", "package_path_outside_envelope", "generation_identity_conflict"],
      "resourceBounds": {"maximumPackages": 4096, "maximumAssignments": 128},
      "rollback": "publish a new immutable generation after revoking conflicting leases"
    },
    {
      "id": "audit-projection",
      "source": "tools/hepta-engineering-control/control_engineering_v2/control_plane.py",
      "symbols": ["EngineeringStore.verify_audit_chain", "EngineeringStore.audit_projection"],
