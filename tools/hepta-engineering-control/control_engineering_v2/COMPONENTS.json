      "source": "tools/hepta-engineering-control/control_engineering_v2/facade.py",
      "symbols": ["issue_work_envelope", "schedule_ready_packages", "generate_candidate", "execute_candidate_sandbox", "verify_integration_evidence", "request_independent_review", "record_integration_decision", "publish_audit_projection", "prepare_assimilation_candidate"],
