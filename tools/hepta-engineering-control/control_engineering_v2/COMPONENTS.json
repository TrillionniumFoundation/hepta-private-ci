      "physicalState": "append-only hash-linked SQLite audit_events",
      "failureModel": ["audit_chain_broken", "invalid_audit_query"],
      "resourceBounds": {"maximumQueryRows": 512},
      "rollback": "quarantine corruption and rebuild the projection from immutable owner facts"
    },
    {
      "id": "integration-decision-store",
      "source": "tools/hepta-engineering-control/control_engineering_v2/control_plane.py",
      "symbols": ["EngineeringStore.record_integration_decision"],
