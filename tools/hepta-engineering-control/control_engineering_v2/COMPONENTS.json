      "failureModel": ["expired_envelope", "authority_ceiling_incomplete", "envelope_identity_conflict"],
      "resourceBounds": {"maximumEncodedBytes": 262144, "maximumAssignments": 128},
      "rollback": "restore an exact compatible predecessor and replay the current revocation frontier"
    },
