      "state": "source_implemented",
      "failureModel": ["invalid_path", "noncanonical_unicode", "unsupported_glob", "path_limit_exceeded"],
      "resourceBounds": {"maximumPathBytes": 1024, "maximumPathsPerRecord": 256},
