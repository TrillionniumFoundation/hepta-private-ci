ngFinished\n Body: \u0027Hello world\u0027\n-Empty body that is never read:\n+\n+Scenario 2: Empty body that is never read\n Page: 200\n Event: Network.loadingFinished\n Body: \u0027\u0027\n```\n```\nThe name of the file: third_party/blink/web_tests/http/tests/inspector-protocol/network/fetch-completed-body-loading-finished.js\nInsertions: 5, Deletions: 3.\n\n@@ -5,6 +5,7 @@\n   await dp.Network.enable();\n \n   async function logLoadingResult(title, expression) {\n+    testRunner.log(\u0027\u0027);\n     testRunner.log(title);\n     const pagePromise \u003d session.evaluateAsync(expression);\n     const event \u003d await Promise.race([\n@@ -23,8 +24,9 @@\n \n   // resource.php is no-store, so the body is not buffered; tail_wait delays\n   // the end of the body after the data is sent.\n-  await logLoadingResult(\u0027No-store body read to the end with a stream reader:\u0027,\n-                         `(async () \u003d\u003e {\n+  await logLoadingResult(\n+      \u0027Scenario 1: No-store body read to the end with a stream reader\u0027,\n+      `(async () \u003d\u003e {\n     const response \u003d\n         await fetch(\u0027/devtools/network/resources/resource.php?tail_wait\u003d100\u0027);\n     const reader \u003d response.body.getReader();\n@@ -41,7 +43,7 @@\n   // The body ends before the buffering of an unread body starts.\n   const emptyUrl \u003d testRunner.url(\u0027./resources/content-length-0.pl\u0027);\n   await logLoadingResult(\n-      \u0027Empty body that is never read:\u0027,\n+      \u0027Scenario 2: Empty body that is never read\u0027,\n       `fetch(${JSON.stringify(emptyUrl)}).then(r \u003d\u003e r.status)`);\n \n   testRunner.completeTest();\n```\n","accounts_in_message":[],"_revision_number":4}],"current_revision_number":4,"current_revision":"62473ad0f747e245e514c93e741bb8e168a2a207","revisions":{"62473ad0f747e245e514c93e741bb8e168a2a207":{"kind":"TRIVIAL_REBASE_WITH_MESSAGE_UPDATE","_number":4,"created":"2026-10-06 21:44:48.000000000","uploader":{"_account_id":1347153,"name":"Chromium LUCI CQ","display_name":"Chromium LUCI CQ","email":"chromium-scoped@luci-project-accounts.iam.gserviceaccount.com","avatars":[{"url":"https://storage.googleapis.com/chrome-infra/lucy-small.png","height":32},{"url":"https://storage.googleapis.com/chrome-infra/lucy-small.png","height":56},{"url":"https://storage.googleapis.com/chrome-infra/lucy-small.png","height":100},{"url":"https://storage.googleapis.com/chrome-infra/lucy-small.png","height":120}],"tags":["SERVICE_USER"]},"ref":"refs/changes/56/8508456/4","fetch":{"repo":{"url":"chromium/src","ref":"refs/changes/56/8508456/4"},"http":{"url":"https://chromium.googlesource.com/chromium/src","ref":"refs/changes/56/8508456/4"},"depot_tools":{"url":"chromium/src","ref":"refs/changes/56/8508456/4"}},"commit":{"parents":[{"commit":"29bebccbb1ffd2d9402c64bc2547c6b89f9bf9cb","subject":"Simplify some checks for the binary size targets"}],"author":{"name":"Yury Semikhatsky","email":"yurys@chromium.org","date":"2026-10-06 21:44:48.000000000","tz":-420},"committer":{"name":"Chromium LUCI CQ","email":"chromium-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2026-10-06 21:44:48.000000000","tz":-420},"subject":"[Fetch] Don\u0027t report a completed fetch() body as cancelled","message":"[Fetch] Don\u0027t report a completed fetch() body as cancelled\n\nDevTools got Network.loadingFailed with net::ERR_ABORTED and\ncanceled: true instead of Network.loadingFinished, and lost the\nresponse body, for fetch() responses whose body had been fully\nreceived:\n- a Cache-Control: no-store body read to the end with\n  response.body.getReader(), when the end of the body arrived\n  separately from the last data chunk;\n- an empty body that the page never read.\n\nWhen the end of the body was signalled in its own OnStateChange(),\nResponseBodyLoader\u0027s DelegatingBytesConsumer notified its client before\nrecording the done state. BodyStreamBuffer saw the closed state, closed\nthe stream and cancelled the consumer, which was still loading, so the\nload ended in ResourceLoader::Cancel(). BodyStreamBuffer is the direct\nclient of a no-store body, which FetchManager does not buffer. Other\nbodies go through a BufferingBytesConsumer, which until it starts\nbuffering after a delay forwards the notification and, with nothing\nbuffered, the closed state. An errored body was reported as cancelled\nthe same way.\n\nRecord the terminal result before notifying the client, as BeginRead()\nalready does, so that the client\u0027s cancellation is a no-op and the load\nfinishes or fails as it should.\n\nBug: 568852319, 371021302\nChange-Id: I02bdf42c58775981ede35f76ced882844873eb7c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8508456\nReviewed-by: Takashi Toyoshima \u003ctoyoshim@chromium.org\u003e\nCommit-Queue: Yury Semikhatsky \u003cyurys@chromium.org\u003e\nReviewed-by: Yoichi Osato \u003cyoichio@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1712735}\n"},"branch":"refs/heads/main","description":"Rebase","conflicts":{"base":"5f709c6aa89109f376ae881325dab264c5383b29","ours":"c8a4bff7cf793d7b349ce40f50fc8343fd21abda","theirs":"29bebccbb1ffd2d9402c64bc2547c6b89f9bf9cb","merge_strategy":"recursive","contains_conflicts":false}}}}
