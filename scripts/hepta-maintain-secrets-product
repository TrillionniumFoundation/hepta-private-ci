#!/usr/bin/python3
"""Root policy maintenance with original-owner CAS and recoverable config publication.
No service is started, no quota is reset, and no provider/grant/operation is issued.
"""
import argparse,fcntl,hashlib,importlib.util,json,os,stat,subprocess,sys
from pathlib import Path

def digest(data):return hashlib.sha256(data).hexdigest()
def encode(value):return json.dumps(value,separators=(',',':')).encode()
def read_root(path):
    s=path.lstat()
    if not stat.S_ISREG(s.st_mode) or s.st_uid!=0 or s.st_nlink!=1 or stat.S_IMODE(s.st_mode)!=0o640 or s.st_size>262144:raise ValueError('unsafe Root maintenance document')
    return path.read_bytes()
def atomic(path,data):
    temporary=path.with_name(path.name+'.maintenance-new')
    if temporary.exists():
        if read_root(temporary)!=data:raise ValueError('different unfinished publication retained')
    else:
        with temporary.open('xb') as f:
            os.fchown(f.fileno(),0,976);os.fchmod(f.fileno(),0o640);f.write(data);f.flush();os.fsync(f.fileno())
    os.replace(temporary,path)
    descriptor=os.open(path.parent,os.O_RDONLY|os.O_DIRECTORY)
    try:os.fsync(descriptor)
    finally:os.close(descriptor)
def create_or_exact(path,data):
    if path.exists():
        if read_root(path)!=data:raise ValueError('different original maintenance intent retained')
        return
    atomic(path,data)
def verifier(manifest):
    helper=Path(manifest['helper_path']);s=helper.lstat()
    if not stat.S_ISREG(s.st_mode) or s.st_uid!=0 or s.st_nlink!=1 or stat.S_IMODE(s.st_mode)!=0o555 or digest(helper.read_bytes())!=manifest['helper_sha256']:raise ValueError('original installed verifier changed')
    spec=importlib.util.spec_from_file_location('original_root_verifier',helper)
    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
    return module
def prepare(config,action,revision,expiry):
    manifest_raw=read_root(config/'instance.json');manifest=json.loads(manifest_raw)
    original_verifier=verifier(manifest);original_verifier.verify_layout(config)
    if (config/'maintenance.pending.json').exists():raise ValueError('original maintenance is pending; use apply with the same intent')
    if manifest.get('policy_revoked',False):raise ValueError('original policy is already revoked; preserve its status and history')
    if revision!=manifest.get('policy_revision',1):raise ValueError('expected Root manifest revision differs')
    runtime_raw=read_root(config/'runtime.json');runtime=json.loads(runtime_raw)
    if digest(runtime_raw)!=manifest['config_sha256']['runtime.json']:raise ValueError('original runtime config differs')
    target=dict(runtime)
    if action=='renew':
        if expiry is None or expiry<=runtime['policy_expires_at_ms']:raise ValueError('renewal must extend only the original policy expiry')
        target['policy_expires_at_ms']=expiry
    elif expiry is not None:raise ValueError('revocation does not extend policy expiry')
    target_raw=encode(target)
    next_manifest=dict(manifest);next_manifest['config_sha256']=dict(manifest['config_sha256'])
    next_manifest['config_sha256']['runtime.json']=digest(target_raw)
    next_manifest['policy_expires_at_ms']=target['policy_expires_at_ms'];next_manifest['policy_revision']=revision+1
    next_manifest['policy_revoked']=action=='revoke'
    stem=f'maintenance-{revision}-{action}'
    snapshot=config/(stem+'.runtime-before.json');intent_path=config/(stem+'.intent.json')
    change={'action':action}
    if action=='renew':change['expires_at_ms']=expiry
    intent={'schema_version':1,'runtime_configuration_sha256':list(hashlib.sha256(runtime_raw).digest()),'expected_policy_revision':revision,'change':change}
    create_or_exact(snapshot,runtime_raw);create_or_exact(intent_path,encode(intent))
    pending={'schema_version':1,'action':action,'original_revision':revision,'policy_id':runtime['policy_id'],'runtime_before':runtime_raw.decode(),'runtime_after':target_raw.decode(),'manifest_before':manifest_raw.decode(),'manifest_after':encode(next_manifest).decode(),'runtime_snapshot':snapshot.name,'intent_file':intent_path.name}
    create_or_exact(config/'maintenance.pending.json',encode(pending))
    return pending
def apply(config):
    pending_path=config/'maintenance.pending.json';pending=json.loads(read_root(pending_path))
    if pending['schema_version']!=1 or pending['action'] not in ['renew','revoke']:raise ValueError('unsupported original maintenance')
    before_runtime=pending['runtime_before'].encode();after_runtime=pending['runtime_after'].encode()
    before_manifest=pending['manifest_before'].encode();after_manifest=pending['manifest_after'].encode()
    if read_root(config/'runtime.json') not in [before_runtime,after_runtime] or read_root(config/'instance.json') not in [before_manifest,after_manifest]:raise ValueError('configuration differs from both original publication states')
    # This restores only the original Root startup configuration, never any DB,
    # clock, quota, grant or ACK. A changed durable policy conflicts with it and
    # cannot admit effects until the same intent publishes its successor config.
    if read_root(config/'runtime.json')!=before_runtime:atomic(config/'runtime.json',before_runtime)
    if read_root(config/'instance.json')!=before_manifest:atomic(config/'instance.json',before_manifest)
    original=json.loads(before_manifest);module=verifier(original);module.verify_layout(config)
    snapshot=config/pending['runtime_snapshot'];intent=config/pending['intent_file']
    if snapshot.parent!=config or intent.parent!=config or read_root(snapshot)!=before_runtime:raise ValueError('original maintenance paths changed')
    endpoint_parent=Path(json.loads(before_runtime)['service']['socket_path']).parent
    if not endpoint_parent.exists():
        # /run is volatile. Recreate only the original runtime endpoint parent
        # after a boot; no durable owner, stable-history file or key is replaced.
        module.protected_ancestors(endpoint_parent.parent)
        endpoint_parent.mkdir(mode=0o750);os.chown(endpoint_parent,992,976);os.chmod(endpoint_parent,0o750)
    metadata=endpoint_parent.lstat()
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid!=992 or metadata.st_gid!=976 or metadata.st_mode&0o027:raise ValueError('original runtime endpoint parent differs')
    command=[original['binary_path'],'maintain-runtime-policy',str(snapshot),str(intent)]
    # No timeout kills this physical owner. A failed/uncertain child leaves the
    # original intent and publication states; apply uses the same revision CAS.
    child=subprocess.run(['/usr/bin/setpriv','--reuid','992','--regid','976','--clear-groups',*command],stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    if child.returncode or len(child.stdout)>4096:raise ValueError('original maintenance remains pending; keep state and use apply after restoring trusted clock availability')
    result=json.loads(child.stdout)
    target=json.loads(after_runtime)
    if result['policy_id']!=pending['policy_id'] or result['revision']!=pending['original_revision']+1 or result['expires_at_ms']!=target['policy_expires_at_ms'] or result['revoked']!=(pending['action']=='revoke'):raise ValueError('original revision result differs; publication retained')
    atomic(config/'runtime.json',after_runtime);atomic(config/'instance.json',after_manifest)
    module.verify_layout(config)
    receipt=config/f"maintenance-{pending['original_revision']}-{pending['action']}.completed.json"
    pending['result']={key:value for key,value in result.items() if key!='already_applied'}
    create_or_exact(receipt,encode(pending))
    pending_path.unlink();descriptor=os.open(config,os.O_RDONLY|os.O_DIRECTORY)
    try:os.fsync(descriptor)
    finally:os.close(descriptor)
    return result
def main():
    parser=argparse.ArgumentParser();parser.add_argument('command',choices=['renew','revoke','apply']);parser.add_argument('--config',type=Path,default=Path('/etc/hepta-secrets'));parser.add_argument('--expected-revision',type=int);parser.add_argument('--expires-at-ms',type=int);args=parser.parse_args()
    if os.geteuid()!=0:raise ValueError('Root required')
    if not args.config.is_absolute() or '..' in args.config.parts:raise ValueError('protected absolute config required')
    for ancestor in [args.config,*args.config.parents]:
        s=ancestor.lstat()
        if not stat.S_ISDIR(s.st_mode) or s.st_uid!=0 or s.st_mode&0o022:raise ValueError('unprotected configuration ancestor')
    lock=os.open(args.config/'.root-maintenance.lock',os.O_CREAT|os.O_RDWR|os.O_NOFOLLOW|os.O_NONBLOCK,0o600)
    metadata=os.fstat(lock)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid!=0 or metadata.st_nlink!=1 or stat.S_IMODE(metadata.st_mode)!=0o600:raise ValueError('unsafe Root publication lock')
    fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
    if args.command!='apply':
        if args.expected_revision is None or not 1<=args.expected_revision<2**64-1:raise ValueError('exact original revision required')
        prepare(args.config,args.command,args.expected_revision,args.expires_at_ms)
    elif args.expected_revision is not None or args.expires_at_ms is not None:raise ValueError('apply resumes only the original pending intent')
    print(json.dumps(apply(args.config)))
if __name__=='__main__':
    try:main()
    except Exception as exc:
        print('protected maintenance refused: '+str(exc) if isinstance(exc,ValueError) else 'protected maintenance failed: '+type(exc).__name__,file=sys.stderr);raise SystemExit(1)
