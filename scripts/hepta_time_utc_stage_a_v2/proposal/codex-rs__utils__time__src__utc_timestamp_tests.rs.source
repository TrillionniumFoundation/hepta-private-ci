use super::*;
use pretty_assertions::assert_eq;
use serde::Deserialize;
use serde::Serialize;

type TestResult = Result<(), Box<dyn std::error::Error>>;

#[test]
fn serde_preserves_legacy_autosi_zero_three_six_nine_digits() -> TestResult {
    for (input, expected) in [
        ("2026-01-02T03:04:05Z", "\"2026-01-02T03:04:05Z\""),
        ("2026-01-02T03:04:05.1Z", "\"2026-01-02T03:04:05.100Z\""),
        ("2026-01-02T03:04:05.12Z", "\"2026-01-02T03:04:05.120Z\""),
        ("2026-01-02T03:04:05.1234Z", "\"2026-01-02T03:04:05.123400Z\""),
        ("2026-01-02T03:04:05.1234567Z", "\"2026-01-02T03:04:05.123456700Z\""),
        ("2026-01-02T03:04:05.000000001Z", "\"2026-01-02T03:04:05.000000001Z\""),
    ] {
        let value = UtcTimestamp::parse_rfc3339(input)?;
        assert_eq!(serde_json::to_string(&value)?, expected, "{input}");
        assert_eq!(serde_json::from_str::<UtcTimestamp>(expected)?, value);
    }
    Ok(())
}

#[test]
fn serde_normalizes_offsets_before_canonical_bytes() -> TestResult {
    let expected = UtcTimestamp::parse_rfc3339("2026-01-01T21:34:05.100Z")?;
    for input in [
        "\"2026-01-02T03:04:05.1+05:30\"",
        "\"2026-01-02 03:04:05.1+0530\"",
        "\"2026-01-01t21:34:05.100z\"",
    ] {
        let value: UtcTimestamp = serde_json::from_str(input)?;
        assert_eq!(value, expected);
        assert_eq!(serde_json::to_string(&value)?, "\"2026-01-01T21:34:05.100Z\"");
    }
    for (input, canonical) in [
        (" 2026 - 1 - 2 3 : 4 : 5.1000000009 uTc \n",
            "\"2026-01-02T03:04:05.100Z\""),
        ("+002026-1-2t3:4:5.1z", "\"2026-01-02T03:04:05.100Z\""),
        ("2026-1-2 0:0:5.1\u{2212}03:: \u{2002}04",
            "\"2026-01-02T03:04:05.100Z\""),
        ("2026\u{2002}-\u{2002}1 -2T \t3 :4:\r5.1 UTC",
            "\"2026-01-02T03:04:05.100Z\""),
        ("2026-1-2T3:4:5.123456789999999Z",
            "\"2026-01-02T03:04:05.123456789Z\""),
        ("1969-12-31T23:59:59.999999999999Z",
            "\"1969-12-31T23:59:59.999999999Z\""),
        ("1969-12-31T23:59:59.000000000999Z",
            "\"1969-12-31T23:59:59Z\""),
        ("1-1-1T0:0:0Z", "\"0001-01-01T00:00:00Z\""),
        ("-0000-1-1T0:0:0UTC", "\"0000-01-01T00:00:00Z\""),
    ] {
        let encoded = serde_json::to_string(input)?;
        let value: UtcTimestamp = serde_json::from_str(&encoded)?;
        assert_eq!(serde_json::to_string(&value)?, canonical, "{input}");
    }
    Ok(())
}

#[test]
fn public_rfc3339_parser_keeps_relaxed_forms_at_serde_boundary() -> TestResult {
    assert!(UtcTimestamp::parse_rfc3339("2026-01-02 03:04:05+0000").is_err());
    assert!(serde_json::from_str::<UtcTimestamp>("\"2026-01-02 03:04:05+0000\"").is_ok());
    for input in [
        "2026-1-2\t3:4:5Z",
        "2026-1-2\u{2002}3:4:5Z",
        "2026-1-2T3:4:5 .1Z",
        "2026-1-2T3:4:5. Z",
        "2026-1-2T3:4:5+0:00",
        "2026-1-2T3:4:5+00:0",
        "2026-1-2T3:4:5+ 01:00",
        "2026-1-2T3:4:5GMT",
        "2026-1-2T3:4:5UTCjunk",
        "2026-1-2T3:4:5.1 2Z",
        "2026-1-2T3:4:5+00:60",
        "2026-1-2T3:4:5\u{2212}24:00",
        "20260-1-2T3:4:5Z",
        "+ 2026-1-2T3:4:5Z",
    ] {
        let encoded = serde_json::to_string(input)?;
        assert!(serde_json::from_str::<UtcTimestamp>(&encoded).is_err(), "{input}");
    }
    Ok(())
}

#[test]
fn negative_epoch_seconds_and_milliseconds_floor() -> TestResult {
    for (nanos, seconds, millis) in [
        (-1_000_000_001_i128, -2_i64, -1_001_i64),
        (-1_000_000_000, -1, -1_000),
        (-999_999_999, -1, -1_000),
        (-1_000_001, -1, -2),
        (-1_000_000, -1, -1),
        (-999_999, -1, -1),
        (-1, -1, -1),
        (0, 0, 0),
        (1, 0, 0),
        (999_999, 0, 0),
        (1_000_000, 0, 1),
        (1_000_000_001, 1, 1_000),
    ] {
        let value = UtcTimestamp::from_unix_nanos(nanos)?;
        assert_eq!(value.unix_nanos(), nanos);
        assert_eq!(value.unix_seconds(), seconds, "{nanos}");
        assert_eq!(value.unix_millis(), millis, "{nanos}");
        assert_eq!(i128::from(value.unix_seconds()), nanos.div_euclid(/*rhs*/ 1_000_000_000));
        assert_eq!(i128::from(value.unix_millis()), nanos.div_euclid(/*rhs*/ 1_000_000));
    }
    Ok(())
}

#[derive(Debug, Deserialize, Eq, PartialEq, Serialize)]
struct NumericSchemas {
    #[serde(with = "epoch_seconds")]
    seconds: UtcTimestamp,
    #[serde(with = "epoch_milliseconds")]
    milliseconds: UtcTimestamp,
}

#[test]
fn explicit_numeric_schemas_keep_integers_and_old_units() -> TestResult {
    let value = UtcTimestamp::from_unix_nanos(/*value*/ -1)?;
    let encoded = serde_json::to_string(&NumericSchemas { seconds: value, milliseconds: value })?;
    assert_eq!(encoded, r#"{"seconds":-1,"milliseconds":-1}"#);
    let decoded: NumericSchemas = serde_json::from_str(&encoded)?;
    assert_eq!(decoded.seconds.unix_nanos(), -1_000_000_000);
    assert_eq!(decoded.milliseconds.unix_nanos(), -1_000_000);
    assert!(serde_json::from_str::<NumericSchemas>(
        r#"{"seconds":-0.5,"milliseconds":-1}"#).is_err());
    assert!(serde_json::from_str::<NumericSchemas>(
        r#"{"seconds":"-1","milliseconds":-1}"#).is_err());
    assert!(serde_json::from_str::<NumericSchemas>(
        r#"{"seconds":-1,"milliseconds":null}"#).is_err());
    Ok(())
}

#[test]
fn numeric_constructors_never_infer_units_from_small_values() -> TestResult {
    assert_eq!(UtcTimestamp::from_unix_seconds(/*value*/ 1)?.unix_nanos(), 1_000_000_000);
    assert_eq!(UtcTimestamp::from_unix_millis(/*value*/ 1)?.unix_nanos(), 1_000_000);
    assert_eq!(UtcTimestamp::from_unix_millis(/*value*/ -1)?.unix_nanos(), -1_000_000);
    Ok(())
}

#[test]
fn fixed_precision_and_explicit_utc_suffix_do_not_round() -> TestResult {
    let value = UtcTimestamp::from_unix_nanos(/*value*/ -1)?;
    assert_eq!(value.to_rfc3339(), "1969-12-31T23:59:59.999999999+00:00");
    assert_eq!(value.to_rfc3339_opts(TimestampPrecision::Seconds, UtcSuffix::Z),
        "1969-12-31T23:59:59Z");
    assert_eq!(value.to_rfc3339_opts(TimestampPrecision::Milliseconds, UtcSuffix::Z),
        "1969-12-31T23:59:59.999Z");
    let exact_second = UtcTimestamp::from_unix_seconds(/*value*/ 0)?;
    assert_eq!(exact_second.to_rfc3339_opts(TimestampPrecision::Milliseconds, UtcSuffix::Offset),
        "1970-01-01T00:00:00.000+00:00");
    Ok(())
}

#[test]
fn display_and_debug_keep_their_distinct_legacy_shapes() -> TestResult {
    let value = UtcTimestamp::parse_rfc3339("2026-01-02T03:04:05.12Z")?;
    assert_eq!(format!("{value}"), "2026-01-02 03:04:05.120 UTC");
    assert_eq!(format!("{value:?}"), "2026-01-02T03:04:05.120Z");
    Ok(())
}

#[test]
fn four_digit_utc_range_is_checked_after_offset_normalization() -> TestResult {
    let first = UtcTimestamp::parse_rfc3339("0000-01-01T00:00:00Z")?;
    let last = UtcTimestamp::parse_rfc3339("9999-12-31T23:59:59.999999999Z")?;
    assert!(matches!(UtcTimestamp::from_unix_nanos(first.unix_nanos() - 1),
        Err(TimestampError::OutsideSupportedRange)));
    assert!(matches!(UtcTimestamp::from_unix_nanos(last.unix_nanos() + 1),
        Err(TimestampError::OutsideSupportedRange)));
    assert!(matches!(UtcTimestamp::parse_rfc3339("0000-01-01T00:00:00+00:01"),
        Err(TimestampError::OutsideSupportedRange)));
    assert!(matches!(UtcTimestamp::parse_rfc3339("9999-12-31T23:59:59-00:01"),
        Err(TimestampError::OutsideSupportedRange)));
    assert_eq!(serde_json::to_string(&first)?, "\"0000-01-01T00:00:00Z\"");
    Ok(())
}

#[test]
fn unsupported_chrono_leap_and_expanded_year_inputs_are_explicit_errors() {
    // These are intentionally unresolved old-input contracts, not evidence
    // that the migration already accepts Chrono's whole domain.
    assert_eq!(UtcTimestamp::parse_rfc3339("2016-12-31T23:59:60Z"),
        Err(TimestampError::UnsupportedLeapSecond));
    assert_eq!(UtcTimestamp::parse_rfc3339("2016-12-31T23:59:60.5Z"),
        Err(TimestampError::UnsupportedLeapSecond));
    assert_eq!(UtcTimestamp::parse_rfc3339("+010000-01-01T00:00:00Z"),
        Err(TimestampError::UnsupportedExpandedYear));
    assert_eq!(UtcTimestamp::parse_rfc3339("-000001-01-01T00:00:00Z"),
        Err(TimestampError::UnsupportedExpandedYear));
    assert_eq!(UtcTimestamp::parse_rfc3339("2026-01-01T00:00:00.1234567890Z"),
        Err(TimestampError::UnsupportedFractionalPrecision));
}

#[test]
fn malformed_and_non_string_inputs_are_not_coerced() {
    for input in [
        "2026-02-30T00:00:00Z",
        "2026-01-01T00:00:00+24:00",
        "2026-01-01T00:00:00.Z",
        "2026-01-01T00:00:00Z[UTC]",
        "2026-01-01T00:00:00",
        "2026-01-01T00:00:00Z trailing",
        "é026-01-01T00:00:00Z",
    ] {
        assert!(UtcTimestamp::parse_rfc3339(input).is_err(), "{input}");
    }
    for input in ["0", "null", "{}", "[]"] {
        assert!(serde_json::from_str::<UtcTimestamp>(input).is_err(), "{input}");
    }
}

#[test]
fn numeric_range_errors_do_not_saturate_into_an_instant() {
    for value in [i64::MIN, i64::MAX] {
        assert_eq!(UtcTimestamp::from_unix_seconds(value),
            Err(TimestampError::OutsideSupportedRange));
        assert_eq!(UtcTimestamp::from_unix_millis(value),
            Err(TimestampError::OutsideSupportedRange));
    }
    assert_eq!(UtcTimestamp::from_unix_nanos(i128::MIN),
        Err(TimestampError::OutsideSupportedRange));
    assert_eq!(UtcTimestamp::from_unix_nanos(i128::MAX),
        Err(TimestampError::OutsideSupportedRange));
}

#[test]
fn legacy_duration_boundary_remains_exact_to_one_nanosecond() -> TestResult {
    let maximum = Duration::new(/*secs*/ 9_223_372_036_854_775, /*nanos*/ 807_000_000);
    assert_eq!(legacy_duration_nanos(maximum)?, i128::from(i64::MAX) * 1_000_000);
    assert_eq!(legacy_duration_nanos(Duration::new(/*secs*/ 9_223_372_036_854_775, /*nanos*/ 807_000_001)),
        Err(TimestampError::DurationOutOfRange));
    assert_eq!(legacy_duration_nanos(Duration::MAX), Err(TimestampError::DurationOutOfRange));
    Ok(())
}

#[test]
fn checked_arithmetic_preserves_instant_and_rejects_range_overflow() -> TestResult {
    let epoch = UtcTimestamp::from_unix_seconds(/*value*/ 0)?;
    let before = epoch.checked_sub_std(Duration::from_nanos(/*nanos*/ 1))?;
    assert_eq!(before.unix_nanos(), -1);
    assert_eq!(before.checked_add_std(Duration::from_nanos(/*nanos*/ 1))?, epoch);
    let first = UtcTimestamp::parse_rfc3339("0000-01-01T00:00:00Z")?;
    let last = UtcTimestamp::parse_rfc3339("9999-12-31T23:59:59.999999999Z")?;
    assert_eq!(first.checked_sub_std(Duration::from_nanos(/*nanos*/ 1)),
        Err(TimestampError::OutsideSupportedRange));
    assert_eq!(last.checked_add_std(Duration::from_nanos(/*nanos*/ 1)),
        Err(TimestampError::OutsideSupportedRange));
    assert_eq!(epoch.checked_add_std(Duration::MAX), Err(TimestampError::DurationOutOfRange));
    Ok(())
}

#[test]
fn system_clock_conversion_preserves_pre_epoch_fraction() -> TestResult {
    let before = UNIX_EPOCH.checked_sub(Duration::from_nanos(/*nanos*/ 1))
        .ok_or("platform cannot represent one nanosecond before the Unix epoch")?;
    let value = UtcTimestamp::from_system_time(before)?;
    assert_eq!(value.unix_nanos(), -1);
    assert_eq!(value.unix_seconds(), -1);
    assert_eq!(value.unix_millis(), -1);
    assert_eq!(UtcTimestamp::from_system_time(UNIX_EPOCH)?.unix_nanos(), 0);
    Ok(())
}

#[test]
fn signed_age_keeps_future_timestamp_negative() -> TestResult {
    let now = UtcTimestamp::from_unix_seconds(/*value*/ 100)?;
    let future = UtcTimestamp::from_unix_seconds(/*value*/ 101)?;
    assert_eq!(now.signed_duration_nanos_since(future), -1_000_000_000);
    assert_eq!(future.signed_duration_nanos_since(now), 1_000_000_000);
    assert_eq!(now.signed_duration_nanos_since(now), 0);
    Ok(())
}
