#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  hepta-generation-pointer initialize --install-root DIR --manifest PATH
  hepta-generation-pointer verify --install-root DIR [--manifest PATH]
  hepta-generation-pointer cutover --install-root DIR --manifest PATH --expected-current-sha256 SHA --output-receipt PATH
  hepta-generation-pointer rollback --receipt PATH --expected-current-sha256 SHA --output-receipt PATH
  hepta-generation-pointer recover-pending --receipt PATH
  hepta-generation-pointer self-test

The command changes only one `active` symlink. It never restarts a service.
EOF
  exit 64
}

sha256_file() { shasum -a 256 "$1" | awk '{print $1}'; }
absolute_non_root() {
  [[ "$1" == /* \
    && "$1" != "/" \
    && "$1" != */ \
    && "$1" != *"//"* \
    && "$1" != *"/../"* \
    && "$1" != *"/./"* \
    && "$1" != */.. \
    && "$1" != */. ]] || {
    echo "path must be absolute, normalized, and non-root: $1" >&2
    return 1
  }
}
require_sha256() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]] || {
    echo "invalid SHA-256: $1" >&2
    exit 1
  }
}
canonical_file() {
  [[ -e "$1" ]] || { echo "path does not exist: $1" >&2; return 1; }
  local directory
  directory="$(cd "$(dirname "$1")" && pwd -P)" || return 1
  realpath "$directory/$(basename "$1")"
}

reserve_private_receipt() {
  local destination="$1" source="$2" parent staged
  absolute_non_root "$destination" || return 1
  [[ ! -e "$destination" && ! -L "$destination" ]] || { echo "refusing to replace receipt: $destination" >&2; return 1; }
  parent="$(dirname "$destination")"
  mkdir -p "$parent" || return 1
  chmod 0700 "$parent" || return 1
  [[ "$(cd "$parent" && pwd -P)" == "$parent" ]] || { echo "receipt parent must be physical and canonical" >&2; return 1; }
  staged="$(mktemp "$parent/.hepta-generation-receipt.XXXXXX")" || return 1
  cp "$source" "$staged" || { rm -f "$staged"; return 1; }
  chmod 0400 "$staged" || { rm -f "$staged"; return 1; }
  ln "$staged" "$destination" || { rm -f "$staged"; echo "failed to reserve generation receipt" >&2; return 1; }
  rm -f "$staged" || true
}

replace_reserved_receipt() {
  local destination="$1" expected_sha="$2" source="$3" parent staged source_sha
  [[ -f "$destination" && ! -L "$destination" && "$(sha256_file "$destination")" == "$expected_sha" ]] || {
    echo "generation receipt reservation changed" >&2
    return 1
  }
  if [[ "${HEPTA_GENERATION_SELF_TEST_FAIL_FINALIZE:-0}" == 1 ]]; then
    echo "injected generation receipt finalization failure" >&2
    return 1
  fi
  parent="$(dirname "$destination")"
  source_sha="$(sha256_file "$source")" || return 1
  staged="$(mktemp "$parent/.hepta-generation-final.XXXXXX")" || return 1
  cp "$source" "$staged" || { rm -f "$staged"; return 1; }
  chmod 0400 "$staged" || { rm -f "$staged"; return 1; }
  [[ "$(sha256_file "$staged")" == "$source_sha" ]] || { rm -f "$staged"; return 1; }
  mv -f "$staged" "$destination" || { rm -f "$staged"; return 1; }
}

write_generation_cursor_cas() {
  local cursor="$1" expected_sha="$2" source="$3" parent staged source_sha
  if [[ "${HEPTA_GENERATION_SELF_TEST_FAIL_CURSOR:-0}" == 1 ]]; then
    echo "injected generation cursor finalization failure" >&2
    return 1
  fi
  parent="$(dirname "$cursor")"
  [[ -d "$parent" && ! -L "$parent" && "$(cd "$parent" && pwd -P)" == "$parent" ]] || return 1
  if [[ -n "$expected_sha" ]]; then
    [[ -f "$cursor" && ! -L "$cursor" && "$(sha256_file "$cursor")" == "$expected_sha" ]] || {
      echo "generation chain cursor changed since review" >&2
      return 1
    }
  else
    [[ ! -e "$cursor" && ! -L "$cursor" ]] || {
      echo "generation chain cursor already exists" >&2
      return 1
    }
  fi
  source_sha="$(sha256_file "$source")" || return 1
  staged="$(mktemp "$parent/.hepta-generation-chain.XXXXXX")" || return 1
  cp "$source" "$staged" || { rm -f "$staged"; return 1; }
  chmod 0400 "$staged" || { rm -f "$staged"; return 1; }
  [[ "$(sha256_file "$staged")" == "$source_sha" ]] || {
    rm -f "$staged"
    echo "generation chain cursor staging changed" >&2
    return 1
  }
  if [[ -n "$expected_sha" ]]; then
    mv -f "$staged" "$cursor" || { rm -f "$staged"; return 1; }
  else
    ln "$staged" "$cursor" || { rm -f "$staged"; return 1; }
    rm -f "$staged" || true
  fi
}

with_generation_lock() {
  local install_root="$1"; shift
  absolute_non_root "$install_root" || return 1
  mkdir -p "$install_root" || return 1
  [[ -d "$install_root" && ! -L "$install_root" && "$(cd "$install_root" && pwd -P)" == "$install_root" ]] || {
    echo "generation lock root must be physical and canonical" >&2
    return 1
  }
  GENERATION_LOCK_DIR="$install_root/.generation-operation.lock"
  mkdir "$GENERATION_LOCK_DIR" 2>/dev/null || { echo "another generation mutation is active or orphaned" >&2; return 1; }
  chmod 0700 "$GENERATION_LOCK_DIR" || return 1
  trap 'rmdir "$GENERATION_LOCK_DIR" 2>/dev/null || true' EXIT
  "$@"
  rmdir "$GENERATION_LOCK_DIR"
  trap - EXIT
}

verify_manifest_self() {
  local manifest="$1" release verify_relative verifier
  manifest="$(canonical_file "$manifest")" || return 1
  release="$(dirname "$manifest")"
  verify_relative="$(jq -r '.watchdog.verify_tool' "$manifest")" || return 1
  [[ "$verify_relative" == "scripts/hepta-immutable-release-tree" ]] || {
    echo "release declares an unsupported verifier: $verify_relative" >&2
    return 1
  }
  verifier="$release/$verify_relative"
  [[ -x "$verifier" && ! -L "$verifier" ]] || {
    echo "release-bound verifier is missing: $verifier" >&2
    return 1
  }
  "$verifier" verify --manifest "$manifest" >/dev/null || return 1
}

layout() {
  INSTALL_ROOT="$1"
  absolute_non_root "$INSTALL_ROOT"
  ACTIVE_LINK="$INSTALL_ROOT/active"
  STABLE_PROGRAM="$INSTALL_ROOT/bin/hepta"
  STABLE_MANIFEST="$INSTALL_ROOT/bin/hepta.manifest"
  GENERATION_CURSOR="$INSTALL_ROOT/.generation-chain.json"
}

verify_generation_cursor() {
  local install_root="$1" expected_release="$2" expected_artifact_sha="$3" expected_manifest_sha="$4"
  layout "$install_root"
  [[ -f "$GENERATION_CURSOR" && ! -L "$GENERATION_CURSOR" ]] || {
    echo "generation chain cursor is missing" >&2
    return 1
  }
  jq -e --arg install_root "$INSTALL_ROOT" --arg release "$expected_release" \
    --arg artifact_sha "$expected_artifact_sha" --arg manifest_sha "$expected_manifest_sha" '
    .schema == "hepta_vnext_generation_chain_v1"
    and .status == "ready"
    and .install_root == $install_root
    and (.sequence | type == "number" and . >= 0 and . == floor)
    and .current.release == $release
    and .current.artifact_sha256 == $artifact_sha
    and .current.manifest_sha256 == $manifest_sha
    and (if .sequence == 0 then .head_receipt == null and .head_receipt_sha256 == null
      else (.head_receipt | startswith("/")) and (.head_receipt_sha256 | test("^[0-9a-f]{64}$")) end)
  ' "$GENERATION_CURSOR" >/dev/null || {
    echo "generation chain cursor does not match the active release" >&2
    return 1
  }
  local sequence head_receipt head_sha
  sequence="$(jq -r '.sequence' "$GENERATION_CURSOR")"
  if (( sequence > 0 )); then
    head_receipt="$(jq -r '.head_receipt' "$GENERATION_CURSOR")"
    head_sha="$(jq -r '.head_receipt_sha256' "$GENERATION_CURSOR")"
    [[ -f "$head_receipt" && ! -L "$head_receipt" \
      && "$(canonical_file "$head_receipt")" == "$head_receipt" \
      && "$(sha256_file "$head_receipt")" == "$head_sha" ]] || {
      echo "generation chain head receipt is missing or changed" >&2
      return 1
    }
  fi
}

ensure_generation_cursor() {
  local install_root="$1" release="$2" artifact_sha="$3" manifest_sha="$4" temp_root cursor_tmp
  layout "$install_root"
  if [[ -e "$GENERATION_CURSOR" || -L "$GENERATION_CURSOR" ]]; then
    verify_generation_cursor "$install_root" "$release" "$artifact_sha" "$manifest_sha"
    return
  fi
  temp_root="${TMPDIR:-/tmp}"
  cursor_tmp="$(mktemp "${temp_root%/}/hepta-generation-chain-genesis.XXXXXX")" || return 1
  jq -n --arg install_root "$INSTALL_ROOT" --arg release "$release" \
    --arg artifact_sha256 "$artifact_sha" --arg manifest_sha256 "$manifest_sha" \
    --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_generation_chain_v1",status:"ready",install_root:$install_root,sequence:0,current:{release:$release,artifact_sha256:$artifact_sha256,manifest_sha256:$manifest_sha256},head_receipt:null,head_receipt_sha256:null,updated_at:$updated_at}' >"$cursor_tmp" || { rm -f "$cursor_tmp"; return 1; }
  write_generation_cursor_cas "$GENERATION_CURSOR" "" "$cursor_tmp" || { rm -f "$cursor_tmp"; return 1; }
  rm -f "$cursor_tmp"
}

verify_layout_raw() {
  local expected_manifest="${2:-}"
  layout "$1"
  [[ -d "$INSTALL_ROOT" && ! -L "$INSTALL_ROOT" && "$(cd "$INSTALL_ROOT" && pwd -P)" == "$INSTALL_ROOT" ]] || {
    echo "install root must be a physical canonical directory" >&2
    return 1
  }
  [[ -L "$ACTIVE_LINK" ]] || { echo "generation pointer is missing: $ACTIVE_LINK" >&2; return 1; }
  [[ -L "$STABLE_PROGRAM" && "$(readlink "$STABLE_PROGRAM")" == "../active/bin/hepta" ]] || {
    echo "stable program link is invalid" >&2
    return 1
  }
  [[ -L "$STABLE_MANIFEST" && "$(readlink "$STABLE_MANIFEST")" == "../active/manifest.json" ]] || {
    echo "stable manifest link is invalid" >&2
    return 1
  }
  local release manifest artifact expected_sha actual_sha
  release="$(canonical_file "$ACTIVE_LINK")"
  manifest="$(canonical_file "$STABLE_MANIFEST")"
  [[ "$manifest" == "$release/manifest.json" ]] || {
    echo "stable manifest escaped the active release" >&2
    return 1
  }
  if [[ -n "$expected_manifest" ]]; then
    expected_manifest="$(canonical_file "$expected_manifest")"
    [[ "$manifest" == "$expected_manifest" ]] || {
      echo "active generation is not the reviewed manifest" >&2
      return 1
    }
  fi
  [[ "$(jq -r '.runtime.install_root' "$manifest")" == "$INSTALL_ROOT" ]] || {
    echo "active manifest install root differs from the physical generation root" >&2
    return 1
  }
  verify_manifest_self "$manifest" || return 1
  artifact="$release/$(jq -r '.artifact.relative_path' "$manifest")"
  [[ "$(canonical_file "$STABLE_PROGRAM")" == "$(canonical_file "$artifact")" ]] || {
    echo "stable program and manifest do not resolve through one release" >&2
    return 1
  }
  expected_sha="$(jq -r '.artifact.sha256' "$manifest")"
  require_sha256 "$expected_sha"
  actual_sha="$(sha256_file "$STABLE_PROGRAM")"
  [[ "$actual_sha" == "$expected_sha" ]] || {
    echo "active program differs from its manifest" >&2
    return 1
  }
  jq -cn \
    --arg install_root "$INSTALL_ROOT" \
    --arg active_link "$ACTIVE_LINK" \
    --arg release "$release" \
    --arg artifact_sha256 "$actual_sha" \
    --arg manifest_sha256 "$(sha256_file "$manifest")" \
    '{schema:"hepta_vnext_generation_pointer_state_v1",status:"ready",install_root:$install_root,active_link:$active_link,release:$release,artifact_sha256:$artifact_sha256,manifest_sha256:$manifest_sha256,single_atomic_pointer:true,service_restarted:false}'
}

verify_layout() {
  local install_root="$1" expected_manifest="${2:-}" state release artifact_sha manifest_sha
  state="$(verify_layout_raw "$install_root" "$expected_manifest")" || return 1
  release="$(jq -r '.release' <<<"$state")" || return 1
  artifact_sha="$(jq -r '.artifact_sha256' <<<"$state")" || return 1
  manifest_sha="$(jq -r '.manifest_sha256' <<<"$state")" || return 1
  verify_generation_cursor "$install_root" "$release" "$artifact_sha" "$manifest_sha" || return 1
  printf '%s\n' "$state"
}

restore_generation_source() {
  local install_root="$1" source_release="$2" source_manifest="$3" expected_cursor_sha="$4" previous_cursor="$5"
  local suffix restore_link
  layout "$install_root"
  suffix="$$.$RANDOM"
  restore_link="$INSTALL_ROOT/.active.recover.$suffix"
  ln -s "$source_release" "$restore_link" || return 1
  mv -fh "$restore_link" "$ACTIVE_LINK" || { rm -f "$restore_link"; return 1; }
  verify_layout_raw "$install_root" "$source_manifest" >/dev/null || return 1
  write_generation_cursor_cas "$GENERATION_CURSOR" "$expected_cursor_sha" "$previous_cursor" || return 1
  verify_layout "$install_root" "$source_manifest" >/dev/null || return 1
}

initialize_layout() {
  local install_root="$1" manifest="$2" release suffix
  layout "$install_root"
  manifest="$(canonical_file "$manifest")" || return 1
  verify_manifest_self "$manifest" || return 1
  [[ "$(jq -r '.runtime.install_root' "$manifest")" == "$install_root" ]] || {
    echo "manifest install root differs from requested generation root" >&2
    exit 1
  }
  release="$(dirname "$manifest")"
  if [[ -e "$ACTIVE_LINK" || -L "$ACTIVE_LINK" || -e "$STABLE_PROGRAM" || -L "$STABLE_PROGRAM" || -e "$STABLE_MANIFEST" || -L "$STABLE_MANIFEST" ]]; then
    verify_layout_raw "$install_root" "$manifest" >/dev/null || return 1
    [[ "$(canonical_file "$ACTIVE_LINK")" == "$release" ]] || {
      echo "generation layout already points at a different release" >&2
      exit 1
    }
    ensure_generation_cursor "$install_root" "$release" \
      "$(jq -r '.artifact.sha256' "$manifest")" "$(sha256_file "$manifest")" || return 1
    return
  fi
  mkdir -p "$INSTALL_ROOT/bin"
  [[ ! -L "$INSTALL_ROOT" && "$(cd "$INSTALL_ROOT" && pwd -P)" == "$INSTALL_ROOT" ]] || {
    echo "install root must be a physical canonical directory" >&2
    exit 1
  }
  suffix="$$.$RANDOM"
  ln -s "$release" "$INSTALL_ROOT/.active.$suffix"
  ln -s "../active/bin/hepta" "$INSTALL_ROOT/bin/.hepta.$suffix"
  ln -s "../active/manifest.json" "$INSTALL_ROOT/bin/.hepta.manifest.$suffix"
  mv -f "$INSTALL_ROOT/bin/.hepta.$suffix" "$STABLE_PROGRAM"
  mv -f "$INSTALL_ROOT/bin/.hepta.manifest.$suffix" "$STABLE_MANIFEST"
  mv -f "$INSTALL_ROOT/.active.$suffix" "$ACTIVE_LINK"
  verify_layout_raw "$install_root" "$manifest" >/dev/null || return 1
  ensure_generation_cursor "$install_root" "$release" \
    "$(jq -r '.artifact.sha256' "$manifest")" "$(sha256_file "$manifest")" || return 1
  jq -cn \
    --arg install_root "$INSTALL_ROOT" \
    --arg release "$release" \
    --arg artifact_sha256 "$(sha256_file "$STABLE_PROGRAM")" \
    '{schema:"hepta_vnext_generation_pointer_initialize_v1",status:"ready",install_root:$install_root,release:$release,artifact_sha256:$artifact_sha256,single_atomic_pointer:true,service_restarted:false}'
}

cutover_layout() {
  local install_root="$1" manifest="$2" expected_current_sha="$3" output_receipt="$4"
  require_sha256 "$expected_current_sha"
  verify_layout "$install_root" >/dev/null || return 1
  layout "$install_root"
  manifest="$(canonical_file "$manifest")" || return 1
  verify_manifest_self "$manifest" || return 1
  [[ "$(jq -r '.runtime.install_root' "$manifest")" == "$install_root" ]] || {
    echo "target manifest install root differs from the physical generation root" >&2
    return 1
  }
  local previous_release previous_manifest previous_manifest_sha previous_sha target_release target_manifest_sha target_sha
  local previous_cursor_sha previous_sequence previous_head_path previous_head_sha sequence ready_receipt_sha pending_sha pending_cursor_sha ready_cursor_sha
  local temp_root pending_tmp receipt_tmp pending_cursor_tmp ready_cursor_tmp previous_cursor_tmp suffix staged_link restore_link
  previous_release="$(canonical_file "$ACTIVE_LINK")" || return 1
  previous_manifest="$previous_release/manifest.json"
  previous_manifest_sha="$(sha256_file "$previous_manifest")"
  previous_sha="$(sha256_file "$STABLE_PROGRAM")"
  [[ "$previous_sha" == "$expected_current_sha" ]] || {
    echo "active generation changed since review" >&2
    return 1
  }
  target_release="$(dirname "$manifest")"
  target_manifest_sha="$(sha256_file "$manifest")"
  target_sha="$(jq -r '.artifact.sha256' "$manifest")"
  require_sha256 "$target_sha"
  [[ "$target_release" != "$previous_release" && "$target_sha" != "$previous_sha" ]] || {
    echo "generation cutover requires a distinct release and artifact" >&2
    return 1
  }
  absolute_non_root "$output_receipt" || return 1
  verify_generation_cursor "$install_root" "$previous_release" "$previous_sha" "$previous_manifest_sha" || return 1
  previous_cursor_sha="$(sha256_file "$GENERATION_CURSOR")"
  previous_sequence="$(jq -r '.sequence' "$GENERATION_CURSOR")"
  sequence="$((previous_sequence + 1))"
  previous_head_path="$(jq -r '.head_receipt // ""' "$GENERATION_CURSOR")"
  previous_head_sha="$(jq -r '.head_receipt_sha256 // ""' "$GENERATION_CURSOR")"
  temp_root="${TMPDIR:-/tmp}"
  pending_tmp="$(mktemp "${temp_root%/}/hepta-generation-pending.XXXXXX")" || return 1
  receipt_tmp="$(mktemp "${temp_root%/}/hepta-generation-final.XXXXXX")" || return 1
  pending_cursor_tmp="$(mktemp "${temp_root%/}/hepta-generation-chain-pending.XXXXXX")" || return 1
  ready_cursor_tmp="$(mktemp "${temp_root%/}/hepta-generation-chain-final.XXXXXX")" || return 1
  previous_cursor_tmp="$(mktemp "${temp_root%/}/hepta-generation-chain-previous.XXXXXX")" || return 1
  suffix="$$.$RANDOM"
  staged_link="$INSTALL_ROOT/.active.$suffix"
  restore_link="$INSTALL_ROOT/.active.restore.$suffix"
  trap 'rm -f "${pending_tmp:-}" "${receipt_tmp:-}" "${pending_cursor_tmp:-}" "${ready_cursor_tmp:-}" "${previous_cursor_tmp:-}" "${staged_link:-}" "${restore_link:-}"; trap - RETURN' RETURN
  cp "$GENERATION_CURSOR" "$previous_cursor_tmp" || return 1
  jq -n --arg install_root "$INSTALL_ROOT" --arg active_program "$STABLE_PROGRAM" \
    --arg previous_release "$previous_release" --arg previous_sha "$previous_sha" \
    --arg previous_manifest_sha "$previous_manifest_sha" --arg target_release "$target_release" \
    --arg target_sha "$target_sha" --arg target_manifest_sha "$target_manifest_sha" \
    --arg chain_cursor "$GENERATION_CURSOR" --arg previous_head_path "$previous_head_path" \
    --arg previous_head_sha "$previous_head_sha" --argjson sequence "$sequence" \
    '{schema:"hepta_vnext_generation_pointer_cutover_v1",status:"ready",install_root:$install_root,sequence:$sequence,chain_cursor:$chain_cursor,chain_head_commit_required:true,previous_chain_head:(if $previous_head_path=="" then null else {receipt:$previous_head_path,sha256:$previous_head_sha} end),active_program:$active_program,previous:{release:$previous_release,artifact_sha256:$previous_sha,manifest_sha256:$previous_manifest_sha},deployed:{release:$target_release,artifact_sha256:$target_sha,manifest_sha256:$target_manifest_sha},cas_verified:true,single_atomic_pointer:true,service_restarted:false}' >"$receipt_tmp" || return 1
  ready_receipt_sha="$(sha256_file "$receipt_tmp")"
  jq -n --arg install_root "$INSTALL_ROOT" --arg chain_cursor "$GENERATION_CURSOR" \
    --arg source_release "$previous_release" --arg source_sha "$previous_sha" --arg source_manifest_sha "$previous_manifest_sha" \
    --arg target_release "$target_release" --arg target_sha "$target_sha" --arg target_manifest_sha "$target_manifest_sha" \
    --arg previous_head_path "$previous_head_path" --arg previous_head_sha "$previous_head_sha" \
    --arg ready_receipt_sha "$ready_receipt_sha" --argjson previous_sequence "$previous_sequence" --argjson sequence "$sequence" \
    '{schema:"hepta_vnext_generation_pointer_pending_v1",status:"pending",operation:"cutover",install_root:$install_root,sequence:$sequence,chain_cursor:$chain_cursor,previous_chain:{sequence:$previous_sequence,head_receipt:(if $previous_head_path=="" then null else $previous_head_path end),head_receipt_sha256:(if $previous_head_sha=="" then null else $previous_head_sha end)},source:{release:$source_release,artifact_sha256:$source_sha,manifest_sha256:$source_manifest_sha},target:{release:$target_release,artifact_sha256:$target_sha,manifest_sha256:$target_manifest_sha},ready_receipt_sha256:$ready_receipt_sha,changed:false}' >"$pending_tmp" || return 1
  reserve_private_receipt "$output_receipt" "$pending_tmp" || return 1
  output_receipt="$(canonical_file "$output_receipt")" || return 1
  pending_sha="$(sha256_file "$output_receipt")"
  jq -n --arg install_root "$INSTALL_ROOT" --arg operation cutover \
    --arg source_release "$previous_release" --arg source_sha "$previous_sha" --arg source_manifest_sha "$previous_manifest_sha" \
    --arg target_release "$target_release" --arg target_sha "$target_sha" --arg target_manifest_sha "$target_manifest_sha" \
    --arg pending_receipt "$output_receipt" --arg pending_receipt_sha "$pending_sha" --arg ready_receipt_sha "$ready_receipt_sha" \
    --arg previous_head_path "$previous_head_path" --arg previous_head_sha "$previous_head_sha" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson previous_sequence "$previous_sequence" --argjson sequence "$sequence" \
    '{schema:"hepta_vnext_generation_chain_pending_v1",status:"pending",install_root:$install_root,sequence:$sequence,operation:$operation,source:{release:$source_release,artifact_sha256:$source_sha,manifest_sha256:$source_manifest_sha},target:{release:$target_release,artifact_sha256:$target_sha,manifest_sha256:$target_manifest_sha},pending_receipt:$pending_receipt,pending_receipt_sha256:$pending_receipt_sha,ready_receipt_sha256:$ready_receipt_sha,previous_chain:{sequence:$previous_sequence,head_receipt:(if $previous_head_path=="" then null else $previous_head_path end),head_receipt_sha256:(if $previous_head_sha=="" then null else $previous_head_sha end)},created_at:$created_at}' >"$pending_cursor_tmp" || return 1
  jq -n --arg install_root "$INSTALL_ROOT" --arg release "$target_release" \
    --arg artifact_sha256 "$target_sha" --arg manifest_sha256 "$target_manifest_sha" \
    --arg head_receipt "$output_receipt" --arg head_receipt_sha256 "$ready_receipt_sha" \
    --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson sequence "$sequence" \
    '{schema:"hepta_vnext_generation_chain_v1",status:"ready",install_root:$install_root,sequence:$sequence,current:{release:$release,artifact_sha256:$artifact_sha256,manifest_sha256:$manifest_sha256},head_receipt:$head_receipt,head_receipt_sha256:$head_receipt_sha256,updated_at:$updated_at}' >"$ready_cursor_tmp" || return 1
  ln -s "$target_release" "$staged_link" || return 1
  ln -s "$previous_release" "$restore_link" || return 1
  [[ "$(sha256_file "$staged_link/bin/hepta")" == "$target_sha" ]] || {
    echo "staged generation artifact differs from manifest" >&2
    return 1
  }
  if [[ "${HEPTA_GENERATION_SELF_TEST_CRASH_AFTER:-}" == pending-receipt ]]; then
    echo "injected crash after pending receipt reservation" >&2
    return 90
  fi
  if ! write_generation_cursor_cas "$GENERATION_CURSOR" "$previous_cursor_sha" "$pending_cursor_tmp"; then
    echo "generation pending-chain reservation failed; active generation was not changed" >&2
    return 1
  fi
  pending_cursor_sha="$(sha256_file "$pending_cursor_tmp")"
  if [[ "${HEPTA_GENERATION_SELF_TEST_CRASH_AFTER:-}" == pending-cursor ]]; then
    echo "injected crash after pending generation cursor" >&2
    return 91
  fi
  if ! mv -fh "$staged_link" "$ACTIVE_LINK" || ! verify_layout_raw "$install_root" "$manifest" >/dev/null; then
    echo "generation cutover failed; restoring the previous active release" >&2
    restore_generation_source "$install_root" "$previous_release" "$previous_manifest" "$pending_cursor_sha" "$previous_cursor_tmp" || return 1
    return 1
  fi
  if [[ "${HEPTA_GENERATION_SELF_TEST_CRASH_AFTER:-}" == active-pointer ]]; then
    echo "injected crash after active generation pointer" >&2
    return 92
  fi
  if ! write_generation_cursor_cas "$GENERATION_CURSOR" "$pending_cursor_sha" "$ready_cursor_tmp"; then
    echo "generation chain finalization failed; restoring the previous active release" >&2
    restore_generation_source "$install_root" "$previous_release" "$previous_manifest" "$pending_cursor_sha" "$previous_cursor_tmp" || return 1
    return 1
  fi
  ready_cursor_sha="$(sha256_file "$ready_cursor_tmp")"
  if [[ "${HEPTA_GENERATION_SELF_TEST_CRASH_AFTER:-}" == ready-cursor ]]; then
    echo "injected crash after ready generation cursor" >&2
    return 93
  fi
  if ! replace_reserved_receipt "$output_receipt" "$pending_sha" "$receipt_tmp"; then
    echo "generation receipt finalization failed; restoring pointer and previous chain cursor" >&2
    restore_generation_source "$install_root" "$previous_release" "$previous_manifest" "$ready_cursor_sha" "$previous_cursor_tmp" || return 1
    return 1
  fi
  trap - RETURN
  rm -f "$pending_tmp" "$receipt_tmp" "$pending_cursor_tmp" "$ready_cursor_tmp" "$previous_cursor_tmp" "$staged_link" "$restore_link" || true
  cat "$output_receipt"
}

rollback_layout() {
  local receipt="$1" expected_current_sha="$2" output_receipt="$3"
  require_sha256 "$expected_current_sha"
  [[ -f "$receipt" && ! -L "$receipt" ]] || {
    echo "rollback receipt must be a regular file" >&2
    return 1
  }
  jq -e '
    .schema == "hepta_vnext_generation_pointer_cutover_v1"
    and .status == "ready"
    and .cas_verified == true
    and .single_atomic_pointer == true
    and (.sequence | type == "number" and . >= 1 and . == floor)
    and (.chain_cursor | startswith("/"))
    and .chain_head_commit_required == true
    and (.install_root | startswith("/"))
    and (.previous.release | startswith("/"))
    and (.deployed.release | startswith("/"))
    and (.previous.artifact_sha256 | test("^[0-9a-f]{64}$"))
    and (.previous.manifest_sha256 | test("^[0-9a-f]{64}$"))
    and (.deployed.artifact_sha256 | test("^[0-9a-f]{64}$"))
    and (.deployed.manifest_sha256 | test("^[0-9a-f]{64}$"))
  ' "$receipt" >/dev/null || {
    echo "invalid rollback receipt" >&2
    return 1
  }
  receipt="$(canonical_file "$receipt")" || return 1
  local install_root previous_release previous_sha previous_manifest_sha deployed_release deployed_sha deployed_manifest_sha
  local previous_cursor_sha previous_sequence sequence receipt_sha ready_receipt_sha pending_sha pending_cursor_sha ready_cursor_sha
  local temp_root pending_tmp receipt_tmp pending_cursor_tmp ready_cursor_tmp previous_cursor_tmp suffix staged_link restore_link
  install_root="$(jq -r '.install_root' "$receipt")"
  previous_release="$(jq -r '.previous.release' "$receipt")"
  previous_sha="$(jq -r '.previous.artifact_sha256' "$receipt")"
  previous_manifest_sha="$(jq -r '.previous.manifest_sha256' "$receipt")"
  deployed_release="$(jq -r '.deployed.release' "$receipt")"
  deployed_sha="$(jq -r '.deployed.artifact_sha256' "$receipt")"
  deployed_manifest_sha="$(jq -r '.deployed.manifest_sha256' "$receipt")"
  [[ "$expected_current_sha" == "$deployed_sha" ]] || {
    echo "rollback CAS differs from cutover receipt" >&2
    return 1
  }
  verify_layout "$install_root" >/dev/null || return 1
  layout "$install_root"
  [[ "$(canonical_file "$ACTIVE_LINK")" == "$deployed_release" && "$(sha256_file "$STABLE_PROGRAM")" == "$deployed_sha" ]] || {
    echo "deployed generation changed since rollback review" >&2
    return 1
  }
  [[ "$(sha256_file "$deployed_release/manifest.json")" == "$deployed_manifest_sha" ]] || {
    echo "deployed generation manifest differs from rollback receipt" >&2
    return 1
  }
  verify_manifest_self "$previous_release/manifest.json" || return 1
  [[ "$(jq -r '.runtime.install_root' "$previous_release/manifest.json")" == "$install_root" ]] || {
    echo "previous manifest install root differs from the physical generation root" >&2
    return 1
  }
  [[ "$(sha256_file "$previous_release/bin/hepta")" == "$previous_sha" ]] || {
    echo "previous generation artifact differs from receipt" >&2
    return 1
  }
  [[ "$(sha256_file "$previous_release/manifest.json")" == "$previous_manifest_sha" ]] || {
    echo "previous generation manifest differs from rollback receipt" >&2
    return 1
  }
  absolute_non_root "$output_receipt" || return 1
  receipt_sha="$(sha256_file "$receipt")"
  verify_generation_cursor "$install_root" "$deployed_release" "$deployed_sha" "$deployed_manifest_sha" || return 1
  [[ "$(jq -r '.head_receipt' "$GENERATION_CURSOR")" == "$receipt" \
    && "$(jq -r '.head_receipt_sha256' "$GENERATION_CURSOR")" == "$receipt_sha" \
    && "$(jq -r '.sequence' "$GENERATION_CURSOR")" == "$(jq -r '.sequence' "$receipt")" ]] || {
    echo "rollback receipt is not the current generation chain head" >&2
    return 1
  }
  previous_cursor_sha="$(sha256_file "$GENERATION_CURSOR")"
  previous_sequence="$(jq -r '.sequence' "$GENERATION_CURSOR")"
  sequence="$((previous_sequence + 1))"
  temp_root="${TMPDIR:-/tmp}"
  pending_tmp="$(mktemp "${temp_root%/}/hepta-generation-rollback-pending.XXXXXX")" || return 1
  receipt_tmp="$(mktemp "${temp_root%/}/hepta-generation-rollback-final.XXXXXX")" || return 1
  pending_cursor_tmp="$(mktemp "${temp_root%/}/hepta-generation-chain-rollback-pending.XXXXXX")" || return 1
  ready_cursor_tmp="$(mktemp "${temp_root%/}/hepta-generation-chain-rollback-ready.XXXXXX")" || return 1
  previous_cursor_tmp="$(mktemp "${temp_root%/}/hepta-generation-chain-previous.XXXXXX")" || return 1
  suffix="$$.$RANDOM"
  staged_link="$INSTALL_ROOT/.active.$suffix"
  restore_link="$INSTALL_ROOT/.active.restore.$suffix"
  trap 'rm -f "${pending_tmp:-}" "${receipt_tmp:-}" "${pending_cursor_tmp:-}" "${ready_cursor_tmp:-}" "${previous_cursor_tmp:-}" "${staged_link:-}" "${restore_link:-}"; trap - RETURN' RETURN
  cp "$GENERATION_CURSOR" "$previous_cursor_tmp" || return 1
  jq -n --arg install_root "$INSTALL_ROOT" --arg restored_release "$previous_release" \
    --arg artifact_sha256 "$previous_sha" --arg chain_cursor "$GENERATION_CURSOR" \
    --arg previous_head_receipt "$receipt" --arg previous_head_sha256 "$receipt_sha" --argjson sequence "$sequence" \
    '{schema:"hepta_vnext_generation_pointer_rollback_v1",status:"ready",install_root:$install_root,sequence:$sequence,chain_cursor:$chain_cursor,chain_head_commit_required:true,previous_chain_head:{receipt:$previous_head_receipt,sha256:$previous_head_sha256},restored_release:$restored_release,artifact_sha256:$artifact_sha256,cas_verified:true,single_atomic_pointer:true,service_restarted:false}' >"$receipt_tmp" || return 1
  ready_receipt_sha="$(sha256_file "$receipt_tmp")"
  jq -n --arg install_root "$INSTALL_ROOT" --arg chain_cursor "$GENERATION_CURSOR" \
    --arg source_release "$deployed_release" --arg source_sha "$deployed_sha" --arg source_manifest_sha "$deployed_manifest_sha" \
    --arg target_release "$previous_release" --arg target_sha "$previous_sha" --arg target_manifest_sha "$previous_manifest_sha" \
    --arg previous_head_path "$receipt" --arg previous_head_sha "$receipt_sha" --arg ready_receipt_sha "$ready_receipt_sha" \
    --argjson previous_sequence "$previous_sequence" --argjson sequence "$sequence" \
    '{schema:"hepta_vnext_generation_pointer_pending_v1",status:"pending",operation:"rollback",install_root:$install_root,sequence:$sequence,chain_cursor:$chain_cursor,previous_chain:{sequence:$previous_sequence,head_receipt:$previous_head_path,head_receipt_sha256:$previous_head_sha},source:{release:$source_release,artifact_sha256:$source_sha,manifest_sha256:$source_manifest_sha},target:{release:$target_release,artifact_sha256:$target_sha,manifest_sha256:$target_manifest_sha},ready_receipt_sha256:$ready_receipt_sha,changed:false}' >"$pending_tmp" || return 1
  reserve_private_receipt "$output_receipt" "$pending_tmp" || return 1
  output_receipt="$(canonical_file "$output_receipt")" || return 1
  pending_sha="$(sha256_file "$output_receipt")"
  jq -n --arg install_root "$INSTALL_ROOT" --arg operation rollback \
    --arg source_release "$deployed_release" --arg source_sha "$deployed_sha" --arg source_manifest_sha "$deployed_manifest_sha" \
    --arg target_release "$previous_release" --arg target_sha "$previous_sha" --arg target_manifest_sha "$previous_manifest_sha" \
    --arg pending_receipt "$output_receipt" --arg pending_receipt_sha "$pending_sha" --arg ready_receipt_sha "$ready_receipt_sha" \
    --arg previous_head_path "$receipt" --arg previous_head_sha "$receipt_sha" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson previous_sequence "$previous_sequence" --argjson sequence "$sequence" \
    '{schema:"hepta_vnext_generation_chain_pending_v1",status:"pending",install_root:$install_root,sequence:$sequence,operation:$operation,source:{release:$source_release,artifact_sha256:$source_sha,manifest_sha256:$source_manifest_sha},target:{release:$target_release,artifact_sha256:$target_sha,manifest_sha256:$target_manifest_sha},pending_receipt:$pending_receipt,pending_receipt_sha256:$pending_receipt_sha,ready_receipt_sha256:$ready_receipt_sha,previous_chain:{sequence:$previous_sequence,head_receipt:$previous_head_path,head_receipt_sha256:$previous_head_sha},created_at:$created_at}' >"$pending_cursor_tmp" || return 1
  jq -n --arg install_root "$INSTALL_ROOT" --arg release "$previous_release" \
    --arg artifact_sha256 "$previous_sha" --arg manifest_sha256 "$previous_manifest_sha" \
    --arg head_receipt "$output_receipt" --arg head_receipt_sha256 "$ready_receipt_sha" \
    --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson sequence "$sequence" \
    '{schema:"hepta_vnext_generation_chain_v1",status:"ready",install_root:$install_root,sequence:$sequence,current:{release:$release,artifact_sha256:$artifact_sha256,manifest_sha256:$manifest_sha256},head_receipt:$head_receipt,head_receipt_sha256:$head_receipt_sha256,updated_at:$updated_at}' >"$ready_cursor_tmp" || return 1
  ln -s "$previous_release" "$staged_link" || return 1
  ln -s "$deployed_release" "$restore_link" || return 1
  [[ "$(sha256_file "$staged_link/bin/hepta")" == "$previous_sha" ]] || {
    echo "staged rollback artifact differs from receipt" >&2
    return 1
  }
  if [[ "${HEPTA_GENERATION_SELF_TEST_CRASH_AFTER:-}" == pending-receipt ]]; then
    echo "injected crash after pending rollback receipt reservation" >&2
    return 90
  fi
  if ! write_generation_cursor_cas "$GENERATION_CURSOR" "$previous_cursor_sha" "$pending_cursor_tmp"; then
    echo "generation rollback pending-chain reservation failed; active generation was not changed" >&2
    return 1
  fi
  pending_cursor_sha="$(sha256_file "$pending_cursor_tmp")"
  if [[ "${HEPTA_GENERATION_SELF_TEST_CRASH_AFTER:-}" == pending-cursor ]]; then
    echo "injected crash after pending rollback cursor" >&2
    return 91
  fi
  if ! mv -fh "$staged_link" "$ACTIVE_LINK" || ! verify_layout_raw "$install_root" "$previous_release/manifest.json" >/dev/null; then
    echo "generation rollback failed; restoring the deployed active release" >&2
    restore_generation_source "$install_root" "$deployed_release" "$deployed_release/manifest.json" "$pending_cursor_sha" "$previous_cursor_tmp" || return 1
    return 1
  fi
  if [[ "${HEPTA_GENERATION_SELF_TEST_CRASH_AFTER:-}" == active-pointer ]]; then
    echo "injected crash after rollback generation pointer" >&2
    return 92
  fi
  if ! write_generation_cursor_cas "$GENERATION_CURSOR" "$pending_cursor_sha" "$ready_cursor_tmp"; then
    echo "generation rollback chain finalization failed; restoring the deployed active release" >&2
    restore_generation_source "$install_root" "$deployed_release" "$deployed_release/manifest.json" "$pending_cursor_sha" "$previous_cursor_tmp" || return 1
    return 1
  fi
  ready_cursor_sha="$(sha256_file "$ready_cursor_tmp")"
  if [[ "${HEPTA_GENERATION_SELF_TEST_CRASH_AFTER:-}" == ready-cursor ]]; then
    echo "injected crash after ready rollback cursor" >&2
    return 93
  fi
  if ! replace_reserved_receipt "$output_receipt" "$pending_sha" "$receipt_tmp"; then
    echo "generation rollback receipt finalization failed; restoring pointer and previous chain cursor" >&2
    restore_generation_source "$install_root" "$deployed_release" "$deployed_release/manifest.json" "$ready_cursor_sha" "$previous_cursor_tmp" || return 1
    return 1
  fi
  trap - RETURN
  rm -f "$pending_tmp" "$receipt_tmp" "$pending_cursor_tmp" "$ready_cursor_tmp" "$previous_cursor_tmp" "$staged_link" "$restore_link" || true
  cat "$output_receipt"
}

recover_pending_layout() {
  local pending_receipt="$1" pending_sha install_root operation sequence previous_sequence chain_cursor
  local source_release source_sha source_manifest_sha target_release target_sha target_manifest_sha
  local previous_head_path previous_head_sha ready_receipt_sha active_release cursor_sha cursor_mode
  local source_manifest target_manifest temp_root previous_cursor_tmp recovery_tmp suffix staged_link
  [[ -f "$pending_receipt" && ! -L "$pending_receipt" ]] || {
    echo "pending generation receipt must be a regular non-symlink file" >&2
    return 1
  }
  pending_receipt="$(canonical_file "$pending_receipt")" || return 1
  pending_sha="$(sha256_file "$pending_receipt")"
  jq -e '
    .schema == "hepta_vnext_generation_pointer_pending_v1"
    and .status == "pending"
    and (.operation == "cutover" or .operation == "rollback")
    and (.install_root | startswith("/"))
    and (.chain_cursor | startswith("/"))
    and (.sequence | type == "number" and . >= 1 and . == floor)
    and (.previous_chain.sequence | type == "number" and . >= 0 and . == floor)
    and .sequence == (.previous_chain.sequence + 1)
    and (.source.release | startswith("/"))
    and (.source.artifact_sha256 | test("^[0-9a-f]{64}$"))
    and (.source.manifest_sha256 | test("^[0-9a-f]{64}$"))
    and (.target.release | startswith("/"))
    and (.target.artifact_sha256 | test("^[0-9a-f]{64}$"))
    and (.target.manifest_sha256 | test("^[0-9a-f]{64}$"))
    and (.ready_receipt_sha256 | test("^[0-9a-f]{64}$"))
    and .source.release != .target.release
    and .source.artifact_sha256 != .target.artifact_sha256
    and .changed == false
    and (if .previous_chain.sequence == 0 then
      .previous_chain.head_receipt == null and .previous_chain.head_receipt_sha256 == null
    else
      (.previous_chain.head_receipt | startswith("/"))
      and (.previous_chain.head_receipt_sha256 | test("^[0-9a-f]{64}$"))
    end)
  ' "$pending_receipt" >/dev/null || {
    echo "invalid pending generation receipt" >&2
    return 1
  }
  install_root="$(jq -r '.install_root' "$pending_receipt")"
  operation="$(jq -r '.operation' "$pending_receipt")"
  sequence="$(jq -r '.sequence' "$pending_receipt")"
  previous_sequence="$(jq -r '.previous_chain.sequence' "$pending_receipt")"
  chain_cursor="$(jq -r '.chain_cursor' "$pending_receipt")"
  source_release="$(jq -r '.source.release' "$pending_receipt")"
  source_sha="$(jq -r '.source.artifact_sha256' "$pending_receipt")"
  source_manifest_sha="$(jq -r '.source.manifest_sha256' "$pending_receipt")"
  target_release="$(jq -r '.target.release' "$pending_receipt")"
  target_sha="$(jq -r '.target.artifact_sha256' "$pending_receipt")"
  target_manifest_sha="$(jq -r '.target.manifest_sha256' "$pending_receipt")"
  previous_head_path="$(jq -r '.previous_chain.head_receipt // ""' "$pending_receipt")"
  previous_head_sha="$(jq -r '.previous_chain.head_receipt_sha256 // ""' "$pending_receipt")"
  ready_receipt_sha="$(jq -r '.ready_receipt_sha256' "$pending_receipt")"
  absolute_non_root "$install_root" || return 1
  layout "$install_root"
  [[ "$chain_cursor" == "$GENERATION_CURSOR" ]] || {
    echo "pending receipt names another generation chain cursor" >&2
    return 1
  }
  [[ -f "$GENERATION_CURSOR" && ! -L "$GENERATION_CURSOR" ]] || {
    echo "recoverable generation chain cursor is missing" >&2
    return 1
  }
  source_manifest="$source_release/manifest.json"
  target_manifest="$target_release/manifest.json"
  [[ "$(canonical_file "$source_release")" == "$source_release" \
    && "$(canonical_file "$target_release")" == "$target_release" \
    && "$(canonical_file "$source_manifest")" == "$source_manifest" \
    && "$(canonical_file "$target_manifest")" == "$target_manifest" ]] || {
    echo "pending generation release paths are no longer canonical" >&2
    return 1
  }
  verify_manifest_self "$source_manifest" || return 1
  verify_manifest_self "$target_manifest" || return 1
  [[ "$(jq -r '.runtime.install_root' "$source_manifest")" == "$install_root" \
    && "$(jq -r '.runtime.install_root' "$target_manifest")" == "$install_root" \
    && "$(sha256_file "$source_manifest")" == "$source_manifest_sha" \
    && "$(sha256_file "$target_manifest")" == "$target_manifest_sha" \
    && "$(sha256_file "$source_release/bin/hepta")" == "$source_sha" \
    && "$(sha256_file "$target_release/bin/hepta")" == "$target_sha" ]] || {
    echo "pending generation evidence changed before recovery" >&2
    return 1
  }
  if (( previous_sequence > 0 )); then
    [[ -f "$previous_head_path" && ! -L "$previous_head_path" \
      && "$(canonical_file "$previous_head_path")" == "$previous_head_path" \
      && "$(sha256_file "$previous_head_path")" == "$previous_head_sha" ]] || {
      echo "previous generation chain head changed before recovery" >&2
      return 1
    }
  fi
  active_release="$(canonical_file "$ACTIVE_LINK")" || return 1
  if [[ "$active_release" == "$source_release" ]]; then
    verify_layout_raw "$install_root" "$source_manifest" >/dev/null || return 1
  elif [[ "$active_release" == "$target_release" ]]; then
    verify_layout_raw "$install_root" "$target_manifest" >/dev/null || return 1
  else
    echo "pending recovery found an unreviewed active generation" >&2
    return 1
  fi
  if jq -e --arg install_root "$install_root" --arg source_release "$source_release" \
    --arg source_sha "$source_sha" --arg source_manifest_sha "$source_manifest_sha" \
    --arg previous_head_path "$previous_head_path" --arg previous_head_sha "$previous_head_sha" \
    --argjson previous_sequence "$previous_sequence" '
      .schema == "hepta_vnext_generation_chain_v1" and .status == "ready"
      and .install_root == $install_root and .sequence == $previous_sequence
      and .current == {release:$source_release,artifact_sha256:$source_sha,manifest_sha256:$source_manifest_sha}
      and ((.head_receipt // "") == $previous_head_path)
      and ((.head_receipt_sha256 // "") == $previous_head_sha)
    ' "$GENERATION_CURSOR" >/dev/null; then
    cursor_mode=previous
  elif jq -e --arg install_root "$install_root" --arg operation "$operation" \
    --arg source_release "$source_release" --arg source_sha "$source_sha" --arg source_manifest_sha "$source_manifest_sha" \
    --arg target_release "$target_release" --arg target_sha "$target_sha" --arg target_manifest_sha "$target_manifest_sha" \
    --arg pending_receipt "$pending_receipt" --arg pending_sha "$pending_sha" --arg ready_receipt_sha "$ready_receipt_sha" \
    --arg previous_head_path "$previous_head_path" --arg previous_head_sha "$previous_head_sha" \
    --argjson sequence "$sequence" --argjson previous_sequence "$previous_sequence" '
      .schema == "hepta_vnext_generation_chain_pending_v1" and .status == "pending"
      and .install_root == $install_root and .sequence == $sequence and .operation == $operation
      and .source == {release:$source_release,artifact_sha256:$source_sha,manifest_sha256:$source_manifest_sha}
      and .target == {release:$target_release,artifact_sha256:$target_sha,manifest_sha256:$target_manifest_sha}
      and .pending_receipt == $pending_receipt and .pending_receipt_sha256 == $pending_sha
      and .ready_receipt_sha256 == $ready_receipt_sha
      and .previous_chain.sequence == $previous_sequence
      and ((.previous_chain.head_receipt // "") == $previous_head_path)
      and ((.previous_chain.head_receipt_sha256 // "") == $previous_head_sha)
    ' "$GENERATION_CURSOR" >/dev/null; then
    cursor_mode=pending
  elif jq -e --arg install_root "$install_root" --arg target_release "$target_release" \
    --arg target_sha "$target_sha" --arg target_manifest_sha "$target_manifest_sha" \
    --arg pending_receipt "$pending_receipt" --arg ready_receipt_sha "$ready_receipt_sha" --argjson sequence "$sequence" '
      .schema == "hepta_vnext_generation_chain_v1" and .status == "ready"
      and .install_root == $install_root and .sequence == $sequence
      and .current == {release:$target_release,artifact_sha256:$target_sha,manifest_sha256:$target_manifest_sha}
      and .head_receipt == $pending_receipt and .head_receipt_sha256 == $ready_receipt_sha
    ' "$GENERATION_CURSOR" >/dev/null; then
    cursor_mode=target
  else
    echo "pending receipt is not the recoverable generation chain operation" >&2
    return 1
  fi
  cursor_sha="$(sha256_file "$GENERATION_CURSOR")"
  [[ "$(sha256_file "$pending_receipt")" == "$pending_sha" ]] || {
    echo "pending generation receipt changed before recovery" >&2
    return 1
  }
  temp_root="${TMPDIR:-/tmp}"
  previous_cursor_tmp="$(mktemp "${temp_root%/}/hepta-generation-chain-recovery.XXXXXX")" || return 1
  recovery_tmp="$(mktemp "${temp_root%/}/hepta-generation-recovery-receipt.XXXXXX")" || return 1
  suffix="$$.$RANDOM"
  staged_link="$INSTALL_ROOT/.active.recovery.$suffix"
  trap 'rm -f "${previous_cursor_tmp:-}" "${recovery_tmp:-}" "${staged_link:-}"; trap - RETURN' RETURN
  jq -n --arg install_root "$install_root" --arg release "$source_release" \
    --arg artifact_sha256 "$source_sha" --arg manifest_sha256 "$source_manifest_sha" \
    --arg head_receipt "$previous_head_path" --arg head_receipt_sha256 "$previous_head_sha" \
    --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson sequence "$previous_sequence" \
    '{schema:"hepta_vnext_generation_chain_v1",status:"ready",install_root:$install_root,sequence:$sequence,current:{release:$release,artifact_sha256:$artifact_sha256,manifest_sha256:$manifest_sha256},head_receipt:(if $head_receipt=="" then null else $head_receipt end),head_receipt_sha256:(if $head_receipt_sha256=="" then null else $head_receipt_sha256 end),updated_at:$updated_at}' >"$previous_cursor_tmp" || return 1
  ln -s "$source_release" "$staged_link" || return 1
  mv -fh "$staged_link" "$ACTIVE_LINK" || { rm -f "$staged_link"; return 1; }
  verify_layout_raw "$install_root" "$source_manifest" >/dev/null || return 1
  if [[ "$cursor_mode" != previous ]]; then
    write_generation_cursor_cas "$GENERATION_CURSOR" "$cursor_sha" "$previous_cursor_tmp" || return 1
  fi
  verify_layout "$install_root" "$source_manifest" >/dev/null || return 1
  jq -n --arg operation "$operation" --arg install_root "$install_root" \
    --arg pending_receipt_sha256 "$pending_sha" --arg restored_release "$source_release" \
    --arg restored_artifact_sha256 "$source_sha" --arg previous_head_path "$previous_head_path" \
    --arg previous_head_sha "$previous_head_sha" --arg recovered_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson sequence "$sequence" --argjson restored_sequence "$previous_sequence" \
    '{schema:"hepta_vnext_generation_pointer_pending_recovery_v1",status:"ready",operation:$operation,install_root:$install_root,aborted_sequence:$sequence,pending_receipt_sha256:$pending_receipt_sha256,restored:{release:$restored_release,artifact_sha256:$restored_artifact_sha256,sequence:$restored_sequence,head_receipt:(if $previous_head_path=="" then null else $previous_head_path end),head_receipt_sha256:(if $previous_head_sha=="" then null else $previous_head_sha end)},recovered_at:$recovered_at,active_generation_restored:true,chain_head_restored:true,no_transition_pass_published:true,service_restarted:false}' >"$recovery_tmp" || return 1
  replace_reserved_receipt "$pending_receipt" "$pending_sha" "$recovery_tmp" || return 1
  trap - RETURN
  rm -f "$previous_cursor_tmp" "$recovery_tmp" "$staged_link" || true
  cat "$pending_receipt"
}

self_test_binary() {
  local destination="$1" fallback_exit="$2"
  local contract='{"authority":{"automatic_transition":false,"enforce":false,"model_invocation":false,"operator_mutation":false,"outbound":false,"promotion":false,"retirement":false,"telegram":false},"protocol_version":1,"routes":["GET /","GET /api/hepta/runtime","GET /healthz"],"runtime":{"keyed_integrity_required":true,"loopback_only":true,"open_mode":"immutable-query-only-open-existing","read_only":true,"requires_empty_wal":true,"schema_version":5},"schema":"hepta_vnext_live_shell_contract_v1","status":"ready"}'
  # The single-quoted literals are emitted into the fixture.
  # shellcheck disable=SC2016
  printf '%s\n' '#!/bin/sh' \
    'if [ "$#" -eq 1 ] && [ "$1" = "--hepta-vnext-live-shell-contract-v1" ]; then' \
    "  printf '%s\\n' '$contract'" \
    '  exit 0' \
    'fi' \
    "exit $fallback_exit" >"$destination"
  chmod 0500 "$destination"
}

self_test() {
  local root release_a release_b release_wrong materializer install_root sha_a sha_b receipt rollback_receipt temp_root binary_a binary_b wrong_receipt finalize_receipt rollback_finalize_receipt source_commit
  local cursor_failure_receipt crash_receipt crash_phase second_cutover_receipt stale_rollback_receipt second_rollback_receipt first_recovery_receipt
  temp_root="${TMPDIR:-/tmp}"
  root="$(mktemp -d "${temp_root%/}/hepta-generation-self-test.XXXXXX")"
  HEPTA_GENERATION_SELF_TEST_ROOT="$root"
  trap 'chmod -R u+w "$HEPTA_GENERATION_SELF_TEST_ROOT" 2>/dev/null || true; rm -rf "$HEPTA_GENERATION_SELF_TEST_ROOT"' EXIT
  release_a="$root/release-a"
  release_b="$root/release-b"
  install_root="$root/install"
  binary_a="$root/hepta-a"; binary_b="$root/hepta-b"
  self_test_binary "$binary_a" 0
  self_test_binary "$binary_b" 1
  materializer="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/hepta-immutable-release-tree"
  source_commit="$(git -C "$(dirname "${BASH_SOURCE[0]}")/.." rev-parse --verify 'HEAD^{commit}')"
  "$materializer" materialize --binary "$binary_a" --destination "$release_a" \
    --state-root "$root/state-a" --install-root "$install_root" \
    --gateway-label ai.hepta.selftest.a --watchdog-label ai.hepta.selftest.a.watchdog \
    --listen-port 17373 --source-commit "$source_commit" >/dev/null
  "$materializer" materialize --binary "$binary_b" --destination "$release_b" \
    --state-root "$root/state-b" --install-root "$install_root" \
    --gateway-label ai.hepta.selftest.b --watchdog-label ai.hepta.selftest.b.watchdog \
    --listen-port 17374 --source-commit "$source_commit" >/dev/null
  release_wrong="$root/release-wrong-root"
  "$materializer" materialize --binary "$binary_b" --destination "$release_wrong" \
    --state-root "$root/state-wrong" --install-root "$root/other-install" \
    --gateway-label ai.hepta.selftest.wrong --watchdog-label ai.hepta.selftest.wrong.watchdog \
    --listen-port 17375 --source-commit "$source_commit" >/dev/null
  initialize_layout "$install_root" "$release_a/manifest.json" >/dev/null
  if verify_layout "$install_root" "$release_b/manifest.json" >/dev/null 2>&1; then
    echo "active generation was accepted against a different manifest" >&2
    exit 1
  fi
  sha_a="$(sha256_file "$install_root/bin/hepta")"
  wrong_receipt="$root/wrong-root.json"
  if cutover_layout "$install_root" "$release_wrong/manifest.json" "$sha_a" "$wrong_receipt" >/dev/null 2>&1; then
    echo "generation accepted a target manifest for another install root" >&2
    exit 1
  fi
  [[ "$(sha256_file "$install_root/bin/hepta")" == "$sha_a" && ! -e "$wrong_receipt" ]] || {
    echo "wrong-root preflight changed the active generation or reserved a receipt" >&2
    exit 1
  }
  finalize_receipt="$root/finalize-failure.json"
  if HEPTA_GENERATION_SELF_TEST_FAIL_FINALIZE=1 \
    cutover_layout "$install_root" "$release_b/manifest.json" "$sha_a" "$finalize_receipt" >/dev/null 2>&1; then
    echo "injected finalization failure unexpectedly passed" >&2
    exit 1
  fi
  [[ "$(sha256_file "$install_root/bin/hepta")" == "$sha_a" ]] || {
    echo "finalization failure did not restore the previous generation" >&2
    exit 1
  }
  jq -e '.schema == "hepta_vnext_generation_pointer_pending_v1" and .status == "pending"' "$finalize_receipt" >/dev/null
  recover_pending_layout "$finalize_receipt" >/dev/null
  jq -e '.schema == "hepta_vnext_generation_pointer_pending_recovery_v1" and .no_transition_pass_published == true' "$finalize_receipt" >/dev/null
  verify_layout "$install_root" "$release_a/manifest.json" >/dev/null
  first_recovery_receipt="$finalize_receipt"
  cursor_failure_receipt="$root/cursor-failure.json"
  if HEPTA_GENERATION_SELF_TEST_FAIL_CURSOR=1 \
    cutover_layout "$install_root" "$release_b/manifest.json" "$sha_a" "$cursor_failure_receipt" >/dev/null 2>&1; then
    echo "injected pending cursor failure unexpectedly passed" >&2
    exit 1
  fi
  recover_pending_layout "$cursor_failure_receipt" >/dev/null
  verify_layout "$install_root" "$release_a/manifest.json" >/dev/null
  for crash_phase in pending-receipt pending-cursor active-pointer ready-cursor; do
    crash_receipt="$root/cutover-crash-$crash_phase.json"
    if HEPTA_GENERATION_SELF_TEST_CRASH_AFTER="$crash_phase" \
      cutover_layout "$install_root" "$release_b/manifest.json" "$sha_a" "$crash_receipt" >/dev/null 2>&1; then
      echo "injected cutover crash unexpectedly passed at $crash_phase" >&2
      exit 1
    fi
    jq -e '.schema == "hepta_vnext_generation_pointer_pending_v1" and .status == "pending" and .operation == "cutover"' "$crash_receipt" >/dev/null
    recover_pending_layout "$crash_receipt" >/dev/null
    verify_layout "$install_root" "$release_a/manifest.json" >/dev/null
    jq -e '.schema == "hepta_vnext_generation_pointer_pending_recovery_v1" and .active_generation_restored == true and .chain_head_restored == true and .no_transition_pass_published == true' "$crash_receipt" >/dev/null
  done
  receipt="$root/cutover.json"
  cutover_layout "$install_root" "$release_b/manifest.json" "$sha_a" "$receipt" >/dev/null
  sha_b="$(sha256_file "$install_root/bin/hepta")"
  [[ "$sha_a" != "$sha_b" ]] || { echo "self-test artifacts must differ" >&2; exit 1; }
  rollback_finalize_receipt="$root/rollback-finalize-failure.json"
  if HEPTA_GENERATION_SELF_TEST_FAIL_FINALIZE=1 \
    rollback_layout "$receipt" "$sha_b" "$rollback_finalize_receipt" >/dev/null 2>&1; then
    echo "injected rollback finalization failure unexpectedly passed" >&2
    exit 1
  fi
  [[ "$(sha256_file "$install_root/bin/hepta")" == "$sha_b" ]] || {
    echo "rollback finalization failure did not restore the deployed generation" >&2
    exit 1
  }
  jq -e '.schema == "hepta_vnext_generation_pointer_pending_v1" and .status == "pending" and .operation == "rollback"' "$rollback_finalize_receipt" >/dev/null
  recover_pending_layout "$rollback_finalize_receipt" >/dev/null
  verify_layout "$install_root" "$release_b/manifest.json" >/dev/null
  for crash_phase in pending-receipt pending-cursor active-pointer ready-cursor; do
    crash_receipt="$root/rollback-crash-$crash_phase.json"
    if HEPTA_GENERATION_SELF_TEST_CRASH_AFTER="$crash_phase" \
      rollback_layout "$receipt" "$sha_b" "$crash_receipt" >/dev/null 2>&1; then
      echo "injected rollback crash unexpectedly passed at $crash_phase" >&2
      exit 1
    fi
    jq -e '.schema == "hepta_vnext_generation_pointer_pending_v1" and .status == "pending" and .operation == "rollback"' "$crash_receipt" >/dev/null
    recover_pending_layout "$crash_receipt" >/dev/null
    verify_layout "$install_root" "$release_b/manifest.json" >/dev/null
  done
  rollback_receipt="$root/rollback.json"
  rollback_layout "$receipt" "$sha_b" "$rollback_receipt" >/dev/null
  [[ "$(sha256_file "$install_root/bin/hepta")" == "$sha_a" ]] || {
    echo "generation rollback did not restore release A" >&2
    exit 1
  }
  second_cutover_receipt="$root/second-cutover.json"
  cutover_layout "$install_root" "$release_b/manifest.json" "$sha_a" "$second_cutover_receipt" >/dev/null
  stale_rollback_receipt="$root/stale-rollback.json"
  if rollback_layout "$receipt" "$sha_b" "$stale_rollback_receipt" >/dev/null 2>&1; then
    echo "generation accepted a stale cutover receipt as the current chain head" >&2
    exit 1
  fi
  [[ ! -e "$stale_rollback_receipt" ]] || {
    echo "stale rollback reserved an output receipt" >&2
    exit 1
  }
  verify_layout "$install_root" "$release_b/manifest.json" >/dev/null
  if rollback_layout "$first_recovery_receipt" "$sha_b" "$stale_rollback_receipt" >/dev/null 2>&1; then
    echo "generation accepted a recovery receipt as a transition PASS" >&2
    exit 1
  fi
  second_rollback_receipt="$root/second-rollback.json"
  rollback_layout "$second_cutover_receipt" "$sha_b" "$second_rollback_receipt" >/dev/null
  verify_layout "$install_root" "$release_a/manifest.json" >/dev/null
  [[ "$(jq -r '.sequence' "$install_root/.generation-chain.json")" == 4 \
    && "$(jq -r '.head_receipt' "$install_root/.generation-chain.json")" == "$second_rollback_receipt" \
    && "$(jq -r '.head_receipt_sha256' "$install_root/.generation-chain.json")" == "$(sha256_file "$second_rollback_receipt")" ]] || {
    echo "generation chain sequence or final head is not monotonic" >&2
    exit 1
  }
  jq -cn '{schema:"hepta_vnext_generation_pointer_self_test_v1",status:"ready",cutover:true,rollback:true,manifest_mismatch_rejected:true,target_install_root_mismatch_rejected:true,receipt_finalization_restored:true,rollback_finalization_restored:true,pending_cursor_recoverable:true,active_pointer_crash_recoverable:true,ready_cursor_crash_recoverable:true,recovery_receipt_not_transition_pass:true,stale_chain_head_rejected:true,chain_monotonic:true,stale_cas_closed:true,service_restarted:false}'
}

command="${1:-}"
[[ -n "$command" ]] || usage
shift
install_root=""; manifest=""; receipt=""; output_receipt=""; expected_current_sha=""
while (( $# > 0 )); do
  case "$1" in
    --install-root) shift; [[ $# -gt 0 ]] || usage; install_root="$1" ;;
    --manifest) shift; [[ $# -gt 0 ]] || usage; manifest="$1" ;;
    --receipt) shift; [[ $# -gt 0 ]] || usage; receipt="$1" ;;
    --output-receipt) shift; [[ $# -gt 0 ]] || usage; output_receipt="$1" ;;
    --expected-current-sha256) shift; [[ $# -gt 0 ]] || usage; expected_current_sha="$1" ;;
    *) usage ;;
  esac
  shift
done
case "$command" in
  initialize) [[ -n "$install_root" && -n "$manifest" && -z "$receipt$output_receipt$expected_current_sha" ]] || usage; with_generation_lock "$install_root" initialize_layout "$install_root" "$manifest" ;;
  verify) [[ -n "$install_root" && -z "$receipt$output_receipt$expected_current_sha" ]] || usage; verify_layout "$install_root" "$manifest" ;;
  cutover) [[ -n "$install_root" && -n "$manifest" && -n "$expected_current_sha" && -n "$output_receipt" && -z "$receipt" ]] || usage; with_generation_lock "$install_root" cutover_layout "$install_root" "$manifest" "$expected_current_sha" "$output_receipt" ;;
  rollback) [[ -n "$receipt" && -n "$expected_current_sha" && -n "$output_receipt" && -z "$install_root$manifest" ]] || usage; rollback_install_root="$(jq -er '.install_root' "$receipt")"; with_generation_lock "$rollback_install_root" rollback_layout "$receipt" "$expected_current_sha" "$output_receipt" ;;
  recover-pending) [[ -n "$receipt" && -z "$install_root$manifest$output_receipt$expected_current_sha" ]] || usage; recovery_install_root="$(jq -er '.install_root' "$receipt")"; with_generation_lock "$recovery_install_root" recover_pending_layout "$receipt" ;;
  self-test) [[ -z "$install_root$manifest$receipt$output_receipt$expected_current_sha" ]] || usage; self_test ;;
  *) usage ;;
esac
