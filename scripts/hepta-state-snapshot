#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  hepta-state-snapshot --source-state-root DIR --destination-state-root DIR [--legacy-label LABEL] [--receipt PATH] [--predecessor-rollback-receipt PATH] [--writer-barrier-receipt PATH] [--materialize]
  hepta-state-snapshot verify --receipt PATH
  hepta-state-snapshot verify-source --receipt PATH
  hepta-state-snapshot self-test

The default is a read-only full-root v3 plan. --materialize requires the legacy
writer to have no open files anywhere under the state root, rejects every
nonempty WAL, copies every top-level entry into a new separate state root, and
writes a receipt after source identity and portable payload inventories agree.
Fresh recutover snapshots bind the exact applied rollback receipt, its plan SHA,
and sequence through --predecessor-rollback-receipt.
Every materialized production snapshot also requires a live writer-barrier
receipt. The barrier is reverified before copying and immediately before the
ready receipt is published.
The v3 mode profile permits regular files only at 0400, 0444, 0500, or 0600,
and directories only at 0700. Every other mode is rejected. Every original
mode is bound per path and must be preserved exactly.
Existing v1 and v2 receipts remain verifiable. The command never stops or
starts a service.
EOF
  exit 64
}

sha256_file() { shasum -a 256 "$1" | awk '{print $1}'; }
SNAPSHOT_PROFILE_V3=full-state-root-v3
MODE_PROFILE_V3=hepta_vnext_state_mode_profile_v3
ACL_PROFILE_V3=hepta_vnext_state_acl_profile_deny_only_v1

writer_barrier_self_test_exempt_v3() {
  local source_root="$1" legacy_label="$2" test_root="${HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT:-}"
  [[ "$legacy_label" == *.selftest \
    && -n "$test_root" && "$test_root" == /* && "$test_root" != / \
    && -d "$test_root" && ! -L "$test_root" \
    && "$(cd "$test_root" && pwd -P)" == "$test_root" \
    && "$source_root" == "$test_root/"* ]]
}

verify_writer_barrier_v3() {
  local barrier_receipt="$1" source_root="$2" legacy_label="$3" script_dir guard barrier_state barrier_label
  if [[ -z "$barrier_receipt" ]]; then
    writer_barrier_self_test_exempt_v3 "$source_root" "$legacy_label" || {
      echo "materialized production snapshot requires --writer-barrier-receipt" >&2
      return 1
    }
    return 0
  fi
  absolute_non_root "$barrier_receipt" || return 1
  barrier_receipt="$(realpath "$barrier_receipt")" || return 1
  [[ -f "$barrier_receipt" && ! -L "$barrier_receipt" ]] || return 1
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  guard="$script_dir/hepta-cutover-guard"
  [[ -f "$guard" && -x "$guard" && ! -L "$guard" ]] || return 1
  "$guard" verify-writer --receipt "$barrier_receipt" >/dev/null || return 1
  barrier_state="$(jq -r '.state_root // empty' "$barrier_receipt")"
  barrier_label="$(jq -r '.legacy_label // empty' "$barrier_receipt")"
  [[ "$barrier_state" == "$source_root" && "$barrier_label" == "$legacy_label" ]] || {
    echo "writer barrier subject does not match the snapshot source and label" >&2
    return 1
  }
}

fsync_paths() {
  local python3_bin
  python3_bin="$(command -v python3 2>/dev/null || true)"
  [[ -n "$python3_bin" && -x "$python3_bin" ]] || {
    echo "python3 is required for durable file and directory publication" >&2
    return 1
  }
  "$python3_bin" - "$@" <<'PY'
import os
import stat
import sys

for path in sys.argv[1:]:
    info = os.lstat(path)
    if stat.S_ISLNK(info.st_mode):
        raise SystemExit(f"refusing to fsync symlink: {path}")
    flags = os.O_RDONLY
    if stat.S_ISDIR(info.st_mode):
        flags |= getattr(os, "O_DIRECTORY", 0)
    descriptor = os.open(path, flags)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
PY
}

fsync_tree() {
  local tree_root="$1" item
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  while IFS= read -r -d '' item; do
    fsync_paths "$item" || return 1
  done < <(find "$tree_root" -type f -print0)
  while IFS= read -r -d '' item; do
    fsync_paths "$item" || return 1
  done < <(find -d "$tree_root" -type d -print0)
}

absolute_non_root() {
  [[ "$1" == /* \
    && "$1" != "/" \
    && "$1" != */ \
    && "$1" != *"//"* \
    && "$1" != *"/../"* \
    && "$1" != *"/./"* \
    && "$1" != */.. \
    && "$1" != */. ]] || {
    echo "path must be absolute, normalized, and non-root: $1" >&2
    return 1
  }
}

inventory_tree() {
  local tree_root="$1" output="$2"
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      [[ ! -L "$item" ]] || { echo "state snapshot rejects symlink: $item" >&2; exit 1; }
      if [[ -f "$item" ]]; then
        printf '%s|file|%s|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m|%c|%d|%i' "$item")" "$(sha256_file "$item")"
      elif [[ -d "$item" ]]; then
        printf '%s|directory|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m|%c|%d|%i' "$item")"
      else
        echo "state snapshot rejects special entry: $item" >&2
        exit 1
      fi
    done
  ) >"$output"
}

payload_inventory() {
  local tree_root="$1" output="$2"
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      if [[ -f "$item" ]]; then
        printf '%s|file|%s|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m' "$item")" "$(sha256_file "$item")"
      elif [[ -d "$item" ]]; then
        printf '%s|directory|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m' "$item")"
      fi
    done
  ) >"$output"
}

acl_sha256() {
  local item="$1"
  /bin/ls -lden "$item" | sed '1d' | shasum -a 256 | awk '{print $1}'
}

acl_inventory_v3() {
  local tree_root="$1" output="$2" item item_type acl_hash
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  validate_tree_names "$tree_root" || return 1
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      [[ ! -L "$item" ]] || return 1
      if [[ -f "$item" ]]; then item_type="file"
      elif [[ -d "$item" ]]; then item_type="directory"
      else return 1
      fi
      acl_hash="$(acl_sha256 "$item")" || exit 1
      printf '%s|%s|%s\n' "$item" "$item_type" "$acl_hash" || exit 1
    done
  ) >"$output"
}

validate_acl_profile_v3() {
  local tree_root="$1" item acl_lines
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  while IFS= read -r -d '' item; do
    acl_lines="$(/bin/ls -lden "$item" | sed '1d')" || return 1
    [[ -z "$acl_lines" ]] && continue
    if grep -Eq '[[:space:]]allow[[:space:]]' <<<"$acl_lines"; then
      echo "state snapshot ACL profile rejects every allow ACE: $item" >&2
      return 1
    fi
    if grep -Ev '^[[:space:]]*[0-9]+: .*([[:space:]])deny([[:space:]])' <<<"$acl_lines" | grep -q .; then
      echo "state snapshot ACL profile permits only explicit deny ACEs: $item" >&2
      return 1
    fi
  done < <(find "$tree_root" -print0)
}

xattr_sha256() {
  local item="$1" name names value_sha
  if ! names="$(/usr/bin/xattr "$item" 2>/dev/null)"; then
    echo "could not enumerate state snapshot xattrs: $item" >&2
    return 1
  fi
  if [[ -n "$names" ]]; then
    while IFS= read -r name; do
      [[ "$name" != *$'\r'* && "$name" != *'|'* ]] || {
        echo "state snapshot rejects carriage-return or pipe in xattr names" >&2
        return 1
      }
    done <<<"$names"
  fi
  {
    if [[ -n "$names" ]]; then
      printf '%s\n' "$names" | LC_ALL=C sort | while IFS= read -r name; do
        value_sha="$(/usr/bin/xattr -p "$name" "$item" | shasum -a 256 | awk '{print $1}')" || exit 1
        printf '%s|%s\n' "$name" "$value_sha" || exit 1
      done
    fi
  } | shasum -a 256 | awk '{print $1}'
}

# A source identity inventory intentionally includes APFS identity fields that
# must remain stable while the writer is stopped. It is never compared across
# the copy boundary.
identity_inventory_v2() {
  local tree_root="$1" output="$2" item metadata acl_hash xattr_hash content_sha
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  validate_tree_names "$tree_root" || return 1
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      [[ ! -L "$item" ]] || { echo "state snapshot rejects symlink: $item" >&2; exit 1; }
      if [[ -f "$item" ]]; then
        metadata="$(stat -f '%Lp|%u|%g|%z|%m|%c|%d|%i|%l|%f' "$item")" || exit 1
        acl_hash="$(acl_sha256 "$item")" || exit 1
        xattr_hash="$(xattr_sha256 "$item")" || exit 1
        content_sha="$(sha256_file "$item")" || exit 1
        printf '%s|file|%s|%s|%s|%s\n' "$item" "$metadata" "$acl_hash" "$xattr_hash" "$content_sha" || exit 1
      elif [[ -d "$item" ]]; then
        metadata="$(stat -f '%Lp|%u|%g|%m|%c|%d|%i|%f' "$item")" || exit 1
        acl_hash="$(acl_sha256 "$item")" || exit 1
        xattr_hash="$(xattr_sha256 "$item")" || exit 1
        printf '%s|directory|%s|%s|%s\n' "$item" "$metadata" "$acl_hash" "$xattr_hash" || exit 1
      else
        echo "state snapshot rejects special entry: $item" >&2
        exit 1
      fi
    done
  ) >"$output"
}

# A portable payload inventory excludes device/inode/ctime, but binds every
# byte and every property that must survive materialization. The link count is
# portable only after the separate hardlink topology inventory proves that all
# aliases are contained inside the state root.
portable_inventory_v2() {
  local tree_root="$1" output="$2" item metadata acl_hash xattr_hash content_sha
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  validate_tree_names "$tree_root" || return 1
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      [[ ! -L "$item" ]] || { echo "state snapshot rejects symlink: $item" >&2; exit 1; }
      if [[ -f "$item" ]]; then
        metadata="$(stat -f '%Lp|%u|%g|%z|%m|%l|%f' "$item")" || exit 1
        acl_hash="$(acl_sha256 "$item")" || exit 1
        xattr_hash="$(xattr_sha256 "$item")" || exit 1
        content_sha="$(sha256_file "$item")" || exit 1
        printf '%s|file|%s|%s|%s|%s\n' "$item" "$metadata" "$acl_hash" "$xattr_hash" "$content_sha" || exit 1
      elif [[ -d "$item" ]]; then
        metadata="$(stat -f '%Lp|%u|%g|%m|%f' "$item")" || exit 1
        acl_hash="$(acl_sha256 "$item")" || exit 1
        xattr_hash="$(xattr_sha256 "$item")" || exit 1
        printf '%s|directory|%s|%s|%s\n' "$item" "$metadata" "$acl_hash" "$xattr_hash" || exit 1
      else
        echo "state snapshot rejects special entry: $item" >&2
        exit 1
      fi
    done
  ) >"$output"
}

# v3 keeps the complete v2 portable metadata closure and adds a separately
# addressable per-node mode inventory. Keeping mode in both inventories makes
# it impossible to relax the admission policy into a lossy normalization step.
identity_inventory_v3() { identity_inventory_v2 "$@"; }
portable_inventory_v3() { portable_inventory_v2 "$@"; }

mode_inventory_v3() {
  local tree_root="$1" output="$2" item raw_mode mode_bits item_type
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  validate_tree_names "$tree_root" || return 1
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      [[ ! -L "$item" ]] || { echo "state snapshot rejects symlink: $item" >&2; exit 1; }
      if [[ -f "$item" ]]; then
        item_type="file"
      elif [[ -d "$item" ]]; then
        item_type="directory"
      else
        echo "state snapshot rejects special entry: $item" >&2
        exit 1
      fi
      raw_mode="$(stat -f '%p' "$item")" || exit 1
      mode_bits="$((8#$raw_mode & 07777))"
      printf '%s|%s|%04o\n' "$item" "$item_type" "$mode_bits"
    done
  ) >"$output"
}

# Bind hardlinks by a portable alias-group identity: the lexicographically
# first path in a device/inode group is the group primary. A file whose kernel
# link count exceeds the aliases visible below tree_root has an alias outside
# the snapshot boundary and is rejected fail-closed.
hardlink_topology_inventory_v2() {
  local tree_root="$1" output="$2" raw temp_root
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  validate_tree_names "$tree_root" || return 1
  temp_root="${TMPDIR:-/tmp}"
  raw="$(mktemp "${temp_root%/}/hepta-state-v2-hardlinks.XXXXXX")" || return 1
  if ! (
    cd "$tree_root"
    find . -type f -print | LC_ALL=C sort | while IFS= read -r item; do
      printf '%s|%s|%s|%s\n' \
        "$(stat -f '%d' "$item")" "$(stat -f '%i' "$item")" \
        "$(stat -f '%l' "$item")" "$item"
    done
  ) >"$raw"; then
    rm -f "$raw"
    return 1
  fi
  if ! awk -F '|' '
    {
      key = $1 SUBSEP $2
      rows += 1
      file[rows] = $4
      row_key[rows] = key
      observed[key] += 1
      if (!(key in primary)) {
        primary[key] = $4
        declared[key] = $3
      } else if (declared[key] != $3) {
        invalid = 1
      }
    }
    END {
      for (key in observed) {
        if (declared[key] != observed[key]) invalid = 1
      }
      if (invalid) exit 1
      for (row = 1; row <= rows; row++) {
        key = row_key[row]
        printf "%s|%s|%d\n", file[row], primary[key], observed[key]
      }
    }
  ' "$raw" >"$output"; then
    echo "state snapshot rejects hardlink aliases outside the full state root" >&2
    rm -f "$raw" "$output"
    return 1
  fi
  rm -f "$raw"
}

hardlink_topology_inventory_v3() { hardlink_topology_inventory_v2 "$@"; }

copy_full_tree_v2() {
  local source="$1" destination="$2"
  [[ -d "$source" && ! -L "$source" && ! -e "$destination" && ! -L "$destination" ]] || return 1
  mkdir "$destination" || return 1
  # macOS bsdtar preserves hardlinks, ACLs, xattrs, BSD flags, ownership,
  # modes, and mtimes. The portable and topology inventories below still
  # independently prove the exact result before it can be published.
  if ! (cd "$source" && /usr/bin/tar --acls --xattrs --fflags -cf - .) \
    | (cd "$destination" && /usr/bin/tar --acls --xattrs --fflags -xpf -); then
    return 1
  fi
  # bsdtar restores every archived child but leaves the already-created
  # extraction root with the extraction-time mtime. Bind that root too.
  /usr/bin/touch -r "$source" "$destination" || return 1
}

copy_full_tree_v3() { copy_full_tree_v2 "$@"; }

inventory_subset_sha256() {
  local inventory="$1" pattern="$2"
  awk -F '|' -v pattern="$pattern" '$1 ~ pattern { print }' "$inventory" | shasum -a 256 | awk '{print $1}'
}

top_level_inventory_sha256() {
  local inventory="$1"
  awk -F '|' '$1 != "." && $1 !~ /^\.\/[^\/]+\// { print }' "$inventory" | shasum -a 256 | awk '{print $1}'
}

validate_tree_names() {
  local tree_root="$1" item relative
  while IFS= read -r -d '' item; do
    relative="${item#"$tree_root"/}"
    [[ "$relative" != *$'\n'* && "$relative" != *$'\r'* && "$relative" != *'|'* ]] || {
      echo "state snapshot rejects newline, carriage-return, or pipe in paths" >&2
      return 1
    }
  done < <(find "$tree_root" -print0)
}

validate_source() {
  local source_runtime="$1" legacy_label="$2"
  [[ -d "$source_runtime" && ! -L "$source_runtime" ]] || {
    echo "source runtime-v2 is missing or unsafe" >&2
    return 1
  }
  validate_tree_names "$source_runtime" || return 1
  if find "$source_runtime" -type l -print -quit | grep -q .; then
    echo "source runtime-v2 contains a symlink" >&2
    return 1
  fi
  [[ "$legacy_label" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "invalid legacy launchd label: $legacy_label" >&2
    return 1
  }
  local launch_output
  if launch_output="$(/bin/launchctl print "gui/$(id -u)/$legacy_label" 2>&1)"; then
    echo "legacy launchd job is still loaded: $legacy_label" >&2
    return 1
  elif [[ "$launch_output" != *"Could not find service"* ]]; then
    echo "could not prove legacy launchd job is unloaded: $launch_output" >&2
    return 1
  fi
  if find "$source_runtime" -type f -name '*-wal' -size +0c -print -quit | grep -q .; then
    echo "source has a nonempty SQLite WAL; stop the writer and checkpoint a private copy first" >&2
    return 1
  fi
  while IFS= read -r item; do
    local mode
    mode="$(stat -f '%Lp' "$item")"
    if (( (8#$mode & 077) != 0 )); then
      echo "source state grants group/world permissions: $item" >&2
      return 1
    fi
  done < <(find "$source_runtime" -print)
  local lsof_output lsof_rc
  if lsof_output="$(lsof -nP +D "$source_runtime" 2>&1)"; then
    echo "legacy writer or reader still has runtime-v2 open; stop it before snapshotting" >&2
    return 1
  else
    lsof_rc=$?
    if [[ "$lsof_rc" -ne 1 || -n "$lsof_output" ]]; then
      echo "could not prove runtime-v2 has no open files: $lsof_output" >&2
      return 1
    fi
  fi
}

validate_full_tree_v2() {
  local tree_root="$1" require_quiescent="$2" legacy_label="$3" launch_output item mode hardlinks temp_root
  [[ -d "$tree_root" && ! -L "$tree_root" && -d "$tree_root/runtime-v2" && ! -L "$tree_root/runtime-v2" ]] || {
    echo "full state root or required runtime-v2 payload is missing or unsafe" >&2
    return 1
  }
  [[ "$(cd "$tree_root" && pwd -P)" == "$tree_root" ]] || {
    echo "full state root must be a physical canonical directory" >&2
    return 1
  }
  validate_tree_names "$tree_root" || return 1
  if find "$tree_root" -type l -print -quit | grep -q .; then
    echo "full state root contains a symlink" >&2
    return 1
  fi
  if find "$tree_root" ! -type f ! -type d -print -quit | grep -q .; then
    echo "full state root contains a special filesystem entry" >&2
    return 1
  fi
  if find "$tree_root" -type f -name '*-wal' -size +0c -print -quit | grep -q .; then
    echo "full state root contains a nonempty SQLite WAL" >&2
    return 1
  fi
  while IFS= read -r item; do
    mode="$(stat -f '%Lp' "$item")"
    (( (8#$mode & 077) == 0 )) || {
      echo "full state root grants group/world permissions: $item" >&2
      return 1
    }
  done < <(find "$tree_root" -print)
  temp_root="${TMPDIR:-/tmp}"
  hardlinks="$(mktemp "${temp_root%/}/hepta-state-v2-hardlink-validation.XXXXXX")" || return 1
  if ! hardlink_topology_inventory_v2 "$tree_root" "$hardlinks"; then
    rm -f "$hardlinks"
    return 1
  fi
  rm -f "$hardlinks"
  [[ "$require_quiescent" == true ]] || return 0
  [[ "$legacy_label" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "invalid legacy launchd label: $legacy_label" >&2
    return 1
  }
  if launch_output="$(/bin/launchctl print "gui/$(id -u)/$legacy_label" 2>&1)"; then
    echo "legacy launchd job is still loaded: $legacy_label" >&2
    return 1
  elif [[ "$launch_output" != *"Could not find service"* ]]; then
    echo "could not prove legacy launchd job is unloaded: $launch_output" >&2
    return 1
  fi
  local lsof_output lsof_rc
  if lsof_output="$(lsof -nP +D "$tree_root" 2>&1)"; then
    echo "legacy writer or reader still has the full state root open; stop it before snapshotting" >&2
    return 1
  else
    lsof_rc=$?
    if [[ "$lsof_rc" -ne 1 || -n "$lsof_output" ]]; then
      echo "could not prove the full state root has no open files: $lsof_output" >&2
      return 1
    fi
  fi
}

validate_full_tree_v3() {
  local tree_root="$1" require_quiescent="$2" legacy_label="$3" launch_output item raw_mode mode mode_bits hardlinks temp_root
  [[ -d "$tree_root" && ! -L "$tree_root" && -d "$tree_root/runtime-v2" && ! -L "$tree_root/runtime-v2" ]] || {
    echo "full state root or required runtime-v2 payload is missing or unsafe" >&2
    return 1
  }
  [[ "$(cd "$tree_root" && pwd -P)" == "$tree_root" ]] || {
    echo "full state root must be a physical canonical directory" >&2
    return 1
  }
  validate_tree_names "$tree_root" || return 1
  if find "$tree_root" -type l -print -quit | grep -q .; then
    echo "full state root contains a symlink" >&2
    return 1
  fi
  if find "$tree_root" ! -type f ! -type d -print -quit | grep -q .; then
    echo "full state root contains a special filesystem entry" >&2
    return 1
  fi
  if find "$tree_root" -type f -name '*-wal' -size +0c -print -quit | grep -q .; then
    echo "full state root contains a nonempty SQLite WAL" >&2
    return 1
  fi
  while IFS= read -r item; do
    raw_mode="$(stat -f '%p' "$item")" || return 1
    mode_bits="$((8#$raw_mode & 07777))"
    printf -v mode '%04o' "$mode_bits"
    if [[ -f "$item" ]]; then
      case "$mode" in
        0400|0444|0500|0600) ;;
        *)
          echo "full state regular file violates exact v3 mode profile (allowed: 0400, 0444, 0500, 0600): $item ($mode)" >&2
          return 1
          ;;
      esac
    elif [[ "$mode" != 0700 ]]; then
      echo "full state directory violates exact v3 mode profile (required: 0700): $item ($mode)" >&2
      return 1
    fi
  done < <(find "$tree_root" -print)
  validate_acl_profile_v3 "$tree_root" || return 1
  temp_root="${TMPDIR:-/tmp}"
  hardlinks="$(mktemp "${temp_root%/}/hepta-state-v3-hardlink-validation.XXXXXX")" || return 1
  if ! hardlink_topology_inventory_v3 "$tree_root" "$hardlinks"; then
    rm -f "$hardlinks"
    return 1
  fi
  rm -f "$hardlinks"
  [[ "$require_quiescent" == true ]] || return 0
  [[ "$legacy_label" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "invalid legacy launchd label: $legacy_label" >&2
    return 1
  }
  if launch_output="$(/bin/launchctl print "gui/$(id -u)/$legacy_label" 2>&1)"; then
    echo "legacy launchd job is still loaded: $legacy_label" >&2
    return 1
  elif [[ "$launch_output" != *"Could not find service"* ]]; then
    echo "could not prove legacy launchd job is unloaded: $launch_output" >&2
    return 1
  fi
  local lsof_output lsof_rc
  if lsof_output="$(lsof -nP +D "$tree_root" 2>&1)"; then
    echo "legacy writer or reader still has the full state root open; stop it before snapshotting" >&2
    return 1
  else
    lsof_rc=$?
    if [[ "$lsof_rc" -ne 1 || -n "$lsof_output" ]]; then
      echo "could not prove the full state root has no open files: $lsof_output" >&2
      return 1
    fi
  fi
}

validate_private_artifact_v3() {
  local artifact="$1" mode flags xattrs acl_lines
  [[ -f "$artifact" && ! -L "$artifact" ]] || return 1
  mode="$(stat -f '%Lp' "$artifact")" || return 1
  flags="$(stat -f '%f' "$artifact")" || return 1
  if ! xattrs="$(/usr/bin/xattr "$artifact" 2>/dev/null)"; then
    echo "could not enumerate private snapshot artifact xattrs: $artifact" >&2
    return 1
  fi
  acl_lines="$(/bin/ls -lden "$artifact" | sed '1d')" || return 1
  [[ "$mode" == 400 && "$(stat -f '%l' "$artifact")" == 1 && "$flags" == 0 \
    && -z "$xattrs" && -z "$acl_lines" ]] || {
    echo "private snapshot artifact must be 0400, single-linked, ACL/xattr/flag-free: $artifact" >&2
    return 1
  }
}

write_private_new() {
  local destination="$1" source="$2" parent staged source_sha
  [[ ! -e "$destination" && ! -L "$destination" ]] || { echo "receipt already exists: $destination" >&2; return 1; }
  parent="$(dirname "$destination")"; mkdir -p "$parent"; chmod 0700 "$parent"
  [[ "$(cd "$parent" && pwd -P)" == "$parent" ]] || {
    echo "receipt parent must be a physical canonical directory" >&2
    return 1
  }
  source_sha="$(sha256_file "$source")" || return 1
  staged="$(mktemp "$parent/.hepta-state-snapshot-receipt.XXXXXX")"
  trap 'rm -f "${staged:-}"; trap - RETURN' RETURN
  cp "$source" "$staged"
  chmod -N "$staged" 2>/dev/null || true
  /usr/bin/xattr -c "$staged" 2>/dev/null || return 1
  chflags nouchg,noschg,nohidden "$staged" 2>/dev/null || true
  chmod 0400 "$staged"
  [[ "$(sha256_file "$staged")" == "$source_sha" ]] || return 1
  validate_private_artifact_v3 "$staged" || return 1
  fsync_paths "$staged" || return 1
  ln "$staged" "$destination" || {
    echo "failed to publish new snapshot artifact without replacement: $destination" >&2
    return 1
  }
  rm "$staged"
  staged=""
  fsync_paths "$parent" || return 1
  validate_private_artifact_v3 "$destination" || return 1
  trap - RETURN
}

publish_directory_no_replace_v3() {
  local staged="$1" destination="$2" parent script_dir guard
  parent="$(dirname "$destination")"
  [[ -d "$staged" && ! -L "$staged" && ! -e "$destination" && ! -L "$destination" ]] || return 1
  fsync_tree "$staged" || return 1
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  guard="$script_dir/hepta-cutover-guard"
  [[ -f "$guard" && -x "$guard" && ! -L "$guard" ]] || {
    echo "Darwin cutover guard is missing or unsafe" >&2
    return 1
  }
  "$guard" publish-directory --staged "$staged" --destination "$destination" >/dev/null || return 1
  [[ ! -e "$staged" && ! -L "$staged" && -d "$destination" && ! -L "$destination" ]] || {
    echo "snapshot destination publication lost the no-replace race" >&2
    return 1
  }
  fsync_paths "$parent" || return 1
}

replace_private_reserved() {
  local destination="$1" expected_sha="$2" source="$3" parent staged source_sha
  [[ -f "$destination" && ! -L "$destination" && "$(sha256_file "$destination")" == "$expected_sha" ]] || {
    echo "snapshot receipt reservation changed before finalization" >&2
    return 1
  }
  parent="$(dirname "$destination")"
  source_sha="$(sha256_file "$source")" || return 1
  staged="$(mktemp "$parent/.hepta-state-snapshot-final.XXXXXX")"
  cp "$source" "$staged" || { rm -f "$staged"; return 1; }
  chmod 0400 "$staged" || { rm -f "$staged"; return 1; }
  [[ "$(sha256_file "$staged")" == "$source_sha" ]] || { rm -f "$staged"; return 1; }
  mv -f "$staged" "$destination" || { rm -f "$staged"; return 1; }
}

snapshot_v1() {
  local source_root="$1" destination_root="$2" receipt="$3" materialize="$4" legacy_label="$5"
  local source_runtime destination_parent destination_name stage temp_root
  local source_before source_after source_payload destination_payload receipt_tmp pending_tmp pending_sha
  absolute_non_root "$source_root" || return 1
  absolute_non_root "$destination_root" || return 1
  [[ "$(realpath "$source_root")" == "$source_root" ]] || {
    echo "source state root must be a physical canonical directory" >&2
    return 1
  }
  [[ "$source_root" != "$destination_root" ]] || { echo "snapshot destination must be separate from legacy state" >&2; return 1; }
  [[ "$destination_root" != "$source_root/"* && "$source_root" != "$destination_root/"* ]] || {
    echo "snapshot source and destination must not be nested" >&2
    return 1
  }
  source_runtime="$source_root/runtime-v2"
  validate_source "$source_runtime" "$legacy_label" || return 1
  [[ ! -e "$destination_root" && ! -L "$destination_root" ]] || { echo "snapshot destination already exists" >&2; return 1; }
  if [[ "$materialize" != "true" ]]; then
    jq -cn --arg source "$source_root" --arg destination "$destination_root" --arg legacy_label "$legacy_label" \
      '{schema:"hepta_vnext_state_snapshot_plan_v1",status:"ready",source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,legacy_launchd_unloaded:true,writer_stopped:true,wal_empty:true,materialized:false,service_changed:false}'
    return
  fi
  [[ -n "$receipt" ]] || usage
  absolute_non_root "$receipt" || return 1
  [[ "$receipt" != "$source_root" && "$receipt" != "$source_root/"* \
    && "$receipt" != "$destination_root" && "$receipt" != "$destination_root/"* ]] || {
    echo "snapshot receipt must remain outside source and destination state roots" >&2
    return 1
  }
  temp_root="${TMPDIR:-/tmp}"
  source_before="$(mktemp "${temp_root%/}/hepta-state-source-before.XXXXXX")"
  source_after="$(mktemp "${temp_root%/}/hepta-state-source-after.XXXXXX")"
  source_payload="$(mktemp "${temp_root%/}/hepta-state-source-payload.XXXXXX")"
  destination_payload="$(mktemp "${temp_root%/}/hepta-state-destination-payload.XXXXXX")"
  receipt_tmp="$(mktemp "${temp_root%/}/hepta-state-snapshot.XXXXXX")"
  pending_tmp="$(mktemp "${temp_root%/}/hepta-state-snapshot-pending.XXXXXX")"
  trap 'rm -f "${source_before:-}" "${source_after:-}" "${source_payload:-}" "${destination_payload:-}" "${receipt_tmp:-}" "${pending_tmp:-}"; trap - RETURN' RETURN
  jq -n --arg source "$source_root" --arg destination "$destination_root" --arg legacy_label "$legacy_label" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_state_snapshot_pending_v1",status:"pending",source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,created_at:$created_at,materialized:false,service_changed:false}' >"$pending_tmp"
  write_private_new "$receipt" "$pending_tmp"
  pending_sha="$(sha256_file "$receipt")"
  inventory_tree "$source_runtime" "$source_before"
  payload_inventory "$source_runtime" "$source_payload"
  destination_parent="$(dirname "$destination_root")"; destination_name="$(basename "$destination_root")"
  mkdir -p "$destination_parent"; chmod 0700 "$destination_parent"
  [[ "$(cd "$destination_parent" && pwd -P)" == "$destination_parent" ]] || {
    echo "snapshot destination parent must be a physical canonical directory" >&2
    return 1
  }
  stage="$(mktemp -d "$destination_parent/.hepta-state-snapshot.XXXXXX")"
  chmod 0700 "$stage"
  cp -pR "$source_runtime" "$stage/runtime-v2"
  if ! validate_source "$stage/runtime-v2" "ai.hepta.snapshot.private-copy"; then
    chmod -R u+w "$stage" 2>/dev/null || true
    rm -rf "$stage"
    return 1
  fi
  inventory_tree "$source_runtime" "$source_after"
  diff -u "$source_before" "$source_after" >/dev/null || {
    echo "source state changed while snapshotting" >&2
    chmod -R u+w "$stage" 2>/dev/null || true; rm -rf "$stage"; return 1
  }
  payload_inventory "$stage/runtime-v2" "$destination_payload"
  diff -u "$source_payload" "$destination_payload" >/dev/null || {
    echo "snapshot bytes or preserved metadata differ from source" >&2
    chmod -R u+w "$stage" 2>/dev/null || true; rm -rf "$stage"; return 1
  }
  mv "$stage" "$destination_parent/$destination_name"
  destination_root="$destination_parent/$destination_name"
  jq -n --arg source "$source_root" --arg destination "$destination_root" --arg legacy_label "$legacy_label" \
    --arg source_inventory_sha256 "$(sha256_file "$source_before")" \
    --arg payload_inventory_sha256 "$(sha256_file "$destination_payload")" \
    --argjson file_count "$(find "$destination_root/runtime-v2" -type f | wc -l | tr -d ' ')" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_state_snapshot_receipt_v1",status:"ready",source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,legacy_launchd_unloaded:true,source_inventory_sha256:$source_inventory_sha256,payload_inventory_sha256:$payload_inventory_sha256,file_count:$file_count,created_at:$created_at,writer_stopped:true,wal_empty:true,source_unchanged:true,destination_exact_copy:true,modes_and_sidecars_preserved:true,service_changed:false}' >"$receipt_tmp"
  replace_private_reserved "$receipt" "$pending_sha" "$receipt_tmp"
  trap - RETURN
  rm -f "$source_before" "$source_after" "$source_payload" "$destination_payload" "$receipt_tmp" "$pending_tmp"
  cat "$receipt"
}

snapshot_v3_pre_atomic() {
  local source_root="$1" destination_root="$2" receipt="$3" materialize="$4" legacy_label="$5"
  local destination_parent destination_name stage payload_root temp_root snapshot_id
  local source_identity_before source_identity_after source_portable destination_portable
  local source_modes_before source_modes_after destination_modes source_hardlinks destination_hardlinks
  local receipt_tmp pending_tmp binding_tmp pending_sha source_identity_sha portable_sha mode_sha top_level_sha
  local sidecar_sha key_sha hardlink_sha file_count entry_count top_level_count sidecar_count key_count hardlink_group_count hardlink_alias_count
  local binding binding_sha
  absolute_non_root "$source_root" || return 1
  absolute_non_root "$destination_root" || return 1
  [[ -d "$source_root" && ! -L "$source_root" && "$(cd "$source_root" && pwd -P)" == "$source_root" ]] || {
    echo "source state root must be a physical canonical directory" >&2
    return 1
  }
  [[ "$source_root" != "$destination_root" ]] || {
    echo "snapshot destination must be separate from legacy state" >&2
    return 1
  }
  [[ "$destination_root" != "$source_root/"* && "$source_root" != "$destination_root/"* ]] || {
    echo "snapshot source and destination must not be nested" >&2
    return 1
  }
  validate_full_tree_v3 "$source_root" true "$legacy_label" || return 1
  [[ ! -e "$destination_root" && ! -L "$destination_root" ]] || {
    echo "snapshot destination already exists" >&2
    return 1
  }
  if [[ "$materialize" != true ]]; then
    jq -cn --arg source "$source_root" --arg destination "$destination_root" --arg legacy_label "$legacy_label" \
      --arg profile "$SNAPSHOT_PROFILE_V3" --arg mode_profile "$MODE_PROFILE_V3" \
      '{schema:"hepta_vnext_state_snapshot_plan_v3",profile:$profile,mode_profile:$mode_profile,status:"ready",scope:"full-state-root",source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,legacy_launchd_unloaded:true,writer_stopped:true,wal_empty:true,all_top_level_entries_required:true,identity_inventory_separate:true,portable_payload_inventory_required:true,original_mode_inventory_required:true,regular_file_mode_contract:{allowed_modes:["0400","0444","0500","0600"],exact_allowlist:true},directory_mode_contract:{allowed_modes:["0700"],exact_allowlist:true},hardlink_topology_inventory_required:true,external_hardlinks_rejected:true,materialized:false,service_changed:false}'
    return
  fi
  [[ -n "$receipt" ]] || usage
  absolute_non_root "$receipt" || return 1
  [[ "$receipt" != "$source_root" && "$receipt" != "$source_root/"* \
    && "$receipt" != "$destination_root" && "$receipt" != "$destination_root/"* ]] || {
    echo "snapshot receipt must remain outside source and destination state roots" >&2
    return 1
  }
  destination_parent="$(dirname "$destination_root")"
  destination_name="$(basename "$destination_root")"
  binding="$destination_parent/.$destination_name.hepta-state-snapshot-v3.binding"
  [[ ! -e "$binding" && ! -L "$binding" ]] || {
    echo "snapshot destination binding already exists" >&2
    return 1
  }
  mkdir -p "$destination_parent"; chmod 0700 "$destination_parent"
  [[ "$(cd "$destination_parent" && pwd -P)" == "$destination_parent" ]] || {
    echo "snapshot destination parent must be a physical canonical directory" >&2
    return 1
  }
  temp_root="${TMPDIR:-/tmp}"
  source_identity_before="$(mktemp "${temp_root%/}/hepta-state-v3-identity-before.XXXXXX")"
  source_identity_after="$(mktemp "${temp_root%/}/hepta-state-v3-identity-after.XXXXXX")"
  source_portable="$(mktemp "${temp_root%/}/hepta-state-v3-portable-source.XXXXXX")"
  destination_portable="$(mktemp "${temp_root%/}/hepta-state-v3-portable-destination.XXXXXX")"
  source_modes_before="$(mktemp "${temp_root%/}/hepta-state-v3-modes-before.XXXXXX")"
  source_modes_after="$(mktemp "${temp_root%/}/hepta-state-v3-modes-after.XXXXXX")"
  destination_modes="$(mktemp "${temp_root%/}/hepta-state-v3-modes-destination.XXXXXX")"
  source_hardlinks="$(mktemp "${temp_root%/}/hepta-state-v3-hardlinks-source.XXXXXX")"
  destination_hardlinks="$(mktemp "${temp_root%/}/hepta-state-v3-hardlinks-destination.XXXXXX")"
  receipt_tmp="$(mktemp "${temp_root%/}/hepta-state-v3-receipt.XXXXXX")"
  pending_tmp="$(mktemp "${temp_root%/}/hepta-state-v3-pending.XXXXXX")"
  binding_tmp="$(mktemp "${temp_root%/}/hepta-state-v3-binding.XXXXXX")"
  stage=""
  trap '
    rm -f "${source_identity_before:-}" "${source_identity_after:-}" "${source_portable:-}" "${destination_portable:-}" "${source_modes_before:-}" "${source_modes_after:-}" "${destination_modes:-}" "${source_hardlinks:-}" "${destination_hardlinks:-}" "${receipt_tmp:-}" "${pending_tmp:-}" "${binding_tmp:-}"
    if [[ -n "${stage:-}" && -d "$stage" ]]; then
      chflags -R nouchg,noschg "$stage" 2>/dev/null || true
      chmod -RN "$stage" 2>/dev/null || true
      chmod -R u+w "$stage" 2>/dev/null || true
      rm -rf "$stage"
    fi
    trap - RETURN
  ' RETURN
  snapshot_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
  jq -n --arg source "$source_root" --arg destination "$destination_root" \
    --arg legacy_label "$legacy_label" --arg snapshot_id "$snapshot_id" \
    --arg profile "$SNAPSHOT_PROFILE_V3" --arg mode_profile "$MODE_PROFILE_V3" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_state_snapshot_pending_v3",profile:$profile,mode_profile:$mode_profile,status:"pending",scope:"full-state-root",snapshot_id:$snapshot_id,source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,created_at:$created_at,materialized:false,service_changed:false}' >"$pending_tmp"
  write_private_new "$receipt" "$pending_tmp"
  pending_sha="$(sha256_file "$receipt")"

  identity_inventory_v3 "$source_root" "$source_identity_before"
  portable_inventory_v3 "$source_root" "$source_portable"
  mode_inventory_v3 "$source_root" "$source_modes_before"
  hardlink_topology_inventory_v3 "$source_root" "$source_hardlinks"
  stage="$(mktemp -d "$destination_parent/.hepta-state-snapshot-v3.XXXXXX")"
  chmod 0700 "$stage"
  payload_root="$stage/payload"
  copy_full_tree_v3 "$source_root" "$payload_root"
  validate_full_tree_v3 "$payload_root" false "$legacy_label"
  identity_inventory_v3 "$source_root" "$source_identity_after"
  mode_inventory_v3 "$source_root" "$source_modes_after"
  diff -u "$source_identity_before" "$source_identity_after" >/dev/null || {
    echo "full source identity changed while snapshotting" >&2
    return 1
  }
  diff -u "$source_modes_before" "$source_modes_after" >/dev/null || {
    echo "full source modes changed while snapshotting" >&2
    return 1
  }
  portable_inventory_v3 "$payload_root" "$destination_portable"
  mode_inventory_v3 "$payload_root" "$destination_modes"
  hardlink_topology_inventory_v3 "$payload_root" "$destination_hardlinks"
  diff -u "$source_portable" "$destination_portable" >/dev/null || {
    echo "full snapshot bytes or portable metadata differ from source" >&2
    return 1
  }
  diff -u "$source_modes_before" "$destination_modes" >/dev/null || {
    echo "full snapshot original per-entry modes differ from source" >&2
    return 1
  }
  diff -u "$source_hardlinks" "$destination_hardlinks" >/dev/null || {
    echo "full snapshot hardlink alias topology differs from source" >&2
    return 1
  }

  source_identity_sha="$(sha256_file "$source_identity_before")"
  portable_sha="$(sha256_file "$source_portable")"
  mode_sha="$(sha256_file "$source_modes_before")"
  top_level_sha="$(top_level_inventory_sha256 "$source_portable")"
  sidecar_sha="$(inventory_subset_sha256 "$source_portable" '\\-(wal|shm)$')"
  key_sha="$(inventory_subset_sha256 "$source_portable" '(^|/)keys/|\\.key$')"
  hardlink_sha="$(sha256_file "$source_hardlinks")"
  entry_count="$(find "$source_root" -print | wc -l | tr -d ' ')"
  file_count="$(find "$source_root" -type f | wc -l | tr -d ' ')"
  top_level_count="$(find "$source_root" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d ' ')"
  sidecar_count="$(find "$source_root" -type f \( -name '*-wal' -o -name '*-shm' \) | wc -l | tr -d ' ')"
  key_count="$(find "$source_root" -type f \( -path '*/keys/*' -o -name '*.key' \) | wc -l | tr -d ' ')"
  hardlink_group_count="$(awk -F '|' '$1 == $2 && $3 > 1 { count += 1 } END { print count + 0 }' "$source_hardlinks")"
  hardlink_alias_count="$(awk -F '|' '$1 != $2 { count += 1 } END { print count + 0 }' "$source_hardlinks")"
  mv "$payload_root" "$destination_parent/$destination_name"
  rmdir "$stage"
  stage=""
  destination_root="$destination_parent/$destination_name"
  jq -n --arg snapshot_id "$snapshot_id" --arg destination "$destination_root" \
    --arg profile "$SNAPSHOT_PROFILE_V3" --arg mode_profile "$MODE_PROFILE_V3" \
    --arg portable_payload_sha256 "$portable_sha" --arg original_mode_inventory_sha256 "$mode_sha" \
    --arg hardlink_topology_sha256 "$hardlink_sha" \
    '{schema:"hepta_vnext_state_snapshot_binding_v3",profile:$profile,mode_profile:$mode_profile,snapshot_id:$snapshot_id,destination_state_root:$destination,portable_payload_inventory_sha256:$portable_payload_sha256,original_mode_inventory_sha256:$original_mode_inventory_sha256,hardlink_topology_inventory_sha256:$hardlink_topology_sha256}' >"$binding_tmp"
  write_private_new "$binding" "$binding_tmp"
  binding_sha="$(sha256_file "$binding")"
  jq -n --arg snapshot_id "$snapshot_id" --arg source "$source_root" --arg destination "$destination_root" \
    --arg profile "$SNAPSHOT_PROFILE_V3" --arg mode_profile "$MODE_PROFILE_V3" \
    --arg legacy_label "$legacy_label" --arg source_identity_sha256 "$source_identity_sha" \
    --arg portable_payload_sha256 "$portable_sha" --arg top_level_inventory_sha256 "$top_level_sha" \
    --arg sqlite_sidecar_inventory_sha256 "$sidecar_sha" --arg key_inventory_sha256 "$key_sha" \
    --arg original_mode_inventory_sha256 "$mode_sha" --arg hardlink_topology_inventory_sha256 "$hardlink_sha" \
    --arg binding "$binding" --arg binding_sha256 "$binding_sha" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson entry_count "$entry_count" \
    --argjson file_count "$file_count" --argjson top_level_entry_count "$top_level_count" \
    --argjson sqlite_sidecar_count "$sidecar_count" --argjson key_file_count "$key_count" \
    --argjson hardlink_group_count "$hardlink_group_count" --argjson hardlink_alias_count "$hardlink_alias_count" \
    '{schema:"hepta_vnext_state_snapshot_receipt_v3",profile:$profile,mode_profile:$mode_profile,status:"ready",scope:"full-state-root",snapshot_id:$snapshot_id,source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,legacy_launchd_unloaded:true,source_identity_inventory_sha256:$source_identity_sha256,portable_payload_inventory_sha256:$portable_payload_sha256,original_mode_inventory_sha256:$original_mode_inventory_sha256,top_level_inventory_sha256:$top_level_inventory_sha256,sqlite_sidecar_inventory_sha256:$sqlite_sidecar_inventory_sha256,key_inventory_sha256:$key_inventory_sha256,hardlink_topology_inventory_sha256:$hardlink_topology_inventory_sha256,destination_binding:$binding,destination_binding_sha256:$binding_sha256,entry_count:$entry_count,file_count:$file_count,top_level_entry_count:$top_level_entry_count,sqlite_sidecar_count:$sqlite_sidecar_count,key_file_count:$key_file_count,hardlink_group_count:$hardlink_group_count,hardlink_alias_count:$hardlink_alias_count,created_at:$created_at,writer_stopped:true,wal_empty:true,source_unchanged:true,destination_exact_copy:true,all_top_level_entries_covered:true,regular_file_mode_contract:{allowed_modes:["0400","0444","0500","0600"],exact_allowlist:true},directory_mode_contract:{allowed_modes:["0700"],exact_allowlist:true},mode_policy_validated:true,original_modes_preserved:true,modes_uid_gid_mtime_flags_acl_xattr_preserved:true,wal_shm_and_keys_covered:true,hardlinks_preserved:true,external_hardlinks_rejected:true,identity_inventory_separate:true,replay_protected_by_destination_binding:true,service_changed:false}' >"$receipt_tmp"
  replace_private_reserved "$receipt" "$pending_sha" "$receipt_tmp"
  trap - RETURN
  rm -f "$source_identity_before" "$source_identity_after" "$source_portable" "$destination_portable" "$source_modes_before" "$source_modes_after" "$destination_modes" "$source_hardlinks" "$destination_hardlinks" "$receipt_tmp" "$pending_tmp" "$binding_tmp"
  cat "$receipt"
}

snapshot() {
  local source_root="$1" destination_root="$2" receipt="$3" materialize="$4" legacy_label="$5"
  local predecessor_receipt="${6:-}" predecessor_sha="" predecessor_plan_sha="" predecessor_sequence=""
  local writer_barrier_receipt="${7:-}" writer_barrier_sha="" writer_barrier_json='null'
  local destination_parent destination_name operation_lock stage payload_root temp_root snapshot_id binding binding_sha
  local source_identity_before source_identity_after source_portable destination_portable
  local source_modes_before source_modes_after destination_modes source_acls_before source_acls_after destination_acls
  local source_hardlinks destination_hardlinks receipt_tmp pending_tmp binding_tmp lock_tmp
  local source_identity_sha portable_sha mode_sha acl_sha top_level_sha sidecar_sha key_sha hardlink_sha
  local file_count entry_count top_level_count sidecar_count key_count hardlink_group_count hardlink_alias_count
  local interrupt_after="${HEPTA_STATE_SNAPSHOT_SELF_TEST_INTERRUPT_AFTER:-}"

  absolute_non_root "$source_root" || return 1
  absolute_non_root "$destination_root" || return 1
  [[ -d "$source_root" && ! -L "$source_root" && "$(cd "$source_root" && pwd -P)" == "$source_root" ]] || {
    echo "source state root must be a physical canonical directory" >&2
    return 1
  }
  [[ "$source_root" != "$destination_root" \
    && "$destination_root" != "$source_root/"* && "$source_root" != "$destination_root/"* ]] || {
    echo "snapshot source and destination must be separate and non-nested" >&2
    return 1
  }
  validate_full_tree_v3 "$source_root" true "$legacy_label" || return 1
  if [[ -n "$predecessor_receipt" ]]; then
    absolute_non_root "$predecessor_receipt" || return 1
    predecessor_receipt="$(realpath "$predecessor_receipt")" || return 1
    [[ -f "$predecessor_receipt" && ! -L "$predecessor_receipt" ]] || return 1
    jq -e '
      (.schema == "hepta_vnext_launchd_bridge_transition_v1" or .schema == "hepta_vnext_launchd_bridge_transition_v2")
      and .status == "ready" and .transition == "rollback"
      and .source_generation == "vnext" and .target_generation == "legacy"
      and (.plan_sha256 | test("^[0-9a-f]{64}$"))
      and (.sequence | type == "number" and . >= 2 and . == floor)
      and .applied == true and .chain_head_committed == true
    ' "$predecessor_receipt" >/dev/null || {
      echo "snapshot recutover predecessor must be an exact applied rollback receipt" >&2
      return 1
    }
    predecessor_sha="$(sha256_file "$predecessor_receipt")"
    predecessor_plan_sha="$(jq -r '.plan_sha256' "$predecessor_receipt")"
    predecessor_sequence="$(jq -r '.sequence' "$predecessor_receipt")"
  fi
  if [[ "$materialize" == true ]]; then
    verify_writer_barrier_v3 "$writer_barrier_receipt" "$source_root" "$legacy_label" || return 1
    if [[ -n "$writer_barrier_receipt" ]]; then
      writer_barrier_receipt="$(realpath "$writer_barrier_receipt")" || return 1
      writer_barrier_sha="$(sha256_file "$writer_barrier_receipt")"
      writer_barrier_json="$(jq -cn --arg receipt "$writer_barrier_receipt" --arg sha256 "$writer_barrier_sha" \
        '{schema:"hepta_vnext_writer_barrier_v1",receipt:$receipt,sha256:$sha256,writer_admission_closed:true,self_test_exemption:false}')"
    else
      writer_barrier_json='{"schema":"hepta_vnext_writer_barrier_self_test_exemption_v1","receipt":null,"sha256":null,"writer_admission_closed":true,"self_test_exemption":true}'
    fi
  fi

  if [[ "$materialize" != true ]]; then
    jq -cn --arg source "$source_root" --arg destination "$destination_root" --arg legacy_label "$legacy_label" \
      --arg profile "$SNAPSHOT_PROFILE_V3" --arg mode_profile "$MODE_PROFILE_V3" --arg acl_profile "$ACL_PROFILE_V3" \
      --arg predecessor_sha "$predecessor_sha" --arg predecessor_plan_sha "$predecessor_plan_sha" \
      --arg predecessor_sequence "$predecessor_sequence" \
      '{schema:"hepta_vnext_state_snapshot_plan_v3",profile:$profile,mode_profile:$mode_profile,acl_profile:$acl_profile,status:"ready",scope:"full-state-root",source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,legacy_launchd_unloaded:true,writer_stopped:true,wal_empty:true,all_top_level_entries_required:true,identity_inventory_separate:true,portable_payload_inventory_required:true,original_mode_inventory_required:true,acl_inventory_required:true,acl_allow_aces_forbidden:true,acl_deny_only_preserved:true,regular_file_mode_contract:{allowed_modes:["0400","0444","0500","0600"],exact_allowlist:true},directory_mode_contract:{allowed_modes:["0700"],exact_allowlist:true},hardlink_topology_inventory_required:true,external_hardlinks_rejected:true,recutover_predecessor:(if $predecessor_sha=="" then null else {sha256:$predecessor_sha,plan_sha256:$predecessor_plan_sha,sequence:($predecessor_sequence|tonumber)} end),materialized:false,service_changed:false}'
    return
  fi

  [[ -n "$receipt" ]] || usage
  absolute_non_root "$receipt" || return 1
  [[ "$receipt" != "$source_root" && "$receipt" != "$source_root/"* \
    && "$receipt" != "$destination_root" && "$receipt" != "$destination_root/"* ]] || {
    echo "snapshot receipt must remain outside source and destination state roots" >&2
    return 1
  }
  destination_parent="$(dirname "$destination_root")"
  destination_name="$(basename "$destination_root")"
  mkdir -p "$destination_parent"
  chmod 0700 "$destination_parent"
  [[ "$(cd "$destination_parent" && pwd -P)" == "$destination_parent" ]] || {
    echo "snapshot destination parent must be a physical canonical directory" >&2
    return 1
  }
  destination_root="$destination_parent/$destination_name"
  operation_lock="$destination_parent/.$destination_name.hepta-state-snapshot-v3.lock"
  if ! mkdir "$operation_lock" 2>/dev/null; then
    echo "another snapshot for this destination is active or its inspection lock is retained: $operation_lock" >&2
    return 1
  fi
  chmod 0700 "$operation_lock"
  fsync_paths "$destination_parent" || return 1
  [[ ! -e "$destination_root" && ! -L "$destination_root" ]] || {
    echo "snapshot destination already exists" >&2
    return 1
  }
  binding="$destination_parent/.$destination_name.hepta-state-snapshot-v3.binding"
  [[ ! -e "$binding" && ! -L "$binding" && ! -e "$receipt" && ! -L "$receipt" ]] || {
    echo "snapshot destination binding or receipt already exists" >&2
    return 1
  }
  if [[ -n "$interrupt_after" ]]; then
    [[ -n "${HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT:-}" \
      && "$destination_root" == "$HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT/"* \
      && "$interrupt_after" =~ ^(destination|binding|receipt)$ ]] || {
      echo "snapshot interruption injection is restricted to the self-test root" >&2
      return 1
    }
  fi

  temp_root="${TMPDIR:-/tmp}"
  source_identity_before="$(mktemp "${temp_root%/}/hepta-state-v3-identity-before.XXXXXX")"
  source_identity_after="$(mktemp "${temp_root%/}/hepta-state-v3-identity-after.XXXXXX")"
  source_portable="$(mktemp "${temp_root%/}/hepta-state-v3-portable-source.XXXXXX")"
  destination_portable="$(mktemp "${temp_root%/}/hepta-state-v3-portable-destination.XXXXXX")"
  source_modes_before="$(mktemp "${temp_root%/}/hepta-state-v3-modes-before.XXXXXX")"
  source_modes_after="$(mktemp "${temp_root%/}/hepta-state-v3-modes-after.XXXXXX")"
  destination_modes="$(mktemp "${temp_root%/}/hepta-state-v3-modes-destination.XXXXXX")"
  source_acls_before="$(mktemp "${temp_root%/}/hepta-state-v3-acls-before.XXXXXX")"
  source_acls_after="$(mktemp "${temp_root%/}/hepta-state-v3-acls-after.XXXXXX")"
  destination_acls="$(mktemp "${temp_root%/}/hepta-state-v3-acls-destination.XXXXXX")"
  source_hardlinks="$(mktemp "${temp_root%/}/hepta-state-v3-hardlinks-source.XXXXXX")"
  destination_hardlinks="$(mktemp "${temp_root%/}/hepta-state-v3-hardlinks-destination.XXXXXX")"
  receipt_tmp="$(mktemp "${temp_root%/}/hepta-state-v3-receipt.XXXXXX")"
  pending_tmp="$(mktemp "${temp_root%/}/hepta-state-v3-pending.XXXXXX")"
  binding_tmp="$(mktemp "${temp_root%/}/hepta-state-v3-binding.XXXXXX")"
  lock_tmp="$(mktemp "${temp_root%/}/hepta-state-v3-lock.XXXXXX")"
  stage=""
  trap '
    rm -f "${source_identity_before:-}" "${source_identity_after:-}" "${source_portable:-}" "${destination_portable:-}" "${source_modes_before:-}" "${source_modes_after:-}" "${destination_modes:-}" "${source_acls_before:-}" "${source_acls_after:-}" "${destination_acls:-}" "${source_hardlinks:-}" "${destination_hardlinks:-}" "${receipt_tmp:-}" "${pending_tmp:-}" "${binding_tmp:-}" "${lock_tmp:-}"
    if [[ -n "${stage:-}" && -d "$stage" ]]; then
      chflags -R nouchg,noschg "$stage" 2>/dev/null || true
      chmod -RN "$stage" 2>/dev/null || true
      chmod -R u+w "$stage" 2>/dev/null || true
      rm -rf "$stage"
    fi
    trap - RETURN
  ' RETURN

  snapshot_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
  jq -n --arg destination "$destination_root" --arg receipt "$receipt" --arg snapshot_id "$snapshot_id" \
    --arg pid "$$" --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_state_snapshot_operation_lock_v1",status:"pending",destination_state_root:$destination,receipt:$receipt,snapshot_id:$snapshot_id,pid:($pid|tonumber),created_at:$created_at}' >"$lock_tmp"
  write_private_new "$operation_lock/operation.json" "$lock_tmp" || return 1
  jq -n --arg source "$source_root" --arg destination "$destination_root" --arg legacy_label "$legacy_label" \
    --arg snapshot_id "$snapshot_id" --arg profile "$SNAPSHOT_PROFILE_V3" --arg mode_profile "$MODE_PROFILE_V3" \
    --arg acl_profile "$ACL_PROFILE_V3" --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_state_snapshot_pending_v3",profile:$profile,mode_profile:$mode_profile,acl_profile:$acl_profile,status:"pending",scope:"full-state-root",snapshot_id:$snapshot_id,source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,created_at:$created_at,materialized:false,service_changed:false}' >"$pending_tmp"
  write_private_new "$operation_lock/pending.json" "$pending_tmp" || return 1

  identity_inventory_v3 "$source_root" "$source_identity_before" || return 1
  portable_inventory_v3 "$source_root" "$source_portable" || return 1
  mode_inventory_v3 "$source_root" "$source_modes_before" || return 1
  acl_inventory_v3 "$source_root" "$source_acls_before" || return 1
  hardlink_topology_inventory_v3 "$source_root" "$source_hardlinks" || return 1
  stage="$(mktemp -d "$destination_parent/.hepta-state-snapshot-v3.XXXXXX")"
  chmod 0700 "$stage"
  payload_root="$stage/payload"
  copy_full_tree_v3 "$source_root" "$payload_root" || return 1
  validate_full_tree_v3 "$payload_root" false "$legacy_label" || return 1
  portable_inventory_v3 "$payload_root" "$destination_portable" || return 1
  mode_inventory_v3 "$payload_root" "$destination_modes" || return 1
  acl_inventory_v3 "$payload_root" "$destination_acls" || return 1
  hardlink_topology_inventory_v3 "$payload_root" "$destination_hardlinks" || return 1
  if ! diff -u "$source_portable" "$destination_portable" >/dev/null \
    || ! diff -u "$source_modes_before" "$destination_modes" >/dev/null \
    || ! diff -u "$source_acls_before" "$destination_acls" >/dev/null \
    || ! diff -u "$source_hardlinks" "$destination_hardlinks" >/dev/null; then
      echo "full snapshot bytes, metadata, modes, ACLs, or hardlinks differ from source" >&2
      return 1
  fi

  source_identity_sha="$(sha256_file "$source_identity_before")"
  portable_sha="$(sha256_file "$source_portable")"
  mode_sha="$(sha256_file "$source_modes_before")"
  acl_sha="$(sha256_file "$source_acls_before")"
  top_level_sha="$(top_level_inventory_sha256 "$source_portable")"
  sidecar_sha="$(inventory_subset_sha256 "$source_portable" '\\-(wal|shm)$')"
  key_sha="$(inventory_subset_sha256 "$source_portable" '(^|/)keys/|\\.key$')"
  hardlink_sha="$(sha256_file "$source_hardlinks")"
  entry_count="$(find "$source_root" -print | wc -l | tr -d ' ')"
  file_count="$(find "$source_root" -type f | wc -l | tr -d ' ')"
  top_level_count="$(find "$source_root" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d ' ')"
  sidecar_count="$(find "$source_root" -type f \( -name '*-wal' -o -name '*-shm' \) | wc -l | tr -d ' ')"
  key_count="$(find "$source_root" -type f \( -path '*/keys/*' -o -name '*.key' \) | wc -l | tr -d ' ')"
  hardlink_group_count="$(awk -F '|' '$1 == $2 && $3 > 1 { count += 1 } END { print count + 0 }' "$source_hardlinks")"
  hardlink_alias_count="$(awk -F '|' '$1 != $2 { count += 1 } END { print count + 0 }' "$source_hardlinks")"

  publish_directory_no_replace_v3 "$payload_root" "$destination_root" || return 1
  rmdir "$stage"
  stage=""
  if [[ "$interrupt_after" == destination ]]; then
    echo "injected interruption after destination publication" >&2
    return 75
  fi

  jq -n --arg snapshot_id "$snapshot_id" --arg destination "$destination_root" \
    --arg profile "$SNAPSHOT_PROFILE_V3" --arg mode_profile "$MODE_PROFILE_V3" --arg acl_profile "$ACL_PROFILE_V3" \
    --arg portable "$portable_sha" --arg modes "$mode_sha" --arg acls "$acl_sha" --arg hardlinks "$hardlink_sha" \
    '{schema:"hepta_vnext_state_snapshot_binding_v3",profile:$profile,mode_profile:$mode_profile,acl_profile:$acl_profile,snapshot_id:$snapshot_id,destination_state_root:$destination,portable_payload_inventory_sha256:$portable,original_mode_inventory_sha256:$modes,acl_inventory_sha256:$acls,hardlink_topology_inventory_sha256:$hardlinks,acl_allow_aces_forbidden:true,acl_deny_only_preserved:true}' >"$binding_tmp"
  write_private_new "$binding" "$binding_tmp" || return 1
  binding_sha="$(sha256_file "$binding")"
  if [[ "$interrupt_after" == binding ]]; then
    echo "injected interruption after binding publication" >&2
    return 75
  fi

  # This is deliberately the final source rescan: it occurs after destination
  # and binding publication and immediately before the only ready receipt is
  # published. The receipt is never used as an in-place pending reservation.
  validate_full_tree_v3 "$source_root" true "$legacy_label" || return 1
  identity_inventory_v3 "$source_root" "$source_identity_after" || return 1
  mode_inventory_v3 "$source_root" "$source_modes_after" || return 1
  acl_inventory_v3 "$source_root" "$source_acls_after" || return 1
  [[ "$(sha256_file "$source_identity_after")" == "$source_identity_sha" \
    && "$(sha256_file "$source_modes_after")" == "$mode_sha" \
    && "$(sha256_file "$source_acls_after")" == "$acl_sha" ]] || {
    echo "full source identity, modes, or ACLs changed before ready publication" >&2
    return 1
  }

  verify_writer_barrier_v3 "$writer_barrier_receipt" "$source_root" "$legacy_label" || return 1
  jq -n --arg snapshot_id "$snapshot_id" --arg source "$source_root" --arg destination "$destination_root" \
    --arg profile "$SNAPSHOT_PROFILE_V3" --arg mode_profile "$MODE_PROFILE_V3" --arg acl_profile "$ACL_PROFILE_V3" \
    --arg legacy_label "$legacy_label" --arg source_identity_sha256 "$source_identity_sha" \
    --arg portable_payload_sha256 "$portable_sha" --arg original_mode_inventory_sha256 "$mode_sha" \
    --arg acl_inventory_sha256 "$acl_sha" --arg top_level_inventory_sha256 "$top_level_sha" \
    --arg sqlite_sidecar_inventory_sha256 "$sidecar_sha" --arg key_inventory_sha256 "$key_sha" \
    --arg hardlink_topology_inventory_sha256 "$hardlink_sha" --arg binding "$binding" --arg binding_sha256 "$binding_sha" \
    --arg predecessor_receipt "$predecessor_receipt" --arg predecessor_sha "$predecessor_sha" \
    --arg predecessor_plan_sha "$predecessor_plan_sha" --arg predecessor_sequence "$predecessor_sequence" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson writer_barrier "$writer_barrier_json" --argjson entry_count "$entry_count" \
    --argjson file_count "$file_count" --argjson top_level_entry_count "$top_level_count" \
    --argjson sqlite_sidecar_count "$sidecar_count" --argjson key_file_count "$key_count" \
    --argjson hardlink_group_count "$hardlink_group_count" --argjson hardlink_alias_count "$hardlink_alias_count" \
    '{schema:"hepta_vnext_state_snapshot_receipt_v3",profile:$profile,mode_profile:$mode_profile,acl_profile:$acl_profile,status:"ready",scope:"full-state-root",snapshot_id:$snapshot_id,source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,legacy_launchd_unloaded:true,writer_barrier:$writer_barrier,source_identity_inventory_sha256:$source_identity_sha256,portable_payload_inventory_sha256:$portable_payload_sha256,original_mode_inventory_sha256:$original_mode_inventory_sha256,acl_inventory_sha256:$acl_inventory_sha256,top_level_inventory_sha256:$top_level_inventory_sha256,sqlite_sidecar_inventory_sha256:$sqlite_sidecar_inventory_sha256,key_inventory_sha256:$key_inventory_sha256,hardlink_topology_inventory_sha256:$hardlink_topology_inventory_sha256,destination_binding:$binding,destination_binding_sha256:$binding_sha256,recutover_predecessor:(if $predecessor_sha=="" then null else {receipt:$predecessor_receipt,sha256:$predecessor_sha,plan_sha256:$predecessor_plan_sha,sequence:($predecessor_sequence|tonumber)} end),entry_count:$entry_count,file_count:$file_count,top_level_entry_count:$top_level_entry_count,sqlite_sidecar_count:$sqlite_sidecar_count,key_file_count:$key_file_count,hardlink_group_count:$hardlink_group_count,hardlink_alias_count:$hardlink_alias_count,created_at:$created_at,writer_stopped:true,wal_empty:true,source_unchanged:true,destination_exact_copy:true,all_top_level_entries_covered:true,regular_file_mode_contract:{allowed_modes:["0400","0444","0500","0600"],exact_allowlist:true},directory_mode_contract:{allowed_modes:["0700"],exact_allowlist:true},mode_policy_validated:true,original_modes_preserved:true,acl_allow_aces_forbidden:true,acl_deny_only_preserved:true,acl_inventory_bound:true,modes_uid_gid_mtime_flags_acl_xattr_preserved:true,wal_shm_and_keys_covered:true,hardlinks_preserved:true,external_hardlinks_rejected:true,identity_inventory_separate:true,replay_protected_by_destination_binding:true,atomic_no_replace_publication:true,durable_publication:true,final_source_rescan:true,writer_admission_closed:true,service_changed:false}' >"$receipt_tmp"
  # Prove the exact ready bytes and the final source state before the ready
  # path exists. Publication below is then only a durable no-replace commit of
  # those already-verified bytes.
  chmod -N "$receipt_tmp" 2>/dev/null || true
  /usr/bin/xattr -c "$receipt_tmp" 2>/dev/null || true
  chflags nouchg,noschg,nohidden "$receipt_tmp" 2>/dev/null || true
  chmod 0400 "$receipt_tmp"
  fsync_paths "$receipt_tmp" || return 1
  verify_snapshot_receipt_v3 "$receipt_tmp" >/dev/null || return 1
  verify_snapshot_source_v3 "$receipt_tmp" >/dev/null || return 1
  write_private_new "$receipt" "$receipt_tmp" || return 1
  if [[ "$interrupt_after" == receipt ]]; then
    echo "injected interruption after ready receipt publication" >&2
    return 75
  fi
  [[ "$(sha256_file "$receipt")" == "$(sha256_file "$receipt_tmp")" ]] || return 1
  validate_private_artifact_v3 "$receipt" || return 1

  rm "$operation_lock/pending.json" "$operation_lock/operation.json"
  fsync_paths "$operation_lock"
  rmdir "$operation_lock"
  fsync_paths "$destination_parent"
  trap - RETURN
  rm -f "$source_identity_before" "$source_identity_after" "$source_portable" "$destination_portable" \
    "$source_modes_before" "$source_modes_after" "$destination_modes" "$source_acls_before" "$source_acls_after" \
    "$destination_acls" "$source_hardlinks" "$destination_hardlinks" "$receipt_tmp" "$pending_tmp" "$binding_tmp" "$lock_tmp"
  cat "$receipt"
}

verify_snapshot_receipt_v1() {
  local receipt="$1" destination payload expected_payload expected_count actual_count temp_root
  absolute_non_root "$receipt" || return 1
  [[ -f "$receipt" && ! -L "$receipt" ]] || { echo "snapshot receipt is missing or unsafe" >&2; return 1; }
  jq -e '
    .schema == "hepta_vnext_state_snapshot_receipt_v1"
    and .status == "ready"
    and (.source_state_root | startswith("/"))
    and (.destination_state_root | startswith("/"))
    and .source_state_root != .destination_state_root
    and (.legacy_launchd_label | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
    and .legacy_launchd_unloaded == true
    and (.payload_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.source_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.file_count >= 1)
    and .writer_stopped == true
    and .wal_empty == true
    and .source_unchanged == true
    and .destination_exact_copy == true
    and .modes_and_sidecars_preserved == true
    and .service_changed == false
  ' "$receipt" >/dev/null || { echo "invalid state snapshot receipt" >&2; return 1; }
  destination="$(jq -r '.destination_state_root' "$receipt")"
  absolute_non_root "$destination" || return 1
  [[ -d "$destination/runtime-v2" && ! -L "$destination" && ! -L "$destination/runtime-v2" ]] || {
    echo "snapshot destination is missing or unsafe" >&2
    return 1
  }
  [[ "$(cd "$destination" && pwd -P)" == "$destination" ]] || {
    echo "snapshot destination is not a physical canonical directory" >&2
    return 1
  }
  validate_tree_names "$destination/runtime-v2" || return 1
  if find "$destination/runtime-v2" -type l -print -quit | grep -q .; then
    echo "snapshot destination contains a symlink" >&2
    return 1
  fi
  if find "$destination/runtime-v2" ! -type f ! -type d -print -quit | grep -q .; then
    echo "snapshot destination contains a special filesystem entry" >&2
    return 1
  fi
  if find "$destination/runtime-v2" -type f -name '*-wal' -size +0c -print -quit | grep -q .; then
    echo "snapshot destination contains a nonempty SQLite WAL" >&2
    return 1
  fi
  while IFS= read -r item; do
    local mode
    mode="$(stat -f '%Lp' "$item")"
    (( (8#$mode & 077) == 0 )) || { echo "snapshot destination grants group/world permissions: $item" >&2; return 1; }
  done < <(find "$destination/runtime-v2" -print)
  temp_root="${TMPDIR:-/tmp}"; payload="$(mktemp "${temp_root%/}/hepta-state-verify.XXXXXX")"
  trap 'rm -f "${payload:-}"; trap - RETURN' RETURN
  payload_inventory "$destination/runtime-v2" "$payload"
  expected_payload="$(jq -r '.payload_inventory_sha256' "$receipt")"
  [[ "$(sha256_file "$payload")" == "$expected_payload" ]] || {
    echo "snapshot destination inventory differs from receipt" >&2
    return 1
  }
  expected_count="$(jq -r '.file_count' "$receipt")"
  actual_count="$(find "$destination/runtime-v2" -type f | wc -l | tr -d ' ')"
  [[ "$actual_count" == "$expected_count" ]] || { echo "snapshot file count differs from receipt" >&2; return 1; }
  jq -cn --arg receipt "$receipt" --arg receipt_sha256 "$(sha256_file "$receipt")" \
    --arg destination_state_root "$destination" --arg payload_inventory_sha256 "$expected_payload" \
    '{schema:"hepta_vnext_state_snapshot_verification_v1",status:"ready",receipt:$receipt,receipt_sha256:$receipt_sha256,destination_state_root:$destination_state_root,payload_inventory_sha256:$payload_inventory_sha256,destination_unchanged:true,service_changed:false}'
  trap - RETURN
  rm -f "$payload"
}

verify_snapshot_source_v1() {
  local receipt="$1" source legacy_label expected_inventory current_inventory temp_root
  verify_snapshot_receipt_v1 "$receipt" >/dev/null || return 1
  receipt="$(realpath "$receipt")" || return 1
  source="$(jq -r '.source_state_root' "$receipt")" || return 1
  legacy_label="$(jq -r '.legacy_launchd_label' "$receipt")" || return 1
  expected_inventory="$(jq -r '.source_inventory_sha256' "$receipt")" || return 1
  absolute_non_root "$source" || return 1
  [[ -d "$source" && ! -L "$source" && "$(cd "$source" && pwd -P)" == "$source" ]] || {
    echo "snapshot source is missing or no longer physical/canonical" >&2
    return 1
  }
  validate_source "$source/runtime-v2" "$legacy_label" || return 1
  temp_root="${TMPDIR:-/tmp}"
  current_inventory="$(mktemp "${temp_root%/}/hepta-state-source-verify.XXXXXX")" || return 1
  trap 'rm -f "${current_inventory:-}"; trap - RETURN' RETURN
  inventory_tree "$source/runtime-v2" "$current_inventory" || return 1
  [[ "$(sha256_file "$current_inventory")" == "$expected_inventory" ]] || {
    echo "snapshot source changed after materialization" >&2
    return 1
  }
  jq -cn --arg receipt "$receipt" --arg receipt_sha256 "$(sha256_file "$receipt")" \
    --arg source_state_root "$source" --arg source_inventory_sha256 "$expected_inventory" \
    '{schema:"hepta_vnext_state_snapshot_source_verification_v1",status:"ready",receipt:$receipt,receipt_sha256:$receipt_sha256,source_state_root:$source_state_root,source_inventory_sha256:$source_inventory_sha256,legacy_launchd_unloaded:true,no_open_runtime_files:true,source_unchanged:true,service_changed:false}'
  trap - RETURN
  rm -f "$current_inventory"
}

verify_snapshot_receipt_v2() {
  local receipt="$1" destination binding portable expected_portable expected_top expected_sidecar expected_key
  local hardlinks expected_hardlinks actual_count actual_files actual_top actual_sidecars actual_keys actual_hardlink_groups actual_hardlink_aliases temp_root
  absolute_non_root "$receipt" || return 1
  [[ -f "$receipt" && ! -L "$receipt" ]] || {
    echo "snapshot receipt is missing or unsafe" >&2
    return 1
  }
  jq -e '
    .schema == "hepta_vnext_state_snapshot_receipt_v2"
    and .status == "ready"
    and .scope == "full-state-root"
    and (.snapshot_id | test("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"))
    and (.source_state_root | startswith("/"))
    and (.destination_state_root | startswith("/"))
    and .source_state_root != .destination_state_root
    and (.legacy_launchd_label | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
    and .legacy_launchd_unloaded == true
    and (.source_identity_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.portable_payload_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.top_level_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.sqlite_sidecar_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.key_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.hardlink_topology_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.destination_binding | startswith("/"))
    and (.destination_binding_sha256 | test("^[0-9a-f]{64}$"))
    and (.entry_count >= 2) and (.file_count >= 1) and (.top_level_entry_count >= 1)
    and (.sqlite_sidecar_count >= 0) and (.key_file_count >= 0)
    and (.hardlink_group_count >= 0) and (.hardlink_alias_count >= 0)
    and .writer_stopped == true and .wal_empty == true
    and .source_unchanged == true and .destination_exact_copy == true
    and .all_top_level_entries_covered == true
    and .modes_uid_gid_mtime_flags_acl_xattr_preserved == true
    and .wal_shm_and_keys_covered == true and .hardlinks_preserved == true
    and .external_hardlinks_rejected == true and .identity_inventory_separate == true
    and .replay_protected_by_destination_binding == true
    and .service_changed == false
  ' "$receipt" >/dev/null || {
    echo "invalid full-root state snapshot receipt" >&2
    return 1
  }
  destination="$(jq -r '.destination_state_root' "$receipt")"
  binding="$(jq -r '.destination_binding' "$receipt")"
  absolute_non_root "$destination" || return 1
  absolute_non_root "$binding" || return 1
  [[ "$binding" == "$(dirname "$destination")/.$(basename "$destination").hepta-state-snapshot-v2.binding" ]] || {
    echo "snapshot destination binding path is not destination-derived" >&2
    return 1
  }
  [[ -f "$binding" && ! -L "$binding" \
    && "$(sha256_file "$binding")" == "$(jq -r '.destination_binding_sha256' "$receipt")" ]] || {
    echo "snapshot destination binding is missing or changed" >&2
    return 1
  }
  jq -e --arg snapshot_id "$(jq -r '.snapshot_id' "$receipt")" \
    --arg destination "$destination" --arg portable "$(jq -r '.portable_payload_inventory_sha256' "$receipt")" \
    --arg hardlinks "$(jq -r '.hardlink_topology_inventory_sha256' "$receipt")" '
    .schema == "hepta_vnext_state_snapshot_binding_v2"
    and .snapshot_id == $snapshot_id
    and .destination_state_root == $destination
    and .portable_payload_inventory_sha256 == $portable
    and .hardlink_topology_inventory_sha256 == $hardlinks
  ' "$binding" >/dev/null || {
    echo "snapshot destination binding does not match the receipt" >&2
    return 1
  }
  validate_full_tree_v2 "$destination" false "$(jq -r '.legacy_launchd_label' "$receipt")" || return 1
  temp_root="${TMPDIR:-/tmp}"
  portable="$(mktemp "${temp_root%/}/hepta-state-v2-verify.XXXXXX")"
  hardlinks="$(mktemp "${temp_root%/}/hepta-state-v2-hardlinks-verify.XXXXXX")"
  trap 'rm -f "${portable:-}" "${hardlinks:-}"; trap - RETURN' RETURN
  portable_inventory_v2 "$destination" "$portable"
  hardlink_topology_inventory_v2 "$destination" "$hardlinks"
  expected_portable="$(jq -r '.portable_payload_inventory_sha256' "$receipt")"
  expected_top="$(jq -r '.top_level_inventory_sha256' "$receipt")"
  expected_sidecar="$(jq -r '.sqlite_sidecar_inventory_sha256' "$receipt")"
  expected_key="$(jq -r '.key_inventory_sha256' "$receipt")"
  expected_hardlinks="$(jq -r '.hardlink_topology_inventory_sha256' "$receipt")"
  [[ "$(sha256_file "$portable")" == "$expected_portable" \
    && "$(top_level_inventory_sha256 "$portable")" == "$expected_top" \
    && "$(inventory_subset_sha256 "$portable" '\\-(wal|shm)$')" == "$expected_sidecar" \
    && "$(inventory_subset_sha256 "$portable" '(^|/)keys/|\\.key$')" == "$expected_key" \
    && "$(sha256_file "$hardlinks")" == "$expected_hardlinks" ]] || {
    echo "full snapshot portable, top-level, sidecar, key, or hardlink inventory differs from receipt" >&2
    return 1
  }
  actual_count="$(find "$destination" -print | wc -l | tr -d ' ')"
  actual_files="$(find "$destination" -type f | wc -l | tr -d ' ')"
  actual_top="$(find "$destination" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d ' ')"
  actual_sidecars="$(find "$destination" -type f \( -name '*-wal' -o -name '*-shm' \) | wc -l | tr -d ' ')"
  actual_keys="$(find "$destination" -type f \( -path '*/keys/*' -o -name '*.key' \) | wc -l | tr -d ' ')"
  actual_hardlink_groups="$(awk -F '|' '$1 == $2 && $3 > 1 { count += 1 } END { print count + 0 }' "$hardlinks")"
  actual_hardlink_aliases="$(awk -F '|' '$1 != $2 { count += 1 } END { print count + 0 }' "$hardlinks")"
  [[ "$actual_count" == "$(jq -r '.entry_count' "$receipt")" \
    && "$actual_files" == "$(jq -r '.file_count' "$receipt")" \
    && "$actual_top" == "$(jq -r '.top_level_entry_count' "$receipt")" \
    && "$actual_sidecars" == "$(jq -r '.sqlite_sidecar_count' "$receipt")" \
    && "$actual_keys" == "$(jq -r '.key_file_count' "$receipt")" \
    && "$actual_hardlink_groups" == "$(jq -r '.hardlink_group_count' "$receipt")" \
    && "$actual_hardlink_aliases" == "$(jq -r '.hardlink_alias_count' "$receipt")" ]] || {
    echo "full snapshot entry counters differ from receipt" >&2
    return 1
  }
  jq -cn --arg receipt "$receipt" --arg receipt_sha256 "$(sha256_file "$receipt")" \
    --arg snapshot_id "$(jq -r '.snapshot_id' "$receipt")" --arg destination "$destination" \
    --arg portable "$expected_portable" --arg top "$expected_top" --arg hardlinks "$expected_hardlinks" \
    '{schema:"hepta_vnext_state_snapshot_verification_v2",status:"ready",scope:"full-state-root",receipt:$receipt,receipt_sha256:$receipt_sha256,snapshot_id:$snapshot_id,destination_state_root:$destination,portable_payload_inventory_sha256:$portable,top_level_inventory_sha256:$top,hardlink_topology_inventory_sha256:$hardlinks,all_top_level_entries_covered:true,hardlinks_preserved:true,destination_unchanged:true,replay_binding_verified:true,service_changed:false}'
  trap - RETURN
  rm -f "$portable" "$hardlinks"
}

verify_snapshot_source_v2() {
  local receipt="$1" source legacy_label expected_identity current_identity temp_root
  verify_snapshot_receipt_v2 "$receipt" >/dev/null || return 1
  receipt="$(realpath "$receipt")" || return 1
  source="$(jq -r '.source_state_root' "$receipt")"
  legacy_label="$(jq -r '.legacy_launchd_label' "$receipt")"
  expected_identity="$(jq -r '.source_identity_inventory_sha256' "$receipt")"
  absolute_non_root "$source" || return 1
  validate_full_tree_v2 "$source" true "$legacy_label" || return 1
  temp_root="${TMPDIR:-/tmp}"
  current_identity="$(mktemp "${temp_root%/}/hepta-state-v2-source-verify.XXXXXX")"
  trap 'rm -f "${current_identity:-}"; trap - RETURN' RETURN
  identity_inventory_v2 "$source" "$current_identity"
  [[ "$(sha256_file "$current_identity")" == "$expected_identity" ]] || {
    echo "full snapshot source identity changed after materialization" >&2
    return 1
  }
  jq -cn --arg receipt "$receipt" --arg receipt_sha256 "$(sha256_file "$receipt")" \
    --arg snapshot_id "$(jq -r '.snapshot_id' "$receipt")" --arg source "$source" \
    --arg identity "$expected_identity" \
    '{schema:"hepta_vnext_state_snapshot_source_verification_v2",status:"ready",scope:"full-state-root",receipt:$receipt,receipt_sha256:$receipt_sha256,snapshot_id:$snapshot_id,source_state_root:$source,source_identity_inventory_sha256:$identity,legacy_launchd_unloaded:true,no_open_state_files:true,source_unchanged:true,service_changed:false}'
  trap - RETURN
  rm -f "$current_identity"
}

verify_snapshot_receipt_v3() {
  local receipt="$1" destination binding portable modes acls expected_portable expected_modes expected_acls expected_top expected_sidecar expected_key
  local hardlinks expected_hardlinks actual_count actual_files actual_top actual_sidecars actual_keys actual_hardlink_groups actual_hardlink_aliases temp_root
  local predecessor_receipt predecessor_sha predecessor_plan predecessor_sequence
  local source legacy_label barrier_receipt barrier_sha barrier_exempt
  absolute_non_root "$receipt" || return 1
  [[ -f "$receipt" && ! -L "$receipt" ]] || {
    echo "snapshot receipt is missing or unsafe" >&2
    return 1
  }
  validate_private_artifact_v3 "$receipt" || return 1
  jq -e --arg profile "$SNAPSHOT_PROFILE_V3" --arg mode_profile "$MODE_PROFILE_V3" --arg acl_profile "$ACL_PROFILE_V3" '
    .schema == "hepta_vnext_state_snapshot_receipt_v3"
    and .profile == $profile and .mode_profile == $mode_profile and .acl_profile == $acl_profile
    and .status == "ready" and .scope == "full-state-root"
    and (.snapshot_id | test("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"))
    and (.source_state_root | startswith("/"))
    and (.destination_state_root | startswith("/"))
    and .source_state_root != .destination_state_root
    and (.legacy_launchd_label | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
    and .legacy_launchd_unloaded == true
    and .writer_admission_closed == true
    and (.writer_barrier.schema == "hepta_vnext_writer_barrier_v1" or .writer_barrier.schema == "hepta_vnext_writer_barrier_self_test_exemption_v1")
    and .writer_barrier.writer_admission_closed == true
    and (.writer_barrier.self_test_exemption | type == "boolean")
    and (if .writer_barrier.self_test_exemption then
      .writer_barrier.receipt == null and .writer_barrier.sha256 == null
    else
      (.writer_barrier.receipt | startswith("/")) and (.writer_barrier.sha256 | test("^[0-9a-f]{64}$"))
    end)
    and (.source_identity_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.portable_payload_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.original_mode_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.acl_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.top_level_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.sqlite_sidecar_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.key_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.hardlink_topology_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.destination_binding | startswith("/"))
    and (.destination_binding_sha256 | test("^[0-9a-f]{64}$"))
    and (.entry_count >= 2) and (.file_count >= 1) and (.top_level_entry_count >= 1)
    and (.sqlite_sidecar_count >= 0) and (.key_file_count >= 0)
    and (.hardlink_group_count >= 0) and (.hardlink_alias_count >= 0)
    and .writer_stopped == true and .wal_empty == true
    and .source_unchanged == true and .destination_exact_copy == true
    and .all_top_level_entries_covered == true
    and .regular_file_mode_contract == {allowed_modes:["0400","0444","0500","0600"],exact_allowlist:true}
    and .directory_mode_contract == {allowed_modes:["0700"],exact_allowlist:true}
    and .mode_policy_validated == true and .original_modes_preserved == true
    and .acl_allow_aces_forbidden == true and .acl_deny_only_preserved == true
    and .acl_inventory_bound == true
    and .modes_uid_gid_mtime_flags_acl_xattr_preserved == true
    and .wal_shm_and_keys_covered == true and .hardlinks_preserved == true
    and .external_hardlinks_rejected == true and .identity_inventory_separate == true
    and .replay_protected_by_destination_binding == true
    and .atomic_no_replace_publication == true and .durable_publication == true
    and .final_source_rescan == true
    and ((.recutover_predecessor == null) or
      ((.recutover_predecessor.receipt | startswith("/"))
      and (.recutover_predecessor.sha256 | test("^[0-9a-f]{64}$"))
      and (.recutover_predecessor.plan_sha256 | test("^[0-9a-f]{64}$"))
      and (.recutover_predecessor.sequence | type == "number" and . >= 2 and . == floor)))
    and .service_changed == false
  ' "$receipt" >/dev/null || {
    echo "invalid full-root v3 state snapshot receipt" >&2
    return 1
  }
  source="$(jq -r '.source_state_root' "$receipt")"
  legacy_label="$(jq -r '.legacy_launchd_label' "$receipt")"
  barrier_exempt="$(jq -r '.writer_barrier.self_test_exemption' "$receipt")"
  if [[ "$barrier_exempt" == true ]]; then
    writer_barrier_self_test_exempt_v3 "$source" "$legacy_label" || {
      echo "snapshot writer barrier self-test exemption escaped its isolated root" >&2
      return 1
    }
  else
    barrier_receipt="$(jq -r '.writer_barrier.receipt' "$receipt")"
    barrier_sha="$(jq -r '.writer_barrier.sha256' "$receipt")"
    absolute_non_root "$barrier_receipt" || return 1
    [[ "$(realpath "$barrier_receipt")" == "$barrier_receipt" \
      && -f "$barrier_receipt" && ! -L "$barrier_receipt" \
      && "$(sha256_file "$barrier_receipt")" == "$barrier_sha" ]] || {
      echo "snapshot writer barrier receipt path or digest changed" >&2
      return 1
    }
    jq -e --arg source "$source" --arg legacy_label "$legacy_label" '
      .schema == "hepta_vnext_writer_barrier_v1" and .status == "ready"
      and .state_root == $source and .legacy_label == $legacy_label
      and (.legacy_labels | type == "array" and length >= 1 and index($legacy_label) != null)
      and .launchd_unloaded == true and .state_root_quiescent == true
      and .writer_admission_closed == true and .system_immutable == true
      and .sealed_mode == "0400" and (.program_sha256 | test("^[0-9a-f]{64}$"))
    ' "$barrier_receipt" >/dev/null || {
      echo "snapshot writer barrier receipt does not statically bind the source" >&2
      return 1
    }
  fi
  destination="$(jq -r '.destination_state_root' "$receipt")"
  binding="$(jq -r '.destination_binding' "$receipt")"
  absolute_non_root "$destination" || return 1
  absolute_non_root "$binding" || return 1
  [[ "$binding" == "$(dirname "$destination")/.$(basename "$destination").hepta-state-snapshot-v3.binding" ]] || {
    echo "snapshot v3 destination binding path is not destination-derived" >&2
    return 1
  }
  [[ -f "$binding" && ! -L "$binding" \
    && "$(sha256_file "$binding")" == "$(jq -r '.destination_binding_sha256' "$receipt")" ]] || {
    echo "snapshot destination binding is missing or changed" >&2
    return 1
  }
  validate_private_artifact_v3 "$binding" || return 1
  jq -e --arg profile "$SNAPSHOT_PROFILE_V3" --arg mode_profile "$MODE_PROFILE_V3" --arg acl_profile "$ACL_PROFILE_V3" \
    --arg snapshot_id "$(jq -r '.snapshot_id' "$receipt")" \
    --arg destination "$destination" --arg portable "$(jq -r '.portable_payload_inventory_sha256' "$receipt")" \
    --arg modes "$(jq -r '.original_mode_inventory_sha256' "$receipt")" \
    --arg acls "$(jq -r '.acl_inventory_sha256' "$receipt")" \
    --arg hardlinks "$(jq -r '.hardlink_topology_inventory_sha256' "$receipt")" '
    .schema == "hepta_vnext_state_snapshot_binding_v3"
    and .profile == $profile and .mode_profile == $mode_profile and .acl_profile == $acl_profile
    and .snapshot_id == $snapshot_id
    and .destination_state_root == $destination
    and .portable_payload_inventory_sha256 == $portable
    and .original_mode_inventory_sha256 == $modes
    and .acl_inventory_sha256 == $acls
    and .hardlink_topology_inventory_sha256 == $hardlinks
    and .acl_allow_aces_forbidden == true and .acl_deny_only_preserved == true
  ' "$binding" >/dev/null || {
    echo "snapshot v3 destination binding does not match the receipt" >&2
    return 1
  }
  validate_full_tree_v3 "$destination" false "$(jq -r '.legacy_launchd_label' "$receipt")" || return 1
  temp_root="${TMPDIR:-/tmp}"
  portable="$(mktemp "${temp_root%/}/hepta-state-v3-verify.XXXXXX")"
  modes="$(mktemp "${temp_root%/}/hepta-state-v3-modes-verify.XXXXXX")"
  acls="$(mktemp "${temp_root%/}/hepta-state-v3-acls-verify.XXXXXX")"
  hardlinks="$(mktemp "${temp_root%/}/hepta-state-v3-hardlinks-verify.XXXXXX")"
  trap 'rm -f "${portable:-}" "${modes:-}" "${acls:-}" "${hardlinks:-}"; trap - RETURN' RETURN
  portable_inventory_v3 "$destination" "$portable" || return 1
  mode_inventory_v3 "$destination" "$modes" || return 1
  acl_inventory_v3 "$destination" "$acls" || return 1
  hardlink_topology_inventory_v3 "$destination" "$hardlinks" || return 1
  expected_portable="$(jq -r '.portable_payload_inventory_sha256' "$receipt")"
  expected_modes="$(jq -r '.original_mode_inventory_sha256' "$receipt")"
  expected_acls="$(jq -r '.acl_inventory_sha256' "$receipt")"
  expected_top="$(jq -r '.top_level_inventory_sha256' "$receipt")"
  expected_sidecar="$(jq -r '.sqlite_sidecar_inventory_sha256' "$receipt")"
  expected_key="$(jq -r '.key_inventory_sha256' "$receipt")"
  expected_hardlinks="$(jq -r '.hardlink_topology_inventory_sha256' "$receipt")"
  [[ "$(sha256_file "$portable")" == "$expected_portable" \
    && "$(sha256_file "$modes")" == "$expected_modes" \
    && "$(sha256_file "$acls")" == "$expected_acls" \
    && "$(top_level_inventory_sha256 "$portable")" == "$expected_top" \
    && "$(inventory_subset_sha256 "$portable" '\\-(wal|shm)$')" == "$expected_sidecar" \
    && "$(inventory_subset_sha256 "$portable" '(^|/)keys/|\\.key$')" == "$expected_key" \
    && "$(sha256_file "$hardlinks")" == "$expected_hardlinks" ]] || {
    echo "full snapshot portable, mode, top-level, sidecar, key, or hardlink inventory differs from receipt" >&2
    return 1
  }
  if [[ "$(jq -r '.recutover_predecessor == null' "$receipt")" != true ]]; then
    predecessor_receipt="$(jq -r '.recutover_predecessor.receipt' "$receipt")"
    predecessor_sha="$(jq -r '.recutover_predecessor.sha256' "$receipt")"
    predecessor_plan="$(jq -r '.recutover_predecessor.plan_sha256' "$receipt")"
    predecessor_sequence="$(jq -r '.recutover_predecessor.sequence' "$receipt")"
    absolute_non_root "$predecessor_receipt" || return 1
    [[ "$(realpath "$predecessor_receipt")" == "$predecessor_receipt" \
      && -f "$predecessor_receipt" && ! -L "$predecessor_receipt" \
      && "$(sha256_file "$predecessor_receipt")" == "$predecessor_sha" ]] || {
      echo "snapshot recutover predecessor path or digest changed" >&2
      return 1
    }
    jq -e --arg plan "$predecessor_plan" --argjson sequence "$predecessor_sequence" '
      (.schema == "hepta_vnext_launchd_bridge_transition_v1" or .schema == "hepta_vnext_launchd_bridge_transition_v2")
      and .status == "ready" and .transition == "rollback"
      and .plan_sha256 == $plan and .sequence == $sequence
      and .applied == true and .chain_head_committed == true
    ' "$predecessor_receipt" >/dev/null || {
      echo "snapshot recutover predecessor fields differ from the bound rollback" >&2
      return 1
    }
  fi
  actual_count="$(find "$destination" -print | wc -l | tr -d ' ')"
  actual_files="$(find "$destination" -type f | wc -l | tr -d ' ')"
  actual_top="$(find "$destination" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d ' ')"
  actual_sidecars="$(find "$destination" -type f \( -name '*-wal' -o -name '*-shm' \) | wc -l | tr -d ' ')"
  actual_keys="$(find "$destination" -type f \( -path '*/keys/*' -o -name '*.key' \) | wc -l | tr -d ' ')"
  actual_hardlink_groups="$(awk -F '|' '$1 == $2 && $3 > 1 { count += 1 } END { print count + 0 }' "$hardlinks")"
  actual_hardlink_aliases="$(awk -F '|' '$1 != $2 { count += 1 } END { print count + 0 }' "$hardlinks")"
  [[ "$actual_count" == "$(jq -r '.entry_count' "$receipt")" \
    && "$actual_files" == "$(jq -r '.file_count' "$receipt")" \
    && "$actual_top" == "$(jq -r '.top_level_entry_count' "$receipt")" \
    && "$actual_sidecars" == "$(jq -r '.sqlite_sidecar_count' "$receipt")" \
    && "$actual_keys" == "$(jq -r '.key_file_count' "$receipt")" \
    && "$actual_hardlink_groups" == "$(jq -r '.hardlink_group_count' "$receipt")" \
    && "$actual_hardlink_aliases" == "$(jq -r '.hardlink_alias_count' "$receipt")" ]] || {
    echo "full snapshot entry counters differ from receipt" >&2
    return 1
  }
  jq -cn --arg receipt "$receipt" --arg receipt_sha256 "$(sha256_file "$receipt")" \
    --arg profile "$SNAPSHOT_PROFILE_V3" --arg mode_profile "$MODE_PROFILE_V3" --arg acl_profile "$ACL_PROFILE_V3" \
    --arg snapshot_id "$(jq -r '.snapshot_id' "$receipt")" --arg destination "$destination" \
    --arg portable "$expected_portable" --arg modes "$expected_modes" --arg acls "$expected_acls" --arg top "$expected_top" --arg hardlinks "$expected_hardlinks" \
    '{schema:"hepta_vnext_state_snapshot_verification_v3",profile:$profile,mode_profile:$mode_profile,acl_profile:$acl_profile,status:"ready",scope:"full-state-root",receipt:$receipt,receipt_sha256:$receipt_sha256,snapshot_id:$snapshot_id,destination_state_root:$destination,portable_payload_inventory_sha256:$portable,original_mode_inventory_sha256:$modes,acl_inventory_sha256:$acls,top_level_inventory_sha256:$top,hardlink_topology_inventory_sha256:$hardlinks,all_top_level_entries_covered:true,original_modes_preserved:true,acl_deny_only_preserved:true,hardlinks_preserved:true,destination_unchanged:true,replay_binding_verified:true,service_changed:false}'
  trap - RETURN
  rm -f "$portable" "$modes" "$acls" "$hardlinks"
}

verify_snapshot_source_v3() {
  local receipt="$1" source legacy_label expected_identity expected_modes expected_acls current_identity current_modes current_acls temp_root
  verify_snapshot_receipt_v3 "$receipt" >/dev/null || return 1
  receipt="$(realpath "$receipt")" || return 1
  source="$(jq -r '.source_state_root' "$receipt")"
  legacy_label="$(jq -r '.legacy_launchd_label' "$receipt")"
  expected_identity="$(jq -r '.source_identity_inventory_sha256' "$receipt")"
  expected_modes="$(jq -r '.original_mode_inventory_sha256' "$receipt")"
  expected_acls="$(jq -r '.acl_inventory_sha256' "$receipt")"
  if [[ "$(jq -r '.writer_barrier.self_test_exemption' "$receipt")" != true ]]; then
    verify_writer_barrier_v3 "$(jq -r '.writer_barrier.receipt' "$receipt")" "$source" "$legacy_label" || return 1
  fi
  absolute_non_root "$source" || return 1
  validate_full_tree_v3 "$source" true "$legacy_label" || return 1
  temp_root="${TMPDIR:-/tmp}"
  current_identity="$(mktemp "${temp_root%/}/hepta-state-v3-source-verify.XXXXXX")"
  current_modes="$(mktemp "${temp_root%/}/hepta-state-v3-source-modes-verify.XXXXXX")"
  current_acls="$(mktemp "${temp_root%/}/hepta-state-v3-source-acls-verify.XXXXXX")"
  trap 'rm -f "${current_identity:-}" "${current_modes:-}" "${current_acls:-}"; trap - RETURN' RETURN
  identity_inventory_v3 "$source" "$current_identity" || return 1
  mode_inventory_v3 "$source" "$current_modes" || return 1
  acl_inventory_v3 "$source" "$current_acls" || return 1
  [[ "$(sha256_file "$current_identity")" == "$expected_identity" \
    && "$(sha256_file "$current_modes")" == "$expected_modes" \
    && "$(sha256_file "$current_acls")" == "$expected_acls" ]] || {
    echo "full snapshot source identity, original modes, or ACLs changed after materialization" >&2
    return 1
  }
  jq -cn --arg receipt "$receipt" --arg receipt_sha256 "$(sha256_file "$receipt")" \
    --arg profile "$SNAPSHOT_PROFILE_V3" --arg mode_profile "$MODE_PROFILE_V3" --arg acl_profile "$ACL_PROFILE_V3" \
    --arg snapshot_id "$(jq -r '.snapshot_id' "$receipt")" --arg source "$source" \
    --arg identity "$expected_identity" --arg modes "$expected_modes" --arg acls "$expected_acls" \
    '{schema:"hepta_vnext_state_snapshot_source_verification_v3",profile:$profile,mode_profile:$mode_profile,acl_profile:$acl_profile,status:"ready",scope:"full-state-root",receipt:$receipt,receipt_sha256:$receipt_sha256,snapshot_id:$snapshot_id,source_state_root:$source,source_identity_inventory_sha256:$identity,original_mode_inventory_sha256:$modes,acl_inventory_sha256:$acls,legacy_launchd_unloaded:true,no_open_state_files:true,source_unchanged:true,original_modes_unchanged:true,acl_deny_only_unchanged:true,service_changed:false}'
  trap - RETURN
  rm -f "$current_identity" "$current_modes" "$current_acls"
}

verify_snapshot_receipt() {
  local schema
  schema="$(jq -r '.schema // empty' "$1" 2>/dev/null || true)"
  case "$schema" in
    hepta_vnext_state_snapshot_receipt_v1) verify_snapshot_receipt_v1 "$1" ;;
    hepta_vnext_state_snapshot_receipt_v2) verify_snapshot_receipt_v2 "$1" ;;
    hepta_vnext_state_snapshot_receipt_v3) verify_snapshot_receipt_v3 "$1" ;;
    *) echo "unsupported state snapshot receipt schema" >&2; return 1 ;;
  esac
}

verify_snapshot_source() {
  local schema
  schema="$(jq -r '.schema // empty' "$1" 2>/dev/null || true)"
  case "$schema" in
    hepta_vnext_state_snapshot_receipt_v1) verify_snapshot_source_v1 "$1" ;;
    hepta_vnext_state_snapshot_receipt_v2) verify_snapshot_source_v2 "$1" ;;
    hepta_vnext_state_snapshot_receipt_v3) verify_snapshot_source_v3 "$1" ;;
    *) echo "unsupported state snapshot receipt schema" >&2; return 1 ;;
  esac
}

self_test() {
  local temp_root root source destination receipt bad_source bad_symlink bad_special bad_delimiter
  local replay_destination replay_receipt v1_source v1_destination v1_receipt primary alias other_primary other_alias split_tmp
  local readonly_file executable_file bad_mode_0466 bad_mode_0644 bad_mode_0646 bad_mode_group_exec bad_mode_world_exec bad_mode_owner_read_missing bad_mode_special bad_mode_directory bad_mode_directory_special tampered_receipt
  local mode_source mode_destination mode_receipt private_0400 private_0600
  local concurrent_source concurrent_destination concurrent_receipt_a concurrent_receipt_b concurrent_pid_a concurrent_pid_b concurrent_rc_a concurrent_rc_b winner_receipt
  local interrupt_kind interrupt_source interrupt_destination interrupt_receipt interrupt_binding interrupt_lock interrupt_rc quarantine_dir recovery_receipt
  local allow_file_source allow_directory_source unreadable_xattr_source unreadable_xattr_receipt
  temp_root="${TMPDIR:-/tmp}"; root="$(mktemp -d "${temp_root%/}/hepta-state-snapshot-self-test.XXXXXX")"
  HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT="$root"
  trap 'chflags -R nouchg,noschg "$HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT" 2>/dev/null || true; chmod -RN "$HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT" 2>/dev/null || true; chmod -R u+w "$HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT" 2>/dev/null || true; rm -rf "$HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT"' EXIT
  source="$root/legacy"; destination="$root/vnext/live-snapshot"; receipt="$root/receipts/snapshot.json"
  mkdir -p "$source/runtime-v2/keys" "$source/archive" "$source/release-runs/20260812"
  chmod 0700 "$source" "$source/runtime-v2" "$source/runtime-v2/keys" "$source/archive" "$source/release-runs" "$source/release-runs/20260812"
  printf 'fixture\n' >"$source/runtime-v2/runtime-state.json"; chmod 0600 "$source/runtime-v2/runtime-state.json"
  : >"$source/runtime-v2/outcomes.sqlite3-wal"; chmod 0600 "$source/runtime-v2/outcomes.sqlite3-wal"
  printf 'shared-memory-sidecar\n' >"$source/runtime-v2/outcomes.sqlite3-shm"; chmod 0600 "$source/runtime-v2/outcomes.sqlite3-shm"
  printf 'key-material\n' >"$source/runtime-v2/keys/runtime-integrity.key"; chmod 0600 "$source/runtime-v2/keys/runtime-integrity.key"
  printf 'archive-payload\n' >"$source/archive/record.json"; chmod 0600 "$source/archive/record.json"
  printf 'run-payload\n' >"$source/release-runs/20260812/run.json"; chmod 0600 "$source/release-runs/20260812/run.json"
  readonly_file="$source/archive/readonly-0444.json"
  executable_file="$source/release-runs/20260812/owner-executable-0500.py"
  private_0400="$source/archive/private-0400.json"
  private_0600="$source/archive/private-0600.json"
  printf 'readonly-mode-fixture\n' >"$readonly_file"; chmod 0444 "$readonly_file"
  printf 'owner-executable-mode-fixture\n' >"$executable_file"; chmod 0500 "$executable_file"
  printf 'owner-read-mode-fixture\n' >"$private_0400"; chmod 0400 "$private_0400"
  printf 'owner-read-write-mode-fixture\n' >"$private_0600"; chmod 0600 "$private_0600"
  primary="$source/archive/shared-a.bin"; alias="$source/release-runs/20260812/shared-a-alias.bin"
  other_primary="$source/archive/shared-b.bin"; other_alias="$source/release-runs/20260812/shared-b-alias.bin"
  printf 'hardlink-payload\n' >"$primary"; chmod 0600 "$primary"; ln "$primary" "$alias"
  printf 'hardlink-payload\n' >"$other_primary"; chmod 0600 "$other_primary"; touch -r "$primary" "$other_primary"; ln "$other_primary" "$other_alias"
  /usr/bin/xattr -w com.hepta.snapshot.selftest 'xattr-payload' "$source/archive/record.json"
  chmod +a 'everyone deny delete' "$source/archive/record.json"
  chmod +a 'everyone deny delete' "$source/archive"
  chflags hidden "$source/release-runs/20260812/run.json"
  snapshot "$source" "$destination" "$receipt" true ai.hepta.snapshot.selftest >/dev/null
  verify_snapshot_receipt "$receipt" >/dev/null
  verify_snapshot_source "$receipt" >/dev/null
  jq -e '
    .schema == "hepta_vnext_state_snapshot_receipt_v3"
    and .profile == "full-state-root-v3"
    and .mode_profile == "hepta_vnext_state_mode_profile_v3"
    and .scope == "full-state-root"
    and .status == "ready"
    and .destination_exact_copy == true and .source_unchanged == true
    and .all_top_level_entries_covered == true
    and (.original_mode_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and .regular_file_mode_contract == {allowed_modes:["0400","0444","0500","0600"],exact_allowlist:true}
    and .directory_mode_contract == {allowed_modes:["0700"],exact_allowlist:true}
    and .mode_policy_validated == true and .original_modes_preserved == true
    and .modes_uid_gid_mtime_flags_acl_xattr_preserved == true
    and .wal_shm_and_keys_covered == true
    and .top_level_entry_count == 3
    and .sqlite_sidecar_count == 2
    and .key_file_count == 1
    and .hardlink_group_count == 2 and .hardlink_alias_count == 2
    and .hardlinks_preserved == true and .external_hardlinks_rejected == true
    and .replay_protected_by_destination_binding == true
  ' "$receipt" >/dev/null
  [[ "$(/usr/bin/xattr -p com.hepta.snapshot.selftest "$destination/archive/record.json")" == xattr-payload \
    && "$(stat -f '%f' "$destination/release-runs/20260812/run.json")" == "$(stat -f '%f' "$source/release-runs/20260812/run.json")" \
    && "$(stat -f '%Lp' "$destination/archive/readonly-0444.json")" == 444 \
    && "$(stat -f '%Lp' "$destination/release-runs/20260812/owner-executable-0500.py")" == 500 \
    && "$(stat -f '%Lp' "$destination/archive/private-0400.json")" == 400 \
    && "$(stat -f '%Lp' "$destination/archive/private-0600.json")" == 600 \
    && -s "$destination/runtime-v2/outcomes.sqlite3-shm" \
    && -s "$destination/runtime-v2/keys/runtime-integrity.key" \
    && "$(acl_sha256 "$destination/archive/record.json")" == "$(acl_sha256 "$source/archive/record.json")" \
    && "$(acl_sha256 "$destination/archive")" == "$(acl_sha256 "$source/archive")" ]] || {
    echo "full-root metadata, sidecar, or key payload was not preserved" >&2
    exit 1
  }
  [[ "$(stat -f '%i' "$destination/archive/shared-a.bin")" == "$(stat -f '%i' "$destination/release-runs/20260812/shared-a-alias.bin")" \
    && "$(stat -f '%l' "$destination/archive/shared-a.bin")" == 2 \
    && "$(stat -f '%i' "$destination/archive/shared-b.bin")" == "$(stat -f '%i' "$destination/release-runs/20260812/shared-b-alias.bin")" \
    && "$(stat -f '%l' "$destination/archive/shared-b.bin")" == 2 ]] || {
    echo "full-root hardlink groups were not preserved" >&2
    exit 1
  }
  split_tmp="$root/split-hardlink.bin"
  /usr/bin/ditto "$destination/release-runs/20260812/shared-a-alias.bin" "$split_tmp"
  rm "$destination/release-runs/20260812/shared-a-alias.bin"
  mv "$split_tmp" "$destination/release-runs/20260812/shared-a-alias.bin"
  if verify_snapshot_receipt "$receipt" >/dev/null 2>&1; then
    echo "full snapshot accepted a split hardlink group" >&2
    exit 1
  fi
  rm "$destination/release-runs/20260812/shared-a-alias.bin"
  ln "$destination/archive/shared-a.bin" "$destination/release-runs/20260812/shared-a-alias.bin"
  touch -r "$source/release-runs/20260812" "$destination/release-runs/20260812"
  verify_snapshot_receipt "$receipt" >/dev/null
  chmod -a# 0 "$destination/archive/record.json"
  if verify_snapshot_receipt "$receipt" >/dev/null 2>&1; then
    echo "full snapshot accepted removal of a bound deny ACL" >&2
    exit 1
  fi
  chmod +a 'everyone deny delete' "$destination/archive/record.json"
  verify_snapshot_receipt "$receipt" >/dev/null
  chmod +a 'everyone allow read' "$(jq -r '.destination_binding' "$receipt")"
  if verify_snapshot_receipt "$receipt" >/dev/null 2>&1; then
    echo "snapshot accepted an allow ACL on its destination binding" >&2
    exit 1
  fi
  chmod -RN "$(jq -r '.destination_binding' "$receipt")"
  verify_snapshot_receipt "$receipt" >/dev/null
  chmod 0644 "$destination/archive/readonly-0444.json"
  if verify_snapshot_receipt "$receipt" >/dev/null 2>&1; then
    echo "full snapshot accepted a preserved-mode tamper to another allowed mode" >&2
    exit 1
  fi
  chmod 0444 "$destination/archive/readonly-0444.json"
  verify_snapshot_receipt "$receipt" >/dev/null
  tampered_receipt="$root/receipts/tampered-mode-contract.json"
  jq '.regular_file_mode_contract.allowed_modes[2] = "0510"' "$receipt" >"$tampered_receipt"
  chmod 0400 "$tampered_receipt"
  if verify_snapshot_receipt "$tampered_receipt" >/dev/null 2>&1; then
    echo "snapshot accepted a tampered v3 mode contract" >&2
    exit 1
  fi
  rm "$destination/release-runs/20260812/shared-a-alias.bin"
  ln "$destination/archive/shared-b.bin" "$destination/release-runs/20260812/shared-a-alias.bin"
  if verify_snapshot_receipt "$receipt" >/dev/null 2>&1; then
    echo "full snapshot accepted a hardlink alias rebound to the wrong group" >&2
    exit 1
  fi
  rm "$destination/release-runs/20260812/shared-a-alias.bin"
  ln "$destination/archive/shared-a.bin" "$destination/release-runs/20260812/shared-a-alias.bin"
  touch -r "$source/release-runs/20260812" "$destination/release-runs/20260812"
  verify_snapshot_receipt "$receipt" >/dev/null
  bad_source="$root/legacy-nonempty-wal"
  mkdir -p "$bad_source/runtime-v2"; chmod 0700 "$bad_source" "$bad_source/runtime-v2"
  printf 'not-empty\n' >"$bad_source/runtime-v2/outcomes.sqlite3-wal"; chmod 0600 "$bad_source/runtime-v2/outcomes.sqlite3-wal"
  if snapshot "$bad_source" "$root/rejected" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "nonempty WAL was accepted" >&2
    exit 1
  fi
  if snapshot "$source" "$root/rejected-nested" "$source/receipt.json" true ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "receipt inside source state was accepted" >&2
    exit 1
  fi
  bad_symlink="$root/legacy-symlink"; mkdir -p "$bad_symlink/runtime-v2"; chmod 0700 "$bad_symlink" "$bad_symlink/runtime-v2"
  ln -s "$root" "$bad_symlink/archive"
  if snapshot "$bad_symlink" "$root/rejected-symlink" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "full-root symlink was accepted" >&2
    exit 1
  fi
  bad_special="$root/legacy-special"; mkdir -p "$bad_special/runtime-v2"; chmod 0700 "$bad_special" "$bad_special/runtime-v2"
  mkfifo "$bad_special/runtime-v2/fifo"; chmod 0600 "$bad_special/runtime-v2/fifo"
  if snapshot "$bad_special" "$root/rejected-special" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "full-root special filesystem entry was accepted" >&2
    exit 1
  fi
  bad_delimiter="$root/legacy-delimiter"; mkdir -p "$bad_delimiter/runtime-v2"; chmod 0700 "$bad_delimiter" "$bad_delimiter/runtime-v2"
  printf 'bad\n' >"$bad_delimiter/bad|name"; chmod 0600 "$bad_delimiter/bad|name"
  if snapshot "$bad_delimiter" "$root/rejected-delimiter" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "full-root delimiter path was accepted" >&2
    exit 1
  fi
  bad_mode_0466="$root/legacy-mode-0466"; mkdir -p "$bad_mode_0466/runtime-v2"; chmod 0700 "$bad_mode_0466" "$bad_mode_0466/runtime-v2"
  printf 'bad-mode\n' >"$bad_mode_0466/runtime-v2/file"; chmod 0466 "$bad_mode_0466/runtime-v2/file"
  if snapshot "$bad_mode_0466" "$root/rejected-mode-0466" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "regular file mode 0466 was accepted" >&2
    exit 1
  fi
  bad_mode_0644="$root/legacy-mode-0644"; mkdir -p "$bad_mode_0644/runtime-v2"; chmod 0700 "$bad_mode_0644" "$bad_mode_0644/runtime-v2"
  printf 'bad-mode\n' >"$bad_mode_0644/runtime-v2/file"; chmod 0644 "$bad_mode_0644/runtime-v2/file"
  if snapshot "$bad_mode_0644" "$root/rejected-mode-0644" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "regular file mode 0644 was accepted" >&2
    exit 1
  fi
  bad_mode_0646="$root/legacy-mode-0646"; mkdir -p "$bad_mode_0646/runtime-v2"; chmod 0700 "$bad_mode_0646" "$bad_mode_0646/runtime-v2"
  printf 'bad-mode\n' >"$bad_mode_0646/runtime-v2/file"; chmod 0646 "$bad_mode_0646/runtime-v2/file"
  if snapshot "$bad_mode_0646" "$root/rejected-mode-0646" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "regular file mode 0646 was accepted" >&2
    exit 1
  fi
  bad_mode_group_exec="$root/legacy-mode-group-exec"; mkdir -p "$bad_mode_group_exec/runtime-v2"; chmod 0700 "$bad_mode_group_exec" "$bad_mode_group_exec/runtime-v2"
  printf 'bad-mode\n' >"$bad_mode_group_exec/runtime-v2/file"; chmod 0450 "$bad_mode_group_exec/runtime-v2/file"
  if snapshot "$bad_mode_group_exec" "$root/rejected-mode-group-exec" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "group-executable regular file mode 0450 was accepted" >&2
    exit 1
  fi
  bad_mode_world_exec="$root/legacy-mode-world-exec"; mkdir -p "$bad_mode_world_exec/runtime-v2"; chmod 0700 "$bad_mode_world_exec" "$bad_mode_world_exec/runtime-v2"
  printf 'bad-mode\n' >"$bad_mode_world_exec/runtime-v2/file"; chmod 0401 "$bad_mode_world_exec/runtime-v2/file"
  if snapshot "$bad_mode_world_exec" "$root/rejected-mode-world-exec" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "world-executable regular file mode 0401 was accepted" >&2
    exit 1
  fi
  bad_mode_owner_read_missing="$root/legacy-mode-owner-read-missing"; mkdir -p "$bad_mode_owner_read_missing/runtime-v2"; chmod 0700 "$bad_mode_owner_read_missing" "$bad_mode_owner_read_missing/runtime-v2"
  printf 'bad-mode\n' >"$bad_mode_owner_read_missing/runtime-v2/file"; chmod 0100 "$bad_mode_owner_read_missing/runtime-v2/file"
  if snapshot "$bad_mode_owner_read_missing" "$root/rejected-mode-owner-read-missing" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "owner-read-missing regular file mode 0100 was accepted" >&2
    exit 1
  fi
  bad_mode_special="$root/legacy-mode-special-bit"; mkdir -p "$bad_mode_special/runtime-v2"; chmod 0700 "$bad_mode_special" "$bad_mode_special/runtime-v2"
  printf 'bad-mode\n' >"$bad_mode_special/runtime-v2/file"; chmod 04400 "$bad_mode_special/runtime-v2/file"
  if snapshot "$bad_mode_special" "$root/rejected-mode-special-bit" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "special-bit regular file mode 04400 was accepted" >&2
    exit 1
  fi
  bad_mode_directory="$root/legacy-mode-directory"; mkdir -p "$bad_mode_directory/runtime-v2/group-readable"; chmod 0700 "$bad_mode_directory" "$bad_mode_directory/runtime-v2"
  chmod 0740 "$bad_mode_directory/runtime-v2/group-readable"
  if snapshot "$bad_mode_directory" "$root/rejected-mode-directory" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "group-readable directory was accepted" >&2
    exit 1
  fi
  bad_mode_directory_special="$root/legacy-mode-directory-special"; mkdir -p "$bad_mode_directory_special/runtime-v2/special"; chmod 0700 "$bad_mode_directory_special" "$bad_mode_directory_special/runtime-v2"
  chmod 01700 "$bad_mode_directory_special/runtime-v2/special"
  if snapshot "$bad_mode_directory_special" "$root/rejected-mode-directory-special" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "special-bit directory was accepted" >&2
    exit 1
  fi
  unreadable_xattr_source="$root/legacy-unreadable-xattr"
  unreadable_xattr_receipt="$root/receipts/unreadable-xattr.json"
  mkdir -p "$unreadable_xattr_source/runtime-v2"
  chmod 0700 "$unreadable_xattr_source" "$unreadable_xattr_source/runtime-v2"
  printf 'xattr-denial\n' >"$unreadable_xattr_source/runtime-v2/file"
  chmod 0600 "$unreadable_xattr_source/runtime-v2/file"
  /usr/bin/xattr -w com.hepta.snapshot.selftest unreadable "$unreadable_xattr_source/runtime-v2/file"
  chmod +a 'everyone deny readextattr' "$unreadable_xattr_source/runtime-v2/file"
  if snapshot "$unreadable_xattr_source" "$root/rejected-unreadable-xattr" "$unreadable_xattr_receipt" true ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "snapshot accepted an unreadable xattr namespace" >&2
    exit 1
  fi
  if [[ -f "$unreadable_xattr_receipt" ]] && jq -e '.status == "ready"' "$unreadable_xattr_receipt" >/dev/null 2>&1; then
    echo "snapshot published a ready receipt after xattr enumeration failure" >&2
    exit 1
  fi
  replay_destination="$root/replayed-state"
  cp -pR "$destination" "$replay_destination"
  replay_receipt="$root/receipts/replayed.json"
  jq --arg destination "$replay_destination" \
    --arg binding "$root/.replayed-state.hepta-state-snapshot-v3.binding" \
    '.destination_state_root=$destination | .destination_binding=$binding' "$receipt" >"$replay_receipt"
  chmod 0400 "$replay_receipt"
  if verify_snapshot_receipt "$replay_receipt" >/dev/null 2>&1; then
    echo "snapshot receipt replay against an unbound destination was accepted" >&2
    exit 1
  fi
  printf 'unexpected-top-level\n' >"$destination/unexpected-top-level"; chmod 0600 "$destination/unexpected-top-level"
  if verify_snapshot_receipt "$receipt" >/dev/null 2>&1; then
    echo "full snapshot top-level inventory drift was accepted" >&2
    exit 1
  fi
  rm "$destination/unexpected-top-level"
  touch -r "$source" "$destination"
  /usr/bin/xattr -w com.hepta.snapshot.selftest 'tampered-xattr' "$destination/archive/record.json"
  if verify_snapshot_receipt "$receipt" >/dev/null 2>&1; then
    echo "full snapshot xattr tamper was accepted" >&2
    exit 1
  fi
  /usr/bin/xattr -w com.hepta.snapshot.selftest 'xattr-payload' "$destination/archive/record.json"
  verify_snapshot_receipt "$receipt" >/dev/null

  allow_file_source="$root/legacy-allow-file-acl"
  mkdir -p "$allow_file_source/runtime-v2"; chmod 0700 "$allow_file_source" "$allow_file_source/runtime-v2"
  printf 'allow-file\n' >"$allow_file_source/runtime-v2/file"; chmod 0600 "$allow_file_source/runtime-v2/file"
  chmod +a 'everyone allow read' "$allow_file_source/runtime-v2/file"
  if snapshot "$allow_file_source" "$root/rejected-allow-file-acl" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "snapshot accepted an allow ACE on a regular file" >&2
    exit 1
  fi
  allow_directory_source="$root/legacy-allow-directory-acl"
  mkdir -p "$allow_directory_source/runtime-v2/child"; chmod 0700 "$allow_directory_source" "$allow_directory_source/runtime-v2" "$allow_directory_source/runtime-v2/child"
  chmod +a 'everyone allow list' "$allow_directory_source/runtime-v2/child"
  if snapshot "$allow_directory_source" "$root/rejected-allow-directory-acl" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "snapshot accepted an allow ACE on a directory" >&2
    exit 1
  fi

  concurrent_source="$root/concurrent-source"
  concurrent_destination="$root/concurrent-target/state"
  concurrent_receipt_a="$root/concurrent-receipts/a.json"
  concurrent_receipt_b="$root/concurrent-receipts/b.json"
  mkdir -p "$concurrent_source/runtime-v2"; chmod 0700 "$concurrent_source" "$concurrent_source/runtime-v2"
  printf 'concurrent\n' >"$concurrent_source/runtime-v2/state"; chmod 0600 "$concurrent_source/runtime-v2/state"
  env HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT="$root" "$0" \
    --source-state-root "$concurrent_source" --destination-state-root "$concurrent_destination" \
    --legacy-label ai.hepta.snapshot.selftest --receipt "$concurrent_receipt_a" --materialize >/dev/null 2>&1 &
  concurrent_pid_a=$!
  env HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT="$root" "$0" \
    --source-state-root "$concurrent_source" --destination-state-root "$concurrent_destination" \
    --legacy-label ai.hepta.snapshot.selftest --receipt "$concurrent_receipt_b" --materialize >/dev/null 2>&1 &
  concurrent_pid_b=$!
  if wait "$concurrent_pid_a"; then concurrent_rc_a=0; else concurrent_rc_a=$?; fi
  if wait "$concurrent_pid_b"; then concurrent_rc_b=0; else concurrent_rc_b=$?; fi
  [[ ( "$concurrent_rc_a" == 0 && "$concurrent_rc_b" != 0 ) \
    || ( "$concurrent_rc_b" == 0 && "$concurrent_rc_a" != 0 ) ]] || {
    echo "same-destination concurrent snapshots did not produce exactly one winner" >&2
    exit 1
  }
  winner_receipt="$concurrent_receipt_a"; [[ "$concurrent_rc_b" == 0 ]] && winner_receipt="$concurrent_receipt_b"
  verify_snapshot_receipt "$winner_receipt" >/dev/null
  [[ ! -e "$concurrent_destination/payload" \
    && ! -e "$(dirname "$concurrent_destination")/.$(basename "$concurrent_destination").hepta-state-snapshot-v3.lock" ]] || {
    echo "concurrent snapshot publication polluted the destination or retained a success lock" >&2
    exit 1
  }

  for interrupt_kind in destination binding receipt; do
    interrupt_source="$root/interrupt-$interrupt_kind-source"
    interrupt_destination="$root/interrupt-$interrupt_kind-target/state"
    interrupt_receipt="$root/interrupt-$interrupt_kind-receipt.json"
    interrupt_binding="$(dirname "$interrupt_destination")/.$(basename "$interrupt_destination").hepta-state-snapshot-v3.binding"
    interrupt_lock="$(dirname "$interrupt_destination")/.$(basename "$interrupt_destination").hepta-state-snapshot-v3.lock"
    mkdir -p "$interrupt_source/runtime-v2"; chmod 0700 "$interrupt_source" "$interrupt_source/runtime-v2"
    printf 'interrupt-%s\n' "$interrupt_kind" >"$interrupt_source/runtime-v2/state"; chmod 0600 "$interrupt_source/runtime-v2/state"
    if env HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT="$root" HEPTA_STATE_SNAPSHOT_SELF_TEST_INTERRUPT_AFTER="$interrupt_kind" "$0" \
      --source-state-root "$interrupt_source" --destination-state-root "$interrupt_destination" \
      --legacy-label ai.hepta.snapshot.selftest --receipt "$interrupt_receipt" --materialize >/dev/null 2>&1; then
      interrupt_rc=0
    else
      interrupt_rc=$?
    fi
    [[ "$interrupt_rc" == 75 && -d "$interrupt_lock" \
      && "$(stat -f '%Lp' "$interrupt_lock")" == 700 \
      && "$(stat -f '%Lp' "$interrupt_lock/operation.json")" == 400 \
      && "$(stat -f '%Lp' "$interrupt_lock/pending.json")" == 400 ]] || {
      echo "snapshot interruption did not retain its inspectable operation lock" >&2
      exit 1
    }
    if env HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT="$root" "$0" \
      --source-state-root "$interrupt_source" --destination-state-root "$interrupt_destination" \
      --legacy-label ai.hepta.snapshot.selftest --receipt "$root/interrupt-$interrupt_kind-retry.json" --materialize >/dev/null 2>&1; then
      echo "snapshot retry ignored an interrupted destination lock" >&2
      exit 1
    fi
    case "$interrupt_kind" in
      destination)
        [[ -d "$interrupt_destination" && ! -e "$interrupt_binding" && ! -e "$interrupt_receipt" ]] || exit 1
        ;;
      binding)
        [[ -d "$interrupt_destination" && -f "$interrupt_binding" && ! -e "$interrupt_receipt" ]] || exit 1
        validate_private_artifact_v3 "$interrupt_binding"
        ;;
      receipt)
        [[ -d "$interrupt_destination" && -f "$interrupt_binding" && -f "$interrupt_receipt" ]] || exit 1
        verify_snapshot_receipt "$interrupt_receipt" >/dev/null
        verify_snapshot_source "$interrupt_receipt" >/dev/null
        ;;
    esac
    quarantine_dir="$root/interrupt-$interrupt_kind-forensics"
    mkdir "$quarantine_dir"; chmod 0700 "$quarantine_dir"
    mv "$interrupt_lock" "$quarantine_dir/operation-lock"
    [[ ! -e "$interrupt_destination" ]] || mv "$interrupt_destination" "$quarantine_dir/destination"
    [[ ! -e "$interrupt_binding" ]] || mv "$interrupt_binding" "$quarantine_dir/binding.json"
    [[ ! -e "$interrupt_receipt" ]] || mv "$interrupt_receipt" "$quarantine_dir/receipt.json"
    recovery_receipt="$root/interrupt-$interrupt_kind-recovery-receipt.json"
    env HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT="$root" "$0" \
      --source-state-root "$interrupt_source" --destination-state-root "$interrupt_destination" \
      --legacy-label ai.hepta.snapshot.selftest --receipt "$recovery_receipt" --materialize >/dev/null
    verify_snapshot_receipt "$recovery_receipt" >/dev/null
    verify_snapshot_source "$recovery_receipt" >/dev/null
    [[ -d "$quarantine_dir/operation-lock" && -d "$quarantine_dir/destination" \
      && ! -e "$interrupt_lock" ]] || {
      echo "snapshot boundary recovery did not preserve forensics and publish a fresh attempt" >&2
      exit 1
    }
  done
  mode_source="$root/source-mode-tamper"; mode_destination="$root/destination-mode-tamper"; mode_receipt="$root/receipts/source-mode-tamper.json"
  mkdir -p "$mode_source/runtime-v2"; chmod 0700 "$mode_source" "$mode_source/runtime-v2"
  printf 'mode-freshness\n' >"$mode_source/runtime-v2/readonly"; chmod 0444 "$mode_source/runtime-v2/readonly"
  snapshot "$mode_source" "$mode_destination" "$mode_receipt" true ai.hepta.snapshot.selftest >/dev/null
  verify_snapshot_source "$mode_receipt" >/dev/null
  chmod 0644 "$mode_source/runtime-v2/readonly"
  if verify_snapshot_source "$mode_receipt" >/dev/null 2>&1; then
    echo "source freshness verification accepted a post-snapshot mode change" >&2
    exit 1
  fi
  printf 'changed-after-snapshot\n' >>"$source/runtime-v2/runtime-state.json"
  if verify_snapshot_source "$receipt" >/dev/null 2>&1; then
    echo "source freshness verification accepted post-snapshot mutation" >&2
    exit 1
  fi
  v1_source="$root/v1-legacy"; v1_destination="$root/v1-destination"; v1_receipt="$root/receipts/v1.json"
  mkdir -p "$v1_source/runtime-v2"; chmod 0700 "$v1_source" "$v1_source/runtime-v2"
  printf 'v1-fixture\n' >"$v1_source/runtime-v2/runtime-state.json"; chmod 0600 "$v1_source/runtime-v2/runtime-state.json"
  snapshot_v1 "$v1_source" "$v1_destination" "$v1_receipt" true ai.hepta.snapshot.v1.selftest >/dev/null
  verify_snapshot_receipt "$v1_receipt" >/dev/null
  verify_snapshot_source "$v1_receipt" >/dev/null
  jq -cn --arg receipt_sha256 "$(sha256_file "$receipt")" \
    --arg v1_receipt_sha256 "$(sha256_file "$v1_receipt")" \
    '{schema:"hepta_vnext_state_snapshot_self_test_v3",profile:"full-state-root-v3",mode_profile:"hepta_vnext_state_mode_profile_v3",acl_profile:"hepta_vnext_state_acl_profile_deny_only_v1",status:"ready",receipt_sha256:$receipt_sha256,v1_receipt_sha256:$v1_receipt_sha256,full_root_v3:true,all_top_level_entries_covered:true,identity_and_portable_inventories_separate:true,original_mode_inventory_bound:true,acl_inventory_bound:true,deny_only_acl_preserved:true,deny_only_acl_file_and_directory_preserved:true,allow_acl_file_rejected:true,allow_acl_directory_rejected:true,binding_acl_tamper_rejected:true,mode_0400_accepted_and_preserved:true,mode_0600_accepted_and_preserved:true,mode_0444_accepted_and_preserved:true,mode_0644_rejected:true,mode_0500_accepted_and_preserved:true,mode_0466_rejected:true,mode_0646_rejected:true,mode_0450_group_execute_rejected:true,mode_0401_world_execute_rejected:true,mode_0100_owner_read_missing_rejected:true,special_mode_bits_rejected:true,directory_group_read_rejected:true,directory_special_bits_rejected:true,allowed_mode_tamper_rejected:true,mode_contract_tamper_rejected:true,modes_uid_gid_mtime_flags_acl_xattr_preserved:true,unreadable_xattr_rejected:true,wal_shm_and_keys_covered:true,hardlink_topology_bound:true,hardlink_copy_preserved:true,hardlink_split_rejected:true,hardlink_rebind_rejected:true,external_hardlinks_rejected:true,nonempty_wal_rejected:true,symlink_rejected:true,special_entry_rejected:true,path_delimiter_rejected:true,nested_receipt_rejected:true,receipt_replay_rejected:true,top_level_drift_rejected:true,xattr_tamper_rejected:true,source_freshness_reverified:true,source_mode_tamper_rejected:true,post_snapshot_mutation_rejected:true,destination_derived_atomic_mkdir_lock:true,same_destination_concurrency_serialized:true,three_publication_boundary_interruptions_rejected:true,three_publication_boundary_recoveries_verified:true,interrupted_locks_retained:true,no_nested_payload_pollution:true,receipt_publication_no_replace:true,binding_publication_no_replace:true,destination_publication_no_replace:true,file_and_directory_fsync:true,formal_verification_before_ready_publication:true,final_source_rescan:true,v1_receipt_compatible:true,source_unchanged:true,destination_exact_copy:true,production_changed:false}'
}

if [[ "${1:-}" == "self-test" ]]; then
  [[ $# -eq 1 ]] || usage
  self_test
  exit 0
fi
if [[ "${1:-}" == "verify" || "${1:-}" == "verify-source" ]]; then
  verify_command="$1"
  shift
  [[ "${1:-}" == "--receipt" && -n "${2:-}" && $# -eq 2 ]] || usage
  if [[ "$verify_command" == verify-source ]]; then
    verify_snapshot_source "$2"
  else
    verify_snapshot_receipt "$2"
  fi
  exit 0
fi
source_root=""; destination_root=""; receipt=""; predecessor_rollback_receipt=""; writer_barrier_receipt=""; materialize=false; legacy_label=ai.hepta.gateway
while (( $# > 0 )); do
  case "$1" in
    --source-state-root) shift; [[ $# -gt 0 ]] || usage; source_root="$1" ;;
    --destination-state-root) shift; [[ $# -gt 0 ]] || usage; destination_root="$1" ;;
    --legacy-label) shift; [[ $# -gt 0 ]] || usage; legacy_label="$1" ;;
    --receipt) shift; [[ $# -gt 0 ]] || usage; receipt="$1" ;;
    --predecessor-rollback-receipt) shift; [[ $# -gt 0 ]] || usage; predecessor_rollback_receipt="$1" ;;
    --writer-barrier-receipt) shift; [[ $# -gt 0 ]] || usage; writer_barrier_receipt="$1" ;;
    --materialize) materialize=true ;;
    *) usage ;;
  esac
  shift
done
[[ -n "$source_root" && -n "$destination_root" ]] || usage
snapshot "$source_root" "$destination_root" "$receipt" "$materialize" "$legacy_label" "$predecessor_rollback_receipt" "$writer_barrier_receipt"
