+use super::{Button as TestedButton, ButtonAction as TestedAction, KeyboardEdge};
+use crate::*;
+
+fn button() -> (Cx, TestedButton) {
+    let mut cx = Cx::new(Box::new(|_, _| {}));
+    let button = cx.with_vm(|vm| {
+        crate::script_mod(vm);
+        let value = script_eval!(vm, { mod.widgets.Button {text: "Fixture"} });
+        TestedButton::script_from_value(vm, value)
+    });
+    (cx, button)
+}
+fn key(code: KeyCode, repeat: bool) -> KeyEvent {
+    KeyEvent {key_code: code, is_repeat: repeat, modifiers: KeyModifiers {shift: true, ..Default::default()}, time: 1.0}
+}
+fn clicks(cx: &Cx) -> usize {
+    cx.new_actions.iter().filter(|a| matches!(a.as_widget_action().cast::<TestedAction>(), TestedAction::Clicked(_))).count()
+}
+
+#[test]
+fn enter_and_space_use_real_button_actions_once_with_modifiers() {
+    for code in [KeyCode::ReturnKey, KeyCode::Space] {
+        let (mut cx, mut button) = button();
+        button.activate_keyboard(&mut cx, key(code, false), KeyboardEdge::Press);
+        button.activate_keyboard(&mut cx, key(code, true), KeyboardEdge::Press);
+        assert_eq!(clicks(&cx), 0);
+        button.activate_keyboard(&mut cx, key(code, false), KeyboardEdge::Release);
+        button.activate_keyboard(&mut cx, key(code, false), KeyboardEdge::Release);
+        assert_eq!(clicks(&cx), 1);
+        let action = cx.new_actions.iter().find_map(|a| match a.as_widget_action().cast::<TestedAction>() {
+            TestedAction::Clicked(modifiers) => Some(modifiers), _ => None,
+        }).unwrap();
+        assert!(action.shift);
+    }
+}
+#[test]
+fn disabled_hidden_and_mismatched_releases_do_not_click() {
+    for mode in 0..3 {
+        let (mut cx, mut button) = button();
+        button.activate_keyboard(&mut cx, key(KeyCode::Space, false), KeyboardEdge::Press);
+        match mode {0 => button.enabled = false, 1 => button.visible = false, _ => {}}
+        let code = if mode == 2 {KeyCode::ReturnKey} else {KeyCode::Space};
+        button.activate_keyboard(&mut cx, key(code, false), KeyboardEdge::Release);
+        assert_eq!(clicks(&cx), 0);
+        assert!(button.keyboard_key.is_none());
+    }
+}
+#[test]
+fn intervening_navigation_key_cancels_the_arm() {
+    let (mut cx, mut button) = button();
+    button.activate_keyboard(&mut cx, key(KeyCode::Space, false), KeyboardEdge::Press);
+    button.activate_keyboard(&mut cx, key(KeyCode::Tab, false), KeyboardEdge::Press);
+    button.activate_keyboard(&mut cx, key(KeyCode::Space, false), KeyboardEdge::Release);
+    assert_eq!(clicks(&cx), 0);
+}
+
+#[test]
+fn actual_event_dispatch_cancels_an_arm_without_current_focus() {
+    let (mut cx, mut button) = button();
+    button.activate_keyboard(&mut cx, key(KeyCode::Space, false), KeyboardEdge::Press);
+    button.handle_event(&mut cx, &Event::Actions(Vec::new()), &mut Scope::empty());
+    button.activate_keyboard(&mut cx, key(KeyCode::Space, false), KeyboardEdge::Release);
+    assert_eq!(clicks(&cx), 0);
+}
+
+#[test]
+fn undrawn_or_modal_blocked_button_cannot_arm_from_key_dispatch() {
+    let (mut cx, mut button) = button();
+    for modal in [false, true] {
+        if modal { cx.block_scrolling_except_within(Area::Empty); }
+        button.handle_event(&mut cx, &Event::KeyDown(key(KeyCode::Space, false)), &mut Scope::empty());
+        assert!(button.keyboard_key.is_none());
+        button.handle_event(&mut cx, &Event::KeyUp(key(KeyCode::Space, false)), &mut Scope::empty());
+        assert_eq!(clicks(&cx), 0);
+    }
+}
