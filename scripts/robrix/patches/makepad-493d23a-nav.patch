+#[test]
+fn adaptive_actions_do_not_read_retired_area_generation() {
+    let (mut cx, mut bars, list, _view) = scene();
+    let old = list.id();
+    drop(list);
+    let replacement = DrawList::new(&mut cx);
+    assert_eq!(old.index(), replacement.id().index());
+    assert!(!bars.area().is_valid(&cx));
+    // The runtime log gate must remain silent, not just return false.
+    assert!(!bars.catch_fling_on_press(&mut cx, &Event::Actions(Vec::new())));
+}
