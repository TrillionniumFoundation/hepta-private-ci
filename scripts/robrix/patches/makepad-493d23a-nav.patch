+use super::*;
+use crate::*;
+
+fn scene() -> (Cx, DrawPass, DrawList, Vec<Area>) {
+    let mut cx = Cx::new(Box::new(|_, _| {}));
+    let mut views = cx.with_vm(|vm| {
+        crate::script_mod(vm);
+        (0..3).map(|_| {
+            let value = script_eval!(vm, { mod.widgets.SolidView {width: 40, height: 30, draw_bg.color: #fff} });
+            View::script_from_value(vm, value)
+        }).collect::<Vec<_>>()
+    });
+    let pass = DrawPass::new(&mut cx);
+    pass.set_size(&mut cx, dvec2(320.0, 240.0));
+    let mut list = DrawList::new(&mut cx);
+    let event = DrawEvent::default();
+    let mut draw = CxDraw::new(&mut cx, &event);
+    draw.begin_pass(&pass, None);
+    list.begin_always(&mut draw);
+    {
+        let mut cx = Cx2d::new(&mut draw);
+        cx.begin_root_turtle(dvec2(320.0, 240.0), Layout::flow_down());
+        for view in &mut views {
+            view.draw_all(&mut cx, &mut Scope::empty());
+            cx.add_nav_stop(view.area(), NavRole::TextInput, Inset::default());
+        }
+        cx.end_turtle();
+    }
+    list.end(&mut draw);
+    draw.end_pass(&pass);
+    drop(draw);
+    let areas = views.iter().map(|view| view.area()).collect();
+    (cx, pass, list, areas)
+}
+
+#[test]
+fn initial_forward_reverse_and_wrap_use_actual_drawn_stops() {
+    let (mut cx, _pass, list, areas) = scene();
+    let root = list.id();
+    assert_eq!(tab_target(&mut cx, root, Area::Empty, false).unwrap().0, areas[0]);
+    assert_eq!(tab_target(&mut cx, root, Area::Empty, true).unwrap().0, areas[2]);
+    for index in 0..3 {
+        assert_eq!(tab_target(&mut cx, root, areas[index], false).unwrap().0, areas[(index + 1) % 3]);
+        assert_eq!(tab_target(&mut cx, root, areas[index], true).unwrap().0, areas[(index + 2) % 3]);
+    }
+    assert!(cx.key_focus().is_empty(), "target selection itself must not steal focus");
+}
+
+#[test]
+fn empty_tree_has_no_target() {
+    let (mut cx, pass, mut list, _) = scene();
+    let event = DrawEvent::default();
+    let mut draw = CxDraw::new(&mut cx, &event);
+    draw.begin_pass(&pass, None);
+    list.begin_always(&mut draw);
+    list.end(&mut draw);
+    draw.end_pass(&pass);
+    drop(draw);
+    assert!(tab_target(&mut cx, list.id(), Area::Empty, false).is_none());
+    assert!(tab_target(&mut cx, list.id(), Area::Empty, true).is_none());
+}
+
+#[test]
+fn stale_modal_scope_never_falls_through_to_background_controls() {
+    let (mut cx, _pass, list, areas) = scene();
+    cx.block_scrolling_except_within(Area::Empty);
+    assert!(tab_target(&mut cx, list.id(), areas[0], false).is_none());
+    assert!(tab_target(&mut cx, list.id(), areas[0], true).is_none());
+    cx.unblock_scrolling();
+    assert_eq!(tab_target(&mut cx, list.id(), areas[0], false).unwrap().0, areas[1]);
+}
+
+#[test]
+fn deferred_footer_does_not_take_initial_focus() {
+    let (mut cx, _pass, list, areas) = scene();
+    let tree = cx.get_global::<makepad_draw::nav::CxNavTreeRc>().clone();
+    tree.0.borrow_mut()[list.id()].nav_list.rotate_right(1);
+    assert_eq!(tab_target(&mut cx, list.id(), Area::Empty, false).unwrap().0, areas[0]);
+    assert_eq!(tab_target(&mut cx, list.id(), areas[2], false).unwrap().0, areas[0]);
+}
