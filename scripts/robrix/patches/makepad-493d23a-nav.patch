+use super::ScrollBars as TestedScrollBars;
+use crate::*;
+use crate::event::{ScrollEvent, ScrollPhase, TouchUpdateEvent, TouchPoint, TouchState};
+use crate::scroll_bar::ScrollAxis;
+
+fn scene() -> (Cx, TestedScrollBars, DrawList, View) {
+    let mut cx = Cx::new(Box::new(|_, _| {}));
+    let (mut view, mut bars) = cx.with_vm(|vm| {
+        crate::script_mod(vm);
+        let view = script_eval!(vm, {mod.widgets.SolidView {width: 120, height: 80, draw_bg.color: #fff}});
+        let bars = script_eval!(vm, {mod.widgets.ScrollBars {}});
+        (View::script_from_value(vm, view), TestedScrollBars::script_from_value(vm, bars))
+    });
+    let pass = DrawPass::new(&mut cx);
+    pass.set_size(&mut cx, dvec2(320.0, 240.0));
+    let mut list = DrawList::new(&mut cx);
+    let event = DrawEvent::default();
+    let mut draw = CxDraw::new(&mut cx, &event);
+    draw.begin_pass(&pass, None);
+    list.begin_always(&mut draw);
+    {
+        let mut cx = Cx2d::new(&mut draw);
+        cx.begin_root_turtle(dvec2(320.0, 240.0), Layout::flow_down());
+        view.draw_all(&mut cx, &mut Scope::empty());
+        bars.scroll_bar_y.draw_scroll_bar(&mut cx, ScrollAxis::Vertical,
+            Rect {pos: dvec2(0.0, 0.0), size: dvec2(120.0, 80.0)}, dvec2(120.0, 600.0));
+        cx.end_pass_sized_turtle();
+    }
+    list.end(&mut draw);
+    draw.end_pass(&pass);
+    drop(draw);
+    bars.set_area(view.area());
+    (cx, bars, list, view)
+}
