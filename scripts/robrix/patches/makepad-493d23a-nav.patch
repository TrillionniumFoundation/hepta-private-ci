+// Keyboard activation is armed only by a focused real Hit::KeyDown. Repeat,
+// cancellation and release never synthesize pointer events or change key focus.
+#[derive(Clone, Copy)]
+enum KeyboardEdge { Press, Release }
+
+impl Button {
+    fn activate_keyboard(&mut self, cx: &mut Cx, key: KeyEvent, edge: KeyboardEdge) {
+        let allowed = self.enabled && self.visible && !self.disabled(cx)
+            && matches!(key.key_code, KeyCode::ReturnKey | KeyCode::Space)
+            && !key.modifiers.control && !key.modifiers.alt && !key.modifiers.logo;
+        if !allowed { self.keyboard_key = None; return; }
+        let uid = self.widget_uid();
+        match edge {
+            KeyboardEdge::Press => {
+                if key.is_repeat || self.keyboard_key.is_some() { return; }
+                self.keyboard_key = Some(key.key_code);
+                cx.widget_action_with_data(&self.action_data, uid, ButtonAction::Pressed(key.modifiers));
+                cx.widget_to_script_call(uid, NIL, self.source.clone(), self.on_press.clone(), &[]);
+                if self.trigger_on_press {
+                    cx.widget_to_script_call(uid, NIL, self.source.clone(), self.on_click.clone(), &[]);
+                }
+                self.animator_play(cx, ids!(hover.down));
+            }
+            KeyboardEdge::Release => {
+                let armed = self.keyboard_key.take();
+                self.animator_play(cx, ids!(hover.off));
+                if key.is_repeat || armed != Some(key.key_code) { return; }
+                cx.widget_action_with_data(&self.action_data, uid, ButtonAction::Clicked(key.modifiers));
+                if !self.trigger_on_press {
+                    cx.widget_to_script_call(uid, NIL, self.source.clone(), self.on_click.clone(), &[]);
+                }
+            }
+        }
+    }
+}
