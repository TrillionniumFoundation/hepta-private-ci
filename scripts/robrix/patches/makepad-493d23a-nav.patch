+    let _replacement = DrawList::new(&mut cx);
+    let event = Event::MouseDown(MouseDownEvent {
+        abs: dvec2(10.0, 10.0), button: MouseButton::PRIMARY, window_id: WindowId(0, 0),
+        modifiers: Default::default(), handled: Default::default(), time: 1.0,
+    });
+    assert!(!bars.catch_fling_on_press(&mut cx, &event));
