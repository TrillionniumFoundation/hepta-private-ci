+// Use the same real nav tree and scroll trigger path as pointer-focused traversal.
+// The existing modal scrolling constraint also bounds keyboard navigation.
+fn tab_target(cx: &mut Cx, root: DrawListId, focus: Area, reverse: bool) -> Option<(Area, Vec<Area>)> {
+    let root = if let Some(scope) = cx.fingers.blocked_scrolling_exception_area() {
+        if !scope.is_valid(cx) { return None; }
+        scope.draw_list_id()?
+    } else { root };
+    let mut areas = Vec::new();
+    CxDraw::iterate_nav_stops(cx, root, |cx, stop| {
+        if stop.area.is_valid(cx) {
+            let size = stop.area.rect(cx).size;
+            // Off-screen scroll children remain reachable through scroll-to-focus.
+            // Hidden/deferred zero-sized controls are not navigation stops.
+            if size.x > 0.0 && size.y > 0.0 { areas.push(stop.area); }
+        }
+        None
+    });
+    if areas.is_empty() { return None; }
+    let current = areas.iter().position(|area| *area == focus);
+    let index = match (current, reverse) {
+        (Some(index), true) => (index + areas.len() - 1) % areas.len(),
+        (Some(index), false) => (index + 1) % areas.len(),
+        (None, true) => areas.len() - 1,
+        (None, false) => areas.iter().enumerate().min_by(|(_, a), (_, b)| {
+            // Deferred Fill children may register after a visually later footer.
+            // Only initial focus uses layout order; traversal retains tree order.
+            let a = a.rect(cx).pos;
+            let b = b.rect(cx).pos;
+            a.y.total_cmp(&b.y).then(a.x.total_cmp(&b.x))
+        }).map(|(index, _)| index).unwrap(),
+    };
+    let target = areas[index];
+    CxDraw::iterate_nav_stops(cx, root, |_, stop| (stop.area == target).then_some(target))
+}
