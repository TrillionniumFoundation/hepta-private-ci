+#[cfg(test)]
+mod hepta_web_startup_tests {
+    use super::*;
+    use std::{cell::RefCell, rc::Rc};
+    fn native(width: f64) -> WindowGeom {
+        WindowGeom { dpi_factor: 2.0, inner_size: Vec2d { x: width, y: 600.0 }, ..Default::default() }
+    }
+    #[test]
+    fn startup_creates_real_window_before_dpi_and_repeat_is_rejected() {
+        let owner = Rc::new(RefCell::new(None));
+        let keep = owner.clone();
+        let mut cx = Cx::new(Box::new(move |cx, event| {
+            if matches!(event, crate::event::Event::Startup) {
+                let window = WindowHandle::new(cx);
+                cx.windows[window.window_id()].dpi_override = Some(1.0);
+                *keep.borrow_mut() = Some(window);
+            }
+        }));
+        let geom = cx.hepta_web_startup_geometry(native(800.0)).unwrap();
+        assert_eq!(geom.inner_size, Vec2d { x: 1600.0, y: 1200.0 });
+        assert_eq!(geom.dpi_factor, 1.0);
+        assert!(cx.hepta_web_startup_geometry(native(800.0)).is_err());
+        assert_eq!(cx.windows.id_iter().count(), 1);
+        let updated = cx.hepta_web_window_geometry(native(400.0)).unwrap();
+        assert_eq!(updated.inner_size, Vec2d { x: 800.0, y: 1200.0 });
+        assert_eq!(cx.hepta_web_window_geometry(native(400.0)).unwrap(), updated);
+    }
