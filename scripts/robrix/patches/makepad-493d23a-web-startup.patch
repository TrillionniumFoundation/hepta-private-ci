+#[test]
+fn delayed_html_refreshes_real_row_metrics_without_changing_native_ink_or_body() {
+    use crate::html::Html;
+    let mut cx = Cx::new(Box::new(|_, _| {}));
+    let (mut delayed, mut fresh) = cx.with_vm(|vm| {
+        crate::script_mod(vm);
+        (Html::script_new_with_default(vm), Html::script_new_with_default(vm))
+    });
+    for html in [&mut delayed, &mut fresh] {
+        html.font_size = 9.3;
+        html.text_style_normal.font_size = 9.3;
+        html.text_style_normal.line_spacing = 1.32;
+        html.max_lines = 2;
+        html.layout.flow = makepad_draw::turtle::Flow::Right {wrap: true, row_align: makepad_draw::turtle::RowAlign::Center};
+        html.set_text(&mut cx, "Principles and long-form thinking");
+    }
+    CxDraw::lazy_construct_fonts(&mut cx);
+    let family = delayed.text_style_normal.font_family_id();
+    let fonts = cx.get_global::<Rc<RefCell<Fonts>>>().clone();
+    fonts.borrow_mut().set_font_family_definition(family, FontFamilyDefinition {font_ids: vec![], expected_member_count: 0});
+    let pass = DrawPass::new(&mut cx);
+    pass.set_size(&mut cx, dvec2(300.0, 160.0));
+    let mut list = DrawList::new(&mut cx);
+    let event = DrawEvent::default();
+    let mut draw = CxDraw::new(&mut cx, &event);
+    draw.begin_pass(&pass, None);
+    list.begin_always(&mut draw);
+    let mut offsets = Vec::new();
+    let mut row_heights = Vec::new();
+    {
+        let mut cx = Cx2d::new(&mut draw);
+        cx.begin_root_turtle(dvec2(300.0, 160.0), Layout::flow_down());
+        delayed.style_metrics_em(&mut cx, 0);
+        let font: FontId = 0x484550544147_u64.into();
+        fonts.borrow_mut().define_font(font, FontDefinition {
+            data: SharedBytes::from_file_mmap_or_read(std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("resources/IBMPlexSans-Text.ttf")).unwrap(),
+            index: 0, ascender_fudge_in_ems: -0.1, descender_fudge_in_ems: 0.0,
+            weight: None, variations: vec![],
+        });
+        fonts.borrow_mut().set_font_family_definition(family, FontFamilyDefinition {font_ids: vec![font], expected_member_count: 1});
+        for html in [&mut delayed, &mut fresh] {
+            html.draw_walk(&mut cx, &mut Scope::empty(), Walk {width: Size::Fixed(140.0), height: Size::Fixed(34.0), ..Walk::default()});
+            let ink = html.draw_text.area();
+            assert!(ink.is_valid(&cx), "real glyph area must be present");
+            offsets.push(ink.rect(&cx).pos.y-html.area.rect(&cx).pos.y);
+            row_heights.push(html.draw_text.align_row_height);
+            assert_eq!(html.lines_drawn, 2, "fixture must exercise two real text rows");
+            assert_eq!(html.body.as_ref(), "Principles and long-form thinking");
+        }
+        cx.end_pass_sized_turtle();
+    }
+    list.end(&mut draw); draw.end_pass(&pass); drop(draw);
+    assert_eq!(row_heights[0], row_heights[1], "real Html handed stale row metrics to DrawText");
+    assert!((offsets[0]-offsets[1]).abs() <= 0.1, "late/fresh real glyph baselines differ: {offsets:?}");
+}
