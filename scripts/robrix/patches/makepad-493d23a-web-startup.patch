+use super::*;
+use makepad_draw::text::{font::FontId, fonts::Fonts, loader::{FontDefinition, FontFamilyDefinition}};
+use std::cell::RefCell;
+
+#[test]
+fn delayed_font_refreshes_empty_input_metrics_and_preserves_editing() {
+    let mut cx = Cx::new(Box::new(|_, _| {}));
+    let mut input = cx.with_vm(|vm| {
+        crate::script_mod(vm);
+        TextInput::script_new_with_default(vm)
+    });
+    CxDraw::lazy_construct_fonts(&mut cx);
+    let family = input.draw_text.text_style.font_family_id();
+    let fonts = cx.get_global::<Rc<RefCell<Fonts>>>().clone();
+    // Model the state before an asynchronous resource response, with no font yet.
+    fonts.borrow_mut().set_font_family_definition(family, FontFamilyDefinition {
+        font_ids: vec![], expected_member_count: 0,
+    });
+    let event = DrawEvent::default();
+    let mut draw = CxDraw::new(&mut cx, &event);
+    let mut cx = Cx2d::new(&mut draw);
+    cx.begin_root_turtle(dvec2(275.0, 100.0), Layout::default());
+    input.layout_text(&mut cx);
+    let stale = input.laidout_text.as_ref().unwrap().clone();
+    assert_eq!(stale.size_in_lpxs.height, 0.0);
+    let font: FontId = 0x4845505441_u64.into();
+    fonts.borrow_mut().define_font(font, FontDefinition {
+        data: SharedBytes::from_file_mmap_or_read(std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("resources/IBMPlexSans-Text.ttf")).unwrap(),
+        index: 0, ascender_fudge_in_ems: -0.1, descender_fudge_in_ems: 0.0,
+        weight: None, variations: vec![],
+    });
+    fonts.borrow_mut().set_font_family_definition(family, FontFamilyDefinition {
+        font_ids: vec![font], expected_member_count: 1,
+    });
+    let selection = input.selection;
+    input.layout_text(&mut cx);
+    let refreshed = input.laidout_text.as_ref().unwrap().clone();
+    assert!(refreshed.size_in_lpxs.height > 0.0, "empty input retained pre-resource metrics");
+    assert_eq!((input.selection.anchor, input.selection.cursor), (selection.anchor, selection.cursor));
+    input.layout_text(&mut cx);
+    assert!(Rc::ptr_eq(&refreshed, input.laidout_text.as_ref().unwrap()), "complete fonts should reuse the shared bounded layout cache");
+    input.set_text(&mut cx, "draft");
+    input.set_cursor(&mut cx, Cursor { index: 3, prefer_next_row: false }, false);
+    let selection = input.selection;
+    input.layout_text(&mut cx);
+    assert_eq!(input.text, "draft");
+    assert_eq!((input.selection.anchor, input.selection.cursor), (selection.anchor, selection.cursor));
+    assert!(input.cursor_to_position(input.cursor()).is_ok());
+    input.set_text(&mut cx, "");
+    input.layout_text(&mut cx);
+    assert_eq!(input.laidout_text.as_ref().unwrap().size_in_lpxs.height, refreshed.size_in_lpxs.height);
+    cx.end_turtle();
+}
