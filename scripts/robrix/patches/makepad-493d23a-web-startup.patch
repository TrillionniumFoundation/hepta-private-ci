+use super::*;
+use makepad_draw::text::{font::FontId, fonts::Fonts, loader::{FontDefinition, FontFamilyDefinition}};
+use std::cell::RefCell;
+
+#[test]
+fn delayed_fonts_refresh_real_text_flow_style_metrics() {
+    let mut cx = Cx::new(Box::new(|_, _| {}));
+    let (mut delayed, mut fresh) = cx.with_vm(|vm| {
+        crate::script_mod(vm);
+        (TextFlow::script_new_with_default(vm), TextFlow::script_new_with_default(vm))
+    });
+    CxDraw::lazy_construct_fonts(&mut cx);
+    let family = delayed.text_style_normal.font_family_id();
+    let fonts = cx.get_global::<Rc<RefCell<Fonts>>>().clone();
+    fonts.borrow_mut().set_font_family_definition(family, FontFamilyDefinition {font_ids: vec![], expected_member_count: 0});
+    let event = DrawEvent::default();
+    let mut draw = CxDraw::new(&mut cx, &event);
+    let mut cx = Cx2d::new(&mut draw);
+    cx.begin_root_turtle(dvec2(275.0, 100.0), Layout::default());
+    let before = delayed.style_metrics_em(&mut cx, 0);
+    let font: FontId = 0x484550544146_u64.into();
+    fonts.borrow_mut().define_font(font, FontDefinition {
+        data: SharedBytes::from_file_mmap_or_read(std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("resources/IBMPlexSans-Text.ttf")).unwrap(),
+        index: 0, ascender_fudge_in_ems: -0.1, descender_fudge_in_ems: 0.0,
+        weight: None, variations: vec![],
+    });
+    fonts.borrow_mut().set_font_family_definition(family, FontFamilyDefinition {font_ids: vec![font], expected_member_count: 1});
+    let expected = fresh.style_metrics_em(&mut cx, 0);
+    let actual = delayed.style_metrics_em(&mut cx, 0);
+    assert!(expected.0 > 0.0 && expected.1 > 0.0);
+    assert_ne!(before, expected, "fixture must exercise genuinely unavailable then ready fonts");
+    assert_eq!(actual, expected, "TextFlow retained metrics from before the font response");
+    assert_eq!(delayed.style_metrics_em(&mut cx, 0), expected);
+    delayed.draw_text.text_style = delayed.text_style_normal.clone();
+    delayed.draw_text.text_style.font_size = 100.0;
+    let first = delayed.draw_text.layout(&mut cx, 0.0, 0.0, None, false, Align::default(), "Ag");
+    let again = delayed.draw_text.layout(&mut cx, 0.0, 0.0, None, false, Align::default(), "Ag");
+    assert!(Rc::ptr_eq(&first, &again), "ready fonts must retain bounded shared layout reuse");
+    cx.end_turtle();
+}
