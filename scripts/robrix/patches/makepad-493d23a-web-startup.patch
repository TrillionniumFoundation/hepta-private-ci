+// Hepta compatibility for Makepad 493d23a: web Startup owns window creation.
+impl Cx {
+    pub fn hepta_web_startup_geometry(&mut self, native: WindowGeom) -> Result<WindowGeom, &'static str> {
+        if self.windows.is_valid(CxWindowPool::id_zero()) {
+            return Err("web startup window already exists");
+        }
+        self.call_event_handler(&crate::event::Event::Startup);
+        self.hepta_web_window_geometry(native)
+    }
+
+    pub fn hepta_web_window_geometry(&mut self, native: WindowGeom) -> Result<WindowGeom, &'static str> {
+        let id = CxWindowPool::id_zero();
+        if !self.windows.is_valid(id) { return Err("web main window was not created"); }
+        let window = &mut self.windows[id];
+        window.os_dpi_factor = Some(native.dpi_factor);
+        let layout = window.native_window_geom_to_layout(native);
+        window.window_geom = layout.clone();
+        Ok(layout)
+    }
+}
