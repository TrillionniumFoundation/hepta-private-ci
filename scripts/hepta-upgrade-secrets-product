#!/usr/bin/python3
"""Replace an existing secrets program while retaining every original owner.

All four stable endpoint writer locks exclude live services. A durable intent
binds the original manifest and the exact successor. Interrupted publication
resumes that intent; it never restores a database or reinitializes the instance.
"""

import argparse
from contextlib import ExitStack
import fcntl
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import re
import stat
import sys

ROLES = {"authority": 982, "operator": 981, "consumer": 983, "runtime": 992}
MAX_IMAGE_BYTES = 512 * 1024 * 1024


def unique(items):
    result = {}
    for key, value in items:
        if key in result:
            raise ValueError("duplicate protected document field")
        result[key] = value
    return result


def encode(value):
    return json.dumps(value, separators=(",", ":"), sort_keys=True).encode()


def file_identity(value):
    return (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns, value.st_ctime_ns)


def read_file(path, *, uid, mode, maximum):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        before = os.fstat(stream.fileno())
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != uid
            or before.st_nlink != 1
            or stat.S_IMODE(before.st_mode) != mode
            or before.st_size > maximum
        ):
            raise ValueError("unsafe protected file")
        data = stream.read(maximum + 1)
        after = os.fstat(stream.fileno())
        if len(data) > maximum or file_identity(before) != file_identity(after):
            raise ValueError("protected file changed during read")
    return data


def read_document(path):
    raw = read_file(path, uid=0, mode=0o640, maximum=256 * 1024)
    return raw, json.loads(raw, object_pairs_hook=unique)


def digest(data):
    return hashlib.sha256(data).hexdigest()


def sync_directory(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def publish(path, data, *, mode, gid):
    temporary = path.with_name(path.name + ".upgrade-new")
    if temporary.exists():
        if read_file(temporary, uid=0, mode=mode, maximum=MAX_IMAGE_BYTES) != data:
            raise ValueError("different interrupted publication retained")
    else:
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
        with os.fdopen(fd, "wb") as stream:
            os.fchown(stream.fileno(), 0, gid)
            os.fchmod(stream.fileno(), mode)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
    os.replace(temporary, path)
    sync_directory(path.parent)


def original_verifier(manifest):
    helper = Path(manifest["helper_path"])
    raw = read_file(helper, uid=0, mode=0o555, maximum=256 * 1024)
    if digest(raw) != manifest["helper_sha256"]:
        raise ValueError("original installed verifier changed")
    spec = importlib.util.spec_from_file_location("original_secrets_verifier", helper)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def acquire_lock(stack, path, uid, gid):
    flags = os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK
    try:
        fd = os.open(path, flags | os.O_CREAT | os.O_EXCL, 0o600)
        created = True
    except FileExistsError:
        fd = os.open(path, flags)
        created = False
    stack.callback(os.close, fd)
    if created:
        os.fchown(fd, uid, gid)
        os.fchmod(fd, 0o600)
    metadata = os.fstat(fd)
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != uid
        or metadata.st_nlink != 1
        or stat.S_IMODE(metadata.st_mode) != 0o600
    ):
        raise ValueError("original writer lock metadata differs")
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    current = path.stat(follow_symlinks=False)
    if (current.st_dev, current.st_ino) != (metadata.st_dev, metadata.st_ino):
        raise ValueError("original writer lock was replaced")


def verify_frozen_layout(config, module, manifest):
    """Check retained layout without requiring two-file publication to be whole.

    apply separately validates the image and manifest against both exact
    original intent states. No other configuration or private pin can vary.
    """
    root, backing = Path(manifest["canonical_root"]), Path(manifest["backing_root"])
    module.protected_ancestors(root)
    metadata, original = root.stat(), backing.lstat()
    if (
        metadata.st_ino != manifest["namespace_inode"]
        or module.filesystem_uuid(root) != manifest["filesystem_uuid"]
        or original.st_uid != 0
        or stat.S_IMODE(original.st_mode) != 0o755
        or (original.st_dev, original.st_ino) != (metadata.st_dev, metadata.st_ino)
    ):
        raise ValueError("original mounted namespace differs")
    image = Path(manifest["binary_path"])
    module.protected_ancestors(image.parent)
    for name, expected in manifest["config_sha256"].items():
        if Path(name).name != name or digest(read_document(config / name)[0]) != expected:
            raise ValueError("original frozen configuration differs")
    module.revocation_head(config / manifest["mutable_root_revocation_head"])
    for record in manifest["private_files"]:
        raw = read_file(Path(record["path"]), uid=record["uid"], mode=0o600, maximum=256 * 1024)
        if digest(raw) != record["sha256"]:
            raise ValueError("original purpose or credential pin differs")


def exclude_owners(stack, config, module, manifest):
    for role, uid in ROLES.items():
        _, value = read_document(config / (role + ".json"))
        service = value if role == "consumer" else value["service"]
        if service.get("service_uid", uid) != uid or service["ipc_group_gid"] != 976:
            raise ValueError("original service principal changed")
        endpoint = Path(service["socket_path"])
        if not endpoint.is_absolute() or ".." in endpoint.parts:
            raise ValueError("original endpoint path is invalid")
        parent = endpoint.parent
        # /run can disappear across a boot. Restore only an absent original
        # endpoint directory, never a durable directory or owner database.
        if not parent.exists():
            module.protected_ancestors(parent.parent)
            parent.mkdir(mode=0o750)
            os.chown(parent, uid, 976)
            os.chmod(parent, 0o750)
        metadata = parent.lstat()
        if (
            not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid != uid
            or metadata.st_gid != 976
            or metadata.st_mode & 0o027
        ):
            raise ValueError("original endpoint directory differs")
        acquire_lock(stack, endpoint.with_suffix(".stable-writer.lock"), uid, 976)
    # Check the entire frozen layout again after all physical writers are
    # excluded, including unchanged private material and mounted namespace.
    verify_frozen_layout(config, module, manifest)


def archive_image(path, data, expected):
    if digest(data) != expected or not data.startswith(b"\x7fELF"):
        raise ValueError("exact native executable differs")
    if path.exists():
        if read_file(path, uid=0, mode=0o555, maximum=MAX_IMAGE_BYTES) != data:
            raise ValueError("existing immutable release differs")
        return
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o555)
    with os.fdopen(fd, "wb") as stream:
        os.fchown(stream.fileno(), 0, 0)
        os.fchmod(stream.fileno(), 0o555)
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
    sync_directory(path.parent)


def apply(config, revision):
    pending_path = config / "upgrade.pending.json"
    completed_path = config / f"upgrade-{revision}.completed.json"
    raw, pending = read_document(pending_path if pending_path.exists() else completed_path)
    del raw
    before = pending["manifest_before"].encode()
    after = pending["manifest_after"].encode()
    original = json.loads(before, object_pairs_hook=unique)
    target = json.loads(after, object_pairs_hook=unique)
    if pending["schema"] != "hepta.secrets.original-software-upgrade.v1" or pending["original_revision"] != revision:
        raise ValueError("different original software intent")
    expected = dict(original, release_revision=revision + 1, previous_binary_sha256=original["binary_sha256"], binary_sha256=target["binary_sha256"])
    if original.get("release_revision", 1) != revision or target != expected:
        raise ValueError("software intent changes original owner configuration")
    current, _ = read_document(config / "instance.json")
    if current not in (before, after):
        raise ValueError("manifest differs from both original publication states")
    image = Path(original["binary_path"])
    current_image = read_file(image, uid=0, mode=0o555, maximum=MAX_IMAGE_BYTES)
    if digest(current_image) not in (original["binary_sha256"], target["binary_sha256"]):
        raise ValueError("program differs from both original publication states")
    target_image = read_file(Path(pending["target_archive"]), uid=0, mode=0o555, maximum=MAX_IMAGE_BYTES)
    if digest(target_image) != target["binary_sha256"]:
        raise ValueError("retained successor executable differs")
    if digest(current_image) != target["binary_sha256"]:
        publish(image, target_image, mode=0o555, gid=0)
    if current != after:
        publish(config / "instance.json", after, mode=0o640, gid=976)
    original_verifier(target).verify_layout(config)
    if completed_path.exists():
        if read_document(completed_path)[0] != encode(pending):
            raise ValueError("different completed original upgrade")
    else:
        publish(completed_path, encode(pending), mode=0o640, gid=976)
    if pending_path.exists():
        pending_path.unlink()
        sync_directory(config)
    return {"release_revision": revision + 1, "binary_sha256": target["binary_sha256"], "original_owner_state_replaced": False, "services_started": False}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["plan", "upgrade", "apply"])
    parser.add_argument("--config", type=Path, default=Path("/etc/hepta-secrets"))
    parser.add_argument("--expected-revision", type=int, required=True)
    parser.add_argument("--binary", type=Path)
    parser.add_argument("--sha256")
    args = parser.parse_args()
    if os.geteuid() != 0 or not args.config.is_absolute() or ".." in args.config.parts:
        raise ValueError("Root and protected absolute configuration required")
    if not 1 <= args.expected_revision < 2**64 - 1:
        raise ValueError("bounded original release revision required")
    manifest_raw, manifest = read_document(args.config / "instance.json")
    module = original_verifier(manifest)
    module.protected_ancestors(args.config)
    if args.command == "plan":
        module.verify_layout(args.config)
        print(json.dumps({"release_revision": manifest.get("release_revision", 1), "binary_sha256": manifest["binary_sha256"], "required_offline_owners": list(ROLES), "services_started": False}))
        return
    with ExitStack() as stack:
        acquire_lock(stack, args.config / ".root-maintenance.lock", 0, 976)
        manifest_raw, manifest = read_document(args.config / "instance.json")
        module = original_verifier(manifest)
        if (args.config / "maintenance.pending.json").exists():
            raise ValueError("original policy publication must finish before upgrade")
        # Resume validates frozen files through the original manifest. A
        # partially published current image may disagree with that manifest;
        # only the two exact pinned image states are accepted by apply.
        pending_path = args.config / "upgrade.pending.json"
        if pending_path.exists():
            _, pending = read_document(pending_path)
            original = json.loads(pending["manifest_before"], object_pairs_hook=unique)
            module = original_verifier(original)
        else:
            original = manifest
        if args.command == "upgrade":
            if pending_path.exists():
                raise ValueError("original software publication is pending; use apply")
            if original.get("release_revision", 1) != args.expected_revision:
                raise ValueError("expected original software revision differs")
            if args.binary is None or not re.fullmatch(r"[0-9a-f]{64}", args.sha256 or ""):
                raise ValueError("exact successor executable and SHA256 required")
            module.verify_layout(args.config)
        # The current SHA may be the pending successor. Check frozen layout
        # against that exact public state without modifying owner configuration.
        exclude_owners(stack, args.config, module, original)
        if args.command == "upgrade":
            source_fd = os.open(args.binary, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(source_fd, "rb") as source:
                before = os.fstat(source.fileno())
                if not stat.S_ISREG(before.st_mode) or before.st_size > MAX_IMAGE_BYTES:
                    raise ValueError("bounded regular successor executable required")
                data = source.read(MAX_IMAGE_BYTES + 1)
                after = os.fstat(source.fileno())
                if file_identity(before) != file_identity(after) or digest(data) != args.sha256:
                    raise ValueError("successor executable changed during copy")
            if args.sha256 == original["binary_sha256"]:
                print(json.dumps({"release_revision": args.expected_revision, "binary_sha256": args.sha256, "already_installed": True, "original_owner_state_replaced": False, "services_started": False}))
                return
            image = Path(original["binary_path"])
            module.protected_ancestors(image.parent)
            old = read_file(image, uid=0, mode=0o555, maximum=MAX_IMAGE_BYTES)
            archive = image.parent / "releases"
            if not archive.exists():
                archive.mkdir(mode=0o755)
            module.protected_ancestors(archive)
            archive_image(archive / (original["binary_sha256"] + ".elf"), old, original["binary_sha256"])
            target_archive = archive / (args.sha256 + ".elf")
            archive_image(target_archive, data, args.sha256)
            target = dict(original, release_revision=args.expected_revision + 1, previous_binary_sha256=original["binary_sha256"], binary_sha256=args.sha256)
            pending = {"schema": "hepta.secrets.original-software-upgrade.v1", "original_revision": args.expected_revision, "manifest_before": manifest_raw.decode(), "manifest_after": encode(target).decode(), "target_archive": str(target_archive)}
            publish(pending_path, encode(pending), mode=0o640, gid=976)
        elif args.binary is not None or args.sha256 is not None:
            raise ValueError("apply resumes only the retained original intent")
        print(json.dumps(apply(args.config, args.expected_revision)))


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        message = str(error) if isinstance(error, ValueError) else type(error).__name__
        print("protected software upgrade refused: " + message, file=sys.stderr)
        raise SystemExit(1)
