#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  hepta-immutable-release-tree materialize --binary PATH --destination DIR [options]
  hepta-immutable-release-tree verify --manifest PATH
  hepta-immutable-release-tree self-test

materialize options:
  --state-root DIR          default: $HEPTA_STATE_ROOT or ~/.local/share/hepta-vnext/live-snapshot
  --install-root DIR        default: $HEPTA_INSTALL_ROOT or ~/.local/opt/hepta-vnext
  --gateway-label LABEL     default: ai.hepta.gateway
  --watchdog-label LABEL    default: ai.hepta.installed-live-watchdog
  --listen-port PORT        default: 7373 (isolated canary: 17373)
  --source-commit SHA       required exact 40-hex source identity

Materialization never changes a generation pointer or launchd job.
EOF
  exit 64
}

sha256_file() { shasum -a 256 "$1" | awk '{print $1}'; }
file_size() { stat -f '%z' "$1" 2>/dev/null || stat -c '%s' "$1"; }
LIVE_SHELL_CONTRACT_ARG=--hepta-vnext-live-shell-contract-v1

expected_live_shell_contract() {
  jq -cn '{schema:"hepta_vnext_live_shell_contract_v1",status:"ready",protocol_version:1,routes:["GET /","GET /api/hepta/runtime","GET /healthz"],runtime:{loopback_only:true,read_only:true,open_mode:"immutable-query-only-open-existing",schema_version:5,requires_empty_wal:true,keyed_integrity_required:true},authority:{telegram:false,outbound:false,model_invocation:false,operator_mutation:false,enforce:false,promotion:false,retirement:false,automatic_transition:false}}' | jq -S -c .
}

read_live_shell_contract() {
  local binary="$1" actual expected
  if ! actual="$("$binary" "$LIVE_SHELL_CONTRACT_ARG")"; then
    echo "release artifact does not implement the vNext live-shell contract handshake" >&2
    return 1
  fi
  actual="$(printf '%s\n' "$actual" | jq -S -c . 2>/dev/null)" || {
    echo "release artifact emitted a malformed live-shell contract" >&2
    return 1
  }
  expected="$(expected_live_shell_contract)"
  [[ "$actual" == "$expected" ]] || {
    echo "release artifact is not the exact closed vNext live shell" >&2
    return 1
  }
  printf '%s\n' "$actual"
}

sha256_text() { printf '%s' "$1" | shasum -a 256 | awk '{print $1}'; }

absolute_non_root() {
  [[ "$1" == /* \
    && "$1" != "/" \
    && "$1" != */ \
    && "$1" != *"//"* \
    && "$1" != *"/../"* \
    && "$1" != *"/./"* \
    && "$1" != */.. \
    && "$1" != */. ]] || {
    echo "path must be absolute, normalized, and non-root: $1" >&2
    exit 1
  }
}

valid_label() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "invalid launchd label: $1" >&2
    exit 1
  }
}

valid_port() {
  if ! [[ "$1" =~ ^[0-9]+$ ]] || ! (( "$1" >= 1 && "$1" <= 65535 )); then
    echo "listen port must be an integer from 1 through 65535" >&2
    exit 1
  fi
}

valid_commit() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]] || {
    echo "source commit must be an exact lowercase 40-hex object ID" >&2
    exit 1
  }
  local source_repository
  source_repository="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
  git -C "$source_repository" cat-file -e "$1^{commit}" 2>/dev/null || {
    echo "source commit is not present in the materializer repository" >&2
    exit 1
  }
}

release_root_from_manifest() {
  local manifest="$1"
  [[ -f "$manifest" && ! -L "$manifest" ]] || {
    echo "immutable manifest must be a regular file: $manifest" >&2
    return 1
  }
  (cd "$(dirname "$manifest")" && pwd -P)
}

verify_release_v1() {
  local manifest="$1" release_root artifact expected_sha actual_sha expected_size actual_size state_root install_root
  local actual_contract expected_contract_sha actual_contract_sha
  release_root="$(release_root_from_manifest "$manifest")"
  manifest="$release_root/$(basename "$manifest")"
  jq -e '
    .schema == "hepta_vnext_immutable_release_v1"
    and .status == "ready"
    and (.source.commit | test("^[0-9a-f]{40}$"))
    and .artifact.relative_path == "bin/hepta"
    and (.artifact.sha256 | test("^[0-9a-f]{64}$"))
    and (.artifact.size_bytes >= 1)
    and .artifact.contract_schema == "hepta_vnext_live_shell_contract_v1"
    and (.artifact.contract_sha256 | test("^[0-9a-f]{64}$"))
    and .runtime.listen_host == "127.0.0.1"
    and (.runtime.listen_port >= 1 and .runtime.listen_port <= 65535)
    and (.runtime.state_root | startswith("/"))
    and (.runtime.install_root | startswith("/"))
    and .runtime.open_mode == "immutable-query-only-open-existing"
    and .runtime.schema_version == 5
    and .runtime.requires_empty_wal == true
    and .runtime.keyed_integrity_required == true
    and .runtime.state_snapshot_scope == "full-state-root-v2"
    and .runtime.rollback_recutover_epoch_schema == "v2"
    and .authority.telegram == false
    and .authority.outbound == false
    and .authority.model_invocation == false
    and .authority.operator_mutation == false
    and .authority.enforce == false
    and .authority.promotion == false
    and .authority.retirement == false
    and .authority.automatic_transition == false
    and .watchdog.entrypoint == "scripts/hepta-watchdog.sh"
    and .watchdog.verify_tool == "scripts/hepta-immutable-release-tree"
    and .watchdog.immutable_release_bound == true
    and (.gateway_launch_agent.label | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
    and .gateway_launch_agent.relative_path == ("launchd/" + .gateway_launch_agent.label + ".plist")
    and (.gateway_launch_agent.sha256 | test("^[0-9a-f]{64}$"))
    and .gateway_launch_agent.state_root == .runtime.state_root
    and .gateway_launch_agent.listen_port == .runtime.listen_port
    and .gateway_launch_agent.effective_gates_all_false == true
    and (.watchdog_launch_agent.label | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
    and .watchdog_launch_agent.relative_path == ("launchd/" + .watchdog_launch_agent.label + ".plist")
    and (.watchdog_launch_agent.sha256 | test("^[0-9a-f]{64}$"))
    and .watchdog_launch_agent.state_root == .runtime.state_root
    and .watchdog_launch_agent.listen_port == .runtime.listen_port
    and .watchdog_launch_agent.read_only == true
  ' "$manifest" >/dev/null || {
    echo "invalid vNext immutable release manifest" >&2
    return 1
  }
  state_root="$(jq -r '.runtime.state_root' "$manifest")"
  install_root="$(jq -r '.runtime.install_root' "$manifest")"
  absolute_non_root "$state_root"
  absolute_non_root "$install_root"
  [[ -f "$release_root/SHA256SUMS" && ! -L "$release_root/SHA256SUMS" ]] || {
    echo "immutable release SHA256SUMS is missing" >&2
    return 1
  }
  if find "$release_root" -type l -print -quit | grep -q .; then
    echo "immutable release contains a symlink" >&2
    return 1
  fi
  (
    cd "$release_root"
    shasum -a 256 -c SHA256SUMS >/dev/null
    local temp_root
    temp_root="${TMPDIR:-/tmp}"
    actual_inventory="$(mktemp "${temp_root%/}/hepta-release-inventory.XXXXXX")"
    manifest_inventory="$(mktemp "${temp_root%/}/hepta-release-manifest.XXXXXX")"
    trap 'rm -f "$actual_inventory" "$manifest_inventory"' EXIT
    find . -type f ! -name SHA256SUMS -print | sed 's#^\./##' | LC_ALL=C sort >"$actual_inventory"
    awk '{print substr($0, 67)}' SHA256SUMS | LC_ALL=C sort >"$manifest_inventory"
    diff -u "$manifest_inventory" "$actual_inventory" >/dev/null
  ) || {
    echo "immutable release inventory or digest verification failed" >&2
    return 1
  }
  while IFS= read -r item; do
    local mode
    mode="$(stat -f '%Lp' "$item" 2>/dev/null || stat -c '%a' "$item")"
    if (( (8#$mode & 022) != 0 )); then
      echo "immutable release item is group/world writable: $item" >&2
      return 1
    fi
  done < <(find "$release_root" -print)

  artifact="$release_root/$(jq -r '.artifact.relative_path' "$manifest")"
  [[ -f "$artifact" && -x "$artifact" && ! -L "$artifact" ]] || {
    echo "release artifact is missing or non-executable" >&2
    return 1
  }
  expected_sha="$(jq -r '.artifact.sha256' "$manifest")"
  actual_sha="$(sha256_file "$artifact")"
  [[ "$actual_sha" == "$expected_sha" ]] || {
    echo "release artifact SHA-256 differs from manifest" >&2
    return 1
  }
  expected_size="$(jq -r '.artifact.size_bytes' "$manifest")"
  actual_size="$(file_size "$artifact")"
  [[ "$actual_size" == "$expected_size" ]] || {
    echo "release artifact size differs from manifest" >&2
    return 1
  }
  actual_contract="$(read_live_shell_contract "$artifact")" || return 1
  actual_contract_sha="$(sha256_text "$actual_contract")"
  expected_contract_sha="$(jq -r '.artifact.contract_sha256' "$manifest")"
  [[ "$actual_contract_sha" == "$expected_contract_sha" ]] || {
    echo "release artifact live-shell contract differs from manifest" >&2
    return 1
  }
  for contract in gateway_launch_agent watchdog_launch_agent; do
    local relative expected
    relative="$(jq -r ".${contract}.relative_path" "$manifest")"
    expected="$(jq -r ".${contract}.sha256" "$manifest")"
    [[ "$(sha256_file "$release_root/$relative")" == "$expected" ]] || {
      echo "$contract differs from manifest" >&2
      return 1
    }
    plutil -lint "$release_root/$relative" >/dev/null
  done
  jq -cn \
    --arg manifest "$manifest" \
    --arg manifest_sha256 "$(sha256_file "$manifest")" \
    --arg artifact_sha256 "$actual_sha" \
    --arg contract_sha256 "$actual_contract_sha" \
    --arg state_root "$(jq -r '.runtime.state_root' "$manifest")" \
    --argjson listen_port "$(jq -r '.runtime.listen_port' "$manifest")" \
    '{schema:"hepta_vnext_immutable_release_verification_v1",status:"ready",manifest:$manifest,manifest_sha256:$manifest_sha256,artifact_sha256:$artifact_sha256,live_shell_contract_sha256:$contract_sha256,state_root:$state_root,listen_host:"127.0.0.1",listen_port:$listen_port,authority_all_closed:true,service_changed:false}'
}

materialize_release_v1() {
  local binary="$1" destination="$2" state_root="$3" install_root="$4"
  local gateway_label="$5" watchdog_label="$6" listen_port="$7" source_commit="$8"
  local destination_parent destination_name stage script_dir artifact_sha artifact_size
  local live_shell_contract live_shell_contract_sha
  [[ -f "$binary" && -x "$binary" && ! -L "$binary" ]] || {
    echo "--binary must name a non-symlink executable regular file" >&2
    exit 1
  }
  live_shell_contract="$(read_live_shell_contract "$binary")" || exit 1
  live_shell_contract_sha="$(sha256_text "$live_shell_contract")"
  absolute_non_root "$destination"
  absolute_non_root "$state_root"
  absolute_non_root "$install_root"
  valid_label "$gateway_label"
  valid_label "$watchdog_label"
  [[ "$gateway_label" != "$watchdog_label" ]] || {
    echo "gateway and watchdog labels must differ" >&2
    exit 1
  }
  valid_port "$listen_port"
  valid_commit "$source_commit"
  [[ ! -e "$destination" && ! -L "$destination" ]] || {
    echo "release destination already exists: $destination" >&2
    exit 1
  }
  destination_parent="$(cd "$(dirname "$destination")" && pwd -P)"
  destination_name="$(basename "$destination")"
  destination="$destination_parent/$destination_name"
  stage="$(mktemp -d "$destination_parent/.hepta-release.XXXXXX")"
  trap 'chmod -R u+w "$stage" 2>/dev/null || true; rm -rf "$stage"' EXIT
  mkdir -p "$stage/bin" "$stage/scripts" "$stage/launchd"
  cp "$binary" "$stage/bin/hepta"
  chmod 0555 "$stage/bin/hepta"
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  for script in \
    hepta-immutable-release-tree \
    hepta-cutover-guard \
    hepta-generation-pointer \
    hepta-install-live-gateway \
    hepta-install-live-watchdog \
    hepta-launchd-cutover-bridge \
    hepta-live-soak.sh \
    hepta-state-snapshot \
    hepta-watchdog.sh; do
    [[ -f "$script_dir/$script" && ! -L "$script_dir/$script" ]] || {
      echo "release script is missing: $script_dir/$script" >&2
      exit 1
    }
    cp "$script_dir/$script" "$stage/scripts/$script"
    chmod 0555 "$stage/scripts/$script"
  done

  local gateway_plist watchdog_plist gateway_json watchdog_json live_url
  gateway_plist="$stage/launchd/$gateway_label.plist"
  watchdog_plist="$stage/launchd/$watchdog_label.plist"
  gateway_json="$stage/.gateway-plist.json"
  watchdog_json="$stage/.watchdog-plist.json"
  live_url="http://127.0.0.1:$listen_port"
  jq -n \
    --arg label "$gateway_label" \
    --arg program "$install_root/bin/hepta" \
    --arg state_root "$state_root" \
    --arg runtime_root "$state_root/runtime-v2" \
    --arg listen "127.0.0.1:$listen_port" \
    --arg live_url "$live_url" \
    --arg stdout "$install_root/logs/gateway/stdout.log" \
    --arg stderr "$install_root/logs/gateway/stderr.log" \
    '{Label:$label,ProgramArguments:[$program,"--serve-ui",$listen,"--state-root",$state_root],WorkingDirectory:$runtime_root,RunAtLoad:true,KeepAlive:true,StandardOutPath:$stdout,StandardErrorPath:$stderr,EnvironmentVariables:{HEPTA_STATE_ROOT:$state_root,HEPTA_LIVE_URL:$live_url,HEPTA_LAUNCHD_LABEL:$label,HEPTA_GATEWAY_ENABLE_TELEGRAM_PLUGIN:"0",HEPTA_NATIVE_POST_REAL_HANDLER_APPROVED:"0",HEPTA_NATIVE_POST_REAL_HANDLERS:"0",HEPTA_NATIVE_TELEGRAM_CODEX_CORE_RUNNER:"0",HEPTA_NATIVE_TELEGRAM_DELIVERY_APPROVED:"0",HEPTA_NATIVE_TELEGRAM_HEPTA_KERNEL_RUNNER:"0",HEPTA_NATIVE_TELEGRAM_IN_PROCESS_MODEL_RUNNER:"0",HEPTA_NATIVE_TELEGRAM_LIVE_READ:"0",HEPTA_NATIVE_TELEGRAM_MODEL_TURN:"0",HEPTA_NATIVE_TELEGRAM_POLL_LOOP:"0",HEPTA_NATIVE_TELEGRAM_SEND:"0",HEPTA_OPERATOR_MUTATION_ENABLED:"0",HEPTA_RUNTIME_MUTATION_CANARY:"0",HEPTA_TELEGRAM_AUTHORITY_ENABLED:"0",HEPTA_ENFORCE_ENABLED:"0",HEPTA_PROMOTION_ENABLED:"0",HEPTA_OUTBOUND_ENABLED:"0",HEPTA_RETIREMENT_ENABLED:"0"}}' >"$gateway_json"
  plutil -convert xml1 -o "$gateway_plist" "$gateway_json"
  jq -n \
    --arg label "$watchdog_label" \
    --arg program "$destination/scripts/hepta-watchdog.sh" \
    --arg manifest "$destination/manifest.json" \
    --arg live_url "$live_url" \
    --arg stdout "$install_root/logs/watchdog/stdout.log" \
    --arg stderr "$install_root/logs/watchdog/stderr.log" \
    '{Label:$label,ProgramArguments:[$program,"--manifest",$manifest,"--url",$live_url],RunAtLoad:true,StartInterval:900,StandardOutPath:$stdout,StandardErrorPath:$stderr}' >"$watchdog_json"
  plutil -convert xml1 -o "$watchdog_plist" "$watchdog_json"
  rm -f "$gateway_json" "$watchdog_json"
  chmod 0444 "$gateway_plist" "$watchdog_plist"

  artifact_sha="$(sha256_file "$stage/bin/hepta")"
  artifact_size="$(file_size "$stage/bin/hepta")"
  local gateway_sha watchdog_sha gateway_path watchdog_path
  gateway_sha="$(sha256_file "$gateway_plist")"
  watchdog_sha="$(sha256_file "$watchdog_plist")"
  gateway_path="$HOME/Library/LaunchAgents/$gateway_label.plist"
  watchdog_path="$HOME/Library/LaunchAgents/$watchdog_label.plist"
  jq -n \
    --arg source_commit "$source_commit" \
    --arg artifact_sha "$artifact_sha" \
    --arg live_shell_contract_sha "$live_shell_contract_sha" \
    --argjson artifact_size "$artifact_size" \
    --arg state_root "$state_root" \
    --arg install_root "$install_root" \
    --argjson listen_port "$listen_port" \
    --arg gateway_label "$gateway_label" \
    --arg watchdog_label "$watchdog_label" \
    --arg gateway_relative "launchd/$gateway_label.plist" \
    --arg watchdog_relative "launchd/$watchdog_label.plist" \
    --arg gateway_sha "$gateway_sha" \
    --arg watchdog_sha "$watchdog_sha" \
    --arg gateway_path "$gateway_path" \
    --arg watchdog_path "$watchdog_path" \
    '{schema:"hepta_vnext_immutable_release_v1",status:"ready",source:{commit:$source_commit},artifact:{relative_path:"bin/hepta",sha256:$artifact_sha,size_bytes:$artifact_size,executable:true,contract_schema:"hepta_vnext_live_shell_contract_v1",contract_sha256:$live_shell_contract_sha},runtime:{state_root:$state_root,install_root:$install_root,listen_host:"127.0.0.1",listen_port:$listen_port,open_mode:"immutable-query-only-open-existing",schema_version:5,requires_empty_wal:true,keyed_integrity_required:true,state_snapshot_scope:"full-state-root-v2",rollback_recutover_epoch_schema:"v2"},authority:{telegram:false,outbound:false,model_invocation:false,operator_mutation:false,enforce:false,promotion:false,retirement:false,automatic_transition:false},watchdog:{entrypoint:"scripts/hepta-watchdog.sh",verify_tool:"scripts/hepta-immutable-release-tree",immutable_release_bound:true},gateway_launch_agent:{schema:"hepta_vnext_gateway_launch_agent_v1",relative_path:$gateway_relative,sha256:$gateway_sha,label:$gateway_label,canonical_install_path:$gateway_path,state_root:$state_root,listen_port:$listen_port,effective_gates_all_false:true},watchdog_launch_agent:{schema:"hepta_vnext_watchdog_launch_agent_v1",relative_path:$watchdog_relative,sha256:$watchdog_sha,label:$watchdog_label,canonical_install_path:$watchdog_path,state_root:$state_root,listen_port:$listen_port,read_only:true}}' >"$stage/manifest.json"
  chmod 0444 "$stage/manifest.json"
  local sums
  sums="$(
    cd "$stage"
    find . -type f ! -name SHA256SUMS -print \
      | sed 's#^\./##' \
      | LC_ALL=C sort \
      | while IFS= read -r relative; do shasum -a 256 "$relative"; done
  )"
  (
    cd "$stage"
    printf '%s\n' "$sums" >SHA256SUMS
    chmod 0444 SHA256SUMS
  )
  find "$stage" -type d -exec chmod 0555 {} +
  mv "$stage" "$destination"
  stage=""
  trap - EXIT
  verify_release_v1 "$destination/manifest.json" >/dev/null
  jq -cn \
    --arg release "$destination" \
    --arg manifest "$destination/manifest.json" \
    --arg manifest_sha256 "$(sha256_file "$destination/manifest.json")" \
    --arg artifact_sha256 "$artifact_sha" \
    --arg state_root "$state_root" \
    --arg gateway_label "$gateway_label" \
    --arg watchdog_label "$watchdog_label" \
    --argjson listen_port "$listen_port" \
    '{schema:"hepta_vnext_immutable_release_materialization_v1",status:"ready",release:$release,manifest:$manifest,manifest_sha256:$manifest_sha256,artifact_sha256:$artifact_sha256,state_root:$state_root,gateway_label:$gateway_label,watchdog_label:$watchdog_label,listen_port:$listen_port,service_changed:false,generation_changed:false}'
}

fsync_paths() {
  local python3_bin
  python3_bin="$(command -v python3 2>/dev/null || true)"
  [[ -n "$python3_bin" && -x "$python3_bin" ]] || {
    echo "python3 is required for durable release publication" >&2
    return 1
  }
  "$python3_bin" - "$@" <<'PY'
import os
import stat
import sys

for path in sys.argv[1:]:
    info = os.lstat(path)
    if stat.S_ISLNK(info.st_mode):
        raise SystemExit(f"refusing to fsync symlink: {path}")
    flags = os.O_RDONLY | (getattr(os, "O_DIRECTORY", 0) if stat.S_ISDIR(info.st_mode) else 0)
    descriptor = os.open(path, flags)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
PY
}

fsync_tree() {
  local tree_root="$1" item
  while IFS= read -r -d '' item; do fsync_paths "$item" || return 1; done < <(find "$tree_root" -type f -print0)
  while IFS= read -r -d '' item; do fsync_paths "$item" || return 1; done < <(find -d "$tree_root" -type d -print0)
}

validate_closed_tree_names_v1() {
  local tree_root="$1" item relative
  while IFS= read -r -d '' item; do
    relative="${item#"$tree_root"/}"
    [[ "$relative" != *$'\n'* && "$relative" != *$'\r'* && "$relative" != *'|'* ]] || {
      echo "closed tree rejects newline, carriage-return, or pipe in paths" >&2
      return 1
    }
  done < <(find "$tree_root" -print0)
}

empty_metadata_sha256_v1() { printf '' | shasum -a 256 | awk '{print $1}'; }

node_acl_sha256_v1() { /bin/ls -lden "$1" | sed '1d' | shasum -a 256 | awk '{print $1}'; }

node_xattr_sha256_v1() {
  local item="$1" names name value_sha
  if ! names="$(/usr/bin/xattr "$item" 2>/dev/null)"; then
    echo "could not enumerate immutable-release xattrs: $item" >&2
    return 1
  fi
  {
    if [[ -n "$names" ]]; then
      printf '%s\n' "$names" | LC_ALL=C sort | while IFS= read -r name; do
        [[ "$name" != *$'\n'* && "$name" != *$'\r'* && "$name" != *'|'* ]] || exit 1
        value_sha="$(/usr/bin/xattr -p "$name" "$item" | shasum -a 256 | awk '{print $1}')" || exit 1
        printf '%s|%s\n' "$name" "$value_sha" || exit 1
      done
    fi
  } | shasum -a 256 | awk '{print $1}'
}

expected_closed_mode_v1() {
  local profile="$1" relative="$2" item_type="$3"
  if [[ "$item_type" == directory ]]; then
    printf '0500\n'
    return
  fi
  case "$profile:$relative" in
    immutable-release-v2:bin/hepta|immutable-release-v2:scripts/*) printf '0500\n' ;;
    immutable-release-v2:*|bridge-bundle-v1:*) printf '0400\n' ;;
    *) echo "unsupported closed-tree profile: $profile" >&2; return 1 ;;
  esac
}

closed_tree_inventory_v1() {
  local tree_root="$1" profile="$2" output="$3" item relative item_type raw_mode mode_bits mode expected_mode nlink size flags acl_sha xattr_sha digest empty_sha
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  validate_closed_tree_names_v1 "$tree_root" || return 1
  empty_sha="$(empty_metadata_sha256_v1)"
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      relative="${item#./}"
      [[ "$item" != ./TYPED-INVENTORY.tsv && "$item" != ./SHA256SUMS ]] || continue
      [[ ! -L "$item" ]] || { echo "closed tree rejects symlink: $relative" >&2; exit 1; }
      if [[ -f "$item" ]]; then item_type='file'
      elif [[ -d "$item" ]]; then item_type='directory'
      else echo "closed tree rejects special entry: $relative" >&2; exit 1
      fi
      [[ "$item" != . ]] || relative=.
      raw_mode="$(stat -f '%p' "$item")" || exit 1
      mode_bits="$((8#$raw_mode & 07777))"; printf -v mode '%04o' "$mode_bits"
      expected_mode="$(expected_closed_mode_v1 "$profile" "$relative" "$item_type")" || exit 1
      [[ "$mode" == "$expected_mode" ]] || {
        echo "closed tree mode differs from profile at $relative: $mode != $expected_mode" >&2
        exit 1
      }
      nlink="$(stat -f '%l' "$item")" || exit 1
      [[ "$item_type" != file || "$nlink" == 1 ]] || {
        echo "closed tree regular file is hardlinked: $relative" >&2
        exit 1
      }
      flags="$(stat -f '%f' "$item")" || exit 1
      acl_sha="$(node_acl_sha256_v1 "$item")" || exit 1
      xattr_sha="$(node_xattr_sha256_v1 "$item")" || exit 1
      [[ "$flags" == 0 && "$acl_sha" == "$empty_sha" && "$xattr_sha" == "$empty_sha" ]] || {
        echo "closed tree rejects ACLs, xattrs, and BSD flags: $relative" >&2
        exit 1
      }
      if [[ "$item_type" == file ]]; then
        size="$(file_size "$item")"; digest="$(sha256_file "$item")"
      else
        size=-; digest=-
      fi
      printf '%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
        "$relative" "$item_type" "$mode" "$nlink" "$size" "$flags" "$acl_sha" "$xattr_sha" "$digest"
    done
  ) >"$output"
}

validate_closure_file_v1() {
  local item="$1" empty_sha
  empty_sha="$(empty_metadata_sha256_v1)"
  [[ -f "$item" && ! -L "$item" && "$(stat -f '%Lp' "$item")" == 400 \
    && "$(stat -f '%l' "$item")" == 1 && "$(stat -f '%f' "$item")" == 0 \
    && "$(node_acl_sha256_v1 "$item")" == "$empty_sha" \
    && "$(node_xattr_sha256_v1 "$item")" == "$empty_sha" ]] || {
    echo "closed-tree closure file is not exact 0400/single-link/metadata-free: $item" >&2
    return 1
  }
}

verify_closed_tree_v1() {
  local tree_root="$1" profile="$2" expected_inventory="$3" temp_root actual_inventory actual_paths expected_paths actual_sums expected_sums
  [[ -d "$tree_root" && ! -L "$tree_root" && "$(cd "$tree_root" && pwd -P)" == "$tree_root" ]] || return 1
  [[ "$expected_inventory" == "$tree_root/TYPED-INVENTORY.tsv" ]] || return 1
  validate_closure_file_v1 "$tree_root/TYPED-INVENTORY.tsv" || return 1
  validate_closure_file_v1 "$tree_root/SHA256SUMS" || return 1
  if find "$tree_root" -type l -print -quit | grep -q . \
    || find "$tree_root" ! -type f ! -type d -print -quit | grep -q .; then
    echo "closed tree contains a symlink or special entry" >&2
    return 1
  fi
  temp_root="${TMPDIR:-/tmp}"
  actual_inventory="$(mktemp "${temp_root%/}/hepta-closed-tree-inventory.XXXXXX")"
  actual_paths="$(mktemp "${temp_root%/}/hepta-closed-tree-paths.XXXXXX")"
  expected_paths="$(mktemp "${temp_root%/}/hepta-closed-tree-expected.XXXXXX")"
  actual_sums="$(mktemp "${temp_root%/}/hepta-closed-tree-sums.XXXXXX")"
  expected_sums="$(mktemp "${temp_root%/}/hepta-closed-tree-sums-expected.XXXXXX")"
  trap 'rm -f "${actual_inventory:-}" "${actual_paths:-}" "${expected_paths:-}" "${actual_sums:-}" "${expected_sums:-}"; trap - RETURN' RETURN
  closed_tree_inventory_v1 "$tree_root" "$profile" "$actual_inventory" || return 1
  diff -u "$expected_inventory" "$actual_inventory" >/dev/null || {
    echo "closed tree typed inventory differs" >&2
    diff -u "$expected_inventory" "$actual_inventory" >&2 || true
    return 1
  }
  (
    cd "$tree_root"
    shasum -a 256 -c SHA256SUMS >/dev/null
    find . -type f ! -name SHA256SUMS -print | sed 's#^./##' | LC_ALL=C sort >"$actual_paths"
    awk '{print substr($0, 67)}' SHA256SUMS | LC_ALL=C sort >"$expected_paths"
    diff -u "$expected_paths" "$actual_paths" >/dev/null
    while IFS= read -r relative; do shasum -a 256 "$relative"; done <"$actual_paths" >"$actual_sums"
    LC_ALL=C sort SHA256SUMS >"$expected_sums"
    LC_ALL=C sort "$actual_sums" | diff -u "$expected_sums" - >/dev/null
  ) || {
    echo "closed tree SHA256SUMS namespace or content differs" >&2
    return 1
  }
  trap - RETURN
  rm -f "$actual_inventory" "$actual_paths" "$expected_paths" "$actual_sums" "$expected_sums"
}

clear_node_metadata_v1() {
  local tree_root="$1" item
  chmod -RN "$tree_root" 2>/dev/null || true
  while IFS= read -r -d '' item; do
    /usr/bin/xattr -c "$item" 2>/dev/null || true
    chflags nouchg,noschg,nohidden "$item" 2>/dev/null || true
  done < <(find "$tree_root" -print0)
}

build_closed_tree_closure_v1() {
  local tree_root="$1" profile="$2" temp_root inventory_tmp sums_tmp relative
  chmod 0700 "$tree_root"
  rm -f "$tree_root/TYPED-INVENTORY.tsv" "$tree_root/SHA256SUMS"
  chmod 0500 "$tree_root"
  temp_root="${TMPDIR:-/tmp}"
  inventory_tmp="$(mktemp "${temp_root%/}/hepta-closed-tree-build.XXXXXX")"
  sums_tmp="$(mktemp "${temp_root%/}/hepta-closed-tree-sums-build.XXXXXX")"
  trap 'rm -f "${inventory_tmp:-}" "${sums_tmp:-}"; trap - RETURN' RETURN
  closed_tree_inventory_v1 "$tree_root" "$profile" "$inventory_tmp"
  chmod 0700 "$tree_root"
  cp "$inventory_tmp" "$tree_root/TYPED-INVENTORY.tsv"
  chmod 0400 "$tree_root/TYPED-INVENTORY.tsv"
  (
    cd "$tree_root"
    find . -type f ! -name SHA256SUMS -print | sed 's#^./##' | LC_ALL=C sort \
      | while IFS= read -r relative; do shasum -a 256 "$relative"; done
  ) >"$sums_tmp"
  cp "$sums_tmp" "$tree_root/SHA256SUMS"
  (
    cd "$tree_root"
    chmod 0400 SHA256SUMS
  )
  chmod -N "$tree_root/TYPED-INVENTORY.tsv" "$tree_root/SHA256SUMS" 2>/dev/null || true
  /usr/bin/xattr -c "$tree_root/TYPED-INVENTORY.tsv" "$tree_root/SHA256SUMS" 2>/dev/null || true
  chflags nouchg,noschg,nohidden "$tree_root/TYPED-INVENTORY.tsv" "$tree_root/SHA256SUMS" 2>/dev/null || true
  chmod 0500 "$tree_root"
  # Creating the two closure files changes the APFS directory link count. Now
  # that the namespace is final, capture the terminal typed inventory and then
  # refresh SHA256SUMS without adding or removing another node.
  closed_tree_inventory_v1 "$tree_root" "$profile" "$inventory_tmp"
  chmod 0700 "$tree_root"
  chmod 0600 "$tree_root/TYPED-INVENTORY.tsv" "$tree_root/SHA256SUMS"
  cp "$inventory_tmp" "$tree_root/TYPED-INVENTORY.tsv"
  chmod 0400 "$tree_root/TYPED-INVENTORY.tsv"
  (
    cd "$tree_root"
    find . -type f ! -name SHA256SUMS -print | sed 's#^./##' | LC_ALL=C sort \
      | while IFS= read -r relative; do shasum -a 256 "$relative"; done
  ) >"$sums_tmp"
  cp "$sums_tmp" "$tree_root/SHA256SUMS"
  chmod 0400 "$tree_root/SHA256SUMS"
  chmod -N "$tree_root/TYPED-INVENTORY.tsv" "$tree_root/SHA256SUMS" 2>/dev/null || true
  /usr/bin/xattr -c "$tree_root/TYPED-INVENTORY.tsv" "$tree_root/SHA256SUMS" 2>/dev/null || true
  chflags nouchg,noschg,nohidden "$tree_root/TYPED-INVENTORY.tsv" "$tree_root/SHA256SUMS" 2>/dev/null || true
  chmod 0500 "$tree_root"
  trap - RETURN
  rm -f "$inventory_tmp" "$sums_tmp"
}

tooling_scripts_json_v2() {
  local repository="$1" commit="$2" script relative mode object working_sha blob_sha json='[]'
  for script in \
    hepta-immutable-release-tree hepta-cutover-guard hepta-generation-pointer hepta-install-live-gateway \
    hepta-install-live-watchdog hepta-launchd-cutover-bridge hepta-live-soak.sh \
    hepta-state-snapshot hepta-watchdog.sh; do
    relative="scripts/$script"
    [[ -f "$repository/$relative" && ! -L "$repository/$relative" ]] || return 1
    read -r mode _ object _ < <(git -C "$repository" ls-tree "$commit" -- "$relative")
    [[ "$mode" == 100755 && "$object" =~ ^[0-9a-f]{40}$ ]] || {
      echo "release tooling is not an executable tracked blob at $commit: $relative" >&2
      return 1
    }
    working_sha="$(sha256_file "$repository/$relative")"
    blob_sha="$(git -C "$repository" cat-file blob "$object" | shasum -a 256 | awk '{print $1}')"
    [[ "$working_sha" == "$blob_sha" ]] || {
      echo "release tooling working bytes differ from the source commit: $relative" >&2
      return 1
    }
    json="$(jq -c --arg relative "$relative" --arg mode "$mode" --arg object "$object" --arg sha "$working_sha" \
      '. + [{relative_path:$relative,git_mode:$mode,blob_oid:$object,sha256:$sha}]' <<<"$json")"
  done
  printf '%s\n' "$json"
}

verify_release_v2() {
  local manifest="$1" release_root artifact actual_contract actual_contract_sha relative expected
  release_root="$(release_root_from_manifest "$manifest")" || return 1
  manifest="$release_root/$(basename "$manifest")"
  jq -e '
    .schema == "hepta_vnext_immutable_release_v2" and .status == "ready"
    and (.source.commit | test("^[0-9a-f]{40}$")) and (.source.tree | test("^[0-9a-f]{40}$"))
    and .tooling.commit == .source.commit and .tooling.tree == .source.tree
    and .tooling.repository_clean == true and .tooling.head_equals_source_commit == true
    and .tooling.all_tracked_blobs_exact == true and (.tooling.scripts | length == 9)
    and ([.tooling.scripts[].relative_path] | sort) == (["scripts/hepta-cutover-guard","scripts/hepta-generation-pointer","scripts/hepta-immutable-release-tree","scripts/hepta-install-live-gateway","scripts/hepta-install-live-watchdog","scripts/hepta-launchd-cutover-bridge","scripts/hepta-live-soak.sh","scripts/hepta-state-snapshot","scripts/hepta-watchdog.sh"] | sort)
    and all(.tooling.scripts[]; (.git_mode == "100755") and (.blob_oid | test("^[0-9a-f]{40}$")) and (.sha256 | test("^[0-9a-f]{64}$")))
    and .closure.profile == "immutable-release-v2"
    and .closure.typed_inventory == "TYPED-INVENTORY.tsv"
    and .closure.sha256sums == "SHA256SUMS"
    and .closure.only_regular_and_directories == true and .closure.regular_nlink_one == true
    and .closure.acls_rejected == true and .closure.xattrs_rejected == true and .closure.bsd_flags_rejected == true
    and .artifact.relative_path == "bin/hepta" and (.artifact.sha256 | test("^[0-9a-f]{64}$"))
    and (.artifact.size_bytes >= 1) and .artifact.contract_schema == "hepta_vnext_live_shell_contract_v1"
    and (.artifact.contract_sha256 | test("^[0-9a-f]{64}$"))
    and .runtime.listen_host == "127.0.0.1" and (.runtime.listen_port >= 1 and .runtime.listen_port <= 65535)
    and (.runtime.state_root | startswith("/")) and (.runtime.install_root | startswith("/"))
    and .runtime.open_mode == "immutable-query-only-open-existing" and .runtime.schema_version == 5
    and .runtime.requires_empty_wal == true and .runtime.keyed_integrity_required == true
    and .runtime.state_snapshot_scope == "full-state-root-v3"
    and .runtime.state_snapshot_receipt_schema == "hepta_vnext_state_snapshot_receipt_v3"
    and .runtime.state_snapshot_mode_profile == "hepta_vnext_state_mode_profile_v3"
    and .runtime.state_snapshot_acl_profile == "hepta_vnext_state_acl_profile_deny_only_v1"
    and .runtime.rollback_recutover_epoch_schema == "v2"
    and .authority == {telegram:false,outbound:false,model_invocation:false,operator_mutation:false,enforce:false,promotion:false,retirement:false,automatic_transition:false}
    and .watchdog.entrypoint == "scripts/hepta-watchdog.sh" and .watchdog.verify_tool == "scripts/hepta-immutable-release-tree"
    and .watchdog.immutable_release_bound == true
    and (.gateway_launch_agent.label | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
    and .gateway_launch_agent.relative_path == ("launchd/" + .gateway_launch_agent.label + ".plist")
    and (.gateway_launch_agent.sha256 | test("^[0-9a-f]{64}$"))
    and .gateway_launch_agent.state_root == .runtime.state_root and .gateway_launch_agent.listen_port == .runtime.listen_port
    and .gateway_launch_agent.effective_gates_all_false == true
    and (.watchdog_launch_agent.label | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
    and .watchdog_launch_agent.relative_path == ("launchd/" + .watchdog_launch_agent.label + ".plist")
    and (.watchdog_launch_agent.sha256 | test("^[0-9a-f]{64}$"))
    and .watchdog_launch_agent.state_root == .runtime.state_root and .watchdog_launch_agent.listen_port == .runtime.listen_port
    and .watchdog_launch_agent.read_only == true
  ' "$manifest" >/dev/null || { echo "invalid vNext immutable release v2 manifest" >&2; return 1; }
  verify_closed_tree_v1 "$release_root" immutable-release-v2 "$release_root/TYPED-INVENTORY.tsv" || return 1
  for relative in $(jq -r '.tooling.scripts[].relative_path' "$manifest"); do
    expected="$(jq -r --arg relative "$relative" '.tooling.scripts[] | select(.relative_path == $relative) | .sha256' "$manifest")"
    [[ "$(sha256_file "$release_root/$relative")" == "$expected" ]] || {
      echo "release tooling differs from its tracked-blob digest: $relative" >&2
      return 1
    }
  done
  artifact="$release_root/$(jq -r '.artifact.relative_path' "$manifest")"
  [[ -f "$artifact" && -x "$artifact" && ! -L "$artifact" \
    && "$(sha256_file "$artifact")" == "$(jq -r '.artifact.sha256' "$manifest")" \
    && "$(file_size "$artifact")" == "$(jq -r '.artifact.size_bytes' "$manifest")" ]] || return 1
  actual_contract="$(read_live_shell_contract "$artifact")" || return 1
  actual_contract_sha="$(sha256_text "$actual_contract")"
  [[ "$actual_contract_sha" == "$(jq -r '.artifact.contract_sha256' "$manifest")" ]] || return 1
  for contract in gateway_launch_agent watchdog_launch_agent; do
    relative="$(jq -r ".${contract}.relative_path" "$manifest")"
    expected="$(jq -r ".${contract}.sha256" "$manifest")"
    [[ "$(sha256_file "$release_root/$relative")" == "$expected" ]] || return 1
    plutil -lint "$release_root/$relative" >/dev/null || return 1
  done
  jq -cn --arg manifest "$manifest" --arg manifest_sha256 "$(sha256_file "$manifest")" \
    --arg inventory_sha256 "$(sha256_file "$release_root/TYPED-INVENTORY.tsv")" \
    --arg sums_sha256 "$(sha256_file "$release_root/SHA256SUMS")" \
    --arg artifact_sha256 "$(sha256_file "$artifact")" \
    '{schema:"hepta_vnext_immutable_release_verification_v2",status:"ready",manifest:$manifest,manifest_sha256:$manifest_sha256,typed_inventory_sha256:$inventory_sha256,sha256sums_sha256:$sums_sha256,artifact_sha256:$artifact_sha256,tooling_commit_tree_and_blobs_bound:true,closed_world_verified:true,service_changed:false}'
}

verify_release() {
  local schema
  schema="$(jq -r '.schema // empty' "$1" 2>/dev/null || true)"
  case "$schema" in
    hepta_vnext_immutable_release_v1) verify_release_v1 "$1" ;;
    hepta_vnext_immutable_release_v2) verify_release_v2 "$1" ;;
    *) echo "unsupported immutable release manifest schema" >&2; return 1 ;;
  esac
}

materialize_release() {
  local binary="$1" destination="$2" state_root="$3" install_root="$4" gateway_label="$5" watchdog_label="$6" listen_port="$7" source_commit="$8"
  local repository head tree tooling_json destination_parent destination_name stage artifact_sha artifact_size live_shell_contract live_shell_contract_sha
  local gateway_plist watchdog_plist gateway_json watchdog_json live_url gateway_sha watchdog_sha gateway_path watchdog_path relative script
  [[ -f "$binary" && -x "$binary" && ! -L "$binary" ]] || { echo "--binary must name a non-symlink executable regular file" >&2; return 1; }
  live_shell_contract="$(read_live_shell_contract "$binary")" || return 1
  live_shell_contract_sha="$(sha256_text "$live_shell_contract")"
  absolute_non_root "$destination"; absolute_non_root "$state_root"; absolute_non_root "$install_root"
  valid_label "$gateway_label"; valid_label "$watchdog_label"; [[ "$gateway_label" != "$watchdog_label" ]] || return 1
  valid_port "$listen_port"; valid_commit "$source_commit"
  repository="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
  head="$(git -C "$repository" rev-parse --verify 'HEAD^{commit}')"
  [[ "$head" == "$source_commit" ]] || { echo "release tooling HEAD does not equal --source-commit" >&2; return 1; }
  [[ -z "$(git -C "$repository" status --porcelain=v1 --untracked-files=all)" ]] || {
    echo "release tooling repository must be canonical and clean" >&2
    return 1
  }
  tree="$(git -C "$repository" rev-parse --verify "$source_commit^{tree}")"
  tooling_json="$(tooling_scripts_json_v2 "$repository" "$source_commit")" || return 1
  [[ "$destination" != "$repository" && "$destination" != "$repository/"* ]] || {
    echo "release destination must remain outside the tooling repository" >&2
    return 1
  }
  [[ ! -e "$destination" && ! -L "$destination" ]] || { echo "release destination already exists: $destination" >&2; return 1; }
  destination_parent="$(cd "$(dirname "$destination")" && pwd -P)"; destination_name="$(basename "$destination")"; destination="$destination_parent/$destination_name"
  stage="$(mktemp -d "$destination_parent/.hepta-release-v2.XXXXXX")"
  trap 'chmod -RN "${stage:-}" 2>/dev/null || true; chmod -R u+w "${stage:-}" 2>/dev/null || true; rm -rf "${stage:-}"' EXIT
  mkdir -p "$stage/bin" "$stage/scripts" "$stage/launchd"
  cp "$binary" "$stage/bin/hepta"; chmod 0500 "$stage/bin/hepta"
  while IFS= read -r relative; do cp "$repository/$relative" "$stage/$relative"; chmod 0500 "$stage/$relative"; done < <(jq -r '.[].relative_path' <<<"$tooling_json")
  gateway_plist="$stage/launchd/$gateway_label.plist"; watchdog_plist="$stage/launchd/$watchdog_label.plist"
  gateway_json="$stage/.gateway-plist.json"; watchdog_json="$stage/.watchdog-plist.json"; live_url="http://127.0.0.1:$listen_port"
  jq -n --arg label "$gateway_label" --arg program "$install_root/bin/hepta" --arg state_root "$state_root" \
    --arg runtime_root "$state_root/runtime-v2" --arg listen "127.0.0.1:$listen_port" --arg live_url "$live_url" \
    --arg stdout "$install_root/logs/gateway/stdout.log" --arg stderr "$install_root/logs/gateway/stderr.log" \
    '{Label:$label,ProgramArguments:[$program,"--serve-ui",$listen,"--state-root",$state_root],WorkingDirectory:$runtime_root,RunAtLoad:true,KeepAlive:true,StandardOutPath:$stdout,StandardErrorPath:$stderr,EnvironmentVariables:{HEPTA_STATE_ROOT:$state_root,HEPTA_LIVE_URL:$live_url,HEPTA_LAUNCHD_LABEL:$label,HEPTA_GATEWAY_ENABLE_TELEGRAM_PLUGIN:"0",HEPTA_NATIVE_POST_REAL_HANDLER_APPROVED:"0",HEPTA_NATIVE_POST_REAL_HANDLERS:"0",HEPTA_NATIVE_TELEGRAM_CODEX_CORE_RUNNER:"0",HEPTA_NATIVE_TELEGRAM_DELIVERY_APPROVED:"0",HEPTA_NATIVE_TELEGRAM_HEPTA_KERNEL_RUNNER:"0",HEPTA_NATIVE_TELEGRAM_IN_PROCESS_MODEL_RUNNER:"0",HEPTA_NATIVE_TELEGRAM_LIVE_READ:"0",HEPTA_NATIVE_TELEGRAM_MODEL_TURN:"0",HEPTA_NATIVE_TELEGRAM_POLL_LOOP:"0",HEPTA_NATIVE_TELEGRAM_SEND:"0",HEPTA_OPERATOR_MUTATION_ENABLED:"0",HEPTA_RUNTIME_MUTATION_CANARY:"0",HEPTA_TELEGRAM_AUTHORITY_ENABLED:"0",HEPTA_ENFORCE_ENABLED:"0",HEPTA_PROMOTION_ENABLED:"0",HEPTA_OUTBOUND_ENABLED:"0",HEPTA_RETIREMENT_ENABLED:"0"}}' >"$gateway_json"
  plutil -convert xml1 -o "$gateway_plist" "$gateway_json"
  jq -n --arg label "$watchdog_label" --arg program "$destination/scripts/hepta-watchdog.sh" \
    --arg manifest "$destination/manifest.json" --arg live_url "$live_url" \
    --arg stdout "$install_root/logs/watchdog/stdout.log" --arg stderr "$install_root/logs/watchdog/stderr.log" \
    '{Label:$label,ProgramArguments:[$program,"--manifest",$manifest,"--url",$live_url],RunAtLoad:true,StartInterval:900,StandardOutPath:$stdout,StandardErrorPath:$stderr}' >"$watchdog_json"
  plutil -convert xml1 -o "$watchdog_plist" "$watchdog_json"
  rm "$gateway_json" "$watchdog_json"; chmod 0400 "$gateway_plist" "$watchdog_plist"
  artifact_sha="$(sha256_file "$stage/bin/hepta")"; artifact_size="$(file_size "$stage/bin/hepta")"
  gateway_sha="$(sha256_file "$gateway_plist")"; watchdog_sha="$(sha256_file "$watchdog_plist")"
  gateway_path="$HOME/Library/LaunchAgents/$gateway_label.plist"; watchdog_path="$HOME/Library/LaunchAgents/$watchdog_label.plist"
  jq -n --arg source_commit "$source_commit" --arg source_tree "$tree" --argjson scripts "$tooling_json" \
    --arg artifact_sha "$artifact_sha" --arg live_shell_contract_sha "$live_shell_contract_sha" --argjson artifact_size "$artifact_size" \
    --arg state_root "$state_root" --arg install_root "$install_root" --argjson listen_port "$listen_port" \
    --arg gateway_label "$gateway_label" --arg watchdog_label "$watchdog_label" \
    --arg gateway_relative "launchd/$gateway_label.plist" --arg watchdog_relative "launchd/$watchdog_label.plist" \
    --arg gateway_sha "$gateway_sha" --arg watchdog_sha "$watchdog_sha" --arg gateway_path "$gateway_path" --arg watchdog_path "$watchdog_path" \
    '{schema:"hepta_vnext_immutable_release_v2",status:"ready",source:{commit:$source_commit,tree:$source_tree},tooling:{commit:$source_commit,tree:$source_tree,repository_clean:true,head_equals_source_commit:true,all_tracked_blobs_exact:true,scripts:$scripts},closure:{profile:"immutable-release-v2",typed_inventory:"TYPED-INVENTORY.tsv",sha256sums:"SHA256SUMS",only_regular_and_directories:true,regular_nlink_one:true,exact_modes:true,acls_rejected:true,xattrs_rejected:true,bsd_flags_rejected:true},artifact:{relative_path:"bin/hepta",sha256:$artifact_sha,size_bytes:$artifact_size,executable:true,contract_schema:"hepta_vnext_live_shell_contract_v1",contract_sha256:$live_shell_contract_sha},runtime:{state_root:$state_root,install_root:$install_root,listen_host:"127.0.0.1",listen_port:$listen_port,open_mode:"immutable-query-only-open-existing",schema_version:5,requires_empty_wal:true,keyed_integrity_required:true,state_snapshot_scope:"full-state-root-v3",state_snapshot_receipt_schema:"hepta_vnext_state_snapshot_receipt_v3",state_snapshot_mode_profile:"hepta_vnext_state_mode_profile_v3",state_snapshot_acl_profile:"hepta_vnext_state_acl_profile_deny_only_v1",rollback_recutover_epoch_schema:"v2"},authority:{telegram:false,outbound:false,model_invocation:false,operator_mutation:false,enforce:false,promotion:false,retirement:false,automatic_transition:false},watchdog:{entrypoint:"scripts/hepta-watchdog.sh",verify_tool:"scripts/hepta-immutable-release-tree",immutable_release_bound:true},gateway_launch_agent:{schema:"hepta_vnext_gateway_launch_agent_v1",relative_path:$gateway_relative,sha256:$gateway_sha,label:$gateway_label,canonical_install_path:$gateway_path,state_root:$state_root,listen_port:$listen_port,effective_gates_all_false:true},watchdog_launch_agent:{schema:"hepta_vnext_watchdog_launch_agent_v1",relative_path:$watchdog_relative,sha256:$watchdog_sha,label:$watchdog_label,canonical_install_path:$watchdog_path,state_root:$state_root,listen_port:$listen_port,read_only:true}}' >"$stage/manifest.json"
  chmod 0400 "$stage/manifest.json"
  find "$stage" -type d -exec chmod 0500 {} +
  clear_node_metadata_v1 "$stage"
  build_closed_tree_closure_v1 "$stage" immutable-release-v2
  fsync_tree "$stage"
  "$repository/scripts/hepta-cutover-guard" publish-directory \
    --staged "$stage" --destination "$destination" >/dev/null
  [[ ! -e "$stage" && -d "$destination" && ! -L "$destination" ]] || { echo "release no-replace publication failed" >&2; return 1; }
  stage=""; fsync_paths "$destination_parent"
  trap - EXIT
  verify_release_v2 "$destination/manifest.json" >/dev/null
  jq -cn --arg release "$destination" --arg manifest "$destination/manifest.json" \
    --arg manifest_sha256 "$(sha256_file "$destination/manifest.json")" \
    --arg inventory_sha256 "$(sha256_file "$destination/TYPED-INVENTORY.tsv")" \
    --arg sums_sha256 "$(sha256_file "$destination/SHA256SUMS")" --arg artifact_sha256 "$artifact_sha" \
    '{schema:"hepta_vnext_immutable_release_materialization_v2",status:"ready",release:$release,manifest:$manifest,manifest_sha256:$manifest_sha256,typed_inventory_sha256:$inventory_sha256,sha256sums_sha256:$sums_sha256,artifact_sha256:$artifact_sha256,tooling_commit_tree_and_blobs_bound:true,closed_world_verified:true,service_changed:false,generation_changed:false}'
}

self_test_binary() {
  local destination="$1" fallback_exit="$2" contract
  contract="$(expected_live_shell_contract)"
  # The single-quoted literals are emitted into the fixture.
  # shellcheck disable=SC2016
  printf '%s\n' '#!/bin/sh' \
    'if [ "$#" -eq 1 ] && [ "$1" = "--hepta-vnext-live-shell-contract-v1" ]; then' \
    "  printf '%s\\n' '$contract'" \
    '  exit 0' \
    'fi' \
    "exit $fallback_exit" >"$destination"
  chmod 0500 "$destination"
}

self_test() {
  local root release temp_root fixture_binary source_commit source_repository clean_repository clean_tool relative
  local downgraded_release manifest_tmp extra_dir_release special_release hardlink_release acl_file_release acl_dir_release xattr_release flags_release dirty_rejected_release
  temp_root="${TMPDIR:-/tmp}"
  root="$(mktemp -d "${temp_root%/}/hepta-release-self-test.XXXXXX")"
  HEPTA_RELEASE_SELF_TEST_ROOT="$root"
  trap 'chflags -R nouchg,noschg "$HEPTA_RELEASE_SELF_TEST_ROOT" 2>/dev/null || true; chmod -RN "$HEPTA_RELEASE_SELF_TEST_ROOT" 2>/dev/null || true; chmod -R u+w "$HEPTA_RELEASE_SELF_TEST_ROOT" 2>/dev/null || true; rm -rf "$HEPTA_RELEASE_SELF_TEST_ROOT"' EXIT
  source_repository="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
  clean_repository="$root/tooling-repository"
  mkdir -p "$clean_repository/scripts"
  for relative in \
    scripts/hepta-immutable-release-tree scripts/hepta-cutover-guard scripts/hepta-generation-pointer scripts/hepta-install-live-gateway \
    scripts/hepta-install-live-watchdog scripts/hepta-launchd-cutover-bridge scripts/hepta-live-soak.sh \
    scripts/hepta-state-snapshot scripts/hepta-watchdog.sh; do
    cp "$source_repository/$relative" "$clean_repository/$relative"
    chmod 0755 "$clean_repository/$relative"
  done
  git -C "$clean_repository" init -q
  git -C "$clean_repository" config user.name hepta-self-test
  git -C "$clean_repository" config user.email hepta-self-test.invalid
  git -C "$clean_repository" add scripts
  git -C "$clean_repository" commit -q -m 'immutable release self-test tooling'
  source_commit="$(git -C "$clean_repository" rev-parse --verify 'HEAD^{commit}')"
  clean_tool="$clean_repository/scripts/hepta-immutable-release-tree"
  release="$root/release"
  fixture_binary="$root/hepta-fixture"
  self_test_binary "$fixture_binary" 0
  if "$clean_tool" materialize --binary /usr/bin/true --destination "$root/rejected-broad-binary" \
    --state-root "$root/state-rejected" --install-root "$root/install-rejected" \
    --gateway-label ai.hepta.rejected --watchdog-label ai.hepta.rejected.watchdog \
    --listen-port 17372 --source-commit "$source_commit" >/dev/null 2>&1; then
    echo "unrelated executable was accepted as a closed vNext live shell" >&2
    exit 1
  fi
  "$clean_tool" materialize --binary "$fixture_binary" --destination "$release" \
    --state-root "$root/state" --install-root "$root/install" \
    --gateway-label ai.hepta.canary --watchdog-label ai.hepta.canary.watchdog \
    --listen-port 17373 --source-commit "$source_commit" >/dev/null
  "$clean_tool" verify --manifest "$release/manifest.json" >/dev/null
  jq -e --arg commit "$source_commit" '
    .schema == "hepta_vnext_immutable_release_v2" and .source.commit == $commit
    and .source.tree == .tooling.tree and .tooling.commit == $commit
    and (.tooling.scripts | length == 9) and .closure.profile == "immutable-release-v2"
    and .runtime.state_snapshot_acl_profile == "hepta_vnext_state_acl_profile_deny_only_v1"
  ' "$release/manifest.json" >/dev/null
  [[ "$(stat -f '%Lp' "$release")" == 500 \
    && "$(stat -f '%Lp' "$release/bin/hepta")" == 500 \
    && "$(stat -f '%Lp' "$release/manifest.json")" == 400 \
    && "$(stat -f '%Lp' "$release/TYPED-INVENTORY.tsv")" == 400 \
    && "$(stat -f '%l' "$release/manifest.json")" == 1 ]] || exit 1

  # The downgrade copy is complete and internally self-consistent: its typed
  # inventory and SHA256SUMS are rebuilt after the manifest mutation. Rejection
  # therefore exercises the contract rather than a missing-neighbor shortcut.
  downgraded_release="$root/downgraded-release"
  cp -pR "$release" "$downgraded_release"
  chmod 0700 "$downgraded_release"; chmod 0600 "$downgraded_release/manifest.json"
  manifest_tmp="$root/downgraded-manifest.tmp"
  jq '.runtime.state_snapshot_scope="full-state-root-v2" | .runtime.state_snapshot_receipt_schema="hepta_vnext_state_snapshot_receipt_v2" | del(.runtime.state_snapshot_mode_profile,.runtime.state_snapshot_acl_profile)' \
    "$downgraded_release/manifest.json" >"$manifest_tmp"
  cp "$manifest_tmp" "$downgraded_release/manifest.json"; chmod 0400 "$downgraded_release/manifest.json"; chmod 0500 "$downgraded_release"
  build_closed_tree_closure_v1 "$downgraded_release" immutable-release-v2
  if verify_release "$downgraded_release/manifest.json" >/dev/null 2>&1; then
    echo "immutable release accepted a downgraded v2 snapshot profile" >&2
    exit 1
  fi

  extra_dir_release="$root/extra-dir-release"; cp -pR "$release" "$extra_dir_release"; chmod 0700 "$extra_dir_release"; mkdir "$extra_dir_release/extra"; chmod 0500 "$extra_dir_release/extra" "$extra_dir_release"
  if verify_release "$extra_dir_release/manifest.json" >/dev/null 2>&1; then echo "immutable release accepted an extra directory" >&2; exit 1; fi
  special_release="$root/special-release"; cp -pR "$release" "$special_release"; chmod 0700 "$special_release"; mkfifo "$special_release/fifo"; chmod 0400 "$special_release/fifo"; chmod 0500 "$special_release"
  if verify_release "$special_release/manifest.json" >/dev/null 2>&1; then echo "immutable release accepted a FIFO" >&2; exit 1; fi
  hardlink_release="$root/hardlink-release"; cp -pR "$release" "$hardlink_release"; ln "$hardlink_release/manifest.json" "$root/external-release-hardlink"
  if verify_release "$hardlink_release/manifest.json" >/dev/null 2>&1; then echo "immutable release accepted a root-external hardlink" >&2; exit 1; fi
  rm "$root/external-release-hardlink"
  acl_file_release="$root/acl-file-release"; cp -pR "$release" "$acl_file_release"; chmod +a 'everyone allow read' "$acl_file_release/manifest.json"
  if verify_release "$acl_file_release/manifest.json" >/dev/null 2>&1; then echo "immutable release accepted an allow ACL on a file" >&2; exit 1; fi
  acl_dir_release="$root/acl-dir-release"; cp -pR "$release" "$acl_dir_release"; chmod +a 'everyone allow list' "$acl_dir_release/scripts"
  if verify_release "$acl_dir_release/manifest.json" >/dev/null 2>&1; then echo "immutable release accepted an allow ACL on a directory" >&2; exit 1; fi
  xattr_release="$root/xattr-release"; cp -pR "$release" "$xattr_release"; chmod 0600 "$xattr_release/manifest.json"; /usr/bin/xattr -w com.hepta.release.selftest value "$xattr_release/manifest.json"; chmod 0400 "$xattr_release/manifest.json"
  if verify_release "$xattr_release/manifest.json" >/dev/null 2>&1; then echo "immutable release accepted an xattr" >&2; exit 1; fi
  unreadable_xattr_release="$root/unreadable-xattr-release"; cp -pR "$release" "$unreadable_xattr_release"; chmod 0600 "$unreadable_xattr_release/manifest.json"
  /usr/bin/xattr -w com.hepta.release.selftest value "$unreadable_xattr_release/manifest.json"
  chmod +a 'everyone deny readextattr' "$unreadable_xattr_release/manifest.json"; chmod 0400 "$unreadable_xattr_release/manifest.json"
  if node_xattr_sha256_v1 "$unreadable_xattr_release/manifest.json" >/dev/null 2>&1; then
    echo "immutable release xattr helper accepted an unreadable namespace" >&2
    exit 1
  fi
  flags_release="$root/flags-release"; cp -pR "$release" "$flags_release"; chflags hidden "$flags_release/manifest.json"
  if verify_release "$flags_release/manifest.json" >/dev/null 2>&1; then echo "immutable release accepted BSD flags" >&2; exit 1; fi

  printf '\n# dirty tracked bytes\n' >>"$clean_repository/scripts/hepta-watchdog.sh"
  dirty_rejected_release="$root/dirty-rejected-release"
  if "$clean_tool" materialize --binary "$fixture_binary" --destination "$dirty_rejected_release" \
    --state-root "$root/dirty-state" --install-root "$root/dirty-install" \
    --gateway-label ai.hepta.dirty --watchdog-label ai.hepta.dirty.watchdog \
    --listen-port 17374 --source-commit "$source_commit" >/dev/null 2>&1; then
    echo "immutable release accepted dirty tooling bytes" >&2
    exit 1
  fi
  jq -cn '{schema:"hepta_vnext_immutable_release_self_test_v2",status:"ready",canary_port:17373,canonical_clean_repository_required:true,head_equals_source_commit:true,tooling_commit_tree_and_nine_blobs_bound:true,full_typed_closed_world_inventory:true,exact_directory_0500_and_file_0400_0500_modes:true,regular_nlink_one:true,extra_directory_rejected:true,fifo_rejected:true,external_hardlink_rejected:true,allow_acl_file_rejected:true,allow_acl_directory_rejected:true,xattr_rejected:true,unreadable_xattr_rejected:true,bsd_flags_rejected:true,coherent_snapshot_downgrade_rejected:true,snapshot_profile_v3_bound:true,snapshot_acl_profile_bound:true,unrelated_binary_rejected:true,contract_bound:true,production_unchanged:true}'
}

command="${1:-}"
[[ -n "$command" ]] || usage
shift
case "$command" in
  verify)
    [[ "${1:-}" == "--manifest" && -n "${2:-}" && $# -eq 2 ]] || usage
    verify_release "$2"
    ;;
  self-test)
    [[ $# -eq 0 ]] || usage
    self_test
    ;;
  materialize)
    binary=""; destination=""; state_root="${HEPTA_STATE_ROOT:-$HOME/.local/share/hepta-vnext/live-snapshot}"
    install_root="${HEPTA_INSTALL_ROOT:-$HOME/.local/opt/hepta-vnext}"
    gateway_label="${HEPTA_GATEWAY_LABEL:-ai.hepta.gateway}"
    watchdog_label="${HEPTA_WATCHDOG_LABEL:-ai.hepta.installed-live-watchdog}"
    listen_port="${HEPTA_LISTEN_PORT:-7373}"
    source_commit=""
    while (( $# > 0 )); do
      case "$1" in
        --binary) shift; [[ $# -gt 0 ]] || usage; binary="$1" ;;
        --destination) shift; [[ $# -gt 0 ]] || usage; destination="$1" ;;
        --state-root) shift; [[ $# -gt 0 ]] || usage; state_root="$1" ;;
        --install-root) shift; [[ $# -gt 0 ]] || usage; install_root="$1" ;;
        --gateway-label) shift; [[ $# -gt 0 ]] || usage; gateway_label="$1" ;;
        --watchdog-label) shift; [[ $# -gt 0 ]] || usage; watchdog_label="$1" ;;
        --listen-port) shift; [[ $# -gt 0 ]] || usage; listen_port="$1" ;;
        --source-commit) shift; [[ $# -gt 0 ]] || usage; source_commit="$1" ;;
        *) usage ;;
      esac
      shift
    done
    [[ -n "$binary" && -n "$destination" && -n "$source_commit" ]] || usage
    materialize_release "$binary" "$destination" "$state_root" "$install_root" \
      "$gateway_label" "$watchdog_label" "$listen_port" "$source_commit"
    ;;
  *) usage ;;
esac
