from __future__ import annotations

import json
import textwrap
from pathlib import Path

codec_path = Path("codex-rs/hepta-control-plane/src/planner_execution_codec.rs")
codec = codec_path.read_text(encoding="utf-8")
old_operation = '''pub(super) fn operation_identity_digest(request: &GrantRequestV1) -> Digest32 {
    let mut bytes = b"hepta.control.execution-operation.v1".to_vec();
    push_id(&mut bytes, request.operation_id.as_str());
    push_id(&mut bytes, request.candidate_id.as_str());
    bytes.extend_from_slice(request.plan_digest.as_array());
    bytes.extend_from_slice(request.final_payload_digest.as_array());
    Digest32::of_bytes(&bytes)
}
'''
new_operation = '''pub(super) fn operation_identity_digest(request: &GrantRequestV1) -> Digest32 {
    crate::planner_operation_identity_digest_v1(request)
}
'''
old_request = '''pub(super) fn request_digest(request: &GrantRequestV1) -> Digest32 {
    let mut bytes = b"hepta.control.execution-request.v1".to_vec();
    push_id(&mut bytes, request.operation_id.as_str());
    push_id(&mut bytes, request.candidate_id.as_str());
    bytes.extend_from_slice(request.plan_digest.as_array());
    bytes.extend_from_slice(request.final_payload_digest.as_array());
    bytes.extend_from_slice(request.objective_digest.as_array());
    bytes.extend_from_slice(request.snapshot_digest.as_array());
    bytes.extend_from_slice(request.revocation_frontier_digest.as_array());
    bytes.extend_from_slice(&request.expires_at_micros.to_be_bytes());
    Digest32::of_bytes(&bytes)
}
'''
new_request = '''pub(super) fn request_digest(request: &GrantRequestV1) -> Digest32 {
    crate::planner_request_digest_v1(request)
}
'''
old_push_id = '''fn push_id(bytes: &mut Vec<u8>, value: &str) {
    bytes.extend_from_slice(&u64::try_from(value.len()).unwrap_or(u64::MAX).to_be_bytes());
    bytes.extend_from_slice(value.as_bytes());
}

'''
for old, new, label in (
    (old_operation, new_operation, "operation identity"),
    (old_request, new_request, "request identity"),
):
    if old not in codec:
        raise SystemExit(f"missing canonical codec block: {label}")
    codec = codec.replace(old, new, 1)
if old_push_id not in codec:
    raise SystemExit("missing obsolete codec push_id helper")
codec = codec.replace(old_push_id, "", 1)
codec_path.write_text(codec, encoding="utf-8")

map_path = Path("docs/modules/control.runtime/IMPLEMENTATION_MAP.json")
implementation = json.loads(map_path.read_text(encoding="utf-8"))
operations = implementation.get("operations")
if not isinstance(operations, list):
    raise SystemExit("implementation map operations must be a list")

