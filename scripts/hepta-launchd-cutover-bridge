#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  hepta-launchd-cutover-bridge prepare --manifest PATH --launch-agent-root DIR --bundle DIR --snapshot-receipt PATH --canary-receipt PATH --soak-receipt PATH
  hepta-launchd-cutover-bridge prepare-recutover --manifest PATH --launch-agent-root DIR --bundle DIR --parent-bundle DIR --previous-receipt ROLLBACK --snapshot-receipt PATH --canary-receipt PATH --soak-receipt PATH
  hepta-launchd-cutover-bridge rebase-after-rollback --bundle DIR --previous-receipt ROLLBACK [--output-receipt PATH] [--apply]
  hepta-launchd-cutover-bridge cutover --bundle DIR [--output-receipt PATH] [--apply]
  hepta-launchd-cutover-bridge rollback --bundle DIR --previous-receipt PATH [--output-receipt PATH] [--apply]
  hepta-launchd-cutover-bridge recutover --bundle DIR --previous-receipt PATH [--output-receipt PATH] [--apply]
  hepta-launchd-cutover-bridge recover-pending --bundle DIR --pending-receipt PATH [--apply]
  hepta-launchd-cutover-bridge self-test

prepare snapshots and hashes the exact legacy and vNext plists without loading
anything. Transition commands are dry-run unless --apply is explicit. The
legacy executable is never copied into a vNext release or described as closed.
EOF
  exit 64
}

sha256_file() { shasum -a 256 "$1" | awk '{print $1}'; }

bridge_empty_metadata_sha256() { printf '' | shasum -a 256 | awk '{print $1}'; }
bridge_acl_sha256() { /bin/ls -lden "$1" | sed '1d' | shasum -a 256 | awk '{print $1}'; }
bridge_xattr_sha256() {
  local item="$1" names name value_sha
  if ! names="$(/usr/bin/xattr "$item" 2>/dev/null)"; then
    echo "could not enumerate bridge-bundle xattrs: $item" >&2
    return 1
  fi
  {
    if [[ -n "$names" ]]; then
      printf '%s\n' "$names" | LC_ALL=C sort | while IFS= read -r name; do
        [[ "$name" != *$'\n'* && "$name" != *$'\r'* && "$name" != *'|'* ]] || exit 1
        value_sha="$(/usr/bin/xattr -p "$name" "$item" | shasum -a 256 | awk '{print $1}')" || exit 1
        printf '%s|%s\n' "$name" "$value_sha" || exit 1
      done
    fi
  } | shasum -a 256 | awk '{print $1}'
}

bridge_validate_names() {
  local tree_root="$1" item relative
  while IFS= read -r -d '' item; do
    relative="${item#"$tree_root"/}"
    [[ "$relative" != *$'\n'* && "$relative" != *$'\r'* && "$relative" != *'|'* ]] || return 1
  done < <(find "$tree_root" -print0)
}

bridge_typed_inventory() {
  local tree_root="$1" output="$2" item relative item_type mode nlink size flags acl_sha xattr_sha digest empty_sha
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  bridge_validate_names "$tree_root" || return 1
  empty_sha="$(bridge_empty_metadata_sha256)"
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      [[ "$item" != ./TYPED-INVENTORY.tsv && "$item" != ./SHA256SUMS ]] || continue
      relative="${item#./}"; [[ "$item" != . ]] || relative=.
      [[ ! -L "$item" ]] || exit 1
      if [[ -f "$item" ]]; then item_type='file'
      elif [[ -d "$item" ]]; then item_type='directory'
      else exit 1
      fi
      mode="$(stat -f '%Lp' "$item")"; nlink="$(stat -f '%l' "$item")"; flags="$(stat -f '%f' "$item")"
      if [[ "$item_type" == file ]]; then
        [[ "$mode" == 400 && "$nlink" == 1 ]] || exit 1
        size="$(stat -f '%z' "$item")"; digest="$(sha256_file "$item")"
      else
        [[ "$mode" == 500 ]] || exit 1
        size=-; digest=-
      fi
      acl_sha="$(bridge_acl_sha256 "$item")" || exit 1
      xattr_sha="$(bridge_xattr_sha256 "$item")" || exit 1
      [[ "$flags" == 0 && "$acl_sha" == "$empty_sha" && "$xattr_sha" == "$empty_sha" ]] || exit 1
      printf '%s|%s|%04d|%s|%s|%s|%s|%s|%s\n' "$relative" "$item_type" "$mode" "$nlink" "$size" "$flags" "$acl_sha" "$xattr_sha" "$digest"
    done
  ) >"$output"
}

bridge_clear_metadata() {
  local tree_root="$1" item
  chmod -RN "$tree_root" 2>/dev/null || true
  while IFS= read -r -d '' item; do
    /usr/bin/xattr -c "$item" 2>/dev/null || true
    chflags nouchg,noschg,nohidden "$item" 2>/dev/null || true
  done < <(find "$tree_root" -print0)
}

bridge_set_closed_modes() {
  local tree_root="$1"
  find "$tree_root" -type d -exec chmod 0500 {} +
  find "$tree_root" -type f -exec chmod 0400 {} +
}

bridge_build_closure() {
  local tree_root="$1" temp_root inventory_tmp sums_tmp relative
  temp_root="${TMPDIR:-/tmp}"
  inventory_tmp="$(mktemp "${temp_root%/}/hepta-bridge-inventory-build.XXXXXX")"
  sums_tmp="$(mktemp "${temp_root%/}/hepta-bridge-sums-build.XXXXXX")"
  trap 'rm -f "${inventory_tmp:-}" "${sums_tmp:-}"; trap - RETURN' RETURN
  chmod 0700 "$tree_root"; rm -f "$tree_root/TYPED-INVENTORY.tsv" "$tree_root/SHA256SUMS"; chmod 0500 "$tree_root"
  bridge_typed_inventory "$tree_root" "$inventory_tmp"
  chmod 0700 "$tree_root"; cp "$inventory_tmp" "$tree_root/TYPED-INVENTORY.tsv"; chmod 0400 "$tree_root/TYPED-INVENTORY.tsv"
  (cd "$tree_root" && find . -type f ! -name SHA256SUMS -print | sed 's#^./##' | LC_ALL=C sort \
    | while IFS= read -r relative; do shasum -a 256 "$relative"; done) >"$sums_tmp"
  cp "$sums_tmp" "$tree_root/SHA256SUMS"; chmod 0400 "$tree_root/SHA256SUMS"; chmod 0500 "$tree_root"
  bridge_typed_inventory "$tree_root" "$inventory_tmp"
  chmod 0700 "$tree_root"; chmod 0600 "$tree_root/TYPED-INVENTORY.tsv" "$tree_root/SHA256SUMS"
  cp "$inventory_tmp" "$tree_root/TYPED-INVENTORY.tsv"; chmod 0400 "$tree_root/TYPED-INVENTORY.tsv"
  (cd "$tree_root" && find . -type f ! -name SHA256SUMS -print | sed 's#^./##' | LC_ALL=C sort \
    | while IFS= read -r relative; do shasum -a 256 "$relative"; done) >"$sums_tmp"
  cp "$sums_tmp" "$tree_root/SHA256SUMS"; chmod 0400 "$tree_root/SHA256SUMS"
  chmod -N "$tree_root/TYPED-INVENTORY.tsv" "$tree_root/SHA256SUMS" 2>/dev/null || true
  /usr/bin/xattr -c "$tree_root/TYPED-INVENTORY.tsv" "$tree_root/SHA256SUMS" 2>/dev/null || true
  chflags nouchg,noschg,nohidden "$tree_root/TYPED-INVENTORY.tsv" "$tree_root/SHA256SUMS" 2>/dev/null || true
  chmod 0500 "$tree_root"; trap - RETURN; rm -f "$inventory_tmp" "$sums_tmp"
}

bridge_verify_closure() {
  local bundle="$1" temp_root actual_inventory actual_paths expected_paths empty_sha closure
  [[ -f "$bundle/TYPED-INVENTORY.tsv" && ! -L "$bundle/TYPED-INVENTORY.tsv" \
    && -f "$bundle/SHA256SUMS" && ! -L "$bundle/SHA256SUMS" \
    && "$(stat -f '%Lp' "$bundle/TYPED-INVENTORY.tsv")" == 400 \
    && "$(stat -f '%Lp' "$bundle/SHA256SUMS")" == 400 \
    && "$(stat -f '%l' "$bundle/TYPED-INVENTORY.tsv")" == 1 \
    && "$(stat -f '%l' "$bundle/SHA256SUMS")" == 1 ]] || return 1
  empty_sha="$(bridge_empty_metadata_sha256)"
  for closure in "$bundle/TYPED-INVENTORY.tsv" "$bundle/SHA256SUMS"; do
    [[ "$(stat -f '%f' "$closure")" == 0 \
      && "$(bridge_acl_sha256 "$closure")" == "$empty_sha" \
      && "$(bridge_xattr_sha256 "$closure")" == "$empty_sha" ]] || return 1
  done
  temp_root="${TMPDIR:-/tmp}"; actual_inventory="$(mktemp "${temp_root%/}/hepta-bridge-inventory-verify.XXXXXX")"
  actual_paths="$(mktemp "${temp_root%/}/hepta-bridge-paths-verify.XXXXXX")"; expected_paths="$(mktemp "${temp_root%/}/hepta-bridge-paths-expected.XXXXXX")"
  trap 'rm -f "${actual_inventory:-}" "${actual_paths:-}" "${expected_paths:-}"; trap - RETURN' RETURN
  bridge_typed_inventory "$bundle" "$actual_inventory" || return 1
  diff -u "$bundle/TYPED-INVENTORY.tsv" "$actual_inventory" >/dev/null || return 1
  (cd "$bundle" && shasum -a 256 -c SHA256SUMS >/dev/null \
    && find . -type f ! -name SHA256SUMS -print | sed 's#^./##' | LC_ALL=C sort >"$actual_paths" \
    && awk '{print substr($0,67)}' SHA256SUMS | LC_ALL=C sort >"$expected_paths" \
    && diff -u "$expected_paths" "$actual_paths" >/dev/null) || return 1
  trap - RETURN; rm -f "$actual_inventory" "$actual_paths" "$expected_paths"
}

absolute_non_root() {
  [[ "$1" == /* \
    && "$1" != "/" \
    && "$1" != */ \
    && "$1" != *"//"* \
    && "$1" != *"/../"* \
    && "$1" != *"/./"* \
    && "$1" != */.. \
    && "$1" != */. ]] || {
    echo "path must be absolute, normalized, and non-root: $1" >&2
    return 1
  }
}

canonical_file() {
  [[ -f "$1" && ! -L "$1" ]] || { echo "regular non-symlink file required: $1" >&2; return 1; }
  local directory
  directory="$(cd "$(dirname "$1")" && pwd -P)"
  printf '%s/%s\n' "$directory" "$(basename "$1")"
}

validate_label() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "invalid launchd label: $1" >&2
    return 1
  }
}

verify_release_manifest() {
  local manifest="$1" release verify_relative
  manifest="$(canonical_file "$manifest")" || return 1
  release="$(dirname "$manifest")"
  verify_relative="$(jq -r '.watchdog.verify_tool' "$manifest")" || return 1
  [[ "$verify_relative" == "scripts/hepta-immutable-release-tree" ]] || {
    echo "manifest declares an unsupported verifier" >&2
    return 1
  }
  "$release/$verify_relative" verify --manifest "$manifest" >/dev/null || return 1
}

verify_evidence_receipts() {
  local manifest="$1" snapshot_receipt="$2" canary_receipt="$3" soak_receipt="$4"
  local release state_root binary_sha source_commit soak_sha manifest_sha snapshot_sha snapshot_schema snapshot_profile snapshot_mode_profile snapshot_acl_profile
  local manifest_snapshot_scope manifest_snapshot_schema manifest_snapshot_mode_profile manifest_snapshot_acl_profile
  local canary_manifest canary_manifest_sha canary_state_root canary_samples
  release="$(dirname "$manifest")"
  snapshot_receipt="$(canonical_file "$snapshot_receipt")" || return 1
  canary_receipt="$(canonical_file "$canary_receipt")" || return 1
  soak_receipt="$(canonical_file "$soak_receipt")" || return 1
  state_root="$(jq -r '.runtime.state_root' "$manifest")" || return 1
  binary_sha="$(jq -r '.artifact.sha256' "$manifest")" || return 1
  source_commit="$(jq -r '.source.commit' "$manifest")" || return 1
  manifest_sha="$(sha256_file "$manifest")" || return 1
  snapshot_sha="$(sha256_file "$snapshot_receipt")" || return 1
  "$release/scripts/hepta-state-snapshot" verify --receipt "$snapshot_receipt" >/dev/null || return 1
  snapshot_schema="$(jq -r '.schema' "$snapshot_receipt")" || return 1
  snapshot_profile="$(jq -r '.profile // empty' "$snapshot_receipt")" || return 1
  snapshot_mode_profile="$(jq -r '.mode_profile // empty' "$snapshot_receipt")" || return 1
  snapshot_acl_profile="$(jq -r '.acl_profile // empty' "$snapshot_receipt")" || return 1
  manifest_snapshot_scope="$(jq -r '.runtime.state_snapshot_scope // empty' "$manifest")" || return 1
  manifest_snapshot_schema="$(jq -r '.runtime.state_snapshot_receipt_schema // empty' "$manifest")" || return 1
  manifest_snapshot_mode_profile="$(jq -r '.runtime.state_snapshot_mode_profile // empty' "$manifest")" || return 1
  manifest_snapshot_acl_profile="$(jq -r '.runtime.state_snapshot_acl_profile // empty' "$manifest")" || return 1
  if [[ "$manifest_snapshot_scope" != full-state-root-v3 \
    || "$manifest_snapshot_schema" != hepta_vnext_state_snapshot_receipt_v3 \
    || "$manifest_snapshot_mode_profile" != hepta_vnext_state_mode_profile_v3 \
    || "$manifest_snapshot_acl_profile" != hepta_vnext_state_acl_profile_deny_only_v1 \
    || "$snapshot_schema" != hepta_vnext_state_snapshot_receipt_v3 \
    || "$snapshot_profile" != full-state-root-v3 \
    || "$snapshot_mode_profile" != hepta_vnext_state_mode_profile_v3 \
    || "$snapshot_acl_profile" != hepta_vnext_state_acl_profile_deny_only_v1 ]]; then
    echo "cutover requires the exact full-state-root-v3 receipt, mode, and ACL profiles" >&2
    return 1
  fi
  [[ "$(jq -r '.destination_state_root' "$snapshot_receipt")" == "$state_root" ]] || {
    echo "state snapshot receipt is not bound to the release state root" >&2
    return 1
  }
  canary_manifest="$(jq -er '.manifest' "$canary_receipt")" || return 1
  canary_manifest_sha="$(jq -er '.manifest_sha256' "$canary_receipt")" || return 1
  canary_state_root="$(jq -er '.canary_state_root' "$canary_receipt")" || return 1
  canary_samples="$(jq -er '.soak_samples' "$canary_receipt")" || return 1
  jq -e --arg binary_sha "$binary_sha" --arg canary_manifest "$canary_manifest" \
    --arg canary_manifest_sha "$canary_manifest_sha" --arg canary_state_root "$canary_state_root" \
    --argjson canary_samples "$canary_samples" '
    .schema == "hepta_vnext_live_soak_v1"
    and .status == "ready"
    and .live_url == "http://127.0.0.1:17373"
    and .manifest == $canary_manifest
    and .manifest_sha256 == $canary_manifest_sha
    and .active_artifact_sha256 == $binary_sha
    and .state_root == $canary_state_root
    and (.samples >= 3)
    and .samples == $canary_samples
    and .passed == .samples
    and .failed == 0
    and .schema_v5_open_existing == true
    and .keyed_integrity_verified == true
    and .immutable_query_only == true
    and .authority_all_closed == true
    and .service_changed == false
  ' "$soak_receipt" >/dev/null || { echo "invalid canary soak receipt" >&2; return 1; }
  soak_sha="$(sha256_file "$soak_receipt")" || return 1
  jq -e --arg binary_sha "$binary_sha" --arg source_commit "$source_commit" \
    --arg target_manifest "$manifest" --arg target_manifest_sha "$manifest_sha" \
    --arg state_root "$state_root" --arg soak_sha "$soak_sha" --arg snapshot_sha "$snapshot_sha" '
    .schema == "hepta_vnext_runtime_canary_e2e_v3"
    and .status == "ready"
    and .listen_addr == "127.0.0.1:17373"
    and .source_commit == $source_commit
    and .source_tree_clean == true
    and .binary_sha256 == $binary_sha
    and (.manifest | startswith("/"))
    and (.manifest_sha256 | test("^[0-9a-f]{64}$"))
    and (.canary_state_root | startswith("/"))
    and .target_manifest == $target_manifest
    and .target_manifest_sha256 == $target_manifest_sha
    and .snapshot_receipt_sha256 == $snapshot_sha
    and .source_state_root == $state_root
    and .soak_receipt_sha256 == $soak_sha
    and (.source_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.copy_payload_sha256 | test("^[0-9a-f]{64}$"))
    and .soak_samples >= 3
    and .schema_v5_open_existing == true
    and .keyed_integrity_verified == true
    and .immutable_query_only == true
    and .requires_empty_wal == true
    and .source_state_copied == true
    and .source_unchanged == true
    and .copy_unchanged == true
    and .metadata_and_hash_checked == true
    and .installer_dry_run == true
    and .protected_routes_absent == true
    and .non_get_rejected == true
    and .authority_all_closed == true
    and .production_service_changed == false
    and .deny_only_acls_preserved == true
    and (.snapshot_acl_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and .copy_acl_inventory_sha256 == .snapshot_acl_inventory_sha256
  ' "$canary_receipt" >/dev/null || { echo "invalid exact canary receipt" >&2; return 1; }
  jq -e --arg snapshot_sha "$snapshot_sha" \
      --arg snapshot_id "$(jq -r '.snapshot_id' "$snapshot_receipt")" \
      --arg identity "$(jq -r '.source_identity_inventory_sha256' "$snapshot_receipt")" \
      --arg portable "$(jq -r '.portable_payload_inventory_sha256' "$snapshot_receipt")" \
      --arg modes "$(jq -r '.original_mode_inventory_sha256' "$snapshot_receipt")" \
      --arg acls "$(jq -r '.acl_inventory_sha256' "$snapshot_receipt")" \
      --arg top "$(jq -r '.top_level_inventory_sha256' "$snapshot_receipt")" \
      --arg sidecar "$(jq -r '.sqlite_sidecar_inventory_sha256' "$snapshot_receipt")" \
      --arg key "$(jq -r '.key_inventory_sha256' "$snapshot_receipt")" \
      --arg hardlinks "$(jq -r '.hardlink_topology_inventory_sha256' "$snapshot_receipt")" '
      .schema == "hepta_vnext_runtime_canary_e2e_v3"
      and .snapshot_receipt_sha256 == $snapshot_sha
      and .snapshot_schema == "hepta_vnext_state_snapshot_receipt_v3"
      and .snapshot_profile == "full-state-root-v3"
      and .snapshot_mode_profile == "hepta_vnext_state_mode_profile_v3"
      and .snapshot_acl_profile == "hepta_vnext_state_acl_profile_deny_only_v1"
      and .snapshot_id == $snapshot_id
      and .snapshot_source_identity_inventory_sha256 == $identity
      and .snapshot_portable_payload_inventory_sha256 == $portable
      and .snapshot_original_mode_inventory_sha256 == $modes
      and .snapshot_acl_inventory_sha256 == $acls
      and .copy_payload_sha256 == $portable
      and .copy_mode_inventory_sha256 == $modes
      and .copy_acl_inventory_sha256 == $acls
      and .snapshot_top_level_inventory_sha256 == $top
      and .snapshot_sqlite_sidecar_inventory_sha256 == $sidecar
      and .snapshot_key_inventory_sha256 == $key
      and .snapshot_hardlink_topology_inventory_sha256 == $hardlinks
      and .full_state_source_copied == true
      and .full_snapshot_receipt_bound == true
      and .all_top_level_entries_copied == true
      and .original_modes_preserved == true
      and .deny_only_acls_preserved == true
      and .hardlinks_preserved == true
    ' "$canary_receipt" >/dev/null || {
      echo "full-root v3 snapshot and canary inventories are not exactly bound" >&2
      return 1
    }
  jq -e --argjson predecessor "$(jq -c '.recutover_predecessor' "$snapshot_receipt")" '
    .snapshot_recutover_predecessor == $predecessor
  ' "$canary_receipt" >/dev/null || {
    echo "canary did not inherit the snapshot recutover predecessor exactly" >&2
    return 1
  }
  if [[ "$(jq -r '.writer_barrier.self_test_exemption' "$snapshot_receipt")" != true ]]; then
    jq -e --argjson writer_barrier "$(jq -c '.writer_barrier' "$snapshot_receipt")" '
      .writer_admission_closed == true and .snapshot_writer_barrier == $writer_barrier
    ' "$canary_receipt" >/dev/null || {
      echo "canary did not inherit the production writer barrier exactly" >&2
      return 1
    }
  fi
}

verify_snapshot_source_fresh() {
  local manifest="$1" snapshot_receipt="$2" release
  release="$(dirname "$manifest")"
  "$release/scripts/hepta-state-snapshot" verify-source --receipt "$snapshot_receipt" >/dev/null || {
    echo "state snapshot source is no longer quiescent and byte-exact" >&2
    return 1
  }
}

writer_restore_receipt_for_plan() {
  local plan="$1" bundle="$2" snapshot barrier
  snapshot="$bundle/$(jq -r '.evidence.snapshot.relative_path' "$plan")"
  if [[ "$(jq -r '.writer_barrier.self_test_exemption' "$snapshot")" == true ]]; then
    return 0
  fi
  barrier="$(jq -r '.writer_barrier.receipt' "$snapshot")"
  absolute_non_root "$barrier" || return 1
  if [[ "$barrier" == *.json ]]; then
    printf '%s\n' "${barrier%.json}.restore.json"
  else
    printf '%s\n' "$barrier.restore.json"
  fi
}

ensure_legacy_writer_restored() {
  local plan="$1" bundle="$2" snapshot barrier restore manifest release guard
  snapshot="$bundle/$(jq -r '.evidence.snapshot.relative_path' "$plan")"
  if [[ "$(jq -r '.writer_barrier.self_test_exemption' "$snapshot")" == true ]]; then
    return 0
  fi
  barrier="$(jq -r '.writer_barrier.receipt' "$snapshot")"
  restore="$(writer_restore_receipt_for_plan "$plan" "$bundle")" || return 1
  manifest="$(jq -r '.manifest' "$plan")"
  release="$(dirname "$manifest")"
  guard="$release/scripts/hepta-cutover-guard"
  [[ -f "$guard" && -x "$guard" && ! -L "$guard" ]] || return 1
  if [[ -e "$restore" || -L "$restore" ]]; then
    "$guard" verify-restore --receipt "$barrier" --restore-receipt "$restore" >/dev/null || return 1
  else
    /usr/bin/sudo -n "$guard" restore-writer --receipt "$barrier" --output-receipt "$restore" >/dev/null || return 1
    "$guard" verify-restore --receipt "$barrier" --restore-receipt "$restore" >/dev/null || return 1
  fi
}

reserve_private_receipt() {
  local destination="$1" source="$2" parent staged
  absolute_non_root "$destination" || return 1
  [[ ! -e "$destination" && ! -L "$destination" ]] || {
    echo "refusing to replace receipt: $destination" >&2
    return 1
  }
  parent="$(dirname "$destination")"
  mkdir -p "$parent" || return 1
  chmod 0700 "$parent" || return 1
  [[ "$(cd "$parent" && pwd -P)" == "$parent" ]] || {
    echo "transition receipt parent must be a physical canonical directory" >&2
    return 1
  }
  staged="$(mktemp "$parent/.hepta-bridge-receipt.XXXXXX")" || return 1
  cp "$source" "$staged" || { rm -f "$staged"; return 1; }
  chmod 0400 "$staged" || { rm -f "$staged"; return 1; }
  ln "$staged" "$destination" || {
    rm -f "$staged"
    echo "failed to reserve a new transition receipt" >&2
    return 1
  }
  rm -f "$staged" || true
}

replace_reserved_receipt() {
  local destination="$1" expected_sha="$2" source="$3" parent staged source_sha
  [[ -f "$destination" && ! -L "$destination" && "$(sha256_file "$destination")" == "$expected_sha" ]] || {
    echo "transition receipt reservation changed before finalization" >&2
    return 1
  }
  parent="$(dirname "$destination")"
  source_sha="$(sha256_file "$source")" || return 1
  staged="$(mktemp "$parent/.hepta-bridge-receipt-final.XXXXXX")" || return 1
  cp "$source" "$staged" || { rm -f "$staged"; return 1; }
  chmod 0400 "$staged" || { rm -f "$staged"; return 1; }
  [[ "$(sha256_file "$staged")" == "$source_sha" ]] || { rm -f "$staged"; return 1; }
  mv -f "$staged" "$destination" || { rm -f "$staged"; return 1; }
}

with_bridge_operation_lock() {
  local launch_root="$1"
  shift
  absolute_non_root "$launch_root" || return 1
  [[ -d "$launch_root" && ! -L "$launch_root" && "$(cd "$launch_root" && pwd -P)" == "$launch_root" ]] || {
    echo "bridge operation lock root must be physical and canonical" >&2
    return 1
  }
  (
    local lock_dir="$launch_root/.hepta-vnext-launchd-bridge-operation.lock"
    mkdir "$lock_dir" 2>/dev/null || {
      echo "another launchd bridge operation is active or its lock is orphaned" >&2
      exit 1
    }
    chmod 0700 "$lock_dir" || exit 1
    trap '[[ -z "${lock_dir:-}" ]] || rmdir "$lock_dir" 2>/dev/null || true' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    "$@"
  )
}

with_generation_coordination_lock() {
  local install_root="$1"
  shift
  absolute_non_root "$install_root" || return 1
  [[ -d "$install_root" && ! -L "$install_root" && "$(cd "$install_root" && pwd -P)" == "$install_root" ]] || {
    echo "generation coordination root must be physical and canonical" >&2
    return 1
  }
  (
    local lock_dir="$install_root/.generation-operation.lock"
    mkdir "$lock_dir" 2>/dev/null || {
      echo "another generation mutation is active or its lock is orphaned" >&2
      exit 1
    }
    chmod 0700 "$lock_dir" || exit 1
    trap '[[ -z "${lock_dir:-}" ]] || rmdir "$lock_dir" 2>/dev/null || true' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    "$@"
  )
}

ensure_vnext_log_directories() {
  local plan="$1" manifest install_root manifest_install_root directory relative
  manifest="$(jq -r '.manifest' "$plan")" || return 1
  install_root="$(jq -r '.vnext_install_root' "$plan")" || return 1
  manifest_install_root="$(jq -r '.runtime.install_root' "$manifest")" || return 1
  [[ "$install_root" == "$manifest_install_root" ]] || {
    echo "bridge plan and manifest disagree on the vNext install root" >&2
    return 1
  }
  absolute_non_root "$install_root" || return 1
  [[ -d "$install_root" && ! -L "$install_root" \
    && "$(cd "$install_root" && pwd -P)" == "$install_root" ]] || {
    echo "vNext install root must be a physical canonical directory" >&2
    return 1
  }
  for relative in logs logs/gateway logs/watchdog; do
    directory="$install_root/$relative"
    if [[ ! -e "$directory" && ! -L "$directory" ]]; then
      mkdir "$directory" || return 1
    fi
    [[ -d "$directory" && ! -L "$directory" \
      && "$(cd "$directory" && pwd -P)" == "$directory" ]] || {
      echo "vNext log directory must be physical and canonical: $directory" >&2
      return 1
    }
    chmod 0700 "$directory" || return 1
    [[ "$(stat -f '%Lp' "$directory")" == 700 \
      && "$(stat -f '%u' "$directory")" == "$(id -u)" ]] || {
      echo "vNext log directory must be private and operator-owned: $directory" >&2
      return 1
    }
  done
}

write_chain_cursor_cas() {
  local cursor="$1" expected_sha="$2" source="$3" parent staged source_sha
  absolute_non_root "$cursor" || return 1
  parent="$(dirname "$cursor")"
  [[ -d "$parent" && ! -L "$parent" && "$(cd "$parent" && pwd -P)" == "$parent" ]] || {
    echo "bridge chain cursor parent must be physical and canonical" >&2
    return 1
  }
  if [[ -n "$expected_sha" ]]; then
    [[ -f "$cursor" && ! -L "$cursor" && "$(sha256_file "$cursor")" == "$expected_sha" ]] || {
      echo "bridge chain cursor changed since review" >&2
      return 1
    }
  else
    [[ ! -e "$cursor" && ! -L "$cursor" ]] || {
      echo "bridge chain cursor already exists" >&2
      return 1
    }
  fi
  source_sha="$(sha256_file "$source")" || return 1
  staged="$(mktemp "$parent/.hepta-bridge-chain.XXXXXX")" || return 1
  cp "$source" "$staged" || { rm -f "$staged"; return 1; }
  chmod 0400 "$staged" || { rm -f "$staged"; return 1; }
  [[ "$(sha256_file "$staged")" == "$source_sha" ]] || {
    rm -f "$staged"
    echo "bridge chain cursor staging changed" >&2
    return 1
  }
  if [[ -n "$expected_sha" ]]; then
    mv -f "$staged" "$cursor" || { rm -f "$staged"; return 1; }
  else
    ln "$staged" "$cursor" || { rm -f "$staged"; return 1; }
    rm -f "$staged" || true
  fi
}

remove_chain_cursor_cas() {
  local cursor="$1" expected_sha="$2"
  [[ -f "$cursor" && ! -L "$cursor" && "$(sha256_file "$cursor")" == "$expected_sha" ]] || {
    echo "bridge chain cursor changed before removal" >&2
    return 1
  }
  rm "$cursor" || return 1
}

prepare_bundle_locked() {
  local manifest="$1" launch_root="$2" bundle="$3" snapshot_receipt="$4" canary_receipt="$5" soak_receipt="$6"
  local release install_root gateway_label watchdog_label gateway_relative watchdog_relative guard
  local legacy_gateway legacy_watchdog vnext_gateway vnext_watchdog legacy_program legacy_program_canonical legacy_program_mode legacy_install_root
  absolute_non_root "$launch_root" || return 1
  absolute_non_root "$bundle" || return 1
  [[ -d "$launch_root" && ! -L "$launch_root" && "$(cd "$launch_root" && pwd -P)" == "$launch_root" ]] || {
    echo "LaunchAgents root must be a physical canonical directory" >&2
    return 1
  }
  [[ ! -e "$bundle" && ! -L "$bundle" ]] || { echo "bridge bundle already exists: $bundle" >&2; return 1; }
  manifest="$(canonical_file "$manifest")" || return 1
  verify_release_manifest "$manifest" || return 1
  snapshot_receipt="$(canonical_file "$snapshot_receipt")" || return 1
  canary_receipt="$(canonical_file "$canary_receipt")" || return 1
  soak_receipt="$(canonical_file "$soak_receipt")" || return 1
  verify_evidence_receipts "$manifest" "$snapshot_receipt" "$canary_receipt" "$soak_receipt" || return 1
  verify_snapshot_source_fresh "$manifest" "$snapshot_receipt" || return 1
  release="$(dirname "$manifest")"
  guard="$release/scripts/hepta-cutover-guard"
  [[ -f "$guard" && -x "$guard" && ! -L "$guard" ]] || {
    echo "release cutover guard is missing or unsafe" >&2
    return 1
  }
  install_root="$(jq -r '.runtime.install_root' "$manifest")"
  absolute_non_root "$install_root" || return 1
  "$release/scripts/hepta-generation-pointer" verify \
    --install-root "$install_root" --manifest "$manifest" >/dev/null || return 1
  gateway_label="$(jq -r '.gateway_launch_agent.label' "$manifest")"
  watchdog_label="$(jq -r '.watchdog_launch_agent.label' "$manifest")"
  validate_label "$gateway_label" || return 1
  validate_label "$watchdog_label" || return 1
  gateway_relative="$(jq -r '.gateway_launch_agent.relative_path' "$manifest")"
  watchdog_relative="$(jq -r '.watchdog_launch_agent.relative_path' "$manifest")"
  [[ "$gateway_relative" == "launchd/$gateway_label.plist" \
    && "$watchdog_relative" == "launchd/$watchdog_label.plist" ]] || {
    echo "manifest LaunchAgent paths are not label-bound" >&2
    return 1
  }
  legacy_gateway="$(canonical_file "$launch_root/$gateway_label.plist")" || return 1
  legacy_watchdog="$(canonical_file "$launch_root/$watchdog_label.plist")" || return 1
  vnext_gateway="$(canonical_file "$release/$gateway_relative")" || return 1
  vnext_watchdog="$(canonical_file "$release/$watchdog_relative")" || return 1
  [[ "$(plutil -extract Label raw -o - "$legacy_gateway")" == "$gateway_label" \
    && "$(plutil -extract Label raw -o - "$legacy_watchdog")" == "$watchdog_label" \
    && "$(plutil -extract Label raw -o - "$vnext_gateway")" == "$gateway_label" \
    && "$(plutil -extract Label raw -o - "$vnext_watchdog")" == "$watchdog_label" ]] || {
    echo "LaunchAgent label differs from its bound role" >&2
    return 1
  }
  legacy_program="$(plutil -extract ProgramArguments.0 raw -o - "$legacy_gateway")"
  absolute_non_root "$legacy_program" || return 1
  legacy_program_canonical="$(realpath "$legacy_program")" || return 1
  [[ -f "$legacy_program_canonical" && ! -L "$legacy_program_canonical" ]] || return 1
  legacy_program_mode="$(stat -f '%Lp' "$legacy_program_canonical")"
  if [[ ! -x "$legacy_program_canonical" ]]; then
    [[ "$legacy_program_mode" == 400 \
      && "$(jq -r '.program' "$(jq -r '.writer_barrier.receipt' "$snapshot_receipt")")" == "$legacy_program_canonical" ]] || {
      echo "legacy gateway is neither executable nor the exact sealed writer" >&2
      return 1
    }
    "$guard" verify-writer --receipt "$(jq -r '.writer_barrier.receipt' "$snapshot_receipt")" >/dev/null || {
      echo "legacy gateway seal is not live during bridge preparation" >&2
      return 1
    }
  fi
  legacy_install_root="$(cd "$(dirname "$(dirname "$legacy_program")")" && pwd -P)"
  [[ "$(cd "$install_root" && pwd -P)" != "$legacy_install_root" ]] || {
    echo "vNext must use an install root separate from legacy" >&2
    return 1
  }
  [[ "$(sha256_file "$legacy_gateway")" != "$(sha256_file "$vnext_gateway")" \
    && "$(sha256_file "$legacy_watchdog")" != "$(sha256_file "$vnext_watchdog")" ]] || {
    echo "legacy and vNext LaunchAgent bytes must be distinct" >&2
    return 1
  }

  local parent stage plan chain_cursor operation_lock
  mkdir -p "$(dirname "$bundle")" || return 1
  chmod 0700 "$(dirname "$bundle")" || return 1
  parent="$(cd "$(dirname "$bundle")" && pwd -P)" || return 1
  [[ "$parent" == "$(dirname "$bundle")" ]] || {
    echo "bridge bundle parent must be a physical canonical directory" >&2
    return 1
  }
  stage="$(mktemp -d "$parent/.hepta-launchd-bridge.XXXXXX")" || return 1
  trap 'chmod -R u+w "${stage:-}" 2>/dev/null || true; rm -rf "${stage:-}"; trap - RETURN' RETURN
  mkdir -p "$stage/legacy" "$stage/vnext" "$stage/evidence" || return 1
  cp "$legacy_gateway" "$stage/legacy/gateway.plist" || return 1
  cp "$legacy_watchdog" "$stage/legacy/watchdog.plist" || return 1
  cp "$vnext_gateway" "$stage/vnext/gateway.plist" || return 1
  cp "$vnext_watchdog" "$stage/vnext/watchdog.plist" || return 1
  cp "$snapshot_receipt" "$stage/evidence/state-snapshot.json" || return 1
  cp "$canary_receipt" "$stage/evidence/canary.json" || return 1
  cp "$soak_receipt" "$stage/evidence/soak.json" || return 1
  chmod 0400 "$stage"/{legacy,vnext}/*.plist "$stage/evidence"/*.json || return 1
  plan="$stage/plan.json"
  chain_cursor="$launch_root/.hepta-vnext-launchd-bridge-chain.json"
  operation_lock="$launch_root/.hepta-vnext-launchd-bridge-operation.lock"
  jq -n \
    --arg manifest "$manifest" \
    --arg manifest_sha256 "$(sha256_file "$manifest")" \
    --arg launch_root "$launch_root" \
    --arg install_root "$install_root" \
    --arg chain_cursor "$chain_cursor" \
    --arg operation_lock "$operation_lock" \
    --arg legacy_program "$legacy_program" \
    --arg legacy_program_canonical "$legacy_program_canonical" \
    --arg legacy_program_sha "$(sha256_file "$legacy_program_canonical")" \
    --arg gateway_label "$gateway_label" \
    --arg watchdog_label "$watchdog_label" \
    --arg legacy_gateway_sha "$(sha256_file "$legacy_gateway")" \
    --arg legacy_watchdog_sha "$(sha256_file "$legacy_watchdog")" \
    --arg vnext_gateway_sha "$(sha256_file "$vnext_gateway")" \
    --arg vnext_watchdog_sha "$(sha256_file "$vnext_watchdog")" \
    --arg snapshot_sha "$(sha256_file "$snapshot_receipt")" \
    --arg canary_sha "$(sha256_file "$canary_receipt")" \
    --arg soak_sha "$(sha256_file "$soak_receipt")" \
    '{schema:"hepta_vnext_launchd_bridge_plan_v1",status:"ready",manifest:$manifest,manifest_sha256:$manifest_sha256,launch_agent_root:$launch_root,vnext_install_root:$install_root,chain_cursor:$chain_cursor,operation_lock:$operation_lock,bundle_closure:{profile:"bridge-bundle-v1",typed_inventory:"TYPED-INVENTORY.tsv",sha256sums:"SHA256SUMS",directories_mode:"0500",files_mode:"0400",regular_nlink_one:true,acls_rejected:true,xattrs_rejected:true,bsd_flags_rejected:true},separate_legacy_install_root:true,legacy_program:$legacy_program,legacy_program_canonical:$legacy_program_canonical,legacy_program_sha256:$legacy_program_sha,labels:{gateway:$gateway_label,watchdog:$watchdog_label},legacy:{gateway:{relative_path:"legacy/gateway.plist",sha256:$legacy_gateway_sha},watchdog:{relative_path:"legacy/watchdog.plist",sha256:$legacy_watchdog_sha},authority_not_reclassified:true},vnext:{gateway:{relative_path:"vnext/gateway.plist",sha256:$vnext_gateway_sha},watchdog:{relative_path:"vnext/watchdog.plist",sha256:$vnext_watchdog_sha},authority_all_closed:true},evidence:{snapshot:{relative_path:"evidence/state-snapshot.json",sha256:$snapshot_sha},canary:{relative_path:"evidence/canary.json",sha256:$canary_sha},soak:{relative_path:"evidence/soak.json",sha256:$soak_sha},all_required:true},transitions:["cutover","rollback","recutover"],service_changed:false}' >"$plan" || return 1
  chmod 0400 "$plan" || return 1
  bridge_set_closed_modes "$stage" || return 1
  bridge_clear_metadata "$stage"
  bridge_build_closure "$stage"
  "$guard" publish-directory --staged "$stage" --destination "$bundle" >/dev/null || return 1
  [[ ! -e "$stage" && -d "$bundle" ]] || return 1
  stage=""
  trap - RETURN
  verify_bundle "$bundle" >/dev/null || return 1
  jq -cn --arg bundle "$bundle" --arg plan_sha256 "$(sha256_file "$bundle/plan.json")" \
    '{schema:"hepta_vnext_launchd_bridge_prepare_v1",status:"ready",bundle:$bundle,plan_sha256:$plan_sha256,legacy_archived:true,service_changed:false}'
}

prepare_bundle() {
  local manifest="$1" launch_root="$2" install_root
  manifest="$(canonical_file "$manifest")" || return 1
  verify_release_manifest "$manifest" || return 1
  install_root="$(jq -r '.runtime.install_root' "$manifest")" || return 1
  with_bridge_operation_lock "$launch_root" with_generation_coordination_lock \
    "$install_root" prepare_bundle_locked "$@"
}

verify_bundle() {
  local bundle="$1" plan launch_root gateway_label watchdog_label manifest
  absolute_non_root "$bundle" || return 1
  [[ -d "$bundle" && ! -L "$bundle" && -f "$bundle/plan.json" && ! -L "$bundle/plan.json" ]] || {
    echo "bridge bundle is missing or unsafe" >&2
    return 1
  }
  [[ "$(cd "$bundle" && pwd -P)" == "$bundle" ]] || {
    echo "bridge bundle must be a physical canonical directory" >&2
    return 1
  }
  bridge_verify_closure "$bundle" || {
    echo "bridge bundle closed-world verification failed" >&2
    return 1
  }
  if find "$bundle" -type l -print -quit | grep -q .; then
    echo "bridge bundle contains a symlink" >&2
    return 1
  fi
  if find "$bundle" ! -type f ! -type d -print -quit | grep -q .; then
    echo "bridge bundle contains a special filesystem entry" >&2
    return 1
  fi
  plan="$bundle/plan.json"
  jq -e '
    (.schema == "hepta_vnext_launchd_bridge_plan_v1" or .schema == "hepta_vnext_launchd_bridge_plan_v2")
    and .status == "ready"
    and .separate_legacy_install_root == true
    and (.legacy_program_sha256 | test("^[0-9a-f]{64}$"))
    and .legacy.authority_not_reclassified == true
    and .vnext.authority_all_closed == true
    and .evidence.all_required == true
    and .bundle_closure == {profile:"bridge-bundle-v1",typed_inventory:"TYPED-INVENTORY.tsv",sha256sums:"SHA256SUMS",directories_mode:"0500",files_mode:"0400",regular_nlink_one:true,acls_rejected:true,xattrs_rejected:true,bsd_flags_rejected:true}
    and .evidence.snapshot.relative_path == "evidence/state-snapshot.json"
    and .evidence.canary.relative_path == "evidence/canary.json"
    and .evidence.soak.relative_path == "evidence/soak.json"
    and (.launch_agent_root | startswith("/"))
    and .chain_cursor == (.launch_agent_root + "/.hepta-vnext-launchd-bridge-chain.json")
    and .operation_lock == (.launch_agent_root + "/.hepta-vnext-launchd-bridge-operation.lock")
    and (if .schema == "hepta_vnext_launchd_bridge_plan_v2" then
      (.epoch | type == "number" and . >= 2 and . == floor)
      and (.parent_epoch | type == "number")
      and .parent_epoch >= 1 and (.parent_epoch == (.parent_epoch | floor)) and .parent_epoch == (.epoch - 1)
      and (.parent_plan_sha256 | test("^[0-9a-f]{64}$"))
      and (.predecessor_rollback.receipt | startswith("/"))
      and (.predecessor_rollback.sha256 | test("^[0-9a-f]{64}$"))
      and (.predecessor_rollback.plan_sha256 | test("^[0-9a-f]{64}$"))
      and (.predecessor_rollback.sequence | type == "number" and . >= 2 and . == floor)
      and (.parent_chain_head.plan_sha256 == .parent_plan_sha256)
      and (.parent_chain_head.sequence == .predecessor_rollback.sequence)
      and .parent_chain_head.current_generation == "legacy"
      and (.parent_chain_head.head_receipt == .predecessor_rollback.receipt)
      and (.parent_chain_head.head_receipt_sha256 == .predecessor_rollback.sha256)
      and (.supersedes_unapplied_epoch | type == "boolean")
      and (if .supersedes_unapplied_epoch then
        .predecessor_rollback.plan_sha256 != .parent_plan_sha256
      else .predecessor_rollback.plan_sha256 == .parent_plan_sha256 end)
      and .fresh_evidence_required == true
      and .fresh_evidence_predecessor == .predecessor_rollback
      and .chain_rebase_required == true
      and .transitions == ["recutover","rollback"]
    else true end)
  ' "$plan" >/dev/null || { echo "invalid bridge plan" >&2; return 1; }
  manifest="$(jq -r '.manifest' "$plan")"
  [[ "$(sha256_file "$manifest")" == "$(jq -r '.manifest_sha256' "$plan")" ]] || {
    echo "release manifest changed after bridge preparation" >&2
    return 1
  }
  verify_release_manifest "$manifest" || return 1
  local install_root
  install_root="$(jq -r '.runtime.install_root' "$manifest")" || return 1
  "$(dirname "$manifest")/scripts/hepta-generation-pointer" verify \
    --install-root "$install_root" --manifest "$manifest" >/dev/null || return 1
  verify_evidence_receipts "$manifest" \
    "$bundle/$(jq -r '.evidence.snapshot.relative_path' "$plan")" \
    "$bundle/$(jq -r '.evidence.canary.relative_path' "$plan")" \
    "$bundle/$(jq -r '.evidence.soak.relative_path' "$plan")" || return 1
  launch_root="$(jq -r '.launch_agent_root' "$plan")" || return 1
  absolute_non_root "$launch_root" || return 1
  gateway_label="$(jq -r '.labels.gateway' "$plan")" || return 1
  validate_label "$gateway_label" || return 1
  watchdog_label="$(jq -r '.labels.watchdog' "$plan")" || return 1
  validate_label "$watchdog_label" || return 1
  for generation in legacy vnext; do
    for role in gateway watchdog; do
      local relative expected
      relative="$(jq -r ".${generation}.${role}.relative_path" "$plan")"
      [[ "$relative" == "$generation/$role.plist" ]] || { echo "invalid bridge snapshot path" >&2; return 1; }
      expected="$(jq -r ".${generation}.${role}.sha256" "$plan")"
      [[ "$expected" =~ ^[0-9a-f]{64}$ && "$(sha256_file "$bundle/$relative")" == "$expected" ]] || {
        echo "bridge snapshot differs from plan: $generation/$role" >&2
        return 1
      }
    done
  done
  for evidence_name in snapshot canary soak; do
    local evidence_relative evidence_expected
    evidence_relative="$(jq -r ".evidence.${evidence_name}.relative_path" "$plan")"
    [[ "$evidence_relative" == evidence/*.json && "$evidence_relative" != */*/* ]] || {
      echo "invalid bridge evidence path: $evidence_name" >&2
      return 1
    }
    evidence_expected="$(jq -r ".evidence.${evidence_name}.sha256" "$plan")"
    [[ "$evidence_expected" =~ ^[0-9a-f]{64}$ \
      && "$(sha256_file "$bundle/$evidence_relative")" == "$evidence_expected" ]] || {
      echo "bridge evidence differs from plan: $evidence_name" >&2
      return 1
    }
  done
  jq -cn --arg bundle "$bundle" --arg plan_sha256 "$(sha256_file "$plan")" \
    '{schema:"hepta_vnext_launchd_bridge_verification_v1",status:"ready",bundle:$bundle,plan_sha256:$plan_sha256,legacy_authority_reclassified:false}'
}

verify_rollback_predecessor() {
  local receipt="$1" expected_plan_sha="$2" expected_cursor="$3"
  receipt="$(canonical_file "$receipt")" || return 1
  jq -e --arg plan_sha "$expected_plan_sha" --arg chain_cursor "$expected_cursor" \
    --arg legacy_health_path "$(generation_health_path legacy)" \
    --arg vnext_health_path "$(generation_health_path vnext)" '
    (.schema == "hepta_vnext_launchd_bridge_transition_v1" or .schema == "hepta_vnext_launchd_bridge_transition_v2")
    and .status == "ready"
    and .transition == "rollback"
    and .source_generation == "vnext" and .target_generation == "legacy"
    and .source_health_path == $vnext_health_path
    and .target_health_path == $legacy_health_path
    and (.sequence | type == "number" and . >= 2 and . == floor)
    and .plan_sha256 == $plan_sha
    and .chain_cursor == $chain_cursor
    and .chain_head_committed == true
    and .applied == true and .service_pair_reloaded == true
    and .post_transition_health_path == $legacy_health_path
    and .post_transition_health_verified == true
  ' "$receipt" >/dev/null || {
    echo "recutover predecessor is not a valid applied rollback" >&2
    return 1
  }
  printf '%s\n' "$(sha256_file "$receipt")"
}

verify_chain_head_any_plan() {
  local cursor="$1" expected_plan_sha="$2" expected_sequence="$3" expected_generation="$4"
  local expected_receipt="$5" expected_receipt_sha="$6"
  [[ -f "$cursor" && ! -L "$cursor" ]] || {
    echo "bridge chain cursor is missing" >&2
    return 1
  }
  jq -e --arg plan_sha "$expected_plan_sha" --arg generation "$expected_generation" \
    --arg receipt "$expected_receipt" --arg receipt_sha "$expected_receipt_sha" \
    --argjson sequence "$expected_sequence" '
    (.schema == "hepta_vnext_launchd_bridge_chain_v1" or .schema == "hepta_vnext_launchd_bridge_chain_v2")
    and .status == "ready"
    and .plan_sha256 == $plan_sha
    and .sequence == $sequence
    and .current_generation == $generation
    and .head_receipt == $receipt
    and .head_receipt_sha256 == $receipt_sha
    and (
      (.transition_receipt == $receipt and .transition_receipt_sha256 == $receipt_sha
        and .transition_receipt_finalized == true)
      or
      ((.rebase_receipt | type) == "string" and .rebase_receipt_finalized == true)
    )
  ' "$cursor" >/dev/null || {
    echo "rollback predecessor is not the current bridge chain head" >&2
    return 1
  }
}

verify_rebase_ready_cursor() {
  local cursor="$1" plan="$2" expected_sequence="$3" expected_receipt="$4" expected_receipt_sha="$5"
  local plan_sha epoch parent_epoch parent_plan_sha bundle chain_cursor rebase_receipt rebase_receipt_sha canonical_rebase
  plan_sha="$(sha256_file "$plan")" || return 1
  epoch="$(jq -r '.epoch' "$plan")" || return 1
  parent_epoch="$(jq -r '.parent_epoch' "$plan")" || return 1
  parent_plan_sha="$(jq -r '.parent_plan_sha256' "$plan")" || return 1
  bundle="$(cd "$(dirname "$plan")" && pwd -P)" || return 1
  chain_cursor="$(jq -r '.chain_cursor' "$plan")" || return 1
  [[ "$(canonical_file "$expected_receipt")" == "$expected_receipt" \
    && "$(sha256_file "$expected_receipt")" == "$expected_receipt_sha" ]] || {
    echo "rebase predecessor receipt differs from the reviewed chain head" >&2
    return 1
  }
  jq -e --arg plan_sha "$plan_sha" --arg parent_plan_sha "$parent_plan_sha" \
    --arg head_receipt "$expected_receipt" --arg head_receipt_sha "$expected_receipt_sha" \
    --argjson epoch "$epoch" --argjson parent_epoch "$parent_epoch" --argjson sequence "$expected_sequence" '
    .schema == "hepta_vnext_launchd_bridge_chain_v2"
    and .status == "ready" and .plan_sha256 == $plan_sha and .epoch == $epoch
    and .parent_epoch == $parent_epoch
    and .parent_plan_sha256 == $parent_plan_sha and .sequence == $sequence
    and .current_generation == "legacy" and .head_receipt == $head_receipt
    and .head_receipt_sha256 == $head_receipt_sha
    and (.rebase_receipt | startswith("/"))
    and (.rebase_receipt_sha256 | test("^[0-9a-f]{64}$"))
    and .rebase_pending_receipt == .rebase_receipt
    and (.rebase_pending_receipt_sha256 | test("^[0-9a-f]{64}$"))
    and (.rebase_pending_cursor_sha256 | test("^[0-9a-f]{64}$"))
    and (.rebase_prior_cursor_sha256 | test("^[0-9a-f]{64}$"))
    and .rebase_receipt_finalized == true
  ' "$cursor" >/dev/null || {
    echo "recutover chain cursor lacks finalized rebase provenance" >&2
    return 1
  }
  rebase_receipt="$(jq -r '.rebase_receipt' "$cursor")"
  canonical_rebase="$(canonical_file "$rebase_receipt")" || return 1
  [[ "$canonical_rebase" == "$rebase_receipt" ]] || return 1
  rebase_receipt_sha="$(sha256_file "$rebase_receipt")" || return 1
  [[ "$rebase_receipt_sha" == "$(jq -r '.rebase_receipt_sha256' "$cursor")" ]] || {
    echo "finalized rebase receipt differs from the chain cursor" >&2
    return 1
  }
  jq -e --arg bundle "$bundle" --arg plan_sha "$plan_sha" --arg parent_plan_sha "$parent_plan_sha" \
    --arg chain_cursor "$chain_cursor" --arg predecessor "$expected_receipt" \
    --arg predecessor_sha "$expected_receipt_sha" \
    --arg pending_receipt "$(jq -r '.rebase_pending_receipt' "$cursor")" \
    --arg pending_sha "$(jq -r '.rebase_pending_receipt_sha256' "$cursor")" \
    --arg pending_cursor_sha "$(jq -r '.rebase_pending_cursor_sha256' "$cursor")" \
    --arg prior_cursor_sha "$(jq -r '.rebase_prior_cursor_sha256' "$cursor")" \
    --argjson epoch "$epoch" --argjson parent_epoch "$parent_epoch" --argjson sequence "$expected_sequence" '
    .schema == "hepta_vnext_launchd_bridge_rebase_v2" and .status == "ready"
    and .bundle == $bundle and .plan_sha256 == $plan_sha and .epoch == $epoch
    and .parent_epoch == $parent_epoch
    and .parent_plan_sha256 == $parent_plan_sha and .chain_cursor == $chain_cursor
    and .predecessor_rollback_receipt == $predecessor
    and .predecessor_rollback_sha256 == $predecessor_sha
    and .predecessor_sequence == $sequence and .prior_cursor_sha256 == $prior_cursor_sha
    and .pending_receipt == $pending_receipt and .pending_receipt_sha256 == $pending_sha
    and .pending_cursor_sha256 == $pending_cursor_sha
    and .applied == true and .chain_rebase_committed == true
    and .service_pair_unchanged == true and .service_changed == false
  ' "$rebase_receipt" >/dev/null || {
    echo "finalized rebase receipt does not match cursor provenance" >&2
    return 1
  }
}

verify_current_rebase_head_provenance() {
  local cursor="$1" expected_parent_plan_sha="$2" expected_sequence="$3"
  local expected_receipt="$4" expected_receipt_sha="$5"
  local rebase_receipt rebase_receipt_sha parent_bundle canonical_parent_bundle parent_plan
  jq -e '
    .status == "ready"
    and (.rebase_receipt | type) == "string"
    and (.rebase_receipt_sha256 | test("^[0-9a-f]{64}$"))
    and .rebase_receipt_finalized == true
  ' "$cursor" >/dev/null || {
    echo "current chain head lacks finalized rebase provenance" >&2
    return 1
  }
  rebase_receipt="$(jq -r '.rebase_receipt' "$cursor")" || return 1
  rebase_receipt="$(canonical_file "$rebase_receipt")" || return 1
  rebase_receipt_sha="$(sha256_file "$rebase_receipt")" || return 1
  [[ "$rebase_receipt_sha" == "$(jq -r '.rebase_receipt_sha256' "$cursor")" ]] || {
    echo "current finalized rebase receipt changed after recutover preparation" >&2
    return 1
  }
  parent_bundle="$(jq -r '.bundle // empty' "$rebase_receipt")" || return 1
  absolute_non_root "$parent_bundle" || return 1
  [[ -d "$parent_bundle" && ! -L "$parent_bundle" ]] || {
    echo "current finalized rebase receipt names an unsafe parent bundle" >&2
    return 1
  }
  canonical_parent_bundle="$(cd "$parent_bundle" && pwd -P)" || return 1
  [[ "$canonical_parent_bundle" == "$parent_bundle" ]] || {
    echo "current finalized rebase receipt names a non-canonical parent bundle" >&2
    return 1
  }
  verify_bundle "$parent_bundle" >/dev/null || return 1
  parent_plan="$parent_bundle/plan.json"
  [[ "$(sha256_file "$parent_plan")" == "$expected_parent_plan_sha" ]] || {
    echo "current finalized rebase receipt belongs to a different parent plan" >&2
    return 1
  }
  verify_rebase_ready_cursor "$cursor" "$parent_plan" "$expected_sequence" \
    "$expected_receipt" "$expected_receipt_sha"
}

prepare_recutover_bundle_locked() {
  local manifest="$1" launch_root="$2" bundle="$3" snapshot_receipt="$4" canary_receipt="$5" soak_receipt="$6"
  local parent_bundle="$7" predecessor_receipt="$8" parent_plan parent_plan_sha parent_plan_schema parent_epoch epoch chain_cursor predecessor_sha predecessor_sequence predecessor_plan_sha supersedes=false
  local base_bundle plan_tmp guard
  verify_bundle "$parent_bundle" >/dev/null || return 1
  parent_bundle="$(cd "$parent_bundle" && pwd -P)"
  parent_plan="$parent_bundle/plan.json"
  parent_plan_sha="$(sha256_file "$parent_plan")"
  parent_plan_schema="$(jq -r '.schema' "$parent_plan")"
  parent_epoch="$(jq -r '.epoch // 1' "$parent_plan")"
  epoch="$((parent_epoch + 1))"
  chain_cursor="$(jq -r '.chain_cursor' "$parent_plan")"
  predecessor_receipt="$(canonical_file "$predecessor_receipt")" || return 1
  predecessor_plan_sha="$(jq -r '.plan_sha256 // empty' "$predecessor_receipt")"
  [[ "$predecessor_plan_sha" =~ ^[0-9a-f]{64}$ ]] || {
    echo "recutover predecessor does not declare an exact plan" >&2
    return 1
  }
  predecessor_sha="$(verify_rollback_predecessor "$predecessor_receipt" "$predecessor_plan_sha" "$chain_cursor")" || return 1
  predecessor_sequence="$(jq -r '.sequence' "$predecessor_receipt")"
  verify_chain_head_any_plan "$chain_cursor" "$parent_plan_sha" "$predecessor_sequence" legacy \
    "$predecessor_receipt" "$predecessor_sha" || return 1
  if [[ "$predecessor_plan_sha" != "$parent_plan_sha" ]]; then
    [[ "$parent_plan_schema" == hepta_vnext_launchd_bridge_plan_v2 \
      && "$(jq -r '.predecessor_rollback.receipt' "$parent_plan")" == "$predecessor_receipt" \
      && "$(jq -r '.predecessor_rollback.sha256' "$parent_plan")" == "$predecessor_sha" \
      && "$(jq -r '.predecessor_rollback.plan_sha256' "$parent_plan")" == "$predecessor_plan_sha" \
      && "$(jq -r '.predecessor_rollback.sequence' "$parent_plan")" == "$predecessor_sequence" ]] || {
      echo "only an unapplied recutover epoch may be superseded" >&2
      return 1
    }
    verify_rebase_ready_cursor "$chain_cursor" "$parent_plan" "$predecessor_sequence" \
      "$predecessor_receipt" "$predecessor_sha" || return 1
    supersedes=true
  fi
  [[ "$(jq -r '.schema' "$snapshot_receipt")" == hepta_vnext_state_snapshot_receipt_v3 \
    && "$(jq -r '.profile' "$snapshot_receipt")" == full-state-root-v3 \
    && "$(jq -r '.mode_profile' "$snapshot_receipt")" == hepta_vnext_state_mode_profile_v3 \
    && "$(jq -r '.acl_profile' "$snapshot_receipt")" == hepta_vnext_state_acl_profile_deny_only_v1 \
    && "$(jq -r '.schema' "$canary_receipt")" == hepta_vnext_runtime_canary_e2e_v3 ]] || {
    echo "recutover preparation requires fresh exact full-root v3 snapshot and canary evidence" >&2
    return 1
  }
  jq -e --arg receipt "$predecessor_receipt" --arg sha "$predecessor_sha" \
    --arg plan "$predecessor_plan_sha" --argjson sequence "$predecessor_sequence" '
    .recutover_predecessor == {receipt:$receipt,sha256:$sha,plan_sha256:$plan,sequence:$sequence}
  ' "$snapshot_receipt" >/dev/null || {
    echo "fresh recutover snapshot is not bound to the supplied rollback predecessor" >&2
    return 1
  }
  jq -e --arg snapshot_sha "$(sha256_file "$snapshot_receipt")" \
    --arg receipt "$predecessor_receipt" --arg sha "$predecessor_sha" \
    --arg plan "$predecessor_plan_sha" --argjson sequence "$predecessor_sequence" '
    .snapshot_receipt_sha256 == $snapshot_sha
    and .snapshot_recutover_predecessor == {receipt:$receipt,sha256:$sha,plan_sha256:$plan,sequence:$sequence}
  ' "$canary_receipt" >/dev/null || {
    echo "fresh recutover canary did not inherit the exact snapshot/predecessor binding" >&2
    return 1
  }
  base_bundle="$(dirname "$bundle")/.hepta-recutover-base.$$.${RANDOM}"
  guard="$(dirname "$manifest")/scripts/hepta-cutover-guard"
  [[ -f "$guard" && -x "$guard" && ! -L "$guard" ]] || return 1
  [[ ! -e "$base_bundle" && ! -L "$base_bundle" ]] || return 1
  trap 'chmod -R u+w "${base_bundle:-}" 2>/dev/null || true; rm -rf "${base_bundle:-}"; rm -f "${plan_tmp:-}"; trap - RETURN' RETURN
  prepare_bundle_locked "$manifest" "$launch_root" "$base_bundle" "$snapshot_receipt" "$canary_receipt" "$soak_receipt" >/dev/null
  chmod -R u+w "$base_bundle"
  plan_tmp="$(mktemp "${TMPDIR:-/tmp}/hepta-recutover-plan.XXXXXX")"
  jq --arg parent_plan_sha256 "$parent_plan_sha" --arg predecessor_receipt "$predecessor_receipt" \
    --arg predecessor_sha "$predecessor_sha" --arg predecessor_plan_sha "$predecessor_plan_sha" \
    --argjson supersedes "$supersedes" --argjson parent_epoch "$parent_epoch" \
    --argjson epoch "$epoch" --argjson predecessor_sequence "$predecessor_sequence" '
    .schema = "hepta_vnext_launchd_bridge_plan_v2"
    | .epoch = $epoch
    | .parent_epoch = $parent_epoch
    | .parent_plan_sha256 = $parent_plan_sha256
    | .predecessor_rollback = {receipt:$predecessor_receipt,sha256:$predecessor_sha,plan_sha256:$predecessor_plan_sha,sequence:$predecessor_sequence}
    | .fresh_evidence_predecessor = {receipt:$predecessor_receipt,sha256:$predecessor_sha,plan_sha256:$predecessor_plan_sha,sequence:$predecessor_sequence}
    | .parent_chain_head = {plan_sha256:$parent_plan_sha256,sequence:$predecessor_sequence,current_generation:"legacy",head_receipt:$predecessor_receipt,head_receipt_sha256:$predecessor_sha}
    | .supersedes_unapplied_epoch = $supersedes
    | .fresh_evidence_required = true
    | .chain_rebase_required = true
    | .transitions = ["recutover","rollback"]
  ' "$base_bundle/plan.json" >"$plan_tmp"
  cp "$plan_tmp" "$base_bundle/plan.json"
  chmod 0400 "$base_bundle/plan.json"
  bridge_set_closed_modes "$base_bundle"
  bridge_clear_metadata "$base_bundle"
  bridge_build_closure "$base_bundle"
  [[ ! -e "$bundle" && ! -L "$bundle" ]] || { echo "bridge bundle already exists: $bundle" >&2; return 1; }
  "$guard" publish-directory --staged "$base_bundle" --destination "$bundle" >/dev/null
  [[ ! -e "$base_bundle" && -d "$bundle" ]] || return 1
  base_bundle=""
  verify_bundle "$bundle" >/dev/null || return 1
  jq -cn --arg bundle "$bundle" --arg plan_sha256 "$(sha256_file "$bundle/plan.json")" \
    --arg parent_plan_sha256 "$parent_plan_sha" --arg predecessor_sha256 "$predecessor_sha" \
    --argjson epoch "$epoch" --argjson supersedes "$supersedes" \
    '{schema:"hepta_vnext_launchd_bridge_prepare_recutover_v2",status:"ready",bundle:$bundle,plan_sha256:$plan_sha256,epoch:$epoch,parent_plan_sha256:$parent_plan_sha256,predecessor_rollback_sha256:$predecessor_sha256,supersedes_unapplied_epoch:$supersedes,fresh_full_state_evidence:true,chain_rebase_required:true,service_changed:false}'
  trap - RETURN
  rm -f "$plan_tmp"
}

prepare_recutover_bundle() {
  local manifest="$1" launch_root="$2" install_root
  manifest="$(canonical_file "$manifest")" || return 1
  verify_release_manifest "$manifest" || return 1
  install_root="$(jq -r '.runtime.install_root' "$manifest")" || return 1
  with_bridge_operation_lock "$launch_root" with_generation_coordination_lock \
    "$install_root" prepare_recutover_bundle_locked "$@"
}

active_pair_matches_generation() {
  local plan="$1" generation="$2" launch_root gateway_label watchdog_label
  launch_root="$(jq -r '.launch_agent_root' "$plan")"
  gateway_label="$(jq -r '.labels.gateway' "$plan")"
  watchdog_label="$(jq -r '.labels.watchdog' "$plan")"
  [[ -f "$launch_root/$gateway_label.plist" && ! -L "$launch_root/$gateway_label.plist" \
    && -f "$launch_root/$watchdog_label.plist" && ! -L "$launch_root/$watchdog_label.plist" \
    && "$(sha256_file "$launch_root/$gateway_label.plist")" == "$(jq -r ".${generation}.gateway.sha256" "$plan")" \
    && "$(sha256_file "$launch_root/$watchdog_label.plist")" == "$(jq -r ".${generation}.watchdog.sha256" "$plan")" ]]
}

rebase_after_rollback_locked() {
  local bundle="$1" predecessor_receipt="$2" output_receipt="$3" apply="$4"
  local plan plan_sha epoch parent_plan_sha parent_epoch chain_cursor predecessor_sha predecessor_sequence
  local prior_cursor_sha prior_cursor_json prior_cursor_tmp pending_tmp final_tmp pending_cursor_tmp final_cursor_tmp finalized_cursor_tmp pending_sha pending_cursor_sha final_cursor_sha final_receipt_sha temp_root
  verify_bundle "$bundle" >/dev/null || return 1
  plan="$bundle/plan.json"
  [[ "$(jq -r '.schema' "$plan")" == hepta_vnext_launchd_bridge_plan_v2 ]] || {
    echo "chain rebase requires a recutover v2 plan" >&2
    return 1
  }
  plan_sha="$(sha256_file "$plan")"; epoch="$(jq -r '.epoch' "$plan")"
  parent_epoch="$(jq -r '.parent_epoch' "$plan")"; parent_plan_sha="$(jq -r '.parent_plan_sha256' "$plan")"
  chain_cursor="$(jq -r '.chain_cursor' "$plan")"
  predecessor_receipt="$(canonical_file "$predecessor_receipt")" || return 1
  predecessor_sha="$(verify_rollback_predecessor "$predecessor_receipt" \
    "$(jq -r '.predecessor_rollback.plan_sha256' "$plan")" "$chain_cursor")" || return 1
  predecessor_sequence="$(jq -r '.sequence' "$predecessor_receipt")"
  [[ "$predecessor_receipt" == "$(jq -r '.predecessor_rollback.receipt' "$plan")" \
    && "$predecessor_sha" == "$(jq -r '.predecessor_rollback.sha256' "$plan")" \
    && "$predecessor_sequence" == "$(jq -r '.predecessor_rollback.sequence' "$plan")" ]] || {
    echo "rebase predecessor differs from the reviewed rollback" >&2
    return 1
  }
  verify_chain_head_any_plan "$chain_cursor" "$(jq -r '.parent_chain_head.plan_sha256' "$plan")" "$predecessor_sequence" legacy \
    "$predecessor_receipt" "$predecessor_sha" || return 1
  if [[ "$(jq -r '.supersedes_unapplied_epoch' "$plan")" == true ]]; then
    verify_current_rebase_head_provenance "$chain_cursor" \
      "$(jq -r '.parent_chain_head.plan_sha256' "$plan")" "$predecessor_sequence" \
      "$predecessor_receipt" "$predecessor_sha" || return 1
  fi
  active_pair_matches_generation "$plan" legacy || {
    echo "rebase requires the reviewed legacy service pair to remain active" >&2
    return 1
  }
  if [[ "$apply" != true ]]; then
    jq -cn --arg bundle "$bundle" --arg plan_sha256 "$plan_sha" --arg parent_plan_sha256 "$parent_plan_sha" \
      --arg predecessor_sha256 "$predecessor_sha" --argjson epoch "$epoch" \
      '{schema:"hepta_vnext_launchd_bridge_rebase_plan_v2",status:"ready",bundle:$bundle,plan_sha256:$plan_sha256,epoch:$epoch,parent_plan_sha256:$parent_plan_sha256,predecessor_rollback_sha256:$predecessor_sha256,applied:false,service_changed:false}'
    return
  fi
  [[ -n "$output_receipt" ]] || usage
  absolute_non_root "$output_receipt" || return 1
  temp_root="${TMPDIR:-/tmp}"
  pending_tmp="$(mktemp "${temp_root%/}/hepta-bridge-rebase-pending.XXXXXX")"
  prior_cursor_tmp="$(mktemp "${temp_root%/}/hepta-bridge-rebase-prior-cursor.XXXXXX")"
  final_tmp="$(mktemp "${temp_root%/}/hepta-bridge-rebase-final.XXXXXX")"
  pending_cursor_tmp="$(mktemp "${temp_root%/}/hepta-bridge-rebase-cursor-pending.XXXXXX")"
  final_cursor_tmp="$(mktemp "${temp_root%/}/hepta-bridge-rebase-cursor-final.XXXXXX")"
  finalized_cursor_tmp="$(mktemp "${temp_root%/}/hepta-bridge-rebase-cursor-finalized.XXXXXX")"
  trap 'rm -f "${prior_cursor_tmp:-}" "${pending_tmp:-}" "${final_tmp:-}" "${pending_cursor_tmp:-}" "${final_cursor_tmp:-}" "${finalized_cursor_tmp:-}"; trap - RETURN' RETURN
  cp "$chain_cursor" "$prior_cursor_tmp" || return 1
  prior_cursor_sha="$(sha256_file "$prior_cursor_tmp")"
  [[ "$(sha256_file "$chain_cursor")" == "$prior_cursor_sha" ]] || {
    echo "rebase parent cursor changed while it was captured" >&2
    return 1
  }
  prior_cursor_json="$(jq -c . "$prior_cursor_tmp")" || return 1
  jq -n --arg bundle "$bundle" --arg plan_sha256 "$plan_sha" --arg parent_plan_sha256 "$parent_plan_sha" \
    --arg chain_cursor "$chain_cursor" --arg predecessor_receipt "$predecessor_receipt" \
    --arg pending_receipt "$output_receipt" \
    --arg predecessor_sha256 "$predecessor_sha" --arg prior_cursor_sha256 "$prior_cursor_sha" \
    --argjson prior_cursor "$prior_cursor_json" --argjson epoch "$epoch" --argjson parent_epoch "$parent_epoch" \
    --argjson predecessor_sequence "$predecessor_sequence" --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_launchd_bridge_rebase_pending_v2",status:"pending",bundle:$bundle,plan_sha256:$plan_sha256,epoch:$epoch,parent_epoch:$parent_epoch,parent_plan_sha256:$parent_plan_sha256,chain_cursor:$chain_cursor,pending_receipt:$pending_receipt,predecessor_rollback_receipt:$predecessor_receipt,predecessor_rollback_sha256:$predecessor_sha256,predecessor_sequence:$predecessor_sequence,prior_cursor_sha256:$prior_cursor_sha256,prior_cursor:$prior_cursor,created_at:$created_at,applied:false,service_changed:false}' >"$pending_tmp"
  reserve_private_receipt "$output_receipt" "$pending_tmp" || return 1
  output_receipt="$(canonical_file "$output_receipt")" || return 1
  pending_sha="$(sha256_file "$output_receipt")"
  if [[ -n "${HEPTA_BRIDGE_SELF_TEST_CAPTURE_REBASE_PENDING:-}" ]]; then
    [[ -n "${HEPTA_BRIDGE_SELF_TEST_ROOT:-}" \
      && "$HEPTA_BRIDGE_SELF_TEST_CAPTURE_REBASE_PENDING" == "$HEPTA_BRIDGE_SELF_TEST_ROOT/"* \
      && ! -e "$HEPTA_BRIDGE_SELF_TEST_CAPTURE_REBASE_PENDING" \
      && ! -L "$HEPTA_BRIDGE_SELF_TEST_CAPTURE_REBASE_PENDING" ]] || return 1
    cp "$output_receipt" "$HEPTA_BRIDGE_SELF_TEST_CAPTURE_REBASE_PENDING" || return 1
    chmod 0400 "$HEPTA_BRIDGE_SELF_TEST_CAPTURE_REBASE_PENDING" || return 1
  fi
  if [[ "${HEPTA_BRIDGE_SELF_TEST_FAIL_AFTER_REBASE_RECEIPT_RESERVED:-0}" == 1 ]]; then
    echo "injected failure after recutover rebase receipt reservation" >&2
    return 1
  fi
  jq -n --arg plan_sha256 "$plan_sha" --arg parent_plan_sha256 "$parent_plan_sha" \
    --arg pending_receipt "$output_receipt" --arg pending_receipt_sha256 "$pending_sha" \
    --arg predecessor_receipt "$predecessor_receipt" --arg predecessor_sha256 "$predecessor_sha" \
    --arg prior_cursor_sha256 "$prior_cursor_sha" --argjson epoch "$epoch" \
    --argjson predecessor_sequence "$predecessor_sequence" \
    '{schema:"hepta_vnext_launchd_bridge_chain_rebase_pending_v2",status:"pending",plan_sha256:$plan_sha256,epoch:$epoch,parent_plan_sha256:$parent_plan_sha256,predecessor_sequence:$predecessor_sequence,predecessor_rollback_receipt:$predecessor_receipt,predecessor_rollback_sha256:$predecessor_sha256,prior_cursor_sha256:$prior_cursor_sha256,pending_receipt:$pending_receipt,pending_receipt_sha256:$pending_receipt_sha256}' >"$pending_cursor_tmp"
  write_chain_cursor_cas "$chain_cursor" "$prior_cursor_sha" "$pending_cursor_tmp" || return 1
  pending_cursor_sha="$(sha256_file "$chain_cursor")"
  if [[ "${HEPTA_BRIDGE_SELF_TEST_FAIL_AFTER_REBASE_PENDING:-0}" == 1 ]]; then
    echo "injected failure after recutover rebase pending cursor" >&2
    return 1
  fi
  jq -n --arg bundle "$bundle" --arg plan_sha256 "$plan_sha" --arg parent_plan_sha256 "$parent_plan_sha" \
    --arg chain_cursor "$chain_cursor" --arg predecessor_receipt "$predecessor_receipt" \
    --arg predecessor_sha256 "$predecessor_sha" --arg prior_cursor_sha256 "$prior_cursor_sha" \
    --arg pending_receipt "$output_receipt" --arg pending_receipt_sha256 "$pending_sha" \
    --arg pending_cursor_sha256 "$pending_cursor_sha" \
    --argjson epoch "$epoch" --argjson parent_epoch "$parent_epoch" --argjson predecessor_sequence "$predecessor_sequence" \
    --arg rebased_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_launchd_bridge_rebase_v2",status:"ready",bundle:$bundle,plan_sha256:$plan_sha256,epoch:$epoch,parent_epoch:$parent_epoch,parent_plan_sha256:$parent_plan_sha256,chain_cursor:$chain_cursor,predecessor_rollback_receipt:$predecessor_receipt,predecessor_rollback_sha256:$predecessor_sha256,predecessor_sequence:$predecessor_sequence,prior_cursor_sha256:$prior_cursor_sha256,pending_receipt:$pending_receipt,pending_receipt_sha256:$pending_receipt_sha256,pending_cursor_sha256:$pending_cursor_sha256,rebased_at:$rebased_at,applied:true,chain_rebase_committed:true,service_pair_unchanged:true,service_changed:false}' >"$final_tmp"
  final_receipt_sha="$(sha256_file "$final_tmp")"
  jq -n --arg plan_sha256 "$plan_sha" --arg parent_plan_sha256 "$parent_plan_sha" \
    --arg head_receipt "$predecessor_receipt" --arg head_receipt_sha256 "$predecessor_sha" \
    --arg rebase_receipt "$output_receipt" --arg rebase_receipt_sha256 "$final_receipt_sha" \
    --arg rebase_pending_receipt "$output_receipt" --arg rebase_pending_receipt_sha256 "$pending_sha" \
    --arg rebase_pending_cursor_sha256 "$pending_cursor_sha" --arg rebase_prior_cursor_sha256 "$prior_cursor_sha" \
    --argjson epoch "$epoch" --argjson parent_epoch "$parent_epoch" --argjson sequence "$predecessor_sequence" \
    --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_launchd_bridge_chain_v2",status:"ready",plan_sha256:$plan_sha256,epoch:$epoch,parent_epoch:$parent_epoch,parent_plan_sha256:$parent_plan_sha256,sequence:$sequence,current_generation:"legacy",head_receipt:$head_receipt,head_receipt_sha256:$head_receipt_sha256,rebase_receipt:$rebase_receipt,rebase_receipt_sha256:$rebase_receipt_sha256,rebase_pending_receipt:$rebase_pending_receipt,rebase_pending_receipt_sha256:$rebase_pending_receipt_sha256,rebase_pending_cursor_sha256:$rebase_pending_cursor_sha256,rebase_prior_cursor_sha256:$rebase_prior_cursor_sha256,rebase_receipt_finalized:false,updated_at:$updated_at}' >"$final_cursor_tmp"
  jq '.rebase_receipt_finalized = true | .updated_at = $updated_at' \
    --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$final_cursor_tmp" >"$finalized_cursor_tmp"
  if ! write_chain_cursor_cas "$chain_cursor" "$pending_cursor_sha" "$final_cursor_tmp"; then
    write_chain_cursor_cas "$chain_cursor" "$pending_cursor_sha" "$prior_cursor_tmp" 2>/dev/null || true
    return 1
  fi
  final_cursor_sha="$(sha256_file "$chain_cursor")"
  if [[ "${HEPTA_BRIDGE_SELF_TEST_FAIL_REBASE_RECEIPT_REPLACE:-0}" == 1 ]] \
    || ! replace_reserved_receipt "$output_receipt" "$pending_sha" "$final_tmp"; then
    write_chain_cursor_cas "$chain_cursor" "$final_cursor_sha" "$prior_cursor_tmp" 2>/dev/null || true
    return 1
  fi
  if [[ "${HEPTA_BRIDGE_SELF_TEST_FAIL_AFTER_REBASE_RECEIPT_FINALIZED:-0}" == 1 ]]; then
    echo "injected failure after rebase receipt finalization" >&2
    return 1
  fi
  if ! write_chain_cursor_cas "$chain_cursor" "$final_cursor_sha" "$finalized_cursor_tmp"; then
    echo "rebase receipt finalized but chain cursor finalization remains pending" >&2
    return 1
  fi
  verify_rebase_ready_cursor "$chain_cursor" "$plan" "$predecessor_sequence" \
    "$predecessor_receipt" "$predecessor_sha" || return 1
  trap - RETURN
  rm -f "$prior_cursor_tmp" "$pending_tmp" "$final_tmp" "$pending_cursor_tmp" "$final_cursor_tmp" "$finalized_cursor_tmp"
  cat "$output_receipt"
}

rebase_after_rollback() {
  local bundle="$1" predecessor_receipt="$2" output_receipt="$3" apply="$4"
  if [[ "$apply" != true ]]; then
    rebase_after_rollback_locked "$@"
    return
  fi
  verify_bundle "$bundle" >/dev/null || return 1
  local launch_root install_root
  launch_root="$(jq -r '.launch_agent_root' "$bundle/plan.json")"
  install_root="$(jq -r '.vnext_install_root' "$bundle/plan.json")"
  with_bridge_operation_lock "$launch_root" with_generation_coordination_lock \
    "$install_root" rebase_after_rollback_locked "$bundle" "$predecessor_receipt" "$output_receipt" "$apply"
}

verify_previous_receipt() {
  local receipt="$1" expected_transition="$2" plan_sha="$3" expected_target="$4" plan="$5" chain_cursor="$6"
  receipt="$(canonical_file "$receipt")" || return 1
  jq -e --arg transitions "$expected_transition" --arg plan_sha "$plan_sha" \
    --arg expected_target "$expected_target" \
    --arg chain_cursor "$chain_cursor" \
    --arg gateway_sha "$(jq -r ".${expected_target}.gateway.sha256" "$plan")" \
    --arg watchdog_sha "$(jq -r ".${expected_target}.watchdog.sha256" "$plan")" \
    --arg legacy_health_path "$(generation_health_path legacy)" \
    --arg vnext_health_path "$(generation_health_path vnext)" '
    (.schema == "hepta_vnext_launchd_bridge_transition_v1" or .schema == "hepta_vnext_launchd_bridge_transition_v2")
    and .status == "ready"
    and (.transition as $actual | ($transitions | split("|") | index($actual)) != null)
    and (.sequence | type == "number" and . >= 1 and . == floor)
    and .target_generation == $expected_target
    and (if .transition == "rollback" then
      .source_generation == "vnext" and .target_generation == "legacy"
    else
      .source_generation == "legacy" and .target_generation == "vnext"
    end)
    and .source_health_path == (if .source_generation == "legacy" then $legacy_health_path else $vnext_health_path end)
    and .target_health_path == (if .target_generation == "legacy" then $legacy_health_path else $vnext_health_path end)
    and (if .sequence == 1 then .previous_receipt_sha256 == null else (.previous_receipt_sha256 | test("^[0-9a-f]{64}$")) end)
    and .installed.gateway_sha256 == $gateway_sha
    and .installed.watchdog_sha256 == $watchdog_sha
    and .applied == true
    and .service_pair_reloaded == true
    and .post_transition_health_path == .target_health_path
    and .post_transition_health_verified == true
    and .chain_cursor == $chain_cursor
    and .chain_head_committed == true
    and (.service_mode == "launchctl" or .service_mode == "test")
    and (if .service_mode == "launchctl" and .target_generation == "vnext" then .post_transition_bounded_soak_verified == true else true end)
    and .plan_sha256 == $plan_sha
  ' "$receipt" >/dev/null || { echo "previous bridge receipt is invalid" >&2; return 1; }
  printf '%s\n' "$(sha256_file "$receipt")"
}

verify_ready_chain_cursor() {
  local cursor="$1" plan_sha="$2" expected_sequence="$3" expected_generation="$4" expected_receipt="$5" expected_receipt_sha="$6" expected_epoch="${7:-}"
  [[ -f "$cursor" && ! -L "$cursor" ]] || {
    echo "bridge chain cursor is missing" >&2
    return 1
  }
  jq -e --arg plan_sha "$plan_sha" --arg generation "$expected_generation" --arg epoch "$expected_epoch" \
    --arg receipt "$expected_receipt" --arg receipt_sha "$expected_receipt_sha" \
    --argjson sequence "$expected_sequence" '
    (.schema == "hepta_vnext_launchd_bridge_chain_v1" or .schema == "hepta_vnext_launchd_bridge_chain_v2")
    and .status == "ready"
    and .plan_sha256 == $plan_sha
    and .sequence == $sequence
    and .current_generation == $generation
    and .head_receipt == $receipt
    and .head_receipt_sha256 == $receipt_sha
    and (if $epoch == "" then true else (.schema == "hepta_vnext_launchd_bridge_chain_v2" and (.epoch | tostring) == $epoch) end)
    and (
      (.transition_receipt == $receipt and .transition_receipt_sha256 == $receipt_sha
        and .transition_receipt_finalized == true)
      or
      ((.rebase_receipt | type) == "string" and .rebase_receipt_finalized == true)
    )
  ' "$cursor" >/dev/null || {
    echo "previous receipt is not the current bridge chain head" >&2
    return 1
  }
}

publish_plist_pair() {
  local plan="$1" bundle="$2" generation="$3" launch_root="$4" gateway_label="$5" watchdog_label="$6"
  local gateway_stage watchdog_stage gateway_source watchdog_source
  gateway_source="$bundle/$(jq -r ".${generation}.gateway.relative_path" "$plan")"
  watchdog_source="$bundle/$(jq -r ".${generation}.watchdog.relative_path" "$plan")"
  gateway_stage="$(mktemp "$launch_root/.$gateway_label.bridge.XXXXXX")" || return 1
  watchdog_stage="$(mktemp "$launch_root/.$watchdog_label.bridge.XXXXXX")" || { rm -f "$gateway_stage"; return 1; }
  cp "$gateway_source" "$gateway_stage" || { rm -f "$gateway_stage" "$watchdog_stage"; return 1; }
  cp "$watchdog_source" "$watchdog_stage" || { rm -f "$gateway_stage" "$watchdog_stage"; return 1; }
  chmod 0444 "$gateway_stage" "$watchdog_stage" || { rm -f "$gateway_stage" "$watchdog_stage"; return 1; }
  plutil -lint "$gateway_stage" >/dev/null || { rm -f "$gateway_stage" "$watchdog_stage"; return 1; }
  plutil -lint "$watchdog_stage" >/dev/null || { rm -f "$gateway_stage" "$watchdog_stage"; return 1; }
  [[ "$(sha256_file "$gateway_stage")" == "$(jq -r ".${generation}.gateway.sha256" "$plan")" \
    && "$(sha256_file "$watchdog_stage")" == "$(jq -r ".${generation}.watchdog.sha256" "$plan")" ]] || {
    echo "staged LaunchAgent pair differs from reviewed $generation generation" >&2
    rm -f "$gateway_stage" "$watchdog_stage"
    return 1
  }
  mv -f "$gateway_stage" "$launch_root/$gateway_label.plist" || { rm -f "$gateway_stage" "$watchdog_stage"; return 1; }
  gateway_stage=""
  if [[ "${HEPTA_BRIDGE_SELF_TEST_FAIL_AFTER_GATEWAY_PUBLISH:-0}" == 1 && "$generation" == vnext ]]; then
    echo "injected failure after gateway plist publish" >&2
    rm -f "$watchdog_stage"
    return 1
  fi
  if ! mv -f "$watchdog_stage" "$launch_root/$watchdog_label.plist"; then
    rm -f "$watchdog_stage"
    return 1
  fi
  watchdog_stage=""
  [[ "$(sha256_file "$launch_root/$gateway_label.plist")" == "$(jq -r ".${generation}.gateway.sha256" "$plan")" \
    && "$(sha256_file "$launch_root/$watchdog_label.plist")" == "$(jq -r ".${generation}.watchdog.sha256" "$plan")" ]]
}

reload_plist_pair() {
  local launch_root="$1" gateway_label="$2" watchdog_label="$3" service_mode="$4"
  [[ "$service_mode" == "launchctl" ]] || return 0
  local domain attempt loaded
  domain="gui/$(id -u)"
  /bin/launchctl bootout "$domain/$watchdog_label" >/dev/null 2>&1 || true
  /bin/launchctl bootout "$domain/$gateway_label" >/dev/null 2>&1 || true
  for attempt in {1..50}; do
    loaded=false
    /bin/launchctl print "$domain/$gateway_label" >/dev/null 2>&1 && loaded=true
    /bin/launchctl print "$domain/$watchdog_label" >/dev/null 2>&1 && loaded=true
    [[ "$loaded" == false ]] && break
    sleep 0.1
  done
  [[ "$loaded" == false ]] || {
    echo "launchd service pair did not finish bootout before bootstrap" >&2
    return 1
  }
  /bin/launchctl bootstrap "$domain" "$launch_root/$gateway_label.plist" \
    && /bin/launchctl bootstrap "$domain" "$launch_root/$watchdog_label.plist" \
    && /bin/launchctl kickstart -k "$domain/$gateway_label"
}

listener_matches_generation() {
  local plan="$1" generation="$2" port="$3" pids pid executable expected_sha
  pids="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | LC_ALL=C sort -u || true)"
  [[ -n "$pids" && "$(wc -l <<<"$pids" | tr -d ' ')" == 1 ]] || return 1
  pid="$pids"
  executable="$(lsof -a -p "$pid" -d txt -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
  [[ -f "$executable" ]] || return 1
  if [[ "$generation" == "vnext" ]]; then
    expected_sha="$(jq -r '.artifact.sha256' "$(jq -r '.manifest' "$plan")")"
  else
    expected_sha="$(jq -r '.legacy_program_sha256' "$plan")"
  fi
  [[ "$(sha256_file "$executable")" == "$expected_sha" ]]
}

generation_health_path() {
  case "$1" in
    legacy) printf '%s\n' '/health' ;;
    vnext) printf '%s\n' '/healthz' ;;
    *)
      echo "unsupported service generation for health verification: $1" >&2
      return 1
      ;;
  esac
}

probe_generation_health() {
  local generation="$1" port="$2" health_path curl_output http_code response
  [[ "$port" =~ ^[0-9]+$ && "$port" -ge 1 && "$port" -le 65535 ]] || {
    echo "invalid health probe port: $port" >&2
    return 1
  }
  health_path="$(generation_health_path "$generation")" || return 1
  curl_output="$(/usr/bin/curl --disable --noproxy '*' --proto '=http' --max-redirs 0 \
    --silent --show-error --connect-timeout 1 --max-time 2 \
    --write-out $'\n%{http_code}' "http://127.0.0.1:$port$health_path")" || return 1
  http_code="${curl_output##*$'\n'}"
  response="${curl_output%$'\n'*}"
  [[ "$http_code" == 200 ]] || return 1
  case "$generation" in
    legacy)
      jq -e '
        type == "object"
        and keys == ["product", "runtime", "status"]
        and .product == "Hepta"
        and .runtime == "hepta"
        and .status == "ready"
      ' <<<"$response" >/dev/null
      ;;
    vnext)
      jq -e '
        type == "object"
        and keys == ["product", "status"]
        and .product == "hepta"
        and .status == "ok"
      ' <<<"$response" >/dev/null
      ;;
    *) return 1 ;;
  esac
}

wait_for_service_pair() {
  local plan="$1" generation="$2" service_mode="$3"
  local health_path
  health_path="$(generation_health_path "$generation")" || return 1
  if [[ "$service_mode" == "test" ]]; then
    [[ -n "${HEPTA_BRIDGE_SELF_TEST_HEALTH_PORT:-}" \
      && -n "${HEPTA_BRIDGE_SELF_TEST_ROOT:-}" \
      && "${HEPTA_BRIDGE_SELF_TEST_HEALTH_MODE_FILE:-}" == "$HEPTA_BRIDGE_SELF_TEST_ROOT/"* \
      && "${HEPTA_BRIDGE_SELF_TEST_HEALTH_REQUEST_LOG:-}" == "$HEPTA_BRIDGE_SELF_TEST_ROOT/"* ]] || {
      echo "self-test health transport is incomplete or outside its private root" >&2
      return 1
    }
    local test_health_mode="$generation"
    if [[ "${HEPTA_BRIDGE_SELF_TEST_FAIL_HEALTH_GENERATION:-}" == "$generation" ]]; then
      test_health_mode="$generation-fail"
    fi
    printf '%s\n' "$test_health_mode" >"$HEPTA_BRIDGE_SELF_TEST_HEALTH_MODE_FILE"
    probe_generation_health "$generation" "$HEPTA_BRIDGE_SELF_TEST_HEALTH_PORT"
    return
  fi
  [[ "$service_mode" == "launchctl" ]] || {
    echo "unsupported bridge service mode: $service_mode" >&2
    return 1
  }
  local manifest release port gateway_label watchdog_label domain
  manifest="$(jq -r '.manifest' "$plan")"; release="$(dirname "$manifest")"
  port="$(jq -r '.runtime.listen_port' "$manifest")"
  gateway_label="$(jq -r '.labels.gateway' "$plan")"; watchdog_label="$(jq -r '.labels.watchdog' "$plan")"
  domain="gui/$(id -u)"
  for _ in $(seq 1 300); do
    if /bin/launchctl print "$domain/$gateway_label" >/dev/null 2>&1 \
      && /bin/launchctl print "$domain/$watchdog_label" >/dev/null 2>&1; then
      if [[ "$generation" == "vnext" ]]; then
        probe_generation_health "$generation" "$port" \
          && "$release/scripts/hepta-watchdog.sh" --manifest "$manifest" >/dev/null 2>&1 \
          && listener_matches_generation "$plan" "$generation" "$port" \
          && "$release/scripts/hepta-live-soak.sh" --manifest "$manifest" --samples 3 --interval-seconds 0.2 >/dev/null 2>&1 \
          && return 0
      elif probe_generation_health "$generation" "$port"; then
        listener_matches_generation "$plan" "$generation" "$port" && return 0
      fi
    fi
    sleep 0.1
  done
  echo "$generation service pair failed post-transition health verification" >&2
  return 1
}

replace_plist_pair() {
  local plan="$1" bundle="$2" source_generation="$3" target_generation="$4" service_mode="$5"
  local launch_root gateway_label watchdog_label role label target
  launch_root="$(jq -r '.launch_agent_root' "$plan")"
  gateway_label="$(jq -r '.labels.gateway' "$plan")"
  watchdog_label="$(jq -r '.labels.watchdog' "$plan")"
  for role in gateway watchdog; do
    label="$gateway_label"; [[ "$role" == "watchdog" ]] && label="$watchdog_label"
    target="$launch_root/$label.plist"
    [[ -f "$target" && ! -L "$target" ]] || { echo "active plist is missing: $target" >&2; return 1; }
    [[ "$(sha256_file "$target")" == "$(jq -r ".${source_generation}.${role}.sha256" "$plan")" ]] || {
      echo "active $role plist changed since bridge review" >&2
      return 1
    }
  done
  if [[ "$source_generation" == vnext ]]; then
    wait_for_service_pair "$plan" "$source_generation" "$service_mode" || {
      echo "active source service pair does not match the reviewed generation" >&2
      return 1
    }
  fi
  if [[ "$target_generation" == legacy ]]; then
    ensure_legacy_writer_restored "$plan" "$bundle" || {
      echo "legacy writer could not be restored from the bound barrier" >&2
      return 1
    }
  fi
  if ! publish_plist_pair "$plan" "$bundle" "$target_generation" "$launch_root" "$gateway_label" "$watchdog_label" \
    || ! reload_plist_pair "$launch_root" "$gateway_label" "$watchdog_label" "$service_mode" \
    || ! wait_for_service_pair "$plan" "$target_generation" "$service_mode"; then
    echo "transition failed; restoring the reviewed $source_generation service pair" >&2
    publish_plist_pair "$plan" "$bundle" "$source_generation" "$launch_root" "$gateway_label" "$watchdog_label" || {
      echo "failed to restore reviewed source plist pair" >&2
      return 1
    }
    reload_plist_pair "$launch_root" "$gateway_label" "$watchdog_label" "$service_mode" || {
      echo "failed to reload reviewed source service pair" >&2
      return 1
    }
    wait_for_service_pair "$plan" "$source_generation" "$service_mode" || {
      echo "reviewed source service pair did not recover" >&2
      return 1
    }
    return 1
  fi
}

transition_locked() {
  local command="$1" bundle="$2" previous_receipt="$3" output_receipt="$4" apply="$5" service_mode="$6"
  local source_generation target_generation expected_previous plan plan_sha previous_sha="" previous_path="" sequence
  local source_health_path target_health_path
  local plan_schema epoch="" parent_plan_sha="" previous_plan_sha
  local launch_root chain_cursor prior_cursor_sha="" prior_cursor_json="" chain_pending_sha chain_final_sha final_receipt_sha
  local receipt_tmp pending_tmp chain_pending_tmp chain_final_tmp chain_finalized_tmp pending_sha
  local writer_restore_receipt="" writer_restore_sha=""
  verify_bundle "$bundle" >/dev/null || return 1
  plan="$bundle/plan.json"; plan_sha="$(sha256_file "$plan")"
  plan_schema="$(jq -r '.schema' "$plan")"
  if [[ "$plan_schema" == hepta_vnext_launchd_bridge_plan_v2 ]]; then
    epoch="$(jq -r '.epoch' "$plan")"
    parent_plan_sha="$(jq -r '.parent_plan_sha256' "$plan")"
  fi
  launch_root="$(jq -r '.launch_agent_root' "$plan")"
  chain_cursor="$(jq -r '.chain_cursor' "$plan")"
  case "$command" in
    cutover)
      [[ "$plan_schema" == hepta_vnext_launchd_bridge_plan_v1 ]] || {
        echo "a recutover v2 plan cannot start a new cutover chain" >&2
        return 1
      }
      source_generation=legacy; target_generation=vnext; expected_previous="" ;;
    rollback) source_generation=vnext; target_generation=legacy; expected_previous='cutover|recutover' ;;
    recutover) source_generation=legacy; target_generation=vnext; expected_previous=rollback ;;
    *) usage ;;
  esac
  source_health_path="$(generation_health_path "$source_generation")" || return 1
  target_health_path="$(generation_health_path "$target_generation")" || return 1
  if [[ "$target_generation" == vnext ]]; then
    verify_snapshot_source_fresh "$(jq -r '.manifest' "$plan")" \
      "$bundle/$(jq -r '.evidence.snapshot.relative_path' "$plan")" || return 1
  fi
  if [[ -n "$expected_previous" ]]; then
    [[ -n "$previous_receipt" ]] || usage
    previous_path="$(canonical_file "$previous_receipt")" || return 1
    previous_plan_sha="$plan_sha"
    if [[ "$plan_schema" == hepta_vnext_launchd_bridge_plan_v2 && "$command" == recutover ]]; then
      [[ "$previous_path" == "$(jq -r '.predecessor_rollback.receipt' "$plan")" \
        && "$(sha256_file "$previous_path")" == "$(jq -r '.predecessor_rollback.sha256' "$plan")" ]] || {
        echo "recutover refused a rollback other than the reviewed cross-plan predecessor" >&2
        return 1
      }
      previous_plan_sha="$(jq -r '.predecessor_rollback.plan_sha256' "$plan")"
    fi
    previous_sha="$(verify_previous_receipt "$previous_path" "$expected_previous" "$previous_plan_sha" "$source_generation" "$plan" "$chain_cursor")" || return 1
    sequence="$(( $(jq -r '.sequence' "$previous_path") + 1 ))"
    verify_ready_chain_cursor "$chain_cursor" "$plan_sha" "$((sequence - 1))" \
      "$source_generation" "$previous_path" "$previous_sha" "$epoch" || return 1
    if [[ "$plan_schema" == hepta_vnext_launchd_bridge_plan_v2 && "$command" == recutover ]]; then
      verify_rebase_ready_cursor "$chain_cursor" "$plan" "$((sequence - 1))" \
        "$previous_path" "$previous_sha" || return 1
    fi
    prior_cursor_sha="$(sha256_file "$chain_cursor")"
    prior_cursor_json="$(jq -c . "$chain_cursor")" || return 1
  else
    [[ -z "$previous_receipt" ]] || usage
    sequence=1
    [[ ! -e "$chain_cursor" && ! -L "$chain_cursor" ]] || {
      echo "initial cutover refused because a bridge chain already exists" >&2
      return 1
    }
  fi
  if [[ "$apply" != "true" ]]; then
    jq -cn --arg transition "$command" --arg bundle "$bundle" --arg plan_sha256 "$plan_sha" --arg plan_schema "$plan_schema" \
      --arg epoch "$epoch" --arg parent_plan_sha256 "$parent_plan_sha" \
      --arg source "$source_generation" --arg target "$target_generation" \
      --arg source_health_path "$source_health_path" --arg target_health_path "$target_health_path" \
      '{schema:(if $plan_schema == "hepta_vnext_launchd_bridge_plan_v2" then "hepta_vnext_launchd_bridge_transition_plan_v2" else "hepta_vnext_launchd_bridge_transition_plan_v1" end),status:"ready",transition:$transition,bundle:$bundle,plan_sha256:$plan_sha256,epoch:(if $epoch=="" then null else ($epoch|tonumber) end),parent_plan_sha256:(if $parent_plan_sha256=="" then null else $parent_plan_sha256 end),source_generation:$source,target_generation:$target,source_health_path:$source_health_path,target_health_path:$target_health_path,applied:false,service_changed:false}'
    return
  fi
  [[ -n "$output_receipt" ]] || usage
  absolute_non_root "$output_receipt"
  if [[ "$target_generation" == vnext ]]; then
    ensure_vnext_log_directories "$plan" || return 1
  fi
  local temp_root
  temp_root="${TMPDIR:-/tmp}"
  pending_tmp="$(mktemp "${temp_root%/}/hepta-bridge-transition-pending.XXXXXX")"
  receipt_tmp="$(mktemp "${temp_root%/}/hepta-bridge-transition-final.XXXXXX")"
  chain_pending_tmp="$(mktemp "${temp_root%/}/hepta-bridge-chain-pending.XXXXXX")"
  chain_final_tmp="$(mktemp "${temp_root%/}/hepta-bridge-chain-final.XXXXXX")"
  chain_finalized_tmp="$(mktemp "${temp_root%/}/hepta-bridge-chain-finalized.XXXXXX")"
  trap 'rm -f "${pending_tmp:-}" "${receipt_tmp:-}" "${chain_pending_tmp:-}" "${chain_final_tmp:-}" "${chain_finalized_tmp:-}"; trap - RETURN' RETURN
  jq -n --arg transition "$command" --arg bundle "$bundle" --arg plan_sha256 "$plan_sha" --arg plan_schema "$plan_schema" \
    --arg epoch "$epoch" --arg parent_plan_sha256 "$parent_plan_sha" \
    --arg source "$source_generation" --arg target "$target_generation" \
    --arg source_health_path "$source_health_path" --arg target_health_path "$target_health_path" \
    --arg service_mode "$service_mode" \
    --arg pending_receipt "$output_receipt" --arg previous_receipt "$previous_path" --arg previous_receipt_sha256 "$previous_sha" \
    --arg prior_cursor_sha256 "$prior_cursor_sha" --arg prior_cursor_json "$prior_cursor_json" \
    --arg chain_cursor "$chain_cursor" --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson sequence "$sequence" \
    '{schema:(if $plan_schema == "hepta_vnext_launchd_bridge_plan_v2" then "hepta_vnext_launchd_bridge_transition_pending_v2" else "hepta_vnext_launchd_bridge_transition_pending_v1" end),status:"pending",epoch:(if $epoch=="" then null else ($epoch|tonumber) end),parent_plan_sha256:(if $parent_plan_sha256=="" then null else $parent_plan_sha256 end),sequence:$sequence,transition:$transition,bundle:$bundle,plan_sha256:$plan_sha256,source_generation:$source,target_generation:$target,source_health_path:$source_health_path,target_health_path:$target_health_path,service_mode:$service_mode,chain_cursor:$chain_cursor,pending_receipt:$pending_receipt,previous_receipt:(if $previous_receipt=="" then null else $previous_receipt end),previous_receipt_sha256:(if $previous_receipt_sha256=="" then null else $previous_receipt_sha256 end),prior_cursor_sha256:(if $prior_cursor_sha256=="" then null else $prior_cursor_sha256 end),prior_cursor:(if $prior_cursor_json=="" then null else ($prior_cursor_json|fromjson) end),created_at:$created_at,applied:false}' >"$pending_tmp"
  reserve_private_receipt "$output_receipt" "$pending_tmp" || return 1
  output_receipt="$(canonical_file "$output_receipt")" || return 1
  pending_sha="$(sha256_file "$output_receipt")"
  if [[ -n "${HEPTA_BRIDGE_SELF_TEST_CAPTURE_TRANSITION_PENDING:-}" ]]; then
    [[ -n "${HEPTA_BRIDGE_SELF_TEST_ROOT:-}" \
      && "$HEPTA_BRIDGE_SELF_TEST_CAPTURE_TRANSITION_PENDING" == "$HEPTA_BRIDGE_SELF_TEST_ROOT/"* \
      && ! -e "$HEPTA_BRIDGE_SELF_TEST_CAPTURE_TRANSITION_PENDING" \
      && ! -L "$HEPTA_BRIDGE_SELF_TEST_CAPTURE_TRANSITION_PENDING" ]] || return 1
    cp "$output_receipt" "$HEPTA_BRIDGE_SELF_TEST_CAPTURE_TRANSITION_PENDING" || return 1
    chmod 0400 "$HEPTA_BRIDGE_SELF_TEST_CAPTURE_TRANSITION_PENDING" || return 1
  fi
  jq -n --arg transition "$command" --arg plan_sha256 "$plan_sha" --arg plan_schema "$plan_schema" \
    --arg epoch "$epoch" --arg parent_plan_sha256 "$parent_plan_sha" --arg source "$source_generation" \
    --arg target "$target_generation" --arg pending_receipt "$output_receipt" \
    --arg pending_receipt_sha256 "$pending_sha" --arg previous_receipt "$previous_path" \
    --arg previous_receipt_sha256 "$previous_sha" --arg prior_cursor_sha256 "$prior_cursor_sha" \
    --argjson sequence "$sequence" \
    '{schema:(if $plan_schema == "hepta_vnext_launchd_bridge_plan_v2" then "hepta_vnext_launchd_bridge_chain_pending_v2" else "hepta_vnext_launchd_bridge_chain_pending_v1" end),status:"pending",epoch:(if $epoch=="" then null else ($epoch|tonumber) end),parent_plan_sha256:(if $parent_plan_sha256=="" then null else $parent_plan_sha256 end),plan_sha256:$plan_sha256,sequence:$sequence,transition:$transition,source_generation:$source,target_generation:$target,pending_receipt:$pending_receipt,pending_receipt_sha256:$pending_receipt_sha256,previous_receipt:(if $previous_receipt=="" then null else $previous_receipt end),previous_receipt_sha256:(if $previous_receipt_sha256=="" then null else $previous_receipt_sha256 end),prior_cursor_sha256:(if $prior_cursor_sha256=="" then null else $prior_cursor_sha256 end)}' >"$chain_pending_tmp"
  write_chain_cursor_cas "$chain_cursor" "$prior_cursor_sha" "$chain_pending_tmp" || return 1
  chain_pending_sha="$(sha256_file "$chain_cursor")"
  replace_plist_pair "$plan" "$bundle" "$source_generation" "$target_generation" "$service_mode" || return 1
  if [[ "$target_generation" == legacy ]]; then
    writer_restore_receipt="$(writer_restore_receipt_for_plan "$plan" "$bundle")" || return 1
    if [[ -n "$writer_restore_receipt" ]]; then
      writer_restore_sha="$(sha256_file "$writer_restore_receipt")" || return 1
    fi
  fi
  jq -n --arg transition "$command" --arg bundle "$bundle" --arg plan_sha256 "$plan_sha" --arg plan_schema "$plan_schema" \
    --arg epoch "$epoch" --arg parent_plan_sha256 "$parent_plan_sha" \
    --arg source "$source_generation" --arg target "$target_generation" \
    --arg source_health_path "$source_health_path" --arg target_health_path "$target_health_path" \
    --arg service_mode "$service_mode" \
    --arg chain_cursor "$chain_cursor" \
    --arg pending_receipt "$output_receipt" --arg pending_receipt_sha256 "$pending_sha" \
    --arg pending_cursor_sha256 "$chain_pending_sha" --arg prior_cursor_sha256 "$prior_cursor_sha" \
    --arg previous_receipt "$previous_path" --arg previous_receipt_sha256 "$previous_sha" \
    --arg gateway_sha256 "$(jq -r ".${target_generation}.gateway.sha256" "$plan")" \
    --arg watchdog_sha256 "$(jq -r ".${target_generation}.watchdog.sha256" "$plan")" \
    --arg writer_restore_receipt "$writer_restore_receipt" --arg writer_restore_sha256 "$writer_restore_sha" \
    --arg applied_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson sequence "$sequence" \
    '{schema:(if $plan_schema == "hepta_vnext_launchd_bridge_plan_v2" then "hepta_vnext_launchd_bridge_transition_v2" else "hepta_vnext_launchd_bridge_transition_v1" end),status:"ready",epoch:(if $epoch=="" then null else ($epoch|tonumber) end),parent_plan_sha256:(if $parent_plan_sha256=="" then null else $parent_plan_sha256 end),sequence:$sequence,transition:$transition,bundle:$bundle,plan_sha256:$plan_sha256,source_generation:$source,target_generation:$target,source_health_path:$source_health_path,target_health_path:$target_health_path,service_mode:$service_mode,chain_cursor:$chain_cursor,pending_receipt:$pending_receipt,pending_receipt_sha256:$pending_receipt_sha256,pending_cursor_sha256:$pending_cursor_sha256,prior_cursor_sha256:(if $prior_cursor_sha256=="" then null else $prior_cursor_sha256 end),chain_head_committed:true,previous_receipt:(if $previous_receipt=="" then null else $previous_receipt end),previous_receipt_sha256:(if $previous_receipt_sha256=="" then null else $previous_receipt_sha256 end),installed:{gateway_sha256:$gateway_sha256,watchdog_sha256:$watchdog_sha256},writer_barrier_restore:(if $writer_restore_receipt=="" then null else {receipt:$writer_restore_receipt,sha256:$writer_restore_sha256,writer_admission_closed:false} end),applied_at:$applied_at,applied:true,service_pair_reloaded:true,post_transition_health_path:$target_health_path,post_transition_health_verified:true,post_transition_bounded_soak_verified:($service_mode == "launchctl" and $target == "vnext"),legacy_authority_reclassified:false}' >"$receipt_tmp"
  final_receipt_sha="$(sha256_file "$receipt_tmp")"
  jq -n --arg plan_sha256 "$plan_sha" --arg plan_schema "$plan_schema" --arg epoch "$epoch" \
    --arg parent_plan_sha256 "$parent_plan_sha" --arg current_generation "$target_generation" \
    --arg head_receipt "$output_receipt" --arg head_receipt_sha256 "$final_receipt_sha" \
    --arg transition_receipt "$output_receipt" --arg transition_receipt_sha256 "$final_receipt_sha" \
    --arg transition_pending_receipt "$output_receipt" --arg transition_pending_receipt_sha256 "$pending_sha" \
    --arg transition_pending_cursor_sha256 "$chain_pending_sha" --arg transition_prior_cursor_sha256 "$prior_cursor_sha" \
    --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson sequence "$sequence" \
    '{schema:(if $plan_schema == "hepta_vnext_launchd_bridge_plan_v2" then "hepta_vnext_launchd_bridge_chain_v2" else "hepta_vnext_launchd_bridge_chain_v1" end),status:"ready",epoch:(if $epoch=="" then null else ($epoch|tonumber) end),parent_plan_sha256:(if $parent_plan_sha256=="" then null else $parent_plan_sha256 end),plan_sha256:$plan_sha256,sequence:$sequence,current_generation:$current_generation,head_receipt:$head_receipt,head_receipt_sha256:$head_receipt_sha256,transition_receipt:$transition_receipt,transition_receipt_sha256:$transition_receipt_sha256,transition_pending_receipt:$transition_pending_receipt,transition_pending_receipt_sha256:$transition_pending_receipt_sha256,transition_pending_cursor_sha256:$transition_pending_cursor_sha256,transition_prior_cursor_sha256:(if $transition_prior_cursor_sha256=="" then null else $transition_prior_cursor_sha256 end),transition_receipt_finalized:false,updated_at:$updated_at}' >"$chain_final_tmp"
  jq '.transition_receipt_finalized = true | .updated_at = $updated_at' \
    --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$chain_final_tmp" >"$chain_finalized_tmp"
  if ! write_chain_cursor_cas "$chain_cursor" "$chain_pending_sha" "$chain_final_tmp"; then
    echo "bridge chain finalization failed; restoring the source generation" >&2
    replace_plist_pair "$plan" "$bundle" "$target_generation" "$source_generation" "$service_mode" || {
      echo "source generation recovery failed after chain finalization failure" >&2
      return 1
    }
    return 1
  fi
  chain_final_sha="$(sha256_file "$chain_cursor")"
  if ! replace_reserved_receipt "$output_receipt" "$pending_sha" "$receipt_tmp"; then
    echo "transition receipt finalization failed; restoring the source generation" >&2
    replace_plist_pair "$plan" "$bundle" "$target_generation" "$source_generation" "$service_mode" || {
      echo "source generation recovery failed after receipt finalization failure" >&2
      return 1
    }
    return 1
  fi
  if [[ "${HEPTA_BRIDGE_SELF_TEST_FAIL_AFTER_TRANSITION_RECEIPT_FINALIZED:-0}" == 1 ]]; then
    echo "injected failure after transition receipt finalization" >&2
    return 1
  fi
  if ! write_chain_cursor_cas "$chain_cursor" "$chain_final_sha" "$chain_finalized_tmp"; then
    echo "transition receipt finalized but chain cursor finalization remains pending" >&2
    return 1
  fi
  recover_transition_final_receipt_locked "$bundle" "$output_receipt" true "$service_mode" >/dev/null || return 1
  trap - RETURN
  rm -f "$pending_tmp" "$receipt_tmp" "$chain_pending_tmp" "$chain_final_tmp" "$chain_finalized_tmp"
  cat "$output_receipt"
}

transition() {
  local command="$1" bundle="$2" previous_receipt="$3" output_receipt="$4" apply="$5" service_mode="$6"
  if [[ "$apply" != true ]]; then
    transition_locked "$@"
    return
  fi
  verify_bundle "$bundle" >/dev/null || return 1
  local launch_root install_root
  launch_root="$(jq -r '.launch_agent_root' "$bundle/plan.json")"
  install_root="$(jq -r '.vnext_install_root' "$bundle/plan.json")"
  with_bridge_operation_lock "$launch_root" with_generation_coordination_lock \
    "$install_root" transition_locked \
      "$command" "$bundle" "$previous_receipt" "$output_receipt" "$apply" "$service_mode"
}

recover_pending_locked() {
  local bundle="$1" pending_receipt="$2" apply="$3" service_mode="$4"
  local plan plan_sha source_generation target_generation pending_sha launch_root gateway_label watchdog_label role label current_sha source_sha target_sha receipt_tmp="" cursor_tmp="" prior_cursor_tmp="" temp_root
  local transition_name sequence previous_receipt previous_sha chain_cursor cursor_sha=""
  local plan_schema epoch="" parent_plan_sha="" exact_prior_cursor=false prior_cursor_sha=""
  verify_bundle "$bundle" >/dev/null || return 1
  plan="$bundle/plan.json"; plan_sha="$(sha256_file "$plan")"
  plan_schema="$(jq -r '.schema' "$plan")"
  if [[ "$plan_schema" == hepta_vnext_launchd_bridge_plan_v2 ]]; then
    epoch="$(jq -r '.epoch' "$plan")"
    parent_plan_sha="$(jq -r '.parent_plan_sha256' "$plan")"
  fi
  pending_receipt="$(canonical_file "$pending_receipt")"
  pending_sha="$(sha256_file "$pending_receipt")"
  chain_cursor="$(jq -r '.chain_cursor' "$plan")"
  jq -e --arg plan_sha "$plan_sha" --arg bundle "$bundle" --arg service_mode "$service_mode" \
    --arg chain_cursor "$chain_cursor" --arg pending_receipt "$pending_receipt" \
    --arg plan_schema "$plan_schema" --arg epoch "$epoch" --arg parent_plan_sha "$parent_plan_sha" \
    --arg legacy_health_path "$(generation_health_path legacy)" \
    --arg vnext_health_path "$(generation_health_path vnext)" '
    (.schema == "hepta_vnext_launchd_bridge_transition_pending_v1" or .schema == "hepta_vnext_launchd_bridge_transition_pending_v2")
    and .status == "pending"
    and .plan_sha256 == $plan_sha
    and .bundle == $bundle
    and .service_mode == $service_mode
    and .chain_cursor == $chain_cursor
    and .pending_receipt == $pending_receipt
    and .applied == false
    and (if $plan_schema == "hepta_vnext_launchd_bridge_plan_v2" then
      .schema == "hepta_vnext_launchd_bridge_transition_pending_v2"
      and (.epoch | tostring) == $epoch and .parent_plan_sha256 == $parent_plan_sha
    else .schema == "hepta_vnext_launchd_bridge_transition_pending_v1" end)
    and (.sequence | type == "number" and . >= 1 and . == floor)
    and (.source_generation == "legacy" or .source_generation == "vnext")
    and (.target_generation == "legacy" or .target_generation == "vnext")
    and .source_generation != .target_generation
    and .source_health_path == (if .source_generation == "legacy" then $legacy_health_path else $vnext_health_path end)
    and .target_health_path == (if .target_generation == "legacy" then $legacy_health_path else $vnext_health_path end)
    and (if .transition == "cutover" then
      .sequence == 1 and .source_generation == "legacy" and .target_generation == "vnext"
      and .previous_receipt == null and .previous_receipt_sha256 == null
    elif .transition == "rollback" then
      .sequence >= 2 and .source_generation == "vnext" and .target_generation == "legacy"
      and (.previous_receipt | startswith("/")) and (.previous_receipt_sha256 | test("^[0-9a-f]{64}$"))
    elif .transition == "recutover" then
      .sequence >= 3 and .source_generation == "legacy" and .target_generation == "vnext"
      and (.previous_receipt | startswith("/")) and (.previous_receipt_sha256 | test("^[0-9a-f]{64}$"))
    else false end)
  ' "$pending_receipt" >/dev/null || { echo "invalid pending bridge receipt" >&2; return 1; }
  source_generation="$(jq -r '.source_generation' "$pending_receipt")"
  target_generation="$(jq -r '.target_generation' "$pending_receipt")"
  transition_name="$(jq -r '.transition' "$pending_receipt")"
  sequence="$(jq -r '.sequence' "$pending_receipt")"
  previous_receipt="$(jq -r '.previous_receipt // ""' "$pending_receipt")"
  previous_sha="$(jq -r '.previous_receipt_sha256 // ""' "$pending_receipt")"
  launch_root="$(jq -r '.launch_agent_root' "$plan")"
  temp_root="${TMPDIR:-/tmp}"
  trap 'rm -f "${receipt_tmp:-}" "${cursor_tmp:-}" "${prior_cursor_tmp:-}"; trap - RETURN' RETURN
  if (( sequence > 1 )); then
    previous_receipt="$(canonical_file "$previous_receipt")" || return 1
    [[ "$(sha256_file "$previous_receipt")" == "$previous_sha" ]] || {
      echo "previous bridge receipt changed before chain recovery" >&2
      return 1
    }
  fi
  if (( sequence > 1 )); then
    prior_cursor_sha="$(jq -r '.prior_cursor_sha256 // ""' "$pending_receipt")"
    jq -e '
      (.prior_cursor_sha256 | test("^[0-9a-f]{64}$"))
      and (.prior_cursor | type == "object")
    ' "$pending_receipt" >/dev/null || {
      echo "pending bridge receipt lacks its exact prior cursor" >&2
      return 1
    }
    prior_cursor_tmp="$(mktemp "${temp_root%/}/hepta-bridge-chain-prior.XXXXXX")"
    jq '.prior_cursor' "$pending_receipt" >"$prior_cursor_tmp"
    [[ "$(sha256_file "$prior_cursor_tmp")" == "$prior_cursor_sha" ]] || {
      echo "pending bridge embedded prior cursor differs from its digest" >&2
      return 1
    }
    if [[ "$plan_schema" == hepta_vnext_launchd_bridge_plan_v2 && "$transition_name" == recutover ]]; then
      verify_rebase_ready_cursor "$prior_cursor_tmp" "$plan" "$((sequence - 1))" \
        "$previous_receipt" "$previous_sha" || return 1
    fi
    exact_prior_cursor=true
  fi
  if [[ -e "$chain_cursor" || -L "$chain_cursor" ]]; then
    [[ -f "$chain_cursor" && ! -L "$chain_cursor" ]] || { echo "unsafe bridge chain cursor" >&2; return 1; }
    cursor_sha="$(sha256_file "$chain_cursor")"
    jq -e --arg plan_sha "$plan_sha" --arg pending_receipt "$pending_receipt" \
      --arg pending_sha "$pending_sha" --arg transition "$transition_name" \
      --arg source "$source_generation" --arg target "$target_generation" \
      --arg previous_receipt "$previous_receipt" --arg previous_sha "$previous_sha" \
      --arg plan_schema "$plan_schema" --arg epoch "$epoch" --arg parent_plan_sha "$parent_plan_sha" \
      --arg cursor_sha "$cursor_sha" --arg prior_cursor_sha "$prior_cursor_sha" \
      --argjson sequence "$sequence" '
      (
        (.schema == "hepta_vnext_launchd_bridge_chain_pending_v1" or .schema == "hepta_vnext_launchd_bridge_chain_pending_v2")
        and .status == "pending"
        and .plan_sha256 == $plan_sha
        and .sequence == $sequence
        and .transition == $transition
        and .source_generation == $source
        and .target_generation == $target
        and .pending_receipt == $pending_receipt
        and .pending_receipt_sha256 == $pending_sha
        and ((.previous_receipt // "") == $previous_receipt)
        and ((.previous_receipt_sha256 // "") == $previous_sha)
        and (if $plan_schema == "hepta_vnext_launchd_bridge_plan_v2" then
          .schema == "hepta_vnext_launchd_bridge_chain_pending_v2"
          and (.epoch | tostring) == $epoch and .parent_plan_sha256 == $parent_plan_sha
        else .schema == "hepta_vnext_launchd_bridge_chain_pending_v1" end)
        and (if $sequence > 1 then .prior_cursor_sha256 == $prior_cursor_sha else true end)
      ) or (
        (.schema == "hepta_vnext_launchd_bridge_chain_v1" or .schema == "hepta_vnext_launchd_bridge_chain_v2")
        and .status == "ready"
        and .plan_sha256 == $plan_sha
        and (if $plan_schema == "hepta_vnext_launchd_bridge_plan_v2" then
          .schema == "hepta_vnext_launchd_bridge_chain_v2"
          and (.epoch | tostring) == $epoch and .parent_plan_sha256 == $parent_plan_sha
        else .schema == "hepta_vnext_launchd_bridge_chain_v1" end)
        and (
          (.sequence == $sequence and .current_generation == $target
            and .head_receipt == $pending_receipt and (.head_receipt_sha256 | test("^[0-9a-f]{64}$"))
            and .transition_receipt == $pending_receipt
            and (.transition_receipt_sha256 | test("^[0-9a-f]{64}$"))
            and .transition_pending_receipt == $pending_receipt
            and .transition_pending_receipt_sha256 == $pending_sha
            and (.transition_pending_cursor_sha256 | test("^[0-9a-f]{64}$"))
            and (if $sequence > 1 then .transition_prior_cursor_sha256 == $prior_cursor_sha
              else .transition_prior_cursor_sha256 == null end)
            and .transition_receipt_finalized == false)
          or
          ($sequence > 1 and .sequence == ($sequence - 1) and .current_generation == $source
            and .head_receipt == $previous_receipt and .head_receipt_sha256 == $previous_sha
            and $cursor_sha == $prior_cursor_sha)
        )
      )
    ' "$chain_cursor" >/dev/null || { echo "pending receipt is not the recoverable bridge chain operation" >&2; return 1; }
  else
    [[ "$sequence" == 1 && "$transition_name" == cutover ]] || {
      echo "pending bridge receipt has no matching chain cursor" >&2
      return 1
    }
  fi
  gateway_label="$(jq -r '.labels.gateway' "$plan")"; watchdog_label="$(jq -r '.labels.watchdog' "$plan")"
  for role in gateway watchdog; do
    label="$gateway_label"; [[ "$role" == watchdog ]] && label="$watchdog_label"
    [[ -f "$launch_root/$label.plist" && ! -L "$launch_root/$label.plist" ]] || {
      echo "pending recovery found a missing active plist" >&2
      return 1
    }
    current_sha="$(sha256_file "$launch_root/$label.plist")"
    source_sha="$(jq -r ".${source_generation}.${role}.sha256" "$plan")"
    target_sha="$(jq -r ".${target_generation}.${role}.sha256" "$plan")"
    [[ "$current_sha" == "$source_sha" || "$current_sha" == "$target_sha" ]] || {
      echo "pending recovery found unreviewed $role plist bytes" >&2
      return 1
    }
  done
  if [[ "$apply" != true ]]; then
    jq -cn --arg bundle "$bundle" --arg pending_receipt "$pending_receipt" --arg source "$source_generation" \
      '{schema:"hepta_vnext_launchd_bridge_pending_recovery_plan_v1",status:"ready",bundle:$bundle,pending_receipt:$pending_receipt,restore_generation:$source,applied:false,service_changed:false}'
    return
  fi
  [[ "$(sha256_file "$pending_receipt")" == "$pending_sha" ]] || {
    echo "pending bridge receipt changed before recovery" >&2
    return 1
  }
  if [[ "$source_generation" == vnext ]]; then
    ensure_vnext_log_directories "$plan" || return 1
  fi
  publish_plist_pair "$plan" "$bundle" "$source_generation" "$launch_root" "$gateway_label" "$watchdog_label" || return 1
  reload_plist_pair "$launch_root" "$gateway_label" "$watchdog_label" "$service_mode" || return 1
  wait_for_service_pair "$plan" "$source_generation" "$service_mode" || return 1
  if [[ "$sequence" == 1 ]]; then
    if [[ -n "$cursor_sha" ]]; then
      remove_chain_cursor_cas "$chain_cursor" "$cursor_sha" || return 1
    fi
  else
    if [[ "$exact_prior_cursor" == true ]]; then
      cursor_tmp="$prior_cursor_tmp"
    else
      cursor_tmp="$(mktemp "${temp_root%/}/hepta-bridge-chain-recovery.XXXXXX")"
      jq -n --arg plan_sha256 "$plan_sha" --arg plan_schema "$plan_schema" --arg epoch "$epoch" \
        --arg parent_plan_sha256 "$parent_plan_sha" --arg current_generation "$source_generation" \
        --arg head_receipt "$previous_receipt" --arg head_receipt_sha256 "$previous_sha" \
        --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson sequence "$((sequence - 1))" \
        '{schema:(if $plan_schema == "hepta_vnext_launchd_bridge_plan_v2" then "hepta_vnext_launchd_bridge_chain_v2" else "hepta_vnext_launchd_bridge_chain_v1" end),status:"ready",epoch:(if $epoch=="" then null else ($epoch|tonumber) end),parent_plan_sha256:(if $parent_plan_sha256=="" then null else $parent_plan_sha256 end),plan_sha256:$plan_sha256,sequence:$sequence,current_generation:$current_generation,head_receipt:$head_receipt,head_receipt_sha256:$head_receipt_sha256,updated_at:$updated_at}' >"$cursor_tmp"
    fi
    if [[ -n "$cursor_sha" ]] && [[ "$(sha256_file "$chain_cursor")" == "$(sha256_file "$cursor_tmp")" ]]; then
      :
    else
      write_chain_cursor_cas "$chain_cursor" "$cursor_sha" "$cursor_tmp" || { rm -f "$cursor_tmp"; return 1; }
    fi
    if [[ "$exact_prior_cursor" == true && "$plan_schema" == hepta_vnext_launchd_bridge_plan_v2 \
      && "$transition_name" == recutover ]]; then
      verify_rebase_ready_cursor "$chain_cursor" "$plan" "$((sequence - 1))" \
        "$previous_receipt" "$previous_sha" || return 1
    fi
    [[ "$cursor_tmp" == "$prior_cursor_tmp" ]] || rm -f "$cursor_tmp"
    cursor_tmp=""
  fi
  receipt_tmp="$(mktemp "${temp_root%/}/hepta-bridge-recovery.XXXXXX")"
  local restored_health_path
  restored_health_path="$(generation_health_path "$source_generation")" || return 1
  jq -n --arg bundle "$bundle" --arg plan_sha256 "$plan_sha" --arg plan_schema "$plan_schema" \
    --arg epoch "$epoch" --arg parent_plan_sha256 "$parent_plan_sha" --arg pending_sha256 "$pending_sha" \
    --arg restored_generation "$source_generation" --arg recovered_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg restored_health_path "$restored_health_path" \
    --argjson exact_prior_cursor_restored "$exact_prior_cursor" \
    '{schema:(if $plan_schema == "hepta_vnext_launchd_bridge_plan_v2" then "hepta_vnext_launchd_bridge_pending_recovery_v2" else "hepta_vnext_launchd_bridge_pending_recovery_v1" end),status:"ready",epoch:(if $epoch=="" then null else ($epoch|tonumber) end),parent_plan_sha256:(if $parent_plan_sha256=="" then null else $parent_plan_sha256 end),bundle:$bundle,plan_sha256:$plan_sha256,pending_receipt_sha256:$pending_sha256,restored_generation:$restored_generation,restored_health_path:$restored_health_path,restored_health_verified:true,recovered_at:$recovered_at,applied:true,source_service_pair_restored:true,chain_head_restored:true,exact_prior_cursor_restored:$exact_prior_cursor_restored,no_transition_pass_published:true}' >"$receipt_tmp"
  replace_reserved_receipt "$pending_receipt" "$pending_sha" "$receipt_tmp" || { rm -f "$receipt_tmp"; return 1; }
  trap - RETURN
  rm -f "${receipt_tmp:-}" "${cursor_tmp:-}" "${prior_cursor_tmp:-}"
  cat "$pending_receipt"
}

recover_transition_final_receipt_locked() {
  local bundle="$1" transition_receipt="$2" apply="$3" service_mode="$4"
  local plan plan_sha plan_schema epoch="" parent_plan_sha="" chain_cursor receipt_sha cursor_sha
  local sequence transition_name source_generation target_generation previous_receipt previous_sha finalized
  local cursor_tmp temp_root
  verify_bundle "$bundle" >/dev/null || return 1
  plan="$bundle/plan.json"; plan_sha="$(sha256_file "$plan")"
  plan_schema="$(jq -r '.schema' "$plan")"
  if [[ "$plan_schema" == hepta_vnext_launchd_bridge_plan_v2 ]]; then
    epoch="$(jq -r '.epoch' "$plan")"
    parent_plan_sha="$(jq -r '.parent_plan_sha256' "$plan")"
  fi
  transition_receipt="$(canonical_file "$transition_receipt")" || return 1
  receipt_sha="$(sha256_file "$transition_receipt")"
  chain_cursor="$(jq -r '.chain_cursor' "$plan")"
  jq -e --arg bundle "$bundle" --arg plan_sha "$plan_sha" --arg plan_schema "$plan_schema" \
    --arg epoch "$epoch" --arg parent_plan_sha "$parent_plan_sha" --arg service_mode "$service_mode" \
    --arg chain_cursor "$chain_cursor" --arg receipt "$transition_receipt" \
    --arg legacy_gateway "$(jq -r '.legacy.gateway.sha256' "$plan")" \
    --arg legacy_watchdog "$(jq -r '.legacy.watchdog.sha256' "$plan")" \
    --arg vnext_gateway "$(jq -r '.vnext.gateway.sha256' "$plan")" \
    --arg vnext_watchdog "$(jq -r '.vnext.watchdog.sha256' "$plan")" \
    --arg legacy_health_path "$(generation_health_path legacy)" \
    --arg vnext_health_path "$(generation_health_path vnext)" '
    (.schema == "hepta_vnext_launchd_bridge_transition_v1" or .schema == "hepta_vnext_launchd_bridge_transition_v2")
    and .status == "ready" and .bundle == $bundle and .plan_sha256 == $plan_sha
    and .service_mode == $service_mode and .chain_cursor == $chain_cursor
    and .pending_receipt == $receipt
    and (.pending_receipt_sha256 | test("^[0-9a-f]{64}$"))
    and (.pending_cursor_sha256 | test("^[0-9a-f]{64}$"))
    and (if .sequence == 1 then .prior_cursor_sha256 == null
      else (.prior_cursor_sha256 | test("^[0-9a-f]{64}$")) end)
    and (if $plan_schema == "hepta_vnext_launchd_bridge_plan_v2" then
      .schema == "hepta_vnext_launchd_bridge_transition_v2"
      and (.epoch | tostring) == $epoch and .parent_plan_sha256 == $parent_plan_sha
    else .schema == "hepta_vnext_launchd_bridge_transition_v1" end)
    and (.sequence | type == "number" and . >= 1 and . == floor)
    and (if .transition == "cutover" then
      .sequence == 1 and .source_generation == "legacy" and .target_generation == "vnext"
      and .previous_receipt == null and .previous_receipt_sha256 == null
    elif .transition == "rollback" then
      .sequence >= 2 and .source_generation == "vnext" and .target_generation == "legacy"
      and (.previous_receipt | startswith("/")) and (.previous_receipt_sha256 | test("^[0-9a-f]{64}$"))
    elif .transition == "recutover" then
      .sequence >= 3 and .source_generation == "legacy" and .target_generation == "vnext"
      and (.previous_receipt | startswith("/")) and (.previous_receipt_sha256 | test("^[0-9a-f]{64}$"))
    else false end)
    and .source_health_path == (if .source_generation == "legacy" then $legacy_health_path else $vnext_health_path end)
    and .target_health_path == (if .target_generation == "legacy" then $legacy_health_path else $vnext_health_path end)
    and .installed.gateway_sha256 == (if .target_generation == "legacy" then $legacy_gateway else $vnext_gateway end)
    and .installed.watchdog_sha256 == (if .target_generation == "legacy" then $legacy_watchdog else $vnext_watchdog end)
    and .chain_head_committed == true and .applied == true
    and .service_pair_reloaded == true
    and .post_transition_health_path == .target_health_path
    and .post_transition_health_verified == true
  ' "$transition_receipt" >/dev/null || {
    echo "invalid finalized transition receipt" >&2
    return 1
  }
  sequence="$(jq -r '.sequence' "$transition_receipt")"
  transition_name="$(jq -r '.transition' "$transition_receipt")"
  source_generation="$(jq -r '.source_generation' "$transition_receipt")"
  target_generation="$(jq -r '.target_generation' "$transition_receipt")"
  previous_receipt="$(jq -r '.previous_receipt // ""' "$transition_receipt")"
  previous_sha="$(jq -r '.previous_receipt_sha256 // ""' "$transition_receipt")"
  if (( sequence > 1 )); then
    previous_receipt="$(canonical_file "$previous_receipt")" || return 1
    [[ "$(sha256_file "$previous_receipt")" == "$previous_sha" ]] || {
      echo "finalized transition predecessor differs from its receipt" >&2
      return 1
    }
  fi
  [[ -f "$chain_cursor" && ! -L "$chain_cursor" ]] || {
    echo "finalized transition chain cursor is missing" >&2
    return 1
  }
  cursor_sha="$(sha256_file "$chain_cursor")"
  jq -e --arg plan_sha "$plan_sha" --arg plan_schema "$plan_schema" --arg epoch "$epoch" \
    --arg parent_plan_sha "$parent_plan_sha" --arg target "$target_generation" \
    --arg receipt "$transition_receipt" --arg receipt_sha "$receipt_sha" \
    --arg pending_sha "$(jq -r '.pending_receipt_sha256' "$transition_receipt")" \
    --arg pending_cursor_sha "$(jq -r '.pending_cursor_sha256' "$transition_receipt")" \
    --arg prior_cursor_sha "$(jq -r '.prior_cursor_sha256 // ""' "$transition_receipt")" \
    --argjson sequence "$sequence" '
    (.schema == "hepta_vnext_launchd_bridge_chain_v1" or .schema == "hepta_vnext_launchd_bridge_chain_v2")
    and .status == "ready" and .plan_sha256 == $plan_sha and .sequence == $sequence
    and .current_generation == $target and .head_receipt == $receipt and .head_receipt_sha256 == $receipt_sha
    and .transition_receipt == $receipt and .transition_receipt_sha256 == $receipt_sha
    and .transition_pending_receipt == $receipt and .transition_pending_receipt_sha256 == $pending_sha
    and .transition_pending_cursor_sha256 == $pending_cursor_sha
    and (if $sequence == 1 then .transition_prior_cursor_sha256 == null
      else .transition_prior_cursor_sha256 == $prior_cursor_sha end)
    and (.transition_receipt_finalized == false or .transition_receipt_finalized == true)
    and (if $plan_schema == "hepta_vnext_launchd_bridge_plan_v2" then
      .schema == "hepta_vnext_launchd_bridge_chain_v2"
      and (.epoch | tostring) == $epoch and .parent_plan_sha256 == $parent_plan_sha
    else .schema == "hepta_vnext_launchd_bridge_chain_v1" end)
  ' "$chain_cursor" >/dev/null || {
    echo "finalized transition receipt is not the cursor finalization operation" >&2
    return 1
  }
  active_pair_matches_generation "$plan" "$target_generation" || {
    echo "transition cursor finalization found a changed service pair" >&2
    return 1
  }
  finalized="$(jq -r '.transition_receipt_finalized' "$chain_cursor")"
  if [[ "$apply" != true ]]; then
    jq -cn --arg bundle "$bundle" --arg receipt "$transition_receipt" \
      --arg transition "$transition_name" --argjson already_finalized "$finalized" \
      '{schema:"hepta_vnext_launchd_bridge_transition_finalization_plan_v1",status:"ready",bundle:$bundle,transition:$transition,transition_receipt:$receipt,already_finalized:$already_finalized,service_changed:false,applied:false}'
    return
  fi
  if [[ "$finalized" == false ]]; then
    temp_root="${TMPDIR:-/tmp}"
    cursor_tmp="$(mktemp "${temp_root%/}/hepta-bridge-transition-finalize-cursor.XXXXXX")"
    trap 'rm -f "${cursor_tmp:-}"; trap - RETURN' RETURN
    jq '.transition_receipt_finalized = true | .updated_at = $updated_at' \
      --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$chain_cursor" >"$cursor_tmp"
    write_chain_cursor_cas "$chain_cursor" "$cursor_sha" "$cursor_tmp" || return 1
    trap - RETURN
    rm -f "$cursor_tmp"
  fi
  verify_ready_chain_cursor "$chain_cursor" "$plan_sha" "$sequence" \
    "$target_generation" "$transition_receipt" "$receipt_sha" "$epoch" || return 1
  cat "$transition_receipt"
}

recover_rebase_pending_locked() {
  local bundle="$1" pending_receipt="$2" apply="$3" service_mode="$4"
  local plan plan_sha chain_cursor pending_sha current_cursor_sha prior_cursor_tmp recovery_tmp temp_root
  local predecessor_receipt predecessor_sha predecessor_plan_sha
  verify_bundle "$bundle" >/dev/null || return 1
  plan="$bundle/plan.json"; plan_sha="$(sha256_file "$plan")"
  pending_receipt="$(canonical_file "$pending_receipt")" || return 1
  pending_sha="$(sha256_file "$pending_receipt")"
  chain_cursor="$(jq -r '.chain_cursor' "$plan")"
  jq -e --arg bundle "$bundle" --arg plan_sha "$plan_sha" --arg chain_cursor "$chain_cursor" \
    --arg pending_receipt "$pending_receipt" --arg parent_plan_sha "$(jq -r '.parent_plan_sha256' "$plan")" \
    --arg predecessor "$(jq -r '.predecessor_rollback.receipt' "$plan")" \
    --arg predecessor_sha "$(jq -r '.predecessor_rollback.sha256' "$plan")" \
    --argjson predecessor_sequence "$(jq -r '.predecessor_rollback.sequence' "$plan")" \
    --argjson epoch "$(jq -r '.epoch' "$plan")" --argjson parent_epoch "$(jq -r '.parent_epoch' "$plan")" '
    .schema == "hepta_vnext_launchd_bridge_rebase_pending_v2"
    and .status == "pending" and .bundle == $bundle and .plan_sha256 == $plan_sha
    and .chain_cursor == $chain_cursor and .pending_receipt == $pending_receipt
    and .applied == false and .service_changed == false
    and .epoch == $epoch and .parent_epoch == $parent_epoch
    and .parent_plan_sha256 == $parent_plan_sha
    and .predecessor_rollback_receipt == $predecessor
    and .predecessor_rollback_sha256 == $predecessor_sha
    and .predecessor_sequence == $predecessor_sequence
    and (.prior_cursor_sha256 | test("^[0-9a-f]{64}$"))
    and (.prior_cursor | type == "object")
  ' "$pending_receipt" >/dev/null || { echo "invalid pending chain rebase receipt" >&2; return 1; }
  predecessor_receipt="$(jq -r '.predecessor_rollback_receipt' "$pending_receipt")"
  [[ "$(canonical_file "$predecessor_receipt")" == "$predecessor_receipt" ]] || {
    echo "pending rebase predecessor path is not canonical" >&2
    return 1
  }
  predecessor_sha="$(jq -r '.predecessor_rollback_sha256' "$pending_receipt")"
  [[ "$(sha256_file "$predecessor_receipt")" == "$predecessor_sha" ]] || {
    echo "pending rebase predecessor receipt changed before recovery" >&2
    return 1
  }
  predecessor_plan_sha="$(jq -r '.predecessor_rollback.plan_sha256' "$plan")"
  [[ "$(verify_rollback_predecessor "$predecessor_receipt" "$predecessor_plan_sha" "$chain_cursor")" == "$predecessor_sha" ]] || return 1
  temp_root="${TMPDIR:-/tmp}"
  prior_cursor_tmp="$(mktemp "${temp_root%/}/hepta-bridge-rebase-recovery-cursor.XXXXXX")"
  trap 'rm -f "${prior_cursor_tmp:-}" "${recovery_tmp:-}"; trap - RETURN' RETURN
  jq '.prior_cursor' "$pending_receipt" >"$prior_cursor_tmp"
  [[ "$(sha256_file "$prior_cursor_tmp")" == "$(jq -r '.prior_cursor_sha256' "$pending_receipt")" ]] || {
    echo "pending rebase embedded parent cursor does not match its digest" >&2
    return 1
  }
  jq -e --arg parent_plan "$(jq -r '.parent_plan_sha256' "$pending_receipt")" \
    --arg predecessor "$(jq -r '.predecessor_rollback_receipt' "$pending_receipt")" \
    --arg predecessor_sha "$(jq -r '.predecessor_rollback_sha256' "$pending_receipt")" \
    --argjson sequence "$(jq -r '.predecessor_sequence' "$pending_receipt")" '
    (.schema == "hepta_vnext_launchd_bridge_chain_v1" or .schema == "hepta_vnext_launchd_bridge_chain_v2")
    and .status == "ready" and .plan_sha256 == $parent_plan and .sequence == $sequence
    and .current_generation == "legacy" and .head_receipt == $predecessor
    and .head_receipt_sha256 == $predecessor_sha
  ' < <(jq '.prior_cursor' "$pending_receipt") >/dev/null || {
    echo "pending rebase does not embed its exact parent chain head" >&2
    return 1
  }
  [[ -f "$chain_cursor" && ! -L "$chain_cursor" ]] || { echo "pending rebase chain cursor is missing" >&2; return 1; }
  current_cursor_sha="$(sha256_file "$chain_cursor")"
  jq -e --arg plan_sha "$plan_sha" --arg parent_plan "$(jq -r '.parent_plan_sha256' "$pending_receipt")" \
    --arg pending_receipt "$pending_receipt" --arg pending_sha "$pending_sha" \
    --arg current_cursor_sha "$current_cursor_sha" \
    --arg predecessor "$(jq -r '.predecessor_rollback_receipt' "$pending_receipt")" \
    --arg predecessor_sha "$(jq -r '.predecessor_rollback_sha256' "$pending_receipt")" \
    --arg prior_cursor_sha "$(jq -r '.prior_cursor_sha256' "$pending_receipt")" \
    --argjson epoch "$(jq -r '.epoch' "$pending_receipt")" --argjson sequence "$(jq -r '.predecessor_sequence' "$pending_receipt")" '
    (
      .schema == "hepta_vnext_launchd_bridge_chain_rebase_pending_v2"
      and .status == "pending" and .plan_sha256 == $plan_sha and .epoch == $epoch
      and .parent_plan_sha256 == $parent_plan and .predecessor_sequence == $sequence
      and .predecessor_rollback_receipt == $predecessor and .predecessor_rollback_sha256 == $predecessor_sha
      and .pending_receipt == $pending_receipt and .pending_receipt_sha256 == $pending_sha
      and .prior_cursor_sha256 == $prior_cursor_sha
    ) or (
      .schema == "hepta_vnext_launchd_bridge_chain_v2"
      and .status == "ready" and .plan_sha256 == $plan_sha and .epoch == $epoch
      and .parent_plan_sha256 == $parent_plan and .sequence == $sequence
      and .current_generation == "legacy" and .head_receipt == $predecessor
      and .head_receipt_sha256 == $predecessor_sha
      and .rebase_receipt == $pending_receipt
      and (.rebase_receipt_sha256 | test("^[0-9a-f]{64}$"))
      and .rebase_pending_receipt == $pending_receipt
      and .rebase_pending_receipt_sha256 == $pending_sha
      and (.rebase_pending_cursor_sha256 | test("^[0-9a-f]{64}$"))
      and .rebase_prior_cursor_sha256 == $prior_cursor_sha
      and .rebase_receipt_finalized == false
    ) or (
      (.schema == "hepta_vnext_launchd_bridge_chain_v1" or .schema == "hepta_vnext_launchd_bridge_chain_v2")
      and .status == "ready" and .plan_sha256 == $parent_plan and .sequence == $sequence
      and .current_generation == "legacy" and .head_receipt == $predecessor
      and .head_receipt_sha256 == $predecessor_sha
      and $current_cursor_sha == $prior_cursor_sha
    )
  ' "$chain_cursor" >/dev/null || { echo "pending rebase is not the recoverable chain operation" >&2; return 1; }
  active_pair_matches_generation "$plan" legacy || {
    echo "pending rebase recovery found a changed service pair" >&2
    return 1
  }
  if [[ "$apply" != true ]]; then
    jq -cn --arg bundle "$bundle" --arg pending_receipt "$pending_receipt" \
      '{schema:"hepta_vnext_launchd_bridge_rebase_recovery_plan_v2",status:"ready",bundle:$bundle,pending_receipt:$pending_receipt,restore_parent_chain:true,service_changed:false,applied:false}'
    return
  fi
  recovery_tmp="$(mktemp "${temp_root%/}/hepta-bridge-rebase-recovery.XXXXXX")"
  if [[ "$(sha256_file "$chain_cursor")" != "$(sha256_file "$prior_cursor_tmp")" ]]; then
    write_chain_cursor_cas "$chain_cursor" "$current_cursor_sha" "$prior_cursor_tmp" || return 1
  fi
  jq -n --arg bundle "$bundle" --arg plan_sha256 "$plan_sha" --arg pending_sha256 "$pending_sha" \
    --arg parent_plan_sha256 "$(jq -r '.parent_plan_sha256' "$pending_receipt")" \
    --arg predecessor_sha256 "$(jq -r '.predecessor_rollback_sha256' "$pending_receipt")" \
    --arg recovered_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_launchd_bridge_rebase_recovery_v2",status:"ready",bundle:$bundle,plan_sha256:$plan_sha256,parent_plan_sha256:$parent_plan_sha256,pending_receipt_sha256:$pending_sha256,predecessor_rollback_sha256:$predecessor_sha256,recovered_at:$recovered_at,applied:true,parent_chain_restored:true,service_pair_unchanged:true,no_rebase_pass_published:true,service_changed:false}' >"$recovery_tmp"
  replace_reserved_receipt "$pending_receipt" "$pending_sha" "$recovery_tmp" || return 1
  trap - RETURN
  rm -f "$prior_cursor_tmp" "$recovery_tmp"
  cat "$pending_receipt"
}

recover_rebase_final_receipt_locked() {
  local bundle="$1" rebase_receipt="$2" apply="$3" service_mode="$4"
  local plan plan_sha chain_cursor receipt_sha current_cursor_sha finalized cursor_tmp temp_root
  local predecessor_receipt predecessor_sha predecessor_sequence parent_epoch
  : "$service_mode"
  verify_bundle "$bundle" >/dev/null || return 1
  plan="$bundle/plan.json"; plan_sha="$(sha256_file "$plan")"
  rebase_receipt="$(canonical_file "$rebase_receipt")" || return 1
  receipt_sha="$(sha256_file "$rebase_receipt")"
  chain_cursor="$(jq -r '.chain_cursor' "$plan")"
  parent_epoch="$(jq -r '.parent_epoch' "$plan")"
  predecessor_receipt="$(jq -r '.predecessor_rollback.receipt' "$plan")"
  predecessor_receipt="$(canonical_file "$predecessor_receipt")" || return 1
  predecessor_sha="$(jq -r '.predecessor_rollback.sha256' "$plan")"
  predecessor_sequence="$(jq -r '.predecessor_rollback.sequence' "$plan")"
  [[ "$(sha256_file "$predecessor_receipt")" == "$predecessor_sha" ]] || {
    echo "finalized rebase predecessor differs from the reviewed rollback" >&2
    return 1
  }
  [[ "$(verify_rollback_predecessor "$predecessor_receipt" \
    "$(jq -r '.predecessor_rollback.plan_sha256' "$plan")" "$chain_cursor")" == "$predecessor_sha" ]] || {
    echo "finalized rebase predecessor lacks the reviewed rollback health contract" >&2
    return 1
  }
  jq -e --arg bundle "$bundle" --arg plan_sha "$plan_sha" --arg chain_cursor "$chain_cursor" \
    --arg receipt "$rebase_receipt" --arg predecessor "$predecessor_receipt" \
    --arg predecessor_sha "$predecessor_sha" --argjson predecessor_sequence "$predecessor_sequence" \
    --argjson epoch "$(jq -r '.epoch' "$plan")" --argjson parent_epoch "$parent_epoch" \
    --arg parent_plan_sha "$(jq -r '.parent_plan_sha256' "$plan")" '
    .schema == "hepta_vnext_launchd_bridge_rebase_v2" and .status == "ready"
    and .bundle == $bundle and .plan_sha256 == $plan_sha and .epoch == $epoch
    and .parent_epoch == $parent_epoch
    and .parent_plan_sha256 == $parent_plan_sha and .chain_cursor == $chain_cursor
    and .pending_receipt == $receipt
    and (.pending_receipt_sha256 | test("^[0-9a-f]{64}$"))
    and (.pending_cursor_sha256 | test("^[0-9a-f]{64}$"))
    and (.prior_cursor_sha256 | test("^[0-9a-f]{64}$"))
    and .predecessor_rollback_receipt == $predecessor
    and .predecessor_rollback_sha256 == $predecessor_sha
    and .predecessor_sequence == $predecessor_sequence
    and .applied == true and .chain_rebase_committed == true
    and .service_pair_unchanged == true and .service_changed == false
  ' "$rebase_receipt" >/dev/null || {
    echo "invalid finalized rebase receipt" >&2
    return 1
  }
  [[ -f "$chain_cursor" && ! -L "$chain_cursor" ]] || {
    echo "finalized rebase chain cursor is missing" >&2
    return 1
  }
  current_cursor_sha="$(sha256_file "$chain_cursor")"
  jq -e --arg plan_sha "$plan_sha" --arg parent_plan_sha "$(jq -r '.parent_plan_sha256' "$plan")" \
    --arg rebase_receipt "$rebase_receipt" --arg rebase_receipt_sha "$receipt_sha" \
    --arg pending_sha "$(jq -r '.pending_receipt_sha256' "$rebase_receipt")" \
    --arg pending_cursor_sha "$(jq -r '.pending_cursor_sha256' "$rebase_receipt")" \
    --arg prior_cursor_sha "$(jq -r '.prior_cursor_sha256' "$rebase_receipt")" \
    --arg predecessor "$(jq -r '.predecessor_rollback_receipt' "$rebase_receipt")" \
    --arg predecessor_sha "$(jq -r '.predecessor_rollback_sha256' "$rebase_receipt")" \
    --argjson epoch "$(jq -r '.epoch' "$plan")" --argjson parent_epoch "$parent_epoch" \
    --argjson sequence "$predecessor_sequence" '
    .schema == "hepta_vnext_launchd_bridge_chain_v2" and .status == "ready"
    and .plan_sha256 == $plan_sha and .parent_plan_sha256 == $parent_plan_sha
    and .epoch == $epoch and .parent_epoch == $parent_epoch
    and .sequence == $sequence and .current_generation == "legacy"
    and .head_receipt == $predecessor and .head_receipt_sha256 == $predecessor_sha
    and .rebase_receipt == $rebase_receipt and .rebase_receipt_sha256 == $rebase_receipt_sha
    and .rebase_pending_receipt == $rebase_receipt
    and .rebase_pending_receipt_sha256 == $pending_sha
    and .rebase_pending_cursor_sha256 == $pending_cursor_sha
    and .rebase_prior_cursor_sha256 == $prior_cursor_sha
    and (.rebase_receipt_finalized == false or .rebase_receipt_finalized == true)
  ' "$chain_cursor" >/dev/null || {
    echo "finalized rebase receipt is not the cursor finalization operation" >&2
    return 1
  }
  active_pair_matches_generation "$plan" legacy || {
    echo "rebase cursor finalization found a changed service pair" >&2
    return 1
  }
  finalized="$(jq -r '.rebase_receipt_finalized' "$chain_cursor")"
  if [[ "$apply" != true ]]; then
    jq -cn --arg bundle "$bundle" --arg receipt "$rebase_receipt" --argjson already_finalized "$finalized" \
      '{schema:"hepta_vnext_launchd_bridge_rebase_finalization_plan_v2",status:"ready",bundle:$bundle,rebase_receipt:$receipt,already_finalized:$already_finalized,service_changed:false,applied:false}'
    return
  fi
  if [[ "$finalized" == false ]]; then
    temp_root="${TMPDIR:-/tmp}"
    cursor_tmp="$(mktemp "${temp_root%/}/hepta-bridge-rebase-finalize-cursor.XXXXXX")"
    trap 'rm -f "${cursor_tmp:-}"; trap - RETURN' RETURN
    jq '.rebase_receipt_finalized = true | .updated_at = $updated_at' \
      --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$chain_cursor" >"$cursor_tmp"
    write_chain_cursor_cas "$chain_cursor" "$current_cursor_sha" "$cursor_tmp" || return 1
    trap - RETURN
    rm -f "$cursor_tmp"
  fi
  verify_rebase_ready_cursor "$chain_cursor" "$plan" "$predecessor_sequence" \
    "$predecessor_receipt" "$predecessor_sha" || return 1
  cat "$rebase_receipt"
}

recover_pending() {
  local bundle="$1" pending_receipt="$2" apply="$3" service_mode="$4"
  local pending_schema
  pending_schema="$(jq -r '.schema // empty' "$pending_receipt" 2>/dev/null || true)"
  if [[ "$apply" != true ]]; then
    if [[ "$pending_schema" == hepta_vnext_launchd_bridge_rebase_pending_v2 ]]; then
      recover_rebase_pending_locked "$@"
    elif [[ "$pending_schema" == hepta_vnext_launchd_bridge_rebase_v2 ]]; then
      recover_rebase_final_receipt_locked "$@"
    elif [[ "$pending_schema" == hepta_vnext_launchd_bridge_transition_v1 \
      || "$pending_schema" == hepta_vnext_launchd_bridge_transition_v2 ]]; then
      recover_transition_final_receipt_locked "$@"
    else
      recover_pending_locked "$@"
    fi
    return
  fi
  verify_bundle "$bundle" >/dev/null || return 1
  local launch_root install_root
  launch_root="$(jq -r '.launch_agent_root' "$bundle/plan.json")"
  install_root="$(jq -r '.vnext_install_root' "$bundle/plan.json")"
  if [[ "$pending_schema" == hepta_vnext_launchd_bridge_rebase_pending_v2 ]]; then
    with_bridge_operation_lock "$launch_root" with_generation_coordination_lock \
      "$install_root" recover_rebase_pending_locked \
        "$bundle" "$pending_receipt" "$apply" "$service_mode"
  elif [[ "$pending_schema" == hepta_vnext_launchd_bridge_rebase_v2 ]]; then
    with_bridge_operation_lock "$launch_root" with_generation_coordination_lock \
      "$install_root" recover_rebase_final_receipt_locked \
        "$bundle" "$pending_receipt" "$apply" "$service_mode"
  elif [[ "$pending_schema" == hepta_vnext_launchd_bridge_transition_v1 \
    || "$pending_schema" == hepta_vnext_launchd_bridge_transition_v2 ]]; then
    with_bridge_operation_lock "$launch_root" with_generation_coordination_lock \
      "$install_root" recover_transition_final_receipt_locked \
        "$bundle" "$pending_receipt" "$apply" "$service_mode"
  else
    with_bridge_operation_lock "$launch_root" with_generation_coordination_lock \
      "$install_root" recover_pending_locked \
        "$bundle" "$pending_receipt" "$apply" "$service_mode"
  fi
}

self_test_binary() {
  local destination="$1"
  local contract='{"authority":{"automatic_transition":false,"enforce":false,"model_invocation":false,"operator_mutation":false,"outbound":false,"promotion":false,"retirement":false,"telegram":false},"protocol_version":1,"routes":["GET /","GET /api/hepta/runtime","GET /healthz"],"runtime":{"keyed_integrity_required":true,"loopback_only":true,"open_mode":"immutable-query-only-open-existing","read_only":true,"requires_empty_wal":true,"schema_version":5},"schema":"hepta_vnext_live_shell_contract_v1","status":"ready"}'
  # The single-quoted literals are emitted into the fixture.
  # shellcheck disable=SC2016
  printf '%s\n' '#!/bin/sh' \
    'if [ "$#" -eq 1 ] && [ "$1" = "--hepta-vnext-live-shell-contract-v1" ]; then' \
    "  printf '%s\\n' '$contract'" \
    '  exit 0' \
    'fi' \
    'exit 0' >"$destination"
  chmod 0500 "$destination"
}

self_test_inventory_v1() {
  local tree_root="$1" output="$2"
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      if [[ -f "$item" ]]; then
        printf '%s|file|%s|%s\n' "$item" \
          "$(stat -f '%Lp|%u|%g|%z|%m|%c|%d|%i' "$item")" "$(sha256_file "$item")"
      elif [[ -d "$item" ]]; then
        printf '%s|directory|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m|%c|%d|%i' "$item")"
      else
        return 1
      fi
    done
  ) >"$output"
}

self_test_payload_v1() {
  local tree_root="$1" output="$2"
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      if [[ -f "$item" ]]; then
        printf '%s|file|%s|%s\n' "$item" \
          "$(stat -f '%Lp|%u|%g|%z|%m' "$item")" "$(sha256_file "$item")"
      elif [[ -d "$item" ]]; then
        printf '%s|directory|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m' "$item")"
      else
        return 1
      fi
    done
  ) >"$output"
}

self_test_create_v2_evidence() {
  local materializer="$1" fixture_binary="$2" legacy_state="$3" root="$4" suffix="$5"
  local predecessor_receipt="${6:-}"
  local release install_root state_copy snapshot_receipt soak_receipt canary_receipt
  local binary_sha manifest_sha snapshot_sha source_commit
  release="$root/release-$suffix"
  install_root="$root/install-$suffix"
  state_copy="$root/state-copy-$suffix"
  snapshot_receipt="$root/evidence/state-snapshot-$suffix.json"
  soak_receipt="$root/evidence/soak-$suffix.json"
  canary_receipt="$root/evidence/canary-$suffix.json"
  source_commit="$(git -C "$(dirname "$materializer")/.." rev-parse --verify 'HEAD^{commit}')"
  "$materializer" materialize --binary "$fixture_binary" --destination "$release" \
    --state-root "$state_copy" --install-root "$install_root" \
    --gateway-label ai.hepta.gateway --watchdog-label ai.hepta.installed-live-watchdog \
    --listen-port 17373 --source-commit "$source_commit" >/dev/null
  "$release/scripts/hepta-generation-pointer" initialize \
    --install-root "$install_root" --manifest "$release/manifest.json" >/dev/null
  if [[ -n "$predecessor_receipt" ]]; then
    "$release/scripts/hepta-state-snapshot" \
      --source-state-root "$legacy_state" --destination-state-root "$state_copy" \
      --legacy-label ai.hepta.bridge.selftest --receipt "$snapshot_receipt" \
      --predecessor-rollback-receipt "$predecessor_receipt" --materialize >/dev/null
  else
    "$release/scripts/hepta-state-snapshot" \
      --source-state-root "$legacy_state" --destination-state-root "$state_copy" \
      --legacy-label ai.hepta.bridge.selftest --receipt "$snapshot_receipt" --materialize >/dev/null
  fi
  binary_sha="$(jq -r '.artifact.sha256' "$release/manifest.json")"
  manifest_sha="$(sha256_file "$release/manifest.json")"
  snapshot_sha="$(sha256_file "$snapshot_receipt")"
  jq -n --arg binary_sha "$binary_sha" --arg manifest "$root/canary-release-$suffix/manifest.json" \
    --arg state_root "$root/private-copy-$suffix" \
    '{schema:"hepta_vnext_live_soak_v1",status:"ready",manifest:$manifest,manifest_sha256:"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",active_artifact_sha256:$binary_sha,live_url:"http://127.0.0.1:17373",state_root:$state_root,samples:3,passed:3,failed:0,schema_v5_open_existing:true,keyed_integrity_verified:true,immutable_query_only:true,authority_all_closed:true,service_changed:false}' >"$soak_receipt"
  jq -n --arg source_commit "$source_commit" --arg binary_sha "$binary_sha" \
    --arg manifest "$root/canary-release-$suffix/manifest.json" \
    --arg target_manifest "$release/manifest.json" --arg target_manifest_sha "$manifest_sha" \
    --arg snapshot_sha "$snapshot_sha" --arg state_root "$state_copy" \
    --arg snapshot_id "$(jq -r '.snapshot_id' "$snapshot_receipt")" \
    --arg snapshot_identity "$(jq -r '.source_identity_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_portable "$(jq -r '.portable_payload_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_modes "$(jq -r '.original_mode_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_acls "$(jq -r '.acl_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_top "$(jq -r '.top_level_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_sidecar "$(jq -r '.sqlite_sidecar_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_key "$(jq -r '.key_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_hardlinks "$(jq -r '.hardlink_topology_inventory_sha256' "$snapshot_receipt")" \
    --arg canary_state_root "$root/private-copy-$suffix" --arg soak_sha "$(sha256_file "$soak_receipt")" \
    --argjson predecessor "$(jq -c '.recutover_predecessor' "$snapshot_receipt")" \
    '{schema:"hepta_vnext_runtime_canary_e2e_v3",status:"ready",listen_addr:"127.0.0.1:17373",source_commit:$source_commit,source_tree_clean:true,binary_sha256:$binary_sha,manifest:$manifest,manifest_sha256:"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",canary_state_root:$canary_state_root,target_manifest:$target_manifest,target_manifest_sha256:$target_manifest_sha,snapshot_receipt_sha256:$snapshot_sha,snapshot_schema:"hepta_vnext_state_snapshot_receipt_v3",snapshot_profile:"full-state-root-v3",snapshot_mode_profile:"hepta_vnext_state_mode_profile_v3",snapshot_acl_profile:"hepta_vnext_state_acl_profile_deny_only_v1",snapshot_id:$snapshot_id,snapshot_source_identity_inventory_sha256:$snapshot_identity,snapshot_portable_payload_inventory_sha256:$snapshot_portable,snapshot_original_mode_inventory_sha256:$snapshot_modes,snapshot_acl_inventory_sha256:$snapshot_acls,snapshot_top_level_inventory_sha256:$snapshot_top,snapshot_sqlite_sidecar_inventory_sha256:$snapshot_sidecar,snapshot_key_inventory_sha256:$snapshot_key,snapshot_hardlink_topology_inventory_sha256:$snapshot_hardlinks,snapshot_recutover_predecessor:$predecessor,source_state_root:$state_root,source_inventory_sha256:"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",copy_payload_sha256:$snapshot_portable,copy_mode_inventory_sha256:$snapshot_modes,copy_acl_inventory_sha256:$snapshot_acls,soak_receipt_sha256:$soak_sha,soak_samples:3,production_inventory_sha256:"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",schema_v5_open_existing:true,keyed_integrity_verified:true,immutable_query_only:true,requires_empty_wal:true,source_state_copied:true,full_state_source_copied:true,full_snapshot_receipt_bound:true,all_top_level_entries_copied:true,original_modes_preserved:true,deny_only_acls_preserved:true,hardlinks_preserved:true,source_unchanged:true,copy_unchanged:true,metadata_and_hash_checked:true,installer_dry_run:true,protected_routes_absent:true,non_get_rejected:true,authority_all_closed:true,production_service_changed:false}' >"$canary_receipt"
  printf '%s\t%s\t%s\t%s\n' "$release" "$snapshot_receipt" "$canary_receipt" "$soak_receipt"
}

self_test() {
  local temp_root root materializer release install_root launch_root bundle fixture_binary
  local cutover_receipt rollback_receipt recutover_receipt second_rollback_receipt
  local snapshot_receipt canary_receipt soak_receipt legacy_state source_commit binary_sha fault_receipt occupied_receipt
  local manifest_sha snapshot_sha lock_receipt generation_lock_receipt replay_receipt stale_snapshot_receipt bad_canary bad_bundle
  local transition_pending_copy saved_transition_receipt transition_receipt_sha transition_cursor_sha
  local legacy_v1_snapshot legacy_v1_canary legacy_v1_bundle legacy_v1_source_inventory legacy_v1_payload_inventory
  local legacy_v2_snapshot legacy_v2_binding legacy_v2_canary legacy_v2_bundle
  local log_symlink_receipt log_child_symlink_receipt
  local release2 install_root2 fresh_snapshot_receipt fresh_canary_receipt fresh_soak_receipt fresh_snapshot_sha
  local recutover_bundle fork_bundle rebase_fault_receipt rebase_receipt v2_pending_receipt v2_recutover_receipt v2_rollback_receipt
  local wrong_predecessor_bundle fork_rebase_receipt stale_v2_receipt successful_pending_copy modified_pending_copy
  local saved_rebase_receipt completed_rebase_cursor_sha completed_rebase_receipt_sha recovered_rebase_cursor_sha
  local reserved_fault_receipt reserved_pending_copy reserved_cursor_sha tampered_pending_tmp reserved_recovery_receipt replace_fault_receipt
  local release3 snapshot3 canary3 soak3 bundle3 rebase3 recutover3 rollback3 stale_after_rebase
  local parent_rebase_saved supersede_cursor_saved supersede_cursor_sha downgraded_cursor_sha
  local deleted_parent_apply tampered_parent_apply downgraded_cursor_apply
  local release4 snapshot4 canary4 soak4 bundle4 rebase4 rebase4_cursor_sha release5 snapshot5 canary5 soak5 bundle5 rebase5 stale_after_recovery
  local health_mode_file health_request_log health_port_file health_port expected_health_requests
  local health_failure_cutover health_failure_rollback
  local v2_pending_saved v2_pending_tampered v2_pending_original_sha v2_pending_cursor_sha
  local v2_pending_gateway_sha v2_pending_watchdog_sha tamper_mode tampered_receipt
  local v2_final_missing_health v2_final_swapped_health v2_final_original_sha v2_final_cursor_sha
  local v2_final_gateway_sha v2_final_watchdog_sha
  local source_repository tooling_repository relative
  local closure_tamper_bundle external_hardlink_source
  local old_timestamp_snapshot old_timestamp_canary old_timestamp_bundle
  local predecessor_field predecessor_tamper_receipt predecessor_tamper_snapshot predecessor_tamper_canary predecessor_tamper_bundle
  temp_root="${TMPDIR:-/tmp}"
  root="$(mktemp -d "${temp_root%/}/hepta-launchd-bridge-self-test.XXXXXX")"
  HEPTA_BRIDGE_SELF_TEST_ROOT="$root"
  export HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT="$root"
  HEPTA_BRIDGE_SELF_TEST_HEALTH_SERVER_PID=""
  trap 'if [[ -n "${HEPTA_BRIDGE_SELF_TEST_HEALTH_SERVER_PID:-}" ]]; then kill "$HEPTA_BRIDGE_SELF_TEST_HEALTH_SERVER_PID" 2>/dev/null || true; wait "$HEPTA_BRIDGE_SELF_TEST_HEALTH_SERVER_PID" 2>/dev/null || true; fi; chflags -R nouchg,noschg "$HEPTA_BRIDGE_SELF_TEST_ROOT" 2>/dev/null || true; chmod -RN "$HEPTA_BRIDGE_SELF_TEST_ROOT" 2>/dev/null || true; chmod -R u+w "$HEPTA_BRIDGE_SELF_TEST_ROOT" 2>/dev/null || true; rm -rf "$HEPTA_BRIDGE_SELF_TEST_ROOT"' EXIT
  health_mode_file="$root/health-mode.txt"
  health_request_log="$root/health-requests.tsv"
  health_port_file="$root/health-port.txt"
  : >"$health_request_log"
  printf '%s\n' legacy >"$health_mode_file"
  chmod 0600 "$health_mode_file" "$health_request_log"
  python3 -u - "$health_mode_file" "$health_request_log" "$health_port_file" <<'PY_HEALTH_SERVER' &
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import sys

mode_path = Path(sys.argv[1])
request_log = Path(sys.argv[2])
port_path = Path(sys.argv[3])

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        mode = mode_path.read_text(encoding="utf-8").strip()
        generation = mode.removesuffix("-fail")
        expected = "/health" if generation == "legacy" else "/healthz"
        with request_log.open("a", encoding="utf-8") as stream:
            stream.write(f"{mode}\t{self.path}\n")
        if generation not in {"legacy", "vnext"} or self.path != expected:
            code, payload = 404, {"error": "runtime_ingress.route_not_found"}
        elif mode.endswith("-fail"):
            code, payload = 503, {"error": "injected_health_failure"}
        elif generation == "legacy":
            code, payload = 200, {"product": "Hepta", "runtime": "hepta", "status": "ready"}
        else:
            code, payload = 200, {"product": "hepta", "status": "ok"}
        encoded = json.dumps(payload, separators=(",", ":")).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(encoded)))
        self.end_headers()
        self.wfile.write(encoded)

    def log_message(self, _format, *_args):
        return

server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
port_path.write_text(f"{server.server_address[1]}\n", encoding="utf-8")
os.chmod(port_path, 0o600)
server.serve_forever()
PY_HEALTH_SERVER
  HEPTA_BRIDGE_SELF_TEST_HEALTH_SERVER_PID=$!
  for _ in $(seq 1 100); do
    [[ -s "$health_port_file" ]] && break
    kill -0 "$HEPTA_BRIDGE_SELF_TEST_HEALTH_SERVER_PID" 2>/dev/null || {
      echo "self-test loopback health server exited before publishing its port" >&2
      exit 1
    }
    sleep 0.02
  done
  [[ -s "$health_port_file" ]] || { echo "self-test loopback health server did not publish its port" >&2; exit 1; }
  health_port="$(tr -d '\r\n' <"$health_port_file")"
  [[ "$health_port" =~ ^[0-9]+$ ]] || { echo "self-test loopback health port is invalid" >&2; exit 1; }
  HEPTA_BRIDGE_SELF_TEST_HEALTH_PORT="$health_port"
  HEPTA_BRIDGE_SELF_TEST_HEALTH_MODE_FILE="$health_mode_file"
  HEPTA_BRIDGE_SELF_TEST_HEALTH_REQUEST_LOG="$health_request_log"

  printf '%s\n' legacy >"$health_mode_file"
  probe_generation_health legacy "$health_port"
  if probe_generation_health vnext "$health_port" >/dev/null 2>&1; then
    echo "vNext health probe accepted the legacy-only route fixture" >&2
    exit 1
  fi
  printf '%s\n' vnext >"$health_mode_file"
  probe_generation_health vnext "$health_port"
  if probe_generation_health legacy "$health_port" >/dev/null 2>&1; then
    echo "legacy health probe accepted the vNext-only route fixture" >&2
    exit 1
  fi
  if generation_health_path unknown >/dev/null 2>&1; then
    echo "unknown service generation received a health route" >&2
    exit 1
  fi
  : >"$health_request_log"
  printf '%s\n' vnext >"$health_mode_file"; probe_generation_health vnext "$health_port"
  printf '%s\n' legacy >"$health_mode_file"; probe_generation_health legacy "$health_port"
  printf '%s\n' vnext >"$health_mode_file"; probe_generation_health vnext "$health_port"
  expected_health_requests="$root/expected-health-requests.tsv"
  printf 'vnext\t/healthz\nlegacy\t/health\nvnext\t/healthz\n' >"$expected_health_requests"
  diff -u "$expected_health_requests" "$health_request_log" >/dev/null || {
    echo "generation-specific health probe sequence differs from the exact route contract" >&2
    exit 1
  }
  : >"$health_request_log"
  source_repository="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
  tooling_repository="$root/tooling-repository"
  mkdir -p "$tooling_repository/scripts"
  for relative in \
    scripts/hepta-immutable-release-tree scripts/hepta-cutover-guard scripts/hepta-generation-pointer scripts/hepta-install-live-gateway \
    scripts/hepta-install-live-watchdog scripts/hepta-launchd-cutover-bridge scripts/hepta-live-soak.sh \
    scripts/hepta-state-snapshot scripts/hepta-watchdog.sh; do
    cp "$source_repository/$relative" "$tooling_repository/$relative"
    chmod 0755 "$tooling_repository/$relative"
  done
  git -C "$tooling_repository" init -q
  git -C "$tooling_repository" config user.name hepta-bridge-self-test
  git -C "$tooling_repository" config user.email hepta-bridge-self-test.invalid
  git -C "$tooling_repository" add scripts
  git -C "$tooling_repository" commit -q -m 'bridge self-test tooling'
  source_commit="$(git -C "$tooling_repository" rev-parse --verify 'HEAD^{commit}')"
  materializer="$tooling_repository/scripts/hepta-immutable-release-tree"
  release="$root/release"; install_root="$root/vnext-install"; launch_root="$root/LaunchAgents"; bundle="$root/bridge"
  mkdir -p "$launch_root" "$root/legacy-install/bin"
  fixture_binary="$root/hepta-fixture"
  self_test_binary "$fixture_binary"
  "$materializer" materialize --binary "$fixture_binary" --destination "$release" \
    --state-root "$root/state-copy" --install-root "$install_root" \
    --gateway-label ai.hepta.gateway --watchdog-label ai.hepta.installed-live-watchdog \
    --listen-port 17373 --source-commit "$source_commit" >/dev/null
  "$release/scripts/hepta-generation-pointer" initialize --install-root "$install_root" --manifest "$release/manifest.json" >/dev/null
  cp /usr/bin/true "$root/legacy-install/bin/hepta"
  cp /usr/bin/true "$root/legacy-install/watchdog.sh"
  chmod 0500 "$root/legacy-install/bin/hepta" "$root/legacy-install/watchdog.sh"
  for role in gateway watchdog; do
    local label program json target
    label=ai.hepta.gateway; program="$root/legacy-install/bin/hepta"
    [[ "$role" == "watchdog" ]] && { label=ai.hepta.installed-live-watchdog; program="$root/legacy-install/watchdog.sh"; }
    json="$root/$role.json"; target="$launch_root/$label.plist"
    jq -n --arg label "$label" --arg program "$program" '{Label:$label,ProgramArguments:[$program]}' >"$json"
    plutil -convert xml1 -o "$target" "$json"; chmod 0444 "$target"
  done

  legacy_state="$root/legacy-state"
  mkdir -p "$legacy_state/runtime-v2"; chmod 0700 "$legacy_state" "$legacy_state/runtime-v2"
  printf 'self-test-state\n' >"$legacy_state/runtime-v2/runtime-state.json"
  chmod 0600 "$legacy_state/runtime-v2/runtime-state.json"
  snapshot_receipt="$root/evidence/state-snapshot.json"
  "$release/scripts/hepta-state-snapshot" \
    --source-state-root "$legacy_state" --destination-state-root "$root/state-copy" \
    --legacy-label ai.hepta.bridge.selftest --receipt "$snapshot_receipt" --materialize >/dev/null
  soak_receipt="$root/evidence/soak.json"
  binary_sha="$(jq -r '.artifact.sha256' "$release/manifest.json")"
  manifest_sha="$(sha256_file "$release/manifest.json")"
  snapshot_sha="$(sha256_file "$snapshot_receipt")"
  jq -n --arg binary_sha "$binary_sha" --arg manifest "$root/canary-release/manifest.json" \
    --arg state_root "$root/private-copy" \
    '{schema:"hepta_vnext_live_soak_v1",status:"ready",manifest:$manifest,manifest_sha256:"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",active_artifact_sha256:$binary_sha,live_url:"http://127.0.0.1:17373",state_root:$state_root,samples:3,passed:3,failed:0,schema_v5_open_existing:true,keyed_integrity_verified:true,immutable_query_only:true,authority_all_closed:true,service_changed:false}' >"$soak_receipt"
  source_commit="$(jq -r '.source.commit' "$release/manifest.json")"
  canary_receipt="$root/evidence/canary.json"
  jq -n --arg source_commit "$source_commit" --arg binary_sha "$binary_sha" \
    --arg manifest "$root/canary-release/manifest.json" \
    --arg target_manifest "$release/manifest.json" --arg target_manifest_sha "$manifest_sha" \
    --arg snapshot_sha "$snapshot_sha" --arg state_root "$root/state-copy" \
    --arg snapshot_id "$(jq -r '.snapshot_id' "$snapshot_receipt")" \
    --arg snapshot_identity "$(jq -r '.source_identity_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_portable "$(jq -r '.portable_payload_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_modes "$(jq -r '.original_mode_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_acls "$(jq -r '.acl_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_top "$(jq -r '.top_level_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_sidecar "$(jq -r '.sqlite_sidecar_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_key "$(jq -r '.key_inventory_sha256' "$snapshot_receipt")" \
    --arg snapshot_hardlinks "$(jq -r '.hardlink_topology_inventory_sha256' "$snapshot_receipt")" \
    --arg canary_state_root "$root/private-copy" --arg soak_sha "$(sha256_file "$soak_receipt")" \
    '{schema:"hepta_vnext_runtime_canary_e2e_v3",status:"ready",listen_addr:"127.0.0.1:17373",source_commit:$source_commit,source_tree_clean:true,binary_sha256:$binary_sha,manifest:$manifest,manifest_sha256:"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",canary_state_root:$canary_state_root,target_manifest:$target_manifest,target_manifest_sha256:$target_manifest_sha,snapshot_receipt_sha256:$snapshot_sha,snapshot_schema:"hepta_vnext_state_snapshot_receipt_v3",snapshot_profile:"full-state-root-v3",snapshot_mode_profile:"hepta_vnext_state_mode_profile_v3",snapshot_acl_profile:"hepta_vnext_state_acl_profile_deny_only_v1",snapshot_id:$snapshot_id,snapshot_source_identity_inventory_sha256:$snapshot_identity,snapshot_portable_payload_inventory_sha256:$snapshot_portable,snapshot_original_mode_inventory_sha256:$snapshot_modes,snapshot_acl_inventory_sha256:$snapshot_acls,snapshot_top_level_inventory_sha256:$snapshot_top,snapshot_sqlite_sidecar_inventory_sha256:$snapshot_sidecar,snapshot_key_inventory_sha256:$snapshot_key,snapshot_hardlink_topology_inventory_sha256:$snapshot_hardlinks,snapshot_recutover_predecessor:null,source_state_root:$state_root,source_inventory_sha256:"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",copy_payload_sha256:$snapshot_portable,copy_mode_inventory_sha256:$snapshot_modes,copy_acl_inventory_sha256:$snapshot_acls,soak_receipt_sha256:$soak_sha,soak_samples:3,production_inventory_sha256:"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",schema_v5_open_existing:true,keyed_integrity_verified:true,immutable_query_only:true,requires_empty_wal:true,source_state_copied:true,full_state_source_copied:true,full_snapshot_receipt_bound:true,all_top_level_entries_copied:true,original_modes_preserved:true,deny_only_acls_preserved:true,hardlinks_preserved:true,source_unchanged:true,copy_unchanged:true,metadata_and_hash_checked:true,installer_dry_run:true,protected_routes_absent:true,non_get_rejected:true,authority_all_closed:true,production_service_changed:false}' >"$canary_receipt"
  if "$release/scripts/hepta-install-live-gateway" --manifest "$release/manifest.json" \
    --launch-agent-root "$root/direct-install-rejected" --install >/dev/null 2>&1; then
    echo "direct production-label gateway install was accepted" >&2
    exit 1
  fi
  if "$release/scripts/hepta-install-live-watchdog" --manifest "$release/manifest.json" \
    --launch-agent-root "$root/direct-install-rejected" --install >/dev/null 2>&1; then
    echo "direct production-label watchdog install was accepted" >&2
    exit 1
  fi
  bad_canary="$root/evidence/bad-canary.json"
  jq '.target_manifest_sha256 = "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"' "$canary_receipt" >"$bad_canary"
  bad_bundle="$root/bad-bridge"
  if prepare_bundle "$release/manifest.json" "$launch_root" "$bad_bundle" \
    "$snapshot_receipt" "$bad_canary" "$soak_receipt" >/dev/null 2>&1; then
    echo "bridge accepted canary evidence for a different target manifest" >&2
    exit 1
  fi
  [[ ! -e "$bad_bundle" ]] || { echo "invalid evidence published a bridge bundle" >&2; exit 1; }
  legacy_v1_snapshot="$root/evidence/legacy-v1-snapshot.json"
  legacy_v1_canary="$root/evidence/legacy-v1-canary.json"
  legacy_v1_bundle="$root/legacy-v1-downgrade-bridge"
  legacy_v1_source_inventory="$root/legacy-v1-source.inventory"
  legacy_v1_payload_inventory="$root/legacy-v1-payload.inventory"
  self_test_inventory_v1 "$legacy_state/runtime-v2" "$legacy_v1_source_inventory"
  self_test_payload_v1 "$root/state-copy/runtime-v2" "$legacy_v1_payload_inventory"
  jq -n --arg source "$legacy_state" --arg destination "$root/state-copy" \
    --arg source_inventory_sha256 "$(sha256_file "$legacy_v1_source_inventory")" \
    --arg payload_inventory_sha256 "$(sha256_file "$legacy_v1_payload_inventory")" \
    --argjson file_count "$(find "$root/state-copy/runtime-v2" -type f | wc -l | tr -d ' ')" \
    '{schema:"hepta_vnext_state_snapshot_receipt_v1",status:"ready",source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:"ai.hepta.bridge.selftest",legacy_launchd_unloaded:true,source_inventory_sha256:$source_inventory_sha256,payload_inventory_sha256:$payload_inventory_sha256,file_count:$file_count,created_at:"2026-08-12T00:00:00Z",writer_stopped:true,wal_empty:true,source_unchanged:true,destination_exact_copy:true,modes_and_sidecars_preserved:true,service_changed:false}' >"$legacy_v1_snapshot"
  "$release/scripts/hepta-state-snapshot" verify --receipt "$legacy_v1_snapshot" >/dev/null
  "$release/scripts/hepta-state-snapshot" verify-source --receipt "$legacy_v1_snapshot" >/dev/null
  jq --arg snapshot_sha "$(sha256_file "$legacy_v1_snapshot")" '
    .schema = "hepta_vnext_runtime_canary_e2e_v1"
    | .snapshot_receipt_sha256 = $snapshot_sha
    | .snapshot_schema = "hepta_vnext_state_snapshot_receipt_v1"
    | del(.snapshot_profile,.snapshot_mode_profile,.snapshot_id,.snapshot_source_identity_inventory_sha256,.snapshot_portable_payload_inventory_sha256,.snapshot_original_mode_inventory_sha256,.snapshot_top_level_inventory_sha256,.snapshot_sqlite_sidecar_inventory_sha256,.snapshot_key_inventory_sha256,.snapshot_hardlink_topology_inventory_sha256,.copy_mode_inventory_sha256,.full_state_source_copied,.full_snapshot_receipt_bound,.all_top_level_entries_copied,.original_modes_preserved,.hardlinks_preserved)
  ' "$canary_receipt" >"$legacy_v1_canary"
  if prepare_bundle "$release/manifest.json" "$launch_root" "$legacy_v1_bundle" \
    "$legacy_v1_snapshot" "$legacy_v1_canary" "$soak_receipt" >/dev/null 2>&1; then
    echo "full-state-root-v3 release accepted legacy v1 snapshot/canary evidence" >&2
    exit 1
  fi
  [[ ! -e "$legacy_v1_bundle" ]] || { echo "v1 downgrade rejection published a bridge bundle" >&2; exit 1; }
  legacy_v2_snapshot="$root/evidence/legacy-v2-snapshot.json"
  legacy_v2_binding="$root/.state-copy.hepta-state-snapshot-v2.binding"
  legacy_v2_canary="$root/evidence/legacy-v2-canary.json"
  legacy_v2_bundle="$root/legacy-v2-downgrade-bridge"
  jq -n --arg snapshot_id "$(jq -r '.snapshot_id' "$snapshot_receipt")" \
    --arg destination "$root/state-copy" \
    --arg portable "$(jq -r '.portable_payload_inventory_sha256' "$snapshot_receipt")" \
    --arg hardlinks "$(jq -r '.hardlink_topology_inventory_sha256' "$snapshot_receipt")" \
    '{schema:"hepta_vnext_state_snapshot_binding_v2",snapshot_id:$snapshot_id,destination_state_root:$destination,portable_payload_inventory_sha256:$portable,hardlink_topology_inventory_sha256:$hardlinks}' >"$legacy_v2_binding"
  chmod 0400 "$legacy_v2_binding"
  jq --arg binding "$legacy_v2_binding" --arg binding_sha "$(sha256_file "$legacy_v2_binding")" '
    .schema = "hepta_vnext_state_snapshot_receipt_v2"
    | .destination_binding = $binding
    | .destination_binding_sha256 = $binding_sha
    | del(.profile,.mode_profile,.original_mode_inventory_sha256,.mode_policy_validated,.original_modes_preserved)
  ' "$snapshot_receipt" >"$legacy_v2_snapshot"
  chmod 0400 "$legacy_v2_snapshot"
  "$release/scripts/hepta-state-snapshot" verify --receipt "$legacy_v2_snapshot" >/dev/null
  "$release/scripts/hepta-state-snapshot" verify-source --receipt "$legacy_v2_snapshot" >/dev/null
  jq --arg snapshot_sha "$(sha256_file "$legacy_v2_snapshot")" '
    .schema = "hepta_vnext_runtime_canary_e2e_v2"
    | .snapshot_receipt_sha256 = $snapshot_sha
    | .snapshot_schema = "hepta_vnext_state_snapshot_receipt_v2"
    | del(.snapshot_profile,.snapshot_mode_profile,.snapshot_original_mode_inventory_sha256,.copy_mode_inventory_sha256,.original_modes_preserved)
  ' "$canary_receipt" >"$legacy_v2_canary"
  if prepare_bundle "$release/manifest.json" "$launch_root" "$legacy_v2_bundle" \
    "$legacy_v2_snapshot" "$legacy_v2_canary" "$soak_receipt" >/dev/null 2>&1; then
    echo "full-state-root-v3 release accepted v2 snapshot/canary evidence as v3" >&2
    exit 1
  fi
  [[ ! -e "$legacy_v2_bundle" ]] || { echo "v2 downgrade rejection published a bridge bundle" >&2; exit 1; }
  prepare_bundle "$release/manifest.json" "$launch_root" "$bundle" \
    "$snapshot_receipt" "$canary_receipt" "$soak_receipt" >/dev/null

  closure_tamper_bundle="$root/bridge-extra-directory"
  cp -pR "$bundle" "$closure_tamper_bundle"; chmod 0700 "$closure_tamper_bundle"
  mkdir "$closure_tamper_bundle/extra"; chmod 0500 "$closure_tamper_bundle/extra" "$closure_tamper_bundle"
  if verify_bundle "$closure_tamper_bundle" >/dev/null 2>&1; then
    echo "bridge closure accepted an extra directory" >&2; exit 1
  fi
  closure_tamper_bundle="$root/bridge-fifo"
  cp -pR "$bundle" "$closure_tamper_bundle"; chmod 0700 "$closure_tamper_bundle"
  mkfifo "$closure_tamper_bundle/fifo"; chmod 0400 "$closure_tamper_bundle/fifo"; chmod 0500 "$closure_tamper_bundle"
  if verify_bundle "$closure_tamper_bundle" >/dev/null 2>&1; then
    echo "bridge closure accepted a FIFO" >&2; exit 1
  fi
  external_hardlink_source="$root/bridge-external-hardlink-source"
  printf 'external\n' >"$external_hardlink_source"; chmod 0400 "$external_hardlink_source"
  closure_tamper_bundle="$root/bridge-external-hardlink"
  cp -pR "$bundle" "$closure_tamper_bundle"; chmod 0700 "$closure_tamper_bundle"
  ln "$external_hardlink_source" "$closure_tamper_bundle/external-hardlink"; chmod 0500 "$closure_tamper_bundle"
  if verify_bundle "$closure_tamper_bundle" >/dev/null 2>&1; then
    echo "bridge closure accepted a root-external hardlink" >&2; exit 1
  fi
  closure_tamper_bundle="$root/bridge-file-mode"
  cp -pR "$bundle" "$closure_tamper_bundle"; chmod 0600 "$closure_tamper_bundle/plan.json"
  if verify_bundle "$closure_tamper_bundle" >/dev/null 2>&1; then
    echo "bridge closure accepted a non-0400 file" >&2; exit 1
  fi
  closure_tamper_bundle="$root/bridge-directory-mode"
  cp -pR "$bundle" "$closure_tamper_bundle"; chmod 0700 "$closure_tamper_bundle/evidence"
  if verify_bundle "$closure_tamper_bundle" >/dev/null 2>&1; then
    echo "bridge closure accepted a non-0500 directory" >&2; exit 1
  fi
  closure_tamper_bundle="$root/bridge-file-acl"
  cp -pR "$bundle" "$closure_tamper_bundle"; chmod +a 'everyone allow read' "$closure_tamper_bundle/plan.json"
  if verify_bundle "$closure_tamper_bundle" >/dev/null 2>&1; then
    echo "bridge closure accepted an ACL on a file" >&2; exit 1
  fi
  closure_tamper_bundle="$root/bridge-directory-acl"
  cp -pR "$bundle" "$closure_tamper_bundle"; chmod +a 'everyone allow list' "$closure_tamper_bundle/evidence"
  if verify_bundle "$closure_tamper_bundle" >/dev/null 2>&1; then
    echo "bridge closure accepted an ACL on a directory" >&2; exit 1
  fi
  closure_tamper_bundle="$root/bridge-xattr"
  cp -pR "$bundle" "$closure_tamper_bundle"; chmod 0600 "$closure_tamper_bundle/plan.json"
  /usr/bin/xattr -w com.hepta.bridge.selftest value "$closure_tamper_bundle/plan.json"; chmod 0400 "$closure_tamper_bundle/plan.json"
  if verify_bundle "$closure_tamper_bundle" >/dev/null 2>&1; then
    echo "bridge closure accepted an xattr" >&2; exit 1
  fi
  unreadable_xattr_bundle="$root/bridge-unreadable-xattr"
  cp -pR "$bundle" "$unreadable_xattr_bundle"; chmod 0600 "$unreadable_xattr_bundle/plan.json"
  /usr/bin/xattr -w com.hepta.bridge.selftest value "$unreadable_xattr_bundle/plan.json"
  chmod +a 'everyone deny readextattr' "$unreadable_xattr_bundle/plan.json"; chmod 0400 "$unreadable_xattr_bundle/plan.json"
  if bridge_xattr_sha256 "$unreadable_xattr_bundle/plan.json" >/dev/null 2>&1; then
    echo "bridge xattr helper accepted an unreadable namespace" >&2
    exit 1
  fi
  closure_tamper_bundle="$root/bridge-bsd-flag"
  cp -pR "$bundle" "$closure_tamper_bundle"; chflags hidden "$closure_tamper_bundle/plan.json"
  if verify_bundle "$closure_tamper_bundle" >/dev/null 2>&1; then
    echo "bridge closure accepted a BSD flag" >&2; exit 1
  fi

  transition cutover "$bundle" "" "" false test >/dev/null
  [[ ! -e "$install_root/logs" && ! -L "$install_root/logs" ]] || {
    echo "dry-run created vNext log directories" >&2
    exit 1
  }
  mkdir "$root/untrusted-logs"
  ln -s "$root/untrusted-logs" "$install_root/logs"
  log_symlink_receipt="$root/log-symlink-refused.json"
  if transition cutover "$bundle" "" "$log_symlink_receipt" true test >/dev/null 2>&1; then
    echo "bridge accepted a symlinked vNext log root" >&2
    exit 1
  fi
  [[ ! -e "$log_symlink_receipt" \
    && "$(sha256_file "$launch_root/ai.hepta.gateway.plist")" == "$(jq -r '.legacy.gateway.sha256' "$bundle/plan.json")" \
    && "$(sha256_file "$launch_root/ai.hepta.installed-live-watchdog.plist")" == "$(jq -r '.legacy.watchdog.sha256' "$bundle/plan.json")" ]] || {
    echo "log preflight failure changed the reviewed legacy service pair" >&2
    exit 1
  }
  rm "$install_root/logs"

  mkdir "$install_root/logs"
  ln -s "$root/untrusted-logs" "$install_root/logs/gateway"
  log_child_symlink_receipt="$root/log-child-symlink-refused.json"
  if transition cutover "$bundle" "" "$log_child_symlink_receipt" true test >/dev/null 2>&1; then
    echo "bridge accepted a symlinked vNext gateway log directory" >&2
    exit 1
  fi
  [[ ! -e "$log_child_symlink_receipt" \
    && "$(sha256_file "$launch_root/ai.hepta.gateway.plist")" == "$(jq -r '.legacy.gateway.sha256' "$bundle/plan.json")" \
    && "$(sha256_file "$launch_root/ai.hepta.installed-live-watchdog.plist")" == "$(jq -r '.legacy.watchdog.sha256' "$bundle/plan.json")" ]] || {
    echo "child log preflight failure changed the reviewed legacy service pair" >&2
    exit 1
  }
  rm "$install_root/logs/gateway"
  rmdir "$install_root/logs"

  fault_receipt="$root/fault-pending.json"
  if HEPTA_BRIDGE_SELF_TEST_FAIL_AFTER_GATEWAY_PUBLISH=1 \
    transition cutover "$bundle" "" "$fault_receipt" true test >/dev/null 2>&1; then
    echo "injected mixed-publish failure unexpectedly passed" >&2
    exit 1
  fi
  jq -e '.schema == "hepta_vnext_launchd_bridge_transition_pending_v1" and .status == "pending" and .applied == false' "$fault_receipt" >/dev/null
  [[ "$(sha256_file "$launch_root/ai.hepta.gateway.plist")" == "$(jq -r '.legacy.gateway.sha256' "$bundle/plan.json")" \
    && "$(sha256_file "$launch_root/ai.hepta.installed-live-watchdog.plist")" == "$(jq -r '.legacy.watchdog.sha256' "$bundle/plan.json")" ]] || {
    echo "fault injection did not restore the legacy plist pair" >&2
    exit 1
  }
  recover_pending "$bundle" "$fault_receipt" true test >/dev/null
  jq -e '.schema == "hepta_vnext_launchd_bridge_pending_recovery_v1"
    and .source_service_pair_restored == true and .chain_head_restored == true
    and .restored_generation == "legacy" and .restored_health_path == "/health"
    and .restored_health_verified == true and .no_transition_pass_published == true' "$fault_receipt" >/dev/null

  health_failure_cutover="$root/health-failure-cutover-pending.json"
  : >"$health_request_log"
  if HEPTA_BRIDGE_SELF_TEST_FAIL_HEALTH_GENERATION=vnext \
    transition cutover "$bundle" "" "$health_failure_cutover" true test >/dev/null 2>&1; then
    echo "cutover accepted an unhealthy vNext target" >&2
    exit 1
  fi
  jq -e '.schema == "hepta_vnext_launchd_bridge_transition_pending_v1"
    and .status == "pending" and .source_generation == "legacy" and .target_generation == "vnext"
    and .source_health_path == "/health" and .target_health_path == "/healthz"
    and .applied == false' "$health_failure_cutover" >/dev/null
  [[ "$(sha256_file "$launch_root/ai.hepta.gateway.plist")" == "$(jq -r '.legacy.gateway.sha256' "$bundle/plan.json")" \
    && "$(sha256_file "$launch_root/ai.hepta.installed-live-watchdog.plist")" == "$(jq -r '.legacy.watchdog.sha256' "$bundle/plan.json")" ]] || {
    echo "vNext health failure did not restore the exact legacy plist pair" >&2
    exit 1
  }
  printf 'vnext-fail\t/healthz\nlegacy\t/health\n' >"$expected_health_requests"
  diff -u "$expected_health_requests" "$health_request_log" >/dev/null || {
    echo "vNext health failure did not probe and restore the generation-specific routes" >&2
    exit 1
  }
  recover_pending "$bundle" "$health_failure_cutover" true test >/dev/null
  jq -e '.schema == "hepta_vnext_launchd_bridge_pending_recovery_v1"
    and .restored_generation == "legacy" and .restored_health_path == "/health"
    and .restored_health_verified == true and .source_service_pair_restored == true
    and .chain_head_restored == true and .no_transition_pass_published == true' "$health_failure_cutover" >/dev/null
  printf 'vnext-fail\t/healthz\nlegacy\t/health\nlegacy\t/health\n' >"$expected_health_requests"
  diff -u "$expected_health_requests" "$health_request_log" >/dev/null || {
    echo "pending recovery did not verify the restored legacy /health route" >&2
    exit 1
  }
  for directory in "$install_root/logs" "$install_root/logs/gateway" "$install_root/logs/watchdog"; do
    [[ -d "$directory" && ! -L "$directory" \
      && "$(cd "$directory" && pwd -P)" == "$directory" \
      && "$(stat -f '%Lp' "$directory")" == 700 \
      && "$(stat -f '%u' "$directory")" == "$(id -u)" ]] || {
      echo "bridge did not create a private physical vNext log directory: $directory" >&2
      exit 1
    }
  done

  cutover_receipt="$root/cutover.json"; rollback_receipt="$root/rollback.json"
  recutover_receipt="$root/recutover.json"; second_rollback_receipt="$root/second-rollback.json"
  lock_receipt="$root/lock-refused.json"
  mkdir "$(jq -r '.operation_lock' "$bundle/plan.json")"
  if transition cutover "$bundle" "" "$lock_receipt" true test >/dev/null 2>&1; then
    echo "bridge transition ignored the global operation lock" >&2
    exit 1
  fi
  rmdir "$(jq -r '.operation_lock' "$bundle/plan.json")"
  [[ ! -e "$lock_receipt" ]] || { echo "lock refusal reserved a transition receipt" >&2; exit 1; }
  generation_lock_receipt="$root/generation-lock-refused.json"
  mkdir "$install_root/.generation-operation.lock"
  if transition cutover "$bundle" "" "$generation_lock_receipt" true test >/dev/null 2>&1; then
    echo "bridge transition ignored the shared generation lock" >&2
    exit 1
  fi
  rmdir "$install_root/.generation-operation.lock"
  [[ ! -e "$generation_lock_receipt" ]] || { echo "generation lock refusal reserved a transition receipt" >&2; exit 1; }
  occupied_receipt="$root/occupied.json"; printf 'occupied\n' >"$occupied_receipt"
  if transition cutover "$bundle" "" "$occupied_receipt" true test >/dev/null 2>&1; then
    echo "pre-existing transition receipt was accepted" >&2
    exit 1
  fi
  chmod 0755 "$install_root/logs" "$install_root/logs/gateway" "$install_root/logs/watchdog"
  transition_pending_copy="$root/cutover-pending-copy.json"
  if HEPTA_BRIDGE_SELF_TEST_CAPTURE_TRANSITION_PENDING="$transition_pending_copy" \
    HEPTA_BRIDGE_SELF_TEST_FAIL_AFTER_TRANSITION_RECEIPT_FINALIZED=1 \
    transition cutover "$bundle" "" "$cutover_receipt" true test >/dev/null 2>&1; then
    echo "injected transition cursor-finalization interruption unexpectedly passed" >&2
    exit 1
  fi
  jq -e '.schema == "hepta_vnext_launchd_bridge_transition_v1" and .transition == "cutover"
    and .applied == true and .chain_head_committed == true' "$cutover_receipt" >/dev/null
  jq -e '.transition_receipt_finalized == false' "$(jq -r '.chain_cursor' "$bundle/plan.json")" >/dev/null
  transition_receipt_sha="$(sha256_file "$cutover_receipt")"
  recover_pending "$bundle" "$cutover_receipt" true test >/dev/null
  [[ "$(sha256_file "$cutover_receipt")" == "$transition_receipt_sha" ]] || {
    echo "transition finalization recovery rewrote the final receipt" >&2
    exit 1
  }
  jq -e '.transition_receipt_finalized == true' "$(jq -r '.chain_cursor' "$bundle/plan.json")" >/dev/null
  transition_cursor_sha="$(sha256_file "$(jq -r '.chain_cursor' "$bundle/plan.json")")"
  recover_pending "$bundle" "$cutover_receipt" true test >/dev/null
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$bundle/plan.json")")" == "$transition_cursor_sha" ]] || {
    echo "idempotent transition finalization recovery changed the cursor" >&2
    exit 1
  }
  if recover_pending "$bundle" "$transition_pending_copy" true test >/dev/null 2>&1; then
    echo "completed transition accepted a copied stale pending receipt" >&2
    exit 1
  fi
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$bundle/plan.json")")" == "$transition_cursor_sha" ]] || {
    echo "copied transition pending replay changed the completed cursor" >&2
    exit 1
  }
  saved_transition_receipt="$root/cutover-final.saved"
  cp "$cutover_receipt" "$saved_transition_receipt"
  chmod 0400 "$saved_transition_receipt"
  chmod 0600 "$cutover_receipt"
  cp "$transition_pending_copy" "$cutover_receipt"
  chmod 0400 "$cutover_receipt"
  if recover_pending "$bundle" "$cutover_receipt" true test >/dev/null 2>&1; then
    echo "completed transition accepted stale pending bytes at the original receipt path" >&2
    exit 1
  fi
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$bundle/plan.json")")" == "$transition_cursor_sha" ]] || {
    echo "original-path transition pending replay changed the completed cursor" >&2
    exit 1
  }
  chmod 0600 "$cutover_receipt"
  cp "$saved_transition_receipt" "$cutover_receipt"
  chmod 0400 "$cutover_receipt"
  [[ "$(sha256_file "$cutover_receipt")" == "$transition_receipt_sha" ]] || {
    echo "failed to restore the exact finalized transition receipt" >&2
    exit 1
  }
  for directory in "$install_root/logs" "$install_root/logs/gateway" "$install_root/logs/watchdog"; do
    [[ "$(stat -f '%Lp' "$directory")" == 700 ]] || {
      echo "bridge did not harden an existing vNext log directory: $directory" >&2
      exit 1
    }
  done
  jq -e '.source_health_path == "/health" and .target_health_path == "/healthz"
    and .post_transition_health_path == "/healthz" and .post_transition_health_verified == true' \
    "$cutover_receipt" >/dev/null

  health_failure_rollback="$root/health-failure-rollback-pending.json"
  : >"$health_request_log"
  if HEPTA_BRIDGE_SELF_TEST_FAIL_HEALTH_GENERATION=legacy \
    transition rollback "$bundle" "$cutover_receipt" "$health_failure_rollback" true test >/dev/null 2>&1; then
    echo "rollback accepted an unhealthy legacy target" >&2
    exit 1
  fi
  jq -e '.schema == "hepta_vnext_launchd_bridge_transition_pending_v1"
    and .status == "pending" and .source_generation == "vnext" and .target_generation == "legacy"
    and .source_health_path == "/healthz" and .target_health_path == "/health"
    and .applied == false' "$health_failure_rollback" >/dev/null
  [[ "$(sha256_file "$launch_root/ai.hepta.gateway.plist")" == "$(jq -r '.vnext.gateway.sha256' "$bundle/plan.json")" \
    && "$(sha256_file "$launch_root/ai.hepta.installed-live-watchdog.plist")" == "$(jq -r '.vnext.watchdog.sha256' "$bundle/plan.json")" ]] || {
    echo "legacy health failure did not restore the exact vNext plist pair" >&2
    exit 1
  }
  printf 'vnext\t/healthz\nlegacy-fail\t/health\nvnext\t/healthz\n' >"$expected_health_requests"
  diff -u "$expected_health_requests" "$health_request_log" >/dev/null || {
    echo "legacy health failure did not probe and restore the generation-specific routes" >&2
    exit 1
  }
  recover_pending "$bundle" "$health_failure_rollback" true test >/dev/null
  jq -e '.schema == "hepta_vnext_launchd_bridge_pending_recovery_v1"
    and .restored_generation == "vnext" and .restored_health_path == "/healthz"
    and .restored_health_verified == true and .source_service_pair_restored == true
    and .chain_head_restored == true and .exact_prior_cursor_restored == true
    and .no_transition_pass_published == true' "$health_failure_rollback" >/dev/null
  printf 'vnext\t/healthz\nlegacy-fail\t/health\nvnext\t/healthz\nvnext\t/healthz\n' >"$expected_health_requests"
  diff -u "$expected_health_requests" "$health_request_log" >/dev/null || {
    echo "pending recovery did not verify the restored vNext /healthz route" >&2
    exit 1
  }
  : >"$health_request_log"
  transition rollback "$bundle" "$cutover_receipt" "$rollback_receipt" true test >/dev/null
  jq -e '.source_health_path == "/healthz" and .target_health_path == "/health"
    and .post_transition_health_path == "/health" and .post_transition_health_verified == true' \
    "$rollback_receipt" >/dev/null
  transition recutover "$bundle" "$rollback_receipt" "$recutover_receipt" true test >/dev/null
  jq -e '.source_health_path == "/health" and .target_health_path == "/healthz"
    and .post_transition_health_path == "/healthz" and .post_transition_health_verified == true' \
    "$recutover_receipt" >/dev/null
  printf 'vnext\t/healthz\nlegacy\t/health\nvnext\t/healthz\n' >"$expected_health_requests"
  diff -u "$expected_health_requests" "$health_request_log" >/dev/null || {
    echo "normal rollback and recutover did not follow the exact vNext-to-legacy-to-vNext health route sequence" >&2
    exit 1
  }
  replay_receipt="$root/replayed-old-head.json"
  if transition rollback "$bundle" "$cutover_receipt" "$replay_receipt" true test >/dev/null 2>&1; then
    echo "bridge accepted a stale receipt instead of the current chain head" >&2
    exit 1
  fi
  [[ ! -e "$replay_receipt" \
    && "$(sha256_file "$launch_root/ai.hepta.gateway.plist")" == "$(jq -r '.vnext.gateway.sha256' "$bundle/plan.json")" ]] || {
    echo "stale receipt rejection changed the active service pair" >&2
    exit 1
  }
  transition rollback "$bundle" "$recutover_receipt" "$second_rollback_receipt" true test >/dev/null
  printf 'post-rollback-write\n' >>"$legacy_state/runtime-v2/runtime-state.json"
  stale_snapshot_receipt="$root/stale-snapshot-recutover.json"
  if transition recutover "$bundle" "$second_rollback_receipt" "$stale_snapshot_receipt" true test >/dev/null 2>&1; then
    echo "bridge recutover accepted a changed snapshot source" >&2
    exit 1
  fi
  [[ ! -e "$stale_snapshot_receipt" \
    && "$(sha256_file "$launch_root/ai.hepta.gateway.plist")" == "$(jq -r '.legacy.gateway.sha256' "$bundle/plan.json")" ]] || {
    echo "stale snapshot rejection changed the legacy service pair" >&2
    exit 1
  }

  # Rollback writes require a new full-root snapshot/canary/soak evidence set
  # and a controlled plan epoch. No service is changed while the new epoch is
  # prepared or rebased onto the reviewed rollback head.
  release2="$root/release-recutover"; install_root2="$root/vnext-install-recutover"
  "$materializer" materialize --binary "$fixture_binary" --destination "$release2" \
    --state-root "$root/state-copy-recutover" --install-root "$install_root2" \
    --gateway-label ai.hepta.gateway --watchdog-label ai.hepta.installed-live-watchdog \
    --listen-port 17373 --source-commit "$source_commit" >/dev/null
  "$release2/scripts/hepta-generation-pointer" initialize --install-root "$install_root2" --manifest "$release2/manifest.json" >/dev/null
  fresh_snapshot_receipt="$root/evidence/state-snapshot-recutover.json"
  "$release2/scripts/hepta-state-snapshot" \
    --source-state-root "$legacy_state" --destination-state-root "$root/state-copy-recutover" \
    --legacy-label ai.hepta.bridge.selftest --receipt "$fresh_snapshot_receipt" \
    --predecessor-rollback-receipt "$second_rollback_receipt" --materialize >/dev/null
  fresh_snapshot_sha="$(sha256_file "$fresh_snapshot_receipt")"
  fresh_soak_receipt="$root/evidence/soak-recutover.json"
  manifest_sha="$(sha256_file "$release2/manifest.json")"
  jq -n --arg binary_sha "$binary_sha" --arg manifest "$root/canary-release-recutover/manifest.json" \
    --arg state_root "$root/private-copy-recutover" \
    '{schema:"hepta_vnext_live_soak_v1",status:"ready",manifest:$manifest,manifest_sha256:"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",active_artifact_sha256:$binary_sha,live_url:"http://127.0.0.1:17373",state_root:$state_root,samples:3,passed:3,failed:0,schema_v5_open_existing:true,keyed_integrity_verified:true,immutable_query_only:true,authority_all_closed:true,service_changed:false}' >"$fresh_soak_receipt"
  fresh_canary_receipt="$root/evidence/canary-recutover.json"
  jq -n --arg source_commit "$source_commit" --arg binary_sha "$binary_sha" \
    --arg manifest "$root/canary-release-recutover/manifest.json" \
    --arg target_manifest "$release2/manifest.json" --arg target_manifest_sha "$manifest_sha" \
    --arg snapshot_sha "$fresh_snapshot_sha" --arg state_root "$root/state-copy-recutover" \
    --arg snapshot_id "$(jq -r '.snapshot_id' "$fresh_snapshot_receipt")" \
    --arg snapshot_identity "$(jq -r '.source_identity_inventory_sha256' "$fresh_snapshot_receipt")" \
    --arg snapshot_portable "$(jq -r '.portable_payload_inventory_sha256' "$fresh_snapshot_receipt")" \
    --arg snapshot_modes "$(jq -r '.original_mode_inventory_sha256' "$fresh_snapshot_receipt")" \
    --arg snapshot_acls "$(jq -r '.acl_inventory_sha256' "$fresh_snapshot_receipt")" \
    --arg snapshot_top "$(jq -r '.top_level_inventory_sha256' "$fresh_snapshot_receipt")" \
    --arg snapshot_sidecar "$(jq -r '.sqlite_sidecar_inventory_sha256' "$fresh_snapshot_receipt")" \
    --arg snapshot_key "$(jq -r '.key_inventory_sha256' "$fresh_snapshot_receipt")" \
    --arg snapshot_hardlinks "$(jq -r '.hardlink_topology_inventory_sha256' "$fresh_snapshot_receipt")" \
    --arg canary_state_root "$root/private-copy-recutover" --arg soak_sha "$(sha256_file "$fresh_soak_receipt")" \
    --argjson predecessor "$(jq -c '.recutover_predecessor' "$fresh_snapshot_receipt")" \
    '{schema:"hepta_vnext_runtime_canary_e2e_v3",status:"ready",listen_addr:"127.0.0.1:17373",source_commit:$source_commit,source_tree_clean:true,binary_sha256:$binary_sha,manifest:$manifest,manifest_sha256:"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",canary_state_root:$canary_state_root,target_manifest:$target_manifest,target_manifest_sha256:$target_manifest_sha,snapshot_receipt_sha256:$snapshot_sha,snapshot_schema:"hepta_vnext_state_snapshot_receipt_v3",snapshot_profile:"full-state-root-v3",snapshot_mode_profile:"hepta_vnext_state_mode_profile_v3",snapshot_acl_profile:"hepta_vnext_state_acl_profile_deny_only_v1",snapshot_id:$snapshot_id,snapshot_source_identity_inventory_sha256:$snapshot_identity,snapshot_portable_payload_inventory_sha256:$snapshot_portable,snapshot_original_mode_inventory_sha256:$snapshot_modes,snapshot_acl_inventory_sha256:$snapshot_acls,snapshot_top_level_inventory_sha256:$snapshot_top,snapshot_sqlite_sidecar_inventory_sha256:$snapshot_sidecar,snapshot_key_inventory_sha256:$snapshot_key,snapshot_hardlink_topology_inventory_sha256:$snapshot_hardlinks,snapshot_recutover_predecessor:$predecessor,source_state_root:$state_root,source_inventory_sha256:"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",copy_payload_sha256:$snapshot_portable,copy_mode_inventory_sha256:$snapshot_modes,copy_acl_inventory_sha256:$snapshot_acls,soak_receipt_sha256:$soak_sha,soak_samples:3,production_inventory_sha256:"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",schema_v5_open_existing:true,keyed_integrity_verified:true,immutable_query_only:true,requires_empty_wal:true,source_state_copied:true,full_state_source_copied:true,full_snapshot_receipt_bound:true,all_top_level_entries_copied:true,original_modes_preserved:true,deny_only_acls_preserved:true,hardlinks_preserved:true,source_unchanged:true,copy_unchanged:true,metadata_and_hash_checked:true,installer_dry_run:true,protected_routes_absent:true,non_get_rejected:true,authority_all_closed:true,production_service_changed:false}' >"$fresh_canary_receipt"

  old_timestamp_snapshot="$root/evidence/state-snapshot-old-created-at.json"
  jq '.created_at = "1970-01-01T00:00:00Z"' "$fresh_snapshot_receipt" >"$old_timestamp_snapshot"
  chmod 0400 "$old_timestamp_snapshot"
  old_timestamp_canary="$root/evidence/canary-old-created-at.json"
  jq --arg snapshot_sha "$(sha256_file "$old_timestamp_snapshot")" \
    '.snapshot_receipt_sha256 = $snapshot_sha' "$fresh_canary_receipt" >"$old_timestamp_canary"
  chmod 0400 "$old_timestamp_canary"
  old_timestamp_bundle="$root/bridge-recutover-old-created-at"
  prepare_recutover_bundle "$release2/manifest.json" "$launch_root" "$old_timestamp_bundle" \
    "$old_timestamp_snapshot" "$old_timestamp_canary" "$fresh_soak_receipt" "$bundle" "$second_rollback_receipt" >/dev/null

  for predecessor_field in receipt sha256 plan_sha256 sequence; do
    predecessor_tamper_receipt="$root/evidence/predecessor-$predecessor_field.json"
    case "$predecessor_field" in
      receipt) cp "$second_rollback_receipt" "$predecessor_tamper_receipt" ;;
      sha256) jq '.created_at = "1970-01-01T00:00:00Z"' "$second_rollback_receipt" >"$predecessor_tamper_receipt" ;;
      plan_sha256) jq '.plan_sha256 = "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"' "$second_rollback_receipt" >"$predecessor_tamper_receipt" ;;
      sequence) jq '.sequence += 2' "$second_rollback_receipt" >"$predecessor_tamper_receipt" ;;
    esac
    chmod 0400 "$predecessor_tamper_receipt"
    predecessor_tamper_snapshot="$root/evidence/state-snapshot-predecessor-$predecessor_field.json"
    jq --arg receipt "$predecessor_tamper_receipt" \
      --arg sha "$(sha256_file "$predecessor_tamper_receipt")" \
      --arg plan "$(jq -r '.plan_sha256' "$predecessor_tamper_receipt")" \
      --argjson sequence "$(jq -r '.sequence' "$predecessor_tamper_receipt")" \
      '.recutover_predecessor = {receipt:$receipt,sha256:$sha,plan_sha256:$plan,sequence:$sequence}' \
      "$fresh_snapshot_receipt" >"$predecessor_tamper_snapshot"
    chmod 0400 "$predecessor_tamper_snapshot"
    predecessor_tamper_canary="$root/evidence/canary-predecessor-$predecessor_field.json"
    jq --arg snapshot_sha "$(sha256_file "$predecessor_tamper_snapshot")" \
      --argjson predecessor "$(jq -c '.recutover_predecessor' "$predecessor_tamper_snapshot")" \
      '.snapshot_receipt_sha256 = $snapshot_sha | .snapshot_recutover_predecessor = $predecessor' \
      "$fresh_canary_receipt" >"$predecessor_tamper_canary"
    chmod 0400 "$predecessor_tamper_canary"
    predecessor_tamper_bundle="$root/bridge-recutover-predecessor-$predecessor_field"
    if prepare_recutover_bundle "$release2/manifest.json" "$launch_root" "$predecessor_tamper_bundle" \
      "$predecessor_tamper_snapshot" "$predecessor_tamper_canary" "$fresh_soak_receipt" \
      "$bundle" "$second_rollback_receipt" >/dev/null 2>&1; then
      echo "recutover preparation accepted a mismatched predecessor $predecessor_field" >&2
      exit 1
    fi
    [[ ! -e "$predecessor_tamper_bundle" ]] || {
      echo "mismatched predecessor $predecessor_field published a bundle" >&2
      exit 1
    }
  done

  wrong_predecessor_bundle="$root/wrong-predecessor-bundle"
  if prepare_recutover_bundle "$release2/manifest.json" "$launch_root" "$wrong_predecessor_bundle" \
    "$fresh_snapshot_receipt" "$fresh_canary_receipt" "$fresh_soak_receipt" "$bundle" "$cutover_receipt" >/dev/null 2>&1; then
    echo "recutover preparation accepted a non-rollback predecessor" >&2
    exit 1
  fi
  [[ ! -e "$wrong_predecessor_bundle" ]] || { echo "wrong predecessor published a bundle" >&2; exit 1; }
  recutover_bundle="$root/bridge-recutover"; fork_bundle="$root/bridge-recutover-fork"
  prepare_recutover_bundle "$release2/manifest.json" "$launch_root" "$recutover_bundle" \
    "$fresh_snapshot_receipt" "$fresh_canary_receipt" "$fresh_soak_receipt" "$bundle" "$second_rollback_receipt" >/dev/null
  prepare_recutover_bundle "$release2/manifest.json" "$launch_root" "$fork_bundle" \
    "$fresh_snapshot_receipt" "$fresh_canary_receipt" "$fresh_soak_receipt" "$bundle" "$second_rollback_receipt" >/dev/null
  jq -e '.schema == "hepta_vnext_launchd_bridge_plan_v2" and .epoch == 2 and .parent_epoch == 1 and .fresh_evidence_required == true' "$recutover_bundle/plan.json" >/dev/null

  reserved_fault_receipt="$root/rebase-reserved-only.json"
  if HEPTA_BRIDGE_SELF_TEST_FAIL_AFTER_REBASE_RECEIPT_RESERVED=1 \
    rebase_after_rollback "$recutover_bundle" "$second_rollback_receipt" "$reserved_fault_receipt" true >/dev/null 2>&1; then
    echo "injected rebase receipt-reservation interruption unexpectedly passed" >&2
    exit 1
  fi
  jq -e --arg receipt "$reserved_fault_receipt" '
    .schema == "hepta_vnext_launchd_bridge_rebase_pending_v2"
    and .status == "pending" and .pending_receipt == $receipt
  ' "$reserved_fault_receipt" >/dev/null
  reserved_cursor_sha="$(sha256_file "$(jq -r '.chain_cursor' "$recutover_bundle/plan.json")")"
  reserved_pending_copy="$root/rebase-reserved-only-copy.json"
  cp "$reserved_fault_receipt" "$reserved_pending_copy"
  chmod 0400 "$reserved_pending_copy"
  if recover_pending "$recutover_bundle" "$reserved_pending_copy" true test >/dev/null 2>&1; then
    echo "pre-CAS recovery accepted a copied pending rebase receipt" >&2
    exit 1
  fi
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$recutover_bundle/plan.json")")" == "$reserved_cursor_sha" ]] || {
    echo "copied pre-CAS pending receipt changed the parent cursor" >&2
    exit 1
  }
  tampered_pending_tmp="$root/rebase-reserved-only-tampered.tmp"
  jq '.prior_cursor.updated_at = "1970-01-01T00:00:00Z"' "$reserved_fault_receipt" >"$tampered_pending_tmp"
  chmod 0600 "$reserved_fault_receipt"
  cp "$tampered_pending_tmp" "$reserved_fault_receipt"
  chmod 0400 "$reserved_fault_receipt"
  if recover_pending "$recutover_bundle" "$reserved_fault_receipt" true test >/dev/null 2>&1; then
    echo "pre-CAS recovery accepted pending bytes with a forged embedded cursor" >&2
    exit 1
  fi
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$recutover_bundle/plan.json")")" == "$reserved_cursor_sha" ]] || {
    echo "forged pre-CAS pending receipt changed the parent cursor" >&2
    exit 1
  }
  reserved_recovery_receipt="$root/rebase-reserved-recoverable.json"
  if HEPTA_BRIDGE_SELF_TEST_FAIL_AFTER_REBASE_RECEIPT_RESERVED=1 \
    rebase_after_rollback "$recutover_bundle" "$second_rollback_receipt" "$reserved_recovery_receipt" true >/dev/null 2>&1; then
    echo "second injected rebase receipt-reservation interruption unexpectedly passed" >&2
    exit 1
  fi
  recover_pending "$recutover_bundle" "$reserved_recovery_receipt" true test >/dev/null
  jq -e '.schema == "hepta_vnext_launchd_bridge_rebase_recovery_v2"
    and .parent_chain_restored == true and .no_rebase_pass_published == true' \
    "$reserved_recovery_receipt" >/dev/null
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$recutover_bundle/plan.json")")" == "$reserved_cursor_sha" ]] || {
    echo "valid pre-CAS pending recovery changed the exact parent cursor" >&2
    exit 1
  }

  rebase_fault_receipt="$root/rebase-pending.json"
  if HEPTA_BRIDGE_SELF_TEST_FAIL_AFTER_REBASE_PENDING=1 \
    rebase_after_rollback "$recutover_bundle" "$second_rollback_receipt" "$rebase_fault_receipt" true >/dev/null 2>&1; then
    echo "injected chain rebase interruption unexpectedly passed" >&2
    exit 1
  fi
  jq -e '.schema == "hepta_vnext_launchd_bridge_rebase_pending_v2" and .status == "pending"' "$rebase_fault_receipt" >/dev/null
  recover_pending "$recutover_bundle" "$rebase_fault_receipt" true test >/dev/null
  jq -e '.schema == "hepta_vnext_launchd_bridge_rebase_recovery_v2" and .parent_chain_restored == true and .no_rebase_pass_published == true' "$rebase_fault_receipt" >/dev/null
  replace_fault_receipt="$root/rebase-receipt-replace-fault.json"
  if HEPTA_BRIDGE_SELF_TEST_FAIL_REBASE_RECEIPT_REPLACE=1 \
    rebase_after_rollback "$recutover_bundle" "$second_rollback_receipt" "$replace_fault_receipt" true >/dev/null 2>&1; then
    echo "injected rebase receipt replacement failure unexpectedly passed" >&2
    exit 1
  fi
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$recutover_bundle/plan.json")")" == "$reserved_cursor_sha" ]] || {
    echo "rebase receipt replacement failure did not restore byte-exact parent cursor" >&2
    exit 1
  }
  recover_pending "$recutover_bundle" "$replace_fault_receipt" true test >/dev/null
  jq -e '.schema == "hepta_vnext_launchd_bridge_rebase_recovery_v2"
    and .parent_chain_restored == true and .no_rebase_pass_published == true' \
    "$replace_fault_receipt" >/dev/null
  rebase_receipt="$root/rebase.json"
  successful_pending_copy="$root/rebase-success-pending-copy.json"
  if HEPTA_BRIDGE_SELF_TEST_CAPTURE_REBASE_PENDING="$successful_pending_copy" \
    HEPTA_BRIDGE_SELF_TEST_FAIL_AFTER_REBASE_RECEIPT_FINALIZED=1 \
    rebase_after_rollback "$recutover_bundle" "$second_rollback_receipt" "$rebase_receipt" true >/dev/null 2>&1; then
    echo "injected rebase cursor-finalization interruption unexpectedly passed" >&2
    exit 1
  fi
  jq -e '.schema == "hepta_vnext_launchd_bridge_rebase_v2" and .chain_rebase_committed == true and .service_pair_unchanged == true' "$rebase_receipt" >/dev/null
  jq -e --arg receipt "$rebase_receipt" --arg receipt_sha "$(sha256_file "$rebase_receipt")" '
    .schema == "hepta_vnext_launchd_bridge_chain_v2"
    and .rebase_receipt == $receipt and .rebase_receipt_sha256 == $receipt_sha
    and .rebase_pending_receipt == $receipt and .rebase_receipt_finalized == false
  ' "$(jq -r '.chain_cursor' "$recutover_bundle/plan.json")" >/dev/null
  completed_rebase_receipt_sha="$(sha256_file "$rebase_receipt")"
  recover_pending "$recutover_bundle" "$rebase_receipt" true test >/dev/null
  [[ "$(sha256_file "$rebase_receipt")" == "$completed_rebase_receipt_sha" ]] || {
    echo "rebase finalization recovery rewrote the final receipt" >&2
    exit 1
  }
  jq -e '.rebase_receipt_finalized == true' "$(jq -r '.chain_cursor' "$recutover_bundle/plan.json")" >/dev/null
  recovered_rebase_cursor_sha="$(sha256_file "$(jq -r '.chain_cursor' "$recutover_bundle/plan.json")")"
  recover_pending "$recutover_bundle" "$rebase_receipt" true test >/dev/null
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$recutover_bundle/plan.json")")" == "$recovered_rebase_cursor_sha" ]] || {
    echo "idempotent final rebase recovery changed the cursor" >&2
    exit 1
  }

  completed_rebase_cursor_sha="$recovered_rebase_cursor_sha"
  if recover_pending "$recutover_bundle" "$successful_pending_copy" true test >/dev/null 2>&1; then
    echo "completed rebase accepted a copied stale pending receipt" >&2
    exit 1
  fi
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$recutover_bundle/plan.json")")" == "$completed_rebase_cursor_sha" ]] || {
    echo "copied stale pending receipt changed the completed rebase cursor" >&2
    exit 1
  }
  modified_pending_copy="$root/rebase-success-pending-modified.json"
  jq '.created_at = "1970-01-01T00:00:00Z"' "$successful_pending_copy" >"$modified_pending_copy"
  chmod 0400 "$modified_pending_copy"
  if recover_pending "$recutover_bundle" "$modified_pending_copy" true test >/dev/null 2>&1; then
    echo "completed rebase accepted a modified stale pending receipt" >&2
    exit 1
  fi
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$recutover_bundle/plan.json")")" == "$completed_rebase_cursor_sha" ]] || {
    echo "modified stale pending receipt changed the completed rebase cursor" >&2
    exit 1
  }
  saved_rebase_receipt="$root/rebase-success-final.saved"
  cp "$rebase_receipt" "$saved_rebase_receipt"
  chmod 0400 "$saved_rebase_receipt"
  chmod 0600 "$rebase_receipt"
  cp "$successful_pending_copy" "$rebase_receipt"
  chmod 0400 "$rebase_receipt"
  if recover_pending "$recutover_bundle" "$rebase_receipt" true test >/dev/null 2>&1; then
    echo "completed rebase accepted stale pending bytes at the original receipt path" >&2
    exit 1
  fi
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$recutover_bundle/plan.json")")" == "$completed_rebase_cursor_sha" ]] || {
    echo "original-path stale pending replay changed the completed rebase cursor" >&2
    exit 1
  }
  chmod 0600 "$rebase_receipt"
  cp "$saved_rebase_receipt" "$rebase_receipt"
  chmod 0400 "$rebase_receipt"
  [[ "$(sha256_file "$rebase_receipt")" == "$completed_rebase_receipt_sha" ]] || {
    echo "failed to restore the exact finalized rebase receipt" >&2
    exit 1
  }
  verify_rebase_ready_cursor "$(jq -r '.chain_cursor' "$recutover_bundle/plan.json")" \
    "$recutover_bundle/plan.json" "$(jq -r '.predecessor_sequence' "$rebase_receipt")" \
    "$second_rollback_receipt" "$(sha256_file "$second_rollback_receipt")"

  fork_rebase_receipt="$root/fork-rebase.json"
  if rebase_after_rollback "$fork_bundle" "$second_rollback_receipt" "$fork_rebase_receipt" true >/dev/null 2>&1; then
    echo "a forked recutover plan rebased after the CAS epoch advanced" >&2
    exit 1
  fi
  [[ ! -e "$fork_rebase_receipt" ]] || { echo "fork rejection reserved a receipt" >&2; exit 1; }

  # A rebase is deliberately reversible through a controlled superseding
  # epoch. Source drift after the epoch-2 cursor commit must not deadlock the
  # chain on evidence that can no longer pass freshness verification.
  printf 'drift-after-rebase\n' >>"$legacy_state/runtime-v2/runtime-state.json"
  stale_after_rebase="$root/stale-after-rebase.json"
  if transition recutover "$recutover_bundle" "$second_rollback_receipt" "$stale_after_rebase" true test >/dev/null 2>&1; then
    echo "recutover accepted source drift after a committed rebase" >&2
    exit 1
  fi
  [[ ! -e "$stale_after_rebase" ]] || { echo "stale post-rebase evidence reserved a receipt" >&2; exit 1; }
  IFS=$'\t' read -r release3 snapshot3 canary3 soak3 \
    < <(self_test_create_v2_evidence "$materializer" "$fixture_binary" "$legacy_state" "$root" epoch3 "$second_rollback_receipt")
  bundle3="$root/bridge-recutover-epoch3"
  prepare_recutover_bundle "$release3/manifest.json" "$launch_root" "$bundle3" \
    "$snapshot3" "$canary3" "$soak3" "$recutover_bundle" "$second_rollback_receipt" >/dev/null
  jq -e '.epoch == 3 and .parent_epoch == 2 and .supersedes_unapplied_epoch == true' "$bundle3/plan.json" >/dev/null
  parent_rebase_saved="$root/rebase-parent-before-supersede.saved"
  supersede_cursor_saved="$root/rebase-cursor-before-supersede.saved"
  cp "$rebase_receipt" "$parent_rebase_saved"
  cp "$(jq -r '.chain_cursor' "$bundle3/plan.json")" "$supersede_cursor_saved"
  chmod 0400 "$parent_rebase_saved" "$supersede_cursor_saved"
  supersede_cursor_sha="$(sha256_file "$supersede_cursor_saved")"

  deleted_parent_apply="$root/rebase-epoch3-deleted-parent.json"
  rm -f "$rebase_receipt"
  if rebase_after_rollback "$bundle3" "$second_rollback_receipt" "$deleted_parent_apply" true >/dev/null 2>&1; then
    echo "superseding epoch applied after its parent rebase receipt was deleted" >&2
    exit 1
  fi
  [[ ! -e "$deleted_parent_apply" && ! -L "$deleted_parent_apply" ]] || {
    echo "deleted parent rebase rejection reserved an output receipt" >&2
    exit 1
  }
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$bundle3/plan.json")")" == "$supersede_cursor_sha" ]] || {
    echo "deleted parent rebase rejection changed the chain cursor" >&2
    exit 1
  }
  cp "$parent_rebase_saved" "$rebase_receipt"
  chmod 0400 "$rebase_receipt"

  tampered_parent_apply="$root/rebase-epoch3-tampered-parent.json"
  chmod 0600 "$rebase_receipt"
  jq '.rebased_at = "1970-01-01T00:00:00Z"' "$parent_rebase_saved" >"$rebase_receipt"
  chmod 0400 "$rebase_receipt"
  if rebase_after_rollback "$bundle3" "$second_rollback_receipt" "$tampered_parent_apply" true >/dev/null 2>&1; then
    echo "superseding epoch applied after its parent rebase receipt was modified" >&2
    exit 1
  fi
  [[ ! -e "$tampered_parent_apply" && ! -L "$tampered_parent_apply" ]] || {
    echo "modified parent rebase rejection reserved an output receipt" >&2
    exit 1
  }
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$bundle3/plan.json")")" == "$supersede_cursor_sha" ]] || {
    echo "modified parent rebase rejection changed the chain cursor" >&2
    exit 1
  }
  chmod 0600 "$rebase_receipt"
  cp "$parent_rebase_saved" "$rebase_receipt"
  chmod 0400 "$rebase_receipt"

  downgraded_cursor_apply="$root/rebase-epoch3-downgraded-cursor.json"
  chmod 0600 "$(jq -r '.chain_cursor' "$bundle3/plan.json")"
  jq --arg receipt "$second_rollback_receipt" --arg receipt_sha "$(sha256_file "$second_rollback_receipt")" '
    del(.rebase_receipt,.rebase_receipt_sha256,.rebase_pending_receipt,
      .rebase_pending_receipt_sha256,.rebase_pending_cursor_sha256,
      .rebase_prior_cursor_sha256,.rebase_receipt_finalized)
    | .transition_receipt = $receipt
    | .transition_receipt_sha256 = $receipt_sha
    | .transition_receipt_finalized = true
  ' "$supersede_cursor_saved" >"$(jq -r '.chain_cursor' "$bundle3/plan.json")"
  chmod 0400 "$(jq -r '.chain_cursor' "$bundle3/plan.json")"
  downgraded_cursor_sha="$(sha256_file "$(jq -r '.chain_cursor' "$bundle3/plan.json")")"
  if rebase_after_rollback "$bundle3" "$second_rollback_receipt" "$downgraded_cursor_apply" true >/dev/null 2>&1; then
    echo "superseding epoch accepted a cursor with downgraded rebase provenance" >&2
    exit 1
  fi
  [[ ! -e "$downgraded_cursor_apply" && ! -L "$downgraded_cursor_apply" ]] || {
    echo "downgraded cursor rejection reserved an output receipt" >&2
    exit 1
  }
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$bundle3/plan.json")")" == "$downgraded_cursor_sha" ]] || {
    echo "downgraded cursor rejection changed the chain cursor" >&2
    exit 1
  }
  chmod 0600 "$(jq -r '.chain_cursor' "$bundle3/plan.json")"
  cp "$supersede_cursor_saved" "$(jq -r '.chain_cursor' "$bundle3/plan.json")"
  chmod 0400 "$(jq -r '.chain_cursor' "$bundle3/plan.json")"
  [[ "$(sha256_file "$rebase_receipt")" == "$(sha256_file "$parent_rebase_saved")" \
    && "$(sha256_file "$(jq -r '.chain_cursor' "$bundle3/plan.json")")" == "$supersede_cursor_sha" ]] || {
    echo "failed to restore exact superseding-epoch parent provenance" >&2
    exit 1
  }
  rebase3="$root/rebase-epoch3.json"
  if HEPTA_BRIDGE_SELF_TEST_FAIL_AFTER_REBASE_RECEIPT_FINALIZED=1 \
    rebase_after_rollback "$bundle3" "$second_rollback_receipt" "$rebase3" true >/dev/null 2>&1; then
    echo "superseding-epoch rebase cursor-finalization interruption unexpectedly passed" >&2
    exit 1
  fi
  jq -e '.schema == "hepta_vnext_launchd_bridge_rebase_v2"
    and .chain_rebase_committed == true' "$rebase3" >/dev/null
  jq -e '.rebase_receipt_finalized == false' \
    "$(jq -r '.chain_cursor' "$bundle3/plan.json")" >/dev/null
  recover_pending "$bundle3" "$rebase3" true test >/dev/null
  jq -e '.rebase_receipt_finalized == true' \
    "$(jq -r '.chain_cursor' "$bundle3/plan.json")" >/dev/null
  recutover3="$root/recutover-epoch3.json"; rollback3="$root/rollback-epoch3.json"
  transition recutover "$bundle3" "$second_rollback_receipt" "$recutover3" true test >/dev/null
  transition rollback "$bundle3" "$recutover3" "$rollback3" true test >/dev/null

  # A later recutover pending recovery may restart the legacy process and
  # create or retimestamp SQLite SHM. The recovered epoch remains safely
  # supersedable with a new snapshot/canary set and no cursor surgery.
  printf 'post-epoch3-rollback-write\n' >>"$legacy_state/runtime-v2/runtime-state.json"
  IFS=$'\t' read -r release4 snapshot4 canary4 soak4 \
    < <(self_test_create_v2_evidence "$materializer" "$fixture_binary" "$legacy_state" "$root" epoch4 "$rollback3")
  bundle4="$root/bridge-recutover-epoch4"
  prepare_recutover_bundle "$release4/manifest.json" "$launch_root" "$bundle4" \
    "$snapshot4" "$canary4" "$soak4" "$bundle3" "$rollback3" >/dev/null
  jq -e '.epoch == 4 and .parent_epoch == 3 and .supersedes_unapplied_epoch == false' "$bundle4/plan.json" >/dev/null
  rebase4="$root/rebase-epoch4.json"
  rebase_after_rollback "$bundle4" "$rollback3" "$rebase4" true >/dev/null
  rebase4_cursor_sha="$(sha256_file "$(jq -r '.chain_cursor' "$bundle4/plan.json")")"
  v2_pending_receipt="$root/v2-recutover-pending.json"
  if HEPTA_BRIDGE_SELF_TEST_FAIL_AFTER_GATEWAY_PUBLISH=1 \
    transition recutover "$bundle4" "$rollback3" "$v2_pending_receipt" true test >/dev/null 2>&1; then
    echo "injected v2 recutover interruption unexpectedly passed" >&2
    exit 1
  fi
  jq -e '.schema == "hepta_vnext_launchd_bridge_transition_pending_v2"
    and .status == "pending" and .epoch == 4
    and .source_generation == "legacy" and .target_generation == "vnext"
    and .source_health_path == "/health" and .target_health_path == "/healthz"' \
    "$v2_pending_receipt" >/dev/null
  v2_pending_saved="$root/v2-recutover-pending.saved"
  v2_pending_tampered="$root/v2-recutover-pending.tampered"
  cp "$v2_pending_receipt" "$v2_pending_saved"
  chmod 0400 "$v2_pending_saved"
  v2_pending_original_sha="$(sha256_file "$v2_pending_saved")"
  v2_pending_cursor_sha="$(sha256_file "$(jq -r '.chain_cursor' "$bundle4/plan.json")")"
  v2_pending_gateway_sha="$(sha256_file "$launch_root/ai.hepta.gateway.plist")"
  v2_pending_watchdog_sha="$(sha256_file "$launch_root/ai.hepta.installed-live-watchdog.plist")"
  for tamper_mode in missing swapped; do
    if [[ "$tamper_mode" == missing ]]; then
      jq 'del(.source_health_path)' "$v2_pending_saved" >"$v2_pending_tampered"
    else
      jq '.source_health_path = "/healthz" | .target_health_path = "/health"' \
        "$v2_pending_saved" >"$v2_pending_tampered"
    fi
    chmod 0600 "$v2_pending_receipt"
    cp "$v2_pending_tampered" "$v2_pending_receipt"
    chmod 0400 "$v2_pending_receipt"
    if recover_pending "$bundle4" "$v2_pending_receipt" true test >/dev/null 2>&1; then
      echo "v2 pending recovery accepted $tamper_mode generation health fields" >&2
      exit 1
    fi
    [[ "$(sha256_file "$(jq -r '.chain_cursor' "$bundle4/plan.json")")" == "$v2_pending_cursor_sha" \
      && "$(sha256_file "$launch_root/ai.hepta.gateway.plist")" == "$v2_pending_gateway_sha" \
      && "$(sha256_file "$launch_root/ai.hepta.installed-live-watchdog.plist")" == "$v2_pending_watchdog_sha" ]] || {
      echo "rejected v2 pending health tamper changed cursor or service pair" >&2
      exit 1
    }
  done
  chmod 0600 "$v2_pending_receipt"
  cp "$v2_pending_saved" "$v2_pending_receipt"
  chmod 0400 "$v2_pending_receipt"
  [[ "$(sha256_file "$v2_pending_receipt")" == "$v2_pending_original_sha" ]] || {
    echo "failed to restore the exact v2 pending receipt after health tamper tests" >&2
    exit 1
  }
  recover_pending "$bundle4" "$v2_pending_receipt" true test >/dev/null
  jq -e '.schema == "hepta_vnext_launchd_bridge_pending_recovery_v2"
    and .source_service_pair_restored == true and .chain_head_restored == true
    and .exact_prior_cursor_restored == true
    and .restored_generation == "legacy" and .restored_health_path == "/health"
    and .restored_health_verified == true' "$v2_pending_receipt" >/dev/null
  [[ "$(sha256_file "$(jq -r '.chain_cursor' "$bundle4/plan.json")")" == "$rebase4_cursor_sha" ]] || {
    echo "v2 recutover pending recovery did not restore byte-exact rebase provenance" >&2
    exit 1
  }
  verify_rebase_ready_cursor "$(jq -r '.chain_cursor' "$bundle4/plan.json")" \
    "$bundle4/plan.json" "$(jq -r '.predecessor_sequence' "$rebase4")" \
    "$rollback3" "$(sha256_file "$rollback3")"
  : >"$legacy_state/runtime-v2/outcomes.sqlite3-shm"
  chmod 0600 "$legacy_state/runtime-v2/outcomes.sqlite3-shm"
  stale_after_recovery="$root/stale-after-pending-recovery.json"
  if transition recutover "$bundle4" "$rollback3" "$stale_after_recovery" true test >/dev/null 2>&1; then
    echo "recutover reused evidence after pending recovery SHM metadata drift" >&2
    exit 1
  fi
  [[ ! -e "$stale_after_recovery" ]] || { echo "stale post-recovery evidence reserved a receipt" >&2; exit 1; }
  IFS=$'\t' read -r release5 snapshot5 canary5 soak5 \
    < <(self_test_create_v2_evidence "$materializer" "$fixture_binary" "$legacy_state" "$root" epoch5 "$rollback3")
  bundle5="$root/bridge-recutover-epoch5"
  prepare_recutover_bundle "$release5/manifest.json" "$launch_root" "$bundle5" \
    "$snapshot5" "$canary5" "$soak5" "$bundle4" "$rollback3" >/dev/null
  jq -e '.epoch == 5 and .parent_epoch == 4 and .supersedes_unapplied_epoch == true' "$bundle5/plan.json" >/dev/null
  rebase5="$root/rebase-epoch5.json"
  rebase_after_rollback "$bundle5" "$rollback3" "$rebase5" true >/dev/null
  v2_recutover_receipt="$root/v2-recutover.json"; v2_rollback_receipt="$root/v2-rollback.json"
  transition recutover "$bundle5" "$rollback3" "$v2_recutover_receipt" true test >/dev/null
  jq -e '.schema == "hepta_vnext_launchd_bridge_transition_v2"
    and .epoch == 5 and .transition == "recutover"
    and .source_generation == "legacy" and .target_generation == "vnext"
    and .source_health_path == "/health" and .target_health_path == "/healthz"
    and .post_transition_health_path == "/healthz" and .post_transition_health_verified == true' \
    "$v2_recutover_receipt" >/dev/null
  transition rollback "$bundle5" "$v2_recutover_receipt" "$v2_rollback_receipt" true test >/dev/null
  jq -e '.schema == "hepta_vnext_launchd_bridge_transition_v2"
    and .epoch == 5 and .transition == "rollback"
    and .source_generation == "vnext" and .target_generation == "legacy"
    and .source_health_path == "/healthz" and .target_health_path == "/health"
    and .post_transition_health_path == "/health" and .post_transition_health_verified == true' \
    "$v2_rollback_receipt" >/dev/null
  v2_final_missing_health="$root/v2-rollback-missing-health.json"
  v2_final_swapped_health="$root/v2-rollback-swapped-health.json"
  jq 'del(.post_transition_health_path)' "$v2_rollback_receipt" >"$v2_final_missing_health"
  jq '.source_health_path = "/health" | .target_health_path = "/healthz"
    | .post_transition_health_path = "/healthz"' \
    "$v2_rollback_receipt" >"$v2_final_swapped_health"
  chmod 0400 "$v2_final_missing_health" "$v2_final_swapped_health"
  v2_final_original_sha="$(sha256_file "$v2_rollback_receipt")"
  v2_final_cursor_sha="$(sha256_file "$(jq -r '.chain_cursor' "$bundle5/plan.json")")"
  v2_final_gateway_sha="$(sha256_file "$launch_root/ai.hepta.gateway.plist")"
  v2_final_watchdog_sha="$(sha256_file "$launch_root/ai.hepta.installed-live-watchdog.plist")"
  for tampered_receipt in "$v2_final_missing_health" "$v2_final_swapped_health"; do
    if verify_previous_receipt "$tampered_receipt" rollback \
      "$(sha256_file "$bundle5/plan.json")" legacy "$bundle5/plan.json" \
      "$(jq -r '.chain_cursor' "$bundle5/plan.json")" >/dev/null 2>&1; then
      echo "v2 rollback verifier accepted tampered generation health fields" >&2
      exit 1
    fi
    [[ "$(sha256_file "$v2_rollback_receipt")" == "$v2_final_original_sha" \
      && "$(sha256_file "$(jq -r '.chain_cursor' "$bundle5/plan.json")")" == "$v2_final_cursor_sha" \
      && "$(sha256_file "$launch_root/ai.hepta.gateway.plist")" == "$v2_final_gateway_sha" \
      && "$(sha256_file "$launch_root/ai.hepta.installed-live-watchdog.plist")" == "$v2_final_watchdog_sha" ]] || {
      echo "rejected v2 final health tamper changed receipt, cursor, or service pair" >&2
      exit 1
    }
  done
  stale_v2_receipt="$root/stale-v2-predecessor.json"
  if transition recutover "$bundle5" "$rollback3" "$stale_v2_receipt" true test >/dev/null 2>&1; then
    echo "v2 recutover accepted a stale parent-epoch predecessor" >&2
    exit 1
  fi
  [[ ! -e "$stale_v2_receipt" ]] || { echo "stale v2 predecessor reserved a receipt" >&2; exit 1; }

  [[ "$(sha256_file "$launch_root/ai.hepta.gateway.plist")" == "$(jq -r '.legacy.gateway.sha256' "$bundle/plan.json")" ]] || {
    echo "receipt preflight failure changed the service generation" >&2
    exit 1
  }
  jq -cn --arg plan_sha256 "$(sha256_file "$bundle/plan.json")" \
    --arg cutover_receipt_sha256 "$(sha256_file "$cutover_receipt")" \
    --arg rollback_receipt_sha256 "$(sha256_file "$rollback_receipt")" \
    --arg recutover_receipt_sha256 "$(sha256_file "$recutover_receipt")" \
    --arg second_rollback_receipt_sha256 "$(sha256_file "$second_rollback_receipt")" \
    --arg v2_plan_sha256 "$(sha256_file "$bundle5/plan.json")" \
    --arg v2_recutover_receipt_sha256 "$(sha256_file "$v2_recutover_receipt")" \
    --arg v2_rollback_receipt_sha256 "$(sha256_file "$v2_rollback_receipt")" \
    '{schema:"hepta_vnext_launchd_bridge_self_test_v2",status:"ready",plan_sha256:$plan_sha256,v2_plan_sha256:$v2_plan_sha256,cutover_receipt_sha256:$cutover_receipt_sha256,rollback_receipt_sha256:$rollback_receipt_sha256,recutover_receipt_sha256:$recutover_receipt_sha256,second_rollback_receipt_sha256:$second_rollback_receipt_sha256,v2_recutover_receipt_sha256:$v2_recutover_receipt_sha256,v2_rollback_receipt_sha256:$v2_rollback_receipt_sha256,cutover:true,rollback:true,recutover:true,post_recutover_rollback:true,generation_specific_health_routes:true,legacy_health_route_verified:true,vnext_health_route_verified:true,health_failure_source_restored:true,health_paths_recorded_in_transition_receipts:true,health_paths_recorded_in_recovery_receipts:true,fresh_full_state_snapshot:true,snapshot_v3_mode_profile_bound:true,snapshot_v3_acl_profile_bound:true,bridge_bundle_typed_closed_world:true,bridge_directories_0500_files_0400:true,bridge_regular_nlink_one:true,bridge_extra_directory_rejected:true,bridge_fifo_rejected:true,bridge_external_hardlink_rejected:true,bridge_file_and_directory_acl_rejected:true,bridge_xattr_rejected:true,bridge_unreadable_xattr_rejected:true,bridge_bsd_flags_rejected:true,v1_evidence_downgrade_rejected_for_v3_release:true,v2_evidence_downgrade_rejected_for_v3_release:true,new_epoch_recutover:true,controlled_epoch_supersede:true,recutover_predecessor_receipt_sha_plan_sequence_exact:true,created_at_informational_not_freshness:true,supersede_deleted_parent_rebase_rejected:true,supersede_tampered_parent_rebase_rejected:true,supersede_downgraded_cursor_rejected:true,supersede_rejection_cursor_unchanged:true,post_rebase_source_drift_recovered_with_fresh_epoch:true,pending_recovery_shm_drift_recovered_with_fresh_epoch:true,no_manual_cursor_mutation:true,wrong_predecessor_rejected:true,stale_predecessor_rejected:true,fork_rejected:true,cross_plan_cas_enforced:true,rebase_pending_recovery_sealed:true,rebase_replace_failure_restores_exact_cursor:true,pre_cas_pending_recovery_sealed:true,pre_cas_pending_copy_rejected:true,pre_cas_embedded_cursor_tamper_rejected:true,rebase_finalization_crash_recovered:true,rebase_finalization_recovery_idempotent:true,completed_rebase_stale_pending_rejected:true,completed_rebase_copied_pending_rejected:true,completed_rebase_modified_pending_rejected:true,completed_rebase_cursor_unchanged_on_replay:true,post_rebase_sibling_epoch_rejected:true,transition_pending_recovery_sealed:true,transition_finalization_crash_recovered:true,transition_finalization_recovery_idempotent:true,completed_transition_stale_pending_rejected:true,completed_transition_copied_pending_rejected:true,completed_transition_cursor_unchanged_on_replay:true,v2_recutover_pending_exact_cursor_restored:true,evidence_bound:true,manifest_mismatch_rejected:true,snapshot_source_freshness_enforced:true,mixed_publish_restored:true,pending_receipt_fail_closed:true,pending_recovery_sealed:true,global_operation_lock_enforced:true,shared_generation_lock_enforced:true,dry_run_log_directories_unchanged:true,private_log_directories_ready:true,existing_log_directories_hardened:true,symlink_log_root_rejected:true,symlink_log_child_rejected:true,stale_chain_head_rejected:true,preexisting_receipt_rejected:true,direct_production_install_rejected:true,legacy_authority_reclassified:false,production_changed:false}'
}

command="${1:-}"; [[ -n "$command" ]] || usage; shift
manifest=""; launch_root=""; bundle=""; parent_bundle=""; previous_receipt=""; pending_receipt=""; output_receipt=""; snapshot_receipt=""; canary_receipt=""; soak_receipt=""; apply=false
while (( $# > 0 )); do
  case "$1" in
    --manifest) shift; [[ $# -gt 0 ]] || usage; manifest="$1" ;;
    --launch-agent-root) shift; [[ $# -gt 0 ]] || usage; launch_root="$1" ;;
    --bundle) shift; [[ $# -gt 0 ]] || usage; bundle="$1" ;;
    --parent-bundle) shift; [[ $# -gt 0 ]] || usage; parent_bundle="$1" ;;
    --previous-receipt) shift; [[ $# -gt 0 ]] || usage; previous_receipt="$1" ;;
    --pending-receipt) shift; [[ $# -gt 0 ]] || usage; pending_receipt="$1" ;;
    --output-receipt) shift; [[ $# -gt 0 ]] || usage; output_receipt="$1" ;;
    --snapshot-receipt) shift; [[ $# -gt 0 ]] || usage; snapshot_receipt="$1" ;;
    --canary-receipt) shift; [[ $# -gt 0 ]] || usage; canary_receipt="$1" ;;
    --soak-receipt) shift; [[ $# -gt 0 ]] || usage; soak_receipt="$1" ;;
    --apply) apply=true ;;
    *) usage ;;
  esac
  shift
done
case "$command" in
  prepare) [[ -n "$manifest" && -n "$launch_root" && -n "$bundle" && -n "$snapshot_receipt" && -n "$canary_receipt" && -n "$soak_receipt" && -z "$parent_bundle$previous_receipt$pending_receipt$output_receipt" && "$apply" == false ]] || usage; prepare_bundle "$manifest" "$launch_root" "$bundle" "$snapshot_receipt" "$canary_receipt" "$soak_receipt" ;;
  prepare-recutover) [[ -n "$manifest" && -n "$launch_root" && -n "$bundle" && -n "$parent_bundle" && -n "$previous_receipt" && -n "$snapshot_receipt" && -n "$canary_receipt" && -n "$soak_receipt" && -z "$pending_receipt$output_receipt" && "$apply" == false ]] || usage; prepare_recutover_bundle "$manifest" "$launch_root" "$bundle" "$snapshot_receipt" "$canary_receipt" "$soak_receipt" "$parent_bundle" "$previous_receipt" ;;
  rebase-after-rollback) [[ -n "$bundle" && -n "$previous_receipt" && -z "$manifest$launch_root$parent_bundle$pending_receipt$snapshot_receipt$canary_receipt$soak_receipt" ]] || usage; rebase_after_rollback "$bundle" "$previous_receipt" "$output_receipt" "$apply" ;;
  cutover|rollback|recutover) [[ -n "$bundle" && -z "$manifest$launch_root$parent_bundle$pending_receipt$snapshot_receipt$canary_receipt$soak_receipt" ]] || usage; transition "$command" "$bundle" "$previous_receipt" "$output_receipt" "$apply" launchctl ;;
  recover-pending) [[ -n "$bundle" && -n "$pending_receipt" && -z "$manifest$launch_root$parent_bundle$previous_receipt$output_receipt$snapshot_receipt$canary_receipt$soak_receipt" ]] || usage; recover_pending "$bundle" "$pending_receipt" "$apply" launchctl ;;
  self-test) [[ -z "$manifest$launch_root$bundle$parent_bundle$previous_receipt$pending_receipt$output_receipt$snapshot_receipt$canary_receipt$soak_receipt" && "$apply" == false ]] || usage; self_test ;;
  *) usage ;;
esac
