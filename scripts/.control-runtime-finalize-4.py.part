      source-and-process-recovery:
        strategy:
          fail-fast: false
          matrix:
            os: [ubuntu-24.04, macos-14]
        runs-on: __MATRIX_OS_EXPRESSION__
        timeout-minutes: 75
        steps:
          - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
            with:
              ref: __CHECKOUT_REF_EXPRESSION__
              fetch-depth: 1
              persist-credentials: false

          - name: Record immutable candidate identity
            shell: bash
            run: |
              set -euo pipefail
              evidence="$RUNNER_TEMP/control-runtime-recovery-evidence"
              mkdir -p "$evidence"
              git rev-parse HEAD > "$evidence/commit.txt"
              git rev-parse HEAD^{tree} > "$evidence/tree.txt"
              rustc --version > "$evidence/rustc.txt"
              cargo --version > "$evidence/cargo.txt"
              printf '%s\n' "$RUNNER_OS" > "$evidence/runner-os.txt"
              printf '%s\n' "$RUNNER_ARCH" > "$evidence/runner-arch.txt"

          - name: Install Linux native prerequisites
            if: runner.os == 'Linux'
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential pkg-config libcap-dev

          - name: Canonical state validation
            run: python3 scripts/control_runtime_validate_state.py --output "$RUNNER_TEMP/control-runtime-recovery-evidence/state.json"

          - name: Formatting
            working-directory: codex-rs
            run: cargo fmt -p codex-hepta-control-plane -- --check

          - name: Full control-plane regression suite
            working-directory: codex-rs
            run: cargo test --locked -p codex-hepta-control-plane

          - name: Abnormal process and restore regressions
            working-directory: codex-rs
            run: cargo test --locked -p codex-hepta-control-plane --test planner_store_process_recovery -- --nocapture

          - name: Durable execution hardening regressions
            working-directory: codex-rs
            run: cargo test --locked -p codex-hepta-control-plane --test planner_durable_hardening -- --nocapture

          - name: Fanout evidence and continuation regressions
            working-directory: codex-rs
            run: cargo test --locked -p codex-hepta-control-plane --test organ_fanout_receipts -- --nocapture

          - name: All-target compilation
            working-directory: codex-rs
            run: cargo check --locked --all-targets -p codex-hepta-control-plane

          - name: Strict lint
            working-directory: codex-rs
            run: cargo clippy --locked --all-targets -p codex-hepta-control-plane -- -D warnings

          - name: Preserve exact recovery evidence
            if: always()
            uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
            with:
              name: control-runtime-recovery-__ARTIFACT_SHA_EXPRESSION__-__MATRIX_NAME_EXPRESSION__
              path: __ARTIFACT_PATH_EXPRESSION__
              if-no-files-found: error
              retention-days: 30
    """
)
expression_open = "$" + "{{"
workflow = (
    workflow.replace(
        "__GROUP_EXPRESSION__",
        expression_open + " github.event.pull_request.number || github.ref }}",
    )
    .replace(
        "__MATRIX_OS_EXPRESSION__",
        expression_open + " matrix.os }}",
    )
    .replace(
        "__CHECKOUT_REF_EXPRESSION__",
        expression_open + " github.event.pull_request.head.sha || github.sha }}",
    )
    .replace(
        "__ARTIFACT_SHA_EXPRESSION__",
        expression_open + " github.event.pull_request.head.sha || github.sha }}",
    )
    .replace(
        "__MATRIX_NAME_EXPRESSION__",
        expression_open + " matrix.os }}",
    )
    .replace(
        "__ARTIFACT_PATH_EXPRESSION__",
        expression_open + " runner.temp }}/control-runtime-recovery-evidence",
    )
)
Path(".github/workflows/control-runtime-crash-recovery.yml").write_text(
    workflow,
    encoding="utf-8",
)
Path(".github/workflows/control-runtime-apply-rustfmt.yml").unlink()
for fragment in (
    "scripts/.control-runtime-finalize-1.py.part",
    "scripts/.control-runtime-finalize-2.py.part",
    "scripts/.control-runtime-finalize-3.py.part",
    "scripts/.control-runtime-finalize-4.py.part",
):
    Path(fragment).unlink()
