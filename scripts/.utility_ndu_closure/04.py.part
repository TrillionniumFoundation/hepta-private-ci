trait_code = """
trait MustInvariant<T> {
    fn must(self, context: &str) -> T;
}

impl<T, E: std::fmt::Debug> MustInvariant<T> for Result<T, E> {
    fn must(self, context: &str) -> T {
        match self {
            Ok(value) => value,
            Err(error) => panic!("{context}: {error:?}"),
        }
    }
}

impl<T> MustInvariant<T> for Option<T> {
    fn must(self, context: &str) -> T {
        match self {
            Some(value) => value,
            None => panic!("{context}"),
        }
    }
}

"""
