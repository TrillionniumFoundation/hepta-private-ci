        '067gNazXdb5F8bJzW9MIDpMyL7RfGadnL4mFGZx2yV8JxIO3s9TGiPVl0k3dnXkTcLSDd1iD9R0WZmu8fULUrfLVcqNlX0s7noBm'
        'NEjxPD4Q0km1I1FVMiY2TTwlJQoAHe1mcSUXtxtzT1DWY1tnAICFpcVz2wRIueB6tluCUZ7dItz5Cot9iZG6zcvvY7xL3NcKg0xL'
        'TjqdDkDrvII79SjF225KveoK3d4cXq/AVvkIdOK7u/Bu53+poNEO'
    ),
}


def main() -> None:
    for relative, encoded in PAYLOADS.items():
        target = ROOT / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(zlib.decompress(base64.b64decode(encoded)))

    quickstart = ROOT / "docs/modules/learning.plasticity/DEVELOPER_QUICKSTART.md"
    quickstart_text = quickstart.read_text(encoding="utf-8")
    marker = (
        "`OPERATIONS.md`; it does not replace their authority, persistence or deployment\n"
        "requirements.\n\n"
        "The module is proposal-only."
    )
    replacement = (
        "`OPERATIONS.md`; it does not replace their authority, persistence or deployment\n"
        "requirements. Runtime quota, cache, shutdown and crash-recovery invariants are\n"
        "specified in [RUNTIME_RESOURCE_RECOVERY.md](RUNTIME_RESOURCE_RECOVERY.md).\n\n"
        "The module is proposal-only."
    )
    if "RUNTIME_RESOURCE_RECOVERY.md" not in quickstart_text:
        if marker not in quickstart_text:
            raise RuntimeError("developer quickstart marker changed")
        quickstart.write_text(quickstart_text.replace(marker, replacement, 1), encoding="utf-8")


if __name__ == "__main__":
    main()
