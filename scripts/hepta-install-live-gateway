#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: hepta-install-live-gateway --manifest PATH [--launch-agent-root DIR] [--archive-root DIR] [--install]

Without --install, prints the exact plan. --install atomically installs and
loads only the manifest-bound gateway label; it does not alter state or a
generation pointer.
EOF
  exit 64
}

sha256_file() { shasum -a 256 "$1" | awk '{print $1}'; }
absolute_non_root() {
  [[ "$1" == /* \
    && "$1" != "/" \
    && "$1" != */ \
    && "$1" != *"//"* \
    && "$1" != *"/../"* \
    && "$1" != *"/./"* \
    && "$1" != */.. \
    && "$1" != */. ]] || {
    echo "path must be absolute, normalized, and non-root: $1" >&2
    exit 1
  }
}

manifest=""; launch_agent_root="$HOME/Library/LaunchAgents"; archive_root=""; install_job=false
while (( $# > 0 )); do
  case "$1" in
    --manifest) shift; [[ $# -gt 0 ]] || usage; manifest="$1" ;;
    --launch-agent-root) shift; [[ $# -gt 0 ]] || usage; launch_agent_root="$1" ;;
    --archive-root) shift; [[ $# -gt 0 ]] || usage; archive_root="$1" ;;
    --install) install_job=true ;;
    *) usage ;;
  esac
  shift
done
[[ -n "$manifest" ]] || usage
manifest="$(realpath "$manifest")"
release="$(dirname "$manifest")"
verify_relative="$(jq -r '.watchdog.verify_tool' "$manifest")"
[[ "$verify_relative" == "scripts/hepta-immutable-release-tree" ]] || {
  echo "manifest declares an unsupported verifier" >&2
  exit 1
}
verifier="$release/$verify_relative"
"$verifier" verify --manifest "$manifest" >/dev/null
label="$(jq -r '.gateway_launch_agent.label' "$manifest")"
relative="$(jq -r '.gateway_launch_agent.relative_path' "$manifest")"
expected_sha="$(jq -r '.gateway_launch_agent.sha256' "$manifest")"
state_root="$(jq -r '.runtime.state_root' "$manifest")"
install_root="$(jq -r '.runtime.install_root' "$manifest")"
listen_port="$(jq -r '.runtime.listen_port' "$manifest")"
[[ "$label" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$relative" == "launchd/$label.plist" ]] || {
  echo "manifest contains an invalid gateway LaunchAgent binding" >&2
  exit 1
}
absolute_non_root "$state_root"
absolute_non_root "$install_root"
absolute_non_root "$launch_agent_root"
template="$release/$relative"
target="$launch_agent_root/$label.plist"
archive_root="${archive_root:-$state_root/archive/launchagents}"
absolute_non_root "$archive_root"
[[ -f "$template" && ! -L "$template" && "$(sha256_file "$template")" == "$expected_sha" ]] || {
  echo "gateway LaunchAgent template differs from manifest" >&2
  exit 1
}
plutil -lint "$template" >/dev/null

duplicates=0
if [[ -d "$launch_agent_root" ]]; then
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    if [[ "$(plutil -extract Label raw -o - "$candidate" 2>/dev/null || true)" == "$label" && "$candidate" != "$target" ]]; then
      duplicates=$((duplicates + 1))
    fi
  done < <(find "$launch_agent_root" -maxdepth 1 -type f -name '*.plist' -print | LC_ALL=C sort)
fi
[[ "$duplicates" -eq 0 ]] || {
  echo "another loadable plist already owns gateway label $label" >&2
  exit 1
}

archived=""; loaded=false
if [[ "$install_job" == "true" ]]; then
  if [[ "$listen_port" == 7373 || "$label" == ai.hepta.gateway ]]; then
    echo "production-compatible gateway installation is allowed only through hepta-launchd-cutover-bridge" >&2
    exit 1
  fi
  [[ -d "$state_root/runtime-v2" && ! -L "$state_root/runtime-v2" ]] || {
    echo "open-existing runtime root is missing: $state_root/runtime-v2" >&2
    exit 1
  }
  "$release/scripts/hepta-generation-pointer" verify \
    --install-root "$install_root" --manifest "$manifest" >/dev/null
  mkdir -p "$launch_agent_root" "$archive_root" "$install_root/logs/gateway"
  [[ "$(realpath "$archive_root")" != "$(realpath "$launch_agent_root")" ]] || {
    echo "LaunchAgent archive must remain outside LaunchAgents" >&2
    exit 1
  }
  if [[ ( -e "$target" || -L "$target" ) && "$(sha256_file "$target")" != "$expected_sha" ]]; then
    echo "existing gateway plist is a distinct generation; use hepta-launchd-cutover-bridge" >&2
    exit 1
  fi
  if [[ -e "$target" || -L "$target" ]]; then
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    archived="$archive_root/$label.plist.$timestamp.disabled"
    mv "$target" "$archived"
  fi
  staged="$(mktemp "$launch_agent_root/.$label.XXXXXX")"
  trap 'rm -f "$staged"' EXIT
  cp "$template" "$staged"
  chmod 0444 "$staged"
  plutil -lint "$staged" >/dev/null
  mv -f "$staged" "$target"
  trap - EXIT
  domain="gui/$(id -u)"
  launchctl bootout "$domain/$label" >/dev/null 2>&1 || true
  launchctl bootstrap "$domain" "$target"
  launchctl kickstart -k "$domain/$label"
  loaded=true
fi

jq -cn \
  --arg manifest "$manifest" \
  --arg label "$label" \
  --arg template "$template" \
  --arg target "$target" \
  --arg state_root "$state_root" \
  --arg install_root "$install_root" \
  --arg archived "$archived" \
  --argjson listen_port "$listen_port" \
  --argjson loaded "$loaded" \
  '{schema:"hepta_vnext_gateway_install_v1",status:"ready",manifest:$manifest,label:$label,template:$template,target:$target,state_root:$state_root,install_root:$install_root,listen_host:"127.0.0.1",listen_port:$listen_port,authority_all_closed:true,archived:(if $archived=="" then null else $archived end),loaded:$loaded,generation_changed:false}'
