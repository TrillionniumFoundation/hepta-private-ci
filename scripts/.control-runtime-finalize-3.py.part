    raise SystemExit("implementation map completion must be an object")
completion["pendingDispatchInventory"] = "source_candidate_boundary_uncomposed"
completion["pendingDispatchReconciliationDriver"] = (
    "source_candidate_boundary_uncomposed"
)
completion["organFanoutRecoveryCursor"] = "source_candidate_boundary_uncomposed"

gaps = implementation.get("repositoryControlledGaps")
if not isinstance(gaps, list):
    raise SystemExit("repositoryControlledGaps must be a list")
controlled_gaps = (
    "Compose the bounded pending-dispatch reconciliation driver through the product-owned exact request ledger and named effect owner without adding a redispatch path.",
    "Compose the DENY_ALL fanout continuation through a bounded product retry owner with downstream idempotency and backpressure; never reinterpret the cursor as replay authority.",
)
for gap in controlled_gaps:
    if gap not in gaps:
        gaps.append(gap)

source_objects = implementation.get("sourceObjects")
if not isinstance(source_objects, list):
    raise SystemExit("sourceObjects must be a list")
source_paths = {entry.get("path") for entry in source_objects}
for source_path in (
    "codex-rs/hepta-control-plane/src/planner_execution_identity.rs",
    "codex-rs/hepta-control-plane/src/planner_reconciliation_controller.rs",
    "codex-rs/hepta-control-plane/src/planner_reconciliation_controller_tests.rs",
):
    if source_path not in source_paths:
        source_objects.append({"path": source_path, "object": "pending"})

map_path.write_text(
    json.dumps(implementation, indent=2, ensure_ascii=False) + "\n",
    encoding="utf-8",
)

state_path = Path("docs/modules/control.runtime/CURRENT_STATE.json")
state = json.loads(state_path.read_text(encoding="utf-8"))
execution = state.get("subsystems", {}).get("authorityExecutionLoop")
if not isinstance(execution, dict):
    raise SystemExit("authorityExecutionLoop state is missing")
notes = execution.get("notes")
if not isinstance(notes, list):
    raise SystemExit("authorityExecutionLoop notes are missing")
notes[:] = [
    note
    for note in notes
    if "bounded DENY_ALL pending-dispatch page" not in note
    and "bounded reconciliation driver" not in note
]
notes.extend(
    [
        "A bounded DENY_ALL pending-dispatch page exposes unresolved claims in round-robin claim-sequence order without granting redispatch.",
        "A bounded reconciliation driver verifies a product-resolved request against the exact durable claim and invokes only effect-owner reconciliation; the production resolver, scheduler and effect-owner composition remain external gates.",
    ]
)
state_path.write_text(
    json.dumps(state, indent=2, ensure_ascii=False) + "\n",
    encoding="utf-8",
)

validator_path = Path("scripts/control_runtime_validate_state.py")
validator = validator_path.read_text(encoding="utf-8")
insertions = (
    (
        '    "reconcile_planner_request_v1",\n',
        '    "PlannerStoreV1::pending_dispatches_page",\n',
    ),
    (
        '    "PlannerStoreV1::pending_dispatches_page",\n',
        '    "reconcile_pending_dispatches_v1",\n',
    ),
    (
        '    "OrganHostV1::dispatch_once_with_receipt",\n',
        '    "OrganFanoutReceiptV1::continuation",\n',
    ),
)
for anchor, addition in insertions:
    if addition not in validator:
        if anchor not in validator:
            raise SystemExit(f"validator insertion anchor is missing: {anchor!r}")
        validator = validator.replace(anchor, anchor + addition, 1)
validator_path.write_text(validator, encoding="utf-8")

workflow = textwrap.dedent(
    """\
    name: control.runtime crash and recovery regression

    on:
      pull_request:
        branches: [main]
        paths:
          - 'codex-rs/hepta-control-plane/**'
          - 'docs/modules/control.runtime/**'
          - 'docs/readiness/CONTROL_RUNTIME_*.md'
          - 'scripts/control_runtime_validate_state.py'
          - '.github/workflows/control-runtime-crash-recovery.yml'
      workflow_dispatch:

    permissions:
      contents: read

    concurrency:
      group: control-runtime-crash-recovery-__GROUP_EXPRESSION__
      cancel-in-progress: true

    env:
      CARGO_INCREMENTAL: '0'
      CARGO_BUILD_JOBS: '2'
      CARGO_PROFILE_TEST_DEBUG: '0'
      CARGO_PROFILE_DEV_DEBUG: '0'

    jobs:
