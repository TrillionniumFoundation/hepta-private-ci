#!/usr/bin/python3
"""First Root deployment of one concrete protected secrets service instance.
prepare emits frozen config/keys/unit files, never starts services or reissues work.
Existing instances are verified in place; neither original DB nor key is replaced.
"""
import argparse,base64,hashlib,json,os,pwd,re,shutil,stat,subprocess,sys,time
from pathlib import Path
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
from cryptography.hazmat.primitives.serialization import Encoding,PublicFormat,PrivateFormat,NoEncryption

ROLES={'authority':(982,971),'operator':(981,970),'consumer':(983,972),'runtime':(992,976)}
AGENTS={986:'3ad2bb64-09ba-4811-b892-466c5fd952df',969:'10b204bc-ec72-48a2-a2c2-cf5d2f5ed730'}
PROVIDER=Path('/var/lib/hepta-secrets-runtime/provider-read.json')
TOKEN=Path('/var/lib/hepta-secrets-runtime/provider-token')
CA=Path('/var/lib/hepta-secrets-runtime/provider-ca.pem')
DEFAULT_ROOT=Path('/var/lib/hepta-secrets-product')
DEFAULT_CONFIG=Path('/etc/hepta-secrets')
DEFAULT_BACKING=Path('/data/.hepta-secrets-product/namespace')

def unique(items):
    result={}
    for key,value in items:
        if key in result:raise ValueError('duplicate configuration key')
        result[key]=value
    return result

def read(path):return json.loads(path.read_text(),object_pairs_hook=unique)
def check_file(path,uid,mode):
    s=path.lstat()
    if not stat.S_ISREG(s.st_mode) or s.st_nlink!=1 or s.st_uid!=uid or stat.S_IMODE(s.st_mode)!=mode:raise ValueError('unsafe protected file: '+str(path))
def revocation_head(path):
    check_file(path,0,0o640);protected_ancestors(path.parent)
    if path.stat().st_size>32768:raise ValueError('Root revocation head exceeds bound')
    head=read(path)
    if set(head)!={'authority_epoch','revision','revoked_grant_ids'}:raise ValueError('invalid Root revocation head fields')
    for field in ['authority_epoch','revision']:
        if type(head[field]) is not int or not 1<=head[field]<=2**64-1:raise ValueError('invalid Root revocation frontier')
    ids=head['revoked_grant_ids']
    if not isinstance(ids,list) or len(ids)>16384 or any(not isinstance(i,str) or not re.fullmatch(r'[A-Za-z0-9_.:/-]{1,128}',i) for i in ids) or ids!=sorted(set(ids)):raise ValueError('invalid Root revocation identifiers')
    return head
def protected_ancestors(path):
    for p in [path,*path.parents]:
        s=p.lstat()
        if not stat.S_ISDIR(s.st_mode) or s.st_uid!=0 or stat.S_IMODE(s.st_mode)&0o022:raise ValueError('unprotected canonical ancestor: '+str(p))
def mkdir(path,uid=0,gid=0,mode=0o755):
    path.mkdir();os.chown(path,uid,gid);os.chmod(path,mode)
def private_write(path,data,uid,gid,mode):
    with path.open('xb') as f:
        os.fchown(f.fileno(),uid,gid);os.fchmod(f.fileno(),mode);f.write(data);f.flush();os.fsync(f.fileno())
    fd=os.open(path.parent,os.O_DIRECTORY|os.O_RDONLY)
    try:os.fsync(fd)
    finally:os.close(fd)
def root_json(path,value,gid=976):private_write(path,json.dumps(value,separators=(',',':')).encode(),0,gid,0o640)
def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest()
def filesystem_uuid(path):
    return subprocess.check_output(['/usr/bin/findmnt','-n','--target',str(path),'-o','UUID'],text=True).strip()

# Only UID992 opens the existing token/CA/profile. RawToken stays in this child;
# its stdout is a private Root pipe, not an environment/file/log transport.
PROVIDER_CHILD=r'''import base64,hashlib,json,os,ssl,sys,urllib.request
from pathlib import Path
assert os.geteuid()==992
p=json.loads(Path('/var/lib/hepta-secrets-runtime/provider-read.json').read_text())
assert p['provider_token_file']=='/var/lib/hepta-secrets-runtime/provider-token'
assert p['ca_path']=='/var/lib/hepta-secrets-runtime/provider-ca.pem'
assert p['endpoint']=='https://127.0.0.1:18200/' and p['version']==1
if sys.argv[1]=='profile':print(json.dumps(p));raise SystemExit(0)
token=Path(p['provider_token_file']).read_text().strip()
headers={'X-Vault-Token':token}
if p['namespace']:headers['X-Vault-Namespace']=p['namespace']
request=urllib.request.Request(p['endpoint']+'v1/'+p['mount']+'/data/'+p['path']+'?version=1',headers=headers)
with urllib.request.urlopen(request,context=ssl.create_default_context(cafile=p['ca_path']),timeout=4) as response:value=json.load(response)
credential=value['data']['data'][p['field']].encode();assert value['data']['metadata']['version']==1
assert list(hashlib.sha256(credential).digest())==p['expected_secret_sha256']
print(json.dumps({'profile':p,'credential':base64.b64encode(credential).decode()}))
'''
def provider(mode):
    result=subprocess.run(['/usr/bin/setpriv','--reuid','992','--regid','976','--clear-groups','/usr/bin/python3','-c',PROVIDER_CHILD,mode],stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=8)
    if result.returncode:raise ValueError('existing provider read failed; token/config remains unchanged')
    if len(result.stdout)>16384:raise ValueError('provider bootstrap response exceeded bound')
    return json.loads(result.stdout,object_pairs_hook=unique)

def preflight(binary,expected):
    if os.geteuid()!=0:raise ValueError('Root required')
    for role,(uid,gid) in ROLES.items():
        account=pwd.getpwnam('hepta-secrets-'+role)
        if (account.pw_uid,account.pw_gid)!=(uid,gid):raise ValueError('actual service principal differs')
    for uid in AGENTS:
        if pwd.getpwuid(uid).pw_gid!=975:raise ValueError('Agent primary group changed')
    for path in [PROVIDER,TOKEN,CA]:check_file(path,992,0o600)
    if not re.fullmatch('[0-9a-f]{64}',expected) or sha(binary)!=expected:raise ValueError('immutable binary checksum differs')
    s=binary.lstat()
    if not stat.S_ISREG(s.st_mode) or not s.st_mode&0o111:raise ValueError('runtime executable required')
    p=provider('profile')
    return {'provider_profile':p,'provider_ca_sha256':sha(CA),'binary_sha256':expected,'role_uids':{k:v[0] for k,v in ROLES.items()},'agent_uids_ids':AGENTS,'raw_token_read_or_copied_by_root':False,'services_started':False}

def verify_layout(config):
    protected_ancestors(config)
    manifest_path=config/'instance.json';check_file(manifest_path,0,0o640);m=read(manifest_path)
    root=Path(m['canonical_root']);backing=Path(m['backing_root'])
    protected_ancestors(root)
    s=root.stat()
    if s.st_ino!=m['namespace_inode'] or filesystem_uuid(root)!=m['filesystem_uuid']:raise ValueError('original mounted instance differs')
    b=backing.lstat()
    if b.st_uid!=0 or stat.S_IMODE(b.st_mode)!=0o755 or b.st_ino!=s.st_ino or b.st_dev!=s.st_dev:raise ValueError('original backing instance differs')
    image=Path(m['binary_path']);check_file(image,0,0o555);protected_ancestors(image.parent)
    if sha(image)!=m['binary_sha256']:raise ValueError('installed executable changed')
    helper=Path(m['helper_path']);check_file(helper,0,0o555)
    if sha(helper)!=m['helper_sha256']:raise ValueError('installed helper changed')
    for name,digest in m['config_sha256'].items():
        path=config/name;check_file(path,0,0o640)
        if sha(path)!=digest:raise ValueError('Root-frozen configuration changed')
    # Root may advance revocations; the actual operator/authority owners enforce
    # monotonic epochs/revisions and retained revoked IDs in FULL transactions.
    # Freezing the initial head digest here would disable that production path.
    revocation_head(config/m['mutable_root_revocation_head'])
    for record in m['private_files']:
        path=Path(record['path']);check_file(path,record['uid'],0o600)
        if sha(path)!=record['sha256']:raise ValueError('original private purpose/credential file changed')
    return m

def acl_runtime(config):
    m=verify_layout(config);path=Path(read(config/'runtime.json')['service']['socket_path'])
    deadline=time.monotonic()+35
    while not path.exists():
        if time.monotonic()>=deadline:raise ValueError('runtime endpoint not listening')
        time.sleep(.02)
    for target,permissions in [(path.parent,'rx'),(path,'rw')]:
        s=target.lstat()
        if s.st_uid!=992 or (target==path and not stat.S_ISSOCK(s.st_mode)):raise ValueError('runtime endpoint owner differs')
        subprocess.run(['/usr/bin/setfacl','-m',','.join(f'u:{uid}:{permissions}' for uid in AGENTS),str(target)],check=True)
    print(json.dumps({'runtime_public_acl_uids':list(AGENTS),'private_role_endpoints_opened':False}))

def prepare(args):
    report=preflight(args.binary,args.sha256);root=args.root;config=args.config;backing=args.backing
    if (config/'instance.json').exists():
        m=verify_layout(config)
        if m['binary_sha256']!=args.sha256:raise ValueError('upgrade needs explicit existing-instance release; no initialization repeated')
        print(json.dumps({'existing_instance_verified':True,'original_keys_floors_nonce_ack_kept':True,'services_started':False}));return
    if config.exists() or root.exists() or backing.exists():raise ValueError('partial/existing deployment retained; inspect instead of reinitializing')
    protected_ancestors(root.parent);protected_ancestors(config.parent)
    if backing.parent.exists():raise ValueError('existing backing namespace retained')
    mkdir(backing.parent,mode=0o700);mkdir(backing)
    mkdir(root)
    subprocess.run(['/usr/bin/mount','--bind',str(backing),str(root)],check=True)
    protected_ancestors(root)
    mkdir(config,gid=976,mode=0o755);mkdir(config/'units',mode=0o755)
    # All init writes are exclusive. A partial failure leaves the original
    # namespace in place and a later prepare cannot replace keys or clock state.
    installed=root/'bin';mkdir(installed)
    image=installed/'hepta-secrets-runtime'
    private_write(image,args.binary.read_bytes(),0,0,0o555)
    if sha(image)!=args.sha256:raise ValueError('copied executable checksum differs')
    executable_helper=installed/'install-root.py'
    private_write(executable_helper,Path(__file__).read_bytes(),0,0,0o555)
    for role,(uid,gid) in ROLES.items():mkdir(root/role,uid,gid,0o700)
    private_files=[]
    def key(role,purpose):
        seed=Ed25519PrivateKey.generate();path=root/role/(purpose+'.key');uid,gid=ROLES[role]
        private_write(path,seed.private_bytes(Encoding.Raw,PrivateFormat.Raw,NoEncryption()),uid,gid,0o600)
        private_files.append({'path':str(path),'uid':uid,'sha256':sha(path),'purpose':purpose})
        return str(path),list(seed.public_key().public_bytes(Encoding.Raw,PublicFormat.Raw))
    issuer_path,issuer_pin=key('authority','issuer');time_path,time_pin=key('authority','time')
    approval_path,approval_pin=key('operator','approval');revocation_path,revocation_pin=key('operator','revocation')
    ack_path,ack_pin=key('consumer','ack');settlement_path,settlement_pin=key('consumer','settlement')
    value=provider('credential');p=value['profile'];credential=base64.b64decode(value['credential'],validate=True)
    credential_path=root/'consumer/credential';private_write(credential_path,credential,983,972,0o600)
    digest=list(hashlib.sha256(credential).digest());private_files.append({'path':str(credential_path),'uid':983,'sha256':sha(credential_path),'purpose':'independent-consumer-credential'})
    credential=None;value=None
    def service(role,peers):
        return {'socket_path':f'/run/hepta-secrets-{role}/service.sock','ipc_group_gid':976,'service_uid':ROLES[role][0],'allowed_peer_uids':peers,'request_timeout_ms':5000,'shutdown_drain_ms':6000}
    authority_service=service('authority',[992,981,983]);operator_service=service('operator',[992]);consumer_service=service('consumer',[992]);runtime_service=service('runtime',[969,986]);runtime_service.update(request_timeout_ms=30000,shutdown_drain_ms=35000)
    clock={'connection':{'socket_path':authority_service['socket_path'],'peer_uid':982,'timeout_ms':4000},'issuer_id':'hepta-secrets-product-time-v1','key_epoch':1,'verifying_key':time_pin}
    port={'consumer_id':'hepta-secrets-product-consumer-v1','socket_path':consumer_service['socket_path'],'service_uid':983,'acknowledgement_verifying_key':ack_pin,'credential_reference_sha256':digest,'timeout_ms':4000}
    port_digest=list(hashlib.sha256(json.dumps(['hepta.secrets.credential-consumer.configuration.v2',port],separators=(',',':')).encode()).digest())
    request={'subject_id':'hepta-secrets-product-exact-kv-v1','consumer_id':port['consumer_id'],'consumer_configuration_sha256':port_digest,'namespace':p['namespace'],'mount':p['mount'],'path':p['path'],'field':p['field'],'version':1,'expected_secret_sha256':digest}
    ca_digest=list(hashlib.sha256(CA.read_bytes()).digest())
    binding={'subject_id':request['subject_id'],'destination_id':'provider:heptabao','request_sha256':list(hashlib.sha256(json.dumps(['hepta.bao.read.v1',p['endpoint'],ca_digest,request],separators=(',',':')).encode()).digest()),'scope_sha256':list(hashlib.sha256(json.dumps(['hepta.bao.scope.v1',p['endpoint'],request['namespace'],request['mount'],request['consumer_id']],separators=(',',':')).encode()).digest()),'payload_sha256':digest}
    head={'authority_epoch':1,'revision':1,'revoked_grant_ids':[]};root_json(config/'root-revocations.json',head)
    authority={'schema_version':1,'service':authority_service,'database_path':str(root/'authority/owner.sqlite'),'runtime_uid':992,'operator_uid':981,'consumer_uid':983,'issuer_id':'hepta-secrets-product-issuer-v1','issuer_signing_key_file':issuer_path,'issuer_verifying_key':issuer_pin,'time_issuer_id':clock['issuer_id'],'time_key_epoch':1,'time_signing_key_file':time_path,'time_verifying_key':time_pin,'approver_id':'hepta-secrets-product-approval-v1','approver_verifying_key':approval_pin,'distributor_id':'hepta-secrets-product-revocations-v1','distributor_verifying_key':revocation_pin,'frozen_binding':binding,'initial_revocations':head,'grant_lifetime_ms':30000}
    operator={'schema_version':1,'service':operator_service,'database_path':str(root/'operator/owner.sqlite'),'runtime_uid':992,'authority_time':clock,'issuer_id':authority['issuer_id'],'issuer_verifying_key':issuer_pin,'approver_id':authority['approver_id'],'approval_signing_key_file':approval_path,'approval_verifying_key':approval_pin,'distributor_id':authority['distributor_id'],'revocation_signing_key_file':revocation_path,'revocation_verifying_key':revocation_pin,'frozen_binding':binding,'root_revocation_head_file':str(config/'root-revocations.json'),'feed_lifetime_ms':10000,'maximum_grant_lifetime_ms':30000}
    roles={'schema_version':1,'runtime_uid':992,'authority':clock,'operator':{'socket_path':operator_service['socket_path'],'peer_uid':981,'timeout_ms':4000},'issuer_id':authority['issuer_id'],'issuer_verifying_key':issuer_pin,'approver_id':authority['approver_id'],'approver_verifying_key':approval_pin,'frozen_binding':binding}
    consumer={'schema_version':1,'consumer_id':port['consumer_id'],'socket_path':consumer_service['socket_path'],'ipc_group_gid':976,'allowed_caller_uid':992,'database_path':str(root/'consumer/owner.sqlite'),'credential_file':str(credential_path),'credential_sha256':digest,'acknowledgement_signing_key_file':ack_path,'acknowledgement_verifying_key':ack_pin,'request_timeout_ms':5000,'shutdown_drain_ms':6000,'receipt_policy':{'authority':clock,'issuer_id':authority['issuer_id'],'issuer_verifying_key':issuer_pin,'approver_id':authority['approver_id'],'approver_verifying_key':approval_pin,'frozen_binding':binding,'version':1,'credential_bytes':credential_path.stat().st_size,'preparation_lifetime_ms':4000,'cost':1,'settlement_issuer_id':'hepta-secrets-product-settlement-v1','settlement_key_epoch':1,'settlement_signing_key_file':settlement_path,'settlement_verifying_key':settlement_pin,'settlement_lifetime_ms':10000}}
    evidence={'runtime_uid':992,'authority':clock,'consumer':port,'settlement_issuer_id':'hepta-secrets-product-settlement-v1','settlement_key_epoch':1,'settlement_verifying_key':settlement_pin,'cost':1}
    mkdir(root/'runtime/frontier',992,976,0o700);now=int(time.time()*1000)
    runtime={'schema_version':1,'service':runtime_service,'agents':AGENTS,'roles':roles,'evidence':evidence,'revocation_distributor_id':authority['distributor_id'],'revocation_verifying_key':revocation_pin,'provider_endpoint':p['endpoint'],'provider_token_file':str(TOKEN),'provider_ca_file':str(CA),'provider_timeout_ms':4000,'request':request,'owner_database':str(root/'runtime/owner.sqlite'),'authbus_database':str(root/'runtime/authbus.sqlite'),'authbus_checkpoint':str(root/'runtime/frontier/authbus-frontier.json'),'final_use_state':str(root/'runtime/final-use'),'authbus_owner_id':'hepta-secrets-product-authbus-v1','policy_id':'hepta-secrets-product-exact-kv-v1','policy_not_before_ms':now-1000,'policy_expires_at_ms':now+args.policy_days*86400000,'quota_period_id':'hepta-secrets-product-initial-period-v1','quota_limit':args.quota,'maximum_clock_age_ms':5000}
    configs={'authority.json':authority,'operator.json':operator,'consumer.json':consumer,'runtime.json':runtime}
    for uid,agent in AGENTS.items():configs[f'agent-{uid}.json']={'schema_version':1,'agent_uid':uid,'agent_id':agent,'runtime_uid':992,'socket_path':runtime_service['socket_path'],'operation_timeout_ms':30000}
    for name,value in configs.items():root_json(config/name,value,975 if name.startswith('agent-') else 976)
    for role,(uid,gid) in ROLES.items():
        dependencies='hepta-secrets-authority.service' if role in ['operator','consumer'] else ''
        if role=='runtime':dependencies='hepta-secrets-authority.service hepta-secrets-operator.service hepta-secrets-consumer.service hepta-openbao-private-ci.service'
        network='AF_UNIX AF_INET AF_INET6' if role=='runtime' else 'AF_UNIX'
        acl=f'ExecStartPost=+/usr/bin/python3 {executable_helper} acl-runtime --config {config}\n' if role=='runtime' else ''
        unit=f'''[Unit]\nDescription=Hepta protected {role} original-operation owner\nAfter=local-fs.target {dependencies}\nRequires={dependencies}\nRequiresMountsFor={root}\n\n[Service]\nType=simple\nUser=hepta-secrets-{role}\nGroup=hepta-secrets-runtime\nExecStartPre=+/usr/bin/python3 {executable_helper} verify --config {config}\nExecStart={image} serve-{role} {config}/{role}.json\n{acl}RuntimeDirectory=hepta-secrets-{role}\nRuntimeDirectoryMode=0750\nUMask=0077\nTimeoutStopSec={65 if role=='runtime' else 15}s\nKillSignal=SIGTERM\nSendSIGKILL=no\nNoNewPrivileges=yes\nProtectSystem=strict\nProtectHome=yes\nPrivateTmp=yes\nRestrictAddressFamilies={network}\nReadWritePaths={root}/{role} /run/hepta-secrets-{role}\n\n[Install]\nWantedBy=multi-user.target\n'''
        if role=='runtime':unit=unit.replace('ReadWritePaths=', 'IPAddressDeny=any\nIPAddressAllow=localhost\nReadOnlyPaths=/var/lib/hepta-secrets-runtime\nReadWritePaths=')
        if role=='runtime':unit=unit.replace('RuntimeDirectoryMode=0750\n','RuntimeDirectoryMode=0750\nRuntimeDirectoryPreserve=yes\n')
        private_write(config/'units'/f'hepta-secrets-{role}.service',unit.encode(),0,0,0o644)
    mount_name=subprocess.check_output(['/usr/bin/systemd-escape','--path','--suffix=mount',str(root)],text=True).strip()
    mount=f'[Unit]\nDescription=Hepta original secrets durable SSD namespace\nRequiresMountsFor={backing.parent}\nBefore=hepta-secrets-authority.service hepta-secrets-operator.service hepta-secrets-consumer.service hepta-secrets-runtime.service\n\n[Mount]\nWhat={backing}\nWhere={root}\nType=none\nOptions=bind\n\n[Install]\nWantedBy=multi-user.target\n'
    private_write(config/'units'/mount_name,mount.encode(),0,0,0o644)
    manifest={'schema':'hepta.secrets.root-product-first-install.v1','canonical_root':str(root),'backing_root':str(backing),'namespace_inode':root.stat().st_ino,'filesystem_uuid':filesystem_uuid(root),'binary_path':str(image),'binary_sha256':args.sha256,'config_sha256':{name:sha(config/name) for name in configs},'mutable_root_revocation_head':'root-revocations.json','private_files':private_files,'policy_not_before_ms':runtime['policy_not_before_ms'],'policy_expires_at_ms':runtime['policy_expires_at_ms'],'initial_policy_days':args.policy_days,'quota_period_id':runtime['quota_period_id'],'quota_limit_per_agent':args.quota,'original_operation_maximum_ms':30000,'role_rpc_ms':4000,'agent_primary_and_supplementary_group':975,'old_namespaces_modified':False,'provider_token_or_ca_copied':False,'services_started':False,'helper_path':str(executable_helper),'helper_sha256':sha(executable_helper)}
    root_json(config/'instance.json',manifest)
    verify_layout(config)
    print(json.dumps({'prepared':True,'canonical_root':str(root),'configuration_root':str(config),'units':str(config/'units'),'manifest':str(config/'instance.json'),'services_started':False,'provider_raw_token_copied':False,'old_nonce_floor_ack_reset':False}))

def main():
    parser=argparse.ArgumentParser();parser.add_argument('command',choices=['plan','prepare','verify','acl-runtime']);parser.add_argument('--binary',type=Path);parser.add_argument('--sha256');parser.add_argument('--root',type=Path,default=DEFAULT_ROOT);parser.add_argument('--config',type=Path,default=DEFAULT_CONFIG);parser.add_argument('--backing',type=Path,default=DEFAULT_BACKING);parser.add_argument('--policy-days',type=int,default=7);parser.add_argument('--quota',type=int,default=1000);args=parser.parse_args()
    if os.geteuid()!=0:raise ValueError('Root required')
    if args.command in ['verify','acl-runtime']:
        if args.command=='acl-runtime':acl_runtime(args.config)
        else:verify_layout(args.config);print(json.dumps({'original_layout_verified':True,'no_effect_dispatch':True}))
        return
    if args.binary is None or args.sha256 is None:raise ValueError('exact binary path/checksum required')
    if not 1<=args.policy_days<=30 or not 1<=args.quota<=100000:raise ValueError('bounded new-instance policy required')
    for path in [args.root,args.config,args.backing]:
        if not path.is_absolute() or '..' in path.parts or not re.fullmatch(r'[A-Za-z0-9_./-]+',str(path)):raise ValueError('fixed absolute paths required')
    if args.command=='plan':print(json.dumps(preflight(args.binary,args.sha256)))
    else:prepare(args)
if __name__=='__main__':
    try:main()
    except Exception as exc:
        # Never print token, credential, signing seed or provider response.
        print('protected deployment refused: '+str(exc) if isinstance(exc,ValueError) else 'protected deployment failed: '+type(exc).__name__,file=sys.stderr);raise SystemExit(1)
