name: Hepta audit remediation (read-only)

on:
  push:
    branches:
      - "codex/hepta-audit-remediation-20260905"
  pull_request:
    paths:
      - "qualification/cns-organ-reference/**"
      - "tools/hepta-engineering-control/**"
      - "scripts/hepta-cns.py"
      - "scripts/hepta-module-docs.py"
      - "scripts/hepta_module_doc_metadata.py"
      - "scripts/test_hepta_module_doc_metadata.py"
      - "scripts/hepta-gap-closure.py"
      - "docs/cns/**"
      - "docs/modules/**"
      - "docs/STATUS.md"
      - "docs/readiness/GAP_CLOSURE_IMPLEMENTATION.md"
      - "codex-rs/hepta-intelligence-eval/**"
      - ".github/workflows/hepta-audit-remediation.yml"

permissions:
  contents: read

concurrency:
  group: hepta-audit-remediation-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  source-evidence:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - name: Check out exact source without retained credentials
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          persist-credentials: false
          fetch-depth: 0

      - name: Bind immutable source evidence
        env:
          EXPECTED_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$EXPECTED_SHA"
          mkdir -p "$RUNNER_TEMP/hepta-audit-source"
          git archive --format=tar.gz HEAD > "$RUNNER_TEMP/hepta-audit-source/source.tar.gz"
          git rev-parse HEAD HEAD^{tree} > "$RUNNER_TEMP/hepta-audit-source/identity.txt"
          (cd "$RUNNER_TEMP/hepta-audit-source" && sha256sum source.tar.gz > SHA256SUMS)

      - name: Retain immutable source for reproducible local checks
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: hepta-audit-source-${{ github.event.pull_request.head.sha || github.sha }}
          path: ${{ runner.temp }}/hepta-audit-source/
          if-no-files-found: error
          retention-days: 7

      - name: Run CNS boundary tests
        working-directory: qualification/cns-organ-reference
        run: python3 -m unittest discover -v

      - name: Run engineering-control tests
        working-directory: tools/hepta-engineering-control
        run: python3 -m unittest discover -v

      - name: Verify full module and CNS document integrity
        run: |
          set -euo pipefail
          python3 -m unittest discover -s scripts -p test_hepta_module_doc_metadata.py -v
          python3 scripts/hepta_module_doc_metadata.py
          python3 scripts/hepta-module-docs.py verify
          python3 scripts/hepta-gap-closure.py verify
          python3 scripts/hepta-cns.py generate-status --check
          python3 scripts/hepta-cns.py verify

      - name: Require unmodified tracked source
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          git diff --check
          git diff --exit-code
          test -z "$(git status --porcelain --untracked-files=no)"

  rust-evaluation:
    name: Rust evaluation (${{ matrix.lane }})
    runs-on: ubuntu-24.04
    timeout-minutes: 35
    strategy:
      fail-fast: false
      matrix:
        lane: [source-head, synthetic-merge]
    env:
      SOURCE_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
      BASE_SHA: ${{ github.event.pull_request.base.sha || 'ca8e8f11b682e25cbd8bb07093edf59a2c53790d' }}
      CARGO_NET_GIT_FETCH_WITH_CLI: "true"
    steps:
      - name: Check out exact source
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ env.SOURCE_SHA }}
          persist-credentials: false
          fetch-depth: 0

      - name: Construct separately identified synthetic merge
        if: matrix.lane == 'synthetic-merge'
        shell: bash
        run: |
          set -euo pipefail
          TREE=$(git merge-tree --write-tree "$BASE_SHA" "$SOURCE_SHA")
          export GIT_AUTHOR_NAME=hepta-qualification GIT_COMMITTER_NAME=hepta-qualification
          export GIT_AUTHOR_EMAIL=qualification@invalid GIT_COMMITTER_EMAIL=qualification@invalid
          export GIT_AUTHOR_DATE=2000-01-01T00:00:00Z GIT_COMMITTER_DATE=2000-01-01T00:00:00Z
          MERGE=$(printf '%s\n' 'Deterministic qualification only; no branch selection' | git commit-tree "$TREE" -p "$BASE_SHA" -p "$SOURCE_SHA")
          test "$MERGE" != "$SOURCE_SHA"
          test "$(git show -s --format=%P "$MERGE")" = "$BASE_SHA $SOURCE_SHA"
          test "$(git rev-parse "$MERGE^{tree}")" = "$TREE"
          git checkout --detach "$MERGE"

      - name: Verify Python and document changes at this exact Git identity
        shell: bash
        run: |
          set -euo pipefail
          python3 -m unittest discover -s qualification/cns-organ-reference -v
          python3 -m unittest discover -s tools/hepta-engineering-control -v
          python3 -m unittest discover -s scripts -p test_hepta_module_doc_metadata.py -v
          python3 scripts/hepta_module_doc_metadata.py
          python3 scripts/hepta-gap-closure.py verify
          python3 scripts/hepta-cns.py verify
          python3 scripts/hepta-docs.py verify

      - name: Install pinned test runner and just
        uses: taiki-e/install-action@44c6d64aa62cd779e873306675c7a58e86d6d532
        with:
          tool: just@1.51.0,nextest@0.9.103

      - name: Check selected package without changing the lockfile
        working-directory: codex-rs
        run: cargo check --locked --package codex-hepta-intelligence-eval --all-targets

      - name: Run selected package regressions
        working-directory: codex-rs
        run: just test --locked -p codex-hepta-intelligence-eval

      - name: Strict selected-package Clippy
        working-directory: codex-rs
        run: cargo clippy --locked --package codex-hepta-intelligence-eval --all-targets -- -D warnings

      - name: Check selected formatting without modifying source
        working-directory: codex-rs
        run: cargo fmt --package codex-hepta-intelligence-eval -- --check

      - name: Collect identity and optional formatting suggestion outside checkout
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          OUT="$RUNNER_TEMP/hepta-rust-evaluation"
          mkdir -p "$OUT/format-suggestion"
          git rev-parse HEAD HEAD^{tree} > "$OUT/identity.txt"
          git show -s --format=%P HEAD >> "$OUT/identity.txt"
          printf 'source=%s\nbase=%s\nlane=%s\n' "$SOURCE_SHA" "$BASE_SHA" '${{ matrix.lane }}' >> "$OUT/identity.txt"
          cp codex-rs/hepta-intelligence-eval/src/*.rs "$OUT/format-suggestion/"
          (cd codex-rs && rustfmt --edition 2024 --config-path rustfmt.toml "$OUT/format-suggestion/lib.rs")
          git diff --exit-code

      - name: Retain diagnostic artifacts, not acceptance receipts
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: hepta-eval-${{ matrix.lane }}-${{ env.SOURCE_SHA }}
          path: ${{ runner.temp }}/hepta-rust-evaluation/
          if-no-files-found: error
          retention-days: 7
