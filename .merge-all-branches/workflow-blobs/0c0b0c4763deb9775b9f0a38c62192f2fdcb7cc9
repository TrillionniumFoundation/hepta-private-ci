name: Hepta CNS organ embodiment

on:
  pull_request:
    paths:
      - "docs/cns/**"
      - "docs/hnmf/**"
      - "docs/learning/**"
      - "qualification/cns-organ-reference/**"
      - "qualification/hnmf-*/**"
      - "scripts/hepta-cns.py"
      - "scripts/hepta-hnmf.py"
      - "scripts/hepta-paper-evidence.py"
      - "scripts/test_hepta_paper_evidence.py"
      - ".github/workflows/hepta-cns-embodiment.yml"
      - "README.md"
  push:
    branches:
      - main
      - integration/vnext-main-20260811
      - "codex/hepta-cns-*"
    paths:
      - "docs/cns/**"
      - "docs/hnmf/**"
      - "docs/learning/**"
      - "qualification/cns-organ-reference/**"
      - "qualification/hnmf-*/**"
      - "scripts/hepta-cns.py"
      - "scripts/hepta-hnmf.py"
      - "scripts/hepta-paper-evidence.py"
      - "scripts/test_hepta_paper_evidence.py"
      - ".github/workflows/hepta-cns-embodiment.yml"
      - "README.md"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: hepta-cns-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

env:
  PAPER_EVIDENCE_COMMIT: de36bedfbb2ae463e690f5737b22cb280527b142

jobs:
  source-head:
    name: Verify exact CNS source
    runs-on: ubuntu-24.04
    timeout-minutes: 40
    steps:
      - name: Check out exact source
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          persist-credentials: false
          fetch-depth: 0

      - name: Verify retained independent paper evidence
        shell: bash
        run: |
          set -euo pipefail
          git cat-file -e "$PAPER_EVIDENCE_COMMIT^{commit}"
          git merge-base --is-ancestor "$PAPER_EVIDENCE_COMMIT" HEAD

      - name: Verify CNS, evidence and HNMF closed worlds
        env:
          EXPECTED_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$EXPECTED_SHA"
          python3 scripts/hepta-paper-evidence.py self-test
          python3 -m unittest discover -s scripts -p test_hepta_paper_evidence.py -v
          python3 scripts/hepta-paper-evidence.py verify
          python3 scripts/hepta-hnmf.py self-test
          python3 scripts/hepta-hnmf.py verify
          python3 scripts/hepta-cns.py self-test
          python3 scripts/hepta-cns.py generate-status --check
          python3 scripts/hepta-cns.py verify
          python3 scripts/hepta-module-docs.py self-test
          python3 scripts/hepta-module-docs.py verify
          python3 scripts/hepta-algorithm-docs.py self-test
          python3 scripts/hepta-algorithm-docs.py verify-sources
          python3 scripts/hepta-algorithm-docs.py generate-status --check
          python3 scripts/hepta-algorithm-docs.py verify
          python3 scripts/hepta-docs.py self-test
          python3 scripts/hepta-docs.py generate-status
          git diff --exit-code -- docs/STATUS.md
          python3 scripts/hepta-docs.py verify

      - name: Verify HNMF executable references
        shell: bash
        run: |
          set -euo pipefail
          for manifest in \
            qualification/hnmf-reference/Cargo.toml \
            qualification/hnmf-contract-reference/Cargo.toml \
            qualification/hnmf-adversarial-reference/Cargo.toml; do
            cargo fmt --manifest-path "$manifest" -- --check
            cargo check --manifest-path "$manifest" --all-targets --locked
            cargo test --manifest-path "$manifest" --locked
          done

      - name: Emit exact source receipt
        env:
          EXPECTED_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/hepta-cns.py receipt \
            --kind source-head \
            --expected-sha "$EXPECTED_SHA" \
            --output .hepta-evidence/cns-source.json
          python3 scripts/hepta-cns.py receipt-verify \
            --kind source-head \
            --expected-sha "$EXPECTED_SHA" \
            --input .hepta-evidence/cns-source.json
          git diff --check
          test -z "$(git status --porcelain --untracked-files=no)"

      - name: Retain exact source receipt
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: hepta-cns-source-${{ github.event.pull_request.head.sha || github.sha }}
          path: .hepta-evidence/cns-source.json
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 30

  merge-candidate:
    name: Verify deterministic CNS merge candidate
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-24.04
    timeout-minutes: 40
    steps:
      - name: Check out exact source
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          persist-credentials: false
          fetch-depth: 0

      - name: Construct ordered synthetic merge
        id: merge
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          SOURCE_SHA: ${{ github.event.pull_request.head.sha }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$SOURCE_SHA"
          TREE="$(git merge-tree --write-tree "$BASE_SHA" "$SOURCE_SHA")"
          [[ "$TREE" =~ ^[0-9a-f]{40}$ ]]
          export GIT_AUTHOR_NAME='Hepta CNS CI'
          export GIT_AUTHOR_EMAIL='hepta-cns-ci@users.noreply.github.com'
          export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
          export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
          export GIT_AUTHOR_DATE='2000-01-01T00:00:00Z'
          export GIT_COMMITTER_DATE="$GIT_AUTHOR_DATE"
          SHA="$(printf 'Synthetic CNS merge for PR %s\n' "$PR_NUMBER" | git commit-tree "$TREE" -p "$BASE_SHA" -p "$SOURCE_SHA")"
          git checkout --detach "$SHA"
          test "$(git rev-parse HEAD^{tree})" = "$TREE"
          printf 'sha=%s\n' "$SHA" >> "$GITHUB_OUTPUT"
          printf 'tree=%s\n' "$TREE" >> "$GITHUB_OUTPUT"

      - name: Verify retained independent paper evidence
        shell: bash
        run: |
          set -euo pipefail
          git cat-file -e "$PAPER_EVIDENCE_COMMIT^{commit}"
          git merge-base --is-ancestor "$PAPER_EVIDENCE_COMMIT" HEAD

      - name: Verify merged CNS closed world
        env:
          EXPECTED_SHA: ${{ steps.merge.outputs.sha }}
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$EXPECTED_SHA"
          python3 -m unittest discover -s scripts -p test_hepta_paper_evidence.py -v
          python3 scripts/hepta-paper-evidence.py verify
          python3 scripts/hepta-hnmf.py self-test
          python3 scripts/hepta-hnmf.py verify
          python3 scripts/hepta-cns.py self-test
          python3 scripts/hepta-cns.py generate-status --check
          python3 scripts/hepta-cns.py verify
          python3 scripts/hepta-module-docs.py verify
          python3 scripts/hepta-algorithm-docs.py verify-sources
          python3 scripts/hepta-algorithm-docs.py generate-status --check
          python3 scripts/hepta-algorithm-docs.py verify
          python3 scripts/hepta-docs.py generate-status
          git diff --exit-code -- docs/STATUS.md
          python3 scripts/hepta-docs.py verify
          for manifest in \
            qualification/hnmf-reference/Cargo.toml \
            qualification/hnmf-contract-reference/Cargo.toml \
            qualification/hnmf-adversarial-reference/Cargo.toml; do
            cargo fmt --manifest-path "$manifest" -- --check
            cargo check --manifest-path "$manifest" --all-targets --locked
            cargo test --manifest-path "$manifest" --locked
          done

      - name: Emit exact merge receipt
        env:
          EXPECTED_SHA: ${{ steps.merge.outputs.sha }}
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/hepta-cns.py receipt \
            --kind merge-candidate \
            --expected-sha "$EXPECTED_SHA" \
            --output .hepta-evidence/cns-merge.json
          python3 scripts/hepta-cns.py receipt-verify \
            --kind merge-candidate \
            --expected-sha "$EXPECTED_SHA" \
            --input .hepta-evidence/cns-merge.json
          git diff --check
          test -z "$(git status --porcelain --untracked-files=no)"

      - name: Retain exact merge receipt
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: hepta-cns-merge-${{ steps.merge.outputs.sha }}
          path: .hepta-evidence/cns-merge.json
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 30
