name: Hepta adaptive algorithm documents

on:
  pull_request:
  push:
    branches:
      - main
      - integration/vnext-main-20260811
      - "docs/**"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: hepta-algorithm-docs-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  source-head:
    name: Verify exact adaptive-document source
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - name: Check out exact source
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          persist-credentials: false
          fetch-depth: 0

      - name: Verify closed-world algorithm specifications
        env:
          EXPECTED_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$EXPECTED_SHA"
          python3 scripts/hepta-algorithm-docs.py self-test
          python3 scripts/hepta-algorithm-docs.py verify-sources
          python3 scripts/hepta-algorithm-docs.py generate-status --check
          python3 scripts/hepta-algorithm-docs.py verify
          python3 scripts/hepta-module-docs.py self-test
          python3 scripts/hepta-module-docs.py verify
          python3 scripts/hepta-docs.py self-test
          python3 scripts/hepta-docs.py generate-status
          git diff --exit-code -- docs/STATUS.md
          python3 scripts/hepta-docs.py verify
          python3 scripts/hepta-algorithm-docs.py receipt \
            --expected-sha "$EXPECTED_SHA" \
            --output .hepta-evidence/algorithm-source-head.json
          python3 scripts/hepta-algorithm-docs.py receipt-verify \
            --input .hepta-evidence/algorithm-source-head.json \
            --expected-sha "$EXPECTED_SHA"
          git diff --check
          test -z "$(git status --porcelain --untracked-files=no)"

      - name: Retain source receipt
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: hepta-algorithm-source-${{ github.event.pull_request.head.sha || github.sha }}
          path: .hepta-evidence/algorithm-source-head.json
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 30

  merge-candidate:
    name: Verify exact adaptive-document merge candidate
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - name: Check out source for deterministic merge construction
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          persist-credentials: false
          fetch-depth: 0

      - name: Construct exact synthetic merge
        id: merge
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          SOURCE_SHA: ${{ github.event.pull_request.head.sha }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$SOURCE_SHA"
          git cat-file -e "$BASE_SHA^{commit}"
          TREE="$(git merge-tree --write-tree "$BASE_SHA" "$SOURCE_SHA")"
          [[ "$TREE" =~ ^[0-9a-f]{40}$ ]]
          export GIT_AUTHOR_NAME="Hepta Algorithm Docs CI"
          export GIT_AUTHOR_EMAIL="hepta-algorithm-docs-ci@users.noreply.github.com"
          export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
          export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
          export GIT_AUTHOR_DATE="2000-01-01T00:00:00Z"
          export GIT_COMMITTER_DATE="$GIT_AUTHOR_DATE"
          SHA="$(printf 'Synthetic algorithm-document merge for PR %s\n' "$PR_NUMBER" | git commit-tree "$TREE" -p "$BASE_SHA" -p "$SOURCE_SHA")"
          git checkout --detach "$SHA"
          test "$(git rev-parse HEAD)" = "$SHA"
          test "$(git rev-parse HEAD^{tree})" = "$TREE"
          printf 'sha=%s\n' "$SHA" >> "$GITHUB_OUTPUT"
          printf 'tree=%s\n' "$TREE" >> "$GITHUB_OUTPUT"

      - name: Verify synthetic merge candidate
        env:
          EXPECTED_SHA: ${{ steps.merge.outputs.sha }}
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$EXPECTED_SHA"
          python3 scripts/hepta-algorithm-docs.py self-test
          python3 scripts/hepta-algorithm-docs.py verify-sources
          python3 scripts/hepta-algorithm-docs.py generate-status --check
          python3 scripts/hepta-algorithm-docs.py verify
          python3 scripts/hepta-module-docs.py verify
          python3 scripts/hepta-docs.py generate-status
          git diff --exit-code -- docs/STATUS.md
          python3 scripts/hepta-docs.py verify
          python3 scripts/hepta-algorithm-docs.py receipt \
            --expected-sha "$EXPECTED_SHA" \
            --output .hepta-evidence/algorithm-merge-candidate.json
          python3 scripts/hepta-algorithm-docs.py receipt-verify \
            --input .hepta-evidence/algorithm-merge-candidate.json \
            --expected-sha "$EXPECTED_SHA"
          git diff --check
          test -z "$(git status --porcelain --untracked-files=no)"

      - name: Retain merge receipt
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: hepta-algorithm-merge-${{ steps.merge.outputs.sha }}
          path: .hepta-evidence/algorithm-merge-candidate.json
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 30
