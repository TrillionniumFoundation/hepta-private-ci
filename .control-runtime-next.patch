+
+fn request_named(name: &str) -> GrantRequestV1 {
+    let mut value = request();
+    value.operation_id = id(&format!("send-{name}"));
+    value.candidate_id = id(&format!("candidate-{name}"));
+    value.plan_digest = digest(&format!("plan-{name}"));
+    value.final_payload_digest = digest(&format!("payload-{name}"));
+    value
+}
+
+fn leave_unresolved_claim(store: &mut PlannerStoreV1, request: &GrantRequestV1) {
+    let mut authority = authority(request);
+    let mut executor = executor(PlannerEffectDispositionV1::Succeeded);
+    executor.fail_next_execute = true;
+    let error = must_err(execute_planner_request_v1(
+        request,
+        1_000,
+        &mut authority,
+        &mut executor,
+        store,
+    ));
+    assert!(matches!(error, PlannerExecutionError::Store(_)));
+}
+
+#[test]
+fn pending_dispatch_inventory_is_bounded_and_round_robin() {
+    let directory = must(tempdir());
+    let mut store = must(PlannerStoreV1::open(
+        directory.path(),
+        PlannerStoreConfigV1::default(),
+    ));
+    let first = request_named("first");
+    let second = request_named("second");
+    let third = request_named("third");
+    leave_unresolved_claim(&mut store, &first);
+    leave_unresolved_claim(&mut store, &second);
+    leave_unresolved_claim(&mut store, &third);
+
+    let page = must(store.pending_dispatches_page(None, 2));
+    assert_eq!(page.items.len(), 2);
+    assert!(!page.wrapped);
+    assert!(!page.authority.grants_any());
+    assert!(page.items.iter().all(|item| !item.authority.grants_any()));
+    assert!(page.items[0].claim_sequence < page.items[1].claim_sequence);
+
+    let rotated = must(store.pending_dispatches_page(page.next_after_sequence, 2));
+    assert_eq!(rotated.items.len(), 2);
+    assert!(rotated.wrapped);
+    assert_eq!(rotated.items[1], page.items[0]);
+    assert_ne!(rotated.items[0], page.items[0]);
+}
+
+#[test]
+fn pending_dispatch_inventory_excludes_conclusive_and_keeps_indeterminate() {
+    let directory = must(tempdir());
+    let mut store = must(PlannerStoreV1::open(
+        directory.path(),
+        PlannerStoreConfigV1::default(),
+    ));
+
+    let conclusive = request_named("conclusive");
+    let mut authority = authority(&conclusive);
+    let mut executor = executor(PlannerEffectDispositionV1::Succeeded);
+    must(execute_planner_request_v1(
+        &conclusive,
+        1_000,
+        &mut authority,
+        &mut executor,
+        &mut store,
+    ));
+
+    let indeterminate = request_named("indeterminate");
+    let mut authority = authority(&indeterminate);
+    let mut executor = executor(PlannerEffectDispositionV1::Indeterminate);
+    must(execute_planner_request_v1(
+        &indeterminate,
+        1_000,
+        &mut authority,
+        &mut executor,
+        &mut store,
+    ));
+
+    let page = must(store.pending_dispatches_page(None, 8));
+    assert_eq!(page.items.len(), 1);
+    assert_eq!(
+        page.items[0].final_payload_digest,
+        indeterminate.final_payload_digest
+    );
+}
+
+#[test]
+fn pending_dispatch_inventory_rejects_invalid_bounds_and_poisoned_state() {
+    let directory = must(tempdir());
+    let mut store = must(PlannerStoreV1::open(
+        directory.path(),
+        PlannerStoreConfigV1::default(),
+    ));
+    assert!(matches!(
+        store.pending_dispatches_page(None, 0),
+        Err(PlannerExecutionError::Store(message))
+            if message.contains("limit is out of bounds")
+    ));
+    assert!(matches!(
+        store.pending_dispatches_page(None, MAX_PENDING_DISPATCH_PAGE_ITEMS_V1 + 1),
+        Err(PlannerExecutionError::Store(message))
+            if message.contains("limit is out of bounds")
+    ));
+
+    store.set_failpoint(Some(PlannerStoreFailpointV1::AfterLogSyncBeforePublish));
+    let error = must_err(store.append(
+        PlannerStoreRecordKindV1::Decision,
+        digest("poison-operation"),
+        digest("poison-payload"),
+        b"poison-envelope",
+    ));
+    assert!(matches!(
+        error,
+        PlannerStoreError::Failpoint(PlannerStoreFailpointV1::AfterLogSyncBeforePublish)
+    ));
+    assert!(matches!(
+        store.pending_dispatches_page(None, 1),
+        Err(PlannerExecutionError::Store(message))
+            if message.contains("recovery required")
+    ));
+}
