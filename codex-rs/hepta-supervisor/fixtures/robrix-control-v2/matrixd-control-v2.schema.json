            "type": {
              "const": "turn_started"
            }
          },
          "required": [
            "type",
            "thread_id",
            "turn_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "thread_id": {
              "$ref": "#/$defs/RuntimeId"
            },
            "turn_id": {
              "$ref": "#/$defs/RuntimeId"
