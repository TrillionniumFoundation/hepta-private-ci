        "kind": {
          "$ref": "#/$defs/MatrixdEventKind"
        }
      },
      "required": [
        "cursor",
        "kind"
      ],
      "type": "object"
    },
    "MatrixdEventBatch": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "gap": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "events": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/MatrixdEvent"
          },
          "maxItems": 256,
          "type": "array"
        },
        "gap": {
          "type": "boolean"
        },
        "latest_cursor": {
          "minimum": 0,
          "type": "integer"
        },
        "next_cursor": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "events",
        "gap",
        "next_cursor",
        "latest_cursor"
      ],
      "type": "object"
    },
    "MatrixdEventKind": {
