      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ApprovalDecision": {
      "enum": [
        "accept",
        "accept_for_session",
        "decline",
        "cancel"
      ]
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "MatrixRoomId": {
      "maxLength": 255,
      "minLength": 3,
      "pattern": "^![^\\s:]+:.+$",
      "type": "string"
    },
    "MatrixUserId": {
      "maxLength": 255,
      "minLength": 3,
      "pattern": "^@[^\\s:]+:.+$",
      "type": "string"
    },
    "MatrixdBootstrapMethod": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "health"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "snapshot"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "MatrixdEvent": {
