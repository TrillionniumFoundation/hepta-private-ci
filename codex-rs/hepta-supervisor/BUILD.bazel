load("//:defs.bzl", "codex_rust_crate")
load("//bazel/rules/testing:qualification_lease_clock.bzl", "qualification_lease_clock_library")

codex_rust_crate(
    name = "hepta-supervisor",
    crate_name = "codex_hepta_supervisor",
    # The paired process tests strip only their private child image. Declare
    # that tool so remote executors do not need a host-installed binutils.
    extra_binaries_non_windows = ["@llvm-project//llvm:llvm-strip"],
    # The projection integration tests compare generated artifacts with the
    # checked-in fixture set. Bazel must place those runtime files in runfiles.
    test_data_extra = glob(["fixtures/robrix-control-v2/**"]),
)

# Caller evidence inspected by the Hepta contracts tests.
exports_files(
    [
        "examples/write_robrix_control_projection.rs",
        "src/matrix.rs",
        "src/supervisor_tests.rs",
        "src/unix.rs",
        "tests/robrix_control_projection.rs",
    ],
    visibility = ["//codex-rs/hepta-contracts:__pkg__"],
)

qualification_lease_clock_library(
    name = "hepta-supervisor",
    crate_name = "codex_hepta_supervisor",
)
