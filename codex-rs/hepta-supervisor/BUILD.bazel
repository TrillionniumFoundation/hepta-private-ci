load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "hepta-supervisor",
    binary_feature_groups = {
        # Match Cargo's opt-in tools without exposing signing APIs through the
        # ordinary supervisor library or hepta-supervisord.
        "offline-authority-tools": {
            "binaries": [
                "hepta-supervisor-authority-bundle",
                "hepta-authority-signer",
                "hepta-final-use-signer",
                "hepta-final-use-approver",
                "hepta-final-use-revocation-signer",
            ],
            "features": [
                "offline-authority-tools",
                "production-verifier",
                "production-authority",
            ],
        },
    },
    # Mirror Cargo target eligibility without activating an unavailable profile.
    binary_required_features = {
        "hepta-authority-signer": ["offline-authority-tools"],
        "hepta-final-use-approver": ["offline-authority-tools"],
        "hepta-final-use-revocation-signer": ["offline-authority-tools"],
        "hepta-final-use-signer": ["offline-authority-tools"],
        "hepta-fleetctl": [],
        "hepta-model-authority": ["local-model-authority"],
        "hepta-supervisor-authority-bundle": ["offline-authority-tools"],
        "hepta-supervisor-intent-recovery": [],
        "hepta-supervisor-recovery-diagnose": [],
        "hepta-supervisord": [],
    },
    crate_name = "codex_hepta_supervisor",
    owner_test_dependency_replacements = {
        "//codex-rs/hepta-fleet": "//codex-rs/hepta-fleet:hepta-fleet-supervisor-owner-test-lib",
        "//codex-rs/hepta-agent-protocol": "//codex-rs/hepta-agent-protocol:hepta-agent-protocol-supervisor-owner-test-lib",
    },
    unit_test_dependency_replacements = {
        "//codex-rs/hepta-intelligence-eval": "//codex-rs/hepta-intelligence-eval:hepta-intelligence-eval-test-lib",
    },
)

# Caller evidence inspected by the Hepta contracts tests.
exports_files(
    [
        "examples/write_robrix_control_projection.rs",
        "src/matrix.rs",
        "src/supervisor_tests.rs",
        "src/unix.rs",
        "tests/robrix_control_projection.rs",
    ],
    visibility = ["//codex-rs/hepta-contracts:__pkg__"],
)
