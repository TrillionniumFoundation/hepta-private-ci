{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hepta.invalid/schemas/platform.types/sensor-calibration-manifest-v1.schema.json",
  "title": "SensorCalibrationManifestV1 strict JSON transport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "sensor_id",
    "sensor_class",
    "hardware_or_adapter_digest",
    "calibration_generation",
    "clock_domain",
    "valid_from",
    "valid_until",
    "uncertainty_profile",
    "operating_range",
    "failure_policy"
  ],
  "properties": {
    "kind": { "const": "sensor_calibration_manifest_v1" },
    "sensor_id": { "$ref": "#/$defs/stableId" },
    "sensor_class": {
      "enum": [
        "physical_sensor",
        "browser_session",
        "matrix_session",
        "provider_runtime",
        "filesystem_mount",
        "service_adapter",
        "simulator"
      ]
    },
    "hardware_or_adapter_digest": { "$ref": "#/$defs/nonzeroDigest" },
    "calibration_generation": { "$ref": "#/$defs/positiveU64String" },
    "clock_domain": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000]+$" },
    "valid_from": { "$ref": "#/$defs/utcTimestamp" },
    "valid_until": { "$ref": "#/$defs/utcTimestamp" },
    "uncertainty_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution_class", "lower_q32", "upper_q32", "confidence_ppm"],
      "properties": {
        "distribution_class": { "enum": ["bounded_interval", "normal_approximation", "empirical_quantiles"] },
        "lower_q32": { "$ref": "#/$defs/i64String" },
        "upper_q32": { "$ref": "#/$defs/i64String" },
        "confidence_ppm": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "operating_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "minimum_q32", "maximum_q32"],
      "properties": {
        "unit": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000]+$" },
        "minimum_q32": { "$ref": "#/$defs/i64String" },
        "maximum_q32": { "$ref": "#/$defs/i64String" }
      }
    },
    "failure_policy": { "enum": ["reject", "degrade", "abstain", "reflex_stop"] }
  },
  "$defs": {
    "stableId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "nonzeroDigest": { "type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$" },
    "positiveU64String": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "i64String": { "type": "string", "pattern": "^(0|-?[1-9][0-9]*)$" },
    "utcTimestamp": { "type": "string", "minLength": 20, "maxLength": 27, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" }
  }
}
