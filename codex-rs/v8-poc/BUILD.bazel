load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "v8-poc",
    # The linked Windows MSVC rusty_v8 artifact is sandbox-enabled, just as
    # MODULE.bazel's v8 crate annotation is. Keep the wrapper feature aligned
    # with that real native library on every supported target.
    crate_features = ["sandbox"],
    crate_name = "codex_v8_poc",
    deps_extra = ["@crates//:v8"],
)

alias(
    name = "v8-poc-rusty-v8",
    actual = ":v8-poc",
)
