load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "v8-poc",
    # MODULE.bazel enables the linked V8 sandbox for Windows MSVC too.
    # Keep the crate's own feature aligned with the actual linked library.
    crate_features = ["sandbox"],
    crate_name = "codex_v8_poc",
    deps_extra = ["@crates//:v8"],
)

alias(
    name = "v8-poc-rusty-v8",
    actual = ":v8-poc",
)
