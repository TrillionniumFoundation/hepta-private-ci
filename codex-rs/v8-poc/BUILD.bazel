load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "v8-poc",
    crate_features = select({
        # Windows MSVC consumes the sandbox-enabled prebuilt selected in
        # MODULE.bazel, so keep the Rust feature in sync with the linked V8.
        "@llvm//constraints/windows/abi:msvc": ["sandbox"],
        "//conditions:default": ["sandbox"],
    }),
    crate_name = "codex_v8_poc",
    deps_extra = ["@crates//:v8"],
)

alias(
    name = "v8-poc-rusty-v8",
    actual = ":v8-poc",
)
