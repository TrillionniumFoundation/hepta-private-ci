load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "v8-poc",
    crate_features = select({
        "@llvm//constraints/windows/abi:msvc": [],
        "//conditions:default": ["sandbox"],
    }),
    crate_name = "codex_v8_poc",
    # V8 initialization and sandbox address-space configuration are
    # process-global. Run every test, but do not initialize concurrently.
    unit_test_args = ["--test-threads=1"],
    deps_extra = ["@crates//:v8"],
)

alias(
    name = "v8-poc-rusty-v8",
    actual = ":v8-poc",
)
