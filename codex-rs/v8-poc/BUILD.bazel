load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "v8-poc",
    # Match the sandbox-enabled linked V8 library on every Bazel target,
    # including the Windows MSVC prebuilt.
    crate_features = ["sandbox"],
    crate_name = "codex_v8_poc",
    deps_extra = ["@crates//:v8"],
)

alias(
    name = "v8-poc-rusty-v8",
    actual = ":v8-poc",
)
