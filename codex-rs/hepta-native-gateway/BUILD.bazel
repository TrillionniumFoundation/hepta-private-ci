load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "hepta-native-gateway",
    crate_name = "codex_hepta_native_gateway",
    crate_srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/main.rs",
            "src/bin/*.rs",
