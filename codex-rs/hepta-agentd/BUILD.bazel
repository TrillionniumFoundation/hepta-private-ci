load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//:defs.bzl", "WINDOWS_RUSTC_LINK_FLAGS", "codex_rust_crate", "workspace_root_test")
load("//bazel/rules/testing:foreign_platform_binary.bzl", "foreign_platform_binary")
load("//bazel/rules/testing:rust_test_dependencies.bzl", "rust_test_dependencies")

# Linux CI runs the original C fixtures with a dynamic GNU loader. Keep that
# ABI for musl Rust tests too, while preserving the tested target's CPU. The
# pinned LLVM musl C toolchain otherwise forces a static executable.
config_setting(
    name = "pon-native-linux-x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "pon-native-linux-aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

_PON_NATIVE_COMPATIBILITY = select({
    ":pon-native-linux-x86_64": [],
    ":pon-native-linux-aarch64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_PON_NATIVE_GNU_PLATFORM = select({
    ":pon-native-linux-x86_64": "@llvm//platforms:linux_x86_64_gnu.2.28",
    ":pon-native-linux-aarch64": "@llvm//platforms:linux_aarch64_gnu.2.28",
    "//conditions:default": "@llvm//platforms:linux_x86_64_gnu.2.28",
})

_PON_NATIVE_FIXTURE_FILES = [
    "tests/fixtures/pon_pipe.c",
    "tests/fixtures/pon_preload.c",
]

_PON_NATIVE_RUNFILE_ENV = select({
    ":pon-native-linux-x86_64": {
        ":pon-native-pipe-runfile": "HEPTA_PON_TEST_PIPE_FIXTURE",
        ":pon-native-preload-runfile": "HEPTA_PON_TEST_PRELOAD_FIXTURE",
    },
    ":pon-native-linux-aarch64": {
        ":pon-native-pipe-runfile": "HEPTA_PON_TEST_PIPE_FIXTURE",
        ":pon-native-preload-runfile": "HEPTA_PON_TEST_PRELOAD_FIXTURE",
    },
    "//conditions:default": {},
})

cc_binary(
    name = "pon-native-pipe-fixture-bin",
    testonly = True,
    srcs = ["tests/fixtures/pon_pipe.c"],
    copts = [
        "-std=c11",
        "-O0",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    tags = ["manual"],
    target_compatible_with = _PON_NATIVE_COMPATIBILITY,
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "pon-native-preload-fixture.so",
    testonly = True,
    srcs = ["tests/fixtures/pon_preload.c"],
    copts = [
        "-std=c11",
        "-fPIC",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkshared = True,
    tags = ["manual"],
    target_compatible_with = _PON_NATIVE_COMPATIBILITY,
    visibility = ["//visibility:private"],
)

foreign_platform_binary(
    name = "pon-native-pipe-runfile",
    testonly = True,
    binary = ":pon-native-pipe-fixture-bin",
    platform = _PON_NATIVE_GNU_PLATFORM,
    tags = ["manual"],
    target_compatible_with = _PON_NATIVE_COMPATIBILITY,
    visibility = ["//visibility:private"],
)

foreign_platform_binary(
    name = "pon-native-preload-runfile",
    testonly = True,
    binary = ":pon-native-preload-fixture.so",
    platform = _PON_NATIVE_GNU_PLATFORM,
    tags = ["manual"],
    target_compatible_with = _PON_NATIVE_COMPATIBILITY,
    visibility = ["//visibility:private"],
)

_UNIT_TEST_DEPENDENCIES = {
    "//codex-rs/hepta-bellman-operator": "//codex-rs/hepta-bellman-operator:hepta-bellman-operator-test-lib",
    "//codex-rs/hepta-intelligence": "//codex-rs/hepta-intelligence:hepta-intelligence-test-lib",
    "//codex-rs/hepta-intelligence-eval": "//codex-rs/hepta-intelligence-eval:hepta-intelligence-eval-test-lib",
    "//codex-rs/hepta-learning-ledger": "//codex-rs/hepta-learning-ledger:hepta-learning-ledger-qualification-lib",
    "//codex-rs/hepta-prompt-optimizer": "//codex-rs/hepta-prompt-optimizer:hepta-prompt-optimizer-test-lib",
}

codex_rust_crate(
    name = "hepta-agentd",
    compile_data = ["src/cognitive_three_generation_support.rs"] + _PON_NATIVE_FIXTURE_FILES,
    # Match the package default feature closure in Cargo.
    crate_features = [
        "default",
        "production-cognitive-write",
    ],
    crate_name = "codex_hepta_agentd",
    # This process fixture seeds a historical ledger before launching the
    # ordinary product binary. Keep the legacy writer in this harness only.
    integration_test_dependency_replacements = {
        "plasticity_process_e2e": {
            "//codex-rs/hepta-learning-ledger": "//codex-rs/hepta-learning-ledger:hepta-learning-ledger-qualification-lib",
        },
    },
    integration_test_timeout = "long",
    unit_test_dependency_replacements = _UNIT_TEST_DEPENDENCIES,
    unit_test_runfile_env = _PON_NATIVE_RUNFILE_ENV,
)

# Cargo expands qualification-cognitive-write to production-cognitive-write.
# Keep that feature closure explicit for these hand-written test-only rules.
_COGNITIVE_QUALIFICATION_FEATURES = [
    "production-cognitive-write",
    "qualification-cognitive-write",
]

# Compile the local writer qualification separately from the default product
# library. These unit fixtures need only temporary registry and SQLite state;
# they do not start Agentd, an App Server, or a provider process.
rust_library(
    name = "hepta-agentd-cognitive-write-qualification-lib",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["src/cognitive_three_generation_support.rs"] + _PON_NATIVE_FIXTURE_FILES,
    crate_features = _COGNITIVE_QUALIFICATION_FEATURES,
    crate_name = "codex_hepta_agentd",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_env = {"BAZEL_PACKAGE": "codex-rs/hepta-agentd"},
    visibility = ["//visibility:private"],
    deps = rust_test_dependencies(_UNIT_TEST_DEPENDENCIES),
)

rust_test(
    name = "hepta-agentd-cognitive-write-qualification-test-bin",
    crate = ":hepta-agentd-cognitive-write-qualification-lib",
    crate_features = _COGNITIVE_QUALIFICATION_FEATURES,
    rustc_env = {"BAZEL_PACKAGE": "codex-rs/hepta-agentd"},
    rustc_flags = WINDOWS_RUSTC_LINK_FLAGS + [
        "--remap-path-prefix=../codex-rs=",
        "--remap-path-prefix=codex-rs=",
    ],
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = rust_test_dependencies(
        _UNIT_TEST_DEPENDENCIES,
        normal_dev = True,
    ),
)

workspace_root_test(
    name = "hepta-agentd-cognitive-write-qualification-test",
    args = ["runtime::tests::qualification_"],
    runfile_env = _PON_NATIVE_RUNFILE_ENV,
    test_bin = ":hepta-agentd-cognitive-write-qualification-test-bin",
    workspace_root_marker = "//codex-rs/utils/cargo-bin:repo_root.marker",
)

# The process suite uses UnixProcessDriver and Unix sockets. Compile both the
# spawned Agentd and its test harness with the explicit qualification profile.
_COGNITIVE_E2E_COMPATIBILITY = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

rust_binary(
    name = "hepta-agentd-cognitive-product-qualification-bin",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = _COGNITIVE_QUALIFICATION_FEATURES,
    crate_name = "codex_hepta_agentd",
    crate_root = "src/main.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_BIN_NAME": "codex-hepta-agentd",
    },
    rustc_flags = WINDOWS_RUSTC_LINK_FLAGS + [
        "--remap-path-prefix=../codex-rs=",
        "--remap-path-prefix=codex-rs=",
    ],
    tags = ["manual"],
    target_compatible_with = _COGNITIVE_E2E_COMPATIBILITY,
    visibility = ["//visibility:private"],
    deps = [":hepta-agentd-cognitive-write-qualification-lib"] + all_crate_deps(),
)

rust_test(
    name = "hepta-agentd-cognitive-product-qualification-test-bin",
    srcs = ["tests/cognitive_product_e2e.rs"] + glob(["tests/support/**/*.rs"]),
    crate_features = _COGNITIVE_QUALIFICATION_FEATURES,
    crate_name = "cognitive_product_e2e",
    crate_root = "tests/cognitive_product_e2e.rs",
    data = glob(["tests/support/**"]),
    edition = "2024",
    rustc_flags = WINDOWS_RUSTC_LINK_FLAGS + [
        "--remap-path-prefix=../codex-rs=",
        "--remap-path-prefix=codex-rs=",
    ],
    tags = ["manual"],
    target_compatible_with = _COGNITIVE_E2E_COMPATIBILITY,
    visibility = ["//visibility:private"],
    deps = [":hepta-agentd-cognitive-write-qualification-lib"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

workspace_root_test(
    name = "hepta-agentd-cognitive-product-qualification-test",
    timeout = "long",
    runfile_env = {
        ":hepta-agentd-cognitive-product-qualification-bin": "CARGO_BIN_EXE_codex-hepta-agentd",
    },
    target_compatible_with = _COGNITIVE_E2E_COMPATIBILITY,
    test_bin = ":hepta-agentd-cognitive-product-qualification-test-bin",
    test_threads = 1,
    visibility = ["//visibility:public"],
    workspace_root_marker = "//codex-rs/utils/cargo-bin:repo_root.marker",
)

# Caller evidence inspected by the Hepta contracts tests.
exports_files(
    [
        "src/config.rs",
        "src/config_tests.rs",
        "src/intuition_policy.rs",
        "src/runtime_tests.rs",
        "tests/cognitive_product_e2e.rs",
        "tests/five_agent_rolling_upgrade.rs",
        "tests/supervisord_product_e2e.rs",
    ],
    visibility = ["//codex-rs/hepta-contracts:__pkg__"],
)

# Original process-only codec types reused by the real neural study test.
exports_files(
    [
        "src/cognitive_process_wire.rs",
        "src/cognitive_process_learning_auth.rs",
        "src/cognitive_process_learning_auth_tests.rs",
        "src/cognitive_process_evidence.rs",
        "src/cognitive_process_evaluation.rs",
        "src/cognitive_process_materials.rs",
        "src/cognitive_process_product_wire.rs",
    ],
    visibility = ["//codex-rs/hepta-infer-worker-host:__pkg__"],
)
