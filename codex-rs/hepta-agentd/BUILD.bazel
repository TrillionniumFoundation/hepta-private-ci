load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//:defs.bzl", "WINDOWS_RUSTC_LINK_FLAGS", "codex_rust_crate", "workspace_root_test")
load("//bazel/rules/testing:rust_test_dependencies.bzl", "rust_test_dependencies")

_UNIT_TEST_DEPENDENCIES = {
    "//codex-rs/hepta-bellman-operator": "//codex-rs/hepta-bellman-operator:hepta-bellman-operator-test-lib",
    "//codex-rs/hepta-intelligence": "//codex-rs/hepta-intelligence:hepta-intelligence-test-lib",
    "//codex-rs/hepta-intelligence-eval": "//codex-rs/hepta-intelligence-eval:hepta-intelligence-eval-test-lib",
    "//codex-rs/hepta-learning-ledger": "//codex-rs/hepta-learning-ledger:hepta-learning-ledger-qualification-lib",
    "//codex-rs/hepta-prompt-optimizer": "//codex-rs/hepta-prompt-optimizer:hepta-prompt-optimizer-test-lib",
}

codex_rust_crate(
    name = "hepta-agentd",
    crate_name = "codex_hepta_agentd",
    integration_test_dependency_replacements = {
        "plasticity_process_e2e": {
            "//codex-rs/hepta-learning-ledger": "//codex-rs/hepta-learning-ledger:hepta-learning-ledger-qualification-lib",
        },
    },
    integration_test_timeout = "long",
    unit_test_dependency_replacements = _UNIT_TEST_DEPENDENCIES,
)

# Both writer qualification and process integration require the existing Unix
# durable owner. Other platforms exercise actual admission refusal in the
# default unit target; they must not pass a qualification filter with zero tests.
_DURABLE_OWNER_COMPATIBILITY = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Cargo expands qualification-cognitive-write to production-cognitive-write.
# Keep that complete local feature closure on the library, binary and harness.
_COGNITIVE_QUALIFICATION_FEATURES = [
    "production-cognitive-write",
    "qualification-cognitive-write",
]

# Compile the local writer qualification separately from the default product
# library. These unit fixtures need only temporary registry and SQLite state;
# they do not start Agentd, an App Server, or a provider process.
rust_library(
    name = "hepta-agentd-cognitive-write-qualification-lib",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = _COGNITIVE_QUALIFICATION_FEATURES,
    crate_name = "codex_hepta_agentd",
    crate_root = "src/lib.rs",
    edition = "2024",
    target_compatible_with = _DURABLE_OWNER_COMPATIBILITY,
    visibility = ["//visibility:private"],
    deps = rust_test_dependencies(_UNIT_TEST_DEPENDENCIES),
)

rust_test(
    name = "hepta-agentd-cognitive-write-qualification-test-bin",
    crate = ":hepta-agentd-cognitive-write-qualification-lib",
    crate_features = _COGNITIVE_QUALIFICATION_FEATURES,
    rustc_flags = WINDOWS_RUSTC_LINK_FLAGS + [
        "--remap-path-prefix=../codex-rs=",
        "--remap-path-prefix=codex-rs=",
    ],
    tags = ["manual"],
    target_compatible_with = _DURABLE_OWNER_COMPATIBILITY,
    visibility = ["//visibility:private"],
    deps = rust_test_dependencies(
        _UNIT_TEST_DEPENDENCIES,
        normal_dev = True,
    ),
)

workspace_root_test(
    name = "hepta-agentd-cognitive-write-qualification-test",
    args = ["runtime::tests::qualification_"],
    target_compatible_with = _DURABLE_OWNER_COMPATIBILITY,
    test_bin = ":hepta-agentd-cognitive-write-qualification-test-bin",
    workspace_root_marker = "//codex-rs/utils/cargo-bin:repo_root.marker",
)

# The process suite uses UnixProcessDriver and Unix sockets. Compile both the
# spawned Agentd and its test harness with the explicit qualification profile.
rust_binary(
    name = "hepta-agentd-cognitive-product-qualification-bin",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = _COGNITIVE_QUALIFICATION_FEATURES,
    crate_name = "codex_hepta_agentd",
    crate_root = "src/main.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_BIN_NAME": "codex-hepta-agentd",
    },
    rustc_flags = WINDOWS_RUSTC_LINK_FLAGS + [
        "--remap-path-prefix=../codex-rs=",
        "--remap-path-prefix=codex-rs=",
    ],
    tags = ["manual"],
    target_compatible_with = _DURABLE_OWNER_COMPATIBILITY,
    visibility = ["//visibility:private"],
    deps = [":hepta-agentd-cognitive-write-qualification-lib"] + all_crate_deps(),
)

rust_test(
    name = "hepta-agentd-cognitive-product-qualification-test-bin",
    srcs = ["tests/cognitive_product_e2e.rs"] + glob(["tests/support/**/*.rs"]),
    crate_features = _COGNITIVE_QUALIFICATION_FEATURES,
    crate_name = "cognitive_product_e2e",
    crate_root = "tests/cognitive_product_e2e.rs",
    data = glob(["tests/support/**"]),
    edition = "2024",
    rustc_flags = WINDOWS_RUSTC_LINK_FLAGS + [
        "--remap-path-prefix=../codex-rs=",
        "--remap-path-prefix=codex-rs=",
    ],
    tags = ["manual"],
    target_compatible_with = _DURABLE_OWNER_COMPATIBILITY,
    visibility = ["//visibility:private"],
    deps = [":hepta-agentd-cognitive-write-qualification-lib"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

workspace_root_test(
    name = "hepta-agentd-cognitive-product-qualification-test",
    timeout = "long",
    runfile_env = {
        ":hepta-agentd-cognitive-product-qualification-bin": "CARGO_BIN_EXE_codex-hepta-agentd",
    },
    target_compatible_with = _DURABLE_OWNER_COMPATIBILITY,
    test_bin = ":hepta-agentd-cognitive-product-qualification-test-bin",
    test_threads = 1,
    visibility = ["//visibility:public"],
    workspace_root_marker = "//codex-rs/utils/cargo-bin:repo_root.marker",
)

# Preserve the original read-only degradation assertion with a matching
# no-default-features product. The public wrapper is an ordinary //... test;
# only its private implementation binary follows the existing manual convention.
rust_library(
    name = "hepta-agentd-cognitive-readonly-product-lib",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = [],
    crate_name = "codex_hepta_agentd",
    crate_root = "src/lib.rs",
    edition = "2024",
    target_compatible_with = _DURABLE_OWNER_COMPATIBILITY,
    visibility = ["//visibility:private"],
    deps = rust_test_dependencies(_UNIT_TEST_DEPENDENCIES),
)

rust_binary(
    name = "hepta-agentd-cognitive-readonly-product-bin",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = [],
    crate_name = "codex_hepta_agentd",
    crate_root = "src/main.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_BIN_NAME": "codex-hepta-agentd",
    },
    rustc_flags = WINDOWS_RUSTC_LINK_FLAGS + [
        "--remap-path-prefix=../codex-rs=",
        "--remap-path-prefix=codex-rs=",
    ],
    tags = ["manual"],
    target_compatible_with = _DURABLE_OWNER_COMPATIBILITY,
    visibility = ["//visibility:private"],
    deps = [":hepta-agentd-cognitive-readonly-product-lib"] + rust_test_dependencies(_UNIT_TEST_DEPENDENCIES),
)

rust_test(
    name = "hepta-agentd-cognitive-readonly-product-test-bin",
    srcs = ["tests/cognitive_product_e2e.rs"] + glob(["tests/support/**/*.rs"]),
    crate_features = [],
    crate_name = "cognitive_product_e2e",
    crate_root = "tests/cognitive_product_e2e.rs",
    data = glob(["tests/support/**"]),
    edition = "2024",
    rustc_flags = WINDOWS_RUSTC_LINK_FLAGS + [
        "--remap-path-prefix=../codex-rs=",
        "--remap-path-prefix=codex-rs=",
    ],
    tags = ["manual"],
    target_compatible_with = _DURABLE_OWNER_COMPATIBILITY,
    visibility = ["//visibility:private"],
    deps = [":hepta-agentd-cognitive-readonly-product-lib"] + rust_test_dependencies(
        _UNIT_TEST_DEPENDENCIES,
        normal_dev = True,
    ),
)

workspace_root_test(
    name = "hepta-agentd-cognitive-readonly-product-test",
    timeout = "long",
    args = [
        "--exact",
        "unavailable_cognitive_store_keeps_read_tools_and_omits_write_tools",
    ],
    runfile_env = {
        ":hepta-agentd-cognitive-readonly-product-bin": "CARGO_BIN_EXE_codex-hepta-agentd",
    },
    target_compatible_with = _DURABLE_OWNER_COMPATIBILITY,
    test_bin = ":hepta-agentd-cognitive-readonly-product-test-bin",
    test_threads = 1,
    visibility = ["//visibility:public"],
    workspace_root_marker = "//codex-rs/utils/cargo-bin:repo_root.marker",
)

# Caller evidence inspected by the Hepta contracts tests.
exports_files(
    [
        "src/config.rs",
        "src/config_tests.rs",
        "src/intuition_policy.rs",
        "src/runtime_tests.rs",
        "tests/cognitive_product_e2e.rs",
        "tests/five_agent_rolling_upgrade.rs",
        "tests/supervisord_product_e2e.rs",
    ],
    visibility = ["//codex-rs/hepta-contracts:__pkg__"],
)
