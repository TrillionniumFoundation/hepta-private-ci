load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("//:defs.bzl", "codex_rust_crate")

copy_file(
    name = "windows_sandbox_setup_test_resource",
    src = "//codex-rs/windows-sandbox-rs:codex-windows-sandbox-setup",
    out = "resources/codex-windows-sandbox-setup.exe",
)

copy_file(
    name = "windows_command_runner_test_resource",
    src = "//codex-rs/windows-sandbox-rs:codex-command-runner",
    out = "resources/codex-command-runner.exe",
)

codex_rust_crate(
    name = "exec-server",
    crate_name = "codex_exec_server",
    deps_extra = [
        "@crates//:opentelemetry",
        "@crates//:opentelemetry_sdk",
        "@crates//:toml",
    ],
    extra_binaries = [
        "//codex-rs/bwrap:bwrap",
    ],
    integration_compile_data_extra = [
        "src/proto/codex.exec_server.relay.v1.rs",
    ],
    # Keep the crate's tests single-threaded under Bazel because they install
    # process-global test-binary dispatch state, and the remote exec-server
    # cases already rely on serialization around the full CLI path.
    integration_test_args = ["--test-threads=1"],
    # The test binary also runs as the exec server, so it needs the same
    # sibling resources as a packaged Windows executable.
    test_data_extra = [
        ":windows_command_runner_test_resource",
        ":windows_sandbox_setup_test_resource",
    ],
    test_tags = ["no-sandbox"],
    unit_test_args = ["--test-threads=1"],
)
