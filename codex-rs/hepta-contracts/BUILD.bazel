# Local AuthBus models stay isolated from the product library's feature set.
# Integration fixtures do not compile the caller-manifest unit tests or need
# their product-source runfiles.
rust_library(
    name = "hepta-contracts-authbus-qualification-lib",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["fixtures/AUTHBUS_SOURCE_MANIFEST.v1.json"],
    crate_features = ["authbus-local-qualification"],
    crate_name = "codex_hepta_contracts",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:private"],
    deps = all_crate_deps(),
)

rust_test(
    name = "hepta-contracts-authbus-local-qualification-test-bin",
    srcs = ["tests/authbus_local_qualification.rs"],
    crate_features = ["authbus-local-qualification"],
    crate_name = "authbus_local_qualification",
    crate_root = "tests/authbus_local_qualification.rs",
    edition = "2024",
    rustc_flags = WINDOWS_RUSTC_LINK_FLAGS,
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = [":hepta-contracts-authbus-qualification-lib"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

