[Unit]
Description=Hepta secrets issuer, protected host time and external frontier
After=local-fs.target

[Service]
Type=simple
User=hepta-secrets-authority
Group=hepta-secrets-runtime
ExecStart=/usr/local/libexec/hepta-secrets-runtime serve-authority /etc/hepta-secrets/authority.json
StateDirectory=hepta-secrets-authority
StateDirectoryMode=0700
RuntimeDirectory=hepta-secrets-authority
RuntimeDirectoryMode=0750
UMask=0077
TimeoutStopSec=12s
KillSignal=SIGTERM
SendSIGKILL=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/hepta-secrets-authority /run/hepta-secrets-authority

[Install]
WantedBy=multi-user.target
