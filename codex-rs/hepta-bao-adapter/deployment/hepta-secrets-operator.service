[Unit]
Description=Hepta independent secrets approval and revocation operator
After=hepta-secrets-authority.service
Requires=hepta-secrets-authority.service

[Service]
Type=simple
User=hepta-secrets-operator
Group=hepta-secrets-runtime
ExecStart=/usr/local/libexec/hepta-secrets-runtime serve-operator /etc/hepta-secrets/operator.json
StateDirectory=hepta-secrets-operator
StateDirectoryMode=0700
RuntimeDirectory=hepta-secrets-operator
RuntimeDirectoryMode=0750
UMask=0077
TimeoutStopSec=12s
KillSignal=SIGTERM
SendSIGKILL=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/hepta-secrets-operator /run/hepta-secrets-operator

[Install]
WantedBy=multi-user.target
