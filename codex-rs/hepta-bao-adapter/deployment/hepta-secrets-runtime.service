[Unit]
Description=Hepta protected original secrets runtime and AuthBus saga
After=hepta-secrets-authority.service hepta-secrets-operator.service hepta-secrets-consumer.service hepta-openbao-private-ci.service
Requires=hepta-secrets-authority.service hepta-secrets-operator.service hepta-secrets-consumer.service hepta-openbao-private-ci.service

[Service]
Type=simple
User=hepta-secrets-runtime
Group=hepta-secrets-runtime
ExecStart=/usr/local/libexec/hepta-secrets-runtime serve-runtime /etc/hepta-secrets/runtime.json
StateDirectory=hepta-secrets-runtime
StateDirectoryMode=0700
RuntimeDirectory=hepta-secrets-runtime
RuntimeDirectoryMode=0750
UMask=0077
TimeoutStopSec=65s
KillSignal=SIGTERM
SendSIGKILL=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/hepta-secrets-runtime /run/hepta-secrets-runtime

[Install]
WantedBy=multi-user.target
