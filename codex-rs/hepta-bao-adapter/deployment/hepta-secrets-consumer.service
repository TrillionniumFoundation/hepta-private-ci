[Unit]
Description=Hepta independently authenticated credential consumer and ACK settlement
After=local-fs.target

[Service]
Type=simple
User=hepta-secrets-consumer
Group=hepta-secrets-runtime
ExecStart=/usr/local/libexec/hepta-secrets-runtime serve-consumer /etc/hepta-secrets/consumer.json
StateDirectory=hepta-secrets-consumer
StateDirectoryMode=0700
RuntimeDirectory=hepta-secrets-consumer
RuntimeDirectoryMode=0750
UMask=0077
TimeoutStopSec=12s
KillSignal=SIGTERM
SendSIGKILL=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/hepta-secrets-consumer /run/hepta-secrets-consumer

[Install]
WantedBy=multi-user.target
