load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "codex_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "codex_e2e_benchmark")

codex_rust_crate(
    name = "cli",
    crate_name = "codex_cli",
    extra_binaries = [
        "//codex-rs/bwrap:bwrap",
        "//codex-rs/windows-sandbox-rs:codex-command-runner",
        "//codex-rs/windows-sandbox-rs:codex-windows-sandbox-setup",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
    test_data_extra = glob(["src/**/snapshots/**"]),
    # These unsharded sandbox consumers need the same absolute helper runfiles
    # environment as the existing sharded Windows launcher.
    test_runfile_env = {
        "cli-sandbox_cloud_config-test": {
            "//codex-rs/windows-sandbox-rs:codex-command-runner": "CARGO_BIN_EXE_codex-command-runner",
            "//codex-rs/windows-sandbox-rs:codex-windows-sandbox-setup": "CARGO_BIN_EXE_codex-windows-sandbox-setup",
        },
    },
)

multiplatform_binaries(
    name = "codex",
)

multiplatform_binaries(
    name = "hepta",
    release_group_name = "hepta_release_binaries",
)

codex_e2e_benchmark(
    name = "codex-help",
    binaries = [":codex"],
)
