load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "hepta-fleet",
    compile_data = [
        "//:docs/modules/MODULES.json",
        "src/durable_execution_schema.sql",
        "src/durable_schema.sql",
    ],
    crate_name = "codex_hepta_fleet",
)

# Match Supervisor's Cargo dev feature without changing ordinary Fleet identity.
rust_library(
    name = "hepta-fleet-supervisor-owner-test-lib",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "//:docs/modules/MODULES.json",
        "src/durable_execution_schema.sql",
        "src/durable_schema.sql",
    ],
    crate_features = ["durable-store"],
    crate_name = "codex_hepta_fleet",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = [
        "//codex-rs/hepta-agent-protocol:__pkg__",
        "//codex-rs/hepta-supervisor:__pkg__",
    ],
    deps = all_crate_deps() + [
        "//codex-rs/state",
        "@crates//:sqlx",
    ],
)
