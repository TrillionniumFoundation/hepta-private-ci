load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "skills",
    compile_data = glob(
        include = ["**"],
        allow_empty = True,
        exclude = [
            "**/* *",
            "BUILD.bazel",
            "Cargo.toml",
        ],
    ),
    crate_name = "codex_skills",
    # Cargo renames serde_norway to serde_yaml; Bazel must pass the same --extern name.
    use_cargo_renamed_deps = True,
)
