load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "skills",
    compile_data = glob(
        include = ["**"],
        allow_empty = True,
        exclude = [
            "**/* *",
            "BUILD.bazel",
            "Cargo.toml",
        ],
    ),
    crate_name = "codex_skills",
    # The source uses serde_yaml; Cargo declares it, but Bazel's generated
    # dependency bucket on this exact lock is missing the direct binding.
    deps_extra = ["@crates//:serde_yaml"],
)
