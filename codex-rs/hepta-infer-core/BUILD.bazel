load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "hepta-infer-core",
    crate_name = "codex_hepta_infer_core",
)

rust_library(
    name = "hepta-infer-core-qualification-lib",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["qualification-control-snapshot"],
    crate_name = "codex_hepta_infer_core",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//codex-rs:__subpackages__"],
    deps = all_crate_deps(),
)

rust_test(
    name = "hepta-infer-core-snapshot-test",
    crate = ":hepta-infer-core-qualification-lib",
    crate_features = ["qualification-control-snapshot"],
    edition = "2024",
)
