load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "hepta-intelligence-eval",
    crate_features = ["fixed-eval-host"],
    crate_name = "codex_hepta_intelligence_eval",
    # Enabling a feature here does not add its optional Cargo externs to Bazel.
    deps_extra = [
        "@crates//:ed25519-dalek",
        "@crates//:rustix",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
    integration_compile_data_extra = [
        "fixtures/trusted-inprocess/tests/operator_claim.rs",
    ],
    # Whole cold-process matrices and the 256-attempt synced restart soak
    # retain every cut; their harness timeout is not a product latency gate.
    integration_test_timeout = "long",
    test_data_extra = [
        "src/lib.rs",
        "//:tools/hepta_encode_paired_plan_inputs.py",
    ],
    unit_test_dependency_replacements = {
        "//codex-rs/hepta-learning-ledger": "//codex-rs/hepta-learning-ledger:hepta-learning-ledger-qualification-lib",
    },
    unit_test_timeout = "long",
)

filegroup(
    name = "selected_host_shared_fixture_sources",
    srcs = [
        "tests/selected_host_recovery_support/cold_storage.rs",
        "tests/selected_host_recovery_support/cold_trust.rs",
        "tests/selected_host_recovery_support/eligible_model.rs",
    ],
    visibility = ["//codex-rs/hepta-agentd:__pkg__"],
)
