+#[test]
+fn execution_target_restart_replays_same_committed_receipt() {
+    let fixture = Fixture::new();
+    let native = native_config();
+    let config = runtime_config(&native);
+    let witness = MemoryWitness::for_config(&config);
+    let mut runtime = checked(NeuronRuntime::bootstrap(
+        fixture.file(), native.clone(), scope(), /*max_records*/ 4,
+        config.clone(), witness.clone(),
+    ));
+    let mut model = FakeModel::new();
+    let request = input(1, Digest32::ZERO);
+    let first = checked(runtime.tick(&mut model, request.clone()));
+    let anchor = match checked(runtime.current_anchor()) {
+        Some(anchor) => anchor,
+        None => panic!("successful tick has no anchor"),
+    };
+    drop(runtime);
+    let mut recovered = checked(NeuronRuntime::recover(
+        fixture.file(), native, scope(), /*max_records*/ 4,
+        config, anchor, witness,
+    ));
+    let replay = checked(recovered.tick(&mut model, request));
+    assert_eq!(replay, first);
+    assert_eq!(model.calls, 1);
+}
+
+#[test]
+fn execution_target_reused_tick_id_with_changed_semantics_conflicts() {
+    let fixture = Fixture::new();
+    let native = native_config();
+    let config = runtime_config(&native);
+    let mut runtime = checked(NeuronRuntime::bootstrap(
+        fixture.file(), native, scope(), /*max_records*/ 4,
+        config.clone(), MemoryWitness::for_config(&config),
+    ));
+    let mut model = FakeModel::new();
+    let request = input(1, Digest32::ZERO);
+    let tick_id = request.tick_id.clone();
+    let first = checked(runtime.tick(&mut model, request));
+    let mut changed = input(2, first.tick.checkpoint_after);
+    changed.tick_id = tick_id;
+    let result = runtime.tick(&mut model, changed);
+    assert!(result.is_err(), "a reused tick ID with changed semantics was accepted");
+    assert_eq!(model.calls, 1);
+}
