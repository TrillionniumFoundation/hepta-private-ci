load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "aws-config",
    compile_data = glob(["src/**/*.md"]),
    crate_edition = "2021",
    # Match the actual workspace Cargo resolve features; metadata alone does
    # not supply these cfgs to codex_rust_crate's local rust_library target.
    crate_features = [
        "credentials-login",
        "credentials-process",
        "default",
        "default-https-client",
        "rt-tokio",
        "sso",
    ],
    crate_name = "aws_config",
    # Preserve upstream IMDS API metadata for this local source target.
    rustc_env = {"CARGO_PKG_VERSION": "1.8.12"},
)

# crate.from_cargo resolves the reviewed local patch by its versioned directory.
alias(
    name = "aws-config-1.8.12",
    actual = ":aws-config",
    visibility = ["//visibility:public"],
)
