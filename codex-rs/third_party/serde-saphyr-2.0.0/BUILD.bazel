load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")

filegroup(
    name = "package-files",
    srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    visibility = ["//visibility:public"],
)

# Upstream dev-dependencies are not part of the production workspace. The
# first-party YAML consumer owns the parser compatibility regression target.
rust_library(
    name = "serde-saphyr",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["README.md"],
    crate_features = [
        "comments",
        "default",
        "deserialize",
        "hepta-legacy-scalars",
        "serialize",
    ],
    crate_name = "serde_saphyr",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "2.0.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)
