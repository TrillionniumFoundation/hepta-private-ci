load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")

filegroup(
    name = "package-files",
    srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "secret-service",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["crypto-rust"],
    crate_name = "secret_service",
    crate_root = "src/lib.rs",
    edition = "2021",
    version = "4.0.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)
