+    fn edit_text(&self, offsets: Option<(i32, i32)>, operation: TextEditOperation) -> Result<bool> {
+        if matches!(&operation, TextEditOperation::Replace(value)
+            if value.len() > Self::MAX_EDIT_BYTES || value.contains('\0'))
