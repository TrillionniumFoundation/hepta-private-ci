load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")

filegroup(
    name = "workspace-files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

# Preserve the original external dependency's library target. The published
# crate excludes upstream test fixtures; product extraction tests remain in
# codex-core-plugins and exercise the selected compression implementations.
rust_library(
    name = "zip",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["README.md"],
    crate_features = [
        "_bzip2_any",
        "_deflate-any",
        "aes-crypto",
        "bzip2-rs",
        "deflate",
        "deflate-flate2",
        "deflate-flate2-zlib-rs",
        "deflate-zopfli",
        "deflate64",
        "getrandom",
        "lzma",
        "time",
        "xz",
        "zstd",
    ],
    crate_name = "zip",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_env = {"CARGO_PKG_VERSION": "9.0.0"},
    visibility = ["//visibility:public"],
    deps = all_crate_deps(),
)
