load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "hepta-operator-acceptance-lib",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "codex_hepta_operator_acceptance",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:private"],
    deps = all_crate_deps(),
)

rust_test(
    name = "hepta-operator-acceptance-tests",
    crate = ":hepta-operator-acceptance-lib",
    rustc_flags = select({
        "@platforms//os:windows": [
            "-Aunused-imports",
            "-Aunused-variables",
        ],
        "//conditions:default": [],
    }),
    # CI provisions original system OpenSSH on the native runner. Keep this
    # test out of remote execution and cross-host result reuse.
    tags = [
        "no-remote-cache",
        "no-remote-exec",
    ],
    deps = [
        "@crates//:pretty_assertions",
        "@crates//:tempfile",
    ],
)

rust_binary(
    name = "hepta-operator-acceptance",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2024",
    visibility = ["//visibility:private"],
    deps = [
        ":hepta-operator-acceptance-lib",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "hepta-g5-trust-assessor",
    srcs = ["src/g5_main.rs"],
    crate_root = "src/g5_main.rs",
    edition = "2024",
    visibility = ["//visibility:private"],
    deps = [
        ":hepta-operator-acceptance-lib",
        "@crates//:serde_json",
    ],
)
