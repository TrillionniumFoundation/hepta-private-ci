load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# Cargo's current-EUID operator config check uses the already-locked rustix
# 1.1.4 only on Unix. Keep Bazel's product and native test crate in sync;
# a Cargo PASS alone does not qualify the release-build/clippy targets.
_UNIX_RUSTIX_DEPS = select({
    "@platforms//os:windows": [],
    "//conditions:default": ["@crates//:rustix"],
})

rust_library(
    name = "hepta-operator-acceptance-lib",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "codex_hepta_operator_acceptance",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//codex-rs/hepta-supervisor:__pkg__"],
    deps = [
        "//codex-rs/hepta-neuron",
        "//codex-rs/hepta-types",
        "@crates//:base64",
        "@crates//:ed25519-dalek",
        "@crates//:libc",
        "@crates//:rand",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:thiserror",
    ] + _UNIX_RUSTIX_DEPS + select({
        "@platforms//os:windows": ["@crates//:winapi-util"],
        "//conditions:default": [],
    }),
)

rust_test(
    name = "hepta-operator-acceptance-tests",
    crate = ":hepta-operator-acceptance-lib",
    rustc_flags = select({
        "@platforms//os:windows": [
            "-Aunused-imports",
            "-Aunused-variables",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "@crates//:pretty_assertions",
        "@crates//:tempfile",
    ] + _UNIX_RUSTIX_DEPS,
)

rust_binary(
    name = "hepta-operator-acceptance",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2024",
    visibility = ["//visibility:private"],
    deps = [
        ":hepta-operator-acceptance-lib",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "hepta-g5-trust-assessor",
    srcs = ["src/g5_main.rs"],
    crate_root = "src/g5_main.rs",
    edition = "2024",
    visibility = ["//visibility:private"],
    deps = [
        ":hepta-operator-acceptance-lib",
        "@crates//:serde_json",
    ],
)
