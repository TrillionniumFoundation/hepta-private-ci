load("@crates//:data.bzl", "DEP_DATA")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:defs.bzl", "codex_rust_crate")
load("//bazel/rules:cargo_crate_aliases.bzl", "cargo_crate_aliases")
load("//bazel/rules/testing:qualification_lease_clock.bzl", "qualification_lease_clock_library")
load("//bazel/rules/testing:rust_test_dependencies.bzl", "rust_test_dependencies")
load(":joint_generation.bzl", "joint_generation_binary")

_UNIT_TEST_DEPENDENCIES = {
    "//codex-rs/app-server-client": "//codex-rs/app-server-client:app-server-client-test-lib",
    "//codex-rs/hepta-codex-adapter": "//codex-rs/hepta-codex-adapter:hepta-codex-adapter-test-lib",
    "//codex-rs/hepta-infer-core": "//codex-rs/hepta-infer-core:hepta-infer-core-test-lib",
}

_COMPOSITION_FEATURES = [
    "composition-model-driver-qualification",
    "legacy-local-model-boundary",
]

codex_rust_crate(
    name = "hepta-infer-worker-host",
    crate_name = "codex_hepta_infer_worker_host",
    integration_test_dependency_replacements = {
        "tests/generation_owner_execution.rs": _UNIT_TEST_DEPENDENCIES | {
            "//codex-rs/hepta-infer-worker-host": ":hepta-infer-worker-host-composition-qualification-lib",
        },
    },
    integration_test_features = {"tests/generation_owner_execution.rs": _COMPOSITION_FEATURES},
    unit_test_dependency_replacements = _UNIT_TEST_DEPENDENCIES,
)

# Mirror Cargo's required-features only for the named generation qualifications.
# Default libraries, binaries, unit tests and other integration tests retain
# their existing feature/dependency graph.
rust_library(
    name = "hepta-infer-worker-host-composition-qualification-lib",
    testonly = True,
    srcs = glob(
        ["src/**/*.rs"],
        exclude = DEP_DATA["codex-rs/hepta-infer-worker-host"]["binaries"].values(),
    ),
    aliases = cargo_crate_aliases(workspace_replacements = _UNIT_TEST_DEPENDENCIES),
    crate_features = _COMPOSITION_FEATURES,
    crate_name = "codex_hepta_infer_worker_host",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_env = {"BAZEL_PACKAGE": "codex-rs/hepta-infer-worker-host"},
    visibility = ["//codex-rs/hepta-agentd:__pkg__"],
    deps = rust_test_dependencies(_UNIT_TEST_DEPENDENCIES),
)

joint_generation_binary()

qualification_lease_clock_library(
    name = "hepta-infer-worker-host",
    base_replacements = {
        "//codex-rs/hepta-infer-core": "//codex-rs/hepta-infer-core:hepta-infer-core-test-lib",
    },
    crate_name = "codex_hepta_infer_worker_host",
)
