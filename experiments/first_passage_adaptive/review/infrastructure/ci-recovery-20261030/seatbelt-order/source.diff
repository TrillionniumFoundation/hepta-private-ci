         .expect("seatbelt args should include policy text")
 }
 
+fn seatbelt_writable_parameter_paths(args: &[String]) -> Vec<String> {
+    let policy = seatbelt_policy_arg(args);
+    let mut names = std::collections::BTreeSet::new();
+    let mut parameters = args
+        .iter()
+        .filter(|arg| arg.starts_with("-DWRITABLE_ROOT_"))
+        .map(|arg| {
+            let (name, path) = arg
+                .strip_prefix("-D")
+                .expect("writable parameter prefix")
+                .split_once('=')
+                .expect("writable parameter value");
+            assert!(names.insert(name), "duplicate writable parameter {name}");
+            let name = if let Some((root, _)) = name.split_once("_EXCLUDED_") {
+                // Exclusion numbers only bind parameters within the policy.
+                // Preserve every path and verify both deny predicates before
+                // comparing their order-independent assignment to a root.
+                for matcher in ["literal", "subpath"] {
+                    assert!(
+                        policy.contains(&format!("(require-not ({matcher} (param \"{name}\")))")),
+                        "missing {matcher} exclusion for {name}: {policy}"
+                    );
+                }
+                format!("{root}_EXCLUDED")
+            } else {
+                name.to_string()
+            };
+            format!("-D{name}={path}")
+        })
+        .collect::<Vec<_>>();
+    parameters.sort();
+    parameters
+}
