+@dataclass(frozen=True, slots=True)
+class FinalizationBudget:
+    head_seconds: float = .08
+    serialization_seconds: float = .04
+    sink_seconds: float = .08
+    guard_seconds: float = .20
+
+    def __post_init__(self):
