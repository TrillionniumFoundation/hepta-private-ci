diff --git a/codex-rs/Cargo.toml b/codex-rs/Cargo.toml
--- a/codex-rs/Cargo.toml
+++ b/codex-rs/Cargo.toml
@@ -437,7 +437,7 @@
 log = "0.4"
 lru = "0.18.2"
 maplit = "1.0.2"
-matrix-sdk = { version = "0.18.0", default-features = false, features = ["e2e-encryption", "sqlite"] }
+matrix-sdk = { version = "=0.19.1", default-features = false, features = ["e2e-encryption", "sqlite", "rustls-aws-lc-rs"] }
 memchr = "2.7.6"
 mime_guess = "2.0.5"
 multimap = "0.10.0"
@@ -661,15 +661,13 @@
 opt-level = 0
 
 [patch.crates-io]
-# Matrix SDK/eyeball-im still require imbl 6.x. Backport the upstream 7.0.2
-# bitmap import and patched chunk dependency without changing their public API.
-imbl = { path = "third_party/imbl-6.1.0" }
-# Matrix SDK 0.18.0 pins rusqlite 0.37/libsqlite3-sys 0.35. Hepta's SQLx 0.9
-# deliberately uses libsqlite3-sys 0.37 for the WAL-reset corruption fix, and
-# Cargo permits only one native SQLite `links` crate in a graph. The vendored
-# crate is upstream matrix-sdk-sqlite 0.18.0 with only its rusqlite constraint
-# advanced to 0.39, which uses the already-selected libsqlite3-sys 0.37.
-matrix-sdk-sqlite = { path = "third_party/matrix-sdk-sqlite-0.18.0" }
+# Backport the official anymap3 migration onto the published SDK 0.19.1.
+# Matrix 0.19 already uses the maintained upstream imbl >=7.0.2.
+matrix-sdk = { path = "third_party/matrix-sdk-0.19.1" }
+# Preserve SQLx 0.9's patched libsqlite3-sys 0.37 native links graph.
+# The actual 0.19.1 SQLite backend uses the audited rusqlite 0.39 API
+# with its original limits/cache/fallible_uint features and migrations.
+matrix-sdk-sqlite = { path = "third_party/matrix-sdk-sqlite-0.19.1" }
 # Uncomment to debug local changes.
 # ratatui = { path = "../../ratatui" }
 crossterm = { git = "https://github.com/openai-oss-forks/crossterm", rev = "45fecb9508105988f42fe6ff0441783ed3717f92" }
