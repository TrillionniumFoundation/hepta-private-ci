diff --git a/codex-rs/core-plugins/src/startup_sync.rs b/codex-rs/core-plugins/src/startup_sync.rs
--- a/codex-rs/core-plugins/src/startup_sync.rs
+++ b/codex-rs/core-plugins/src/startup_sync.rs
@@ -36,6 +36,7 @@
 const CURATED_PLUGINS_GIT_TIMEOUT: Duration = Duration::from_secs(30);
 const CURATED_PLUGINS_HTTP_TIMEOUT: Duration = Duration::from_secs(30);
 const CURATED_PLUGINS_BACKUP_ARCHIVE_TIMEOUT: Duration = Duration::from_secs(30);
+const ZIP_UTF8_FILENAME_FLAG: u16 = 1 << 11;
 // Keep this comfortably above a normal sync attempt so we do not race another Codex process.
 const CURATED_PLUGINS_STALE_TEMP_DIR_MAX_AGE: Duration = Duration::from_secs(10 * 60);
 #[derive(Debug, Deserialize)]
@@ -1051,6 +1052,16 @@
         let mut entry = archive
             .by_index(index)
             .map_err(|err| format!("failed to read curated plugins zip entry: {err}"))?;
+        // The reader falls back to CP437 even when the ZIP flags declare UTF-8.
+        // Reject a false declaration before using the decoded name as a path.
+        if entry.flags().as_u16() & ZIP_UTF8_FILENAME_FLAG != 0
+            && std::str::from_utf8(entry.name_raw()).is_err()
+        {
+            return Err(
+                "curated plugins zip entry declares UTF-8 but has invalid filename bytes"
+                    .to_string(),
+            );
+        }
         let name = entry
             .name()
             .map_err(|err| format!("failed to read curated plugins zip entry name: {err}"))?;
diff --git a/codex-rs/core-plugins/src/startup_sync_zip_tests.rs b/codex-rs/core-plugins/src/startup_sync_zip_tests.rs
--- a/codex-rs/core-plugins/src/startup_sync_zip_tests.rs
+++ b/codex-rs/core-plugins/src/startup_sync_zip_tests.rs
@@ -71,9 +71,11 @@
     let mode = 0o107755_u32;
     archive[central + 38..central + 42].copy_from_slice(&(mode << 16).to_le_bytes());
     let mut reader = ZipArchive::new(Cursor::new(&archive)).expect("reopen hostile ZIP");
+    // unix_mode() already clears privileged bits in zip 9. Verify the actual
+    // untrusted header metadata instead, then check the resulting filesystem.
     assert_eq!(
-        reader.by_index(0).expect("read hostile ZIP entry").unix_mode(),
-        Some(mode)
+        reader.by_index(0).expect("read hostile ZIP entry").external_attributes() >> 16,
+        mode
     );
 
     extract_zipball_to_dir(&archive, destination.path()).expect("extract hostile ZIP");
@@ -119,11 +121,50 @@
     archive[30] = 0xff;
     archive[central + 46] = 0xff;
 
-    extract_zipball_to_dir(&archive, destination.path()).expect_err("reject invalid UTF-8 name");
+    let error =
+        extract_zipball_to_dir(&archive, destination.path()).expect_err("reject invalid UTF-8 name");
+    assert!(error.contains("declares UTF-8"));
 
     assert_eq!(
         std::fs::read_dir(destination.path()).expect("read extraction directory").count(),
         0
+    );
+}
+
+#[test]
+fn zipball_extraction_preserves_valid_utf8_names() {
+    let destination = tempdir().expect("create extraction directory");
+    let archive = zipball_with_file("archive/plugin/café-中文.sh", CompressionMethod::Stored);
+    let flags = u16::from_le_bytes(archive[6..8].try_into().expect("local ZIP flags"));
+    assert_ne!(flags & 0x800, 0, "fixture must declare UTF-8");
+
+    extract_zipball_to_dir(&archive, destination.path()).expect("extract valid UTF-8 name");
+
+    assert_eq!(
+        std::fs::read(destination.path().join("plugin/café-中文.sh")).expect("read UTF-8 plugin"),
+        CONTENTS
+    );
+}
+
+#[test]
+fn zipball_extraction_preserves_legacy_cp437_names() {
+    let destination = tempdir().expect("create extraction directory");
+    let mut archive = zipball_with_file("archive/plugin/cafX.sh", CompressionMethod::Stored);
+    let central = archive
+        .windows(4)
+        .position(|bytes| bytes == b"PK\x01\x02")
+        .expect("find central-directory record");
+    let flags = u16::from_le_bytes(archive[6..8].try_into().expect("local ZIP flags"));
+    assert_eq!(flags & 0x800, 0, "legacy fixture must not declare UTF-8");
+    let name_offset = b"archive/plugin/caf".len();
+    archive[30 + name_offset] = 0x82;
+    archive[central + 46 + name_offset] = 0x82;
+
+    extract_zipball_to_dir(&archive, destination.path()).expect("extract CP437 name");
+
+    assert_eq!(
+        std::fs::read(destination.path().join("plugin/café.sh")).expect("read CP437 plugin"),
+        CONTENTS
     );
 }
 
