    "provider": {"type": "object","required": ["kind","identity"],"properties": {"kind": {"enum": ["http","local"]},"identity": {"$ref": "#/$defs/identity"},"argv": {"type": "array","items": {"type": "string"},"minItems": 1},"url_env": {"type": "string"},"key_env": {"type": "string"},"auth_header": {"type": "string"},"auth_prefix": {"type": "string"},"client_request_header": {"type": "string"},"wire_format": {"enum": ["native","openai_chat"]},"decoding": {"type": "object"},"response_map": {"type": "object","additionalProperties": {"type": "array","items": {"type": ["string","integer"]}}}}},
    "task": {"type": "object","required": ["id","family","cluster","source_groups","sha256","verifier_sha256","weight"],"properties": {"id": {"type": "string","minLength": 1},"family": {"type": "string","minLength": 1},"cluster": {"type": "string","minLength": 1},"source_groups": {"type": "array","items": {"type": "string","minLength": 1},"minItems": 1,"uniqueItems": true},"sha256": {"$ref": "#/$defs/hash"},"verifier_sha256": {"$ref": "#/$defs/hash"},"weight": {"type": "number","exclusiveMinimum": 0}}},
    "protocol": {"type": "object","required": ["schema","status","frozen_at","identity","arms","transport_sha256","decoding_sha256","design","alpha","repeats","currency","currency_to_score","deployment_volume","precision_h","deadline_seconds","time_price","max_service_cost","gain_min","families","tasks","comparisons","M","lifecycle_plan"],"properties": {"schema": {"const": "ndu.confirmation.protocol.v1"},"status": {"const": "FROZEN"},"frozen_at": {"type": "string","format": "date-time"},"identity": {"allOf": [{"$ref": "#/$defs/identity"},{"required": ["evidence_sha256"],"properties": {"kind": {"const": "frozen_llm"}}}]},"arms": {"type": "object","required": ["direct_stop","fixed_budget","one_step_voi","strong_planner","full"],"additionalProperties": {"type": "object","required": ["source_sha256"],"properties": {"source_sha256": {"$ref": "#/$defs/hash"}}}},"transport_sha256": {"$ref": "#/$defs/hash"},"decoding_sha256": {"$ref": "#/$defs/hash"},"design": {"type": "object","required": ["split_sha256","order_sha256","price_card_sha256","cost_cap_evidence_sha256","strong_planner_qualification_sha256","source_independence_attested","shared_shocks_clustered","state_reset","hard_cost_cap_enforced"],"properties": {"split_sha256": {"$ref": "#/$defs/hash"},"order_sha256": {"$ref": "#/$defs/hash"},"price_card_sha256": {"$ref": "#/$defs/hash"},"cost_cap_evidence_sha256": {"$ref": "#/$defs/hash"},"strong_planner_qualification_sha256": {"$ref": "#/$defs/hash"},"source_independence_attested": {"const": true},"shared_shocks_clustered": {"const": true},"state_reset": {"const": true},"hard_cost_cap_enforced": {"const": true}}},"alpha": {"const": 0.05},"repeats": {"type": "integer","minimum": 1},"currency": {"type": "string","minLength": 1},"currency_to_score": {"type": "number","exclusiveMinimum": 0},"deployment_volume": {"type": "integer","minimum": 1},"precision_h": {"type": "number","exclusiveMinimum": 0},"deadline_seconds": {"type": "number","exclusiveMinimum": 0},"time_price": {"