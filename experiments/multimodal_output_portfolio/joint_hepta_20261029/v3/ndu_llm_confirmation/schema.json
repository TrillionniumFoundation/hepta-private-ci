    "episode": {"type": "object","required": ["schema","task_id","arm","repeat","protocol_sha256","task_sha256","verifier_sha256","method_sha256","started_at","wall_seconds","quality","terminal","stop_requested","delivery_at_seconds","request_ids","contract"],"properties": {"contract": {"type": "object","required": ["deadline_seconds","currency_to_score","time_price"],"properties": {"deadline_seconds": {"$ref": "#/$defs/nonnegative"},"currency_to_score": {"$ref": "#/$defs/nonnegative"},"time_price": {"$ref": "#/$defs/nonnegative"}}},"schema": {"const": "ndu.confirmation.episode.v1"},"task_id": {"type": "string","minLength": 1},"arm": {"type": "string","minLength": 1},"repeat": {"type": "integer","minimum": 0},"protocol_sha256": {"$ref": "#/$defs/hash"},"task_sha256": {"$ref": "#/$defs/hash"},"verifier_sha256": {"$ref": "#/$defs/hash"},"method_sha256": {"$ref": "#/$defs/hash"},"started_at": {"type": "string","format": "date-time"},"wall_seconds": {"$ref": "#/$defs/nonnegative"},"quality": {"type": "number","minimum": 0,"maximum": 1},"terminal": {"enum": ["delivered","expired","cancelled","model_failure","verifier_failure","invalid_policy","decision_limit","planner_timeout","invalid_model_or_policy_output"]},"stop_requested": {"type": "boolean"},"delivery_at_seconds": {"type": ["number","null"],"minimum": 0},"request_ids": {"type": "array","minItems": 1,"uniqueItems": true,"items": {"type": "string"}}}},
    "event": {"oneOf": [{"$ref": "#/$defs/intent"},{"$ref": "#/$defs/terminal"},{"$ref": "#/$defs/meter"}]},
    "invoice": {"type": "object","required": ["request_id","status","amount","currency","invoice_sha256","line_id"],"properties": {"request_id": {"type": "string","minLength": 1},"status": {"const": "final"},"amount": {"$ref": "#/$defs/nonnegative"},"currency": {"type": "string","minLength": 1},"invoice_sha256": {"$ref": "#/$defs/hash"},"line_id": {"type": "string","minLength": 1},"usage": {"oneOf": [{"$ref": "#/$defs/usage"},{"type": "null"}]},"identity_sha256": {"$ref": "#/$defs/hash"},"provider_request_sha256": {"oneOf": [{"$ref": "#/$defs/hash"},{"type": "null"}]},"identity_evidence_sha256": {"$ref": "#/$defs/hash"}}},
    "lifecycle_invoice": {"type": "object","required": ["charge_id","status","amount","currency","invoice_sha256","line_id"],"properties": {"charge_id": {"type": "string","minLength": 1},"status": {"const": "final"},"amount": {"$ref": "#/$defs/nonnegative"},"currency": {"type": "string","minLength": 1},"invoice_sha256": {"$ref": "#/$defs/hash"},"line_id": {"type": "string","minLength": 1}}},
    "clock": {"type": "object","required": ["started_monotonic","finished_monotonic","wall_seconds","started_at","finished_at"],"properties": {"started_monotonic": {"$ref": "#/$defs/nonnegative"},"finished_monotonic": {"$ref": "#/$defs/nonnegative"},"wall_seconds": {"$ref": "#/$defs/nonnegative"},"started_at": {"type": "string","format": "date-time"},"finished_at": {"type": "string","format": "date-time"}}},
    "context": {"type": "object","required": ["task_id","arm","repeat","protocol_sha256"],"properties": {"task_id": {"type": "string","minLength": 1},"arm": {"type": "string","minLength": 1},"repeat": {"type": "integer","minimum": 0},"protocol_sha256": {"$ref": "#/$defs/hash"}}},
    "request_binding": {"allOf": [{"$ref": "#/$defs/context"}],"type": "object","required": ["schema","request_id","kind","request_sha256","transport_sha256","expected_identity_sha256","identity_kind","timeout_seconds","deadline_monotonic"],"properties": {"schema": {"const": "ndu.request.v2"},"request_id": {"type": "string","minLength": 1},"kind": {"enum": ["model","tool","verifier"]},"request_sha256": {"oneOf": [{"$ref": "#/$defs/hash"},{"type": "null"}]},"transport_sha256": {"$ref": "#/$defs/hash"},"expected_identity_sha256": {"$ref": "#/$defs/hash"},"identity_kind": {"enum": ["frozen_llm","offline_fixture","local_tool"]},"timeout_seconds": {"type": "number","exclusiveMinimum": 0},"deadline_monotonic": {"$ref": "#/$defs/nonnegative"}}},
    "intent": {"allOf": [{"$ref": "#/$defs/request_binding"}],"type": "object","required": ["phase","status","prepared_at","prepared_monotonic"],"properties": {"phase": {"const": "intent"},"status": {"const": "pending"},"prepared_at": {"type": "string","format": "date-time"},"prepared_monotonic": {"$ref": "#/$defs/nonnegative"}}},
    "terminal": {"allOf": [{"$ref": "#/$defs/request_binding"},{"$ref": "#/$defs/clock"}],"type": "object","required": ["phase","status","intent_sha256","intent_finished_monotonic","dispatched","dispatch_monotonic","response_received","identity_status","observed_identity_sha256","usage","usage_status","provider_request_sha256","actual_amount","reconciliation_status"],"properties": {"phase": {"const": "terminal"},"status": {"enum": ["ok","failure","timeout","invalid_response","identity_mismatch"]},"intent_sha256": {"$ref": "#/$defs/hash"},"intent_finished_monotonic": {"$ref": "#/$defs/nonnegative"},"dispatched": {"type": "boolean"},"dispatch_monotonic": {"type": ["number","null"],"minimum": 0},"response_received": {"type": "boolean"},"identity_status": {"enum": ["match","mismatch","unobserved","not_applicable"]},"observed_identity_sha256": {"oneOf": [{"$ref": "#/$defs/hash"},{"type": "null"}]},"usage": {"oneOf": [{"$ref": "#/$defs/usage"},{"type": "null"}]},"usage_status": {"enum": ["reported","unknown","not_applicable"]},"provider_request_sha256": {"oneOf": [{"$ref": "#/$defs/hash"},{"type": "null"}]},"actual_amount": {"type": "null"},"reconciliation_status": {"const": "pending"},"verified_quality": {"type": "number","minimum": 0,"maximum": 1}}},
    "meter": {"allOf": [{"$ref": "#/$defs/context"},{"$ref": "#/$defs/clock"}],"type": "object","required": ["schema","request_id","phase","kind","status","usage","usage_status","actual_amount","reconciliation_status","provider_request_sha256"],"properties": {"schema": {"const": "ndu.request.v2"},"request_id": {"type": "string","minLength": 1},"phase": {"const": "meter"},"kind": {"const": "host_envelope"},"status": {"const": "metered"},"usage": {"type": "null"},"usage_status": {"const": "not_applicable"},"actual_amount": {"type": "null"},"reconciliation_status": {"const": "pending"},"provider_request_sha256": {"type": "null"}}},
    "identity_receipt": {"type": "object","required": ["schema","request_id","model_id","revision","invoice_sha256","issuer"],"properties": {"schema": {"const": "ndu.provider.identity_receipt.v1"},"request_id": {"type": "string","minLength": 1},"model_id": {"type": "string","minLength": 1},"revision": {"type": "string","minLength": 1},"invoice_sha256": {"$ref": "#/$defs/hash"},"issuer": {"type": "string","minLength": 1}}},
    "policy_binding": {"type": "object","required": ["schema","module","qualname","source_sha256","code_sha256","globals_sha256","python"],"properties": {"schema": {"const": "ndu.audited_callback.v1"},"module": {"type": "string","minLength": 1},"qualname": {"type": "string","minLength": 1},"source_sha256": {"$ref": "#/$defs/hash"},"code_sha256": {"$ref": "#/$defs/hash"},"globals_sha256": {"$ref": "#/$defs/hash"},"python": {"type": "string","minLength": 1}},"additionalProperties": false}
  }
