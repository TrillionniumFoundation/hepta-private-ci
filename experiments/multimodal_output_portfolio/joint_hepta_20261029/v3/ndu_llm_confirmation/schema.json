    "nonnegative": {"type": "number","minimum": 0},
    "usage": {"type": "object","required": ["input_tokens","output_tokens"],"additionalProperties": false,"properties": {"input_tokens": {"type": "integer","minimum": 0},"output_tokens": {"type": "integer","minimum": 0},"cached_input_tokens": {"type": "integer","minimum": 0}}},
