{
  "schema": "hepta.analytic-event-neuron.protocol.v2",
  "base_commit": "0acfd9b27db910c180b0d8911f39aea469b7f864",
  "event_mode": "terminal",
  "event_order": [
    "put",
    "neutral",
    "call"
  ],
  "thresholds": [
    -0.6,
    0.6
  ],
  "horizons": [
    0.5,
    1.0,
    2.0
  ],
  "training_seeds": [
    11,
    23,
    37,
    53,
    71
  ],
  "rows": {
    "train": 384,
    "development": 128,
    "confirmation": 256,
    "each_mismatch": 256
  },
  "laws": {
    "training": "gaussian",
    "primary": "gaussian",
    "mismatch": [
      "drift_shift",
      "student_t"
    ]
  },
  "control": {
    "terminal_horizon": 2.0,
    "wait_duration": 1.0,
    "wait_cost": 0.07,
    "wait_observation_variance": 0.64,
    "repair_cost": 0.12,
    "repair_observation_variance": 0.04,
    "utility": "1 - squared_terminal_prediction_error - paid_action_costs",
    "severe_loss_threshold": -2.0,
    "cost_multipliers": [
      0.5,
      1,
      2,
      4
    ],
    "terms_rng": "SeedSequence([data_seed,0xAE71]), independent of physical-law RNG",
    "fixed_policy_references": [
      "always_stop",
      "always_repair",
      "always_wait",
      "always_wait_repair"
    ]
  },
  "primary_contrasts": [
    {
      "id": "analytic_vs_history",
      "candidate": "analytic",
      "baseline": "history"
    },
    {
      "id": "pulse_vs_probability",
      "candidate": "pulse",
      "baseline": "analytic"
    },
    {
      "id": "analytic_vs_native",
      "candidate": "analytic",
      "baseline": "native"
    }
  ],
  "reference_contrasts": [
    "analytic_vs_equivalent_gaussian",
    "analytic_vs_fixed",
    "analytic_vs_known_law_oracle"
  ],
  "statistics": {
    "unit": "independent_training_seed_and_whole_environment_trajectory",
    "paired_environment": true,
    "family_alpha": 0.05,
    "primary_family_size": 3,
    "bootstrap_replicates": 4000,
    "bootstrap_seed": 80827,
    "interval": "two_stage_paired_seed_and_trajectory_percentile_bonferroni",
    "minimum_useful_net_utility_gain": 0.01,
    "superiority": "family_adjusted_lower_endpoint > 0.01 AND every_training_seed_mean_difference > 0",
    "mismatch_noninferiority_margin": 0.02,
    "multiple_horizons_are_independent": false,
    "mismatch_scope": "descriptive intervals only; no population NI claim; Student-t4 fourth moment does not exist"
  },
  "execution": {
    "freeze_protocol_and_executable_sources_before_confirmation": true,
    "retain_all_model_and_seed_results": true,
    "no_confirmation_tuning": true,
    "observe_from_actual_readback": true,
    "score_submitted_artifact_after_delivery": true,
    "native_kernel_must_be_compiled_from_verified_original_sources": true,
    "known_law_oracle_is_privileged": true,
    "original_blockers_relabelled_as_closed": false,
    "production_selection": false
  },
  "preconfirmation_revision": {
    "reason": "development-only oracle always wait-then-repair under fixed tariffs; introduce public independent costs before confirmation",
    "confirmation_accessed": false,
    "prior_protocol_commit": "7b284b6ba140408b2568188601314caa3de1ad39"
  },
  "training": {
    "auxiliary_horizon_zero": true,
    "contexts": [
      "initial",
      "repair",
      "wait",
      "wait_repair"
    ],
    "objective": "composite conditional Gaussian score; no claim of stage/horizon independence",
    "readout_ridge_candidates": [
      0.1,
      1.0,
      10.0
    ],
    "variance_calibration": "development only"
  },
  "data_seed_mapping": {
    "train": "10000 + training_seed",
    "development": "20000 + training_seed",
    "confirmation_gaussian": "30000 + training_seed",
    "confirmation_drift_shift": "40000 + training_seed",
    "confirmation_student_t": "50000 + training_seed"
  },
  "secondary_mechanism_contrasts": [
    "pulse_vs_mean_drive",
    "pulse_vs_pulse_no_reset"
  ],
  "retention": {
    "windows": [
      "drift_shift",
      "gaussian",
      "drift_shift"
    ],
    "training_trajectories_per_window": 256,
    "replay_original_rows": 128,
    "new_rows_with_replay": 128,
    "old_holdout_rows": 256,
    "new_holdout_rows": 256,
    "seeds": "window_train=60000+100*training_seed+window; old_holdout=70000+training_seed; new_holdout=80000+100*training_seed+window",
    "arms": [
      "frozen",
      "online",
      "replay"
    ],
    "matched_training_budget": true,
    "scope": "three-window supervised parameter retention, not indefinite memory or production uptime",
    "old_gaussian_nll_degradation_margin": 0.02,
    "status": "secondary descriptive study",
    "gate": "replay worst-window seed-average old Gaussian NLL degradation <= 0.02 AND last-window new Gaussian NLL <= frozen"
  }
}
