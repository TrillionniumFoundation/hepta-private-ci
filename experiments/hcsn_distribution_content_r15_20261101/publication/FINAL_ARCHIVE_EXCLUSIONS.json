    "exact_command": "python -B - \"$FINAL_MANIFEST\" \"$FINAL_MANIFEST_SHA256\" \"$REPO_ROOT\" <<'COVERAGE'\nimport hashlib, json, sys\nfrom pathlib import Path\nfinal_path, pinned_sha, repository = Path(sys.argv[1]), sys.argv[2], Path(sys.argv[3])\nraw = final_path.read_bytes()\nassert hashlib.sha256(raw).hexdigest() == pinned_sha, 'Final manifest SHA256 mismatch'\nfinal = json.loads(raw)\nretained = {row['path']: row for row in final['members']}\nassert len(retained) == len(final['members']), 'Duplicate final member paths'\nbase = 'repository/experiments/hcsn_distribution_content_r15_20261101'\npub = repository / 'experiments/hcsn_distribution_content_r15_20261101/publication'\npartials = [\n    ('checkpoint_resumed_first5', '6e3c103e10374b24c40d2b2c9832fbd097418b72d422903ac1a39812c84505ab', 70),\n    ('checkpoint_binding_15132_15135light', '4d2975b0a26678772db945b691a597917607d4a47ef71f7d941c91d9a98f27df', 96),\n]\nchecks = []\nfor label, expected_sha, expected_count in partials:\n    partial_path = pub / 'prior_checkpoint_manifests' / label / 'manifest.json'\n    partial_raw = partial_path.read_bytes()\n    assert hashlib.sha256(partial_raw).hexdigest() == expected_sha, label\n    partial = json.loads(partial_raw)\n    assert len(partial['members']) == expected_count, label\n    for row in partial['members']:\n        if row['path'].startswith('formal_03/'):\n            target = base + '/results/' + row['path']\n        else:\n            assert row['path'].startswith(label + '/'), row['path']\n            target = base + '/publication/' + label + '_metadata_001/checkpoint_note/' + row['path'][len(label)+1:]\n        kept = retained[target]\n        assert (kept['bytes'], kept['sha256']) == (row['bytes'], row['sha256']), target\n        checks.append({'partial': label, 'partial_member': row['path'], 'final_member': target, 'bytes': row['bytes'], 'sha256': row['sha256']})\nassert len(checks) == 166\nassert len({c['final_member'] for c in checks}) == 165\nexclusions_path = pub / 'FINAL_ARCHIVE_EXCLUSIONS.json'\nexclusions_raw = exclusions_path.read_bytes()\nexclusions_entry = retained[base + '/publication/FINAL_ARCHIVE_EXCLUSIONS.json']\nassert (len(exclusions_raw), hashlib.sha256(exclusions_raw).hexdigest()) == (exclusions_entry['bytes'], exclusions_entry['sha256'])\nexclusions = json.loads(exclusions_raw)\nfor row in exclusions['protected_publication_files']:\n    kept = retained[row['archive_path']]\n    assert (kept['bytes'], kept['sha256']) == (row['bytes'], row['sha256']), row['archive_path']\nprint(json.dumps({'passed': True, 'final_manifest_sha256': pinned_sha, 'partial_members_verified': len(checks), 'distinct_retained_targets': 165, 'protected_publication_files_verified': len(exclusions['protected_publication_files']), 'only_manifest_and_operational_metadata_read': True, 'checks': checks}, indent=2))\nCOVERAGE",
