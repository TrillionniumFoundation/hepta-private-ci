{
  "schema": "hepta.shared-stem-experiment-config.v1",
  "version": 1,
  "experiment_id": "EXPERIMENT-3-MULTIMODAL-DIFFERENTIATION",
  "kind": "multimodal_differentiation",
  "description": "Paired modality paths over one frozen shared latent Stem and modality-specific adapters/heads.",
  "arms": [
