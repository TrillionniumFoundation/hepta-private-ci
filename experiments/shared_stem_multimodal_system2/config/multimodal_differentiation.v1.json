    "baseline": {
      "enabled": true,
      "kind": "single_modality",
      "paired_by": "example_id",
      "required_metrics": [
        "task_utility",
        "active_flops",
        "latency_ms",
        "peak_rss_bytes",
        "gpu_peak_bytes",
        "retention_score",
        "old_task_regression"
      ]
