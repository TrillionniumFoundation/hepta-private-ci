      "id": "image_text",
      "input_modality": "image",
      "output_modality": "text",
      "family": "perception_generation"
    },
    {
      "id": "audio_text",
      "input_modality": "audio",
      "output_modality": "text",
      "family": "perception_generation"
    },
    {
      "id": "video_text",
      "input_modality": "video",
      "output_modality": "text",
      "family": "temporal_perception_generation"
    },
    {
      "id": "text_image",
      "input_modality": "text",
      "output_modality": "image",
      "family": "conditional_generation"
    },
    {
      "id": "text_audio",
      "input_modality": "text",
      "output_modality": "audio",
      "family": "conditional_generation"
    }
  ],
  "required_metrics": [
    "task_utility",
    "active_flops",
    "latency_ms",
    "peak_rss_bytes",
    "gpu_peak_bytes",
    "retention_score",
