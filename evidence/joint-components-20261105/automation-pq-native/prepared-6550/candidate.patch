+    let second_binary = binary::retain_live_daemon(
+        health2.process_id,
+        second_generation,
+        &agent,
+        &evidence,
+        &source,
+    )?;
+    ensure!(
+        (
+            second_binary["pid"].clone(),
+            second_binary["start_ticks"].clone()
+        ) != (
+            first_binary["pid"].clone(),
+            first_binary["start_ticks"].clone()
+        ),
+        "recovery did not create a new process identity"
+    );
+    ensure!(
+        second_binary["sha256"] == first_binary["sha256"],
+        "restart selected another Agentd executable"
+    );
+    checkpoint(&evidence, "second-process.json", &second_binary)?;
+    ensure!(
+        first.health().await.is_err(),
+        "old client generation crossed the new ordinary boundary"
+    );
+    ensure!(
+        second
+            .automation_execute_effect(
+                intent.clone(),
+                WIRE,
+                grant.clone(),
+                "old-generation-dispatch".into()
+            )
+            .await
+            .is_err(),
+        "old generation grant dispatched after restart"
+    );
+    ensure!(
+        provider.posts.load(Ordering::SeqCst) == 1,
+        "recovery resent the physical request"
+    );
+    let missing = second
+        .automation_reconcile_effect(
+            intent.run_id.clone(),
+            intent.step_id.clone(),
+            intent.attempt,
+        )
+        .await?;
+    ensure!(
+        missing.state == AutomationEffectReconcileState::Indeterminate && missing.effect.is_none(),
+        "temporary lookup absence became permission to retry"
+    );
+    let observed = second
+        .automation_reconcile_effect(
+            intent.run_id.clone(),
+            intent.step_id.clone(),
+            intent.attempt,
+        )
+        .await?;
+    ensure!(
+        observed.state == AutomationEffectReconcileState::Terminal,
+        "current owner did not recover the original operation"
+    );
+    let terminal = observed
+        .effect
+        .clone()
+        .context("ordinary terminal readback")?;
+    ensure!(
+        terminal.observation == AutomationEffectObservation::Succeeded,
+        "provider completion was lost"
+    );
+    let local = second
+        .automation_reconcile_effect(
+            intent.run_id.clone(),
+            intent.step_id.clone(),
+            intent.attempt,
+        )
+        .await?;
+    ensure!(
+        local == observed,
+        "local terminal readback differs from the settled result"
+    );
+    ensure!(
+        provider.posts.load(Ordering::SeqCst) == 1
+            && provider.applies.load(Ordering::SeqCst) == 1
+            && provider.lookups.load(Ordering::SeqCst) == 2,
+        "unexpected send/application/lookup count"
+    );
+    ensure!(
+        *owner.frontier.frontier.lock().unwrap() == claimed_frontier,
+        "lookup consumed new dispatch authority or reset the frontier"
+    );
+    ensure!(
+        fs::read(&recovery_file)? == initial_recovery
+            && fs::read(&recovery_trust)? == initial_recovery_trust,
+        "restart changed its original recovery evidence"
+    );
+    let second_exit = kill_owned_and_wait(&mut fleet, &agent).await?;
+    let store = AutomationStore::open(&agent.layout).await?;
+    let settled = store
+        .authorized_taskflow_effect_attempt(&intent.run_id, &intent.step_id, intent.attempt)
+        .await?
+        .context("original durable effect attempt")?;
+    let ack = settled
+        .provider_ack
+        .context("provider operation read back from durable owner")?;
+    ensure!(
+        ack.key == key
+            && serde_json::json!(ack.provider_operation_id_sha256.as_str())
+                == applied["provider_operation_id_sha256"],
+        "durable receipt substituted another operation"
+    );
+    let receipt = store
+        .read_terminal_authorized_taskflow_effect(&intent.run_id, &intent.step_id, intent.attempt)
+        .await?
+        .context("durable terminal")?;
+    ensure!(
+        receipt.receipt_digest == terminal.receipt_digest,
+        "ordinary readback differs from original durable terminal"
+    );
+    store.close().await;
+    let used_nonces = owner.final_nonce_count(&agent)?;
+    ensure!(
+        used_nonces == 1,
+        "original FinalUse nonce was lost or another one was consumed"
+    );
+    checkpoint(
+        &evidence,
+        "completed.json",
+        &serde_json::json!({"scope":"controlled ordinary process composition; supervisor pre-fences before SIGKILL; no full-host restore or independent custody claim",
+        "source":source,"first_process":first_binary,"second_process":second_binary,"provider_record":applied,
+        "provider_ack":ack,"terminal":terminal,"post_count":1,"physical_apply_count":1,"lookup_count":2,"used_nonces":used_nonces,
+        "frontier_retained":claimed_frontier,"frontier_cas_count":owner.frontier.cas_count.load(Ordering::SeqCst),"protected_fixture_clock":owner.clock.now.load(Ordering::SeqCst),"initial_evidence_frontier_sha256":Sha256Digest::for_bytes(&initial_recovery),"initial_evidence_trust_sha256":Sha256Digest::for_bytes(&initial_recovery_trust),"cleanup_exit":second_exit}),
+    )?;
+    Ok(())
+}
diff --git a/codex-rs/hepta-agentd/tests/support/automation_effect_binary.rs b/codex-rs/hepta-agentd/tests/support/automation_effect_binary.rs
new file mode 100644
index 0000000000..189e1ce33f
--- /dev/null
+++ b/codex-rs/hepta-agentd/tests/support/automation_effect_binary.rs
@@ -0,0 +1,181 @@
+//! Bind the live owned daemon image to the exact binary resolved by Cargo.
+//! Retention happens during each process phase, before any subsequent build.
+use super::*;
+use sha2::Digest;
+use sha2::Sha256;
+use std::io::Read;
+use std::io::Write;
+use std::os::unix::fs::MetadataExt;
+use std::process::Command;
+
+fn source_command(root: &Path, args: &[&str]) -> Result<String> {
+    let output = Command::new("git")
+        .arg("-C")
+        .arg(root)
+        .args(args)
+        .output()?;
+    ensure!(output.status.success(), "source identity command failed");
+    Ok(String::from_utf8(output.stdout)?.trim().to_owned())
+}
+
+pub(super) fn source_identity() -> Result<Value> {
+    let supplied = std::env::var_os("HEPTA_PQ_EFFECT_SOURCE_ROOT");
+    let Some(supplied) = supplied else {
+        ensure!(
+            std::env::var_os("TESTED_SHA").is_none(),
+            "qualification wrapper must supply its verified complete source root"
+        );
+        // Developer/Bazel functional execution makes no source qualification
+        // claim. It still checks the live process image using the repo's binary
+        // resolver. Qualification never derives a checkout from compile paths.
+        return Ok(
+            serde_json::json!({"qualification_binding":false,"scope":"unqualified functional process control; no wrapper-supplied source"}),
+        );
+    };
+    let root = PathBuf::from(supplied);
+    ensure!(
+        root.is_absolute() && root.canonicalize()? == root,
+        "qualification source root must be absolute and canonical"
+    );
+    let tested = std::env::var("TESTED_SHA").context("qualification tested SHA")?;
+    let commit = source_command(&root, &["rev-parse", "HEAD"])?;
+    let tree = source_command(&root, &["rev-parse", "HEAD^{tree}"])?;
+    ensure!(
+        tested == commit,
+        "process evidence source differs from the original wrapper"
+    );
+    ensure!(
+        source_command(
+            &root,
+            &["status", "--porcelain=v1", "--untracked-files=all"]
+        )?
+        .is_empty(),
+        "qualification requires committed clean source"
+    );
+    let rustc = Command::new("rustc").arg("-Vv").output()?;
+    ensure!(rustc.status.success(), "toolchain identity unavailable");
+    let env: std::collections::BTreeMap<_, _> = [
+        "RUSTUP_TOOLCHAIN",
+        "CARGO_INCREMENTAL",
+        "CARGO_BUILD_JOBS",
+        "CARGO_PROFILE_TEST_DEBUG",
+        "CARGO_PROFILE_DEV_DEBUG",
+        "RUSTFLAGS",
+        "CARGO_ENCODED_RUSTFLAGS",
+        "RUSTC_WRAPPER",
+        "RUSTC_WORKSPACE_WRAPPER",
+    ]
+    .into_iter()
+    .map(|name| (name, std::env::var(name).ok()))
+    .collect();
+    Ok(
+        serde_json::json!({"qualification_binding":true,"commit":commit,"tree":tree,"cargo_lock_sha256":Sha256Digest::for_bytes(&fs::read(root.join("codex-rs/Cargo.lock"))?),"rustc":String::from_utf8(rustc.stdout)?,"environment":env}),
+    )
+}
+
+fn start_ticks(path: &Path) -> Result<String> {
+    let stat = fs::read_to_string(path.join("stat"))?;
+    Ok(stat
+        .rsplit_once(')')
+        .context("process stat")?
+        .1
+        .split_whitespace()
+        .nth(19)
+        .context("process start time")?
+        .into())
+}
+
+fn file_identity(v: &fs::Metadata) -> (u64, u64, u64, i64, i64, i64, i64) {
+    (
+        v.dev(),
+        v.ino(),
+        v.len(),
+        v.mtime(),
+        v.mtime_nsec(),
+        v.ctime(),
+        v.ctime_nsec(),
+    )
+}
+
+pub(super) fn retain_live_daemon(
+    pid: u32,
+    generation: u64,
+    agent: &AgentFixture,
+    directory: &Path,
+    source: &Value,
+) -> Result<Value> {
+    let expected = support::fleet::agentd_binary()?.canonicalize()?;
+    let process = PathBuf::from(format!("/proc/{pid}"));
+    let start = start_ticks(&process)?;
+    let argv = fs::read(process.join("cmdline"))?;
+    let actual = fs::read_link(process.join("exe"))?;
+    ensure!(
+        actual == expected,
+        "live Agentd executable differs from exact Cargo binary"
+    );
+    let mut image = fs::File::open(process.join("exe"))?;
+    let before = image.metadata()?;
+    ensure!(
+        file_identity(&before) == file_identity(&fs::metadata(&expected)?),
+        "Cargo path changed before live image capture"
+    );
+    let environment = fs::read(process.join("environ"))?;
+    let selected = |key: &str| -> Option<String> {
+        environment.split(|b| *b == 0).find_map(|line| {
+            line.strip_prefix(format!("{key}=").as_bytes())
+                .and_then(|v| std::str::from_utf8(v).ok())
+                .map(str::to_owned)
+        })
+    };
+    ensure!(
+        selected("HEPTA_AGENT_ID").as_deref() == Some(agent.agent_id.as_str()),
+        "live process belongs to another owner"
+    );
+    ensure!(
+        selected("HEPTA_AGENT_GENERATION") == Some(generation.to_string()),
+        "live process has another spawn generation"
+    );
+    ensure!(
+        start_ticks(&process)? == start && fs::read(process.join("cmdline"))? == argv,
+        "PID or argv changed while opening image"
+    );
+    ensure!(
+        file_identity(&fs::metadata(process.join("exe"))?) == file_identity(&before),
+        "PID executed a different image"
+    );
+    let temporary = directory.join(format!("agentd-{pid}-{start}.elf"));
+    let mut retained = fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&temporary)?;
+    let mut hash = Sha256::new();
+    let mut buffer = [0; 1024 * 1024];
+    loop {
+        let read = image.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        hash.update(&buffer[..read]);
+        retained.write_all(&buffer[..read])?;
+    }
+    retained.sync_all()?;
+    ensure!(
+        file_identity(&image.metadata()?) == file_identity(&before),
+        "live executable changed while copied"
+    );
+    ensure!(
+        start_ticks(&process)? == start && fs::read(process.join("cmdline"))? == argv,
+        "process exited or changed during image capture"
+    );
+    ensure!(
+        file_identity(&fs::metadata(process.join("exe"))?) == file_identity(&before),
+        "process replaced its image during capture"
+    );
+    let digest = format!("{:x}", hash.finalize());
+    Ok(
+        serde_json::json!({"source":source,"pid":pid,"spawn_generation":generation,"start_ticks":start,
+        "cargo_resolved_binary":expected,"actual_executable":actual,"retained_copy":temporary,
+        "sha256":digest,"bytes":before.len(),"device":before.dev(),"inode":before.ino(),
+        "owner_and_generation_verified":true,"opened_fd_and_process_identity_verified":true}),
+    )
+}
diff --git a/codex-rs/hepta-agentd/tests/support/automation_effect_operator.rs b/codex-rs/hepta-agentd/tests/support/automation_effect_operator.rs
new file mode 100644
index 0000000000..4099c9b018
--- /dev/null
+++ b/codex-rs/hepta-agentd/tests/support/automation_effect_operator.rs
@@ -0,0 +1,502 @@
+//! Controlled operator material for one real Agentd process test only.
+//! Its keys and in-test services are not independent deployment custody.
+use super::*;
+use codex_hepta_contracts::AuthorityClock;
+use codex_hepta_contracts::FinalUseAuthenticationProfile;
+use codex_hepta_contracts::FinalUseAuthority;
+use codex_hepta_contracts::FinalUseFrontier;
+use codex_hepta_contracts::FinalUseGrant;
+use codex_hepta_contracts::FinalUseRevocationUpdate;
+use codex_hepta_contracts::FinalUseRevocations;
+use codex_hepta_contracts::PqAuthorityTrustKey;
+use codex_hepta_contracts::SignedFinalUseGrant;
+use codex_hepta_contracts::SignedFinalUseRevocationUpdate;
+use codex_hepta_contracts::authority_trust_unix::PqTrustOperationV2;
+use codex_hepta_contracts::authority_trust_unix::PqTrustOutcomeV2;
+use codex_hepta_contracts::authority_trust_unix::PqTrustRequestV2;
+use codex_hepta_contracts::authority_trust_unix::PqTrustResponseBodyV2;
+use codex_hepta_contracts::authority_trust_unix::SignedPqTrustResponseV2;
+use codex_hepta_contracts::authority_trust_unix::UnixPqAuthorityClock;
+use codex_hepta_contracts::authority_trust_unix::UnixPqFinalUseFrontier;
+use codex_hepta_contracts::authority_trust_unix::UnixPqTrustEndpointConfig;
+use codex_hepta_contracts::pq_auth::PqNativeSigningKey;
+use codex_hepta_contracts::pq_auth::ml_dsa_65_key_id_from_spki;
+use codex_model_provider::HttpProviderEffectConfig;
+use codex_model_provider::HttpProviderEffectContractAttestation;
+use reqwest::header::HeaderMap;
+use std::collections::BTreeSet;
+use std::io::Read;
+use std::io::Write;
+use std::os::unix::fs::MetadataExt;
+use std::os::unix::fs::PermissionsExt;
+use std::os::unix::net::UnixListener;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::thread::JoinHandle;
+use std::thread::{self};
+
+const SIGNER: &str = "test-only-effect-grant-owner";
+const FEED: &str = "test-only-effect-revocation-owner";
+
+fn signing_key(seed: u8) -> anyhow::Result<PqNativeSigningKey> {
+    let spki = PqNativeSigningKey::public_spki_from_seed(&[seed; 32].into());
+    Ok(PqNativeSigningKey::from_owned_seed(
+        [seed; 32].into(),
+        ml_dsa_65_key_id_from_spki(&spki)?,
+    )?)
+}
+
+fn pinned(key: &PqNativeSigningKey, name: &str) -> PqAuthorityTrustKey {
+    PqAuthorityTrustKey {
+        key_id: name.into(),
+        public_key_id: key.public_key_id(),
+        public_key_spki: key.public_spki().to_vec(),
+        not_before_authority_epoch: 9,
+        not_after_authority_epoch: 10,
+    }
+}
+
+pub(super) fn write_private(path: &Path, value: &impl serde::Serialize) -> anyhow::Result<()> {
+    fs::write(path, serde_json::to_vec(value)?)?;
+    fs::set_permissions(path, fs::Permissions::from_mode(0o600))?;
+    Ok(())
+}
+
+#[derive(Clone, Copy)]
+enum ServiceRole {
+    Clock,
+    Frontier,
+}
+
+pub(super) struct Service {
+    pub(super) config: UnixPqTrustEndpointConfig,
+    pub(super) frontier: Arc<Mutex<FinalUseFrontier>>,
+    pub(super) now: Arc<AtomicU64>,
+    pub(super) cas_count: Arc<AtomicUsize>,
+    _available: Arc<AtomicBool>,
+    stop: Arc<AtomicBool>,
+    join: Option<JoinHandle<anyhow::Result<()>>>,
+}
+
+impl Service {
+    fn start(
+        root: &Path,
+        role: ServiceRole,
+        initial: FinalUseFrontier,
+        now_ms: u64,
+    ) -> anyhow::Result<Self> {
+        let (name, seed) = match role {
+            ServiceRole::Clock => ("clock", 74),
+            ServiceRole::Frontier => ("frontier", 75),
+        };
+        let signer = signing_key(seed)?;
+        let socket_path = root.join(format!("{name}.sock"));
+        let listener = UnixListener::bind(&socket_path)?;
+        fs::set_permissions(&socket_path, fs::Permissions::from_mode(0o600))?;
+        listener.set_nonblocking(true)?;
+        let config = UnixPqTrustEndpointConfig {
+            socket_path,
+            peer_uid: fs::metadata(root)?.uid(),
+            service_id: format!("pq-effect-{name}"),
+            key_generation: 1,
+            public_key_id: signer.public_key_id(),
+            public_key_spki: signer.public_spki().to_vec(),
+            timeout_ms: 2000,
+        };
+        let frontier = Arc::new(Mutex::new(initial));
+        let current = Arc::clone(&frontier);
+        let now = Arc::new(AtomicU64::new(now_ms));
+        let clock = Arc::clone(&now);
+        let cas_count = Arc::new(AtomicUsize::new(0));
+        let cas = Arc::clone(&cas_count);
+        let available = Arc::new(AtomicBool::new(true));
+        let serving = Arc::clone(&available);
+        let stop = Arc::new(AtomicBool::new(false));
+        let stopping = Arc::clone(&stop);
+        let join = thread::spawn(move || -> anyhow::Result<()> {
+            let deadline = Instant::now() + Duration::from_secs(120);
+            while !stopping.load(Ordering::SeqCst) && Instant::now() < deadline {
+                match listener.accept() {
+                    Ok((mut stream, _)) => {
+                        stream.set_read_timeout(Some(Duration::from_secs(2)))?;
+                        stream.set_write_timeout(Some(Duration::from_secs(2)))?;
+                        let mut size = [0; 4];
+                        stream.read_exact(&mut size)?;
+                        let size = u32::from_be_bytes(size) as usize;
+                        anyhow::ensure!(size <= 16 * 1024, "bounded trust request");
+                        let mut bytes = vec![0; size];
+                        stream.read_exact(&mut bytes)?;
+                        let request: PqTrustRequestV2 = serde_json::from_slice(&bytes)?;
+                        let outcome = if serving.load(Ordering::SeqCst) {
+                            match (&role, &request.operation) {
+                                (ServiceRole::Clock, PqTrustOperationV2::ClockNow) => {
+                                    PqTrustOutcomeV2::Clock {
+                                        unix_ms: clock.load(Ordering::SeqCst),
+                                    }
+                                }
+                                (
+                                    ServiceRole::Frontier,
+                                    PqTrustOperationV2::FrontierLoad { owner_id },
+                                ) if owner_id == SIGNER => PqTrustOutcomeV2::Frontier {
+                                    value: *current.lock().unwrap(),
+                                },
+                                (
+                                    ServiceRole::Frontier,
+                                    PqTrustOperationV2::FrontierCompareAndSet {
+                                        owner_id,
+                                        expected,
+                                        next,
+                                    },
+                                ) if owner_id == SIGNER => {
+                                    let mut value = current.lock().unwrap();
+                                    if &*value == expected {
+                                        *value = *next;
+                                        cas.fetch_add(1, Ordering::SeqCst);
+                                        PqTrustOutcomeV2::CompareAndSetApplied { value: *next }
+                                    } else {
+                                        PqTrustOutcomeV2::Conflict
+                                    }
+                                }
+                                (
+                                    ServiceRole::Clock,
+                                    PqTrustOperationV2::FrontierLoad { .. }
+                                    | PqTrustOperationV2::FrontierCompareAndSet { .. }
+                                    | PqTrustOperationV2::LearningFrontierLoad { .. }
+                                    | PqTrustOperationV2::LearningFrontierCompareAndSet { .. },
+                                )
+                                | (
+                                    ServiceRole::Frontier,
+                                    PqTrustOperationV2::ClockNow
+                                    | PqTrustOperationV2::FrontierLoad { .. }
+                                    | PqTrustOperationV2::FrontierCompareAndSet { .. }
+                                    | PqTrustOperationV2::LearningFrontierLoad { .. }
+                                    | PqTrustOperationV2::LearningFrontierCompareAndSet { .. },
+                                ) => PqTrustOutcomeV2::Unavailable,
+                            }
+                        } else {
+                            PqTrustOutcomeV2::Unavailable
+                        };
+                        let body = PqTrustResponseBodyV2 {
+                            schema_version: 2,
+                            request,
+                            valid_for_ms: 2000,
+                            outcome,
+                        };
+                        let signature = signer.sign_exact_message(&body.signing_bytes()?)?.to_vec();
+                        let bytes =
+                            serde_json::to_vec(&SignedPqTrustResponseV2 { body, signature })?;
+                        stream.write_all(&(bytes.len() as u32).to_be_bytes())?;
+                        stream.write_all(&bytes)?;
+                    }
+                    Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                        thread::sleep(Duration::from_millis(1))
+                    }
+                    Err(error) => return Err(error.into()),
+                }
+            }
+            Ok(())
+        });
+        Ok(Self {
+            config,
+            frontier,
+            now,
+            cas_count,
+            _available: available,
+            stop,
+            join: Some(join),
+        })
+    }
+}
+
+impl Drop for Service {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::SeqCst);
+        if let Some(join) = self.join.take() {
+            match join.join() {
+                Ok(Ok(())) => {}
+                Ok(Err(error)) => panic!("PQ effect service failed: {error}"),
+                Err(panic) => std::panic::resume_unwind(panic),
+            }
+        }
+    }
+}
+
+pub(super) struct Operator {
+    pub(super) clock: Service,
+    pub(super) frontier: Service,
+    pub(super) path: PathBuf,
+    pub(super) config: Value,
+    pub(super) now: u64,
+    issuer: PqNativeSigningKey,
+    contract: PqNativeSigningKey,
+    _external: tempfile::TempDir,
+}
+
+impl Operator {
+    pub(super) fn new(agent: &AgentFixture, generation: u64, uri: &str) -> Result<Self> {
+        let external = tempfile::tempdir()?;
+        let root = external.path().canonicalize()?;
+        fs::set_permissions(&root, fs::Permissions::from_mode(0o700))?;
+        let now = u64::try_from(SystemTime::now().duration_since(UNIX_EPOCH)?.as_millis())?;
+        let head = FinalUseRevocations {
+            authority_epoch: 9,
+            revision: 1,
+            revoked_grant_ids: BTreeSet::new(),
+        };
+        let initial = FinalUseFrontier::for_initial_head_with_profile(
+            &head,
+            FinalUseAuthenticationProfile::MlDsa65V2,
+        )?;
+        let clock = Service::start(&root, ServiceRole::Clock, initial, now)?;
+        let frontier = Service::start(&root, ServiceRole::Frontier, initial, now)?;
+        let contract = signing_key(/*seed*/ 71)?;
+        let issuer = signing_key(/*seed*/ 72)?;
+        let feed_signer = signing_key(/*seed*/ 73)?;
+        let feed_path = root.join("signed-feed.json");
+        let update = FinalUseRevocationUpdate::new_pq(
+            FEED.into(),
+            head.clone(),
+            now.saturating_sub(1000),
+            now + 60_000,
+        );
+        let signature = feed_signer
+            .sign_exact_message(&update.signing_bytes()?)?
+            .to_vec();
+        write_private(
+            &feed_path,
+            &SignedFinalUseRevocationUpdate { update, signature },
+        )?;
