+class ParserCacheMutationTests(unittest.TestCase):
+    """Warm parsing must never turn a previous source binding into authority."""
+
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix='pon-parser-cache-')
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+
+    def replace_same_metadata(self, path, text):
+        before = path.stat()
+        self.assertEqual(len(text.encode()), before.st_size)
+        path.write_text(text)
+        os.utime(path, ns=(before.st_atime_ns, before.st_mtime_ns))
+        after = path.stat()
+        self.assertEqual(after.st_size, before.st_size)
+        self.assertEqual(after.st_mtime_ns, before.st_mtime_ns)
+
+    def test_warm_rust_parser_reads_same_size_same_mtime_changes(self):
+        path = self.root / 'bound.rs'
+        original = '#[test]\nfn test_bound() {}\n'
+        path.write_text(original)
+        for _ in range(2):
+            check_test_selector(self.root, 'bound.rs::test_bound')
+        self.replace_same_metadata(path, '#[test]\nfn test_other() {}\n')
+        with self.assertRaisesRegex(ValueError, 'missing Rust callable'):
+            check_test_selector(self.root, 'bound.rs::test_bound')
+        check_test_selector(self.root, 'bound.rs::test_other')
+        self.replace_same_metadata(path, original)
+        check_test_selector(self.root, 'bound.rs::test_bound')
+
+    def test_warm_python_parser_reads_same_size_same_mtime_changes(self):
+        path = self.root / 'bound.py'
+        original = 'def test_bound():\n    return 1\n'
+        path.write_text(original)
+        for _ in range(2):
+            check_test_selector(self.root, 'bound.py::test_bound')
+        self.replace_same_metadata(path, 'def test_other():\n    return 1\n')
+        with self.assertRaisesRegex(ValueError, 'missing Python owner'):
+            check_test_selector(self.root, 'bound.py::test_bound')
+        check_test_selector(self.root, 'bound.py::test_other')
+        self.replace_same_metadata(path, original)
+        check_test_selector(self.root, 'bound.py::test_bound')
+
+    def test_warm_rust_parser_refuses_comments_strings_and_unattributed_helpers(self):
+        path = self.root / 'bound.rs'
+        original = '#[test]\nfn test_bound() {}\n'
+        for text in ['// #[test]\n// fn test_bound() {}',
+                     '/* outer /* inner */ #[test] fn test_bound() {} */',
+                     'const S: &str = r#"#[test] fn test_bound() {}"#;',
+                     'fn test_bound() {}']:
+            with self.subTest(source=text):
+                path.write_text(original)
+                check_test_selector(self.root, 'bound.rs::test_bound')
+                path.write_text(text)
+                with self.assertRaises(ValueError):
+                    check_test_selector(self.root, 'bound.rs::test_bound')
+                path.write_text(original)
+                check_test_selector(self.root, 'bound.rs::test_bound')
+
+    def test_python_symbol_results_cannot_pollute_later_calls(self):
+        text = 'class Suite:\n    def test_bound(self):\n        pass\n'
+        symbols = python_symbols(text)
