+def verify_partial_prefixes(plan, entries):
+    """Actually compare every partial byte with the included parent's prefix.
+
+    This proves reconstruction of the retained partial bytes only. It does not
+    establish the interrupted second process's complete executable or outcome.
+    """
+    by_hash = {row["sha256"]: row for row in entries}
+    results = []
+    for partial in plan["partial_prefixes"]:
+        parent = by_hash[partial["parent_sha256"]]
+        partial_stream, partial_before = open_regular(Path(partial["source_path"]), partial["bytes"], partial["bytes"])
+        try:
+            version = ":".join(str(partial_before[key]) for key in ("device", "inode", "bytes", "mtime_ns", "ctime_ns"))
+            require(version == partial["source_version"], "partial source differs from frozen observed file version")
+            parent_stream, parent_before = open_regular(Path(parent["source_path"]), parent["bytes"], parent["bytes"])
+        except BaseException:
+            partial_stream.close()
+            raise
+        with partial_stream, parent_stream:
+            require(parent_before == parent["first_read_metadata"], "prefix parent changed after archive read")
+            partial_digest, parent_digest = hashlib.sha256(), hashlib.sha256()
+            count = 0
+            while count < partial["bytes"]:
+                wanted = min(BLOCK, partial["bytes"] - count)
+                left, right = partial_stream.read(wanted), parent_stream.read(wanted)
+                require(len(left) == wanted and len(right) == wanted and left == right,
+                        "retained partial does not equal the included complete image prefix")
+                partial_digest.update(left)
+                parent_digest.update(right)
+                count += wanted
+            require(not partial_stream.read(1) and metadata(os.fstat(partial_stream.fileno())) == partial_before and
+                    metadata(os.fstat(parent_stream.fileno())) == parent_before, "prefix source changed while compared")
+        require(partial_digest.hexdigest() == parent_digest.hexdigest() == partial["sha256"],
+                "actual partial/prefix hash differs from frozen inventory")
