--- /dev/null
+++ b/platform/src/clipboard.rs
@@ -0,0 +1,73 @@
+//! Nonblocking, request-scoped reads from the original native clipboard path.
+use std::sync::mpsc::{Receiver, TryRecvError};
+#[cfg(all(target_os = "linux", not(target_env = "ohos"), not(linux_direct), not(gpusim)))]
+use std::sync::mpsc::{self, SyncSender};
+
+pub const MAX_CLIPBOARD_TEXT_BYTES: usize = 64 * 1024;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ClipboardReadError {
+    Unavailable,
+    Busy,
+    TooLarge,
+    InvalidText,
+    Timeout,
+}
+
+/// One unique response channel. A result never becomes a global TextInput
+/// event or follows later keyboard focus. The caller must retain its own
+/// target identity and revalidate it before applying the returned text.
+pub struct ClipboardReadTicket(Receiver<Result<String, ClipboardReadError>>);
+
+impl ClipboardReadTicket {
+    pub fn try_recv(&self) -> Result<Option<Result<String, ClipboardReadError>>, ClipboardReadError> {
+        match self.0.try_recv() {
+            Ok(value) => Ok(Some(value)),
+            Err(TryRecvError::Empty) => Ok(None),
+            Err(TryRecvError::Disconnected) => Err(ClipboardReadError::Unavailable),
+        }
+    }
+}
+
+#[cfg(all(target_os = "linux", not(target_env = "ohos"), not(linux_direct), not(gpusim)))]
+pub struct ClipboardReadRequest {
+    pub(crate) max_bytes: usize,
+    sender: Option<SyncSender<Result<String, ClipboardReadError>>>,
+}
+
+#[cfg(all(target_os = "linux", not(target_env = "ohos"), not(linux_direct), not(gpusim)))]
+impl ClipboardReadRequest {
+    pub(crate) fn new(max_bytes: usize) -> (Self, ClipboardReadTicket) {
+        let (sender, receiver) = mpsc::sync_channel(1);
+        (Self { max_bytes, sender: Some(sender) }, ClipboardReadTicket(receiver))
+    }
+
+    pub(crate) fn finish(mut self, value: Result<String, ClipboardReadError>) {
+        self.publish(value);
+    }
+
+    fn publish(&mut self, value: Result<String, ClipboardReadError>) {
+        if let Some(sender) = self.sender.take() {
+            if sender.try_send(value).is_ok() {
+                crate::thread::SignalToUI::set_ui_signal();
+            }
+        }
+    }
+}
+
+#[cfg(all(target_os = "linux", not(target_env = "ohos"), not(linux_direct), not(gpusim)))]
+impl Drop for ClipboardReadRequest {
+    fn drop(&mut self) { self.publish(Err(ClipboardReadError::Unavailable)); }
+}
+
+#[cfg(all(target_os = "linux", not(target_env = "ohos"), not(linux_direct), not(gpusim)))]
+impl PartialEq for ClipboardReadRequest {
+    fn eq(&self, _other: &Self) -> bool { false }
+}
+
+#[cfg(all(target_os = "linux", not(target_env = "ohos"), not(linux_direct), not(gpusim)))]
+impl std::fmt::Debug for ClipboardReadRequest {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.debug_struct("ClipboardReadRequest").field("max_bytes", &self.max_bytes).finish_non_exhaustive()
+    }
+}
