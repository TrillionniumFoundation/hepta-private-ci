diff --git a/platform/src/os/linux/x11/clipboard_read.rs b/platform/src/os/linux/x11/clipboard_read.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f9370b1c28bebf5217bb92d9f58fcb76e8e100fb
--- /dev/null
+++ b/platform/src/os/linux/x11/clipboard_read.rs
@@ -0,0 +1,117 @@
+//! Request-scoped UTF-8 selection conversion on the original X11 connection.
+use super::{x11_sys, xlib_app::XlibApp};
+use crate::clipboard::{ClipboardReadError, ClipboardReadRequest, MAX_CLIPBOARD_TEXT_BYTES};
+use std::os::raw::{c_int, c_long, c_ulong};
+use std::ptr;
+use std::time::{Duration, Instant};
+
+pub(super) struct PendingClipboardRead {
+    requestor: c_ulong,
+    parent: c_ulong,
+    started: Instant,
+    request: ClipboardReadRequest,
+}
+
+impl XlibApp {
+    pub(super) fn cancel_clipboard_read(&mut self) {
+        self.complete_clipboard_read(Err(ClipboardReadError::Unavailable));
+    }
+
+    pub(super) fn request_clipboard_text(&mut self, parent: c_ulong, request: ClipboardReadRequest) {
+        if request.max_bytes == 0 || request.max_bytes > MAX_CLIPBOARD_TEXT_BYTES {
+            request.finish(Err(ClipboardReadError::TooLarge));
+            return;
+        }
+        self.poll_clipboard_read_timeout();
+        if self.clipboard_read.is_some() {
+            request.finish(Err(ClipboardReadError::Busy));
+            return;
+        }
+        if self.display.is_null() || !self.window_map.contains_key(&parent) {
+            request.finish(Err(ClipboardReadError::Unavailable));
+            return;
+        }
+        unsafe {
+            // An unmapped child carries this request's response identity; it
+            // is never a visible UI surface and never receives keyboard input.
+            let requestor = x11_sys::XCreateSimpleWindow(self.display, parent, 0, 0, 1, 1, 0, 0, 0);
+            if requestor == 0 {
+                request.finish(Err(ClipboardReadError::Unavailable));
+                return;
+            }
+            self.clipboard_read = Some(PendingClipboardRead { requestor, parent, started: Instant::now(), request });
+            x11_sys::XConvertSelection(self.display, self.atoms.clipboard, self.atoms.utf8_string,
+                self.atoms.clipboard_read, requestor, x11_sys::CurrentTime as c_ulong);
+            x11_sys::XFlush(self.display);
+        }
+    }
+
+    pub(super) fn poll_clipboard_read_timeout(&mut self) {
+        let outcome = self.clipboard_read.as_ref().and_then(|pending| {
+            if self.display.is_null() || !self.window_map.contains_key(&pending.parent) {
+                Some(ClipboardReadError::Unavailable)
+            } else if pending.started.elapsed() >= Duration::from_secs(2) {
+                Some(ClipboardReadError::Timeout)
+            } else {
+                None
+            }
+        });
+        if let Some(error) = outcome { self.complete_clipboard_read(Err(error)); }
+    }
+
+    pub(super) fn handle_clipboard_read_notify(&mut self, selection: &x11_sys::XSelectionEvent) -> bool {
+        let matching = self.clipboard_read.as_ref().is_some_and(|pending| pending.requestor == selection.requestor);
+        if !matching {
+            // Retired replies cannot become global TextInput events.
+            return selection.property == self.atoms.clipboard_read;
+        }
+        if selection.selection != self.atoms.clipboard || selection.target != self.atoms.utf8_string
+            || selection.property != self.atoms.clipboard_read
+        {
+            self.complete_clipboard_read(Err(ClipboardReadError::Unavailable));
+            return true;
+        }
+        let pending = self.clipboard_read.as_ref().unwrap();
+        let max_bytes = pending.request.max_bytes;
+        let outcome = unsafe {
+            let mut actual_type = 0;
+            let mut actual_format: c_int = 0;
+            let mut items: c_ulong = 0;
+            let mut remaining: c_ulong = 0;
+            let mut data = ptr::null_mut();
+            let status = x11_sys::XGetWindowProperty(self.display, pending.requestor, self.atoms.clipboard_read,
+                0, ((max_bytes + 3) / 4) as c_long, 1, self.atoms.utf8_string,
+                &mut actual_type, &mut actual_format, &mut items, &mut remaining, &mut data);
+            let value = if status != 0 {
+                Err(ClipboardReadError::Unavailable)
+            } else if remaining != 0 || items as usize > max_bytes {
+                Err(ClipboardReadError::TooLarge)
+            } else if actual_type != self.atoms.utf8_string || actual_format != 8 {
+                // INCR and non-UTF8 transfers are not reinterpreted as text.
+                Err(ClipboardReadError::InvalidText)
+            } else if items == 0 {
+                Ok(String::new())
+            } else if data.is_null() {
+                Err(ClipboardReadError::InvalidText)
+            } else {
+                let bytes = std::slice::from_raw_parts(data, items as usize);
+                std::str::from_utf8(bytes).map(str::to_owned).map_err(|_| ClipboardReadError::InvalidText)
+            };
+            if !data.is_null() { x11_sys::XFree(data.cast()); }
+            value
+        };
+        self.complete_clipboard_read(outcome);
+        true
+    }
+
+    fn complete_clipboard_read(&mut self, outcome: Result<String, ClipboardReadError>) {
+        if let Some(pending) = self.clipboard_read.take() {
+            // The parent may already have destroyed its child. Do not issue a
+            // second destroy in that case or touch a closed display.
+            if !self.display.is_null() && self.window_map.contains_key(&pending.parent) {
+                unsafe { x11_sys::XDestroyWindow(self.display, pending.requestor); }
+            }
+            pending.request.finish(outcome);
+        }
+    }
+}
