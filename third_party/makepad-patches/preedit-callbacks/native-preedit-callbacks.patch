+#[test]
+fn checkpoint_projects_external_edits_and_preserves_a_reversed_selection() {
+    let mut s = Surface::new();
+    s.text("α旧🙂z", false);
+    s.input.borrow_mut().unwrap().set_selection(&mut s.cx, Selection {
+        anchor: Cursor { index: 5, prefer_next_row: true },
+        cursor: Cursor { index: 2, prefer_next_row: false },
+    });
+    s.text("ni", true);
+    s.input.replace_range(&mut s.cx, 0..0, "界", UndoGroup::New).unwrap();
+    let end = s.input.text().len();
+    s.input.replace_range(&mut s.cx, end-1..end, "终", UndoGroup::New).unwrap();
+    s.text("你好", true);
+    let checkpoint = s.input.save_state();
+    assert_eq!(checkpoint.text, "界α旧🙂终");
+    assert_eq!((checkpoint.selection.anchor.index, checkpoint.selection.cursor.index), (8, 5));
+    assert!(checkpoint.selection.anchor.prefer_next_row);
+    assert!(!checkpoint.selection.cursor.prefer_next_row);
+    s.input.restore_state(&mut s.cx, checkpoint);
+    assert_eq!(s.input.text(), "界α旧🙂终");
+    assert!(!s.input.is_composing());
+    s.undo(); assert_eq!(s.input.text(), "界α旧🙂z");
+    s.undo(); assert_eq!(s.input.text(), "α旧🙂z");
+    s.redo(); s.redo(); assert_eq!(s.input.text(), "界α旧🙂终");
+}
