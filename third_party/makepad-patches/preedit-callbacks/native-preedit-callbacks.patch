+use super::*;
+use crate::{TextInputWidgetRefExt, WidgetRef};
+use makepad_draw::cx_draw::CxDraw;
+use std::cell::RefCell;
+
+struct Surface {
+    cx: Cx,
+    input: TextInputRef,
+    _pass: DrawPass,
+    _list: DrawList2d,
+}
+
+impl Surface {
+    fn new() -> Self {
+        let target = Rc::new(RefCell::new(None::<TextInputRef>));
+        let dispatch_target = target.clone();
+        let mut cx = Cx::new(Box::new(move |cx, event| {
+            if matches!(event, Event::KeyFocus(_)) {
+                if let Some(input) = dispatch_target.borrow().as_ref() {
+                    input.borrow_mut().unwrap().handle_event(cx, event, &mut Scope::empty());
+                }
+            }
+        }));
+        cx.init_cx_os();
+        let input = cx.with_vm(|vm| {
+            crate::script_mod(vm);
+            let value = vm.eval(crate::makepad_script::script! {
+                use mod.prelude.widgets.*
+                TextInput {}
+            });
+            WidgetRef::script_from_value(vm, value).as_text_input()
+        });
+        *target.borrow_mut() = Some(input.clone());
+        let size = dvec2(640.0, 160.0);
+        let pass = DrawPass::new(&mut cx);
+        pass.set_size(&mut cx, size);
+        let mut list = DrawList2d::new(&mut cx);
+        {
+            let event = DrawEvent::default();
+            let mut draw = CxDraw::new(&mut cx, &event);
+            let mut cx2d = Cx2d::new(&mut draw);
+            cx2d.begin_pass(&pass, None);
+            list.begin_always(&mut cx2d);
+            cx2d.begin_root_turtle(size, Layout::flow_down());
+            input.borrow_mut().unwrap().draw_all(&mut cx2d, &mut Scope::empty());
+            cx2d.end_pass_sized_turtle();
+            list.end(&mut cx2d);
+            cx2d.end_pass(&pass);
+        }
+        assert!(input.area().is_valid(&cx));
+        input.take_key_focus(&mut cx);
+        cx.widget_action(input.widget_uid(), TextInputAction::KeyFocus);
+        cx.handle_actions();
+        assert_eq!(cx.key_focus(), input.area());
+        Self { cx, input, _pass: pass, _list: list }
+    }
+
+    fn event(&mut self, event: Event) {
+        self.input.borrow_mut().unwrap().handle_event(&mut self.cx, &event, &mut Scope::empty());
+        self.cx.handle_actions();
+    }
+
+    fn text(&mut self, text: &str, preview: bool) {
+        self.event(Event::TextInput(TextInputEvent {
+            input: text.into(), replace_last: preview, ..Default::default()
+        }));
+    }
+
+    fn key(&mut self, code: KeyCode, shift: bool) {
+        self.event(Event::KeyDown(KeyEvent {
+            key_code: code,
+            modifiers: KeyModifiers { control: true, shift, ..Default::default() },
+            ..Default::default()
+        }));
+    }
+
+    fn undo(&mut self) { self.key(KeyCode::KeyZ, false); }
+    fn redo(&mut self) { self.key(KeyCode::KeyZ, true); }
+
+    fn select(&mut self, anchor: usize, cursor: usize) {
+        self.input.borrow_mut().unwrap().set_selection(&mut self.cx, Selection {
+            anchor: Cursor { index: anchor, prefer_next_row: false },
+            cursor: Cursor { index: cursor, prefer_next_row: false },
+        });
+    }
+
+    fn compose(&mut self, committed: &str) {
+        for preview in ["n", "ni", "你好"] { self.text(preview, true); }
+        assert!(self.input.is_composing());
+        self.text(committed, false);
+        assert!(!self.input.is_composing());
+    }
+
+    fn history(&self) -> String { format!("{:?}", self.input.save_state().history) }
+    fn selection(&self) -> Selection { self.input.borrow().unwrap().selection() }
+}
