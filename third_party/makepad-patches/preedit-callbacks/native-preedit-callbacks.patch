+#[test]
+fn cancel_after_legal_outside_edits_preserves_the_edits_and_their_history() {
+    let mut s = Surface::new();
+    s.text("α旧🙂z", false);
+    s.select(5, 2);
+    s.text("你好", true);
+    let end = s.input.text().len();
+    s.input.replace_range(&mut s.cx, end-1..end, "终", UndoGroup::New).unwrap();
+    s.input.replace_range(&mut s.cx, 0..0, "界", UndoGroup::New).unwrap();
+    s.text("ni", true);
+    s.text("", true);
+    assert_eq!(s.input.text(), "界α旧🙂终");
+    let selection = s.selection();
+    assert_eq!((selection.anchor.index, selection.cursor.index), (8, 5));
+    s.undo(); assert_eq!(s.input.text(), "α旧🙂终");
+    s.undo(); assert_eq!(s.input.text(), "α旧🙂z");
+    s.redo(); s.redo();
+    assert_eq!(s.input.text(), "界α旧🙂终");
+}
