+#[test]
+fn boundary_insertions_remain_outside_the_composition() {
+    let mut s = Surface::new();
+    s.text("ab", false);
+    s.select(1, 1);
+    s.text("你", true);
+    s.input.replace_range(&mut s.cx, 1..1, "L", UndoGroup::New).unwrap();
+    s.input.replace_range(&mut s.cx, 5..5, "R", UndoGroup::New).unwrap();
+    assert_eq!(s.input.text(), "aL你Rb");
+    assert!(matches!(s.input.replace_range(&mut s.cx, 2..5, "bad", UndoGroup::New), Err(ReplaceRangeError::Composing)));
+    s.text("好", false);
+    s.undo(); assert_eq!(s.input.text(), "aLRb");
+    s.undo(); assert_eq!(s.input.text(), "aLb");
+    s.undo(); assert_eq!(s.input.text(), "ab");
+    s.redo(); s.redo(); s.redo();
+    assert_eq!(s.input.text(), "aL好Rb");
+}
