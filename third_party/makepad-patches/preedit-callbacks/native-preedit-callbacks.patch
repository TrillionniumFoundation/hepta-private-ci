+#[test]
+fn cancelling_previews_preserves_prior_undo_redo_and_selection() {
+    let mut s = Surface::new();
+    s.text("a旧文z", false);
+    s.select(1, 7);
+    s.input.replace_range(&mut s.cx, 1..7, "新", UndoGroup::New).unwrap();
+    s.undo();
+    assert_eq!(s.input.text(), "a旧文z");
+    let selection = s.selection();
+    let history = s.history();
+    for preview in ["n", "ni", "你好"] { s.text(preview, true); }
+    s.text("", true);
+    assert_eq!(s.input.text(), "a旧文z");
+    assert_eq!(format!("{:?}", s.selection()), format!("{:?}", selection));
+    assert_eq!(s.history(), history);
+    assert!(!s.input.is_composing());
+    s.redo(); assert_eq!(s.input.text(), "a新z");
+    s.undo(); assert_eq!(s.input.text(), "a旧文z");
+    s.undo(); assert_eq!(s.input.text(), "");
+}
