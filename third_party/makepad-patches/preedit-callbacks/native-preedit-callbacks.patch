diff --git a/widgets/src/window_focus_tests.rs b/widgets/src/window_focus_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..956ca0595452a6b3becd9a7dcb5b84b3e6414936
--- /dev/null
+++ b/widgets/src/window_focus_tests.rs
@@ -0,0 +1,154 @@
+use super::*;
+use crate::text_input::{TextInputAction, TextInputRef, TextInputWidgetRefExt};
+use crate::WidgetRef;
+use makepad_draw::cx_draw::CxDraw;
+use std::cell::RefCell;
+use std::rc::Rc;
+
+struct Surface {
+    cx: Cx,
+    window: WindowRef,
+    input: TextInputRef,
+    _pass: DrawPass,
+    _draw_list: DrawList2d,
+}
+
+impl Surface {
+    fn new() -> Self {
+        let target = Rc::new(RefCell::new(None::<TextInputRef>));
+        let dispatch_target = target.clone();
+        let mut cx = Cx::new(Box::new(move |cx, event| {
+            if matches!(event, Event::KeyFocus(_)) {
+                if let Some(input) = dispatch_target.borrow().as_ref() {
+                    input.borrow_mut().unwrap().handle_event(cx, event, &mut Scope::empty());
+                }
+            }
+        }));
+        cx.init_cx_os();
+        let (window, input) = cx.with_vm(|vm| {
+            crate::script_mod(vm);
+            let window = vm.eval(crate::makepad_script::script! {
+                use mod.prelude.widgets.*
+                Window { create_on_start: false }
+            });
+            let input = vm.eval(crate::makepad_script::script! {
+                use mod.prelude.widgets.*
+                TextInput {}
+            });
+            (WidgetRef::script_from_value(vm, window).as_window(),
+             WidgetRef::script_from_value(vm, input).as_text_input())
+        });
+        *target.borrow_mut() = Some(input.clone());
+        let size = dvec2(640.0, 160.0);
+        let pass = DrawPass::new(&mut cx);
+        pass.set_size(&mut cx, size);
+        let mut draw_list = DrawList2d::new(&mut cx);
+        {
+            let event = DrawEvent::default();
+            let mut draw = CxDraw::new(&mut cx, &event);
+            let mut cx2d = Cx2d::new(&mut draw);
+            cx2d.begin_pass(&pass, None);
+            draw_list.begin_always(&mut cx2d);
+            cx2d.begin_root_turtle(size, Layout::flow_down());
+            input.borrow_mut().unwrap().draw_all(&mut cx2d, &mut Scope::empty());
+            cx2d.end_pass_sized_turtle();
+            draw_list.end(&mut cx2d);
+            cx2d.end_pass(&pass);
+        }
+        assert!(input.area().is_valid(&cx));
+        let mut surface = Self { cx, window, input, _pass: pass, _draw_list: draw_list };
+        surface.event(Event::WindowGotFocus(surface.window.window_id().unwrap()));
+        surface.input.take_key_focus(&mut surface.cx);
+        surface.pump();
+        assert_eq!(surface.cx.key_focus(), surface.input.area());
+        surface
+    }
+
+    fn pump(&mut self) {
+        self.cx.widget_action(self.input.widget_uid(), TextInputAction::KeyFocus);
+        self.cx.handle_actions();
+    }
+
+    fn event(&mut self, event: Event) {
+        self.window.borrow_mut().unwrap().handle_event(&mut self.cx, &event, &mut Scope::empty());
+        self.pump();
+    }
+
+    fn preedit(&mut self) {
+        self.input.borrow_mut().unwrap().handle_event(
+            &mut self.cx,
+            &Event::TextInput(TextInputEvent {
+                input: "你好".into(),
+                replace_last: true,
+                ..Default::default()
+            }),
+            &mut Scope::empty(),
+        );
+        self.pump();
+        assert!(self.input.is_composing());
+        assert_eq!(self.input.text(), "你好");
+    }
+}
+
+#[test]
+fn duplicate_window_got_focus_preserves_live_editor_and_preedit() {
+    let mut surface = Surface::new();
+    surface.preedit();
+    let before = format!("{:?}", surface.input.save_state());
+    for _ in 0..3 {
+        surface.event(Event::WindowGotFocus(surface.window.window_id().unwrap()));
+        assert_eq!(surface.cx.key_focus(), surface.input.area());
+        assert!(surface.input.is_composing());
+        assert_eq!(format!("{:?}", surface.input.save_state()), before);
+    }
+}
+
+#[test]
+fn genuine_window_lost_then_got_focus_restores_the_original_editor() {
+    let mut surface = Surface::new();
+    let id = surface.window.window_id().unwrap();
+    surface.event(Event::WindowLostFocus(id));
+    assert_eq!(surface.cx.key_focus(), Area::Empty);
+    assert!(!surface.window.borrow().unwrap().has_focus);
+    surface.event(Event::WindowGotFocus(id));
+    assert_eq!(surface.cx.key_focus(), surface.input.area());
+    assert!(surface.window.borrow().unwrap().has_focus);
+    surface.preedit();
+}
+
+#[test]
+fn other_window_focus_events_cannot_change_this_windows_editor() {
+    let mut surface = Surface::new();
+    surface.preedit();
+    let other = surface.cx.with_vm(|vm| {
+        let value = vm.eval(crate::makepad_script::script! {
+            use mod.prelude.widgets.*
+            Window { create_on_start: false }
+        });
+        WidgetRef::script_from_value(vm, value).as_window()
+    });
+    let other_id = other.window_id().unwrap();
+    assert_ne!(surface.window.window_id().unwrap(), other_id);
+    for event in [Event::WindowLostFocus(other_id), Event::WindowGotFocus(other_id)] {
+        surface.event(event);
+        assert_eq!(surface.cx.key_focus(), surface.input.area());
+        assert!(surface.input.is_composing());
+        assert!(surface.window.borrow().unwrap().has_focus);
+        assert_eq!(surface.input.text(), "你好");
+    }
+}
+
+#[test]
+fn duplicate_window_lost_focus_retains_the_saved_editor_for_return() {
+    let mut surface = Surface::new();
+    let id = surface.window.window_id().unwrap();
+    for _ in 0..3 {
+        surface.event(Event::WindowLostFocus(id));
+        assert_eq!(surface.cx.key_focus(), Area::Empty);
+        assert!(!surface.window.borrow().unwrap().has_focus);
+    }
+    surface.event(Event::WindowGotFocus(id));
+    assert_eq!(surface.cx.key_focus(), surface.input.area());
+    assert!(surface.window.borrow().unwrap().has_focus);
+    surface.preedit();
+}
