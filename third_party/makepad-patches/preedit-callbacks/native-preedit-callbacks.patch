+#[test]
+fn focus_loss_cancels_preview_and_preserves_existing_redo() {
+    let mut s = Surface::new();
+    s.text("old", false);
+    s.input.replace_range(&mut s.cx, 0..3, "new", UndoGroup::New).unwrap();
+    s.undo();
