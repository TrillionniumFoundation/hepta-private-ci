+#[test]
+fn checkpoint_and_restore_exclude_uncommitted_preview_and_keep_prior_redo() {
+    let mut s = Surface::new();
+    s.text("a旧z", false);
+    s.select(1, 4);
+    s.input.replace_range(&mut s.cx, 1..4, "新", UndoGroup::New).unwrap();
+    s.undo();
+    let before = format!("{:?}", s.input.save_state());
+    s.text("你好", true);
+    let checkpoint = s.input.save_state();
+    assert_eq!(format!("{:?}", checkpoint), before);
+    s.input.restore_state(&mut s.cx, checkpoint);
+    assert_eq!(s.input.text(), "a旧z");
+    assert!(!s.input.is_composing());
+    s.redo(); assert_eq!(s.input.text(), "a新z");
+    s.text("", true);
+    assert_eq!(s.input.text(), "a新z");
+}
