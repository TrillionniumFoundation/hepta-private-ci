+#[test]
+fn select_all_uses_the_restored_committed_length_after_short_preview() {
+    let mut s = Surface::new();
+    s.text("original long text", false);
+    s.select(0, s.input.text().len());
+    s.text("你", true);
+    s.key(KeyCode::KeyA, false);
+    assert_eq!(s.input.text(), "original long text");
+    assert_eq!(s.input.selected_text(), "original long text");
+    assert!(!s.input.is_composing());
+    s.text("x", false);
+    s.undo(); assert_eq!(s.input.text(), "original long text");
+}
