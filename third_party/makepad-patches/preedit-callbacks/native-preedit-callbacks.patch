+#[test]
+fn normal_typing_on_both_sides_stays_in_separate_undo_groups() {
+    let mut s = Surface::new();
+    s.text("a", false); s.text("b", false);
+    s.compose("你好");
+    s.text("c", false); s.text("d", false);
+    s.undo(); assert_eq!(s.input.text(), "ab你好");
+    s.undo(); assert_eq!(s.input.text(), "ab");
+    s.undo(); assert_eq!(s.input.text(), "");
+    s.redo(); s.redo(); s.redo();
+    assert_eq!(s.input.text(), "ab你好cd");
+}
