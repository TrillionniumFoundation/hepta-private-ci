+#[derive(Clone, Debug)]
+struct CompositionEdit {
+    replaced: String,
+    selection: Selection,
+}
+
+impl CompositionEdit {
+    fn project(&self, index: usize, start: usize, end: usize) -> usize {
+        if index <= start { index }
+        else if index >= end { index - (end - start) + self.replaced.len() }
+        else { start + self.replaced.len() }
+    }
+}
