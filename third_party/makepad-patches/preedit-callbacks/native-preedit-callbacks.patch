+#[test]
+fn previews_and_same_text_commit_are_one_keyboard_undo_and_redo() {
+    let mut s = Surface::new();
+    s.compose("你好");
+    assert_eq!(s.input.text(), "你好");
+    s.undo();
+    assert_eq!(s.input.text(), "");
+    s.redo();
+    assert_eq!(s.input.text(), "你好");
+    assert!(!s.input.is_composing());
+}
+
+#[test]
+fn composition_replacing_a_reversed_selection_restores_text_and_selection() {
+    let mut s = Surface::new();
+    s.text("a旧文z", false);
+    s.select(7, 1);
+    let selected = s.selection();
+    s.compose("新");
+    assert_eq!(s.input.text(), "a新z");
+    s.undo();
+    assert_eq!(s.input.text(), "a旧文z");
+    assert_eq!(format!("{:?}", s.selection()), format!("{:?}", selected));
+    s.redo();
+    assert_eq!(s.input.text(), "a新z");
+}
