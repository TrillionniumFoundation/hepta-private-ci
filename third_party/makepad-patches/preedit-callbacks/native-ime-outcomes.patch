 impl TextInputRef {
+    /// Bind before action production. This does not identify origin-less late
+    /// raw OS IME events; that platform-session boundary remains separate.
+    pub fn begin_edit_scope(&self) -> u64 {
+        static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+        let token = NEXT.fetch_update(std::sync::atomic::Ordering::Relaxed,
+            std::sync::atomic::Ordering::Relaxed, |n| n.checked_add(1))
+            .expect("text edit scope exhausted");
+        if let Some(mut inner) = self.borrow_mut() {
+            assert!(inner.composition_edit.is_none() && !inner.has_composition(),
+                "cancel previous composition before rebinding edit scope");
+            inner.edit_scope = token;
+            inner.edit_sequence = 0;
+            inner.edit_before = None;
+        }
+        token
+    }
+
+    pub fn edit_position(&self) -> (u64, u64) {
+        self.borrow().map_or((0, 0), |inner| (inner.edit_scope, inner.edit_sequence))
+    }
+
+    pub fn edit_outcomes(&self, actions: &Actions) -> Vec<TextEditOutcome> {
+        actions.filter_widget_actions_cast::<TextInputAction>(self.widget_uid())
+            .filter_map(|action| match action {
+                TextInputAction::EditOutcome(value) => Some(value), _ => None,
+            }).collect()
+    }
+
+    pub fn restore_checkpoint(&self, cx: &mut Cx, state: TextInputState) {
+        if let Some(mut inner) = self.borrow_mut() { inner.restore_checkpoint(cx, state); }
+    }
+
+    pub fn cancel_composition(&self, cx: &mut Cx) -> bool {
+        self.borrow_mut().is_some_and(|mut inner| inner.cancel_composition(cx))
+    }
