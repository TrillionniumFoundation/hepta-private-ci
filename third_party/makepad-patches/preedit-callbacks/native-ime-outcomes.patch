+// Integration regressions use this sibling's original drawn SDK Surface.
+// They qualify neither native session origin nor real platform input.
+use crate::window::WindowWidgetRefExt;
+
+fn scoped_outcomes(s: &mut Surface, text: &str, preview: bool) -> Vec<TextEditOutcome> {
+    let input = s.input.clone();
+    let actions = s.cx.capture_actions(|cx| {
+        input.borrow_mut().unwrap().handle_event(cx, &Event::TextInput(TextInputEvent {
+            input: text.into(), replace_last: preview, ..Default::default()
+        }), &mut Scope::empty());
+    });
+    input.edit_outcomes(&actions)
+}
+
+#[test]
+fn typed_outcomes_project_preview_and_filtered_input_without_reclassifying_live_phase() {
+    let mut s = Surface::new();
+    s.input.borrow_mut().unwrap().set_is_numeric_only(&mut s.cx, true);
+    let token = s.input.begin_edit_scope();
+    let preview = scoped_outcomes(&mut s, "12", true);
+    assert_eq!(preview.len(), 1);
+    assert_eq!(preview[0].phase, TextEditPhase::Preview);
+    assert_eq!(preview[0].state.text(), "");
+    assert_eq!(preview[0].scope, token);
+    assert!(scoped_outcomes(&mut s, "invalid", false).is_empty());
+    assert!(s.input.is_composing());
+    assert!(s.input.borrow().unwrap().edit_before.is_none());
+    let commit = scoped_outcomes(&mut s, "123", false);
+    assert_eq!(commit.len(), 1);
+    assert_eq!(commit[0].phase, TextEditPhase::Committed);
+    assert_eq!(commit[0].sequence, 2);
+    assert_eq!(commit[0].before.as_ref().unwrap().text(), "");
+    assert_eq!(commit[0].state.text(), "123");
+    scoped_outcomes(&mut s, "4", true);
+    assert!(s.input.is_composing());
+    assert_eq!(commit[0].state.text(), "123");
+}
+
+#[test]
+fn typed_cancel_emits_once_and_noop_undo_leaves_no_before_checkpoint() {
+    let mut s = Surface::new();
+    s.input.begin_edit_scope();
+    scoped_outcomes(&mut s, "你好", true);
+    let input = s.input.clone();
+    let actions = s.cx.capture_actions(|cx| {
+        input.borrow_mut().unwrap().handle_event(cx, &Event::KeyDown(KeyEvent {
+            key_code: KeyCode::KeyZ,
+            modifiers: KeyModifiers { control: true, ..Default::default() },
+            ..Default::default()
+        }), &mut Scope::empty());
+    });
+    let outcomes = input.edit_outcomes(&actions);
+    assert_eq!(outcomes.len(), 1);
+    assert_eq!(outcomes[0].phase, TextEditPhase::Cancelled);
+    assert_eq!(outcomes[0].state.text(), "");
+    assert!(!input.borrow_mut().unwrap().undo(&mut s.cx));
+    assert!(input.borrow().unwrap().edit_before.is_none());
+}
+
+#[test]
+fn scoped_first_pointer_press_cancels_before_invalid_layout_selection() {
+    let mut s = Surface::new();
+    s.text("original", false);
+    s.select(0, 8);
+    let before = format!("{:?}", s.input.save_state());
+    s.input.begin_edit_scope();
+    scoped_outcomes(&mut s, "你", true);
+    let window = s.cx.with_vm(|vm| {
+        let value = vm.eval(crate::makepad_script::script! {
+            use mod.prelude.widgets.*
+            Window { create_on_start: false }
+        });
+        WidgetRef::script_from_value(vm, value).as_window()
+    });
+    let rect = s.input.area().clipped_rect(&s.cx);
+    assert!(rect.size.x > 0.0 && rect.size.y > 0.0);
+    let input = s.input.clone();
+    let actions = s.cx.capture_actions(|cx| {
+        input.borrow_mut().unwrap().handle_event(cx, &Event::MouseDown(MouseDownEvent {
+            abs: rect.pos + rect.size * 0.5,
+            button: MouseButton::PRIMARY,
+            window_id: window.window_id().unwrap(),
+            modifiers: KeyModifiers::default(),
+            handled: std::cell::Cell::new(Area::Empty),
+            time: 0.0,
+        }), &mut Scope::empty());
+    });
+    let outcomes = input.edit_outcomes(&actions);
+    assert_eq!(outcomes.len(), 1);
+    assert_eq!(outcomes[0].phase, TextEditPhase::Cancelled);
+    assert_eq!(format!("{:?}", input.save_state()), before);
+    assert!(input.borrow().unwrap().laidout_text.is_none());
+}
