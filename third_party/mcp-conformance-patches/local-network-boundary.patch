diff --git a/third_party/mcp-conformance/src/fixture-network.test.ts b/third_party/mcp-conformance/src/fixture-network.test.ts
new file mode 100644
index 00000000..28b1f764
--- /dev/null
+++ b/third_party/mcp-conformance/src/fixture-network.test.ts
@@ -0,0 +1,182 @@
+import express from 'express';
+import type { Server } from 'node:http';
+import { afterEach, describe, expect, test } from 'vitest';
+import {
+  fixtureBrowserOrigins,
+  limitFixtureRequests,
+  listenOnLoopback,
+  requireFixtureBrowserOrigin
+} from './fixture-network';
+
+const servers: Server[] = [];
+afterEach(async () => {
+  await Promise.all(
+    servers.splice(0).map(
+      (server) =>
+        new Promise<void>((resolve) => {
+          server.closeAllConnections();
+          server.close(() => resolve());
+        })
+    )
+  );
+});
+async function start(app: express.Application) {
+  const listening = await listenOnLoopback(app);
+  servers.push(listening.server);
+  return listening;
+}
+
+describe('local fixture HTTP boundary', () => {
+  test('accepts local requests and rejects a real sequential burst before dispatch', async () => {
+    const app = express();
+    limitFixtureRequests(app);
+    let handled = 0;
+    app.post('/token', (_req, res) => {
+      handled += 1;
+      res.json({ accepted: true });
+    });
+    const { server, url } = await start(app);
+    expect(server.address()).toMatchObject({
+      address: '127.0.0.1',
+      family: 'IPv4'
+    });
+    const statuses: number[] = [];
+    for (let i = 0; i < 200; i++) {
+      const response = await fetch(`${url}/token`, { method: 'POST' });
+      statuses.push(response.status);
+      await response.arrayBuffer();
+    }
+    expect(statuses).toContain(200);
+    expect(statuses).toContain(429);
+    expect(handled).toBe(statuses.filter((status) => status === 200).length);
+    const denied = await fetch(`${url}/token`, { method: 'POST' });
+    expect(denied.status).toBe(429);
+    expect(denied.headers.get('retry-after')).toBe('1');
+    await denied.arrayBuffer();
+  });
+
+  test('rejects oversized and over-parameterized bodies without calling OAuth', async () => {
+    const app = express();
+    limitFixtureRequests(app);
+    let handled = 0;
+    app.post('/token', (_req, res) => {
+      handled += 1;
+      res.end();
+    });
+    const { url } = await start(app);
+    for (const [type, body] of [
+      ['application/json', JSON.stringify({ assertion: 'x'.repeat(65_536) })],
+      [
+        'application/x-www-form-urlencoded',
+        new URLSearchParams(
+          Array.from({ length: 65 }, (_, i) => [`p${i}`, 'value'])
+        ).toString()
+      ]
+    ]) {
+      const response = await fetch(`${url}/token`, {
+        method: 'POST',
+        headers: { 'Content-Type': type },
+        body
+      });
+      expect(response.status).toBe(413);
+      await response.arrayBuffer();
+    }
+    expect(handled).toBe(0);
+    const valid = await fetch(`${url}/token`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+      body: 'grant_type=authorization_code&code=fixture'
+    });
+    expect(valid.status).toBe(200);
+    expect(handled).toBe(1);
+    await valid.arrayBuffer();
+  });
+
+  test('caps active work and releases disconnected requests exactly once', async () => {
+    const app = express();
+    limitFixtureRequests(app);
+    let admitted = 0;
+    let batchReady: () => void = () => {};
+    let released = 0;
+    let batchClosed: () => void = () => {};
+    app.get('/hold', (_req, res) => {
+      admitted += 1;
+      res.flushHeaders();
+      res.once('close', () => {
+        released += 1;
+        if (released % 32 === 0) batchClosed();
+      });
+      if (admitted % 32 === 0) batchReady();
+    });
+    const { url } = await start(app);
+    for (let batch = 0; batch < 2; batch++) {
+      const ready = new Promise<void>((resolve) => {
+        batchReady = resolve;
+      });
+      const controllers = Array.from(
+        { length: 32 },
+        () => new AbortController()
+      );
+      const pending = controllers.map((controller) =>
+        fetch(`${url}/hold`, { signal: controller.signal }).catch(() => null)
+      );
+      await ready;
+      const denied = await fetch(`${url}/hold`);
+      expect(denied.status).toBe(429);
+      await denied.arrayBuffer();
+      // Wait for the server's close handlers before filling the second batch.
+      const closed = new Promise<void>((resolve) => {
+        batchClosed = resolve;
+      });
+      // The responses above publish headers, so client cancellation is a real socket close.
+      controllers.forEach((controller) => controller.abort());
+      await Promise.all(pending);
+      await closed;
+    }
+    expect(admitted).toBe(64);
+  });
+
+  test('rejects unlisted browser Origins while preserving non-browser and allowed clients', async () => {
+    const app = express();
+    app.use(
+      requireFixtureBrowserOrigin(
+        fixtureBrowserOrigins('http://127.0.0.1:6274')
+      )
+    );
+    let handled = 0;
+    app.post('/mcp', (_req, res) => {
+      handled += 1;
+      res.end();
+    });
+    const { url } = await start(app);
+    for (const origin of [
+      'https://attacker.invalid',
+      'null',
+      'http://127.0.0.1:6275'
+    ]) {
+      const denied = await fetch(`${url}/mcp`, {
+        method: 'POST',
+        headers: { Origin: origin }
+      });
+      expect(denied.status).toBe(403);
+      await denied.arrayBuffer();
+    }
+    expect(handled).toBe(0);
+    for (const headers of [
+      new Headers(), new Headers({ Origin: 'http://127.0.0.1:6274' })
+    ]) {
+      const accepted = await fetch(`${url}/mcp`, { method: 'POST', headers });
+      expect(accepted.status).toBe(200);
+      await accepted.arrayBuffer();
+    }
+    expect(handled).toBe(2);
+    for (const malformed of [
+      '*',
+      'null',
+      'https://allowed.invalid/path',
+      'https://user:secret@allowed.invalid'
+    ]) {
+      expect(() => fixtureBrowserOrigins(malformed)).toThrow();
+    }
+  });
+});
diff --git a/third_party/mcp-conformance/src/fixture-network.ts b/third_party/mcp-conformance/src/fixture-network.ts
new file mode 100644
index 00000000..73383099
--- /dev/null
+++ b/third_party/mcp-conformance/src/fixture-network.ts
@@ -0,0 +1,105 @@
+import express from 'express';
+import type { Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { performance } from 'node:perf_hooks';
+
+/** Local harness admission, separate from OAuth success/failure observations. */
+export function limitFixtureRequests(app: express.Application): void {
+  // One bucket per fixture, not an unbounded map keyed by attacker input.
+  const capacity = 120;
+  let tokens = capacity;
+  let updated = performance.now();
+  let active = 0;
+  app.use((_req, res, next) => {
+    const now = performance.now();
+    tokens = Math.min(capacity, tokens + ((now - updated) * capacity) / 60_000);
+    updated = now;
+    if (tokens < 1 || active >= 32) {
+      res.setHeader('Retry-After', '1');
+      res.status(429).json({ error: 'fixture_request_limit' });
+      return;
+    }
+    tokens -= 1;
+    active += 1;
+    let released = false;
+    const release = () => {
+      if (!released) {
+        released = true;
+        active -= 1;
+      }
+    };
+    res.once('finish', release);
+    res.once('close', release);
+    next();
+  });
+  app.use(express.json({ limit: '64kb', inflate: false }));
+  app.use(
+    express.urlencoded({
+      extended: false,
+      limit: '64kb',
+      parameterLimit: 64,
+      inflate: false
+    })
+  );
+}
+
+/** Bound incomplete HTTP requests without shortening intentional MCP streams. */
+export async function listenOnLoopback(
+  app: express.Application,
+  port: number = 0
+): Promise<{ server: Server; url: string }> {
+  const server = app.listen(port, '127.0.0.1');
+  server.headersTimeout = 10_000;
+  server.requestTimeout = 15_000;
+  server.keepAliveTimeout = 5_000;
+  server.maxHeadersCount = 64;
+  server.maxRequestsPerSocket = 100;
+  try {
+    await new Promise<void>((resolve, reject) => {
+      server.once('error', reject);
+      server.once('listening', resolve);
+    });
+    const address = server.address() as AddressInfo;
+    return { server, url: `http://127.0.0.1:${address.port}` };
+  } catch (error) {
+    server.close();
+    throw error;
+  }
+}
+
+/** Browser Origins are explicit; non-browser clients send no Origin. */
+export function fixtureBrowserOrigins(
+  configured: string | undefined
+): Set<string> {
+  const origins =
+    configured === undefined
+      ? ['http://localhost:6274', 'http://127.0.0.1:6274']
+      : configured.split(',').map((origin) => origin.trim());
+  for (const origin of origins) {
+    const parsed = new URL(origin);
+    if (
+      !['http:', 'https:'].includes(parsed.protocol) ||
+      parsed.origin !== origin ||
+      parsed.username ||
+      parsed.password
+    ) {
+      throw new Error(
+        'MCP_CONFORMANCE_ALLOWED_ORIGINS requires exact HTTP(S) origins'
+      );
+    }
+  }
+  return new Set(origins);
+}
+
+export function requireFixtureBrowserOrigin(
+  origins: ReadonlySet<string>
+): express.RequestHandler {
+  return (req, res, next) => {
+    const origin = req.headers.origin;
+    if (origin !== undefined && !origins.has(origin)) {
+      res.status(403).json({ error: 'fixture_origin_not_allowed' });
+      return;
+    }
+    next();
+  };
+}
