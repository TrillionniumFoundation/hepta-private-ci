ee(path):
+    """Reject staged or unstaged source changes without comparing checkout EOL bytes.
+
+    Git performs the repository's clean conversion before comparing a worktree path
+    with ``HEAD``. That preserves exact committed-blob identity while accepting a
+    clean Windows checkout whose physical text bytes use CRLF. A raw ``read_bytes``
+    comparison incorrectly rejected those checkouts even though Git considered the
+    tree unchanged.
+    """
+
+    relative = path.relative_to(ROOT).as_posix()
+    result = subprocess.run(
+        ["git", "diff", "--quiet", "--no-ext-diff", "HEAD", "--", relative],
+        cwd=ROOT,
+        check=False,
+    )
+    if result.returncode == 0:
+        return
+    if result.returncode == 1:
+        raise RuntimeError(f"native source differs from committed bytes: {relative}")
+    raise RuntimeError(f"unable to compare native source with HEAD: {relative}")
+
+
