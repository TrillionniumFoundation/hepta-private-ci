+def parse_name_status(output: bytes) -> list[str]:
+    try:
+        fields = output.decode("utf-8").split("\0")
+    except UnicodeDecodeError as error:
+        raise ValueError("changed repository path is not UTF-8") from error
+    if fields and fields[-1] == "":
+        fields.pop()
+    changed: list[str] = []
+    index = 0
+    while index < len(fields):
+        status = fields[index]
+        index += 1
+        if not status or status[0] not in "ACDMRTUXB":
+            fail(f"unexpected Git name-status entry: {status!r}")
+        path_count = 2 if status[0] in "RC" else 1
+        if index + path_count > len(fields):
+            fail("truncated Git name-status output")
+        changed.extend(fields[index : index + path_count])
+        index += path_count
+    return changed
