+def local_dependency_roots(repository: Path) -> set[str]:
+    repository = repository.resolve()
+    workspace_root = repository / "codex-rs"
+    workspace = tomllib.loads((workspace_root / "Cargo.toml").read_text(encoding="utf-8"))
+    workspace_dependencies = workspace.get("workspace", {}).get("dependencies", {})
+    if not isinstance(workspace_dependencies, dict):
+        fail("workspace dependencies must be a table")
+
+    manifest_path = workspace_root / "hepta-agentd/Cargo.toml"
+    manifest = tomllib.loads(manifest_path.read_text(encoding="utf-8"))
+    roots: set[str] = set()
+    for table in dependency_tables(manifest):
+        for name, specification in table.items():
+            path_value: str | None = None
+            base = manifest_path.parent
+            if isinstance(specification, dict):
+                if isinstance(specification.get("path"), str):
+                    path_value = specification["path"]
+                elif specification.get("workspace") is True:
+                    inherited = workspace_dependencies.get(name)
+                    if isinstance(inherited, dict) and isinstance(
+                        inherited.get("path"), str
+                    ):
+                        path_value = inherited["path"]
+                        base = workspace_root
+            if path_value is None:
+                continue
+            resolved = (base / path_value).resolve()
+            try:
+                relative = resolved.relative_to(repository)
+            except ValueError as error:
+                raise ValueError(f"local dependency escapes repository: {name}") from error
+            roots.add(normalize(relative.as_posix()))
+    return roots
