--- /dev/null
+++ b/codex-rs/hepta-agentd/src/runtime_codex_policy_tests.rs
@@ -0,0 +1,72 @@
+use super::runtime_codex_policy::RuntimeCodexCallerActionV1;
+use super::runtime_codex_policy::RuntimeCodexFailureClassV1;
+
+#[test]
+fn failure_policy_is_stable_and_never_requests_blind_immediate_retry() {
+    let cases = [
+        (
+            RuntimeCodexFailureClassV1::AdmissionClosed,
+            RuntimeCodexCallerActionV1::ExitProcess,
+        ),
+        (
+            RuntimeCodexFailureClassV1::StartupReconciliation,
+            RuntimeCodexCallerActionV1::RetryLater,
+        ),
+        (
+            RuntimeCodexFailureClassV1::QueueCapacity,
+            RuntimeCodexCallerActionV1::RetryLater,
+        ),
+        (
+            RuntimeCodexFailureClassV1::CurrentTrustExpired,
+            RuntimeCodexCallerActionV1::RetrySameIdentity,
+        ),
+        (
+            RuntimeCodexFailureClassV1::GenerationFenced,
+            RuntimeCodexCallerActionV1::ExitProcess,
+        ),
+        (
+            RuntimeCodexFailureClassV1::DurableIdentityConflict,
+            RuntimeCodexCallerActionV1::OperatorRequired,
+        ),
+        (
+            RuntimeCodexFailureClassV1::PreparedUnfenced,
+            RuntimeCodexCallerActionV1::RetrySameIdentity,
+        ),
+        (
+            RuntimeCodexFailureClassV1::FencedUnresolved,
+            RuntimeCodexCallerActionV1::ReconcileOnly,
+        ),
+        (
+            RuntimeCodexFailureClassV1::PersistenceOutcomeUnknown,
+            RuntimeCodexCallerActionV1::ReconcileOnly,
+        ),
+        (
+            RuntimeCodexFailureClassV1::TerminalWitnessConflict,
+            RuntimeCodexCallerActionV1::OperatorRequired,
+        ),
+        (
+            RuntimeCodexFailureClassV1::ShutdownRecoveryRequired,
+            RuntimeCodexCallerActionV1::ReconcileOnly,
+        ),
+        (
+            RuntimeCodexFailureClassV1::OwnerFailed,
+            RuntimeCodexCallerActionV1::ExitProcess,
+        ),
+    ];
+
+    for (failure, action) in cases {
+        assert_eq!(failure.caller_action(), action);
+        assert!(!failure.permits_immediate_retry());
+        assert!(!failure.as_str().is_empty());
+        assert!(!action.as_str().is_empty());
+    }
+}
+
+#[test]
+fn queue_capacity_is_the_only_non_readiness_blocking_failure() {
+    let capacity = RuntimeCodexFailureClassV1::QueueCapacity;
+    let unresolved = RuntimeCodexFailureClassV1::FencedUnresolved;
+    assert!(!capacity.blocks_readiness());
+    assert!(unresolved.blocks_readiness());
+    assert!(unresolved.requires_reconciliation());
+}
