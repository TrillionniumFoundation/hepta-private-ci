+        with:
+          name: agentd-merge-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/agentd-merge-evidence
+      - name: Verify merge identity and result
+        if: needs.scope.outputs.applicable == 'true'
+        env:
+          SCOPE_RESULT: ${{ needs.scope.result }}
+          SOURCE_SHA: ${{ github.event.pull_request.head.sha }}
+          BASE_SHA: ${{ github.event.pull_request.base.sha }}
+          MERGE_SHA: ${{ github.sha }}
+          MERGE_RESULT: ${{ needs.merge-candidate.result }}
+        run: |
+          set -euo pipefail
+          test "$SCOPE_RESULT" = success
+          test "$MERGE_RESULT" = success
