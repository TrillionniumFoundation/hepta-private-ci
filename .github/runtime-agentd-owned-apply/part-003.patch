+              'schema': 'hepta.runtime-agentd-merge-receipt.v1',
+              'source_sha': os.environ['SOURCE_SHA'],
+              'base_sha': os.environ['BASE_SHA'],
+              'merge_sha': os.environ['MERGE_SHA'],
+              'merge_tree': data['merge_tree'],
+              'result': 'success',
+              'production_activation': False,
+          }
+          assert len(data['merge_tree']) == 40
+          PY
+      - name: Require irrelevant merge job to remain skipped
+        if: needs.scope.result == 'success' && needs.scope.outputs.applicable != 'true'
+        env:
+          MERGE_RESULT: ${{ needs.merge-candidate.result }}
+        run: test "$MERGE_RESULT" = skipped
+      - name: Reject failed scope selection
+        if: needs.scope.result != 'success'
+        run: exit 1
