+
+
+def fail(message: str) -> None:
+    raise ValueError(message)
+
+
+def normalize(value: str) -> str:
+    candidate = value.replace("\\", "/").strip()
+    path = PurePosixPath(candidate)
+    if (
+        not candidate
+        or any(character in candidate for character in ("\0", "\r", "\n"))
+        or path.is_absolute()
+        or ".." in path.parts
+    ):
+        fail(f"unsafe repository path: {value!r}")
+    normalized = path.as_posix().rstrip("/")
+    if normalized in ("", "."):
+        fail(f"empty repository path: {value!r}")
+    return normalized
+
+
+def read_json(path: Path) -> Any:
+    def unique(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+        result: dict[str, Any] = {}
+        for key, value in pairs:
+            if key in result:
+                fail(f"duplicate JSON key: {key}")
+            result[key] = value
+        return result
+
+    return json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=unique)
+
+
+def module_roots(repository: Path) -> set[str]:
+    ownership = read_json(repository / "docs/delivery/PATH_OWNERSHIP.json")
+    namespaces = ownership.get("moduleNamespaces")
+    if not isinstance(namespaces, list):
+        fail("PATH_OWNERSHIP.json has no moduleNamespaces list")
+    roots: set[str] = set()
+    for namespace in namespaces:
+        if not isinstance(namespace, dict) or namespace.get("module") != MODULE:
+            continue
+        bindings = namespace.get("rootBindings")
+        if not isinstance(bindings, list):
+            fail("runtime.agentd rootBindings must be a list")
+        for binding in bindings:
+            if not isinstance(binding, dict) or not isinstance(binding.get("path"), str):
+                fail("runtime.agentd root binding is malformed")
+            roots.add(normalize(binding["path"]))
+    if not roots:
+        fail("runtime.agentd has no repository-owned root")
+    return roots
+
+
