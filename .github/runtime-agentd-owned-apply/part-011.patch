red,
+                format!("runtime.codex {operation} failed to join: {error}"),
+            )
+        })?
+    }
+}
+
+fn nonzero_metric(metric: &AtomicU64) -> Option<u64> {
+    let value = metric.load(Ordering::Acquire);
+    (value != 0).then_some(value)
+}
+
+fn duration_millis(duration: std::time::Duration) -> u64 {
+    u64::try_from(duration.as_millis()).unwrap_or(u64::MAX)
+}
