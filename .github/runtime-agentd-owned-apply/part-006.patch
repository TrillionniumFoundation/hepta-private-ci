+use std::fmt;
+
+/// Stable runtime.codex failure categories for caller policy and operations.
+///
+/// The category is intentionally independent of product adapters and payloads so
+/// the daemon core can decide whether to retry, reconcile, stop, or require an
+/// operator without parsing error text.
+#[non_exhaustive]
+#[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd)]
+pub enum RuntimeCodexFailureClassV1 {
+    AdmissionClosed,
+    StartupReconciliation,
+    QueueCapacity,
+    CurrentTrustExpired,
+    GenerationFenced,
+    DurableIdentityConflict,
+    PreparedUnfenced,
+    FencedUnresolved,
+    PersistenceOutcomeUnknown,
+    TerminalWitnessConflict,
+    ShutdownRecoveryRequired,
+    OwnerFailed,
+}
+
+/// Required caller action for a stable runtime.codex failure category.
+#[non_exhaustive]
+#[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd)]
+pub enum RuntimeCodexCallerActionV1 {
+    RetryLater,
+    RetrySameIdentity,
+    ReconcileOnly,
+    OperatorRequired,
+    ExitProcess,
+}
+
+impl RuntimeCodexFailureClassV1 {
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::AdmissionClosed => "admission_closed",
+            Self::StartupReconciliation => "startup_reconciliation",
+            Self::QueueCapacity => "queue_capacity",
+            Self::CurrentTrustExpired => "current_trust_expired",
+            Self::GenerationFenced => "generation_fenced",
+            Self::DurableIdentityConflict => "durable_identity_conflict",
+            Self::PreparedUnfenced => "prepared_unfenced",
+            Self::FencedUnresolved => "fenced_unresolved",
+            Self::PersistenceOutcomeUnknown => "persistence_outcome_unknown",
+            Self::TerminalWitnessConflict => "terminal_witness_conflict",
+            Self::ShutdownRecoveryRequired => "shutdown_recovery_required",
+            Self::OwnerFailed => "owner_failed",
+        }
+    }
+
+    pub const fn caller_action(self) -> RuntimeCodexCallerActionV1 {
+        match self {
+            Self::QueueCapacity | Self::StartupReconciliation => {
+                RuntimeCodexCallerActionV1::RetryLater
+            }
+            Self::CurrentTrustExpired | Self::PreparedUnfenced => {
+                RuntimeCodexCallerActionV1::RetrySameIdentity
+            }
+            Self::FencedUnresolved
+            | Self::PersistenceOutcomeUnknown
+            | Self::ShutdownRecoveryRequired => RuntimeCodexCallerActionV1::ReconcileOnly,
+            Self::DurableIdentityConflict | Self::TerminalWitnessConflict => {
+                RuntimeCodexCallerActionV1::OperatorRequired
+            }
+            Self::AdmissionClosed | Self::GenerationFenced | Self::OwnerFailed => {
+                RuntimeCodexCallerActionV1::ExitProcess
+            }
+        }
+    }
+
+    pub const fn blocks_readiness(self) -> bool {
+        !matches!(self, Self::QueueCapacity)
+    }
+
+    pub const fn permits_immediate_retry(self) -> bool {
+        false
+    }
+
+    pub const fn permits_same_identity_retry(self) -> bool {
+        matches!(
+            self.caller_action(),
+            RuntimeCodexCallerActionV1::RetryLater
+                | RuntimeCodexCallerActionV1::RetrySameIdentity
+        )
+    }
+
+    pub const fn requires_reconciliation(self) -> bool {
+        matches!(
+            self.caller_action(),
+            RuntimeCodexCallerActionV1::ReconcileOnly
+        )
+    }
+
+    pub const fn requires_operator(self) -> bool {
+        matches!(
+            self.caller_action(),
+            RuntimeCodexCallerActionV1::OperatorRequired
+        )
+    }
+}
+
+impl RuntimeCodexCallerActionV1 {
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::RetryLater => "retry_later",
+            Self::RetrySameIdentity => "retry_same_identity",
+            Self::ReconcileOnly => "reconcile_only",
+            Self::OperatorRequired => "operator_required",
+            Self::ExitProcess => "exit_process",
+        }
+    }
+}
