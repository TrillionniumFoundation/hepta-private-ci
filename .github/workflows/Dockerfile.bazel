FROM ubuntu:24.04

# TODO(mbolin): Published to docker.io/mbolin491/codex-bazel:latest for
# initial debugging, but we should publish to a more proper location.
#
# docker buildx create --use
# docker buildx build --platform linux/amd64,linux/arm64 -f .github/workflows/Dockerfile.bazel -t mbolin491/codex-bazel:latest --push .

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl git python3 ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install dotslash.
RUN curl -LSfs "https://github.com/facebook/dotslash/releases/download/v0.5.8/dotslash-ubuntu-22.04.$(uname -m).tar.gz" | tar fxz - -C /usr/local/bin

# Ubuntu 24.04 ships with user 'ubuntu' already created with UID 1000.
USER ubuntu

WORKDIR /workspace

# Supply only the authenticated distribution ssh-keygen file. The complete client
# package's postinst changes /etc/group for ssh-agent and is intentionally not run.
USER root
COPY --chmod=0444 .github/rbe-openssh/image_prepare.py .github/rbe-openssh/tool_supply.py /usr/local/lib/hepta-rbe-openssh/
RUN ["/usr/bin/python3", "-I", "-B", "/usr/local/lib/hepta-rbe-openssh/image_prepare.py", "install"]
USER ubuntu
RUN ["/usr/bin/python3", "-I", "-B", "/usr/local/lib/hepta-rbe-openssh/image_prepare.py", "qualify"]
USER root
RUN ["/usr/bin/install", "-o", "0", "-g", "0", "-m", "0444", "/tmp/hepta-rbe-openssh-tool-test.json", "/usr/local/share/hepta-rbe-openssh/tool-test.json"]
RUN ["/usr/bin/rm", "--", "/tmp/hepta-rbe-openssh-tool-test.json"]
USER ubuntu
WORKDIR /workspace
