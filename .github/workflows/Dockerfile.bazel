ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

# bazel-image.yml publishes source- and architecture-specific images. CI passes
# a resolved Ubuntu manifest digest as BASE_IMAGE and records it with the build.

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl git python3 ca-certificates openssh-client && \
    rm -rf /var/lib/apt/lists/*

# Install dotslash.
RUN curl -LSfs "https://github.com/facebook/dotslash/releases/download/v0.5.8/dotslash-ubuntu-22.04.$(uname -m).tar.gz" | tar fxz - -C /usr/local/bin

# Ubuntu 24.04 ships with user 'ubuntu' already created with UID 1000.
USER ubuntu

WORKDIR /workspace
