# Keep the exact Python/glibc base observed by the original R3 SDK job.
FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30

# Tests continue to run as the caller UID/GID in sdk.yml; only this build layer is root.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends zstd \
    && zstd --version \
    && rm -rf /var/lib/apt/lists/*
