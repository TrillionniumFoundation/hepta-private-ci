diff --git a/.github/workflows/hepta-intelligence-qualification-host.yml b/.github/workflows/hepta-intelligence-qualification-host.yml
index ed99920ee7cc891cb7742180594b232f2f3c2c26..508e4d4b677a59e8ca511c91075ff46dc437ae8a 100644
--- a/.github/workflows/hepta-intelligence-qualification-host.yml
+++ b/.github/workflows/hepta-intelligence-qualification-host.yml
@@ -132,11 +132,54 @@ jobs:
           destination.write_text(candidates[0] + "\n")
           PY
           }
+          compile_integration_probe() {
+            local package="$1"
+            local target_name="$2"
+            local label="$3"
+            local json="$root/${label}-build.jsonl"
+            local log="$root/${label}-build.log"
+            cargo test --release --locked -p "$package" --test "$target_name" --no-run \
+              --message-format=json-render-diagnostics > "$json" 2> "$log"
+            python3 - "$json" "$root/${label}-test-binary" "$target_name" <<'PY'
+          import json, pathlib, sys
+          source = pathlib.Path(sys.argv[1])
+          destination = pathlib.Path(sys.argv[2])
+          target_name = sys.argv[3]
+          candidates = []
+          for line in source.read_text().splitlines():
+              try:
+                  value = json.loads(line)
+              except json.JSONDecodeError:
+                  continue
+              if value.get("reason") != "compiler-artifact":
+                  continue
+              target = value.get("target", {})
+              profile = value.get("profile", {})
+              executable = value.get("executable")
+              if (
+                  executable
+                  and profile.get("test") is True
+                  and target.get("name") == target_name
+                  and "test" in target.get("kind", [])
+              ):
+                  candidates.append(executable)
+          candidates = sorted(set(candidates))
+          if len(candidates) != 1:
+              raise SystemExit(
+                  f"expected one {target_name} integration test binary, observed {candidates}"
+              )
+          destination.write_text(candidates[0] + "\n")
+          PY
+          }
           compile_probe codex-hepta-agentd codex_hepta_agentd agentd
+          compile_probe codex-hepta-intelligence codex_hepta_intelligence intelligence
+          compile_integration_probe codex-hepta-intelligence canonical_candidate_closure intelligence-candidate
           compile_probe codex-hepta-operations codex_hepta_operations operations
           compile_probe codex-hepta-infer-worker-host codex_hepta_infer_worker_host infer-worker
           compile_probe codex-hepta-supervisor codex_hepta_supervisor supervisor
           printf 'AGENTD_TEST_BINARY=%s\n' "$(cat "$root/agentd-test-binary")" >> "$GITHUB_ENV"
+          printf 'INTELLIGENCE_TEST_BINARY=%s\n' "$(cat "$root/intelligence-test-binary")" >> "$GITHUB_ENV"
+          printf 'INTELLIGENCE_CANDIDATE_TEST_BINARY=%s\n' "$(cat "$root/intelligence-candidate-test-binary")" >> "$GITHUB_ENV"
           printf 'OPERATIONS_TEST_BINARY=%s\n' "$(cat "$root/operations-test-binary")" >> "$GITHUB_ENV"
           printf 'INFER_WORKER_TEST_BINARY=%s\n' "$(cat "$root/infer-worker-test-binary")" >> "$GITHUB_ENV"
           printf 'SUPERVISOR_TEST_BINARY=%s\n' "$(cat "$root/supervisor-test-binary")" >> "$GITHUB_ENV"
@@ -181,18 +224,19 @@ jobs:
           set -euo pipefail
           root="$RUNNER_TEMP/intelligence-qualification-host"
           : > "$root/semantic-quality.jsonl"
-          for filter in \
-            actual_stage_outputs_fill_templates_but_reject_substitution \
-            utility_universe_rejects_foreign_and_missing_candidates \
-            signed_input_cannot_install_host_trust_or_change_actual_context \
-            final_gate_rehashes_every_envelope_dependency \
-            membership_gate_rejects_mutated_legal_support
-          do
-            output="$root/quality-${filter}.log"
-            timeout 180 "$AGENTD_TEST_BINARY" "$filter" --nocapture --test-threads=1 > "$output" 2>&1
+          run_quality_probe() {
+            local executable="$1"
+            local filter="$2"
+            local output="$root/quality-${filter}.log"
+            timeout 180 "$executable" "$filter" --nocapture --test-threads=1 > "$output" 2>&1
             grep -Eq 'test result: ok\. [1-9][0-9]* passed' "$output"
             printf '{"test":"%s","status":"passed"}\n' "$filter" >> "$root/semantic-quality.jsonl"
-          done
+          }
+          run_quality_probe "$AGENTD_TEST_BINARY" actual_stage_outputs_fill_templates_but_reject_substitution
+          run_quality_probe "$AGENTD_TEST_BINARY" utility_universe_rejects_foreign_and_missing_candidates
+          run_quality_probe "$AGENTD_TEST_BINARY" signed_input_cannot_install_host_trust_or_change_actual_context
+          run_quality_probe "$INTELLIGENCE_CANDIDATE_TEST_BINARY" final_gate_rehashes_every_envelope_dependency
+          run_quality_probe "$INTELLIGENCE_TEST_BINARY" membership_gate_rejects_mutated_legal_support
 
       - name: Measure canonical real-owner preparation latency and RSS
         working-directory: codex-rs
diff --git a/codex-rs/hepta-operations/src/durable_model.rs b/codex-rs/hepta-operations/src/durable_model.rs
index e7b2eb76abc79cc3e2a8ee7ae08f84e07b094a94..099b4c2d2ebce710049635c7e2bd3dba3c6ad20c 100644
--- a/codex-rs/hepta-operations/src/durable_model.rs
+++ b/codex-rs/hepta-operations/src/durable_model.rs
@@ -302,6 +302,35 @@ pub enum DestinationApplyDisposition {
     AlreadyApplied,
 }
 
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum DurableFailureClass {
+    InvalidRequest,
+    MissingOperation,
+    IdentityConflict,
+    RetiredIdentity,
+    CapacityInsufficient,
+    StaleOwnerGeneration,
+    LeaseLost,
+    InvalidTransition,
+    ClockRollback,
+    PermissionDenied,
+    PersistenceCorrupt,
+    OutcomeUnknown,
+}
+
+/// The only recovery actions exposed to callers. In particular, an unavailable
+/// durable store is treated as an unknown commit outcome and must be reconciled
+/// before the same effect is attempted again.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum RecoveryDisposition {
+    Reject,
+    RetrySameIdentity,
+    RetryAfterCapacity,
+    ReconcileOnly,
+    ReplaceOwner,
+    RepairClockOrStore,
+}
+
 #[derive(Debug)]
 pub enum DurableOperationError {
     Invalid(&'static str),
@@ -349,6 +378,67 @@ impl fmt::Display for DurableOperationError {
     }
 }
 
+impl DurableOperationError {
+    #[must_use]
+    pub const fn failure_class(&self) -> DurableFailureClass {
+        match self {
+            Self::Invalid(_) => DurableFailureClass::InvalidRequest,
+            Self::Missing(_) => DurableFailureClass::MissingOperation,
+            Self::Conflict(_) => DurableFailureClass::IdentityConflict,
+            Self::Retired(_) => DurableFailureClass::RetiredIdentity,
+            Self::Capacity => DurableFailureClass::CapacityInsufficient,
+            Self::StaleGeneration => DurableFailureClass::StaleOwnerGeneration,
+            Self::StaleLease => DurableFailureClass::LeaseLost,
+            Self::InvalidTransition { .. } => DurableFailureClass::InvalidTransition,
+            Self::ClockRollback => DurableFailureClass::ClockRollback,
+            Self::Authority(_) => DurableFailureClass::PermissionDenied,
+            Self::Corrupt(_) => DurableFailureClass::PersistenceCorrupt,
+            Self::Unavailable(_) => DurableFailureClass::OutcomeUnknown,
+        }
+    }
+
+    #[must_use]
+    pub const fn recovery_disposition(&self) -> RecoveryDisposition {
+        match self {
+            Self::Invalid(_) | Self::Conflict(_) | Self::Retired(_) | Self::Authority(_) => {
+                RecoveryDisposition::Reject
+            }
+            Self::Capacity => RecoveryDisposition::RetryAfterCapacity,
+            Self::StaleGeneration => RecoveryDisposition::ReplaceOwner,
+            Self::Missing(_)
+            | Self::StaleLease
+            | Self::InvalidTransition { .. }
+            | Self::Unavailable(_) => RecoveryDisposition::ReconcileOnly,
+            Self::ClockRollback | Self::Corrupt(_) => RecoveryDisposition::RepairClockOrStore,
+        }
+    }
+}
+
+impl DurableOperationState {
+    #[must_use]
+    pub const fn recovery_disposition(self) -> RecoveryDisposition {
+        match self {
+            Self::Prepared => RecoveryDisposition::RetrySameIdentity,
+            Self::Dispatching | Self::Dispatched | Self::Indeterminate => {
+                RecoveryDisposition::ReconcileOnly
+            }
+            Self::Applied | Self::NotApplied | Self::Quarantined => RecoveryDisposition::Reject,
+        }
+    }
+}
+
+impl<T> DispatchEffect<T> {
+    #[must_use]
+    pub const fn recovery_disposition(&self) -> RecoveryDisposition {
+        match self {
+            Self::NotDispatched { .. } => RecoveryDisposition::RetrySameIdentity,
+            Self::Dispatched 