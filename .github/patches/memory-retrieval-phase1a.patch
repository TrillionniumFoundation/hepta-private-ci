+
+  verdict:
+    name: Memory retrieval aggregate verdict
+    needs: [identity, qualify, manifest]
+    if: ${{ always() }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 5
+    steps:
+      - name: Require every qualification lane
+        shell: bash
+        env:
+          IDENTITY_RESULT: ${{ needs.identity.result }}
+          QUALIFY_RESULT: ${{ needs.qualify.result }}
+          MANIFEST_RESULT: ${{ needs.manifest.result }}
+        run: |
+          set -euo pipefail
+          test "$IDENTITY_RESULT" = success
+          test "$QUALIFY_RESULT" = success
+          test "$MANIFEST_RESULT" = success
