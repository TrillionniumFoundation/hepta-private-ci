+#[tokio::test]
+async fn owned_event_reader_preserves_real_notification_provenance_and_graceful_shutdown() {
+    let (stream, peer) = tokio::io::duplex(8192);
+    let peer = tokio::spawn(async move {
+        let mut peer = WebSocketStream::from_raw_socket(
+            peer,
+            tokio_tungstenite::tungstenite::protocol::Role::Server,
+            None,
+        )
+        .await;
+        while let Some(message) = peer.next().await {
+            match message.expect("valid peer frame") {
+                Message::Text(text) => {
+                    let message: serde_json::Value = serde_json::from_str(&text).expect("JSON");
+                    match message["method"].as_str() {
+                        Some("initialize") => {
+                            peer.send(Message::Text(serde_json::json!({
+                                "id": message["id"],
+                                "result": {"userAgent": "owned-events/1", "codexHome": "fixture-home"}
+                            }).to_string().into())).await.expect("initialize reply");
+                        }
+                        Some("initialized") => {
+                            peer.send(Message::Text(
+                                serde_json::json!({
+                                    "method": "turn/completed",
+                                    "params": {"threadId": "thread-a", "turn": {
+                                        "id": "turn-a", "items": [], "itemsView": "full",
+                                        "status": "completed", "error": null
+                                    }}
+                                })
+                                .to_string()
+                                .into(),
+                            ))
+                            .await
+                            .expect("terminal event");
+                        }
+                        method => panic!("unexpected request {method:?}"),
+                    }
+                }
+                Message::Close(_) => return,
+                message => panic!("unexpected frame {message:?}"),
+            }
+        }
+    });
+    let websocket = WebSocketStream::from_raw_socket(
+        stream,
+        tokio_tungstenite::tungstenite::protocol::Role::Client,
+        None,
+    )
+    .await;
+    let args = RemoteAppServerConnectArgs {
+        endpoint: RemoteAppServerEndpoint::WebSocket {
+            websocket_url: "ws://unused.test".into(),
+            auth_token: None,
+        },
+        client_name: "owned-events".into(),
+        client_version: "1".into(),
+        experimental_api: true,
+        mcp_server_openai_form_elicitation: false,
+        opt_out_notification_methods: Vec::new(),
+        channel_capacity: 8,
+    };
+    let mut client = RemoteAppServerClient::connect_with_stream(
+        8,
+        RemoteEventMode::Bounded { capacity: 16 },
+        "in-memory owned event fixture".into(),
+        websocket,
+        args.initialize_params(),
+    )
+    .await
+    .expect("initialized client")
+    .into_abort_on_drop();
+    let connection_id = client.connection_id();
+    let worker = client.worker_handle.abort_handle();
+    let event = timeout(Duration::from_secs(10), client.next_observed_event())
+        .await
+        .expect("event deadline")
+        .expect("actual notification");
+    assert_eq!(event.connection_id(), connection_id);
+    assert_eq!(event.server_version(), Some("1"));
+    assert_eq!(event.codex_home(), Some("fixture-home"));
+    let AppServerEvent::ServerNotification(notification) = event.event() else {
+        panic!("expected protocol notification");
+    };
+    let ServerNotification::TurnCompleted(notification) = notification.as_ref() else {
+        panic!("expected terminal notification");
+    };
+    assert_eq!(notification.thread_id, "thread-a");
+    assert_eq!(notification.turn.id, "turn-a");
+    client.shutdown().await.expect("graceful owned shutdown");
+    assert!(worker.is_finished(), "graceful shutdown joined worker");
+    timeout(Duration::from_secs(10), peer)
+        .await
+        .expect("peer deadline")
+        .expect("peer completed");
+}
