+#[test]
+fn existing_fifo_is_rejected_without_waiting_for_a_peer() {
+    use std::os::unix::ffi::OsStrExt;
+    use std::os::unix::fs::FileTypeExt;
+    let temp = tempfile::tempdir().expect("fixture");
+    let path = temp.path().join("fifo");
+    let name = std::ffi::CString::new(path.as_os_str().as_bytes()).expect("fixture path");
+    // SAFETY: name is a live NUL-terminated path and mode contains permission bits.
+    assert_eq!(unsafe { libc::mkfifo(name.as_ptr(), 0o600) }, 0);
+    assert!(prepare(&path).is_err());
+    assert!(
+        fs::symlink_metadata(&path)
+            .expect("retained FIFO")
+            .file_type()
+            .is_fifo()
+    );
+}
