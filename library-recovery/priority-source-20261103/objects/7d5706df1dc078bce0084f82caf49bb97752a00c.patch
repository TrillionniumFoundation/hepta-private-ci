+//! Private bootstrap files must precede SQLite's first WAL/SHM creation.
+//! Existing files are validated, never truncated or permission-repaired here.
+
+use super::*;
+use std::os::unix::fs::MetadataExt;
+use std::os::unix::fs::OpenOptionsExt;
+use std::os::unix::fs::PermissionsExt;
+
+pub(super) fn prepare(path: &Path) -> Result<File, CognitiveStoreError> {
+    let (file, created) = match OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(path)
+    {
+        Ok(file) => (file, true),
+        Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => (
+            OpenOptions::new()
+                .read(true)
+                .write(true)
+                .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_NONBLOCK)
+                .open(path)
+                .map_err(unavailable)?,
+            false,
+        ),
+        Err(error) => return Err(unavailable(error)),
+    };
+    let metadata = file.metadata().map_err(unavailable)?;
+    // SAFETY: geteuid has no preconditions and does not dereference memory.
+    let owner = unsafe { libc::geteuid() };
+    if !metadata.is_file() || metadata.nlink() != 1 || metadata.uid() != owner {
+        return Err(CognitiveStoreError::Invalid(
+            "cognitive database must be one owner-held regular file".into(),
+        ));
+    }
+    if created {
+        // A restrictive umask may remove owner bits. Only this newly created,
+        // retained descriptor is normalized, before SQLite can create sidecars.
+        file.set_permissions(fs::Permissions::from_mode(/*mode*/ 0o600))
+            .map_err(unavailable)?;
+        file.sync_all().map_err(unavailable)?;
+        let parent = path.parent().ok_or_else(|| {
+            CognitiveStoreError::Invalid("cognitive database has no parent".into())
+        })?;
+        File::open(parent)
+            .and_then(|directory| directory.sync_all())
+            .map_err(unavailable)?;
+    } else if metadata.mode() & 0o7777 != 0o600 {
+        return Err(CognitiveStoreError::Invalid(
+            "existing cognitive database must already be private".into(),
+        ));
+    }
+    Ok(file)
+}
