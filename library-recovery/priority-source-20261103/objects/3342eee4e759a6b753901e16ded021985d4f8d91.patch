@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Select fixed canary coverage; a manual diagnostic is never a full receipt."""
+
+import argparse
+import json
+from pathlib import Path
+import re
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[2]
+CATALOG = Path(__file__).with_suffix(".json")
+DIAGNOSTIC = "linux-arm64-release-diagnostic"
+
+
+def plan(scope, event, expected_sha, windows_required, *, root=ROOT, catalog=CATALOG):
+    if scope not in {"full", DIAGNOSTIC}:
+        raise ValueError("unsupported V8 scope")
+    if scope != "full" and event != "workflow_dispatch":
+        raise ValueError("partial diagnostics require explicit manual dispatch")
+    if windows_required not in {"true", "false"}:
+        raise ValueError("missing or invalid Windows coverage decision")
+    if re.fullmatch(r"[0-9a-f]{40}", expected_sha) is None:
+        raise ValueError("expected source must be an exact commit")
+
+    def git(*args):
+        return subprocess.check_output(
+            ["git", "--no-replace-objects", *args], cwd=root, text=True
+        ).strip()
+
+    if git("rev-parse", "HEAD") != expected_sha:
+        raise ValueError("checkout is not the exact triggering source")
+    if git("status", "--porcelain", "--untracked-files=no"):
+        raise ValueError("tracked source changed before coverage selection")
+    rows = json.loads(catalog.read_text())
+    if not isinstance(rows, list) or len(rows) != 12:
+        raise ValueError("unexpected complete canary catalog")
+    if scope == DIAGNOSTIC:
+        rows = [
+            row for row in rows
+            if row["target"] == "aarch64-unknown-linux-gnu"
+            and row["sandbox"] is False
+        ]
+        expected = {
+            "runner": "ubuntu-24.04-arm", "bazel_config": "ci-v8",
+            "platform": "linux_arm64", "sandbox": False,
+            "target": "aarch64-unknown-linux-gnu", "v8_cpu": "arm64",
+            "variant": "release",
+        }
+        if rows != [expected]:
+            raise ValueError("diagnostic target configuration changed")
+    return {
+        "scope": scope,
+        "event": event,
+        "source_sha": expected_sha,
+        "source_tree": git("rev-parse", "HEAD^{tree}"),
+        "coverage": "configured-full" if scope == "full" else "manual-source-only-partial",
+        "qualification_pass": False,
+        "build_matrix": {"include": rows},
+        "build_timeout_minutes": 30 if scope == "full" else 150,
+        "windows_source_required": windows_required if scope == "full" else "false",
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--scope", required=True)
+    parser.add_argument("--event", required=True)
+    parser.add_argument("--expected-sha", required=True)
+    parser.add_argument("--windows-source-required", required=True)
+    parser.add_argument("--github-output", type=Path, required=True)
+    parser.add_argument("--receipt", type=Path, required=True)
+    args = parser.parse_args()
+    receipt = plan(args.scope, args.event, args.expected_sha, args.windows_source_required)
+    args.receipt.write_text(json.dumps(receipt, indent=2) + "\n")
+    with args.github_output.open("a") as output:
+        for key in ("scope", "build_timeout_minutes", "windows_source_required"):
+            output.write(f"{key}={receipt[key]}\n")
+        output.write("build_matrix=" + json.dumps(receipt["build_matrix"]) + "\n")
+    print(json.dumps(receipt, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
