+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+import v8_canary_matrix as selector
+from v8_canary_changes import canary_required, windows_source_required
+
+
+class V8MatrixTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.root = Path(temporary.name)
+        self.repo = self.root / "repo"
+        self.repo.mkdir()
+        scripts = self.repo / ".github/scripts"
+        scripts.mkdir(parents=True)
+        self.catalog = scripts / selector.CATALOG.name
+        self.catalog.write_bytes(selector.CATALOG.read_bytes())
+        self.script = scripts / "v8_canary_matrix.py"
+        self.script.write_bytes(Path(selector.__file__).read_bytes())
+        self.git("init", "-q")
+        self.git("config", "user.name", "V8 fixture")
+        self.git("config", "user.email", "fixture@example.invalid")
+        self.git("add", ".")
+        self.git("commit", "-qm", "exact source")
+        self.sha = self.git("rev-parse", "HEAD")
+
+    def git(self, *args):
+        return subprocess.check_output(
+            ["git", *args], cwd=self.repo, text=True, stderr=subprocess.PIPE
+        ).strip()
+
+    def plan(self, scope="full", event="pull_request", windows="true", sha=None):
+        return selector.plan(
+            scope, event, sha or self.sha, windows,
+            root=self.repo, catalog=self.catalog,
+        )
+
+    def test_full_default_preserves_complete_target_feature_catalog_and_budget(self):
+        targets = {
+            "x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu",
+            "x86_64-unknown-linux-musl", "aarch64-unknown-linux-musl",
+            "x86_64-apple-darwin", "aarch64-apple-darwin",
+        }
+        for event in ("pull_request", "workflow_call", "push", "workflow_dispatch"):
+            receipt = self.plan(event=event)
+            rows = receipt["build_matrix"]["include"]
+            self.assertEqual(len(rows), 12)
+            self.assertEqual(
+                {(row["target"], row["sandbox"]) for row in rows},
+                {(target, sandbox) for target in targets for sandbox in (True, False)},
+            )
+            self.assertEqual(receipt["build_timeout_minutes"], 30)
+            self.assertEqual(receipt["windows_source_required"], "true")
+            self.assertFalse(receipt["qualification_pass"])
+        self.assertEqual(self.plan(windows="false")["windows_source_required"], "false")
+
+    def test_manual_diagnostic_is_one_fixed_arm_release_and_never_full_pass(self):
+        receipt = self.plan(selector.DIAGNOSTIC, "workflow_dispatch")
+        self.assertEqual(receipt["build_matrix"]["include"], [{
+            "runner": "ubuntu-24.04-arm", "bazel_config": "ci-v8",
+            "platform": "linux_arm64", "sandbox": False,
+            "target": "aarch64-unknown-linux-gnu", "v8_cpu": "arm64",
+            "variant": "release",
+        }])
+        self.assertEqual(receipt["build_timeout_minutes"], 150)
+        self.assertEqual(receipt["windows_source_required"], "false")
+        self.assertEqual(receipt["coverage"], "manual-source-only-partial")
+        self.assertFalse(receipt["qualification_pass"])
+        self.assertEqual(receipt["source_sha"], self.sha)
+        self.assertEqual(receipt["source_tree"], self.git("rev-parse", "HEAD^{tree}"))
+
+    def test_partial_selector_rejected_for_every_nonmanual_event(self):
+        for event in ("pull_request", "workflow_call", "push", "", "schedule"):
+            with self.subTest(event=event), self.assertRaises(ValueError):
+                self.plan(selector.DIAGNOSTIC, event)
+
+    def test_invalid_scope_source_and_missing_classifier_are_rejected(self):
+        for kwargs in ({"scope": "arbitrary-target"}, {"sha": "0" * 40},
+                       {"sha": "main"}, {"windows": ""}):
+            with self.subTest(kwargs=kwargs), self.assertRaises(ValueError):
+                self.plan(**kwargs)
+
+    def test_tracked_source_mutation_rejected_before_receipt(self):
+        self.catalog.write_text("[]\n")
+        with self.assertRaisesRegex(ValueError, "tracked source changed"):
+            self.plan(selector.DIAGNOSTIC, "workflow_dispatch")
+
+    def test_changed_diagnostic_configuration_rejected_even_when_committed(self):
+        rows = json.loads(self.catalog.read_text())
+        for row in rows:
+            if row["target"] == "aarch64-unknown-linux-gnu" and not row["sandbox"]:
+                row["runner"] = "unexpected-runner"
+        self.catalog.write_text(json.dumps(rows))
+        self.git("add", ".")
+        self.git("commit", "-qm", "changed catalog")
+        self.sha = self.git("rev-parse", "HEAD")
+        with self.assertRaisesRegex(ValueError, "diagnostic target configuration"):
+            self.plan(selector.DIAGNOSTIC, "workflow_dispatch")
+
+    def test_cli_retains_receipt_and_emits_exact_matrix_outputs(self):
+        receipt_path = self.root / "receipt.json"
+        outputs = self.root / "outputs"
+        result = subprocess.run([
+            sys.executable, str(self.script), "--scope", selector.DIAGNOSTIC,
+            "--event", "workflow_dispatch", "--expected-sha", self.sha,
+            "--windows-source-required", "true", "--github-output", str(outputs),
+            "--receipt", str(receipt_path),
+        ], cwd=self.repo, capture_output=True, text=True, env=os.environ)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        receipt = json.loads(receipt_path.read_text())
+        values = dict(line.split("=", 1) for line in outputs.read_text().splitlines())
+        self.assertEqual(json.loads(values["build_matrix"]), receipt["build_matrix"])
+        self.assertEqual(values["build_timeout_minutes"], "150")
+        self.assertEqual(receipt["source_sha"], self.sha)
+
+    def test_selector_catalog_changes_remain_real_canary_inputs(self):
+        for path in (".github/scripts/v8_canary_matrix.py", ".github/scripts/v8_canary_matrix.json"):
+            self.assertTrue(canary_required({path}, "150.4.0", "150.4.0"))
+            self.assertTrue(windows_source_required({path}, "150.4.0", "150.4.0"))
+
+
+class WorkflowSelectionTests(unittest.TestCase):
+    def test_workflow_wires_manual_choice_exact_source_and_existing_full_guards(self):
+        sys.path.insert(0, str(selector.ROOT / "scripts"))
+        from hepta_workflow_commands import load_workflow
+        workflow = load_workflow((selector.ROOT / ".github/workflows/v8-canary.yml").read_text())
+        choice = workflow["on"]["workflow_dispatch"]["inputs"]["scope"]
+        self.assertEqual(choice["default"], "full")
+        self.assertEqual(choice["options"], ["full", selector.DIAGNOSTIC])
+        jobs = workflow["jobs"]
+        metadata = jobs["metadata"]
+        step = next(s for s in metadata["steps"] if s.get("id") == "matrix")
+        self.assertEqual(step["env"]["EXPECTED_SHA"], "${{ github.sha }}")
+        self.assertEqual(step["env"]["V8_SCOPE"], "${{ inputs.scope || 'full' }}")
+        self.assertIn("--expected-sha", step["run"])
+        self.assertIn("--receipt", step["run"])
+        self.assertEqual(metadata["outputs"]["build_matrix"], "${{ steps.matrix.outputs.build_matrix }}")
+        self.assertEqual(metadata["outputs"]["windows_source_required"], "${{ steps.matrix.outputs.windows_source_required }}")
+        self.assertEqual(jobs["build"]["strategy"]["matrix"], "${{ fromJSON(needs.metadata.outputs.build_matrix) }}")
+        self.assertEqual(jobs["build"]["timeout-minutes"], "${{ fromJSON(needs.metadata.outputs.build_timeout_minutes) }}")
+        self.assertEqual(jobs["build-windows-source"]["timeout-minutes"], "30")
+        for name in ("build", "build-windows-source"):
+            job = jobs[name]
+            checkout = job["steps"][0]
+            self.assertEqual(checkout["with"]["ref"], "${{ github.sha }}")
+            guard = next(s for s in job["steps"] if s.get("name") == "Verify exact triggering source")
+            self.assertIn('test "$(git rev-parse HEAD)" = "${GITHUB_SHA}"', guard["run"])
+            self.assertEqual(job["strategy"]["fail-fast"], "false")
+            self.assertTrue(any(s.get("name", "").startswith("Smoke") for s in job["steps"]))
+            self.assertTrue(any(s.get("name") == "Check for a clean worktree" for s in job["steps"]))
+        self.assertIn("needs.metadata.outputs.windows_source_required", jobs["build-windows-source"]["if"])
+
+
+if __name__ == "__main__":
+    unittest.main()
