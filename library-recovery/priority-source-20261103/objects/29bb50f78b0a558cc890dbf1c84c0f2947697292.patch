@@ -0,0 +1,52 @@
+"""Check the explicit host fixture command, not incidental Cargo harness output."""
+
+from pathlib import Path
+import unittest
+
+from hepta_workflow_commands import workflow_commands
+
+ROOT = Path(__file__).resolve().parents[1]
+WORKFLOW = ROOT / ".github/workflows/hepta-architecture-convergence.yml"
+STEP = "      - name: Actual production host reconciliation fixtures\n"
+EXPECTED = [
+    "python3", "../scripts/hepta_ci_exec.py", "--output",
+    "$RUNNER_TEMP/hepta-command-records/production-reconcile-host.json",
+    "--minimum-tests", "2", "--", "just", "test", "--locked",
+    "-p", "codex-hepta-agentd", "--features", "qualification-cognitive-write",
+    "--test", "production_reconcile_host", "--test-threads=1",
+]
+
+
+def host_commands(text):
+    return [command for command in workflow_commands(text)
+            if "production_reconcile_host" in command]
+
+
+class ArchitectureHostCommandTests(unittest.TestCase):
+    def test_dedicated_feature_enabled_command_has_independent_two_test_receipt(self):
+        text = WORKFLOW.read_text()
+        self.assertEqual(host_commands(text), [EXPECTED])
+        block = text.split(STEP, 1)[1].split("      - name:", 1)[0]
+        self.assertIn("steps.execution.outputs.run_native == 'true'", block)
+        self.assertIn("steps.scope.outputs.effects == 'true'", block)
+        self.assertIn("working-directory: codex-rs", block)
+        self.assertNotIn("continue-on-error", block)
+
+    def test_missing_feature_partial_filter_and_weaker_minimum_are_rejected(self):
+        text = WORKFLOW.read_text()
+        for before, after in (
+            ("--minimum-tests 2 -- just", "--minimum-tests 0 -- just"),
+            ("--minimum-tests 2 -- just", "--minimum-tests 1 -- just"),
+            ("--features qualification-cognitive-write ", ""),
+            ("--test production_reconcile_host --test-threads=1",
+             "--test production_reconcile_host observer_budget --test-threads=1"),
+            ("--test production_reconcile_host", "--lib"),
+        ):
+            with self.subTest(mutation=before):
+                mutated = text.replace(before, after, 1)
+                self.assertNotEqual(mutated, text)
+                self.assertNotEqual(host_commands(mutated), [EXPECTED])
+
+
+if __name__ == "__main__":
+    unittest.main()
