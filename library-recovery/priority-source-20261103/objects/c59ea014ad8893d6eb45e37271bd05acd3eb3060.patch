+struct FairReconcileTarget {
+    inner: CognitiveSourceOutboxTarget,
+    observed: std::sync::Mutex<Vec<String>>,
+}
+
+impl ProductionOutboxTarget for FairReconcileTarget {
+    fn dispatch<'a>(&'a self, _request: ProductionDispatchRequest) -> ProductionDispatchFuture<'a> {
+        panic!("reconciliation must not dispatch")
+    }
+}
+
+impl crate::FinalUseProductionOutboxTarget for FairReconcileTarget {
+    fn destination_id(&self) -> &str { COGNITIVE_SOURCE_DESTINATION_V1 }
+
+    fn observe_terminal<'a>(
+        &'a self, request: &'a ProductionDispatchRequest,
+    ) -> ProductionTerminalObservationFuture<'a> {
+        self.observed.lock().expect("observations").push(request.occurrence_key.clone());
+        Box::pin(async move {
+            if request.occurrence_key == "operation:fair:0" {
+                ProductionTerminalObservation::Unavailable { reason: "temporarily unavailable".to_string() }
+            } else {
+                crate::FinalUseProductionOutboxTarget::observe_terminal(&self.inner, request).await
+            }
+        })
+    }
+}
+
+async fn fair_reconcile_fixture() -> (TempDir, ProductionDurableWriter, FairReconcileTarget) {
+    let temp = TempDir::new().expect("temp");
+    let store = store(&temp).await;
+    let owner = store.owner_agent_id().clone();
+    let writer = ProductionDurableWriter::open(
+        store.clone(), production_authority(owner.clone()), &AllowVerifier,
+        "production:h4:fair-reconcile", 1,
+    ).await.expect("writer");
+    let target = FairReconcileTarget {
+        inner: CognitiveSourceOutboxTarget::new(store, CognitiveAccess::agent_private(owner.clone()))
+            .expect("target"),
+        observed: std::sync::Mutex::new(Vec::new()),
+    };
+    for index in 0..3 {
+        let id = format!("operation:fair:{index}");
+        let (draft, payload) = source_payload(&id, b"fair-source");
+        let intent = operation(&owner, &id, &payload, &draft, None);
+        writer.prepare_operation(intent.clone(), COGNITIVE_SOURCE_TOPIC_V1, &payload)
+            .await.expect("prepare");
+        writer.mark_indeterminate(&id, "qualification lost result").await.expect("unknown");
+        if index == 2 {
+            assert!(matches!(target.inner.dispatch(direct_request(&intent, payload)).await,
+                ProductionTargetOutcome::Committed { .. }));
+        }
+    }
+    (temp, writer, target)
+}
+
+#[tokio::test]
+async fn reconciliation_wraps_past_unavailable_unknown_prefix_across_clones() {
+    let (_temp, writer, target) = fair_reconcile_fixture().await;
+    writer.reconcile_target_batch(&target, 2).await.expect("first batch");
+    assert_eq!(writer.status("operation:fair:2").await.expect("pending"), LocalOutcomeState::Indeterminate);
+    writer.clone().reconcile_target_batch(&target, 2).await.expect("shared cursor");
+    assert_eq!(writer.status("operation:fair:2").await.expect("settled"), LocalOutcomeState::Committed);
+    writer.reconcile_target_batch(&target, 2).await.expect("wrap");
+    assert_eq!(*target.observed.lock().expect("observations"),
+        [0, 1, 2, 0, 1, 0].map(|index| format!("operation:fair:{index}")).to_vec());
+}
+
+#[tokio::test]
+async fn reconstruction_error_does_not_starve_unattempted_tail() {
+    let (_temp, writer, target) = fair_reconcile_fixture().await;
+    // Qualification-only tamper; the corrupt operation must still fail closed.
+    sqlx::query("DROP TRIGGER cognitive_operation_ledger_no_update")
+        .execute(&target.inner.store.pool).await.expect("tamper fixture");
+    sqlx::query("UPDATE cognitive_operation_ledger SET policy_generation = policy_generation + 1 WHERE operation_id = 'operation:fair:0'")
+        .execute(&target.inner.store.pool).await.expect("poison first row");
+    assert!(writer.reconcile_target_batch(&target, 3).await.is_err());
+    assert!(target.observed.lock().expect("observations").is_empty());
+    assert!(writer.reconcile_target_batch(&target, 3).await.is_err());
+    assert_eq!(writer.status("operation:fair:2").await.expect("healthy tail"), LocalOutcomeState::Committed);
+    assert_eq!(*target.observed.lock().expect("observations"),
+        [1, 2].map(|index| format!("operation:fair:{index}")).to_vec());
+}
