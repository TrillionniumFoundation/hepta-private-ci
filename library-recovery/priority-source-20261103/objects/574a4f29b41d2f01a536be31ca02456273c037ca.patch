+//! Real SQLite/raw-alias checks of exclusion wiring. Entry is reserved directly
+//! by the private fixture; these tests do not qualify a provider-entry API.
+
+use super::*;
+use crate::CognitiveRecoveryRequirement;
+use crate::operation_entry_gate::EntryGateError;
+use codex_hepta_types::StableId;
+use tempfile::TempDir;
+
+async fn fixture() -> (TempDir, ProductionDurableWriter, DurableDispatchClaim) {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path().join("fleet");
+    std::fs::create_dir(&root).unwrap();
+    let fleet = codex_hepta_paths::HeptaFleetRoot::parse(root).unwrap();
+    let owner = AgentId::parse("00000000-0000-4000-8000-00000000c061").unwrap();
+    let layout = fleet.layout().agent(&owner);
+    let authority = ProductionAuthorityLease::from_verified_parts(
+        owner.clone(),
+        Sha256Digest::for_bytes(b"entry-alias-grant"),
+        7,
+        11,
+        now_unix_seconds().unwrap() + 3600,
+        ProductionAuthorityToken::from_verified_bytes(b"entry-alias-token".to_vec()).unwrap(),
+    )
+    .unwrap();
+    let verifier: Arc<dyn ProductionAuthorityVerifier> =
+        Arc::new(|lease: &ProductionAuthorityLease, owner: &AgentId| {
+            if lease.agent_id == *owner {
+                Ok(())
+            } else {
+                Err("fixture owner mismatch".to_string())
+            }
+        });
+    let legacy = CognitiveStore::open(&layout).await.unwrap();
+    let first = ProductionDurableWriter::open_with_live_verifier(
+        legacy.clone(),
+        authority.clone(),
+        Arc::clone(&verifier),
+        "entry-alias-lease",
+        1,
+    )
+    .await
+    .unwrap();
+    let anchor = legacy.recovery_anchor().await.unwrap();
+    drop(first);
+    legacy.pool.close().await;
+    drop(legacy);
+    let recovered = CognitiveStore::open_with_recovery(
+        &layout,
+        CognitiveRecoveryRequirement::ExactCurrentCut(&anchor),
+        &authority,
+        verifier.as_ref(),
+    )
+    .await
+    .unwrap();
+    let writer = ProductionDurableWriter::open_with_live_verifier(
+        recovered,
+        authority,
+        verifier,
+        "entry-alias-lease",
+        1,
+    )
+    .await
+    .unwrap();
+    let payload = r#"{"operation":"entry-alias-op"}"#;
+    let intent = OperationIntentV1::new(
+        StableId::new("entry-alias-op").unwrap(),
+        StableId::new(owner.as_str()).unwrap(),
+        StableId::new("entry-alias-target").unwrap(),
+        codex_hepta_types::Digest32::of_bytes(payload.as_bytes()),
+        codex_hepta_types::Digest32::of_bytes(b"entry-alias-scope"),
+        codex_hepta_types::Generation::new(1).unwrap(),
+        None,
+    )
+    .unwrap();
+    let receipt = writer
+        .prepare_operation(intent, "entry.alias.test", payload)
+        .await
+        .unwrap();
+    let claim = writer.claim_dispatch_lease(&receipt, 60_000).await.unwrap();
+    writer
+        .mark_indeterminate("entry-alias-op", "fixture unknown effect")
+        .await
+        .unwrap();
+    let entered = operation_claims::mark_entered(writer.store(), &claim, now_unix_ms().unwrap())
+        .await
+        .unwrap();
+    (temp, writer, entered)
+}
+
+#[tokio::test]
+async fn pending_and_active_entry_fence_raw_clones_claims_and_lease_finalization() {
+    let (_temp, writer, claim) = fixture().await;
+    let raw = writer.lease.clone();
+    let gate = Arc::clone(writer.store().operation_entry_gate().unwrap());
+    let mut entry = gate
+        .reserve_entry(writer.lease_id(), "entry-alias-op")
+        .unwrap();
+    for phase in ["pending", "active"] {
+        if phase == "active" {
+            entry.activate().unwrap();
+        }
+        assert!(matches!(
+            raw.reconcile("entry-alias-op", LocalReconcileOutcome::Committed)
+                .await,
+            Err(LocalLeaseOutboxError::EntryInProgress { .. })
+        ));
+        assert!(matches!(
+            raw.rollback_occurrence("entry-alias-op", "fixture").await,
+            Err(LocalLeaseOutboxError::EntryInProgress { .. })
+        ));
+        assert!(matches!(
+            raw.release().await,
+            Err(LocalLeaseOutboxError::LeaseEntryInProgress { .. })
+        ));
+        assert!(matches!(
+            raw.rollback_lease().await,
+            Err(LocalLeaseOutboxError::LeaseEntryInProgress { .. })
+        ));
+        assert!(matches!(
+            raw.finalize_replayed_occurrence("entry-alias-op").await,
+            Err(LocalLeaseOutboxError::LeaseEntryInProgress { .. })
+        ));
+        assert!(matches!(
+            operation_claims::mark_settled(writer.store(), &claim, now_unix_ms().unwrap()).await,
+            Err(LocalLeaseOutboxError::EntryInProgress { .. })
+        ));
+        assert!(matches!(
+            operation_claims::renew(writer.store(), &claim, now_unix_ms().unwrap(), 60_000).await,
+            Err(LocalLeaseOutboxError::EntryInProgress { .. })
+        ));
+        assert!(matches!(
+            operation_claims::claim(
+                writer.store(),
+                &claim.operation_id,
+                claim.owner_generation,
+                &claim.fencing_token,
+                now_unix_ms().unwrap(),
+                60_000
+            )
+            .await,
+            Err(LocalLeaseOutboxError::EntryInProgress { .. })
+        ));
+    }
+    assert_eq!(
+        writer.status("entry-alias-op").await.unwrap(),
+        LocalOutcomeState::Indeterminate
+    );
+    drop(entry);
+    raw.reconcile("entry-alias-op", LocalReconcileOutcome::Committed)
+        .await
+        .unwrap();
+    assert_eq!(
+        writer.status("entry-alias-op").await.unwrap(),
+        LocalOutcomeState::Committed
