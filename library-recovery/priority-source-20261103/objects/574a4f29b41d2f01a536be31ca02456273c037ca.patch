diff --git a/codex-rs/hepta-memory/src/cognitive_store_entry_gate_tests.rs b/codex-rs/hepta-memory/src/cognitive_store_entry_gate_tests.rs
new file mode 100644
index 0000000000..f7b981899c
--- /dev/null
+++ b/codex-rs/hepta-memory/src/cognitive_store_entry_gate_tests.rs
@@ -0,0 +1,42 @@
+use super::*;
+
+#[test]
+fn shared_open_has_no_product_entry_gate_and_excludes_recovered_open() {
+    let root = tempfile::tempdir().unwrap();
+    let shared = CognitiveStoreOpenGuard::acquire_shared(root.path()).unwrap();
+    assert!(shared.operation_entry_gate.is_none());
+    assert!(CognitiveStoreOpenGuard::acquire_exclusive(root.path()).is_err());
+    drop(shared);
+    assert!(CognitiveStoreOpenGuard::acquire_exclusive(root.path()).is_ok());
+}
+
+#[test]
+fn exclusive_open_clones_share_gate_and_keep_file_exclusion() {
+    let root = tempfile::tempdir().unwrap();
+    let owner = Arc::new(CognitiveStoreOpenGuard::acquire_exclusive(root.path()).unwrap());
+    let clone = Arc::clone(&owner);
+    assert!(Arc::ptr_eq(
+        owner.operation_entry_gate.as_ref().unwrap(),
+        clone.operation_entry_gate.as_ref().unwrap()
+    ));
+    assert!(CognitiveStoreOpenGuard::acquire_shared(root.path()).is_err());
+    let pending = clone
+        .operation_entry_gate
+        .as_ref()
+        .unwrap()
+        .reserve_entry("lease", "op")
+        .unwrap();
+    assert!(matches!(
+        owner
+            .operation_entry_gate
+            .as_ref()
+            .unwrap()
+            .reserve_lease_mutation("lease"),
+        Err(crate::operation_entry_gate::EntryGateError::EntryInProgress)
+    ));
+    drop(pending);
+    drop(owner);
+    assert!(CognitiveStoreOpenGuard::acquire_shared(root.path()).is_err());
+    drop(clone);
+    assert!(CognitiveStoreOpenGuard::acquire_shared(root.path()).is_ok());
+}
