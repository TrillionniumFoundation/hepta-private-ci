@@ -0,0 +1,142 @@
+//! Transaction-side owner exclusion. Reserve before BEGIN; arm the unknown
+//! outcome fence immediately before COMMIT, when cancellation can become
+//! ambiguous. Before that boundary a dropped SQL transaction only rolls back.
+
+use crate::CognitiveStore;
+use crate::CognitiveStoreError;
+use crate::LocalLeaseOutboxError;
+use crate::operation_entry_gate::EntryGateError;
+use crate::operation_entry_gate::MutationReservation;
+
+pub(crate) struct MutationExclusion {
+    reservation: Option<MutationReservation>,
+    operation: Option<(String, String)>,
+}
+
+impl MutationExclusion {
+    pub(crate) fn for_lease(
+        store: &CognitiveStore,
+        lease_id: &str,
+    ) -> Result<Self, LocalLeaseOutboxError> {
+        let reservation = store
+            .operation_entry_gate()
+            .map(|gate| gate.reserve_lease_mutation(lease_id))
+            .transpose()
+            .map_err(|error| map_error(error, lease_id, None))?;
+        Ok(Self {
+            reservation,
+            operation: None,
+        })
+    }
+
+    pub(crate) fn for_operation(
+        store: &CognitiveStore,
+        lease_id: &str,
+        operation_id: &str,
+    ) -> Result<Self, LocalLeaseOutboxError> {
+        let reservation = store
+            .operation_entry_gate()
+            .map(|gate| gate.reserve_terminal(lease_id, operation_id))
+            .transpose()
+            .map_err(|error| map_error(error, lease_id, Some(operation_id)))?;
+        Ok(Self {
+            reservation,
+            operation: Some((lease_id.to_string(), operation_id.to_string())),
+        })
+    }
+
+    pub(crate) async fn for_operation_id(
+        store: &CognitiveStore,
+        operation_id: &str,
+    ) -> Result<Self, LocalLeaseOutboxError> {
+        if store.operation_entry_gate().is_none() {
+            return Ok(Self {
+                reservation: None,
+                operation: None,
+            });
+        }
+        // Immutable association lookup does not grant entry. The existing
+        // transaction checks must still verify the current lease and claim.
+        let lease_id = sqlx::query_scalar::<_, String>(
+            "SELECT lease_id FROM cognitive_operation_ledger WHERE operation_id = ?",
+        )
+        .bind(operation_id)
+        .fetch_optional(&store.pool)
+        .await
+        .map_err(crate::cognitive_store::unavailable)?
+        .ok_or_else(|| LocalLeaseOutboxError::StaleFence("operation is missing".into()))?;
+        Self::for_operation(store, &lease_id, operation_id)
+    }
+
+    pub(crate) fn require_operation(
+        &self,
+        store: &CognitiveStore,
+        lease_id: &str,
+        operation_id: &str,
+    ) -> Result<(), LocalLeaseOutboxError> {
+        if !self
+            .operation
+            .as_ref()
+            .is_some_and(|(lease, operation)| lease == lease_id && operation == operation_id)
+        {
+            return Err(LocalLeaseOutboxError::Invalid(
+                "mutation reservation operation mismatch".into(),
+            ));
+        }
+        match (store.operation_entry_gate(), self.reservation.as_ref()) {
+            (None, None) => Ok(()),
+            (Some(gate), Some(reservation)) if reservation.belongs_to(gate) => Ok(()),
+            _ => Err(LocalLeaseOutboxError::Invalid(
+                "mutation reservation owner generation mismatch".into(),
+            )),
+        }
+    }
+
+    pub(crate) fn commit_started(&mut self) -> Result<(), LocalLeaseOutboxError> {
+        if let Some(reservation) = self.reservation.as_mut() {
+            reservation.mark_db_attempted().map_err(internal_error)?;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn committed(self) -> Result<(), LocalLeaseOutboxError> {
+        if let Some(reservation) = self.reservation {
+            reservation.finish_known().map_err(internal_error)?;
+        }
+        Ok(())
+    }
+}
+
+fn internal_error(error: EntryGateError) -> LocalLeaseOutboxError {
+    LocalLeaseOutboxError::Store(CognitiveStoreError::Unavailable(format!(
+        "operation-entry reservation failed: {error:?}"
+    )))
+}
+
+fn map_error(
+    error: EntryGateError,
+    lease_id: &str,
+    operation_id: Option<&str>,
+) -> LocalLeaseOutboxError {
+    match error {
+        EntryGateError::EntryInProgress => match operation_id {
+            Some(operation_id) => LocalLeaseOutboxError::EntryInProgress {
+                operation_id: operation_id.to_string(),
+            },
+            None => LocalLeaseOutboxError::LeaseEntryInProgress {
+                lease_id: lease_id.to_string(),
+            },
+        },
+        EntryGateError::Busy => LocalLeaseOutboxError::OwnerMutationInProgress {
+            lease_id: lease_id.to_string(),
+        },
+        EntryGateError::Capacity => LocalLeaseOutboxError::CapacityExceeded {
+            resource: "operation-entry reservations",
+            maximum: crate::cognitive_store::MAX_OPERATION_ENTRY_RESERVATIONS,
+        },
+        EntryGateError::Invalid => {
+            LocalLeaseOutboxError::Invalid("invalid operation-entry identity".into())
+        }
+        EntryGateError::Unavailable => internal_error(error),
+    }
+}
