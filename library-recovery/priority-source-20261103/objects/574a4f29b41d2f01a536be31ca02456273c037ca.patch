+    assert_eq!(
+        writer.status("entry-alias-op").await.unwrap(),
+        LocalOutcomeState::Indeterminate
+    );
+}
+
+#[tokio::test]
+async fn lost_commit_acknowledgement_keeps_owner_mutation_fenced() {
+    let (_temp, writer, _claim) = fixture().await;
+    let mut exclusion =
+        MutationExclusion::for_operation(writer.store(), writer.lease_id(), "entry-alias-op")
+            .unwrap();
+    let mut transaction = writer
+        .store()
+        .pool
+        .begin_with("BEGIN IMMEDIATE")
+        .await
+        .unwrap();
+    writer
+        .lease
+        .apply_in_transaction(
+            &mut transaction,
+            "entry-alias-op".into(),
+            "fixture committed receipt".into(),
+            &exclusion,
+        )
+        .await
+        .unwrap();
+    exclusion.commit_started().unwrap();
+    transaction.commit().await.unwrap();
+    // Deliberately omit acknowledgement to the guard, as if the future was
+    // canceled before it could process a successful commit response.
+    drop(exclusion);
+    assert_eq!(
+        writer.status("entry-alias-op").await.unwrap(),
+        LocalOutcomeState::Committed
+    );
+    assert!(matches!(
+        writer
+            .store()
+            .operation_entry_gate()
+            .unwrap()
+            .reserve_entry(writer.lease_id(), "entry-alias-op"),
+        Err(EntryGateError::Busy)
+    ));
+    assert!(matches!(
+        writer
+            .lease
+            .finalize_replayed_occurrence("entry-alias-op")
+            .await,
+        Err(LocalLeaseOutboxError::OwnerMutationInProgress { .. })
+    ));
+}
+
+#[tokio::test]
+async fn entered_operation_lease_association_cannot_be_updated_or_replaced() {
+    let (_temp, writer, _claim) = fixture().await;
+    let mut connection = writer.store().pool.acquire().await.unwrap();
+    let foreign_keys: i64 = sqlx::query_scalar("PRAGMA foreign_keys")
+        .fetch_one(&mut *connection)
+        .await
+        .unwrap();
+    assert_eq!(foreign_keys, 1);
+    sqlx::query("PRAGMA recursive_triggers = OFF")
+        .execute(&mut *connection)
+        .await
+        .unwrap();
+    assert!(sqlx::query("UPDATE cognitive_operation_ledger SET lease_id = 'different-lease' WHERE operation_id = 'entry-alias-op'").execute(&mut *connection).await.is_err());
+    // The existing durable claim's ON DELETE RESTRICT binding also prevents
+    // REPLACE's implicit deletion, even when recursive DELETE triggers are off.
+    assert!(sqlx::query("INSERT OR REPLACE INTO cognitive_operation_ledger SELECT * FROM cognitive_operation_ledger WHERE operation_id = 'entry-alias-op'").execute(&mut *connection).await.is_err());
+    let lease: String = sqlx::query_scalar(
+        "SELECT lease_id FROM cognitive_operation_ledger WHERE operation_id = 'entry-alias-op'",
+    )
+    .fetch_one(&mut *connection)
+    .await
+    .unwrap();
+    assert_eq!(lease, writer.lease_id());
+}
