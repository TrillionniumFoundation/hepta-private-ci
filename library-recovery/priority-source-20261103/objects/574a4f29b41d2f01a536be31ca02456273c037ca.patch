+}
+
+#[tokio::test]
+async fn caller_owned_transaction_rejects_reservation_from_other_open_generation() {
+    let (_first, writer, _claim) = fixture().await;
+    let (_second, other, _other_claim) = fixture().await;
+    let foreign =
+        MutationExclusion::for_operation(other.store(), other.lease_id(), "entry-alias-op")
+            .unwrap();
+    let mut transaction = writer
+        .store()
+        .pool
+        .begin_with("BEGIN IMMEDIATE")
+        .await
+        .unwrap();
+    assert!(matches!(
+        writer
+            .lease
+            .apply_in_transaction(
+                &mut transaction,
+                "entry-alias-op".into(),
