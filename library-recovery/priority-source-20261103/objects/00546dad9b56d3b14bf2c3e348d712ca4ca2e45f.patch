+                            for token in (
+                                "cleanup-inventory",
+                                "receipt --kind",
+                                "receipt-verify",
+                                "hepta-technical-receipts.py",
+                                "hepta-implementation-dossiers.py",
+                            )
+                        )
+                    ]
+                    self.assertEqual(bool(evidence), profile == "qualification")
