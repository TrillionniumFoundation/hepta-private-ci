+fn bedrock_denial_requests() -> [(&'static str, serde_json::Value); 3] {
+    [
+        ("account/bedrock/discover", json!({})),
+        (
+            "account/bedrock/setup",
+            json!({"type": "environment", "region": "us-west-2"}),
+        ),
+        (
+            "account/bedrock/setup",
+            json!({"type": "profile", "profile": "engineering", "region": "us-west-2"}),
+        ),
+    ]
+}
