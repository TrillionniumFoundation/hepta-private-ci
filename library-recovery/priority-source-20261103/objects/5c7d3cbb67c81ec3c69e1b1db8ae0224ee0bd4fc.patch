+#[tokio::test]
+async fn preprepared_sibling_attempt_cannot_claim_until_prior_outcome_is_terminal() {
+    let fixture = Fixture::new();
+    let (store, owner, intent, payload) = prepared_store(&fixture).await;
+    for attempt in [1, 2] {
+        store
+            .prepare_taskflow_step(
+                "step-run", "work", attempt, &owner, &intent, &payload,
+                &format!("prepare-{attempt}"), /*now_ms*/ 21,
+            )
+            .await
+            .expect("prepare before any claim");
+    }
+    let second_before = store
+        .read_taskflow_step("step-run", "work", /*attempt*/ 2, &owner)
+        .await
+        .expect("second attempt")
+        .expect("prepared");
+    store
+        .claim_taskflow_step(
+            "step-run", "work", /*attempt*/ 1, &owner, &intent, &payload,
+            "claim-1", /*now_ms*/ 22,
+        )
+        .await
+        .expect("first claim");
+    for observed_unknown in [false, true] {
+        if observed_unknown {
+            store
+                .record_taskflow_step(
+                    "step-run", "work", /*attempt*/ 1, &owner, &intent, &payload,
+                    "unknown-1", &Sha256Digest::for_bytes(b"unknown"),
+                    TaskFlowStepObservation::Indeterminate, /*now_ms*/ 23,
+                )
+                .await
+                .expect("record uncertainty");
+        }
+        assert!(matches!(
+            store
+                .claim_taskflow_step(
+                    "step-run", "work", /*attempt*/ 2, &owner, &intent, &payload,
+                    "claim-2", /*now_ms*/ 24,
+                )
+                .await,
+            Err(codex_hepta_automation::TaskFlowError::Conflict(_))
+        ));
+        pretty_assertions::assert_eq!(
+            store
+                .read_taskflow_step("step-run", "work", /*attempt*/ 2, &owner)
+                .await
+                .expect("read rejected claim"),
+            Some(second_before.clone())
+        );
+    }
+    store
+        .reconcile_taskflow_step(
+            "step-run", "work", /*attempt*/ 1, &owner, &intent, &payload,
+            "terminal-1", &Sha256Digest::for_bytes(b"terminal"),
+            TaskFlowReconcileOutcome::Failed, /*now_ms*/ 25,
+        )
+        .await
+        .expect("settle first attempt");
+    store
+        .claim_taskflow_step(
+            "step-run", "work", /*attempt*/ 2, &owner, &intent, &payload,
+            "claim-2", /*now_ms*/ 26,
+        )
+        .await
+        .expect("settled predecessor permits retry");
+    let replay = store
+        .claim_taskflow_step(
+            "step-run", "work", /*attempt*/ 2, &owner, &intent, &payload,
+            "claim-2", /*now_ms*/ 26,
+        )
+        .await
+        .expect("exact claim replay");
+    assert_eq!(replay.status, TaskFlowStepCommandStatus::AlreadyApplied);
+    store.close().await;
