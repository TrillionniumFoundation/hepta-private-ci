+#[tokio::test]
+async fn verified_time_is_revalidated_in_the_consuming_registry() {
+    let (_source_root, source) = store().await;
+    let (_target_root, target) = store().await;
+    let key = SigningKey::from_bytes(&[41; 32]);
+    source
+        .enroll_issuer(IssuerPurpose::TrustedTime, spec("issuer:time", 1, &key))
+        .await
+        .expect("enroll source time issuer");
+    let claims = TrustedTimeAttestationClaims {
+        issuer_id: id("issuer:time"),
+        key_epoch: Generation::new(1).expect("generation"),
+        wall_time_ms: 2_000,
+        source_revision: 7,
+        source_digest: Digest32::of_bytes(b"external-time-source"),
+    };
+    let signed = SignedTrustedTimeAttestation {
+        signature: key.sign(&claims.signing_bytes()).to_bytes(),
+        claims,
+    };
+    let sample = source
+        .observe_trusted_time_attestation(&signed)
+        .await
+        .expect("source verification");
+    source
+        .observe_time(sample.clone())
+        .await
+        .expect("current sample reuse");
+    assert!(matches!(
+        target.observe_time(sample.clone()).await,
+        Err(AuthBusAuthorityError::IssuerMissing)
+    ));
+    assert_eq!(target.last_trusted_time().await.expect("target floor"), None);
+
+    let other_key = SigningKey::from_bytes(&[42; 32]);
+    target
+        .enroll_issuer(IssuerPurpose::TrustedTime, spec("issuer:time", 1, &other_key))
+        .await
+        .expect("same identity, independently trusted key");
+    assert!(matches!(
+        target.observe_time(sample.clone()).await,
+        Err(AuthBusAuthorityError::TrustedTimeIssuerMismatch)
+    ));
+    assert_eq!(target.last_trusted_time().await.expect("target floor"), None);
+
+    source
+        .rotate_issuer(
+            IssuerPurpose::TrustedTime,
+            spec("issuer:time", 2, &other_key),
+            Generation::new(1).expect("generation"),
+            1,
+        )
+        .await
+        .expect("rotate source issuer");
+    assert!(matches!(
+        source.observe_time(sample).await,
+        Err(AuthBusAuthorityError::TrustedTimeIssuerMismatch)
+    ));
+    assert_eq!(
+        source
+            .last_trusted_time()
+            .await
+            .expect("source floor")
+            .expect("floor")
+            .wall_time_ms(),
+        2_000
+    );
+}
