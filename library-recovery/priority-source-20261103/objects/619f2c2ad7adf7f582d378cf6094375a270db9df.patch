+name: Hepta Linux compiled-cache diagnostic
+
+# Inert until an independently reviewed caller opts in. This diagnostic does
+# not replace any existing required workflow or its platform matrix.
+on:
+  workflow_call:
+    inputs:
+      source-sha:
+        required: true
+        type: string
+      tested-sha:
+        required: true
+        type: string
+      base-sha:
+        required: true
+        type: string
+      lane:
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+jobs:
+  linux-gnu-cache-diagnostic:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 60
+    environment:
+      name: bazel
+      deployment: false
+    env:
+      SOURCE_SHA: ${{ inputs.source-sha }}
+      TESTED_SHA: ${{ inputs.tested-sha }}
+      BASE_SHA: ${{ inputs.base-sha }}
+      HEPTA_CI_LANE: ${{ inputs.lane }}
+      PYTHONDONTWRITEBYTECODE: "1"
+    steps:
+      - name: Anchor job budget before checkout
+        run: python3 -c 'import time; print(f"HEPTA_PILOT_JOB_STARTED={time.monotonic()}")' >> "$GITHUB_ENV"
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
+        with:
+          ref: ${{ inputs.tested-sha }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Verify exact source pair before cache access
+        run: >-
+          python3 scripts/hepta_ci_candidate.py --source "$SOURCE_SHA"
+          --tested "$TESTED_SHA" --base "$BASE_SHA" --lane "$HEPTA_CI_LANE"
+      - name: Record fixed pilot deadline and cache namespace
+        id: prepare
+        run: >-
+          python3 scripts/hepta_bazel_cache_pilot.py prepare
+          --directory "$RUNNER_TEMP/hepta-compiled-cache-pilot"
+          --github-output "$GITHUB_OUTPUT"
+      - name: Prepare existing pinned Bazel environment
+        timeout-minutes: 8
+        uses: ./.github/actions/prepare-bazel-ci
+        with:
+          target: x86_64-unknown-linux-gnu
+          cache-scope: bazel-test
+      - name: Restore compatible compiled actions
+        id: restore
+        timeout-minutes: 3
+        continue-on-error: true
+        uses: actions/cache/restore@668228422ae6a00e4ad889ee87cd7109ec5666a7
+        with:
+          path: ${{ steps.prepare.outputs.cache_path }}
+          key: ${{ steps.prepare.outputs.cache_key }}
+          restore-keys: ${{ steps.prepare.outputs.restore_prefix }}
+      - name: Run fixed batch lane with fresh tests and bounded resources
+        id: native
+        timeout-minutes: 48
+        run: >-
+          python3 scripts/hepta_bazel_cache_pilot.py run
+          --directory "$RUNNER_TEMP/hepta-compiled-cache-pilot"
+          --github-output "$GITHUB_OUTPUT"
+      - name: Retain exact command and cache evidence
+        if: always() && !cancelled()
+        timeout-minutes: 3
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: hepta-linux-cache-diagnostic-${{ github.run_id }}-${{ github.run_attempt }}
+          path: |
+            ${{ runner.temp }}/hepta-compiled-cache-pilot/pilot-state.json
+            ${{ runner.temp }}/hepta-compiled-cache-pilot/native.json*
+            ${{ runner.temp }}/hepta-compiled-cache-pilot/cache-readiness.json
+            ${{ runner.temp }}/hepta-compiled-cache-pilot/diagnostics/**
+          if-no-files-found: error
+      - name: Save only a measured quiescent cache
+        if: always() && !cancelled() && steps.native.outputs.save_ready == 'true' && steps.restore.outputs.cache-hit != 'true'
+        timeout-minutes: 5
+        continue-on-error: true
+        uses: actions/cache/save@668228422ae6a00e4ad889ee87cd7109ec5666a7
+        with:
+          path: ${{ steps.prepare.outputs.cache_path }}
+          key: ${{ steps.prepare.outputs.cache_key }}
