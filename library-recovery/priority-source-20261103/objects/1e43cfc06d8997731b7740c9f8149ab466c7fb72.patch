+    );
+    assert_eq!(
+        store
+            .next_pending_occurrence(&mut scan)
+            .await
+            .expect("later physical page"),
+        Some(younger)
+    );
+    assert_eq!(
+        store
+            .pending_occurrence_work(/*limit*/ 10)
+            .await
+            .expect("after scan"),
