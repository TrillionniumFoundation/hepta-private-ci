+//! Real SQLite/raw-alias checks of exclusion wiring. Entry is reserved directly
+//! by the private fixture; these tests do not qualify a provider-entry API.
+
+use super::*;
+use crate::CognitiveRecoveryRequirement;
+use crate::operation_entry_gate::EntryGateError;
+use codex_hepta_types::StableId;
+use tempfile::TempDir;
+
+#[derive(Default)]
+struct TestClock {
+    override_now: std::sync::atomic::AtomicU64,
+    fail: std::sync::atomic::AtomicBool,
+    validation_signal: std::sync::Mutex<Option<tokio::sync::oneshot::Sender<()>>>,
+}
+impl codex_hepta_contracts::AuthorityClock for TestClock {
+    fn now_unix_ms(&self) -> Result<u64, codex_hepta_contracts::AuthorityTrustError> {
+        use std::sync::atomic::Ordering;
+        if self.fail.load(Ordering::SeqCst) {
+            return Err(codex_hepta_contracts::AuthorityTrustError::Unavailable);
+        }
+        let value = self.override_now.load(Ordering::SeqCst);
+        if value != 0 {
+            return Ok(value);
+        }
+        // Compatibility time is only a test-fixture bootstrap, never selected
+        // by the production provider-entry constructor.
+        codex_hepta_contracts::AuthorityClock::now_unix_ms(
+            &codex_hepta_contracts::SystemAuthorityClock,
+        )
+    }
+}
+
+async fn fixture() -> (TempDir, ProductionDurableWriter, DurableDispatchClaim) {
+    let (temp, writer, claim, _clock) = fixture_with_clock().await;
+    (temp, writer, claim)
+}
+
+async fn prepared_fixture() -> (
+    TempDir,
+    ProductionDurableWriter,
+    ProductionQueuedReceipt,
+    Arc<TestClock>,
+) {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path().join("fleet");
+    std::fs::create_dir(&root).unwrap();
+    let fleet = codex_hepta_paths::HeptaFleetRoot::parse(root).unwrap();
+    let owner = AgentId::parse("00000000-0000-4000-8000-00000000c061").unwrap();
+    let layout = fleet.layout().agent(&owner);
+    let authority = ProductionAuthorityLease::from_verified_parts(
+        owner.clone(),
+        Sha256Digest::for_bytes(b"entry-alias-grant"),
+        7,
+        11,
+        now_unix_seconds().unwrap() + 3600,
+        ProductionAuthorityToken::from_verified_bytes(b"entry-alias-token".to_vec()).unwrap(),
+    )
+    .unwrap();
+    let clock = Arc::new(TestClock::default());
+    let verifier_clock = Arc::clone(&clock);
+    let verifier: Arc<dyn ProductionAuthorityVerifier> =
+        Arc::new(move |lease: &ProductionAuthorityLease, owner: &AgentId| {
+            if let Some(signal) = verifier_clock.validation_signal.lock().unwrap().take() {
+                let _ = signal.send(());
+            }
+            if lease.agent_id == *owner {
+                Ok(())
+            } else {
+                Err("fixture owner mismatch".to_string())
+            }
+        });
+    let legacy = CognitiveStore::open(&layout).await.unwrap();
+    let first = ProductionDurableWriter::open_with_live_verifier(
+        legacy.clone(),
+        authority.clone(),
+        Arc::clone(&verifier),
+        "entry-alias-lease",
+        1,
+    )
+    .await
+    .unwrap();
+    let anchor = legacy.recovery_anchor().await.unwrap();
+    drop(first);
+    legacy.pool.close().await;
+    drop(legacy);
+    let recovered = CognitiveStore::open_with_recovery(
+        &layout,
+        CognitiveRecoveryRequirement::ExactCurrentCut(&anchor),
+        &authority,
+        verifier.as_ref(),
+    )
+    .await
+    .unwrap();
+    let writer = ProductionDurableWriter::open_with_entry_clock(
+        recovered,
+        authority,
+        verifier,
+        clock.clone(),
+        "entry-alias-lease",
+        1,
+    )
+    .await
+    .unwrap();
+    let payload = r#"{"operation":"entry-alias-op"}"#;
+    let intent = OperationIntentV1::new(
+        StableId::new("entry-alias-op").unwrap(),
