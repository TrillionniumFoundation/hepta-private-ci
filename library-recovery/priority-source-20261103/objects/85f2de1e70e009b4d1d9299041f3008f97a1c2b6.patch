+struct EntryTarget {
+    calls: std::sync::atomic::AtomicUsize,
+}
+impl crate::production_operation_entry::ProductionEntryOutboxTarget for EntryTarget {
+    fn destination_id(&self) -> &str {
+        "entry-alias-target"
+    }
+    fn dispatch<'a>(
+        &'a self,
+        carrier: crate::production_operation_entry::ProductionEntryDispatchRequest,
+    ) -> ProductionDispatchFuture<'a> {
+        Box::pin(async move {
+            let crate::production_operation_entry::ProductionEntryDispatchRequest {
+                request,
+                entry,
+            } = carrier;
+            entry
+                .with_entry(&request, || async {
+                    self.calls.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+                    ProductionTargetOutcome::Indeterminate {
+                        reason: "fixture provider outcome unknown".into(),
+                    }
+                })
+                .await
+                .unwrap_or_else(|_| ProductionTargetOutcome::Indeterminate {
+                    reason: "fixture entry denied; no automatic refund".into(),
+                })
+        })
+    }
+}
