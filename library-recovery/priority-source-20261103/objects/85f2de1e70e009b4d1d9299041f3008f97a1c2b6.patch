+fn signed_entry_grant(
+    temp: &TempDir,
+    writer: &ProductionDurableWriter,
+    binding: FinalUseBinding,
+    clock: Arc<TestClock>,
+) -> (FinalUseAuthority, SignedFinalUseGrant) {
+    use ed25519_dalek::Signer;
+    use std::os::unix::fs::PermissionsExt;
+    let issuer = ed25519_dalek::SigningKey::from_bytes(&[91; 32]);
+    let directory = temp.path().join("entry-kernel-authority");
+    std::fs::create_dir(&directory).unwrap();
+    std::fs::set_permissions(&directory, std::fs::Permissions::from_mode(0o700)).unwrap();
+    let final_use = FinalUseAuthority::open_state_dir_with_clock(
+        &directory,
+        "entry-kernel-owner".into(),
+        issuer.verifying_key().to_bytes(),
+        codex_hepta_contracts::FinalUseRevocations {
+            authority_epoch: 71,
+            revision: 1,
+            revoked_grant_ids: Default::default(),
+        },
+        clock,
+    )
+    .unwrap();
+    let now = writer.entry_owner.as_ref().unwrap().now_unix_ms().unwrap();
+    let grant = codex_hepta_contracts::FinalUseGrant {
+        schema_version: 1,
+        signer_id: "entry-kernel-owner".into(),
+        authority_epoch: 71,
+        grant_id: "entry-dispatch-grant".into(),
+        nonce: [61; 32],
+        binding,
+        not_before_unix_ms: now.saturating_sub(1000),
+        expires_at_unix_ms: now + 30_000,
+    };
+    let signature = issuer
+        .sign(&grant.signing_bytes().unwrap())
+        .to_bytes()
+        .to_vec();
+    (final_use, SignedFinalUseGrant { grant, signature })
+}
