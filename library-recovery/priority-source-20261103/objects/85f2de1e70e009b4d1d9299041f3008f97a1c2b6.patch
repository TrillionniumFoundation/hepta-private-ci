+//! One-shot provider enrollment owned by the recovered CognitiveStore writer.
+//! This capability is not provider authority. The registered adapter must keep
+//! its own final-use checks and await the entire effect, without detached I/O.
+
+use std::future::Future;
+use std::sync::Arc;
+use std::sync::Weak;
+
+use crate::LocalLeaseOutboxError;
+use crate::ProductionDispatchRequest;
+use crate::ProductionDurableWriter;
+use crate::ProductionTargetOutcome;
+use crate::ProductionWriterError;
+use crate::operation_claims::DurableDispatchClaim;
+use crate::operation_entry_gate::EntryGateError;
+
+pub(crate) struct ProductionEntryOwner {
+    // The captured writer has no entry_owner field set, so this retained
+    // snapshot cannot form an Arc cycle. It keeps both file locks alive only
+    // while the real writer or a running pending/active entry owns this Arc.
+    writer: ProductionDurableWriter,
+    clock: Arc<dyn codex_hepta_contracts::AuthorityClock>,
+}
+
+impl ProductionEntryOwner {
+    pub(crate) fn new(
+        writer: ProductionDurableWriter,
+        clock: Arc<dyn codex_hepta_contracts::AuthorityClock>,
+    ) -> Self {
+        Self { writer, clock }
+    }
+
+    pub(crate) fn now_unix_ms(&self) -> Result<u64, ProductionWriterError> {
+        let now = self
+            .clock
+            .now_unix_ms()
+            .map_err(ProductionWriterError::AuthorityTime)?;
+        if now == 0 {
+            return Err(ProductionWriterError::AuthorityTime(
+                codex_hepta_contracts::AuthorityTrustError::Invalid,
+            ));
+        }
+        Ok(now)
+    }
+}
+
+/// Native, non-cloneable and non-serializable entry permission for one exact
+/// durable Entered claim. An issued-but-unused value retains only a Weak owner.
+/// Only the CognitiveStore dispatcher can construct it.
+pub struct ProductionOperationEntry {
+    owner: Weak<ProductionEntryOwner>,
+    claim: DurableDispatchClaim,
+    request: ProductionDispatchRequest,
+    // Exact protected sample used for the durable Entered transition. Minting
+    // must not resample a potentially rolled-back clock and weaken this floor.
+    not_before_unix_ms: u64,
+}
+
+impl ProductionOperationEntry {
+    pub(crate) fn new(
+        owner: &Arc<ProductionEntryOwner>,
+        claim: DurableDispatchClaim,
+        request: ProductionDispatchRequest,
+        not_before_unix_ms: u64,
+    ) -> Self {
+        Self {
+            owner: Arc::downgrade(owner),
+            claim,
+            request,
+            not_before_unix_ms,
+        }
+    }
+
+    pub fn operation_id(&self) -> &str {
+        &self.claim.operation_id
+    }
+
+    /// Validate under pending exclusion, then retain active exclusion through
+    /// the complete awaited provider effect. The fixed passive outcome prevents
+    /// returning an unpolled effect future or exporting the private active guard.
+    /// Entry errors must not automatically refund a prior AuthBus dispatch hold.
+    pub async fn with_entry<F, Fut>(
+        self,
+        expected_request: &ProductionDispatchRequest,
+        factory: F,
+    ) -> Result<ProductionTargetOutcome, ProductionWriterError>
+    where
+        F: FnOnce() -> Fut + Send,
+        Fut: Future<Output = ProductionTargetOutcome> + Send,
+    {
+        if &self.request != expected_request
+            || self.claim.operation_id != self.request.occurrence_key
+        {
+            return Err(ProductionWriterError::StaleReceipt);
+        }
+        let owner = self
+            .owner
+            .upgrade()
+            .ok_or(ProductionWriterError::StaleReceipt)?;
+        if self.request.lease_id != owner.writer.lease_id() {
+            return Err(ProductionWriterError::StaleReceipt);
+        }
+        let gate = owner
+            .writer
+            .store()
+            .operation_entry_gate()
+            .ok_or(ProductionWriterError::RecoveredOwnerRequired)?;
+        let mut enrollment = gate
+            .reserve_entry(owner.writer.lease_id(), &self.claim.operation_id)
+            .map_err(|error| {
+                map_entry_error(error, owner.writer.lease_id(), &self.claim.operation_id)
+            })?;
+        owner.writer.verify_current_authority().await?;
+        owner
+            .writer
+            .verify_entry_request(&self.claim, &self.request)
+            .await?;
+        enrollment.activate().map_err(|error| {
+            map_entry_error(error, owner.writer.lease_id(), &self.claim.operation_id)
+        })?;
+        // The last trusted-time/authority check follows all async database work
+        // and the gate mutex acquisition. No await precedes factory invocation.
+        owner.writer.verify_entry_now(
+            &self.claim,
+            owner.clock.as_ref(),
+            self.not_before_unix_ms,
+        )?;
+        let outcome = factory().await;
+        drop(enrollment);
+        Ok(outcome)
+    }
+}
+
+/// Separate linear native carrier. Metadata remains independently cloneable;
+/// there is no optional serialized entry field or default bypass.
+pub struct ProductionEntryDispatchRequest {
+    pub request: ProductionDispatchRequest,
+    pub entry: ProductionOperationEntry,
+}
+
+fn map_entry_error(
+    error: EntryGateError,
+    lease_id: &str,
+    operation_id: &str,
+) -> ProductionWriterError {
+    let local = match error {
+        EntryGateError::EntryInProgress => LocalLeaseOutboxError::EntryInProgress {
+            operation_id: operation_id.to_string(),
+        },
+        EntryGateError::Busy => LocalLeaseOutboxError::OwnerMutationInProgress {
+            lease_id: lease_id.to_string(),
+        },
+        EntryGateError::Capacity => LocalLeaseOutboxError::CapacityExceeded {
+            resource: "operation-entry reservations",
+            maximum: crate::cognitive_store::MAX_OPERATION_ENTRY_RESERVATIONS,
+        },
+        EntryGateError::Invalid => {
+            LocalLeaseOutboxError::Invalid("invalid operation-entry reservation".into())
+        }
+        EntryGateError::Unavailable => LocalLeaseOutboxError::Store(
+            crate::CognitiveStoreError::Unavailable("operation-entry gate poisoned".into()),
+        ),
+    };
+    ProductionWriterError::Local(local)
+}
+
+/// Explicitly registered external adapter that accepts the linear owner entry
+/// carrier. There is no fallback to the metadata-only dispatch interface.
+pub trait ProductionEntryOutboxTarget: Send + Sync {
+    fn destination_id(&self) -> &str;
+    fn dispatch<'a>(
+        &'a self,
+        request: ProductionEntryDispatchRequest,
+    ) -> crate::ProductionDispatchFuture<'a>;
+    fn observe_terminal<'a>(
+        &'a self,
+        _request: &'a ProductionDispatchRequest,
+    ) -> crate::ProductionTerminalObservationFuture<'a> {
+        Box::pin(async {
+            crate::ProductionTerminalObservation::Unavailable {
+                reason: "entry target has no terminal observer".into(),
+            }
+        })
+    }
+}
+
+/// Dedicated composition path for external providers requiring final-use owner
+/// enrollment. Existing authoritative SQL mutation targets use their separate
+/// transaction path and are not recursively enrolled around their own writes.
+#[derive(Clone)]
+pub struct ProductionEntryOutboxDispatcher {
+    final_use: codex_hepta_contracts::FinalUseAuthority,
+    target: Arc<dyn ProductionEntryOutboxTarget>,
+}
+
+impl std::fmt::Debug for ProductionEntryOutboxDispatcher {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("ProductionEntryOutboxDispatcher")
+            .field("destination", &self.target.destination_id())
+            .finish_non_exhaustive()
+    }
+}
+
+impl ProductionEntryOutboxDispatcher {
+    pub fn attach(
+        final_use: codex_hepta_contracts::FinalUseAuthority,
+        target: Arc<dyn ProductionEntryOutboxTarget>,
+    ) -> Self {
+        Self { final_use, target }
+    }
+    pub fn destination_id(&self) -> &str {
+        self.target.destination_id()
+    }
+    pub async fn dispatch(
+        &self,
+        writer: &ProductionDurableWriter,
+        signed: &codex_hepta_contracts::SignedFinalUseGrant,
+        expected: &codex_hepta_contracts::FinalUseBinding,
+        receipt: crate::ProductionQueuedReceipt,
+    ) -> Result<crate::ProductionDispatchReceipt, ProductionWriterError> {
+        writer
+            .dispatch_entry_target(
+                &self.final_use,
+                self.target.as_ref(),
+                signed,
+                expected,
+                receipt,
+            )
+            .await
+    }
+    pub async fn reconcile(
+        &self,
+        writer: &ProductionDurableWriter,
+        limit: usize,
+    ) -> Result<usize, ProductionWriterError> {
+        writer
+            .reconcile_target_batch(&ObserverOnly(self.target.as_ref()), limit)
+            .await
+    }
+}
+
+// Private observer bridge reuses bounded discovery without granting a
+// metadata-only provider-dispatch route to an entry-aware target.
+struct ObserverOnly<'a>(&'a dyn ProductionEntryOutboxTarget);
+impl crate::ProductionOutboxTarget for ObserverOnly<'_> {
+    fn dispatch<'a>(
+        &'a self,
+        _request: ProductionDispatchRequest,
+    ) -> crate::ProductionDispatchFuture<'a> {
+        Box::pin(async {
+            ProductionTargetOutcome::Indeterminate {
+                reason: "observer bridge cannot dispatch".into(),
+            }
+        })
+    }
+}
+impl crate::FinalUseProductionOutboxTarget for ObserverOnly<'_> {
+    fn destination_id(&self) -> &str {
+        self.0.destination_id()
+    }
+    fn observe_terminal<'a>(
+        &'a self,
+        request: &'a ProductionDispatchRequest,
+    ) -> crate::ProductionTerminalObservationFuture<'a> {
+        self.0.observe_terminal(request)
+    }
+}
