new file mode 100644
index 0000000000..4a224ffe4f
--- /dev/null
+++ b/codex-rs/hepta-memory/src/operation_entry_gate.rs
@@ -0,0 +1,274 @@
+//! Owner-local exclusion reservations. This module never grants authority.
+//!
+//! Callers reserve before database validation, keep the reservation through the
+//! relevant commit/effect, and validate durable identities under that exclusion.
+//! No mutex guard escapes a method or is held across an await.
+
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum EntryGateError {
+    Busy,
+    EntryInProgress,
+    Capacity,
+    Invalid,
+    Unavailable,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum Phase {
+    Pending,
+    Active,
+    MutationReserved,
+    MutationAttempted,
+}
+
+#[derive(Debug)]
+struct OperationSlot {
+    lease_id: String,
+    phase: Phase,
+}
+
+#[derive(Debug, Default)]
+struct State {
+    operations: BTreeMap<String, OperationSlot>,
+    leases: BTreeMap<String, Phase>,
+}
+
+#[derive(Debug)]
+pub(crate) struct OperationEntryGate {
+    capacity: usize,
+    state: Mutex<State>,
+}
+
+impl OperationEntryGate {
+    pub(crate) fn new(capacity: usize) -> Result<Arc<Self>, EntryGateError> {
+        if capacity == 0 {
+            return Err(EntryGateError::Invalid);
+        }
+        Ok(Arc::new(Self {
+            capacity,
+            state: Mutex::new(State::default()),
+        }))
+    }
+
+    fn check_capacity(&self, state: &State) -> Result<(), EntryGateError> {
+        if state.operations.len().saturating_add(state.leases.len()) >= self.capacity {
+            return Err(EntryGateError::Capacity);
+        }
+        Ok(())
+    }
+
+    fn reserve_operation(
+        self: &Arc<Self>,
+        lease_id: &str,
+        operation_id: &str,
+        phase: Phase,
+    ) -> Result<Reservation, EntryGateError> {
+        check_identity(lease_id)?;
+        check_identity(operation_id)?;
+        let mut state = self.state.lock().map_err(|_| EntryGateError::Unavailable)?;
+        if state.leases.contains_key(lease_id) {
+            return Err(EntryGateError::Busy);
+        }
+        if let Some(slot) = state.operations.get(operation_id) {
+            return Err(if matches!(slot.phase, Phase::Pending | Phase::Active) {
+                EntryGateError::EntryInProgress
+            } else {
+                EntryGateError::Busy
+            });
+        }
+        self.check_capacity(&state)?;
+        state.operations.insert(
+            operation_id.to_string(),
+            OperationSlot {
+                lease_id: lease_id.to_string(),
+                phase,
+            },
+        );
+        Ok(Reservation {
+            gate: Arc::clone(self),
+            key: Some(Key::Operation(operation_id.to_string())),
+        })
+    }
+
+    pub(crate) fn reserve_entry(
+        self: &Arc<Self>,
+        lease_id: &str,
+        operation_id: &str,
+    ) -> Result<EntryReservation, EntryGateError> {
+        Ok(EntryReservation(self.reserve_operation(
+            lease_id,
+            operation_id,
+            Phase::Pending,
+        )?))
+    }
+
+    pub(crate) fn reserve_terminal(
+        self: &Arc<Self>,
+        lease_id: &str,
+        operation_id: &str,
+    ) -> Result<MutationReservation, EntryGateError> {
+        Ok(MutationReservation(self.reserve_operation(
+            lease_id,
+            operation_id,
+            Phase::MutationReserved,
+        )?))
+    }
+
+    pub(crate) fn reserve_lease_mutation(
+        self: &Arc<Self>,
+        lease_id: &str,
+    ) -> Result<MutationReservation, EntryGateError> {
+        check_identity(lease_id)?;
+        let mut state = self.state.lock().map_err(|_| EntryGateError::Unavailable)?;
+        if state.leases.contains_key(lease_id) {
+            return Err(EntryGateError::Busy);
+        }
+        if state.operations.values().any(|slot| {
+            slot.lease_id == lease_id && matches!(slot.phase, Phase::Pending | Phase::Active)
+        }) {
+            return Err(EntryGateError::EntryInProgress);
+        }
+        if state
+            .operations
+            .values()
+            .any(|slot| slot.lease_id == lease_id)
+        {
+            return Err(EntryGateError::Busy);
+        }
+        self.check_capacity(&state)?;
+        state
+            .leases
+            .insert(lease_id.to_string(), Phase::MutationReserved);
+        Ok(MutationReservation(Reservation {
+            gate: Arc::clone(self),
+            key: Some(Key::Lease(lease_id.to_string())),
+        }))
+    }
+}
+
+fn check_identity(identity: &str) -> Result<(), EntryGateError> {
+    if identity.is_empty() || identity.len() > 512 || identity.contains('\0') {
+        return Err(EntryGateError::Invalid);
+    }
+    Ok(())
+}
+
+#[derive(Debug)]
+enum Key {
+    Operation(String),
+    Lease(String),
+}
+
+#[derive(Debug)]
+struct Reservation {
+    gate: Arc<OperationEntryGate>,
+    key: Option<Key>,
+}
+
+impl Reservation {
+    fn change_phase(&mut self, from: Phase, to: Phase) -> Result<(), EntryGateError> {
+        let mut state = self
+            .gate
+            .state
+            .lock()
+            .map_err(|_| EntryGateError::Unavailable)?;
+        let phase = match self.key.as_ref() {
+            Some(Key::Operation(id)) => state.operations.get_mut(id).map(|slot| &mut slot.phase),
+            Some(Key::Lease(id)) => state.leases.get_mut(id),
+            None => None,
+        }
+        .ok_or(EntryGateError::Invalid)?;
+        if *phase != from {
+            return Err(EntryGateError::Invalid);
+        }
+        *phase = to;
+        Ok(())
+    }
+
+    fn finish_known(&mut self) -> Result<(), EntryGateError> {
+        let mut state = self
+            .gate
+            .state
+            .lock()
+            .map_err(|_| EntryGateError::Unavailable)?;
+        match self.key.take() {
+            Some(Key::Operation(id)) => {
+                state.operations.remove(&id);
+            }
+            Some(Key::Lease(id)) => {
+                state.leases.remove(&id);
+            }
+            None => return Err(EntryGateError::Invalid),
+        }
+        Ok(())
+    }
+}
+
+impl Drop for Reservation {
+    fn drop(&mut self) {
+        let Ok(mut state) = self.gate.state.lock() else {
+            return;
+        };
+        match self.key.as_ref() {
+            Some(Key::Operation(id))
+                if state
+                    .operations
+                    .get(id)
+                    .is_some_and(|slot| slot.phase != Phase::MutationAttempted) =>
+            {
+                state.operations.remove(id);
+            }
+            Some(Key::Lease(id))
+                if state
+                    .leases
+                    .get(id)
+                    .is_some_and(|phase| *phase != Phase::MutationAttempted) =>
+            {
+                state.leases.remove(id);
+            }
+            _ => {}
+        }
+    }
+}
+
+/// Private pending/active enrollment. The enclosing owner future must retain
+/// the exclusive store-open guard too; this gate alone does not own that lock.
+#[derive(Debug)]
+pub(crate) struct EntryReservation(Reservation);
+
+impl EntryReservation {
+    /// Only call after fresh durable and live-authority validation succeeds.
+    pub(crate) fn activate(&mut self) -> Result<(), EntryGateError> {
+        self.0.change_phase(Phase::Pending, Phase::Active)
+    }
+}
+
+/// A non-cloneable mutation token. Cancellation before the first durable write
+/// releases it; cancellation after an attempted write remains conservatively
+/// fenced until the owner establishes a definite durable result.
+#[derive(Debug)]
+pub(crate) struct MutationReservation(Reservation);
+
+impl MutationReservation {
+    pub(crate) fn belongs_to(&self, gate: &Arc<OperationEntryGate>) -> bool {
+        Arc::ptr_eq(&self.0.gate, gate)
+    }
+
+    pub(crate) fn mark_db_attempted(&mut self) -> Result<(), EntryGateError> {
+        self.0
+            .change_phase(Phase::MutationReserved, Phase::MutationAttempted)
+    }
+
+    /// The caller must have observed successful commit or confirmed rollback.
+    pub(crate) fn finish_known(mut self) -> Result<(), EntryGateError> {
+        self.0.finish_known()
+    }
+}
+
+#[cfg(test)]
+#[path = "operation_entry_gate_tests.rs"]
+mod tests;
