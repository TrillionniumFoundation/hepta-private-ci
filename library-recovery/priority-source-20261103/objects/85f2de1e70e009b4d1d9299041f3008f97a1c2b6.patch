+use super::*;
+use std::sync::Weak;
+
+#[test]
+fn pending_and_active_entry_exclude_matching_mutation_and_lease_close() {
+    let gate = OperationEntryGate::new(/*capacity*/ 8).unwrap();
+    let mut entry = gate.reserve_entry("lease", "op").unwrap();
+    assert!(matches!(
+        gate.reserve_terminal("lease", "op"),
+        Err(EntryGateError::EntryInProgress)
+    ));
+    assert!(matches!(
+        gate.reserve_lease_mutation("lease"),
+        Err(EntryGateError::EntryInProgress)
+    ));
+    entry.activate().unwrap();
+    assert!(matches!(
+        gate.reserve_terminal("lease", "op"),
+        Err(EntryGateError::EntryInProgress)
+    ));
+    assert!(matches!(
+        gate.reserve_lease_mutation("lease"),
+        Err(EntryGateError::EntryInProgress)
+    ));
+    drop(entry);
+    gate.reserve_lease_mutation("lease")
+        .unwrap()
+        .finish_known()
+        .unwrap();
+}
+
+#[test]
+fn unrelated_operation_and_lease_progress_without_partitioning_same_operation() {
+    let gate = OperationEntryGate::new(/*capacity*/ 8).unwrap();
+    let _entry = gate.reserve_entry("lease-a", "op-a").unwrap();
+    gate.reserve_terminal("lease-a", "op-b")
+        .unwrap()
+        .finish_known()
+        .unwrap();
+    gate.reserve_lease_mutation("lease-b")
+        .unwrap()
+        .finish_known()
+        .unwrap();
+    assert!(matches!(
+        gate.reserve_entry("different-lease", "op-a"),
+        Err(EntryGateError::EntryInProgress)
+    ));
+}
+
+#[test]
+fn duplicate_terminal_token_cannot_clear_another_mutation() {
+    let gate = OperationEntryGate::new(/*capacity*/ 8).unwrap();
+    let terminal = gate.reserve_terminal("lease", "op").unwrap();
+    assert!(matches!(
+        gate.reserve_terminal("lease", "op"),
+        Err(EntryGateError::Busy)
+    ));
+    assert!(matches!(
+        gate.reserve_lease_mutation("lease"),
+        Err(EntryGateError::Busy)
+    ));
+    terminal.finish_known().unwrap();
+    gate.reserve_lease_mutation("lease")
+        .unwrap()
+        .finish_known()
+        .unwrap();
+}
+
+#[test]
+fn pre_database_cancellation_releases_both_reservation_kinds() {
+    let gate = OperationEntryGate::new(/*capacity*/ 1).unwrap();
+    drop(gate.reserve_terminal("lease", "op").unwrap());
+    drop(gate.reserve_lease_mutation("lease").unwrap());
+    let mut entry = gate.reserve_entry("lease", "op").unwrap();
+    entry.activate().unwrap();
+}
+
+#[test]
+fn unknown_database_outcome_remains_fenced_without_eviction() {
+    let gate = OperationEntryGate::new(/*capacity*/ 2).unwrap();
+    let mut terminal = gate.reserve_terminal("lease-a", "op").unwrap();
+    terminal.mark_db_attempted().unwrap();
+    drop(terminal);
+    assert!(matches!(
+        gate.reserve_entry("lease-a", "op"),
+        Err(EntryGateError::Busy)
+    ));
+    assert!(matches!(
+        gate.reserve_lease_mutation("lease-a"),
+        Err(EntryGateError::Busy)
+    ));
+    let mut close = gate.reserve_lease_mutation("lease-b").unwrap();
+    close.mark_db_attempted().unwrap();
+    drop(close);
+    assert!(matches!(
+        gate.reserve_entry("lease-b", "other"),
+        Err(EntryGateError::Busy)
+    ));
+    assert!(matches!(
+        gate.reserve_entry("lease-c", "other"),
+        Err(EntryGateError::Capacity)
+    ));
+}
+
+#[test]
+fn known_commit_or_rollback_reclaims_capacity_without_terminal_tombstones() {
+    let gate = OperationEntryGate::new(/*capacity*/ 1).unwrap();
+    for _ in 0..100 {
+        let mut terminal = gate.reserve_terminal("lease", "op").unwrap();
+        terminal.mark_db_attempted().unwrap();
+        terminal.finish_known().unwrap();
+        // A pending slot is possible again, but this gate is not authority:
+        // product entry must freshly reject the persisted terminal row.
+        drop(gate.reserve_entry("lease", "op").unwrap());
+    }
+    assert!(gate.state.lock().unwrap().operations.is_empty());
+    assert!(gate.state.lock().unwrap().leases.is_empty());
+}
+
+#[test]
+fn capacity_failure_never_evicts_pending_entry() {
+    let gate = OperationEntryGate::new(/*capacity*/ 1).unwrap();
+    let pending = gate.reserve_entry("lease", "op").unwrap();
+    assert!(matches!(
+        gate.reserve_entry("other", "other"),
+        Err(EntryGateError::Capacity)
+    ));
+    assert!(matches!(
+        gate.reserve_terminal("lease", "op"),
+        Err(EntryGateError::EntryInProgress)
+    ));
+    drop(pending);
+    drop(gate.reserve_entry("other", "other").unwrap());
+}
+
+#[test]
+fn reservation_retains_gate_but_weak_unused_reference_does_not() {
+    let gate = OperationEntryGate::new(/*capacity*/ 1).unwrap();
+    let weak = Arc::downgrade(&gate);
+    let pending = gate.reserve_entry("lease", "op").unwrap();
+    drop(gate);
+    assert!(Weak::upgrade(&weak).is_some());
+    drop(pending);
+    assert!(Weak::upgrade(&weak).is_none());
+}
+
+#[test]
+fn pending_validation_barrier_excludes_concurrent_close() {
+    let gate = OperationEntryGate::new(/*capacity*/ 8).unwrap();
+    let (ready_tx, ready_rx) = std::sync::mpsc::channel();
+    let (continue_tx, continue_rx) = std::sync::mpsc::channel();
+    let worker_gate = Arc::clone(&gate);
+    let worker = std::thread::spawn(move || {
+        let mut entry = worker_gate.reserve_entry("lease", "op").unwrap();
+        ready_tx.send(()).unwrap();
+        continue_rx.recv().unwrap();
+        entry.activate().unwrap();
+    });
+    ready_rx
+        .recv_timeout(std::time::Duration::from_secs(5))
+        .unwrap();
+    assert!(matches!(
+        gate.reserve_lease_mutation("lease"),
+        Err(EntryGateError::EntryInProgress)
+    ));
+    continue_tx.send(()).unwrap();
+    worker.join().unwrap();
+    gate.reserve_lease_mutation("lease")
+        .unwrap()
+        .finish_known()
+        .unwrap();
+}
+
+#[test]
+fn poisoned_gate_and_invalid_configuration_fail_closed() {
+    assert!(matches!(
+        OperationEntryGate::new(/*capacity*/ 0),
+        Err(EntryGateError::Invalid)
+    ));
+    let gate = OperationEntryGate::new(/*capacity*/ 1).unwrap();
+    assert!(matches!(
+        gate.reserve_entry("", "op"),
+        Err(EntryGateError::Invalid)
+    ));
+    let worker_gate = Arc::clone(&gate);
+    assert!(
+        std::thread::spawn(move || {
+            let _held = worker_gate.state.lock().unwrap();
+            panic!("fixture poison");
+        })
+        .join()
+        .is_err()
+    );
+    assert!(matches!(
+        gate.reserve_entry("lease", "op"),
+        Err(EntryGateError::Unavailable)
+    ));
+}
