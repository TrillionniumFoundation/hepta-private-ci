+pub(crate) async fn verify_entered(
+    store: &CognitiveStore,
+    claim: &DurableDispatchClaim,
+) -> Result<(), LocalLeaseOutboxError> {
+    let mut transaction = store
+        .pool
+        .begin()
+        .await
+        .map_err(crate::cognitive_store::unavailable)?;
+    verify_operation_fence(
+        &mut transaction,
+        store,
+        &claim.operation_id,
+        claim.owner_generation,
+        &claim.fencing_token,
+    )
+    .await?;
+    let current = latest_claim(&mut transaction, &claim.operation_id)
+        .await?
+        .ok_or_else(|| LocalLeaseOutboxError::StaleFence("entered claim is missing".into()))?;
+    if current.state != ClaimState::Entered || to_receipt(&claim.operation_id, &current) != *claim {
+        return Err(LocalLeaseOutboxError::StaleFence(
+            "entered claim is no longer current".into(),
+        ));
+    }
+    transaction
+        .commit()
+        .await
+        .map_err(crate::cognitive_store::unavailable)?;
+    Ok(())
