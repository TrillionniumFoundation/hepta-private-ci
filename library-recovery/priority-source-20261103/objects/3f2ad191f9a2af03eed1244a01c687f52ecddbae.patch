+def validate_module_set(rows: Any, field: str = "module") -> None:
+    if not isinstance(rows, list) or any(not isinstance(row, dict) for row in rows):
+        raise VerificationError("module records must be objects")
+    names = [row.get(field) for row in rows]
+    if (len(names) != len(EXPECTED_MODULES)
+        or any(not isinstance(name, str) for name in names)
+        or set(names) != set(EXPECTED_MODULES)):
+        raise VerificationError("complete unique module set required")
+
+
+def validate_current_sections(row: dict, current: str) -> None:
+    """Check explicit semantic roles without imposing presentation order."""
+    headings = list(re.finditer(r"^## [^\n]+$", current, re.MULTILINE))
+    bodies: dict[str, str] = {}
+    for index, match in enumerate(headings):
+        heading = match.group()
+        if heading in bodies:
+            raise VerificationError("duplicate current-contract section")
+        end = headings[index + 1].start() if index + 1 < len(headings) else len(current)
+        bodies[heading] = current[match.end():end].strip()
+    roles = row.get("currentSpecificationSections")
+    if roles is None:
+        roles = {role: {"heading": role, "mustContain": []} for role in SECTIONS}
+    if not isinstance(roles, dict) or set(roles) != set(SECTIONS):
+        raise VerificationError("complete semantic section roles required")
+    for role, binding in roles.items():
+        if (not isinstance(binding, dict) or set(binding) != {"heading", "mustContain"}
+            or not isinstance(binding["heading"], str)
+            or not isinstance(binding["mustContain"], list)
+            or any(not isinstance(x, str) or not x for x in binding["mustContain"])):
+            raise VerificationError(f"invalid semantic section binding: {role}")
+        body = bodies.get(binding["heading"], "")
+        if not body or any(needle not in body for needle in binding["mustContain"]):
+            raise VerificationError(f"missing semantic section content: {role}")
+
+
+def validate_protocol_registry(value: dict[str, Any], root: Path = ROOT) -> dict[str, dict]:
+    """Validate one module row plus optional same-owner protocol surfaces."""
+    header = {"schemaVersion", "lane", "role", "authority", "protocols"}
+    if (not isinstance(value, dict) or set(value) != header
+        or value.get("schemaVersion") != 1
+        or value.get("lane") != "LANE-A-FOUNDATION"
+        or value.get("role") != "current_executable_protocol_index"
+        or value.get("authority") != "none"):
+        raise VerificationError("protocol registry header mismatch")
+    rows = value.get("protocols")
+    validate_module_set(rows)
+    identities: set[str] = set()
+    current: dict[str, dict] = {}
+    required = {"protocolId", "module", "kind", "source", "invariants"}
+
+    def record(row: Any, owner: str, *, nested: bool) -> None:
+        allowed = required | {"legacyProtocolId"}
+        if not nested:
+            allowed.add("additionalProtocols")
+        if (not isinstance(row, dict) or not required.issubset(row)
+            or not set(row).issubset(allowed) or row.get("module") != owner):
+            raise VerificationError("invalid protocol shape, owner or nesting")
+        for field in ("protocolId", "legacyProtocolId"):
+            if field not in row:
+                continue
+            identity = row[field]
+            if (not isinstance(identity, str)
+                or re.fullmatch(r"hepta\.[a-z0-9]+(?:[.-][a-z0-9]+)*", identity) is None
+                or identity in identities):
+                raise VerificationError("invalid/duplicate protocol identity")
+            identities.add(identity)
+        if not isinstance(row["kind"], str) or not row["kind"].strip():
+            raise VerificationError("protocol kind required")
+        for field in ("source", "invariants"):
+            items = row[field]
+            if not isinstance(items, list) or not items or any(
+                not isinstance(item, str) or not item.strip() for item in items
+            ):
+                raise VerificationError(f"nonempty protocol {field} required")
+        for source in row["source"]:
+            path = Path(source)
+            if (path.is_absolute() or not path.parts or ".." in path.parts
+                or "\\" in source or path.as_posix() != source
+                or not (root / path).exists()
+                or not (root / path).resolve().is_relative_to(root.resolve())):
+                raise VerificationError("invalid/missing protocol source path")
+        current[row["protocolId"]] = row
+        additions = row.get("additionalProtocols", [])
+        if not isinstance(additions, list) or ("additionalProtocols" in row and not additions):
+            raise VerificationError("additionalProtocols must be a nonempty list")
+        for extra in additions:
+            record(extra, owner, nested=True)
+
+    for row in rows:
+        record(row, row["module"], nested=False)
+    return current
+
+
+def validate_capability_coverage(observed: list[tuple[str, str]], expected: list[tuple[str, str]]) -> None:
+    if (len(observed) != len(set(observed)) or len(expected) != len(set(expected))
+        or set(observed) != set(expected)):
+        raise VerificationError("capability map must cover each current capability exactly once")
+
+
