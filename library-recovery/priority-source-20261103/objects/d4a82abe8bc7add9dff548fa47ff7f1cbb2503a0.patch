+    def test_process_observation_accepts_only_confirmed_disappearance(self):
+        for code in (errno.ENOENT, errno.ESRCH):
+            with self.subTest(code=code), patch.object(
+                Path, "read_text", side_effect=OSError(code, "process disappeared")
+            ):
+                self.assertFalse(_process_is_live(123))
+        for code in (errno.EACCES, errno.EPERM, errno.EIO):
+            error = OSError(code, "observation failed")
+            with self.subTest(code=code), patch.object(
+                Path, "read_text", side_effect=error
+            ), self.assertRaises(OSError) as raised:
+                _process_is_live(123)
+            self.assertIs(raised.exception, error)
