+def _process_is_live(pid: int) -> bool:
+    """Observe an unreaped Linux process without racing its disappearance."""
+    try:
+        state = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0]
+    except (FileNotFoundError, ProcessLookupError):
+        return False
+    return state != "Z"
+
