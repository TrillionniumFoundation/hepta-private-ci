+def _first_passage_factors(p: HX, v: float, tau: float) -> tuple[float, float]:
+    """Joint F/G reference in the positive log-distance and horizon region.
+
+    In exact math 0 <= G <= F <= 1. Refuse unresolved f64 ordering rather
+    than clipping; this necessary check is not a full-domain error certificate.
+    """
+    u=p.volatility*math.sqrt(tau)
+    if not (math.isfinite(v) and v>0 and math.isfinite(u) and u>0):
+        raise ArithmeticError('HX first-passage scale unresolved in f64')
+    a,zhat=p.a,p.zhat
+    F=float(ndtr((-v-a*u*u)/u))+_exp_cdf(-2*a*v,(-v+a*u*u)/u)
+    G=(_exp_cdf((-a+zhat)*v,(-v-zhat*u*u)/u)
+       +_exp_cdf((-a-zhat)*v,(-v+zhat*u*u)/u))
+    if not (math.isfinite(F) and math.isfinite(G) and 0<=G<=F<=1):
+        raise ArithmeticError('HX first-passage F/G ordering unresolved in f64')
+    return F,G
 
 
