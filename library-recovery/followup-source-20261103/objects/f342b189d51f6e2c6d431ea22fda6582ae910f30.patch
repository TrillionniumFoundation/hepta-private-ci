+name: Hepta Neuron model trial protocol
+
+on:
+  pull_request:
+    paths:
+      - 'scripts/hepta_neuron_model_trials.py'
+      - 'scripts/hepta_neuron_trial_evidence_gate.py'
+      - '.github/scripts/test_hepta_neuron_model_trials.py'
+      - '.github/scripts/test_hepta_neuron_trial_evidence_gate.py'
+      - '.github/workflows/hepta-neuron-model-trials.yml'
+      - 'qualification/neuron-model-trials/**'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  diagnostic-protocol-only:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
+        with:
+          persist-credentials: false
+      - name: Install isolated signature verification dependency
+        run: |
+          python3 -m venv /tmp/hepta-neuron-trial-venv
+          /tmp/hepta-neuron-trial-venv/bin/python -m pip install --disable-pip-version-check --no-input 'cryptography==46.0.4'
+      - name: Strict offline protocol checks (no weights, no production model claims)
+        run: |
+          /tmp/hepta-neuron-trial-venv/bin/python -m py_compile scripts/hepta_neuron_model_trials.py scripts/hepta_neuron_trial_evidence_gate.py
+          /tmp/hepta-neuron-trial-venv/bin/python -m unittest discover -s .github/scripts -p 'test_hepta_neuron*.py' -v
+          git diff --check
