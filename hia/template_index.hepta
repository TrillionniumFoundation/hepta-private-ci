  compare_b_count:u64 = select(compare_b_shorter,compare_b_key_remaining,compare_b_window_remaining)
  compare_b_header:u64 = const() {"value":32}
  compare_b_key_position:u64 = int.add.checked(compare_b_begin,compare_b_index)
  compare_b_query_position:u64 = int.add.checked(compare_b_header,compare_b_local)
  compare_b_end:u64 = int.add.checked(compare_b_key_position,compare_b_count)
  compare_b_a:usize = int.cast(compare_b_key_position) {"mode":"wrap"}
  compare_b_b:usize = int.cast(compare_b_query_position) {"mode":"wrap"}
  compare_b_limit:usize = int.cast(compare_b_end) {"mode":"wrap"}
  compare_b_result:u64 = call(compare_b_keys,compare_b_query,compare_b_a,compare_b_b,compare_b_limit) {"function":"compare_window"}
  compare_b_one:u64 = const() {"value":1}
  compare_b_equal:bool = compare.eq(compare_b_result,compare_b_one)
  compare_b_next:u64 = int.add.checked(compare_b_index,compare_b_count)
  branch compare_b_equal compared_b(compare_b_size,compare_b_length,compare_b_common,compare_b_next) result_b(compare_b_result)
block compared_b(compared_b_size:u64,compared_b_length:u64,compared_b_common:u64,compared_b_index:u64)
  compared_b_finished:bool = compare.eq(compared_b_index,compared_b_common)
  branch compared_b_finished lengths_b(compared_b_size,compared_b_length) pending_b(compared_b_index)
block lengths_b(lengths_b_size:u64,lengths_b_length:u64)
  lengths_b_equal:bool = compare.eq(lengths_b_size,lengths_b_length)
  lengths_b_less:bool = compare.lt(lengths_b_length,lengths_b_size)
  lengths_b_zero:u64 = const() {"value":0}
  lengths_b_one:u64 = const() {"value":1}
  lengths_b_two:u64 = const() {"value":2}
  lengths_b_unequal:u64 = select(lengths_b_less,lengths_b_zero,lengths_b_two)
  lengths_b_result:u64 = select(lengths_b_equal,lengths_b_one,lengths_b_unequal)
  ret(lengths_b_result,lengths_b_zero)
block result_b(result_b_value:u64)
  result_b_zero:u64 = const() {"value":0}
  ret(result_b_value,result_b_zero)
block pending_b(pending_b_index:u64)
  pending_b_three:u64 = const() {"value":3}
  ret(pending_b_three,pending_b_index)
end
fn compare_window(entry_keys:readbuf,entry_query:mutbuf,entry_a:usize,entry_b:usize,entry_end:usize) -> (u64) effects(read,trap) entry(entry)
block entry(entry_keys:readbuf,entry_query:mutbuf,entry_a:usize,entry_b:usize,entry_end:usize)
  jump loop_b(entry_keys,entry_query,entry_a,entry_b,entry_end)
block loop_b(loop_b_keys:readbuf,loop_b_query:mutbuf,loop_b_a:usize,loop_b_b:usize,loop_b_end:usize)
  loop_b_more:bool = compare.lt(loop_b_a,loop_b_end)
  branch loop_b_more byte_b(loop_b_keys,loop_b_query,loop_b_a,loop_b_b,loop_b_end) equal_b()
block byte_b(byte_b_keys:readbuf,byte_b_query:mutbuf,byte_b_a:usize,byte_b_b:usize,byte_b_end:usize)
  byte_b_av:u8 = buffer.load(byte_b_keys,byte_b_a)
  byte_b_bv:u8 = buffer.load(byte_b_query,byte_b_b)
  byte_b_equal:bool = compare.eq(byte_b_av,byte_b_bv)
  byte_b_less:bool = compare.lt(byte_b_bv,byte_b_av)
  branch byte_b_equal next_b(byte_b_keys,byte_b_query,byte_b_a,byte_b_b,byte_b_end) different_b(byte_b_less)
block next_b(next_b_keys:readbuf,next_b_query:mutbuf,next_b_a:usize,next_b_b:usize,next_b_end:usize)
  next_b_one:usize = const() {"value":1}
  next_b_next_a:usize = int.add.checked(next_b_a,next_b_one)
  next_b_next_b:usize = int.add.checked(next_b_b,next_b_one)
  jump loop_b(next_b_keys,next_b_query,next_b_next_a,next_b_next_b,next_b_end)
block different_b(different_b_less:bool)
  different_b_zero:u64 = const() {"value":0}
  different_b_two:u64 = const() {"value":2}
  different_b_value:u64 = select(different_b_less,different_b_zero,different_b_two)
  ret(different_b_value)
block equal_b()
  equal_b_one:u64 = const() {"value":1}
  ret(equal_b_one)
end
