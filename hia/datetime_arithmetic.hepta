  stay_word:u64 = int.cast(stay_nanos) {"mode":"checked"}
  stay_valid:u64 = const() {"value":1}
  ret(stay_valid,stay_seconds,stay_word)
block normal(normal_seconds:i64,normal_fraction:i64,normal_delta_seconds:i64,normal_delta_nanos:i64)
  whole:i64 = int.add.checked(normal_seconds,normal_delta_seconds)
  fractional:i64 = int.add.checked(normal_fraction,normal_delta_nanos)
  normal_zero:i64 = const() {"value":0}
  normal_one:i64 = const() {"value":1}
  normal_minus_one:i64 = const() {"value":-1}
  normal_billion:i64 = const() {"value":1000000000}
  negative_billion:i64 = const() {"value":-1000000000}
  borrow:bool = compare.lt(fractional,normal_zero)
  carry:bool = compare.ge(fractional,normal_billion)
  carry_seconds:i64 = select(carry,normal_one,normal_zero)
  carry_fraction:i64 = select(carry,negative_billion,normal_zero)
  seconds_adjustment:i64 = select(borrow,normal_minus_one,carry_seconds)
  fraction_adjustment:i64 = select(borrow,normal_billion,carry_fraction)
  result_seconds:i64 = int.add.checked(whole,seconds_adjustment)
  result_fraction:i64 = int.add.checked(fractional,fraction_adjustment)
  result_nanos:u64 = int.cast(result_fraction) {"mode":"checked"}
  result_valid:bool = call(result_seconds,result_nanos) {"function":"timestamp_valid"}
  branch result_valid present(result_seconds,result_nanos) absent()
block present(present_seconds:i64,present_nanos:u64)
  present_valid:u64 = const() {"value":1}
  ret(present_valid,present_seconds,present_nanos)
block absent()
  absent_valid:u64 = const() {"value":0}
  absent_seconds:i64 = const() {"value":0}
  absent_nanos:u64 = const() {"value":0}
  ret(absent_valid,absent_seconds,absent_nanos)
end
fn difference(left_seconds:i64,left_nanos:u64,right_seconds:i64,right_nanos:u64) -> (i64,u64) effects(trap) entry(entry)
block entry(left_seconds:i64,left_nanos:u64,right_seconds:i64,right_nanos:u64)
  day:i64 = const() {"value":86400}
  billion:i64 = const() {"value":1000000000}
  billion_word:u64 = const() {"value":1000000000}
  zero:i64 = const() {"value":0}
  one:i64 = const() {"value":1}
  minus_one:i64 = const() {"value":-1}
  left_day:i64 = call(left_seconds,day) {"function":"floor_div"}
  right_day:i64 = call(right_seconds,day) {"function":"floor_div"}
  left_start:i64 = int.mul.checked(left_day,day)
  right_start:i64 = int.mul.checked(right_day,day)
  left_sod:i64 = int.sub.checked(left_seconds,left_start)
  right_sod:i64 = int.sub.checked(right_seconds,right_start)
  after:bool = compare.gt(left_sod,right_sod)
  before:bool = compare.lt(left_sod,right_sod)
  left_leap:bool = compare.ge(left_nanos,billion_word)
  right_leap:bool = compare.ge(right_nanos,billion_word)
  add_leap:bool = bool.and(after,right_leap)
  subtract_leap:bool = bool.and(before,left_leap)
  minus_adjustment:i64 = select(subtract_leap,minus_one,zero)
  leap_adjustment:i64 = select(add_leap,one,minus_adjustment)
  seconds:i64 = int.sub.checked(left_seconds,right_seconds)
  with_leap:i64 = int.add.checked(seconds,leap_adjustment)
  left_fraction:i64 = int.cast(left_nanos) {"mode":"checked"}
  right_fraction:i64 = int.cast(right_nanos) {"mode":"checked"}
  fraction:i64 = int.sub.checked(left_fraction,right_fraction)
  fraction_seconds:i64 = call(fraction,billion) {"function":"floor_div"}
  whole_fraction:i64 = int.mul.checked(fraction_seconds,billion)
  positive_fraction:i64 = int.sub.checked(fraction,whole_fraction)
  result_seconds:i64 = int.add.checked(with_leap,fraction_seconds)
  result_nanos:u64 = int.cast(positive_fraction) {"mode":"checked"}
  ret(result_seconds,result_nanos)
end
