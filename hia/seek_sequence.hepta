  trimmed_right:usize,trimmed_right_end:usize = call(t_source,t_right_start,t_right_end,both) {"function":"trim_range"}
  unicode_mode:u32 = const() {"value":3}
  unicode:bool = compare.eq(t_mode,unicode_mode)
  branch unicode unicode_loop(t_source,trimmed_left,trimmed_left_end,trimmed_right,trimmed_right_end) byte_ranges(t_source,trimmed_left,trimmed_left_end,trimmed_right,trimmed_right_end)
block byte_ranges(r_source:readbuf,r_left:usize,r_left_end:usize,r_right:usize,r_right_end:usize)
  left_length:usize = int.sub.wrap(r_left_end,r_left)
  right_length:usize = int.sub.wrap(r_right_end,r_right)
  same_length:bool = compare.eq(left_length,right_length)
  branch same_length byte_loop(r_source,r_left,r_left_end,r_right) no()
block byte_loop(b_source:readbuf,b_left:usize,b_end:usize,b_right:usize)
  more_bytes:bool = compare.lt(b_left,b_end)
  branch more_bytes compare_bytes(b_source,b_left,b_end,b_right) yes()
block compare_bytes(c_source:readbuf,c_left:usize,c_end:usize,c_right:usize)
  left_byte:u8 = buffer.load(c_source,c_left)
  right_byte:u8 = buffer.load(c_source,c_right)
  same_byte:bool = compare.eq(left_byte,right_byte)
  byte_one:usize = const() {"value":1}
  next_left:usize = int.add.wrap(c_left,byte_one)
  next_right:usize = int.add.wrap(c_right,byte_one)
  branch same_byte byte_loop(c_source,next_left,c_end,next_right) no()
block unicode_loop(u_source:readbuf,u_left:usize,u_left_end:usize,u_right:usize,u_right_end:usize)
  left_more:bool = compare.lt(u_left,u_left_end)
  branch left_more right_available(u_source,u_left,u_left_end,u_right,u_right_end) unicode_done(u_right,u_right_end)
block right_available(a_source:readbuf,a_left:usize,a_left_end:usize,a_right:usize,a_right_end:usize)
  right_more:bool = compare.lt(a_right,a_right_end)
  branch right_more compare_unicode(a_source,a_left,a_left_end,a_right,a_right_end) no()
block compare_unicode(n_source:readbuf,n_left:usize,n_left_end:usize,n_right:usize,n_right_end:usize)
  left_scalar:u32,left_next:usize = call(n_source,n_left,n_left_end) {"function":"decode_utf8"}
  right_scalar:u32,right_next:usize = call(n_source,n_right,n_right_end) {"function":"decode_utf8"}
  normal_left:u32 = call(left_scalar) {"function":"normalise"}
  normal_right:u32 = call(right_scalar) {"function":"normalise"}
  same_scalar:bool = compare.eq(normal_left,normal_right)
  branch same_scalar unicode_loop(n_source,left_next,n_left_end,right_next,n_right_end) no()
block unicode_done(d_right:usize,d_end:usize)
  complete:bool = compare.eq(d_right,d_end)
  ret(complete)
block yes()
  accepted:bool = const() {"value":true}
  ret(accepted)
block no()
  rejected:bool = const() {"value":false}
  ret(rejected)
end
fn line_range(source:readbuf,index:usize,payload:usize) -> (usize,usize) effects(read,trap) entry(entry)
block entry(source:readbuf,index:usize,payload:usize)
  eight:usize = const() {"value":8}
  base:usize = const() {"value":32}
  displacement:usize = int.mul.wrap(index,eight)
  position:usize = int.add.wrap(base,displacement)
  next_position:usize = int.add.wrap(position,eight)
  start_word:u64 = call(source,position) {"function":"read_word"}
  end_word:u64 = call(source,next_position) {"function":"read_word"}
  start_offset:usize = int.cast(start_word) {"mode":"wrap"}
  end_offset:usize = int.cast(end_word) {"mode":"wrap"}
  start:usize = int.add.wrap(payload,start_offset)
  end_offset_absolute:usize = int.add.wrap(payload,end_offset)
  ret(start,end_offset_absolute)
end
fn seek(source:readbuf,lines:usize,patterns:usize,start:usize,flags:u64,payload:usize) -> (bool,usize) effects(read,trap) entry(entry)
block entry(source:readbuf,lines:usize,patterns:usize,start:usize,flags:u64,payload:usize)
  zero:usize = const() {"value":0}
  empty_pattern:bool = compare.eq(patterns,zero)
  branch empty_pattern found(start) nonempty(source,lines,patterns,start,flags,payload)
block nonempty(n_source:readbuf,n_lines:usize,n_patterns:usize,n_start:usize,n_flags:u64,n_payload:usize)
  possible:bool = compare.le(n_patterns,n_lines)
  branch possible initialize(n_source,n_lines,n_patterns,n_start,n_flags,n_payload) none()
block initialize(i_source:readbuf,i_lines:usize,i_patterns:usize,i_start:usize,i_flags:u64,i_payload:usize)
  last:usize = int.sub.wrap(i_lines,i_patterns)
  one_flag:u64 = const() {"value":1}
  two_flag:u64 = const() {"value":2}
  zero_flag:u64 = const() {"value":0}
  eof_bits:u64 = bit.and(i_flags,one_flag)
  preserve_bits:u64 = bit.and(i_flags,two_flag)
  eof:bool = compare.ne(eof_bits,zero_flag)
  preserve:bool = compare.ne(preserve_bits,zero_flag)
  start_later:bool = compare.gt(i_start,last)
  latest:usize = select(start_later,i_start,last)
  eof_start:usize = select(preserve,latest,last)
  search_start:usize = select(eof,eof_start,i_start)
  initial_mode:u32 = const() {"value":0}
  jump phase(i_source,i_lines,i_patterns,i_payload,search_start,last,initial_mode)
block phase(p_source:readbuf,p_lines:usize,p_patterns:usize,p_payload:usize,p_start:usize,p_last:usize,p_mode:u32)
  mode_limit:u32 = const() {"value":4}
  more_phases:bool = compare.lt(p_mode,mode_limit)
  branch more_phases candidate(p_source,p_lines,p_patterns,p_payload,p_start,p_last,p_mode,p_start) none()
block candidate(c_source:readbuf,c_lines:usize,c_patterns:usize,c_payload:usize,c_start:usize,c_last:usize,c_mode:u32,c_index:usize)
  candidate_available:bool = compare.le(c_index,c_last)
  initial_pattern:usize = const() {"value":0}
  branch candidate_available pattern(c_source,c_lines,c_patterns,c_payload,c_start,c_last,c_mode,c_index,initial_pattern) next_phase(c_source,c_lines,c_patterns,c_payload,c_start,c_last,c_mode)
block pattern(t_source:readbuf,t_lines:usize,t_patterns:usize,t_payload:usize,t_start:usize,t_last:usize,t_mode:u32,t_index:usize,t_pattern:usize)
  more_lines:bool = compare.lt(t_pattern,t_patterns)
  branch more_lines compare(t_source,t_lines,t_patterns,t_payload,t_start,t_last,t_mode,t_index,t_pattern) found(t_index)
block compare(v_source:readbuf,v_lines:usize,v_patterns:usize,v_payload:usize,v_start:usize,v_last:usize,v_mode:u32,v_index:usize,v_pattern:usize)
  line_index:usize = int.add.wrap(v_index,v_pattern)
  pattern_index:usize = int.add.wrap(v_lines,v_pattern)
  line_start:usize,line_end:usize = call(v_source,line_index,v_payload) {"function":"line_range"}
  pattern_start:usize,pattern_end:usize = call(v_source,pattern_index,v_payload) {"function":"line_range"}
  same:bool = call(v_source,line_start,line_end,pattern_start,pattern_end,v_mode) {"function":"equal_line"}
  one_line:usize = const() {"value":1}
  next_pattern:usize = int.add.wrap(v_pattern,one_line)
  next_candidate:usize = int.add.wrap(v_index,one_line)
  branch same pattern(v_source,v_lines,v_patterns,v_payload,v_start,v_last,v_mode,v_index,next_pattern) candidate(v_source,v_lines,v_patterns,v_payload,v_start,v_last,v_mode,next_candidate)
block next_phase(q_source:readbuf,q_lines:usize,q_patterns:usize,q_payload:usize,q_start:usize,q_last:usize,q_mode:u32)
  one_mode:u32 = const() {"value":1}
  following_mode:u32 = int.add.wrap(q_mode,one_mode)
  jump phase(q_source,q_lines,q_patterns,q_payload,q_start,q_last,following_mode)
block found(result_index:usize)
  yes:bool = const() {"value":true}
  ret(yes,result_index)
block none()
  no:bool = const() {"value":false}
  no_index:usize = const() {"value":0}
  ret(no,no_index)
end
