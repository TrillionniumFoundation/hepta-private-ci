  branch e_needed runs(workspace,count,e_one,e_source,e_dest,e_zero) done(e_source)
block runs(r_workspace:mutbuf,r_count:usize,r_width:usize,r_source:usize,r_dest:usize,r_start:usize)
  r_more:bool = compare.lt(r_start,r_count)
  branch r_more interval(r_workspace,r_count,r_width,r_source,r_dest,r_start) next_width(r_workspace,r_count,r_width,r_source,r_dest)
block interval(i_workspace:mutbuf,i_count:usize,i_width:usize,i_source:usize,i_dest:usize,i_start:usize)
  i_left:usize = int.sub.checked(i_count,i_start)
