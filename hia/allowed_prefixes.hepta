fn merge(workspace:mutbuf,source:usize,dest:usize,start:usize,middle:usize,end:usize) -> (usize) effects(read,write,trap) entry(entry)
block entry(workspace:mutbuf,source:usize,dest:usize,start:usize,middle:usize,end:usize)
  jump left_gate(workspace,source,dest,start,middle,middle,end,start)
block left_gate(l_workspace:mutbuf,l_source:usize,l_dest:usize,l_left:usize,l_middle:usize,l_right:usize,l_end:usize,l_out:usize)
  l_more:bool = compare.lt(l_left,l_middle)
  branch l_more right_gate(l_workspace,l_source,l_dest,l_left,l_middle,l_right,l_end,l_out) right_only(l_workspace,l_source,l_dest,l_left,l_middle,l_right,l_end,l_out)
block right_gate(r_workspace:mutbuf,r_source:usize,r_dest:usize,r_left:usize,r_middle:usize,r_right:usize,r_end:usize,r_out:usize)
  r_more:bool = compare.lt(r_right,r_end)
  branch r_more compare(r_workspace,r_source,r_dest,r_left,r_middle,r_right,r_end,r_out) left_copy(r_workspace,r_source,r_dest,r_left,r_middle,r_right,r_end,r_out)
block right_only(o_workspace:mutbuf,o_source:usize,o_dest:usize,o_left:usize,o_middle:usize,o_right:usize,o_end:usize,o_out:usize)
  o_more:bool = compare.lt(o_right,o_end)
  branch o_more right_copy(o_workspace,o_source,o_dest,o_left,o_middle,o_right,o_end,o_out) done(o_end)
block compare(c_workspace:mutbuf,c_source:usize,c_dest:usize,c_left:usize,c_middle:usize,c_right:usize,c_end:usize,c_out:usize)
  c_word:usize = const() {"value":8}
  c_l_offset:usize = int.mul.checked(c_left,c_word)
  c_r_offset:usize = int.mul.checked(c_right,c_word)
  c_l_at:usize = int.add.checked(c_source,c_l_offset)
  c_r_at:usize = int.add.checked(c_source,c_r_offset)
  c_l_word:u64 = buffer.load.u64.le(c_workspace,c_l_at)
  c_r_word:u64 = buffer.load.u64.le(c_workspace,c_r_at)
  c_l:usize = int.cast(c_l_word) {"mode":"wrap"}
  c_r:usize = int.cast(c_r_word) {"mode":"wrap"}
  c_order:u8 = call(c_workspace,c_l,c_r) {"function":"compare_vectors"}
