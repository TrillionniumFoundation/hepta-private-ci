  i_after:usize = call(i_workspace,i_source,i_dest,i_start,i_middle,i_end) {"function":"merge"}
  jump runs(i_workspace,i_count,i_width,i_source,i_dest,i_after)
block next_width(n_workspace:mutbuf,n_count:usize,n_width:usize,n_source:usize,n_dest:usize)
  n_remaining:usize = int.sub.checked(n_count,n_width)
  n_complete:bool = compare.ge(n_width,n_remaining)
  branch n_complete done(n_dest) advance(n_workspace,n_count,n_width,n_source,n_dest)
block advance(a_workspace:mutbuf,a_count:usize,a_width:usize,a_source:usize,a_dest:usize)
  a_double:usize = int.add.checked(a_width,a_width)
  a_zero:usize = const() {"value":0}
  jump runs(a_workspace,a_count,a_double,a_dest,a_source,a_zero)
block done(result:usize)
  ret(result)
end
fn emit_results(workspace:mutbuf,output:mutbuf,count:usize,sorted:usize) -> (u32) effects(read,write,trap) entry(entry)
block entry(workspace:mutbuf,output:mutbuf,count:usize,sorted:usize)
  e_zero:usize = const() {"value":0}
  jump scan(workspace,output,count,sorted,e_zero,e_zero,e_zero)
block scan(s_workspace:mutbuf,s_output:mutbuf,s_count:usize,s_sorted:usize,s_index:usize,s_unique:usize,s_last:usize)
  s_more:bool = compare.lt(s_index,s_count)
  branch s_more item(s_workspace,s_output,s_count,s_sorted,s_index,s_unique,s_last) done(s_output,s_unique)
block item(i_workspace:mutbuf,i_output:mutbuf,i_count:usize,i_sorted:usize,i_index:usize,i_unique:usize,i_last:usize)
  i_eight:usize = const() {"value":8}
  i_offset:usize = int.mul.checked(i_index,i_eight)
  i_at:usize = int.add.checked(i_sorted,i_offset)
  i_key_word:u64 = buffer.load.u64.le(i_workspace,i_at)
  i_key:usize = int.cast(i_key_word) {"mode":"wrap"}
  i_zero:usize = const() {"value":0}
  i_first:bool = compare.eq(i_unique,i_zero)
  branch i_first emit(i_workspace,i_output,i_count,i_sorted,i_index,i_unique,i_key) compare(i_workspace,i_output,i_count,i_sorted,i_index,i_unique,i_last,i_key)
block compare(c_workspace:mutbuf,c_output:mutbuf,c_count:usize,c_sorted:usize,c_index:usize,c_unique:usize,c_last:usize,c_key:usize)
  c_order:u8 = call(c_workspace,c_last,c_key) {"function":"compare_vectors"}
  c_equal:u8 = const() {"value":1}
  c_duplicate:bool = compare.eq(c_order,c_equal)
  branch c_duplicate skip(c_workspace,c_output,c_count,c_sorted,c_index,c_unique,c_last) emit(c_workspace,c_output,c_count,c_sorted,c_index,c_unique,c_key)
block skip(k_workspace:mutbuf,k_output:mutbuf,k_count:usize,k_sorted:usize,k_index:usize,k_unique:usize,k_last:usize)
  k_one:usize = const() {"value":1}
  k_next:usize = int.add.checked(k_index,k_one)
  jump scan(k_workspace,k_output,k_count,k_sorted,k_next,k_unique,k_last)
block emit(m_workspace:mutbuf,m_output:mutbuf,m_count:usize,m_sorted:usize,m_index:usize,m_unique:usize,m_key:usize)
  m_one:usize = const() {"value":1}
  m_eight:usize = const() {"value":8}
  m_slot:usize = int.add.checked(m_unique,m_one)
  m_at:usize = int.mul.checked(m_slot,m_eight)
  m_value:u64 = int.cast(m_key) {"mode":"wrap"}
  _ = buffer.store.u64.le(m_output,m_at,m_value)
  m_next:usize = int.add.checked(m_index,m_one)
  jump scan(m_workspace,m_output,m_count,m_sorted,m_next,m_slot,m_key)
block done(d_output:mutbuf,d_unique:usize)
  d_zero:usize = const() {"value":0}
  d_word:u64 = int.cast(d_unique) {"mode":"wrap"}
  _ = buffer.store.u64.le(d_output,d_zero,d_word)
  d_ok:u32 = const() {"value":0}
  ret(d_ok)
end
