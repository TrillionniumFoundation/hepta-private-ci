  i_l_size:usize = select(i_left_short,i_left,i_width)
  i_middle:usize = int.add.checked(i_start,i_l_size)
  i_right:usize = int.sub.checked(i_count,i_middle)
  i_right_short:bool = compare.lt(i_right,i_width)
  i_r_size:usize = select(i_right_short,i_right,i_width)
