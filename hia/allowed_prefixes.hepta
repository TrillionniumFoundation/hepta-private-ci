  b_word:usize = const() {"value":8}
  b_offset:usize = int.mul.checked(b_right,b_word)
  b_at:usize = int.add.checked(b_source,b_offset)
  b_key:u64 = buffer.load.u64.le(b_workspace,b_at)
  b_one:usize = const() {"value":1}
  b_next:usize = int.add.checked(b_right,b_one)
