  a_word:usize = const() {"value":8}
  a_offset:usize = int.mul.checked(a_left,a_word)
  a_at:usize = int.add.checked(a_source,a_offset)
  a_key:u64 = buffer.load.u64.le(a_workspace,a_at)
  a_one:usize = const() {"value":1}
  a_next:usize = int.add.checked(a_left,a_one)
