  s_one:usize = const() {"value":1}
  s_next:usize = int.add.checked(s_out,s_one)
  jump left_gate(s_workspace,s_source,s_dest,s_left,s_middle,s_right,s_end,s_next)
block done(result:usize)
  ret(result)
end
fn sort_indices(workspace:mutbuf,count:usize) -> (usize) effects(read,write,trap) entry(entry)
block entry(workspace:mutbuf,count:usize)
  e_one:usize = const() {"value":1}
  e_eight:usize = const() {"value":8}
  e_slots:usize = int.add.checked(count,e_one)
  e_source:usize = int.mul.checked(e_slots,e_eight)
