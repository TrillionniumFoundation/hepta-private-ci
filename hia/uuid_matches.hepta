  advance_match_complete:bool = compare.eq(advance_match_next,advance_match_size)
  advance_match_zero:usize = const() {"value":0}
  branch advance_match_complete emit(a_source,a_output,a_index,advance_match_zero) match_byte(a_source,a_output,a_index,a_final,advance_match_next)
block next_candidate(n_source:readbuf,n_output:mutbuf,n_index:usize,n_final:bool)
  next_candidate_one:usize = const() {"value":1}
  next_candidate_index:usize = int.add.checked(n_index,next_candidate_one)
