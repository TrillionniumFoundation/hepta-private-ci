  branch emit_complete matched(e_index) emit(e_source,e_output,e_index,emit_next)
block matched(r_index:usize)
  matched_size:usize = const() {"value":36}
  matched_end:usize = int.add.checked(r_index,matched_size)
  matched_consumed:u32 = int.cast(matched_end) {"mode":"wrap"}
  matched_tag:u32 = const() {"value":65536}
