  _ = buffer.store.u64.le(output,p48,zero)
  _ = buffer.store.u64.le(output,p56,zero)
  success:u32 = const() {"value":0}
  ret(success)
end
fn civil_days(year:i64,month:u64,day:u64) -> (i64,u64) effects(trap) entry(entry)
block entry(year:i64,month:u64,day:u64)
  one:u64 = const() {"value":1}
  twelve:u64 = const() {"value":12}
  thirty_one:u64 = const() {"value":31}
  month_min:bool = compare.ge(month,one)
  month_max:bool = compare.le(month,twelve)
  day_min:bool = compare.ge(day,one)
  day_max:bool = compare.le(day,thirty_one)
  month_ok:bool = bool.and(month_min,month_max)
  day_ok:bool = bool.and(day_min,day_max)
  range_ok:bool = bool.and(month_ok,day_ok)
  branch range_ok month_length(year,month,day) invalid()
block month_length(length_year:i64,length_month:u64,length_day:u64)
  four:i64 = const() {"value":4}
  hundred:i64 = const() {"value":100}
  four_hundred:i64 = const() {"value":400}
  zero:i64 = const() {"value":0}
  mod_four:i64 = int.rem.checked(length_year,four)
  mod_hundred:i64 = int.rem.checked(length_year,hundred)
  mod_four_hundred:i64 = int.rem.checked(length_year,four_hundred)
  by_four:bool = compare.eq(mod_four,zero)
  not_century:bool = compare.ne(mod_hundred,zero)
  whole_era:bool = compare.eq(mod_four_hundred,zero)
  century_ok:bool = bool.or(not_century,whole_era)
  leap:bool = bool.and(by_four,century_ok)
  february:u64 = const() {"value":2}
  april:u64 = const() {"value":4}
  june:u64 = const() {"value":6}
  september:u64 = const() {"value":9}
  november:u64 = const() {"value":11}
  d28:u64 = const() {"value":28}
  d29:u64 = const() {"value":29}
  d30:u64 = const() {"value":30}
  d31:u64 = const() {"value":31}
  is_february:bool = compare.eq(length_month,february)
  is_april:bool = compare.eq(length_month,april)
  is_june:bool = compare.eq(length_month,june)
  is_september:bool = compare.eq(length_month,september)
  is_november:bool = compare.eq(length_month,november)
  spring_short:bool = bool.or(is_april,is_june)
  autumn_short:bool = bool.or(is_september,is_november)
  short_month:bool = bool.or(spring_short,autumn_short)
  ordinary_length:u64 = select(short_month,d30,d31)
  february_length:u64 = select(leap,d29,d28)
  maximum:u64 = select(is_february,february_length,ordinary_length)
  valid:bool = compare.le(length_day,maximum)
  branch valid calculate(length_year,length_month,length_day) invalid()
block calculate(calc_year:i64,calc_month:u64,calc_day:u64)
  month_word:i64 = int.cast(calc_month) {"mode":"checked"}
  day_word:i64 = int.cast(calc_day) {"mode":"checked"}
  calc_zero:i64 = const() {"value":0}
  calc_one:i64 = const() {"value":1}
  calc_two:i64 = const() {"value":2}
  calc_four:i64 = const() {"value":4}
  calc_five:i64 = const() {"value":5}
  calc_hundred:i64 = const() {"value":100}
  era_years:i64 = const() {"value":400}
  year_days:i64 = const() {"value":365}
  era_days:i64 = const() {"value":146097}
  month_span:i64 = const() {"value":153}
  epoch:i64 = const() {"value":719468}
  negative_three:i64 = const() {"value":-3}
  nine:i64 = const() {"value":9}
  winter:bool = compare.le(month_word,calc_two)
  year_adjustment:i64 = select(winter,calc_one,calc_zero)
  adjusted_year:i64 = int.sub.checked(calc_year,year_adjustment)
  era:i64 = call(adjusted_year,era_years) {"function":"floor_div"}
  era_start_year:i64 = int.mul.checked(era,era_years)
  year_of_era:i64 = int.sub.checked(adjusted_year,era_start_year)
  month_adjustment:i64 = select(winter,nine,negative_three)
  march_month:i64 = int.add.checked(month_word,month_adjustment)
  scaled_month:i64 = int.mul.checked(march_month,month_span)
  corrected_month:i64 = int.add.checked(scaled_month,calc_two)
  month_start:i64 = int.div.checked(corrected_month,calc_five)
  with_day:i64 = int.add.checked(month_start,day_word)
  day_of_year:i64 = int.sub.checked(with_day,calc_one)
  whole_years:i64 = int.mul.checked(year_of_era,year_days)
  leap_days:i64 = int.div.checked(year_of_era,calc_four)
  century_days:i64 = int.div.checked(year_of_era,calc_hundred)
  with_leaps:i64 = int.add.checked(whole_years,leap_days)
  without_centuries:i64 = int.sub.checked(with_leaps,century_days)
  day_of_era:i64 = int.add.checked(without_centuries,day_of_year)
  era_start_days:i64 = int.mul.checked(era,era_days)
  absolute_days:i64 = int.add.checked(era_start_days,day_of_era)
  result:i64 = int.sub.checked(absolute_days,epoch)
  success:u64 = const() {"value":0}
  ret(result,success)
block invalid()
  invalid_days:i64 = const() {"value":0}
  error:u64 = const() {"value":1}
  ret(invalid_days,error)
end
fn floor_div(numerator:i64,denominator:i64) -> (i64) effects(trap) entry(entry)
block entry(numerator:i64,denominator:i64)
  quotient:i64 = int.div.checked(numerator,denominator)
  remainder:i64 = int.rem.checked(numerator,denominator)
  zero:i64 = const() {"value":0}
  one:i64 = const() {"value":1}
  negative:bool = compare.lt(remainder,zero)
  adjustment:i64 = select(negative,one,zero)
  result:i64 = int.sub.checked(quotient,adjustment)
  ret(result)
end
