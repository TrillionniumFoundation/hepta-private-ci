  p16:usize = const() {"value":16}
  p24:usize = const() {"value":24}
  p32:usize = const() {"value":32}
  p40:usize = const() {"value":40}
  p48:usize = const() {"value":48}
  p56:usize = const() {"value":56}
  p64:usize = const() {"value":64}
  p72:usize = const() {"value":72}
  zero:u64 = const() {"value":0}
  _ = call(output,p0,active) {"function":"write_word"}
  _ = call(output,p8,detect) {"function":"write_word"}
