  low_shifted:u64 = int.shr.checked(l_word,low_shift)
  low_byte:u64 = bit.and(low_shifted,l_mask)
  ret(low_byte)
block high(h_index:u64)
  h_word:u64 = const() {"value":17572813266247524}
  h_eight:u64 = const() {"value":8}
  h_mask:u64 = const() {"value":255}
  high_index:u64 = int.sub.checked(h_index,h_eight)
  high_shift:u64 = int.mul.checked(high_index,h_eight)
  high_shifted:u64 = int.shr.checked(h_word,high_shift)
  high_byte:u64 = bit.and(high_shifted,h_mask)
  ret(high_byte)
end
fn emit_text(output:mutbuf,count:u64,base_kind:u64,active:u64,offset:u64,length:u64,last:u64) -> (u64) effects(write,trap) entry(entry)
block entry(output:mutbuf,count:u64,base_kind:u64,active:u64,offset:u64,length:u64,last:u64)
  zero:u64 = const() {"value":0}
  one:u64 = const() {"value":1}
  channel:u64 = int.add.checked(active,one)
  same_channel:bool = compare.eq(last,channel)
  continuation:u64 = select(same_channel,one,zero)
  kind:u64 = int.add.checked(base_kind,active)
  next_count:u64 = call(output,count,kind,offset,length,continuation) {"function":"emit_command"}
  ret(next_count)
end
fn emit_command(output:mutbuf,count:u64,kind:u64,offset:u64,length:u64,continuation:u64) -> (u64) effects(write,trap) entry(entry)
block entry(output:mutbuf,count:u64,kind:u64,offset:u64,length:u64,continuation:u64)
  header:usize = const() {"value":80}
  record:usize = const() {"value":32}
  eight:usize = const() {"value":8}
  sixteen:usize = const() {"value":16}
  twenty_four:usize = const() {"value":24}
  one:u64 = const() {"value":1}
  count_size:usize = int.cast(count) {"mode":"checked"}
  record_offset:usize = int.mul.checked(count_size,record)
  position:usize = int.add.checked(header,record_offset)
  offset_position:usize = int.add.checked(position,eight)
  length_position:usize = int.add.checked(position,sixteen)
  continuation_position:usize = int.add.checked(position,twenty_four)
  _ = call(output,position,kind) {"function":"write_word"}
  _ = call(output,offset_position,offset) {"function":"write_word"}
  _ = call(output,length_position,length) {"function":"write_word"}
  _ = call(output,continuation_position,continuation) {"function":"write_word"}
  next_count:u64 = int.add.checked(count,one)
  ret(next_count)
end
fn write_state(output:mutbuf,active:u64,detect:u64,prefix:u64,leading:u64,trailing:u64,pending:u64,call_open:u64,last:u64,count:u64) -> () effects(write,trap) entry(entry)
block entry(output:mutbuf,active:u64,detect:u64,prefix:u64,leading:u64,trailing:u64,pending:u64,call_open:u64,last:u64,count:u64)
  p0:usize = const() {"value":0}
