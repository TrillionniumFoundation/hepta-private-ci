  full_batch:bool = compare.ge(remaining,batch_size)
  branch full_batch batch(s_source,s_index,s_end,s_count) tail(s_source,s_index,s_end,s_count)
block batch(b_source:readbuf,b_index:usize,b_end:usize,b_count:u64)
  byte0:u8 = buffer.load(b_source,b_index)
  word0:u64 = int.cast(byte0) {"mode":"wrap"}
  offset1:usize = const() {"value":1}
  address1:usize = int.add.checked(b_index,offset1)
  byte1:u8 = buffer.load(b_source,address1)
  word1:u64 = int.cast(byte1) {"mode":"wrap"}
  shift1:u64 = const() {"value":8}
  shifted1:u64 = int.shl.checked(word1,shift1)
  combined1:u64 = bit.or(word0,shifted1)
  offset2:usize = const() {"value":2}
  address2:usize = int.add.checked(b_index,offset2)
  byte2:u8 = buffer.load(b_source,address2)
  word2:u64 = int.cast(byte2) {"mode":"wrap"}
  shift2:u64 = const() {"value":16}
  shifted2:u64 = int.shl.checked(word2,shift2)
  combined2:u64 = bit.or(combined1,shifted2)
  offset3:usize = const() {"value":3}
  address3:usize = int.add.checked(b_index,offset3)
  byte3:u8 = buffer.load(b_source,address3)
  word3:u64 = int.cast(byte3) {"mode":"wrap"}
  shift3:u64 = const() {"value":24}
  shifted3:u64 = int.shl.checked(word3,shift3)
  combined3:u64 = bit.or(combined2,shifted3)
  offset4:usize = const() {"value":4}
  address4:usize = int.add.checked(b_index,offset4)
  byte4:u8 = buffer.load(b_source,address4)
  word4:u64 = int.cast(byte4) {"mode":"wrap"}
  shift4:u64 = const() {"value":32}
  shifted4:u64 = int.shl.checked(word4,shift4)
  combined4:u64 = bit.or(combined3,shifted4)
  offset5:usize = const() {"value":5}
  address5:usize = int.add.checked(b_index,offset5)
  byte5:u8 = buffer.load(b_source,address5)
  word5:u64 = int.cast(byte5) {"mode":"wrap"}
  shift5:u64 = const() {"value":40}
  shifted5:u64 = int.shl.checked(word5,shift5)
  combined5:u64 = bit.or(combined4,shifted5)
  offset6:usize = const() {"value":6}
  address6:usize = int.add.checked(b_index,offset6)
  byte6:u8 = buffer.load(b_source,address6)
  word6:u64 = int.cast(byte6) {"mode":"wrap"}
  shift6:u64 = const() {"value":48}
  shifted6:u64 = int.shl.checked(word6,shift6)
  combined6:u64 = bit.or(combined5,shifted6)
  offset7:usize = const() {"value":7}
  address7:usize = int.add.checked(b_index,offset7)
  byte7:u8 = buffer.load(b_source,address7)
  word7:u64 = int.cast(byte7) {"mode":"wrap"}
  shift7:u64 = const() {"value":56}
  shifted7:u64 = int.shl.checked(word7,shift7)
  combined7:u64 = bit.or(combined6,shifted7)
  one:u64 = const() {"value":1}
  shifted_bits:u64 = int.shl.checked(combined7,one)
  inverse_second:u64 = bit.not(shifted_bits)
  continuation_bits:u64 = bit.and(combined7,inverse_second)
  high_mask:u64 = const() {"value":9259542123273814144}
  continuation_high:u64 = bit.and(continuation_bits,high_mask)
  seven:u64 = const() {"value":7}
  continuation_low:u64 = int.shr.checked(continuation_high,seven)
  sum_factor:u64 = const() {"value":72340172838076673}
  spread:u64 = int.mul.wrap(continuation_low,sum_factor)
  fifty_six:u64 = const() {"value":56}
  continuation_count:u64 = int.shr.checked(spread,fifty_six)
  eight:u64 = const() {"value":8}
  scalars:u64 = int.sub.checked(eight,continuation_count)
  batch_count:u64 = int.add.checked(b_count,scalars)
  step:usize = const() {"value":8}
  batch_next:usize = int.add.checked(b_index,step)
  jump scan(b_source,batch_next,b_end,batch_count)
block tail(t_source:readbuf,t_index:usize,t_end:usize,t_count:u64)
  more:bool = compare.lt(t_index,t_end)
  branch more tail_byte(t_source,t_index,t_end,t_count) done(t_count)
block tail_byte(v_source:readbuf,v_index:usize,v_end:usize,v_count:u64)
  tail_octet:u8 = buffer.load(v_source,v_index)
  mask:u8 = const() {"value":192}
  tag:u8 = const() {"value":128}
  masked:u8 = bit.and(tail_octet,mask)
  is_continuation:bool = compare.eq(masked,tag)
  tail_zero:u64 = const() {"value":0}
  tail_one:u64 = const() {"value":1}
  increment:u64 = select(is_continuation,tail_zero,tail_one)
  tail_count:u64 = int.add.checked(v_count,increment)
  tail_step:usize = const() {"value":1}
  tail_next:usize = int.add.checked(v_index,tail_step)
  jump tail(v_source,tail_next,v_end,tail_count)
block done(result:u64)
  ret(result)
end
