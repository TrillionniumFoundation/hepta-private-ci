  zero:i64 = const() {"value":0}
  negated:i64 = int.sub.checked(zero,magnitude)
  year:i64 = select(value_negative,negated,magnitude)
  minimum:i64 = const() {"value":-2147483648}
  maximum:i64 = const() {"value":2147483647}
