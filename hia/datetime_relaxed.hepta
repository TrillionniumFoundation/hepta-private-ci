  e2:u8 = const() {"value":226}
  e3:u8 = const() {"value":227}
  ogham:u64 = const() {"value":39552}
  spaces_start:u64 = const() {"value":32896}
  spaces_end:u64 = const() {"value":32906}
  line_separator:u64 = const() {"value":32936}
  paragraph_separator:u64 = const() {"value":32937}
  narrow_nbsp:u64 = const() {"value":32943}
  medium_space:u64 = const() {"value":33183}
