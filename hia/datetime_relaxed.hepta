block digit(digit_source:readbuf,digit_index:usize,digit_width:usize,digit_count:usize,digit_value:u64)
  byte:u8 = buffer.load(digit_source,digit_index)
  lower:u8 = const() {"value":48}
  upper:u8 = const() {"value":57}
