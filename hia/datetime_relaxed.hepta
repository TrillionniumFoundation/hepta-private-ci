  unsigned_value:u64,unsigned_after:usize,unsigned_error:u64 = call(unsigned_source,unsigned_position,four) {"function":"scan_number"}
  unsigned_negative:bool = const() {"value":false}
  jump checked(unsigned_value,unsigned_after,unsigned_error,unsigned_negative)
block checked(checked_value:u64,checked_position:usize,checked_error:u64,checked_negative:bool)
  zero_error:u64 = const() {"value":0}
  number_ok:bool = compare.eq(checked_error,zero_error)
