  ideographic_tail:bool = compare.eq(tail,spaces_start)
  group_low:bool = compare.ge(tail,spaces_start)
  group_high:bool = compare.le(tail,spaces_end)
  group:bool = bool.and(group_low,group_high)
  line:bool = compare.eq(tail,line_separator)
  paragraph:bool = compare.eq(tail,paragraph_separator)
  narrow:bool = compare.eq(tail,narrow_nbsp)
  medium:bool = compare.eq(tail,medium_space)
  lines:bool = bool.or(line,paragraph)
  singles:bool = bool.or(narrow,medium)
  special:bool = bool.or(lines,singles)
  e2_tail:bool = bool.or(group,special)
  ogham_ok:bool = bool.and(first_e1,ogham_tail)
  e2_ok:bool = bool.and(first_e2,e2_tail)
  ideographic_ok:bool = bool.and(first_e3,ideographic_tail)
