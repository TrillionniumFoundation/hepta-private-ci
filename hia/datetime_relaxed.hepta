  calc_five:i64 = const() {"value":5}
  calc_hundred:i64 = const() {"value":100}
  era_years:i64 = const() {"value":400}
  year_days:i64 = const() {"value":365}
  era_days:i64 = const() {"value":146097}
  month_span:i64 = const() {"value":153}
  epoch:i64 = const() {"value":719468}
  negative_three:i64 = const() {"value":-3}
  nine:i64 = const() {"value":9}
  winter:bool = compare.le(month_word,calc_two)
  year_adjustment:i64 = select(winter,calc_one,calc_zero)
  adjusted_year:i64 = int.sub.checked(calc_year,year_adjustment)
  era:i64 = call(adjusted_year,era_years) {"function":"floor_div"}
  era_start_year:i64 = int.mul.checked(era,era_years)
  year_of_era:i64 = int.sub.checked(adjusted_year,era_start_year)
  month_adjustment:i64 = select(winter,nine,negative_three)
  march_month:i64 = int.add.checked(month_word,month_adjustment)
  scaled_month:i64 = int.mul.checked(march_month,month_span)
  corrected_month:i64 = int.add.checked(scaled_month,calc_two)
  month_start:i64 = int.div.checked(corrected_month,calc_five)
  with_day:i64 = int.add.checked(month_start,day_word)
  day_of_year:i64 = int.sub.checked(with_day,calc_one)
  whole_years:i64 = int.mul.checked(year_of_era,year_days)
  leap_days:i64 = int.div.checked(year_of_era,calc_four)
  century_days:i64 = int.div.checked(year_of_era,calc_hundred)
  with_leaps:i64 = int.add.checked(whole_years,leap_days)
  without_centuries:i64 = int.sub.checked(with_leaps,century_days)
  day_of_era:i64 = int.add.checked(without_centuries,day_of_year)
  era_start_days:i64 = int.mul.checked(era,era_days)
  absolute_days:i64 = int.add.checked(era_start_days,day_of_era)
  result:i64 = int.sub.checked(absolute_days,epoch)
  success:u64 = const() {"value":0}
  ret(result,success)
block invalid()
  invalid_days:i64 = const() {"value":0}
  error:u64 = const() {"value":1}
  ret(invalid_days,error)
end
fn floor_div(numerator:i64,denominator:i64) -> (i64) effects(trap) entry(entry)
