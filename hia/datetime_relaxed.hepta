  jump failed(short_error)
block out_of_range()
  range_error:u64 = const() {"value":1}
  jump failed(range_error)
block failed(failed_error:u64)
  failed_year:i64 = const() {"value":0}
  failed_position:usize = const() {"value":0}
  ret(failed_year,failed_position,failed_error)
