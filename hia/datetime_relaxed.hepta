  empty:usize = const() {"value":0}
  consumed:bool = compare.gt(nondigit_count,empty)
  branch consumed success(nondigit_value,nondigit_index) invalid()
block success(success_value:u64,success_position:usize)
  success_error:u64 = const() {"value":0}
  ret(success_value,success_position,success_error)
block short()
  short_error:u64 = const() {"value":5}
  jump failed(short_error)
block invalid()
  invalid_error:u64 = const() {"value":4}
  jump failed(invalid_error)
block out_of_range()
