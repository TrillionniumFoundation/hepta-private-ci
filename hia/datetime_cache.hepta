fn difference(left_seconds:i64,left_nanos:u64,right_seconds:i64,right_nanos:u64) -> (i64,u64) effects(trap) entry(entry)
block entry(left_seconds:i64,left_nanos:u64,right_seconds:i64,right_nanos:u64)
