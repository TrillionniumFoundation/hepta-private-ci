block entry(b1_source:readbuf,b1_needle:mutbuf)
  b1_size:usize = buffer.len(b1_source)
  b1_length:usize = buffer.len(b1_needle)
  b1_one:usize = const() {"value":1}
  b1_proper:usize = int.sub.checked(b1_length,b1_one)
  b1_shorter:bool = compare.lt(b1_size,b1_proper)
  b1_maximum:usize = select(b1_shorter,b1_size,b1_proper)
  jump scan(b1_source,b1_needle,b1_size,b1_maximum)
block scan(b2_source:readbuf,b2_needle:mutbuf,b2_size:usize,b2_length:usize)
  b2_zero:usize = const() {"value":0}
  b2_nonempty:bool = compare.gt(b2_length,b2_zero)
  branch b2_nonempty boundary(b2_source,b2_needle,b2_size,b2_length) absent()
block boundary(b3_source:readbuf,b3_needle:mutbuf,b3_size:usize,b3_length:usize)
  b3_value:u8 = buffer.load(b3_needle,b3_length)
  b3_low:u8 = const() {"value":128}
  b3_high:u8 = const() {"value":192}
  b3_above:bool = compare.ge(b3_value,b3_low)
  b3_below:bool = compare.lt(b3_value,b3_high)
  b3_continuation:bool = bool.and(b3_above,b3_below)
  branch b3_continuation advance(b3_source,b3_needle,b3_size,b3_length) compare(b3_source,b3_needle,b3_size,b3_length)
block compare(b4_source:readbuf,b4_needle:mutbuf,b4_size:usize,b4_length:usize)
  b4_position:usize = int.sub.checked(b4_size,b4_length)
  b4_matches:bool = call(b4_source,b4_position,b4_needle,b4_length) {"function":"equal_slice"}
  branch b4_matches found(b4_length) advance(b4_source,b4_needle,b4_size,b4_length)
block advance(b5_source:readbuf,b5_needle:mutbuf,b5_size:usize,b5_length:usize)
  b5_one:usize = const() {"value":1}
  b5_next:usize = int.sub.checked(b5_length,b5_one)
  jump scan(b5_source,b5_needle,b5_size,b5_next)
block found(b6_length:usize)
  ret(b6_length)
block absent()
  b7_zero:usize = const() {"value":0}
  ret(b7_zero)
end
fn equal_slice(b1_source:readbuf,b1_start:usize,b1_needle:mutbuf,b1_length:usize) -> (bool) effects(read,trap) entry(entry)
block entry(b1_source:readbuf,b1_start:usize,b1_needle:mutbuf,b1_length:usize)
  b1_zero:usize = const() {"value":0}
  jump scan(b1_source,b1_start,b1_needle,b1_length,b1_zero)
block scan(b2_source:readbuf,b2_start:usize,b2_needle:mutbuf,b2_length:usize,b2_index:usize)
  b2_more:bool = compare.lt(b2_index,b2_length)
  branch b2_more compare(b2_source,b2_start,b2_needle,b2_length,b2_index) equal()
block compare(b3_source:readbuf,b3_start:usize,b3_needle:mutbuf,b3_length:usize,b3_index:usize)
  b3_position:usize = int.add.checked(b3_start,b3_index)
  b3_left:u8 = buffer.load(b3_source,b3_position)
  b3_right:u8 = buffer.load(b3_needle,b3_index)
  b3_same:bool = compare.eq(b3_left,b3_right)
  branch b3_same advance(b3_source,b3_start,b3_needle,b3_length,b3_index) different()
block advance(b4_source:readbuf,b4_start:usize,b4_needle:mutbuf,b4_length:usize,b4_index:usize)
  b4_one:usize = const() {"value":1}
  b4_next:usize = int.add.checked(b4_index,b4_one)
  jump scan(b4_source,b4_start,b4_needle,b4_length,b4_next)
block equal()
  b5_value:bool = const() {"value":true}
  ret(b5_value)
block different()
  b6_value:bool = const() {"value":false}
  ret(b6_value)
end
fn reply(b1_output:mutbuf,b1_mode:u64,b1_count:u64,b1_position:u64,b1_length:u64,b1_index:u64,b1_keep:u64,b1_action:u64,b1_take:u64,b1_consume:u64,b1_tag:u64) -> () effects(write,trap) entry(entry)
block entry(b1_output:mutbuf,b1_mode:u64,b1_count:u64,b1_position:u64,b1_length:u64,b1_index:u64,b1_keep:u64,b1_action:u64,b1_take:u64,b1_consume:u64,b1_tag:u64)
  b1_version:u64 = const() {"value":1}
  b1_reserved:u64 = const() {"value":0}
  b1_offset_0:usize = const() {"value":0}
  _ = buffer.store.u64.le(b1_output,b1_offset_0,b1_version)
  b1_offset_1:usize = const() {"value":8}
  _ = buffer.store.u64.le(b1_output,b1_offset_1,b1_mode)
  b1_offset_2:usize = const() {"value":16}
  _ = buffer.store.u64.le(b1_output,b1_offset_2,b1_count)
  b1_offset_3:usize = const() {"value":24}
  _ = buffer.store.u64.le(b1_output,b1_offset_3,b1_position)
  b1_offset_4:usize = const() {"value":32}
  _ = buffer.store.u64.le(b1_output,b1_offset_4,b1_length)
  b1_offset_5:usize = const() {"value":40}
  _ = buffer.store.u64.le(b1_output,b1_offset_5,b1_index)
  b1_offset_6:usize = const() {"value":48}
  _ = buffer.store.u64.le(b1_output,b1_offset_6,b1_keep)
  b1_offset_7:usize = const() {"value":56}
  _ = buffer.store.u64.le(b1_output,b1_offset_7,b1_action)
  b1_offset_8:usize = const() {"value":64}
  _ = buffer.store.u64.le(b1_output,b1_offset_8,b1_take)
  b1_offset_9:usize = const() {"value":72}
  _ = buffer.store.u64.le(b1_output,b1_offset_9,b1_consume)
  b1_offset_10:usize = const() {"value":80}
  _ = buffer.store.u64.le(b1_output,b1_offset_10,b1_tag)
  b1_offset_11:usize = const() {"value":88}
  _ = buffer.store.u64.le(b1_output,b1_offset_11,b1_reserved)
  ret()
end
