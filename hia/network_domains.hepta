  w_next_left:usize = int.add.checked(w_left,w_width)
  w_next_right:usize = int.add.checked(w_right,w_width)
  w_next_remaining:usize = int.sub.checked(w_remaining,w_width)
  branch w_same chunks(w_source,w_next_left,w_next_right,w_next_remaining) different()
block tail(t_source:readbuf,t_left:usize,t_right:usize,t_remaining:usize)
  t_zero:usize = const() {"value":0}
  t_more:bool = compare.gt(t_remaining,t_zero)
  branch t_more byte(t_source,t_left,t_right,t_remaining) equal()
block byte(b_source:readbuf,b_left:usize,b_right:usize,b_remaining:usize)
  b_a:u8 = buffer.load(b_source,b_left)
  b_b:u8 = buffer.load(b_source,b_right)
  b_same:bool = compare.eq(b_a,b_b)
  b_one:usize = const() {"value":1}
  b_next_left:usize = int.add.checked(b_left,b_one)
  b_next_right:usize = int.add.checked(b_right,b_one)
  b_next_remaining:usize = int.sub.checked(b_remaining,b_one)
  branch b_same tail(b_source,b_next_left,b_next_right,b_next_remaining) different()
block equal()
  yes:bool = const() {"value":true}
  ret(yes)
block different()
  no:bool = const() {"value":false}
  ret(no)
end
