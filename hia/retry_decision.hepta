block http_decision(d_output:mutbuf,d_attempt:u64,d_retry_429:u64,d_retry_5xx:u64,d_status:u64)
  enabled:u64 = const() {"value":1}
  status_429:u64 = const() {"value":429}
  status_500:u64 = const() {"value":500}
  status_600:u64 = const() {"value":600}
  enabled_429:bool = compare.eq(d_retry_429,enabled)
  enabled_5xx:bool = compare.eq(d_retry_5xx,enabled)
  is_429:bool = compare.eq(d_status,status_429)
