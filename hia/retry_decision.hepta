  branch is_http http_status(k_output,k_attempt,k_maximum,k_retry_429,k_retry_5xx,k_retry_transport,k_kind,k_status) other_status(k_output,k_attempt,k_maximum,k_retry_429,k_retry_5xx,k_retry_transport,k_kind,k_status)
block http_status(v_output:mutbuf,v_attempt:u64,v_maximum:u64,v_retry_429:u64,v_retry_5xx:u64,v_retry_transport:u64,v_kind:u64,v_status:u64)
  first_status:u64 = const() {"value":100}
  last_status:u64 = const() {"value":999}
  above:bool = compare.ge(v_status,first_status)
  below:bool = compare.le(v_status,last_status)
  status_valid:bool = bool.and(above,below)
  branch status_valid limit(v_output,v_attempt,v_maximum,v_retry_429,v_retry_5xx,v_retry_transport,v_kind,v_status) invalid()
block other_status(o_output:mutbuf,o_attempt:u64,o_maximum:u64,o_retry_429:u64,o_retry_5xx:u64,o_retry_transport:u64,o_kind:u64,o_status:u64)
  absent_status:u64 = const() {"value":0}
  status_absent:bool = compare.eq(o_status,absent_status)
  branch status_absent limit(o_output,o_attempt,o_maximum,o_retry_429,o_retry_5xx,o_retry_transport,o_kind,o_status) invalid()
block limit(l_output:mutbuf,l_attempt:u64,l_maximum:u64,l_retry_429:u64,l_retry_5xx:u64,l_retry_transport:u64,l_kind:u64,l_status:u64)
  attempts_remain:bool = compare.lt(l_attempt,l_maximum)
  branch attempts_remain classify(l_output,l_attempt,l_retry_429,l_retry_5xx,l_retry_transport,l_kind,l_status) stop(l_output)
block classify(c_output:mutbuf,c_attempt:u64,c_retry_429:u64,c_retry_5xx:u64,c_retry_transport:u64,c_kind:u64,c_status:u64)
  http:u64 = const() {"value":0}
