block status_kind(k_output:mutbuf,k_attempt:u64,k_maximum:u64,k_retry_429:u64,k_retry_5xx:u64,k_retry_transport:u64,k_kind:u64,k_status:u64)
  http_kind:u64 = const() {"value":0}
