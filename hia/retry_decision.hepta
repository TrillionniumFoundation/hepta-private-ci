  one:u64 = const() {"value":1}
  four:u64 = const() {"value":4}
  version_ok:bool = compare.eq(version,one)
  retry_429_ok:bool = compare.le(retry_429,one)
  retry_5xx_ok:bool = compare.le(retry_5xx,one)
  retry_transport_ok:bool = compare.le(retry_transport,one)
  kind_ok:bool = compare.le(kind,four)
  first_ok:bool = bool.and(version_ok,retry_429_ok)
  second_ok:bool = bool.and(retry_5xx_ok,retry_transport_ok)
  flags_ok:bool = bool.and(first_ok,second_ok)
