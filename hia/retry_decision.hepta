  shape_ok:bool = bool.and(source_ok,workspace_ok)
  branch shape_ok header(s_source,s_output) invalid()
block header(h_source:readbuf,h_output:mutbuf)
  offset_0:usize = const() {"value":0}
  version:u64 = buffer.load.u64.le(h_source,offset_0)
  offset_1:usize = const() {"value":8}
  attempt:u64 = buffer.load.u64.le(h_source,offset_1)
