  "errorCode": "OBJ-E007",
  "legacyRetryable": true,
  "blindRetrySafe": false,
  "rustApi": {
    "directiveType": "ObjectiveRetryDirectiveV1",
    "classifier": "objective_admission_retry_directive_v1",
