    {
      "rustVariant": "ObjectiveAdmissionError::LocaleNotAllowed",
      "directive": "correct_request",
      "blindRetrySafe": false,
      "reason": "an unchanged locale/profile pairing will remain rejected"
    },
    {
      "rustVariant": "ObjectiveAdmissionError::DeadlineMissing",
      "directive": "correct_request",
      "blindRetrySafe": false,
      "reason": "the profile requires a deadline absent from the request"
    },
    {
      "rustVariant": "ObjectiveAdmissionError::DeadlineBeforeObservation",
      "directive": "correct_request",
      "blindRetrySafe": false,
      "reason": "the deadline ordering is semantically invalid"
    },
    {
      "rustVariant": "ObjectiveAdmissionError::DeadlineExpired",
      "directive": "correct_request",
      "blindRetrySafe": false,
