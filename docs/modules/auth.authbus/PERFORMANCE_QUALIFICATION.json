{
  "schema": "hepta.authbus.performance-contract.v1",
  "module": "auth.authbus",
  "activation": false,
  "minimumSamplesPerCase": 200,
  "requiredStages": [
    "signatureVerification",
    "authorityValidation",
    "mutationGateWait",
    "sqliteTransaction",
    "frontierUpdate",
    "checkpointPublication",
    "reconciliation",
    "productAcknowledgement",
    "endToEnd"
  ],
  "requiredPercentiles": [
    "p50Us",
    "p95Us",
    "p99Us",
    "maxUs"
  ],
  "requiredCaseIds": [
    "fresh-c1-normal",
    "fresh-c8-normal",
    "fresh-c32-normal",
    "fresh-c128-normal",
    "history-medium-c1-normal",
