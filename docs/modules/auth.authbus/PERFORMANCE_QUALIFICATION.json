    "fresh": {
      "minimumHistoryRows": 0,
      "minimumActiveReservations": 0
    },
    "history_medium": {
      "minimumHistoryRows": 10000,
      "minimumActiveReservations": 0
    },
    "history_long_active": {
      "minimumHistoryRows": 100000,
      "minimumActiveReservations": 8000
    }
  },
  "measurementBoundary": {
    "start": "product caller request entry before signature verification",
    "finish": "caller receives explicit success or AuthBusMutationDisposition",
    "includes": [
      "signature verification",
      "authority and scope validation",
      "mutation gate queueing",
      "SQLite transaction",
      "incremental frontier update",
      "checkpoint file write, fsync, rename and directory fsync",
      "reconciliation when required",
      "product caller acknowledgement"
    ]
  },
  "receiptPolicy": {
    "exactCandidateRequired": true,
    "singleTargetIdentityRequired": true,
    "rawSamplesDigestRequired": true,
    "environmentFingerprintRequired": true,
    "thresholdsAreActivationOwned": true
  }
