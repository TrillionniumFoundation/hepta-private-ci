  "currentNativeState": "Immutable V1 compatibility registry; full canonical V2/V3 admission sidecars before Prepared; fenced serial owner publication with atomic checkpoints, current trust floors, independent restart anchors and lease-rotation recovery; exact projection and single-parent inherited dataset provenance; service current-view expiry/withdrawal exclusions honored by selectors and cached consumers; bounded lifecycle and iteration evidence. Raw owner/verifier views prove V1 current history only. Normal executable writer/current-provider/selected-ranker bootstrap, multi-parent final-use ancestry, independent acceptance and target-host execution remain incomplete.",
  "repositoryControlledGaps": [
    "Compose the owner service, authenticated current withdrawal frontier, independently governed selector and Agentd ranker in a named executable bootstrap with product integration tests.",
    "Introduce a versioned registry/reader capable of full multi-parent final-use ancestry before enabling multi-parent publication.",
    "Provide trusted legacy full-admission backfill and an authorized durable withdrawal-to-artifact revocation/retention integration; V1 projections cannot reconstruct missing V2 provenance."
  ],
  "hostIntegrationRequirements": [
    "Provision independent owner/selector trust and authenticate withdrawal actors/frontiers before constructing typed source evidence.",
    "Retain an independent signed newest-head anchor for every populated service restart; protect the trusted root against concurrent hostile replacement.",
    "Use LearningArtifactOwnerService current views for V2 expiry/source-withdrawal guarantees; raw owner/verifier compatibility views do not provide that guarantee.",
    "Qualify non-Unix directory synchronization, abrupt power loss, retention/orphan reconciliation and physical deletion on the selected host.",
    "Operate signed CURRENT and writer lease validity/rotation/revocation policy; lease generation alone is not an independently retained revocation floor."
  ],
  "externalEvidenceGates": [
    "independent semantic review",
    "target-host product execution and power-loss qualification",
    "production owner/selector trust provisioning and independent operator acceptance",
    "canary, promotion and release"
  ],
