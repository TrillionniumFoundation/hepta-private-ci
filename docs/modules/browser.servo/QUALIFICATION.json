{
  "schema": "hepta.browser.servo-qualification.v1",
  "schemaVersion": 1,
  "module": "browser.servo",
  "sourceBinding": {
    "mode": "runtime-exact-source",
    "headShaEnvironment": "GITHUB_SHA",
    "headTreeCommand": "git rev-parse HEAD^{tree}",
    "pullRequestHeadExpression": "github.event.pull_request.head.sha",
    "pullRequestBaseExpression": "github.event.pull_request.base.sha",
    "syntheticMergeConstructor": ".github/actions/hepta-synthetic-merge/action.yml",
    "trackedShaPolicy": "No tracked file claims its own final commit SHA. Read-only CI emits a digest-bound exact-head or synthetic-merge receipt after checkout."
  },
  "claims": {
    "sourceRootPresent": true,
    "nativeSourceMappingComplete": true,
    "repositoryControlledDocumentationGapsClosed": true,
    "repositoryControlledMappingGapsClosed": true,
    "repositoryControlledSourceBoundaryGapsClosed": false,
    "productExecutionComplete": false,
    "deploymentQualificationComplete": false,
    "independentAcceptanceComplete": false,
    "productionImplementation": false,
    "productExecutionProved": false,
    "independentAcceptance": false,
    "activation": false,
    "promotion": false,
    "release": false,
    "implementedOperationMappingComplete": true
  },
  "gates": [
    {
      "id": "generated_truth_consistency",
      "owner": "repository",
      "required": true,
      "state": "implemented_pending_exact_head",
      "lanes": [
        "exact-head",
        "synthetic-merge"
      ],
      "commands": [
        "npm --prefix apps/hepta-browser run verify:qualification",
        "npm --prefix apps/hepta-browser run verify:registry"
      ]
    },
    {
      "id": "browser_node_suite",
      "owner": "repository",
      "required": true,
      "state": "implemented_pending_exact_head",
      "lanes": [
        "exact-head",
        "synthetic-merge"
      ],
      "commands": [
        "node --test apps/hepta-browser/test/*.test.js"
      ]
    },
    {
      "id": "agentd_rust_composition",
      "owner": "repository",
      "required": true,
      "state": "implemented_pending_exact_head",
      "lanes": [
        "exact-head",
        "synthetic-merge"
      ],
      "commands": [
        "cargo fmt --manifest-path codex-rs/Cargo.toml --package codex-hepta-agentd -- --check",
        "cargo test --locked -p codex-hepta-agentd browser_servo --lib",
        "cargo test --locked -p codex-hepta-agentd --bin hepta-agentd-browser-service",
        "cargo check --locked -p codex-hepta-agentd --bin hepta-agentd-browser --bin hepta-agentd-browser-service",
        "cargo clippy --locked -p codex-hepta-agentd --lib --bin hepta-agentd-browser --bin hepta-agentd-browser-service --no-deps -- -D warnings"
      ]
    },
    {
      "id": "servo_locked_worker",
      "owner": "repository",
      "required": true,
      "state": "implemented_pending_exact_head",
      "lanes": [
        "exact-head",
        "synthetic-merge"
      ],
      "commands": [
        "cargo check --locked --manifest-path apps/hepta-browser/servo-worker/Cargo.toml",
        "cargo test --locked --manifest-path apps/hepta-browser/servo-worker/Cargo.toml"
      ]
    },
    {
      "id": "workspace_integration_check",
      "owner": "repository",
      "required": true,
      "state": "implemented_pending_exact_head_and_merge",
      "lanes": [
        "exact-head",
        "synthetic-merge"
      ],
      "commands": [
        "cargo check --locked --workspace --all-targets"
      ]
    },
    {
      "id": "hostile_page_real_worker",
      "owner": "repository",
      "required": true,
      "state": "implemented_pending_exact_head",
      "lanes": [
        "exact-head",
        "synthetic-merge"
      ],
      "commands": [
        "node apps/hepta-browser/scripts/real-worker-smoke.js WORKER_BINARY"
      ]
    },
    {
      "id": "real_browser_lifecycle_and_egress",
      "owner": "repository",
      "required": true,
      "state": "implemented_pending_exact_head",
      "lanes": [
        "exact-head",
        "synthetic-merge"
      ],
      "commands": [
        "node apps/hepta-browser/scripts/real-browser-e2e.js WORKER_BINARY",
        "node apps/hepta-browser/scripts/public-egress-probe.js WORKER_BINARY"
      ]
    },
    {
      "id": "process_filesystem_and_resource_faults",
      "owner": "repository",
      "required": true,
      "state": "partial_pending_expanded_fault_matrix",
      "lanes": [
        "exact-head",
        "synthetic-merge",
        "trusted-linux-target"
      ],
      "commands": [
        "node apps/hepta-browser/scripts/linux-sandbox-probe.js",
        "node apps/hepta-browser/scripts/journal-scale-probe.js",
        "node apps/hepta-browser/scripts/real-browser-soak.js WORKER_BINARY"
      ]
    },
    {
      "id": "byte_identical_multi_builder_artifact",
      "owner": "repository",
      "required": true,
      "state": "implemented_pending_exact_head_and_merge",
      "lanes": [
        "exact-head",
        "synthetic-merge"
      ],
      "commands": [
        ".github/workflows/hepta-browser-servo-worker-dev.yml",
        ".github/workflows/hepta-browser-servo-independent-rebuild.yml"
      ]
    },
    {
      "id": "signed_sbom_and_provenance",
      "owner": "main-branch-builder",
      "required": true,
      "state": "implemented_main_only_pending",
      "lanes": [
        "main"
      ],
      "commands": [
        "GitHub artifact attestations for worker and SPDX 2.3 SBOM"
      ]
    },
    {
      "id": "trusted_linux_target",
      "owner": "independent-target-operator",
      "required": true,
      "state": "implemented_dispatch_only_pending",
      "lanes": [
        "trusted-linux-target"
      ],
      "commands": [
        ".github/workflows/hepta-browser-servo-deployment-qualification.yml"
      ]
    },
    {
      "id": "operator_acceptance_activation_promotion_release",
      "owner": "independent-operator",
      "required": true,
      "state": "external_not_granted",
      "lanes": [
        "operator"
      ],
      "commands": []
    }
  ],
  "artifacts": [
    {
      "id": "exact_head_receipt",
      "requiredFor": "repository_source_qualification",
      "producer": ".github/workflows/hepta-browser-servo-qualification.yml",
      "state": "runtime_generated_not_tracked"
    },
    {
      "id": "synthetic_merge_receipt",
      "requiredFor": "repository_source_qualification",
      "producer": ".github/workflows/hepta-browser-servo-qualification.yml",
      "state": "runtime_generated_not_tracked"
    },
    {
      "id": "primary_worker",
      "requiredFor": "deployment_qualification",
      "producer": ".github/workflows/hepta-browser-servo-worker-dev.yml",
      "state": "runtime_generated_not_tracked"
    },
    {
      "id": "independent_worker",
      "requiredFor": "deployment_qualification",
      "producer": ".github/workflows/hepta-browser-servo-independent-rebuild.yml",
      "state": "runtime_generated_not_tracked"
    },
    {
      "id": "spdx_2_3_sbom",
      "requiredFor": "deployment_qualification",
      "producer": ".github/workflows/hepta-browser-servo-worker-dev.yml",
      "state": "runtime_generated_not_tracked"
    },
    {
      "id": "primary_and_independent_provenance",
      "requiredFor": "deployment_qualification",
      "producer": "GitHub artifact attestations",
      "state": "main_only_runtime_generated_not_tracked"
    },
    {
      "id": "trusted_target_receipt",
      "requiredFor": "operator_acceptance",
      "producer": ".github/workflows/hepta-browser-servo-deployment-qualification.yml",
      "state": "runtime_generated_not_tracked"
    }
  ],
  "invariants": [
    "The compiler and protocol digest do not grant Browser execution authority.",
    "Only Agentd final-use authority may admit navigate_or_act at the irreversible boundary.",
    "Prepared intent is durable before worker dispatch and unknown post-admission outcomes are never blindly replayed.",
    "The persistent Agentd service and BrowserProfileHost remain the single product owner path.",
    "A green final gate is impossible when a required exact-head or synthetic-merge job failed, was cancelled, or was skipped.",
    "Tracked source and generated documentation are non-self-authorizing; production lifecycle claims require runtime evidence and independent decisions."
  ]
}
