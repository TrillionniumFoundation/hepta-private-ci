    {
      "id": "reveal_path",
      "rustVariant": "RevealPath",
      "payloadVariant": "RevealPath",
      "terminalReceiptRequired": true,
      "finalUseGrantRequired": true
    },
    {
      "id": "copy_text",
      "rustVariant": "CopyText",
      "payloadVariant": "CopyText",
      "terminalReceiptRequired": true,
      "finalUseGrantRequired": true
    },
    {
      "id": "notify",
      "rustVariant": "Notify",
      "payloadVariant": "Notify",
      "terminalReceiptRequired": true,
      "finalUseGrantRequired": true
    }
  ],
  "limits": {
    "stableIdBytes": 128,
    "copyTextBytes": 262144,
    "notificationTitleBytes": 256,
    "notificationBodyBytes": 4096
