  "errorCodes": [
    {
      "code": "owner_busy",
      "action": "retry with bounded backoff; inspect owner lock wait/hold evidence"
    },
    {
      "code": "owner_poisoned",
      "action": "stop serving; recover owner from durable state"
    },
    {
      "code": "controller_busy",
      "action": "retry control operation; inspect drain and lifecycle contention"
    },
    {
      "code": "controller_poisoned",
      "action": "stop lifecycle mutation and reconstruct controller"
    },
    {
      "code": "not_serving",
      "action": "do not dispatch; inspect lifecycle state"
    },
    {
      "code": "invalid_lifecycle_transition",
      "action": "reject caller intent and use documented transition order"
    },
    {
      "code": "generation_conflict",
      "action": "reject stale generation and reload current descriptor"
    },
    {
      "code": "pending_recovery",
      "action": "run exact-operation recovery; never redispatch blindly"
    },
    {
      "code": "unknown_generation",
      "action": "fail closed and inspect durable generation topology"
    }
  ],
  "qualification": {
    "workflow": ".github/workflows/neuron-runtime-readiness.yml",
    "testSetVersion": "2026-09-30.5",
    "repository": "TrillionniumFoundation/hepta-private-ci",
    "workflowName": "Neuron runtime unified readiness",
    "scopePolicy": {
      "msrv": "Rust 1.88 qualifies the durable Neuron core and infer-core only. The locked Agentd/App Server, worker-host and product adapter graph contains dependencies with higher compiler floors and is qualified on the same source SHA by stable Linux, Linux ARM64 and macOS ARM64 gates. A core MSRV pass is never represented as a full product-graph MSRV pass.",
      "repositoryBaseline": "Failures outside sourceRoots remain repository blockers. They may be reported as baseline-isolated only when reproduced on the fixed base SHA; they are never converted into a neuron.runtime pass, production activation or release authorization."
    },
    "requiredGates": [
      {
