+            'x':str(x),'gradient':dump(result,digits=places),
+            'reported_decimal_places':places,
+            'strictly_negative_certified':result.hi<0,
+            'boundary_smooth_pasting_certified':False,
+            'coupled_HX_equity_gradient_certified':False}
