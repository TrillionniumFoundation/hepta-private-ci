  "dynamics": {
    "numericRepresentation": "signed_integer_fixed_point_ppm_reference",
    "activationEquation": "v_next = cue + leak*v + associative_input - inhibitory_input - threshold",
    "competition": "stable_top_k_per_population_then_global_bound",
    "homeostasisEquation": "threshold_delta = eta_h * (activity - target_activity)",
    "eligibilityEquation": "e_next = rho*e + pre_activation*post_activation",
    "modulatorEquation": "clip(w_u*utility + w_p*prediction_error + w_n*novelty - w_r*risk - w_o*ood)",
    "plasticityEquation": "candidate_delta = clip(eta * modulator * eligibility - decay - interference)",
    "currentRunMutationAllowed": false,
    "onlineTopologyActivationAllowed": false
  },
