[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# R8 binary evidence volumes are hash-verified, not natural-language text.
skip = .git*,vendor,third_party,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,./tools/hcsn/third/encoder/features/cifar10_features.npz.part0018,./tools/hcsn/third/encoder/features/cifar10_features.npz.part0019,./tools/hcsn/round8_20261031/bundles/*.tar.gz.part*
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH,disjointness,retuned
