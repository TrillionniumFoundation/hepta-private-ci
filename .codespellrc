[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# Preserve the original hash-bound command receipts reported by CI run 40248493934.
skip = .git*,vendor,third_party,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,
    ./docs/modules/runtime.agentd/evidence/2026-10-23-production-composition/owner-workspace-raw/part-03.txt,
    ./docs/modules/runtime.agentd/evidence/2026-10-23-production-composition/owner-workspace-raw/part-09.txt,
    ./docs/modules/runtime.agentd/evidence/2026-10-23-production-composition/owner-workspace-raw/part-10.txt,
    ./docs/modules/runtime.agentd/evidence/2026-10-23-production-composition/owner-workspace-raw/part-13.txt,
    ./docs/modules/runtime.agentd/evidence/2026-10-23-production-composition/owner-workspace-raw/part-14.txt
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH,disjointness
