[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# Preserve original console evidence and compressed binary archive payloads.
# Archive JSON manifests, documentation and source files remain text-checked.
skip = .git*,vendor,third_party,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,./docs/modules/runtime.agentd/evidence/2026-10-23-production-composition/owner-workspace-raw,./qualification/cell-unification-20261106/archive/p*.bin
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH,disjointness
