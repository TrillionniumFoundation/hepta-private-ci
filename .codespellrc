[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# Preserve original console evidence bytes and hashes; exclude only the named raw evidence paths.
skip = .git*,vendor,third_party,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,./docs/modules/runtime.agentd/evidence/2026-10-23-production-composition/owner-workspace-raw,./qualification/cell-owner-context-20261107/raw/shm/context-native-dev-small.log,./qualification/cell-owner-context-20261107/raw/workspace/context-native-tests.log
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH,disjointness,DAA
