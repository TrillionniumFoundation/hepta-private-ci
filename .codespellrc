[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# Preserve verbatim third-party compiler diagnostics in retained audit evidence.
skip = .git*,vendor,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,qualification/runtime-codex-audit/guarded-send-20261002/logs/*.log
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH
