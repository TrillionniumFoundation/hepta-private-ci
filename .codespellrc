[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# COCO captions retain upstream spelling byte-for-byte under a fixed source hash.
skip = .git*,vendor,third_party,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,qa/stem-bakeoff/coco_caption_sample_v1.json
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH,disjointness
