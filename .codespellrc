[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# These two upstream Matrix fixtures contain opaque cryptographic values;
# preserve their exact bytes and keep spelling checks on all surrounding source.
skip = .git*,vendor,third_party,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,./codex-rs/benchmarks/benches/crypto_bench/keys_query.json,./codex-rs/benchmarks/benches/crypto_bench/keys_claim.json
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH,disjointness
