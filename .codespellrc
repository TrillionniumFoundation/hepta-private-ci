[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# These exact evidence files are immutable zlib binaries, audited by their recorded hashes.
skip = .git*,vendor,third_party,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,./qualification/pft_six_experiments_20261125/results/pft2_multihost_ai395.json.zlib,./qualification/pft_six_experiments_20261125/results/pft2_multihost_pocket4.json.zlib
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH,disjointness
