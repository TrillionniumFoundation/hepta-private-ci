[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
skip = .git*,vendor,third_party,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,experiments/multimodal_output_portfolio/closure_20261028/ci/object-transfer/*.b64
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH,disjointness
# Exact frozen source/receipt lines; provenance is recorded in the NDU CI amendment.
exclude-file = .codespell-exclude-lines
