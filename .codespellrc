[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# The v4 hosted frozen input is sharded binary data, not prose.  Keep
# Codespell active for the manifest, policies, source, tests and receipts.
skip = .git*,vendor,third_party,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,*v4_hosted/inputs/chunks/part-*.bin
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH,disjointness
