[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# R8 binary evidence volumes are hash-verified, not natural-language text.
# R9 binary archives and journals use exact paths; scientific text remains checked.
skip = .git*,vendor,third_party,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,./tools/hcsn/third/encoder/features/cifar10_features.npz.part0018,./tools/hcsn/third/encoder/features/cifar10_features.npz.part0019,./tools/hcsn/round8_20261031/bundles/*.tar.gz.part*,./tools/hcsn/round9_20261031/integration/native_executables.tar.gz,./tools/hcsn/round9_20261031/native/evidence/port-checks/owner/journal.bin,./tools/hcsn/round9_20261031/native/evidence/port-checks/owner/witness.bin,./tools/hcsn/round9_20261031/native/evidence/qualification-dev01/RAW_RECORDS.tar.gz,./tools/hcsn/round9_20261031/native/evidence/qualification-final/RAW_RECORDS.tar.gz,./tools/hcsn/round9_20261031/value/diagnostics/PAIRED.jsonl.gz,./tools/hcsn/round9_20261031/value/evidence/PAIRED.jsonl.gz,./tools/hcsn/round9_20261031/value/evidence/confirmation02/PAIRED.jsonl.gz,./tools/hcsn/round9_20261031/value/evidence/confirmation_attempt01/PAIRED.jsonl.gz
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH,disjointness,retuned
