[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# Preserve original console evidence bytes and hashes; exclude only this dated raw directory.
skip = .git*,vendor,third_party,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,./docs/modules/runtime.agentd/evidence/2026-10-23-production-composition/owner-workspace-raw
check-hidden = true
# Preserve the two exact Cargo crate/version lines in original console evidence.
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b|^\s*Compiling inout v(?:0\.1\.4|0\.2\.2)\s*$
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH,disjointness,DAA
