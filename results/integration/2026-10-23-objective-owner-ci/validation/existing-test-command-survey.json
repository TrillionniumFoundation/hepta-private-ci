        "step": "Strict Clippy independently of test outcome",
        "if": "${{ !cancelled() && steps.native_ready.outcome == 'success' }}",
        "commands": [
          "python3 ../scripts/hepta_ci_dependencies.py --root .. \"${args[@]}\" --action clippy \\"
        ]
      }
