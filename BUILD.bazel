load("@apple_support//xcode:xcode_config.bzl", "xcode_config")

xcode_config(name = "disable_xcode")

config_setting(
    name = "rust_fastbuild",
    values = {"compilation_mode": "fastbuild"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "rust_dbg",
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "rust_opt",
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)

# The release compile gate deliberately exercises cfg(not(debug_assertions))
# with fastbuild. Keep its explicit target and exec compiler flags authoritative.
config_setting(
    name = "rust_release_cfg_check",
    flag_values = {
        "@rules_rust//rust/settings:extra_exec_rustc_flag": "-Cdebug-assertions=no",
        "@rules_rust//rust/settings:extra_rustc_flag": "-Cdebug-assertions=no",
    },
    visibility = ["//visibility:public"],
)

# We mark the local platform as glibc-compatible so that rust can grab a toolchain for us.
# TODO(zbarsky): Upstream a better libc constraint into rules_rust.
# We only enable this on linux though for sanity, and because it breaks remote execution.
platform(
    name = "local_linux",
    constraint_values = [
        # We mark the local platform as glibc-compatible because musl-built rust cannot dlopen proc macros.
        "@llvm//constraints/libc:gnu.2.28",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "local_windows",
    constraint_values = [
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "local_windows_msvc",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
    ],
    flags = ["--features=static_link_msvcrt"],
    parents = ["@platforms//host"],
)

platform(
    name = "windows_x86_64_gnullvm",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
)

platform(
    name = "windows_x86_64_msvc",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:msvc",
    ],
    flags = ["--features=static_link_msvcrt"],
)

# Registered only by the keyless Windows cross wrapper. Native dependencies of
# MSVC proc macros must use the installed MSVC compiler, while GNU target
# dependencies continue to resolve the hermetic LLVM toolchain.
toolchain(
    name = "local_windows_msvc_cc_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:msvc",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:msvc",
    ],
    toolchain = "@local_config_cc//:cc-compiler-x64_windows",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

toolchain(
    name = "windows_gnullvm_tests_on_msvc_host_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:msvc",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
    toolchain = "@bazel_tools//tools/test:empty_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
)

# Run Linux musl test targets on the existing GNU execution hosts without
# changing the target ABI or the host used by compilers and proc macros.
toolchain(
    name = "linux_musl_tests_on_gnu_host_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.28",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:musl",
    ],
    toolchain = "@bazel_tools//tools/test:empty_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
)

alias(
    name = "rbe",
    actual = "@rbe_platform",
)

exports_files([
    "AGENTS.md",
    "docs/modules/MODULES.json",
    "workspace_root_test_launcher.bat.tpl",
    "workspace_root_test_launcher.sh.tpl",
])
